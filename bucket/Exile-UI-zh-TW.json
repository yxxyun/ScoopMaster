{
    "version": "1.58.6",
    "description": "Exile-UI 繁體中文（zh-TW）語言包",
    "homepage": "https://github.com/Drava008/Exile-UI-zh-TW",
    "license": "MIT",
    "depends": "exile-ui",
    "url": "https://github.com/Drava008/Exile-UI-zh-TW/archive/refs/heads/main.zip",
    "extract_dir": "Exile-UI-zh-TW-main",
    "post_install": [
        "$exileDir = \"$(appdir 'exile-ui' $global)\\current\"",
        "$source = Join-Path $dir 'ko-KR'",
        "$languages = [System.Collections.Generic.List[string]]::new()",
        "$languages.Add('ko-KR')",
        "$configCandidates = [System.Collections.Generic.List[string]]::new()",
        "$exileConfig = Join-Path $exileDir 'ini\\config.ini'",
        "if (Test-Path -LiteralPath $exileConfig) {",
        "    $configLine = Get-Content -LiteralPath $exileConfig | Where-Object { $_ -match '^PoE config-file=' } | Select-Object -First 1",
        "    if ($configLine -match '^PoE config-file=\"?(.+?)\"?$') { $configCandidates.Add($matches[1]) }",
        "}",
        "$documents = [Environment]::GetFolderPath('MyDocuments')",
        "$configCandidates.Add((Join-Path $documents 'My Games\\Path of Exile\\production_Config.ini'))",
        "$configCandidates.Add((Join-Path $documents 'My Games\\Path of Exile 2\\production_Config.ini'))",
        "foreach ($config in ($configCandidates | Select-Object -Unique)) {",
        "    if (!(Test-Path -LiteralPath $config)) { continue }",
        "    $languageLine = Get-Content -LiteralPath $config | Where-Object { $_ -match '^language\\s*=' } | Select-Object -First 1",
        "    if ($languageLine -match '^language\\s*=\\s*(.+?)\\s*$') {",
        "        $language = $matches[1].Trim().Trim('\"')",
        "        if ($language -and ($language -notin @('en', 'english')) -and ([IO.Path]::GetFileName($language) -eq $language)) { $languages.Add($language) }",
        "    }",
        "}",
        "$languages = @($languages | Select-Object -Unique)",
        "foreach ($language in $languages) {",
        "    $target = Join-Path $exileDir (\"data\\$language\")",
        "    if (!(Test-Path -LiteralPath $target)) { New-Item -ItemType Directory -Path $target -Force | Out-Null }",
        "    Get-ChildItem -LiteralPath $source -Force | Copy-Item -Destination $target -Recurse -Force",
        "}",
        "$languages | Set-Content -LiteralPath (Join-Path $dir 'installed-languages.txt') -Encoding UTF8"
    ],
    "pre_uninstall": [
        "$exileDir = \"$(appdir 'exile-ui' $global)\\current\"",
        "$source = Join-Path $dir 'ko-KR'",
        "$marker = Join-Path $dir 'installed-languages.txt'",
        "$languages = if (Test-Path -LiteralPath $marker) { @(Get-Content -LiteralPath $marker) } else { @('ko-KR', 'fr') }",
        "foreach ($language in ($languages | Select-Object -Unique)) {",
        "    $target = Join-Path $exileDir (\"data\\$language\")",
        "    if (!(Test-Path -LiteralPath $target)) { continue }",
        "    Get-ChildItem -LiteralPath $source -File -Recurse -Force | ForEach-Object {",
        "        $relative = $_.FullName.Substring($source.Length + 1)",
        "        Remove-Item -LiteralPath (Join-Path $target $relative) -Force -ErrorAction SilentlyContinue",
        "    }",
        "}"
    ],
    "notes": [
        "Exile UI 與 AutoHotkey 1.1 會自動安裝，ko-KR 語言包也會自動複製到 Exile UI 的 data 目錄。",
        "安裝時會讀取 Path of Exile 的 production_Config.ini，並把語言包同步到目前的 language 目錄，例如 language=fr 會同步到 data\\fr。",
        "此語言包目前對應 Exile UI v1.58.6；搭配較新版本時，部分文字或功能可能不相容。",
        "由於繁體中文玩家通常使用韓文聊天室語系，資料夾名稱保留為 ko-KR。"
    ]
}
