{
    "version": "1.0.0-beta9",
    "description": "All-in-one AI gateway. Use any OpenAI/Anthropic-compatible SDK to call 100+ LLMs with built-in failover, load balancing, cost control and end-to-end tracing (web dashboard on port 8090).",
    "homepage": "https://github.com/looplj/axonhub",
    "license": "Apache-2.0",
    "notes": [
        "AxonHub is a console server: run `axonhub` and keep the window open (Ctrl+C to stop). Web UI: http://localhost:8090",
        "Config, database and logs live in $persist_dir (config.yml, axonhub.db, logs) and survive upgrades and uninstalls.",
        "Always start via the `axonhub` command. Launching axonhub.exe directly uses the current folder as its data directory and would create a second copy of the data.",
        "A default config.yml is created on first install; edit it and restart to apply changes."
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/looplj/axonhub/releases/download/v1.0.0-beta9/axonhub_1.0.0-beta9_windows_amd64.zip",
            "hash": "9f5b349ee0435cb81cb7675a017eb20362eb2fe4461e9b67bf47c052a36e8543"
        },
        "arm64": {
            "url": "https://github.com/looplj/axonhub/releases/download/v1.0.0-beta9/axonhub_1.0.0-beta9_windows_arm64.zip",
            "hash": "b269b7b6c612eaf55e48deec92b0778b07d7820dcc4436ee4a15bf0a8c0ffe00"
        }
    },
    "pre_install": [
        "$ErrorActionPreference = 'Stop'",
        "$utf8 = New-Object System.Text.UTF8Encoding($false)",
        "$launcher = @(",
        "    '@echo off',",
        "    ('set \"AXONHUB_HOME={0}\"' -f $persist_dir),",
        "    'if not exist \"%AXONHUB_HOME%\" mkdir \"%AXONHUB_HOME%\"',",
        "    'cd /d \"%AXONHUB_HOME%\"',",
        "    '\"%~dp0axonhub.exe\" %*'",
        ") -join \"`r`n\"",
        "[System.IO.File]::WriteAllText((Join-Path $dir 'axonhub.cmd'), $launcher, $utf8)"
    ],
    "post_install": [
        "$ErrorActionPreference = 'Stop'",
        "$utf8 = New-Object System.Text.UTF8Encoding($false)",
        "$configPath = Join-Path $persist_dir 'config.yml'",
        "if (-not (Test-Path $configPath)) {",
        "    New-Item -ItemType Directory -Force $persist_dir | Out-Null",
        "    $slashDir = $persist_dir -replace '\\\\', '/'",
        "    $config = @(",
        "        'server:',",
        "        '  port: 8090',",
        "    '  name: \"AxonHub\"',",
        "    '  debug: false',",
        "    '',",
        "    'db:',",
        "    '  dialect: \"sqlite3\"',",
        "    ('  dsn: \"file:{0}/axonhub.db?cache=shared&_fk=1&_pragma=journal_mode(WAL)\"' -f $slashDir),",
        "        '',",
        "        'cache:',",
        "        '  mode: \"memory\"',",
        "        '  memory:',",
        "        '    expiration: \"5s\"',",
        "        '    cleanup_interval: \"5s\"',",
        "        '',",
        "        'log:',",
        "        '  level: \"info\"',",
        "        '  encoding: \"json\"',",
        "        '  output: \"file\"',",
        "        '  file:',",
        "    ('    path: \"{0}/logs/axonhub.log\"' -f $slashDir),",
        "        '    max_size: 100',",
        "        '    max_age: 30',",
        "        '    max_backups: 10',",
        "        '    local_time: true'",
        ") -join \"`r`n\"",
        "[System.IO.File]::WriteAllText($configPath, $config, $utf8)",
        "info '[Portable Mode]: Created default config.yml in persist\\axonhub'",
        "}"
    ],
    "bin": "axonhub.cmd",
    "checkver": {
        "github": "https://github.com/looplj/axonhub"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/looplj/axonhub/releases/download/v$version/axonhub_$version_windows_amd64.zip"
            },
            "arm64": {
                "url": "https://github.com/looplj/axonhub/releases/download/v$version/axonhub_$version_windows_arm64.zip"
            }
        }
    }
}
