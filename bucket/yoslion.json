{
    "version": "1.1.2",
    "description": "Desktop download manager with multi-connection downloads, browser integration, and interrupted-transfer resume.",
    "homepage": "https://download.yoslion.com/",
    "license": "Proprietary",
    "url": "https://updates.yoslion.com/release/windows/x86_64/1.1.2/Yoslion%20Download_1.1.2_x64-setup.exe#/dl.7z",
    "hash": "afafa745eabdfdd78a98d423036db74712ab120b252e60741f5ab29ce4873e18",
    "shortcuts": [
        [
            "yoslion-download.exe",
            "Yoslion Download"
        ]
    ],
    "post_install": [
        "$pluginDir = Join-Path $dir '$PLUGINSDIR'",
        "if (Test-Path -LiteralPath $pluginDir) {",
        "    Remove-Item -LiteralPath $pluginDir -Recurse -Force",
        "}",
        "$uninstaller = Join-Path $dir 'uninstall.exe'",
        "if (Test-Path -LiteralPath $uninstaller) {",
        "    Remove-Item -LiteralPath $uninstaller -Force",
        "}",
        "",
        "if ($global) {",
        "    Write-Host 'Yoslion browser integration is per-user and was skipped for this global installation.'",
        "    return",
        "}",
        "",
        "$localData = Join-Path $env:LOCALAPPDATA 'YoslionDownload'",
        "$localWebView = Join-Path $env:LOCALAPPDATA 'com.yoslion.download'",
        "$persistData = Join-Path $persist_dir 'YoslionDownload'",
        "$persistWebView = Join-Path $persist_dir 'com.yoslion.download'",
        "$appsRoot = [System.IO.Path]::GetFullPath((Join-Path $scoopdir \"apps\\$app\")).TrimEnd('\\') + '\\'",
        "$markerName = '.kirobucket-yoslion-persist'",
        "",
        "function Test-YoslionScoopPath([string]$Path) {",
        "    if ([string]::IsNullOrWhiteSpace($Path)) {",
        "        return $false",
        "    }",
        "    $fullPath = [System.IO.Path]::GetFullPath($Path)",
        "    return $fullPath.StartsWith($appsRoot, [System.StringComparison]::OrdinalIgnoreCase)",
        "}",
        "",
        "$nativeHostDir = Join-Path $localData 'NativeMessagingHosts'",
        "$chromeManifestPath = Join-Path $nativeHostDir 'com.yoslion.download.json'",
        "$firefoxManifestPath = Join-Path $nativeHostDir 'com.yoslion.download.firefox.json'",
        "$appPathFile = Join-Path $localData 'app-path'",
        "",
        "if (Test-Path -LiteralPath $nativeHostDir -PathType Container) {",
        "    foreach ($hostFile in Get-ChildItem -LiteralPath $nativeHostDir -File -Filter '*.json' -ErrorAction SilentlyContinue) {",
        "        try {",
        "            $existingHost = Get-Content -LiteralPath $hostFile.FullName -Raw | ConvertFrom-Json -ErrorAction Stop",
        "        } catch {",
        "            throw \"An existing Yoslion native host manifest is unreadable. Refusing to overwrite it: $($hostFile.FullName)\"",
        "        }",
        "        if ($existingHost.path -and -not (Test-YoslionScoopPath $existingHost.path)) {",
        "            throw \"A Yoslion native host is already registered from another install: $($existingHost.path). Uninstall that copy before installing this Scoop manifest.\"",
        "        }",
        "    }",
        "}",
        "if (Test-Path -LiteralPath $appPathFile -PathType Leaf) {",
        "    $existingAppPath = (Get-Content -LiteralPath $appPathFile -Raw).Trim()",
        "    if ($existingAppPath -and -not (Test-YoslionScoopPath $existingAppPath)) {",
        "        throw \"A different Yoslion installation is already recorded in app-path: $existingAppPath. Uninstall that copy before installing this Scoop manifest.\"",
        "    }",
        "}",
        "",
        "$registrations = @(",
        "    @{ Key = 'HKCU:\\Software\\Google\\Chrome\\NativeMessagingHosts\\com.yoslion.download'; Manifest = $chromeManifestPath },",
        "    @{ Key = 'HKCU:\\Software\\Microsoft\\Edge\\NativeMessagingHosts\\com.yoslion.download'; Manifest = $chromeManifestPath },",
        "    @{ Key = 'HKCU:\\Software\\Mozilla\\NativeMessagingHosts\\com.yoslion.download'; Manifest = $firefoxManifestPath }",
        ")",
        "foreach ($registration in $registrations) {",
        "    if (Test-Path -LiteralPath $registration.Key) {",
        "        $existingValue = (Get-Item -LiteralPath $registration.Key).GetValue('')",
        "        if ($existingValue -and ([System.IO.Path]::GetFullPath($existingValue) -ine [System.IO.Path]::GetFullPath($registration.Manifest))) {",
        "            throw \"A different native messaging host is already registered at $($registration.Key): $existingValue\"",
        "        }",
        "    }",
        "}",
        "",
        "function Set-YoslionPersistJunction([string]$Link, [string]$Target) {",
        "    $targetFull = [System.IO.Path]::GetFullPath($Target).TrimEnd('\\')",
        "    New-Item -ItemType Directory -Path $targetFull -Force | Out-Null",
        "    $marker = Join-Path $targetFull $markerName",
        "",
        "    if (Test-Path -LiteralPath $Link) {",
        "        $linkItem = Get-Item -LiteralPath $Link -Force",
        "        if (($linkItem.Attributes -band [System.IO.FileAttributes]::ReparsePoint) -ne 0) {",
        "            $linkMarker = Join-Path $Link $markerName",
        "            if (-not (Test-Path -LiteralPath $linkMarker -PathType Leaf)) {",
        "                throw \"Refusing to reuse an existing junction without the expected Scoop persistence marker: $Link\"",
        "            }",
        "            $recordedTarget = (Get-Content -LiteralPath $linkMarker -Raw).Trim()",
        "            if ($recordedTarget -ine $targetFull) {",
        "                throw \"The existing junction points to a different persistence directory: $Link\"",
        "            }",
        "            return",
        "        }",
        "",
        "        if (-not $linkItem.PSIsContainer) {",
        "            throw \"The expected Yoslion data path is not a directory: $Link\"",
        "        }",
        "",
        "        $sourceItems = @(Get-ChildItem -LiteralPath $Link -Force -ErrorAction Stop)",
        "        $targetItems = @(Get-ChildItem -LiteralPath $targetFull -Force -ErrorAction Stop |",
        "            Where-Object { $_.Name -ne $markerName })",
        "        if ($sourceItems.Count -gt 0 -and $targetItems.Count -gt 0) {",
        "            throw \"Both the existing Yoslion data directory and Scoop persist contain files. Refusing to merge or overwrite either directory: $Link\"",
        "        }",
        "        foreach ($item in $sourceItems) {",
        "            Move-Item -LiteralPath $item.FullName -Destination $targetFull -Force",
        "        }",
        "        Remove-Item -LiteralPath $Link -Force",
        "    } else {",
        "        New-Item -ItemType Directory -Path (Split-Path -Parent $Link) -Force | Out-Null",
        "    }",
        "",
        "    if (Test-Path -LiteralPath $marker -PathType Leaf) {",
        "        if ((Get-Content -LiteralPath $marker -Raw).Trim() -ine $targetFull) {",
        "            throw \"The Yoslion persistence marker contains an unexpected target: $marker\"",
        "        }",
        "    } else {",
        "        [System.IO.File]::WriteAllText($marker, $targetFull, [System.Text.UTF8Encoding]::new($false))",
        "        (Get-Item -LiteralPath $marker).Attributes = [System.IO.FileAttributes]::Hidden",
        "    }",
        "",
        "    New-Item -ItemType Junction -Path $Link -Target $targetFull | Out-Null",
        "}",
        "",
        "Set-YoslionPersistJunction -Link $localData -Target $persistData",
        "Set-YoslionPersistJunction -Link $localWebView -Target $persistWebView",
        "",
        "$appExe = Join-Path $dir 'yoslion-download.exe'",
        "$nativeHostExe = Join-Path $dir 'yoslion-native-host.exe'",
        "New-Item -ItemType Directory -Path $nativeHostDir -Force | Out-Null",
        "",
        "$utf8NoBom = [System.Text.UTF8Encoding]::new($false)",
        "$chromeManifest = [ordered]@{",
        "    name = 'com.yoslion.download'",
        "    description = 'Yoslion Download native messaging host'",
        "    path = $nativeHostExe",
        "    type = 'stdio'",
        "    allowed_origins = @('chrome-extension://jbddlgncoljibdenillmmibcegpgicnb/')",
        "}",
        "$firefoxManifest = [ordered]@{",
        "    name = 'com.yoslion.download'",
        "    description = 'Yoslion Download native messaging host'",
        "    path = $nativeHostExe",
        "    type = 'stdio'",
        "    allowed_extensions = @('yoslion-download@yoslion.com')",
        "}",
        "",
        "[System.IO.File]::WriteAllText($chromeManifestPath, ($chromeManifest | ConvertTo-Json -Depth 4), $utf8NoBom)",
        "[System.IO.File]::WriteAllText($firefoxManifestPath, ($firefoxManifest | ConvertTo-Json -Depth 4), $utf8NoBom)",
        "[System.IO.File]::WriteAllText($appPathFile, $appExe, $utf8NoBom)",
        "",
        "foreach ($registration in $registrations) {",
        "    New-Item -Path $registration.Key -Force | Out-Null",
        "    Set-Item -Path $registration.Key -Value $registration.Manifest",
        "}",
        "Write-Host 'Yoslion Download browser Native Messaging registered for the current user (Chrome, Edge and Firefox).'",
        ""
    ],
    "pre_uninstall": [
        "if ($global) {",
        "    return",
        "}",
        "",
        "$localData = Join-Path $env:LOCALAPPDATA 'YoslionDownload'",
        "$localWebView = Join-Path $env:LOCALAPPDATA 'com.yoslion.download'",
        "$nativeHostDir = Join-Path $localData 'NativeMessagingHosts'",
        "$chromeManifestPath = Join-Path $nativeHostDir 'com.yoslion.download.json'",
        "$firefoxManifestPath = Join-Path $nativeHostDir 'com.yoslion.download.firefox.json'",
        "$appsRoot = [System.IO.Path]::GetFullPath((Join-Path $scoopdir \"apps\\$app\")).TrimEnd('\\') + '\\'",
        "$markerName = '.kirobucket-yoslion-persist'",
        "",
        "function Test-YoslionScoopPath([string]$Path) {",
        "    if ([string]::IsNullOrWhiteSpace($Path)) {",
        "        return $false",
        "    }",
        "    $fullPath = [System.IO.Path]::GetFullPath($Path)",
        "    return $fullPath.StartsWith($appsRoot, [System.StringComparison]::OrdinalIgnoreCase)",
        "}",
        "",
        "$registrations = @(",
        "    @{ Key = 'HKCU:\\Software\\Google\\Chrome\\NativeMessagingHosts\\com.yoslion.download'; Manifest = $chromeManifestPath },",
        "    @{ Key = 'HKCU:\\Software\\Microsoft\\Edge\\NativeMessagingHosts\\com.yoslion.download'; Manifest = $chromeManifestPath },",
        "    @{ Key = 'HKCU:\\Software\\Mozilla\\NativeMessagingHosts\\com.yoslion.download'; Manifest = $firefoxManifestPath }",
        ")",
        "foreach ($registration in $registrations) {",
        "    if (Test-Path -LiteralPath $registration.Key) {",
        "        $existingValue = (Get-Item -LiteralPath $registration.Key).GetValue('')",
        "        if ($existingValue -and ([System.IO.Path]::GetFullPath($existingValue) -ieq [System.IO.Path]::GetFullPath($registration.Manifest))) {",
        "            Remove-Item -LiteralPath $registration.Key -Force",
        "        }",
        "    }",
        "}",
        "",
        "foreach ($manifestPath in @($chromeManifestPath, $firefoxManifestPath)) {",
        "    if (Test-Path -LiteralPath $manifestPath -PathType Leaf) {",
        "        try {",
        "            $hostManifest = Get-Content -LiteralPath $manifestPath -Raw | ConvertFrom-Json -ErrorAction Stop",
        "            if (Test-YoslionScoopPath $hostManifest.path) {",
        "                Remove-Item -LiteralPath $manifestPath -Force",
        "            }",
        "        } catch {",
        "            Write-Host \"Could not verify the Yoslion native host manifest; leaving it untouched: $manifestPath\"",
        "        }",
        "    }",
        "}",
        "",
        "$appPathFile = Join-Path $localData 'app-path'",
        "if (Test-Path -LiteralPath $appPathFile -PathType Leaf) {",
        "    $appPath = (Get-Content -LiteralPath $appPathFile -Raw).Trim()",
        "    if (Test-YoslionScoopPath $appPath) {",
        "        Remove-Item -LiteralPath $appPathFile -Force",
        "    }",
        "}",
        "",
        "function Remove-YoslionPersistJunction([string]$Link, [string]$Target) {",
        "    if (-not (Test-Path -LiteralPath $Link)) {",
        "        return",
        "    }",
        "    $linkItem = Get-Item -LiteralPath $Link -Force",
        "    if (($linkItem.Attributes -band [System.IO.FileAttributes]::ReparsePoint) -eq 0) {",
        "        return",
        "    }",
        "    $targetFull = [System.IO.Path]::GetFullPath($Target).TrimEnd('\\')",
        "    $linkMarker = Join-Path $Link $markerName",
        "    if (-not (Test-Path -LiteralPath $linkMarker -PathType Leaf)) {",
        "        Write-Host \"Leaving an unverified Yoslion data junction untouched: $Link\"",
        "        return",
        "    }",
        "    $recordedTarget = (Get-Content -LiteralPath $linkMarker -Raw).Trim()",
        "    if ($recordedTarget -ieq $targetFull) {",
        "        Remove-Item -LiteralPath $Link -Force",
        "    } else {",
        "        Write-Host \"Leaving a Yoslion data junction that points elsewhere untouched: $Link\"",
        "    }",
        "}",
        "",
        "Remove-YoslionPersistJunction -Link $localData -Target (Join-Path $persist_dir 'YoslionDownload')",
        "Remove-YoslionPersistJunction -Link $localWebView -Target (Join-Path $persist_dir 'com.yoslion.download')",
        "Write-Host 'Yoslion browser registration removed. User data remains in Scoop persist.'",
        ""
    ],
    "notes": "The app payload is extracted from the NSIS package; the vendor setup is not run. Browser Native Messaging is registered per-user for Chrome, Edge and Firefox. App data and the WebView2 profile are redirected to this app's persist directory. checkver and autoupdate use the publisher's downloads page. Global installs skip browser integration; the WebView2 Runtime remains a system dependency.",
    "checkver": {
        "url": "https://download.yoslion.com/downloads",
        "regex": "Yoslion Download_(?<version>[\\d.]+)_x64-setup\\.exe"
    },
    "autoupdate": {
        "url": "https://updates.yoslion.com/release/windows/x86_64/$version/Yoslion%20Download_$version_x64-setup.exe#/dl.7z",
        "hash": {
            "url": "https://download.yoslion.com/downloads",
            "regex": "(?is)Yoslion Download_$version_x64-setup\\.exe.*?SHA-256</p><code[^>]*>([a-f0-9]{64})"
        }
    }
}
