{
    "version": "1.2.0-9ca7775",
    "description": "PowerShell module for managing Windows file-type and protocol associations.",
    "homepage": "https://github.com/feiglein74/FTA-Manager",
    "license": "MIT",
    "url": [
        "https://raw.githubusercontent.com/feiglein74/FTA-Manager/9ca777511edaba2f828d25023477cbe9e4b5a33b/FTA-Manager.psd1",
        "https://raw.githubusercontent.com/feiglein74/FTA-Manager/9ca777511edaba2f828d25023477cbe9e4b5a33b/FTA-Manager.psm1"
    ],
    "hash": [
        "622eee36db72ed2b51d9cf781c5700eb360f6f88f02b9625bf9c22e34aeb6a12",
        "a211e5477a9dd0a73821977f1ee6a6c4926b7ddd63a47ac6fecfc80719df1138"
    ],
    "psmodule": {
        "name": "FTA-Manager"
    },
    "checkver": {
        "regex": "^(?<version>[0-9]+(?:\\.[0-9]+){1,3}-[0-9a-f]{7})$",
        "script": [
            "$commit = Invoke-RestMethod -Uri 'https://api.github.com/repos/feiglein74/FTA-Manager/commits/master' -Headers @{ 'User-Agent' = 'Scoop' }",
            "$module = Invoke-RestMethod -Uri 'https://raw.githubusercontent.com/feiglein74/FTA-Manager/master/FTA-Manager.psd1'",
            "$versionMatch = [regex]::Match([string]$module, \"(?m)^\\s*ModuleVersion\\s*=\\s*'(?<version>[0-9.]+)'\" )",
            "if (-not $versionMatch.Success -or [string]$commit.sha -notmatch '^[0-9a-f]{40}$') { throw 'Could not determine upstream module version and commit.' }",
            "'{0}-{1}' -f $versionMatch.Groups['version'].Value, $commit.sha.Substring(0, 7)"
        ]
    },
    "autoupdate": {
        "url": [
            "https://raw.githubusercontent.com/feiglein74/FTA-Manager/master/FTA-Manager.psd1",
            "https://raw.githubusercontent.com/feiglein74/FTA-Manager/master/FTA-Manager.psm1"
        ]
    },
    "notes": [
        "Import the module with: Import-Module FTA-Manager.",
        "Scoop installs the module files only; it does not install the optional service or alter file associations.",
        "Commands that change file associations require care; disabling UCPD can weaken Windows protection for default-app associations."
    ]
}

