    "hash": "d4f4c0a36f07c15c8b7f3de1445a55738a7012f54433e3a592a0008c99568be2",
    "bin": "GMSSH.exe",
    "shortcuts": [
        [
            "GMSSH.exe",
            "GMSSH"
        ]
    ],
    "pre_install": [
        "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-64.7z\" \"$dir\"",
        "Remove-Item \"$dir\\`$*\" -Force -Recurse"
    ],
    "persist": "data",
    "post_install": [
        "if (-not (Test-Path \"$persist_dir\\AppData\")) {",
        "    if (Test-Path \"$Env:APPDATA\\GMSSH\") {",
        "        Move-Item \"$Env:APPDATA\\GMSSH\" \"$persist_dir\\AppData\"",
        "    } else {",
        "        New-Item -ItemType Directory -Path \"$persist_dir\\AppData\" | Out-Null",
        "    }",
        "}",
        "if (-not (Test-Path \"$Env:APPDATA\\GMSSH\")) {",
        "    New-Item -ItemType Junction -Path \"$Env:APPDATA\\GMSSH\" -Value \"$persist_dir\\AppData\" | Out-Null",
        "}"
    ],
    "post_uninstall": "if ($purge -and (Test-Path \"$Env:APPDATA\\GMSSH\")) { Remove-Item -Recurse -Force \"$Env:APPDATA\\GMSSH\" }",
    "checkver": {
        "script": [
            "$api = 'https://api.gmssh.com/api/package_client/download_v2'",
            "$ua = 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/148.0.0.0 Safari/537.36'",
            "$headers = @{ 'upload-token' = '01841009b01f4f56f032792ceafaef60' }",
            "$response = Invoke-RestMethod -Uri $api -Method Get -UserAgent $ua -Headers $headers",
            "$response | ConvertTo-Json -Depth 5 | Write-Output"
        ],
        "jsonpath": "$.data.win.x64.version"
    },
    "autoupdate": {
        "url": "https://oss.gm.cn/client/win/x64/$version/GMSSH-win-$version-x64-pro.exe#/GMSSH.7z"
    }
