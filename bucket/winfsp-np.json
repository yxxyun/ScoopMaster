{
    "version": "2.2B5",
    "description": "Set of software components that allows the creation of user mode file systems.",
    "homepage": "https://winfsp.dev/",
    "license": "GPL-3.0-or-later",
    "url": "https://github.com/winfsp/winfsp/releases/download/v2.2B5/winfsp-2.2.26286.msi#/setup.msi_",
    "hash": "293ffb9bcc0b625c85079fe85fa77f8fe98170aba51a02ac9c83d58f6c3b0e2f",
    "installer": {
        "script": [
            "if (!(is_admin)) { error \"$app requires admin rights to $cmd\"; break }",
            "$succ = Invoke-ExternalCommand msiexec -ArgumentList @('/i', \"$dir\\setup.msi_\", 'ADDLOCAL=F.Developer', '/qn')",
            "if(-not $succ) { break }"
        ]
    },
    "checkver": {
        "github": "https://api.github.com/repos/winfsp/winfsp/releases",
        "jsonpath": "$..browser_download_url",
        "regex": "download/v(?<version>[\\w.]+)/winfsp-(?<build>[\\d.]+)\\.msi"
    },
    "autoupdate": {
        "url": "https://github.com/winfsp/winfsp/releases/download/v$version/winfsp-$matchBuild.msi#/setup.msi_"
    }
}
