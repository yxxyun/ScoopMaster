{
    "version": "3.5.5.1",
    "description": "All-in-one screenshot tool with annotation, pinning, OCR and recording features",
    "homepage": "https://pixpin.com/",
    "license": "Freeware",
    "url": "https://down.pixpin.cn/PixPin_win_3.5.5.1.zip",
    "hash": "1c6d81e7cc9791862553cceab5123e84d700b59efa2943aa17503fc81088106a",
    "extract_dir": "PixPin",
    "pre_install": [
        "$config = \"$persist_dir\\Config\\PixPinConfig.json\"",
        "if (!(Test-Path $config)) {",
        "    $time = [int][DateTimeOffset]::UtcNow.ToUnixTimeSeconds()",
        "    $content = @{ 'System.Update.UpgradeMode#s.win' = @{ 'v' = 0; 't' = $time } } | ConvertTo-Json -Compress",
        "    New-Item $config -Force -Value $content | Out-Null",
        "}"
    ],
    "shortcuts": [
        [
            "PixPin.exe",
            "PixPin"
        ]
    ],
    "persist": [
        "Config",
        "Data",
        "History",
        "Temp"
    ],
    "checkver": {
        "url": "https://pixpin.com/download/",
        "useragent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64)",
        "regex": "PixPin_win_([\\d.]+)\\.zip"
    },
    "autoupdate": {
        "url": "https://down.pixpin.cn/PixPin_win_$version.zip",
        "hash": {
            "mode": "download"
        }
    }
}
