    "hash": "1ed2b048f7e1468cdd3dc869c3db0653d9308ffe4f48fb42091b0b559a90b211",
    "extract_dir": "PixPin",
    "pre_install": [
        "$config = \"$persist_dir\\Config\\PixPinConfig.json\"",
        "if (!(Test-Path $config)) {",
        "    $time = [int][DateTimeOffset]::UtcNow.ToUnixTimeSeconds()",
        "    $content = @{ 'System.Update.UpgradeMode#s.win' = @{ 'v' = 0; 't' = $time } } | ConvertTo-Json -Compress",
        "    New-Item $config -Force -Value $content | Out-Null",
        "}"
    ],
    "shortcuts": [
        [
            "PixPin.exe",
            "PixPin"
        ]
    ],
    "persist": [
        "Config",
        "Data",
        "History",
        "Temp"
    ],
    "checkver": {
        "url": "https://pixpin.com/download/",
        "useragent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64)",
        "regex": "PixPin_win_([\\d.]+)\\.zip"
    },
    "autoupdate": {
        "url": "https://down.pixpin.cn/PixPin_win_$version.zip",
        "hash": {
            "mode": "download"
        }
    }
}
