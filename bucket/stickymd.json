{
    "version": "0.2.0",
    "description": "Portable Markdown scratch pad: one note, autosave, native preview and math rendering.",
    "homepage": "https://github.com/Develata/StickyMD",
    "license": "MIT",
    "notes": [
        "StickyMD keeps its note, settings and images in $dir\\note.",
        "'scoop update' and 'scoop uninstall' copy that folder to $persist_dir\\note (the copy before it stays in note.previous), and the next install copies it back.",
        "Quit StickyMD from its tray menu (Exit) before updating or uninstalling.",
        "After an update, start StickyMD from the Start menu shortcut; edits made with an older version's StickyMD.exe are not carried over.",
        "'scoop uninstall --purge stickymd' also deletes the saved copy."
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/Develata/StickyMD/releases/download/v0.2.0/StickyMD-0.2.0-windows-x64-portable.zip",
            "hash": "8d35e2f188073c6f3ee91de577990e016f8f982797547e823b4c739ba6b70361"
        }
    },
    "extract_dir": "StickyMD",
    "pre_install": [
        "$saved = Join-Path $persist_dir 'note'",
        "if (Test-Path -LiteralPath $saved -PathType Container) {",
        "    $ErrorActionPreference = 'Stop'",
        "    $note = Join-Path $dir 'note'",
        "    $restoring = Join-Path $dir 'note.restoring'",
        "    if (Test-Path -LiteralPath $note) { throw \"StickyMD: $note already exists, so the saved note in $saved was not restored.\" }",
        "    if (Test-Path -LiteralPath $restoring) { Remove-Item -LiteralPath $restoring -Recurse -Force }",
        "    robocopy $saved $restoring /E /COPY:DAT /DCOPY:DAT /R:1 /W:1 /NFL /NDL /NJH /NJS /NP | Out-Null",
        "    if ($LASTEXITCODE -ge 8) { throw \"StickyMD: restoring $saved failed (robocopy exit code $LASTEXITCODE).\" }",
        "    Rename-Item -LiteralPath $restoring -NewName 'note'",
        "}"
    ],
    "pre_uninstall": [
        "$note = Join-Path $dir 'note'",
        "if (Test-Path -LiteralPath $note -PathType Container) {",
        "    $prefix = (Split-Path -Parent $dir) + '\\'",
        "    $running = @(Get-Process -ErrorAction SilentlyContinue | Where-Object { try { $_.Path -and $_.Path.StartsWith($prefix, [System.StringComparison]::OrdinalIgnoreCase) } catch { $false } })",
        "    if ($running.Count -gt 0) { throw 'StickyMD is still running. Quit it from its tray menu (Exit), then run the command again.' }",
        "    $ErrorActionPreference = 'Stop'",
        "    New-Item -ItemType Directory -Force -Path $persist_dir | Out-Null",
        "    $saved = Join-Path $persist_dir 'note'",
        "    $saving = Join-Path $persist_dir 'note.saving'",
        "    $previous = Join-Path $persist_dir 'note.previous'",
        "    if (Test-Path -LiteralPath $saving) { Remove-Item -LiteralPath $saving -Recurse -Force }",
        "    robocopy $note $saving /E /COPY:DAT /DCOPY:DAT /R:1 /W:1 /NFL /NDL /NJH /NJS /NP | Out-Null",
        "    if ($LASTEXITCODE -ge 8) { throw \"StickyMD: saving $note failed (robocopy exit code $LASTEXITCODE).\" }",
        "    if (Test-Path -LiteralPath $saved) {",
        "        if (Test-Path -LiteralPath $previous) { Remove-Item -LiteralPath $previous -Recurse -Force }",
        "        Rename-Item -LiteralPath $saved -NewName 'note.previous'",
        "    }",
        "    Rename-Item -LiteralPath $saving -NewName 'note'",
        "}"
    ],
    "shortcuts": [
        [
            "StickyMD.exe",
            "StickyMD"
        ]
    ],
    "checkver": {
        "github": "https://github.com/Develata/StickyMD"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/Develata/StickyMD/releases/download/v$version/StickyMD-$version-windows-x64-portable.zip"
            }
        },
        "hash": {
            "url": "$baseurl/SHA256SUMS.txt"
        }
    }
}
