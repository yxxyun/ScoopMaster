{
    "version": "0.90.0-beta.67",
    "description": "PC recomps, all in one place. Find, install, update and play PC recomps from one launcher.",
    "homepage": "https://recomplauncher.com",
    "license": "GPL-3.0",
    "notes": [
        "Non-portable NSIS installer: installs per-user to %LOCALAPPDATA%\\RecompLauncher and creates a Start Menu shortcut.",
        "Installer is unsigned upstream; Windows SmartScreen may prompt on first run."
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/elripalda/RecompLauncher/releases/download/v0.90.0-beta.67/RecompLauncher_0.90.0-beta.67_x64-setup.exe",
            "hash": "dada2d7ba5b11cff9c143ec5ea94de0642f1f1da1871e4af547bd8b1e4e790f6"
        }
    },
    "installer": {
        "script": [
            "Start-Process -FilePath \"$dir\\RecompLauncher_${version}_x64-setup.exe\" -ArgumentList '/S' -Wait",
            "$rlDeadline = (Get-Date).AddMinutes(5); while ((Get-Date) -lt $rlDeadline -and -not (Test-Path \"$env:LOCALAPPDATA\\RecompLauncher\\recomplauncher.exe\")) { Start-Sleep -Seconds 2 }",
            "if (-not (Test-Path \"$env:LOCALAPPDATA\\RecompLauncher\\recomplauncher.exe\")) { throw 'RecompLauncher install did not complete' }"
        ]
    },
    "post_install": "Remove-Item \"$dir\\RecompLauncher_${version}_x64-setup.exe\" -Force -ErrorAction SilentlyContinue",
    "uninstaller": {
        "script": "if (Test-Path \"$env:LOCALAPPDATA\\RecompLauncher\\uninstall.exe\") { Start-Process -FilePath \"$env:LOCALAPPDATA\\RecompLauncher\\uninstall.exe\" -ArgumentList '/S' -Wait }"
    },
    "checkver": {
        "url": "https://api.github.com/repos/elripalda/RecompLauncher/releases",
        "regex": "\"tag_name\":\\s*\"v([\\d.]+-beta\\.\\d+)\""
    },
    "autoupdate": {
        "url": "https://github.com/elripalda/RecompLauncher/releases/download/v$version/RecompLauncher_$version_x64-setup.exe"
    }
}
