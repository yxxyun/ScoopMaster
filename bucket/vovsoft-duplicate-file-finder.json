{
    "version": "2.1",
    "description": "Portable edition of Vovsoft Duplicate File Finder.",
    "homepage": "https://vovsoft.com/software/duplicate-file-finder/",
    "license": "Proprietary",
    "url": "https://vovsoft.com/files/duplicate-file-finder-portable.zip?v=2.1",
    "checkver": {
        "url": "https://vovsoft.com/download/duplicate-file-finder-portable/",
        "regex": "(?is)Version\\s*(?:<[^>]*>\\s*)*:?\\s*(?:<[^>]*>\\s*)*(?<version>\\d+(?:\\.\\d+)+)"
    },
    "autoupdate": {
        "url": "https://vovsoft.com/files/duplicate-file-finder-portable.zip?v=$version"
    },
    "shortcuts": [
        [
            "duplicateff.exe",
            "Vovsoft Duplicate File Finder"
        ]
    ],
    "notes": [
        "SHA-256 has not been verified; archive contents and the shortcut target have been checked."
    ],
    "pre_install": [
        "if (-not (Test-Path -LiteralPath \"$dir\\key.txt\" -PathType Leaf)) { New-Item -ItemType File -Path \"$dir\\key.txt\" | Out-Null }"
    ],
    "persist": "key.txt"
}
