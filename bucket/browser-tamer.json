{
    "version": "6.2.2",
    "description": "Redirects URLs to a browser of your choice based on configurable rules, with profile and protocol support",
    "homepage": "https://github.com/aloneguid/bt",
    "license": "Apache-2.0",
    "depends": "lessmsi",
    "notes": [
        "After installing, open Windows Settings > Apps > Default Apps and set 'Browser Tamer'",
        "as the default handler for http, https, .htm, and .html.",
        "Run 'bt' with no arguments to open the configuration UI."
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/aloneguid/bt/releases/download/6.2.2/BrowserTamer-6.2.2-win64.msi",
            "hash": "52ba0ce77a78c5d94eda0ed6c52f87f37a245c7a1d40a1e130df25bc8187ef6c"
        },
        "arm64": {
            "url": "https://github.com/aloneguid/bt/releases/download/6.2.2/BrowserTamer-6.2.2-win-arm64.msi",
            "hash": "3eaff4671d1468e613a5f4928c3142b44e7e0e625f05235591b69acf7ac91305"
        }
    },
    "installer": {
        "script": [
            "$msi = Get-ChildItem $dir -Filter '*.msi' -ErrorAction SilentlyContinue | Select-Object -First 1 -ExpandProperty FullName",
            "if ($msi) {",
            "    $extractPath = \"$dir\\_extract\"",
            "    New-Item -ItemType Directory -Force -Path $extractPath | Out-Null",
            "    & lessmsi x \"$msi\" \"$extractPath\"; if ($LASTEXITCODE -ne 0) { throw \"lessmsi extraction failed (exit code $LASTEXITCODE)\" }",
            "    $btExe = Get-ChildItem $extractPath -Filter 'bt.exe' -Recurse | Select-Object -First 1",
            "    if (!$btExe) { throw 'bt.exe not found in extracted MSI contents.' }",
            "    Get-ChildItem (Split-Path $btExe.FullName) | Move-Item -Destination $dir -Force",
            "    Remove-Item $extractPath -Recurse -Force",
            "    Remove-Item $msi -Force",
            "} else {",
            "    $btExe = Get-ChildItem $dir -Filter 'bt.exe' -Recurse | Select-Object -First 1",
            "    if ($btExe -and (Split-Path $btExe.FullName) -ne $dir) {",
            "        Get-ChildItem (Split-Path $btExe.FullName) | Move-Item -Destination $dir -Force",
            "        Get-ChildItem $dir -Directory -Recurse | Where-Object { @(Get-ChildItem $_ -Recurse).Count -eq 0 } | Remove-Item -Force",
            "    } elseif (!$btExe) {",
            "        throw 'bt.exe not found in installation directory'",
            "    }",
            "}"
        ]
    },
    "post_install": [
        "# Set up registry entries for URL/protocol handling (mirrors patch.xml from upstream WiX build)",
        "$exe = \"$dir\\bt.exe\"",
        "# x-bt:// custom protocol",
        "New-Item -Path 'HKCU:\\Software\\Classes\\x-bt' -Force | Out-Null",
        "Set-ItemProperty -Path 'HKCU:\\Software\\Classes\\x-bt' -Name '(Default)' -Value 'URL:BrowserTamer Protocol' -Force",
        "New-ItemProperty -Path 'HKCU:\\Software\\Classes\\x-bt' -Name 'URL Protocol' -Value '' -PropertyType String -Force | Out-Null",
        "New-Item -Path 'HKCU:\\Software\\Classes\\x-bt\\shell\\open\\command' -Force | Out-Null",
        "Set-ItemProperty -Path 'HKCU:\\Software\\Classes\\x-bt\\shell\\open\\command' -Name '(Default)' -Value \"`\"$exe`\" `\"%1`\"\" -Force",
        "# Register as a StartMenuInternet browser entry",
        "New-Item -Path 'HKCU:\\Software\\Clients\\StartMenuInternet\\BrowserTamer' -Force | Out-Null",
        "Set-ItemProperty -Path 'HKCU:\\Software\\Clients\\StartMenuInternet\\BrowserTamer' -Name '(Default)' -Value 'Browser Tamer' -Force",
        "New-Item -Path 'HKCU:\\Software\\Clients\\StartMenuInternet\\BrowserTamer\\DefaultIcon' -Force | Out-Null",
        "Set-ItemProperty -Path 'HKCU:\\Software\\Clients\\StartMenuInternet\\BrowserTamer\\DefaultIcon' -Name '(Default)' -Value \"$exe,0\" -Force",
        "New-Item -Path 'HKCU:\\Software\\Clients\\StartMenuInternet\\BrowserTamer\\shell\\open\\command' -Force | Out-Null",
        "Set-ItemProperty -Path 'HKCU:\\Software\\Clients\\StartMenuInternet\\BrowserTamer\\shell\\open\\command' -Name '(Default)' -Value $exe -Force",
        "New-Item -Path 'HKCU:\\Software\\Clients\\StartMenuInternet\\BrowserTamer\\Capabilities' -Force | Out-Null",
        "Set-ItemProperty -Path 'HKCU:\\Software\\Clients\\StartMenuInternet\\BrowserTamer\\Capabilities' -Name 'ApplicationName' -Value 'Browser Tamer' -Force",
        "Set-ItemProperty -Path 'HKCU:\\Software\\Clients\\StartMenuInternet\\BrowserTamer\\Capabilities' -Name 'ApplicationDescription' -Value 'Redirects open URLs to a browser of your choice.' -Force",
        "Set-ItemProperty -Path 'HKCU:\\Software\\Clients\\StartMenuInternet\\BrowserTamer\\Capabilities' -Name 'ApplicationIcon' -Value \"$exe,0\" -Force",
        "New-Item -Path 'HKCU:\\Software\\Clients\\StartMenuInternet\\BrowserTamer\\Capabilities\\URLAssociations' -Force | Out-Null",
        "Set-ItemProperty -Path 'HKCU:\\Software\\Clients\\StartMenuInternet\\BrowserTamer\\Capabilities\\URLAssociations' -Name 'x-bt' -Value 'BrowserTamerHTM' -Force",
        "Set-ItemProperty -Path 'HKCU:\\Software\\Clients\\StartMenuInternet\\BrowserTamer\\Capabilities\\URLAssociations' -Name 'http' -Value 'BrowserTamerHTM' -Force",
        "Set-ItemProperty -Path 'HKCU:\\Software\\Clients\\StartMenuInternet\\BrowserTamer\\Capabilities\\URLAssociations' -Name 'https' -Value 'BrowserTamerHTM' -Force",
        "New-Item -Path 'HKCU:\\Software\\Clients\\StartMenuInternet\\BrowserTamer\\Capabilities\\FileAssociations' -Force | Out-Null",
        "Set-ItemProperty -Path 'HKCU:\\Software\\Clients\\StartMenuInternet\\BrowserTamer\\Capabilities\\FileAssociations' -Name '.htm' -Value 'BrowserTamerHTM' -Force",
        "Set-ItemProperty -Path 'HKCU:\\Software\\Clients\\StartMenuInternet\\BrowserTamer\\Capabilities\\FileAssociations' -Name '.html' -Value 'BrowserTamerHTM' -Force",
        "Set-ItemProperty -Path 'HKCU:\\Software\\Clients\\StartMenuInternet\\BrowserTamer\\Capabilities\\FileAssociations' -Name '.mht' -Value 'BrowserTamerHTM' -Force",
        "Set-ItemProperty -Path 'HKCU:\\Software\\Clients\\StartMenuInternet\\BrowserTamer\\Capabilities\\FileAssociations' -Name '.mhtml' -Value 'BrowserTamerHTM' -Force",
        "Set-ItemProperty -Path 'HKCU:\\Software\\Clients\\StartMenuInternet\\BrowserTamer\\Capabilities\\FileAssociations' -Name '.shtml' -Value 'BrowserTamerHTM' -Force",
        "Set-ItemProperty -Path 'HKCU:\\Software\\Clients\\StartMenuInternet\\BrowserTamer\\Capabilities\\FileAssociations' -Name '.svg' -Value 'BrowserTamerHTM' -Force",
        "Set-ItemProperty -Path 'HKCU:\\Software\\Clients\\StartMenuInternet\\BrowserTamer\\Capabilities\\FileAssociations' -Name '.webp' -Value 'BrowserTamerHTM' -Force",
        "Set-ItemProperty -Path 'HKCU:\\Software\\Clients\\StartMenuInternet\\BrowserTamer\\Capabilities\\FileAssociations' -Name '.xht' -Value 'BrowserTamerHTM' -Force",
        "Set-ItemProperty -Path 'HKCU:\\Software\\Clients\\StartMenuInternet\\BrowserTamer\\Capabilities\\FileAssociations' -Name '.xhtml' -Value 'BrowserTamerHTM' -Force",
        "Set-ItemProperty -Path 'HKCU:\\Software\\Clients\\StartMenuInternet\\BrowserTamer\\Capabilities\\FileAssociations' -Name '.pdf' -Value 'BrowserTamerPDF' -Force",
        "Set-ItemProperty -Path 'HKCU:\\Software\\Clients\\StartMenuInternet\\BrowserTamer\\Capabilities\\FileAssociations' -Name '.epub' -Value 'BrowserTamerEPUB' -Force",
        "# BrowserTamerHTM class (http/https/html handler)",
        "New-Item -Path 'HKCU:\\Software\\Classes\\BrowserTamerHTM' -Force | Out-Null",
        "Set-ItemProperty -Path 'HKCU:\\Software\\Classes\\BrowserTamerHTM' -Name '(Default)' -Value 'Browser Tamer Document' -Force",
        "New-Item -Path 'HKCU:\\Software\\Classes\\BrowserTamerHTM\\Application' -Force | Out-Null",
        "Set-ItemProperty -Path 'HKCU:\\Software\\Classes\\BrowserTamerHTM\\Application' -Name 'ApplicationDescription' -Value 'Redirects open URLs to a browser of your choice.' -Force",
        "Set-ItemProperty -Path 'HKCU:\\Software\\Classes\\BrowserTamerHTM\\Application' -Name 'ApplicationName' -Value 'Browser Tamer' -Force",
        "New-Item -Path 'HKCU:\\Software\\Classes\\BrowserTamerHTM\\DefaultIcon' -Force | Out-Null",
        "Set-ItemProperty -Path 'HKCU:\\Software\\Classes\\BrowserTamerHTM\\DefaultIcon' -Name '(Default)' -Value \"$exe,0\" -Force",
        "New-Item -Path 'HKCU:\\Software\\Classes\\BrowserTamerHTM\\shell\\open\\command' -Force | Out-Null",
        "Set-ItemProperty -Path 'HKCU:\\Software\\Classes\\BrowserTamerHTM\\shell\\open\\command' -Name '(Default)' -Value \"`\"$exe`\" `\"%1`\"\" -Force",
        "# BrowserTamerPDF class",
        "New-Item -Path 'HKCU:\\Software\\Classes\\BrowserTamerPDF' -Force | Out-Null",
        "Set-ItemProperty -Path 'HKCU:\\Software\\Classes\\BrowserTamerPDF' -Name '(Default)' -Value 'Browser Tamer Document' -Force",
        "New-Item -Path 'HKCU:\\Software\\Classes\\BrowserTamerPDF\\Application' -Force | Out-Null",
        "Set-ItemProperty -Path 'HKCU:\\Software\\Classes\\BrowserTamerPDF\\Application' -Name 'ApplicationDescription' -Value 'Redirects open URLs to a browser of your choice.' -Force",
        "Set-ItemProperty -Path 'HKCU:\\Software\\Classes\\BrowserTamerPDF\\Application' -Name 'ApplicationName' -Value 'Browser Tamer' -Force",
        "New-Item -Path 'HKCU:\\Software\\Classes\\BrowserTamerPDF\\DefaultIcon' -Force | Out-Null",
        "Set-ItemProperty -Path 'HKCU:\\Software\\Classes\\BrowserTamerPDF\\DefaultIcon' -Name '(Default)' -Value \"$exe,1\" -Force",
        "New-Item -Path 'HKCU:\\Software\\Classes\\BrowserTamerPDF\\shell\\open\\command' -Force | Out-Null",
        "Set-ItemProperty -Path 'HKCU:\\Software\\Classes\\BrowserTamerPDF\\shell\\open\\command' -Name '(Default)' -Value \"`\"$exe`\" `\"%1`\"\" -Force",
        "# BrowserTamerEPUB class",
        "New-Item -Path 'HKCU:\\Software\\Classes\\BrowserTamerEPUB' -Force | Out-Null",
        "Set-ItemProperty -Path 'HKCU:\\Software\\Classes\\BrowserTamerEPUB' -Name '(Default)' -Value 'Browser Tamer Document' -Force",
        "New-Item -Path 'HKCU:\\Software\\Classes\\BrowserTamerEPUB\\Application' -Force | Out-Null",
        "Set-ItemProperty -Path 'HKCU:\\Software\\Classes\\BrowserTamerEPUB\\Application' -Name 'ApplicationDescription' -Value 'Redirects open URLs to a browser of your choice.' -Force",
        "Set-ItemProperty -Path 'HKCU:\\Software\\Classes\\BrowserTamerEPUB\\Application' -Name 'ApplicationName' -Value 'Browser Tamer' -Force",
        "New-Item -Path 'HKCU:\\Software\\Classes\\BrowserTamerEPUB\\DefaultIcon' -Force | Out-Null",
        "Set-ItemProperty -Path 'HKCU:\\Software\\Classes\\BrowserTamerEPUB\\DefaultIcon' -Name '(Default)' -Value \"$exe,2\" -Force",
        "New-Item -Path 'HKCU:\\Software\\Classes\\BrowserTamerEPUB\\shell\\open\\command' -Force | Out-Null",
        "Set-ItemProperty -Path 'HKCU:\\Software\\Classes\\BrowserTamerEPUB\\shell\\open\\command' -Name '(Default)' -Value \"`\"$exe`\" `\"%1`\"\" -Force",
        "# Register application in RegisteredApplications",
        "New-Item -Path 'HKCU:\\Software\\RegisteredApplications' -Force | Out-Null",
        "Set-ItemProperty -Path 'HKCU:\\Software\\RegisteredApplications' -Name 'Browser Tamer' -Value 'Software\\Clients\\StartMenuInternet\\BrowserTamer\\Capabilities' -Force",
        "# Redirect %APPDATA%\\Browser Tamer to Scoop's persist directory via junction",
        "$configDir = \"$env:APPDATA\\Browser Tamer\"",
        "if (!(Test-Path $persist_dir)) { New-Item -ItemType Directory -Force -Path $persist_dir | Out-Null }",
        "if ((Test-Path $configDir) -and ((Get-Item $configDir).LinkType -ne 'Junction')) {",
        "    Get-ChildItem $configDir -ErrorAction SilentlyContinue | Copy-Item -Destination $persist_dir -Recurse -Force",
        "    Remove-Item $configDir -Recurse -Force",
        "}",
        "if (!(Test-Path $configDir)) { New-Item -ItemType Junction -Path $configDir -Target $persist_dir | Out-Null }"
    ],
    "pre_uninstall": [
        "# Remove junction before uninstall so persist directory contents are preserved",
        "$configDir = \"$env:APPDATA\\Browser Tamer\"",
        "if ((Test-Path $configDir) -and ((Get-Item $configDir -ErrorAction SilentlyContinue).LinkType -eq 'Junction')) {",
        "    Remove-Item $configDir -Force",
        "}",
        "# Remove registry entries",
        "foreach ($key in @('HKCU:\\Software\\Classes\\x-bt', 'HKCU:\\Software\\Classes\\BrowserTamerHTM', 'HKCU:\\Software\\Classes\\BrowserTamerPDF', 'HKCU:\\Software\\Classes\\BrowserTamerEPUB', 'HKCU:\\Software\\Clients\\StartMenuInternet\\BrowserTamer')) {",
        "    Remove-Item $key -Recurse -Force -ErrorAction SilentlyContinue",
        "}",
        "Remove-ItemProperty -Path 'HKCU:\\Software\\RegisteredApplications' -Name 'Browser Tamer' -ErrorAction SilentlyContinue"
    ],
    "bin": "bt.exe",
    "shortcuts": [
        [
            "bt.exe",
            "Browser Tamer"
        ]
    ],
    "checkver": {
        "github": "https://github.com/aloneguid/bt",
        "regex": "tag/(6\\.[\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/aloneguid/bt/releases/download/$version/BrowserTamer-$version-win64.msi"
            },
            "arm64": {
                "url": "https://github.com/aloneguid/bt/releases/download/$version/BrowserTamer-$version-win-arm64.msi"
            }
        }
    }
}
