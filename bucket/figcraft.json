{
    "version": "0.18.1",
    "description": "Open-source interface design and prototyping rebuilt in pure Rust: auto layout, components, variables and multi-screen canvases",
    "homepage": "https://github.com/storytold/figcraft",
    "license": "MIT OR Apache-2.0",
    "notes": [
        "FigCraft keeps its settings in %APPDATA%\\FigCraft, which is outside the Scoop install directory: they survive 'scoop update' and are not touched by 'scoop uninstall'.",
        "This build offers no portable marker and no config-directory environment variable, so that folder cannot be moved into Scoop's persist store.",
        "'figcraft-cli.exe' is exposed as the 'figcraft-cli' shim.",
        "The portable zip does not register the file associations that the MSI installer adds.",
        "The app has no built-in updater; use 'scoop update figcraft' so the install and this manifest stay in sync."
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/storytold/figcraft/releases/download/v0.18.1/figcraft-0.18.1-windows-x64-portable.zip",
            "hash": "158563f240eea42b939c328569dcf0d1b55545d89cbf035bfd5d354f351b0762",
            "installer": {
                "script": [
                    "$stage = \"$dir\\figcraft-$version-windows-x64-portable\"",
                    "Move-Item \"$stage\\*\" $dir -ErrorAction Stop",
                    "Remove-Item $stage -ErrorAction Stop"
                ]
            }
        },
        "arm64": {
            "url": "https://github.com/storytold/figcraft/releases/download/v0.18.1/figcraft-0.18.1-windows-arm64-portable.zip",
            "hash": "0be46bc30645d2366465d35026204cc32b5eaecde90454dbceb85781891533ac",
            "installer": {
                "script": [
                    "$stage = \"$dir\\figcraft-$version-windows-arm64-portable\"",
                    "Move-Item \"$stage\\*\" $dir -ErrorAction Stop",
                    "Remove-Item $stage -ErrorAction Stop"
                ]
            }
        }
    },
    "bin": "figcraft-cli.exe",
    "shortcuts": [
        [
            "figcraft.exe",
            "FigCraft"
        ]
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/storytold/figcraft/releases/download/v$version/figcraft-$version-windows-x64-portable.zip"
            },
            "arm64": {
                "url": "https://github.com/storytold/figcraft/releases/download/v$version/figcraft-$version-windows-arm64-portable.zip"
            }
        }
    }
