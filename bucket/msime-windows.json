{
    "##": "Inno Setup (installer/msime_setup.iss). TSF IME: the installer registers the input method, so this package delegates to it and removes via unins000.exe. Requires VC++ 2015-2022 x64 redistributable.",
    "version": "0.13.2",
    "description": "水杉输入法 —— 开源自由 Windows 输入法（纯 TSF，Win10/11）",
    "homepage": "https://github.com/metasequoiaime/msime-windows",
    "license": {
        "identifier": "GPL-3.0-only",
        "url": "https://github.com/metasequoiaime/msime-windows/blob/develop/LICENSE"
    },
    "notes": [
        "输入法是 TSF 组件，必须由官方安装器注册；本包已代跑安装器并指向 Scoop 目录",
        "若切换不到该输入法或设置窗口一闪即退，先装 Visual C++ 2015-2022 Redistributable (x64)",
        "安装后按 Win+空格 切换"
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/metasequoiaime/msime-windows/releases/download/v0.13.2/MetasequoiaIME_Setup_v0.13.2.exe",
            "hash": "34db47d0d6894164f83c665cccb809de9e8e3ff36f975fed63d3069f02108a7d"
        }
    },
    "installer": {
        "script": [
            "$installer = Join-Path $dir $fname",
            "$dirArg = '/DIR=\"{0}\"' -f $dir",
            "Start-Process -FilePath $installer -ArgumentList '/VERYSILENT', '/SUPPRESSMSGBOXES', '/NORESTART', $dirArg -Wait",
            "Remove-Item $installer -Force"
        ]
    },
    "uninstaller": {
        "script": [
            "$c=@((Join-Path $dir 'unins000.exe'))",
            "foreach ($u in $c) { if (Test-Path -LiteralPath $u) { Start-Process -FilePath $u -ArgumentList '/VERYSILENT','/SUPPRESSMSGBOXES','/NORESTART' -Wait; break } }"
        ]
    },
    "checkver": {
        "url": "https://github.com/metasequoiaime/msime-windows/releases.atom",
        "regex": "releases/tag/v([\\d.]+)\""
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/metasequoiaime/msime-windows/releases/download/v$version/MetasequoiaIME_Setup_v$version.exe"
            }
        },
        "hash": {
            "url": "https://api.github.com/repos/metasequoiaime/msime-windows/releases/tags/v$version",
            "regex": "\"name\":\"MetasequoiaIME_Setup_v$version\\.exe\".*?\"digest\":\"sha256:([0-9a-f]{64})\""
        }
    }
}
