{
    "version": "1.3.3",
    "description": "A third-party Linux.do community client tuned for China networks, derived from FluxDO and built with Flutter. The Windows desktop build is a preview.",
    "homepage": "https://github.com/1molchuan/CFluxDo",
    "license": "GPL-3.0-only",
    "notes": [
        "Requires the Microsoft Edge WebView2 Runtime (bundled with Windows 11).",
        "The build is not code signed; if SmartScreen appears, choose 'More info' and then 'Run anyway'.",
        "Settings and login data are kept in '$persist_dir\\Roaming' and removed by 'scoop uninstall -p'."
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/1molchuan/CFluxDo/releases/download/1.3.3/cfluxdo-1.3.3-windows-x86_64.zip",
            "hash": "b359e1db50121b105ed24ceaedaafff6f90f3653293fc2930535db2da1fe845a",
            "extract_dir": "cfluxdo-1.3.3-windows-x86_64"
        }
    },
    "installer": {
        "script": [
            ". \"$bucketsdir\\$bucket\\scripts\\utils.ps1\"",
            "New-PersistDirectory \"$env:APPDATA\\com.github.molchuan\\cfluxdo\" \"$persist_dir\\Roaming\" -Migrate"
        ]
    },
    "shortcuts": [
        [
            "cfluxdo.exe",
            "CFluxDo"
        ]
    ],
    "pre_uninstall": [
        "$bucket = $install.bucket",
        ". \"$bucketsdir\\$bucket\\scripts\\utils.ps1\"",
        "Remove-Junction \"$env:APPDATA\\com.github.molchuan\\cfluxdo\"",
        "Remove-EmptyDirectory \"$env:APPDATA\\com.github.molchuan\""
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/1molchuan/CFluxDo/releases/download/$version/cfluxdo-$version-windows-x86_64.zip",
                "extract_dir": "cfluxdo-$version-windows-x86_64"
            }
        },
        "hash": {
            "url": "$url.sha256"
        }
    }
}
