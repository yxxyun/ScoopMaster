    "homepage": "https://www.morgen.so/",
    "license": {
        "identifier": "Proprietary",
        "url": "https://www.morgen.so/privacy"
    },
    "architecture": {
        "64bit": {
            "url": "https://download.todesktop.com/210203cqcj00tw1/Morgen%20Setup%204.1.4%20-%20Build%20261111uasppv5l0-x64.exe#/dl.7z",
            "hash": "sha512:4c2de9aebdf9e09ffdb40e3e02cac8ead0f0abd1035635716071105d632593facdaf333d7efea858e2f1455c6ce1d650dc63b392387995b2769cf969d986f9fa",
            "pre_install": [
                "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-64.7z\" \"$dir\"",
                "Remove-Item \"$dir\\`$*\", \"$dir\\Uninst*\" -Recurse"
            ]
        }
    },
    "shortcuts": [
        [
            "Morgen.exe",
            "Morgen App",
            "--user-data-dir=\"$dir\\data\\user-data\""
        ]
    ],
    "persist": "data",
    "checkver": {
        "url": "https://download.todesktop.com/210203cqcj00tw1/latest.yml",
        "regex": "Setup\\s+([\\d.]+).*Build\\s+(?<Build>[\\w]+)-x64.exe"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://download.todesktop.com/210203cqcj00tw1/Morgen%20Setup%20$version%20-%20Build%20$matchBuild-x64.exe#/dl.7z",
                "hash": {
                    "url": "$baseurl/latest.yml",
                    "regex": "(?sm)x64.*?sha512:\\s+$base64"
                }
            }
        }
    }
}
