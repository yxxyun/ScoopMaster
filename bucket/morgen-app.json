            "hash": "sha512:a714ea08fac53f90358a0e54b2fc5b63670f738ee77964e47443719f2688d1531b171870f494aa40f64c2f1356944b457177da7ff02909ecb3588cef8e96ff69",
            "pre_install": [
                "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-64.7z\" \"$dir\"",
                "Remove-Item \"$dir\\`$*\", \"$dir\\Uninst*\" -Recurse"
