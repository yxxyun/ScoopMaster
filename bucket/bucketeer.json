{
    "version": "1.5.0",
    "description": "Desktop assistant for coordinating AI agents, models, memories, and collaborative workspaces.",
    "homepage": "https://github.com/zachzhao1984/bucketeer",
    "license": "Unknown",
    "architecture": {
        "64bit": {
            "url": "https://github.com/zachzhao1984/bucketeer/releases/download/v1.5.0/Bucketeer-1.5.0-windows-amd64.exe",
            "hash": "6f1c6fbd3162d33e570a966a2de73841e57ab15cb01a6560656ec2b8d3cfc875"
        }
    },
    "installer": {
        "args": [
            "/S",
            "/D=$dir"
        ]
    },
    "uninstaller": {
        "script": [
            "$uninstaller = Get-ChildItem -LiteralPath $dir -File -Recurse -ErrorAction SilentlyContinue | Where-Object { $_.Name -match '(?i)^(unins\\d*|uninstall.*)\\.exe$' } | Select-Object -First 1",
            "if (-not $uninstaller) { throw 'The application uninstaller was not found in the Scoop version directory.' }",
            "$process = Start-Process -FilePath $uninstaller.FullName -ArgumentList '/S' -WorkingDirectory $uninstaller.DirectoryName -Wait -PassThru",
            "if ($process.ExitCode -ne 0) { throw ('The application uninstaller exited with code {0}.' -f $process.ExitCode) }"
        ]
    },
    "bin": "Bucketeer.exe",
    "shortcuts": [
        [
            "Bucketeer.exe",
            "Bucketeer"
        ]
    ],
    "checkver": {
        "github": "https://github.com/zachzhao1984/bucketeer"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/zachzhao1984/bucketeer/releases/download/v$version/Bucketeer-$version-windows-amd64.exe",
                "hash": {
                    "mode": "json",
                    "url": "https://api.github.com/repos/zachzhao1984/bucketeer/releases/tags/v$version",
                    "jp": "$.assets[?(@.name == 'Bucketeer-$version-windows-amd64.exe')].digest"
                }
            }
        }
    }
}
