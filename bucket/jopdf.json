{
    "version": "2.4.2.1",
    "description": "Free Windows PDF editor and reader for editing, annotating, converting, merging, splitting, compressing, and protecting PDF files.",
    "homepage": "https://www.jopdf.com/",
    "license": {
        "identifier": "Unknown",
        "url": "https://www.jopdf.com/eula/"
    },
    "architecture": {
        "64bit": {
            "url": "https://cdn.jopdf.com/download/jopdf/jopdf-win-x64_setup.exe",
            "hash": "87e6a08e1ec197bd761e7672ef4a86ae9649795c7e3907f8626daf61646cec13"
        }
    },
    "innosetup": true,
    "bin": "JOPDF.exe",
    "shortcuts": [
        [
            "JOPDF.exe",
            "JOPDF"
        ]
    ],
    "checkver": {
        "script": [
            "$url = 'https://cdn.jopdf.com/download/jopdf/jopdf-win-x64_setup.exe'",
            "$tempPath = Join-Path $env:TEMP ('jopdf-checkver-' + [guid]::NewGuid().ToString('N') + '.exe')",
            "try {",
            "    Invoke-WebRequest -Uri $url -OutFile $tempPath -UseBasicParsing -TimeoutSec 180",
            "    $detected = [System.Diagnostics.FileVersionInfo]::GetVersionInfo($tempPath).ProductVersion.Trim()",
            "    if ($detected -notmatch '^\\d+(?:\\.\\d+){1,3}$') { throw \"Could not read JOPDF ProductVersion from downloaded setup: $detected\" }",
            "    $detected",
            "} finally {",
            "    Remove-Item -LiteralPath $tempPath -Force -ErrorAction SilentlyContinue",
            "}"
        ],
        "regex": "^([\\d.]+)$"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://cdn.jopdf.com/download/jopdf/jopdf-win-x64_setup.exe"
            }
        }
    }
}
