{
    "version": "0.4.0",
    "description": "Windows screenshot and screen recording app with annotation, OCR, QR detection, and video editing",
    "homepage": "https://github.com/apex-shot/apexshot",
    "license": "GPL-3.0-or-later",
    "architecture": {
        "64bit": {
            "url": "https://github.com/apex-shot/apexshot/releases/download/v0.4.0/ApexShot-0.4.0-setup.exe",
            "hash": "0df36c3b883cbfb60fedd17de659cfbee3955a667f53f0304bdf462fc64fcee9"
        }
    },
    "innosetup": true,
    "shortcuts": [
        [
            "bin\\apexshot-settings.exe",
            "ApexShot"
        ]
    ],
    "post_install": [
        "if (!(Test-Path -LiteralPath \"$dir\\bin\\ffmpeg.exe\" -PathType Leaf)) { throw 'ApexShot FFmpeg executable is missing.' }",
        "& \"$dir\\bin\\ffmpeg.exe\" -hide_banner -devices *> $null",
        "if ($LASTEXITCODE -ne 0) { throw 'ApexShot FFmpeg initialization failed.' }"
    ],
    "checkver": {
        "url": "https://api.github.com/repos/apex-shot/apexshot/releases/latest",
        "jsonpath": "$.tag_name",
        "regex": "v(?<version>\\d+\\.\\d+(?:\\.\\d+)?)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/apex-shot/apexshot/releases/download/v$version/ApexShot-$version-setup.exe",
                "hash": {
                    "url": "https://api.github.com/repos/apex-shot/apexshot/releases/tags/v$version",
                    "jsonpath": "$.assets[?(@.name == '$basename')].digest"
                }
            }
        }
    },
    "notes": "Scoop does not register the apexshot:// protocol or sign-in task; configure startup from the app."
}
