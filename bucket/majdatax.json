{
    "version": "6.2.0",
    "description": "Chart editor and viewer for the rhythm game maimai. Community fork of MajdataView & MajdataEdit.",
    "homepage": "https://github.com/re-poem/MajdataViewX",
    "license": "GPL-3.0-only",
    "notes": "MajdataEdit-Neo requires the .NET 10 runtime: scoop install versions/windowsdesktop-runtime-10.0",
    "suggest": {
        ".NET 10 Runtime": "versions/windowsdesktop-runtime-10.0"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/re-poem/MajdataViewX/releases/download/v6.2.0/MajdataX-v6.2.0.zip",
            "hash": "db12cf1fb994a7a7de0aa2085589d861de84751e618bf777c45cd0ed454200c3"
        }
    },
    "pre_install": [
        "if (!(Test-Path \"$persist_dir\\Settings.json\")) {",
        "    Set-Content \"$dir\\Settings.json\" '{}' -Encoding Ascii",
        "}",
        "if (!(Test-Path \"$persist_dir\\editor.db\")) {",
        "    New-Item \"$dir\\editor.db\" -ItemType File | Out-Null",
        "}"
    ],
    "shortcuts": [
        [
            "MajdataEdit-Neo.exe",
            "MajdataEdit Neo"
        ],
        [
            "MajdataViewX.exe",
            "MajdataViewX"
        ]
    ],
    "persist": [
        "SFX",
        "Skin",
        "Record",
        ".autosave",
        "Settings.json",
        "editor.db"
    ],
    "checkver": {
        "url": "https://api.github.com/repos/re-poem/MajdataViewX/releases/latest",
        "regex": "\"browser_download_url\":\\s*\"https://[^\"]+/download/v(?<version>[\\d.]+)/(?<file>MajdataX-[^\"]+\\.zip)\""
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/re-poem/MajdataViewX/releases/download/v$version/$matchFile"
            }
        }
    }
}
