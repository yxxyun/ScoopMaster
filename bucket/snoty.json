{
    "version": "1.0.0",
    "description": "Lightweight sticky notes app with offline Whisper speech-to-text.",
    "homepage": "https://github.com/Brownfries/Snoty",
    "license": "MIT",
    "url": "https://github.com/Brownfries/Snoty/releases/download/v1.0.0/Snoty-v1.0.0-win-x64.zip",
    "hash": "67575ab6c462ec0cbf24d4aaccbbec5f7cc7e97efdd4931ba24c8fe94fbe76da",
    "persist": "data",
    "post_install": [
        "$appDataPath = Join-Path $env:APPDATA 'Snoty'",
        "$persistDataPath = Join-Path $persist_dir 'data'",
        "if (-not (Test-Path -LiteralPath $persistDataPath -PathType Container)) {",
        "    New-Item -ItemType Directory -Path $persistDataPath -Force | Out-Null",
        "}",
        "$existing = Get-Item -LiteralPath $appDataPath -Force -ErrorAction SilentlyContinue",
        "if ($null -ne $existing) {",
        "    if (($existing.Attributes -band [IO.FileAttributes]::ReparsePoint) -ne 0) {",
        "        if ($existing.LinkType -eq 'Junction' -and [IO.Path]::GetFullPath([string]$existing.Target) -ieq [IO.Path]::GetFullPath($persistDataPath)) { return }",
        "        throw ('Refusing to replace an unexpected reparse point at ' + $appDataPath)",
        "    }",
        "    $appItems = @(Get-ChildItem -LiteralPath $appDataPath -Force)",
        "    $persistItems = @(Get-ChildItem -LiteralPath $persistDataPath -Force)",
        "    if ($appItems.Count -gt 0 -and $persistItems.Count -gt 0) {",
        "        throw ('Both ' + $appDataPath + ' and ' + $persistDataPath + ' contain data; refusing to overwrite either location.')",
        "    }",
        "    if ($appItems.Count -gt 0) { $appItems | Move-Item -Destination $persistDataPath }",
        "    Remove-Item -LiteralPath $appDataPath -Force",
        "}",
        "New-Item -ItemType Junction -Path $appDataPath -Target $persistDataPath | Out-Null"
    ],
    "pre_uninstall": [
        "$appDataPath = Join-Path $env:APPDATA 'Snoty'",
        "$persistDataPath = Join-Path $persist_dir 'data'",
        "$existing = Get-Item -LiteralPath $appDataPath -Force -ErrorAction SilentlyContinue",
        "if ($null -ne $existing -and",
        "    ($existing.Attributes -band [IO.FileAttributes]::ReparsePoint) -ne 0 -and",
        "    $existing.LinkType -eq 'Junction' -and",
        "    [IO.Path]::GetFullPath([string]$existing.Target) -ieq [IO.Path]::GetFullPath($persistDataPath)) {",
        "    $removeCommand = 'rmdir \"' + $appDataPath + '\"'",
        "    & $env:ComSpec /d /c $removeCommand",
        "    if ($LASTEXITCODE -ne 0) { throw ('Failed to remove the Snoty AppData junction; cmd exit code: ' + $LASTEXITCODE) }",
        "}"
    ],
    "shortcuts": [
        [
            "Snoty.exe",
            "Snoty"
        ]
    ],
    "checkver": {
        "github": "https://github.com/Brownfries/Snoty"
    },
    "autoupdate": {
        "url": "https://github.com/Brownfries/Snoty/releases/download/v$version/Snoty-v$version-win-x64.zip",
        "hash": {
            "url": "https://api.github.com/repos/Brownfries/Snoty/releases/tags/v$version",
            "jsonpath": "$.assets[?(@.name == 'Snoty-v$version-win-x64.zip')].digest"
        }
    },
    "notes": [
        "Uses the complete x64 ZIP, including the Whisper files required for offline dictation.",
        "The %APPDATA%\\Snoty folder is redirected to Scoop persist; legacy %APPDATA%\\StickyNotes files are copied by the app on first launch."
    ]
}
