    "pre_install": [
        "$launcher = @(",
        "    '@echo off'",
        "    'powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"%~dp0Super_God_Mode.ps1\" %*'",
        ")",
        "[System.IO.File]::WriteAllLines((Join-Path $dir 'SuperGodMode-EasyLauncher.cmd'), [string[]]$launcher, [System.Text.Encoding]::ASCII)"
    ],
    "bin": [
        [
            "SuperGodMode-EasyLauncher.cmd",
            "super-god-mode-thiojoe"
        ]
    ],
    "shortcuts": [
        [
            "SuperGodMode-EasyLauncher.cmd",
            "Super God Mode - ThioJoe"
        ]
    ],
    "persist": "Super God Mode",
    "notes": "The generated `Super God Mode` folder is persisted across updates and normal uninstall. Use `scoop uninstall -p windows-super-god-mode-thiojoe` to remove it as well.",
    "checkver": {
        "url": "https://api.github.com/repos/ThioJoe/Windows-Super-God-Mode/releases/latest",
        "jsonpath": "$.tag_name",
        "regex": "^v(?<version>[\\d.]+)$"
    },
    "autoupdate": {
        "url": "https://github.com/ThioJoe/Windows-Super-God-Mode/releases/download/v$version/Super_God_Mode.ps1",
        "hash": {
            "mode": "json",
            "url": "https://api.github.com/repos/ThioJoe/Windows-Super-God-Mode/releases/tags/v$version",
            "jsonpath": "$.assets[?(@.name=='Super_God_Mode.ps1')].digest",
            "regex": "^sha256:([a-fA-F0-9]{64})$"
        }
    }
