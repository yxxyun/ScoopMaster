{
    "version": "2.1.0.0",
    "description": "Driver detection and update utility",
    "homepage": "https://www.auslogics.com/en/software/driver-updater/",
    "license": "Proprietary",
    "url": "https://downloads.auslogics.com/en/driver-updater/auslogics-driver-updater-setup.exe",
    "hash": "8F3D629618AA21A23ACBFE4640D8FFDC96B5D6E3240849F8F5EC47018F2E2F76",
    "innosetup": true,
    "bin": "DriverUpdater.exe",
    "shortcuts": [
        [
            "DriverUpdater.exe",
            "Auslogics Driver Updater"
        ]
    ],
    "checkver": {
        "script": [
            "$html = (Invoke-WebRequest -Uri 'https://www.auslogics.com/en/software/driver-updater/' -UseBasicParsing).Content",
            "$text = [System.Net.WebUtility]::HtmlDecode([regex]::Replace($html, '<[^>]+>', ' '))",
            "$text = [regex]::Replace($text, '\\s+', ' ')",
            "$match = [regex]::Match($text, '(?i)Version\\s+(?<version>\\d+(?:\\.\\d+){3})')",
            "if (-not $match.Success) { throw 'Unable to detect Auslogics Driver Updater version from the official product page.' }",
            "$match.Groups['version'].Value"
        ],
        "regex": "(?<version>\\d+(?:\\.\\d+){3})"
    },
    "autoupdate": {
        "url": "https://downloads.auslogics.com/en/driver-updater/auslogics-driver-updater-setup.exe"
    },
    "notes": [
        "Scoop extracts the official Inno Setup application payload into the app directory; it does not run the setup program.",
        "This extracts the application's installed files but does not guarantee the vendor's own portable mode or suppress any runtime requirements."
    ]
}
