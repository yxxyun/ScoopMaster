{
    "version": "1.4.3",
    "description": "Minimalist desktop GUI for sing-box — manage the runtime via the Clash API, switch selector groups, view logs and edit the config",
    "homepage": "https://github.com/noartem/vantage-box",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/noartem/vantage-box/releases/download/v1.4.3/vantage-box-portable-1.4.3.zip",
            "hash": "38d7152c539eb262c896935255e94c21c7e3f16178c967c57d53b01297c705e5"
        }
    },
    "bin": "vantage-box.exe",
    "shortcuts": [
        [
            "vantage-box.exe",
            "Vantage Box"
        ]
    ],
    "post_install": [
        "$q = [char]34",
        "$classes = [Microsoft.Win32.Registry]::CurrentUser.OpenSubKey('Software\\Classes', $true)",
        "$v = $classes.CreateSubKey('vantage')",
        "$v.SetValue('', 'URL:Vantage Box', 'String')",
        "$v.SetValue('URL Protocol', '', 'String')",
        "$c = $v.CreateSubKey('shell\\open\\command')",
        "$c.SetValue('', ($q + \"$dir\\vantage-box.exe\" + $q + ' ' + $q + 'uri' + $q + ' ' + $q + '%1' + $q), 'String')",
        "$c.Close(); $v.Close(); $classes.Close()"
    ],
    "pre_uninstall": "try { [Microsoft.Win32.Registry]::CurrentUser.DeleteSubKeyTree('Software\\Classes\\vantage', $false) } catch {}",
    "notes": "The vantage:// URI scheme is registered for the current user on install (the portable build does not self-register it, unlike the NSIS installer) and removed on uninstall. See: https://github.com/noartem/vantage-box/blob/main/API.md",
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/noartem/vantage-box/releases/download/v$version/vantage-box-portable-$version.zip"
            }
        }
    }
}
