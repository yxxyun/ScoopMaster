{
    "version": "1.5",
    "description": "Portable edition of Vovsoft Container Loading Calculator.",
    "homepage": "https://vovsoft.com/software/container-loading-calculator/",
    "license": "Proprietary",
    "url": "https://vovsoft.com/files/container-loading-calculator-portable.zip?v=1.5",
    "checkver": {
        "url": "https://vovsoft.com/download/container-loading-calculator-portable/",
        "regex": "(?is)Version\\s*(?:<[^>]*>\\s*)*:?\\s*(?:<[^>]*>\\s*)*(?<version>\\d+(?:\\.\\d+)+)"
    },
    "autoupdate": {
        "url": "https://vovsoft.com/files/container-loading-calculator-portable.zip?v=$version"
    },
    "shortcuts": [
        [
            "container.exe",
            "Vovsoft Container Loading Calculator"
        ]
    ],
    "notes": [
        "SHA-256 has not been verified; archive contents and the shortcut target have been checked."
    ],
    "pre_install": [
        "if (-not (Test-Path -LiteralPath \"$dir\\key.txt\" -PathType Leaf)) { New-Item -ItemType File -Path \"$dir\\key.txt\" | Out-Null }"
    ],
    "persist": "key.txt"
}
