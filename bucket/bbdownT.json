{
    "version": "2.1.5",
    "description": "A CLI-based Bilibili downloader. A continuation of bbdown.",
    "homepage": "https://github.com/LOVAHE/BBDownT",
    "license": "MIT",
    "suggest": {
        "FFmpeg": [
            "main/ffmpeg",
            "main/ffmpeg-essentials",
            "main/ffmpeg-shared"
        ]
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/LOVAHE/BBDownT/releases/download/v2.1.5/BBDownT_win-x64.exe#/BBDownT.exe",
            "hash": "6bb05c084399d97b8eee4f833bd7f1ab3b1ab96b76285375d73a661d178ad05d"
        },
        "arm64": {
            "url": "https://github.com/LOVAHE/BBDownT/releases/download/v2.1.5/BBDownT_win-arm64.exe#/BBDownT.exe",
            "hash": "1d92dcd36d4ab52b7c3331b66279dfe05cc9271c73939f39cd14bc51613b254f"
        }
    },
    "pre_install": [
        "@('BBDownT.archives', 'BBDownT.config', 'BBDownT.data', 'BBDownTApp.data', 'BBDownTTV.data') | ForEach-Object {",
        "    if (!(Test-Path -Path \"$persist_dir\\$_\")) {",
        "        New-Item -Path \"$dir\\$_\" -ItemType File -Force | Out-Null",
        "    }",
        "}"
    ],
    "bin": "BBDownT.exe",
    "persist": [
        "BBDownT.archives",
        "BBDownT.config",
        "BBDownT.data",
        "BBDownTApp.data",
        "BBDownTTV.data"
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/LOVAHE/BBDownT/releases/download/v$version/BBDownT_win-x64.exe#/BBDownT.exe"
            },
            "arm64": {
                "url": "https://github.com/LOVAHE/BBDownT/releases/download/v$version/BBDownT_win-arm64.exe#/BBDownT.exe"
            }
        }
    }
}
