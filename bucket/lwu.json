{
    "version": "1.0.3",
    "description": "A CLI tool to automatically update Liferay Workspace components to their latest versions",
    "homepage": "https://github.com/peterrichards-lr/liferay-workspace-updater",
    "license": "MIT",
    "url": "https://github.com/peterrichards-lr/liferay-workspace-updater/archive/refs/tags/v1.0.3.tar.gz",
    "hash": "aaf1f1566f76057b6ebeafd9dd0cc491d076f1c2d85caad7766578d294982275",
    "extract_dir": "liferay-workspace-updater-1.0.3",
    "depends": "rustup",
    "installer": {
        "script": [
            "Set-Location \"$dir\"",
            "cargo install --path . --root \"$dir\""
        ]
    },
    "bin": "bin/lwu.exe",
    "checkver": "github",
    "autoupdate": {
        "url": "https://github.com/peterrichards-lr/liferay-workspace-updater/archive/refs/tags/v$version.tar.gz",
        "extract_dir": "liferay-workspace-updater-$version",
        "hash": {
            "url": "$url",
            "mode": "download"
        }
    }
}
