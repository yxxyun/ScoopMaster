{
    "version": "1.0.4",
    "description": "A CLI tool to automatically update Liferay Workspace components to their latest versions",
    "homepage": "https://github.com/peterrichards-lr/liferay-workspace-updater",
    "license": "MIT",
    "url": "https://github.com/peterrichards-lr/liferay-workspace-updater/archive/refs/tags/v1.0.4.tar.gz",
    "hash": "a446bd6ac8ffd0a6cb08c1a475c87ec0b099bfb571d8d006cc28e97b1177c6de",
    "extract_dir": "liferay-workspace-updater-1.0.4",
    "depends": "rustup",
    "installer": {
        "script": [
            "Set-Location \"$dir\"",
            "cargo install --path . --root \"$dir\""
        ]
    },
    "bin": "bin/lwu.exe",
    "checkver": "github",
    "autoupdate": {
        "url": "https://github.com/peterrichards-lr/liferay-workspace-updater/archive/refs/tags/v$version.tar.gz",
        "extract_dir": "liferay-workspace-updater-$version",
        "hash": {
            "url": "$url",
            "mode": "download"
        }
    }
}
