{
    "version": "16.7",
    "description": "Portable edition of Vovsoft Text Edit Plus.",
    "homepage": "https://vovsoft.com/software/text-edit-plus/",
    "license": "Proprietary",
    "url": "https://vovsoft.com/files/text-edit-plus-portable.zip?v=16.7",
    "checkver": {
        "url": "https://vovsoft.com/download/text-edit-plus-portable/",
        "regex": "(?is)Version\\s*(?:<[^>]*>\\s*)*:?\\s*(?:<[^>]*>\\s*)*(?<version>\\d+(?:\\.\\d+)+)"
    },
    "autoupdate": {
        "url": "https://vovsoft.com/files/text-edit-plus-portable.zip?v=$version"
    },
    "shortcuts": [
        [
            "text.exe",
            "Vovsoft Text Edit Plus"
        ]
    ],
    "notes": [
        "SHA-256 has not been verified; archive contents and the shortcut target have been checked."
    ],
    "pre_install": [
        "if (-not (Test-Path -LiteralPath \"$dir\\key.txt\" -PathType Leaf)) { New-Item -ItemType File -Path \"$dir\\key.txt\" | Out-Null }"
    ],
    "persist": "key.txt"
}
