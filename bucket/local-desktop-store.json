{
    "version": "0.3.2",
    "description": "Private Windows app catalog sourced from GitHub Releases",
    "homepage": "https://github.com/SysAdminDoc/LocalDesktopStore",
    "license": "MIT",
    "notes": [
        "Requires the .NET 9 Desktop Runtime for Windows x64.",
        "Application data and downloaded apps are stored in '%LOCALAPPDATA%\\LocalDesktopStore' and are not portable across systems."
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/SysAdminDoc/LocalDesktopStore/releases/download/v0.3.2/LocalDesktopStore-v0.3.2-win-x64.zip",
            "hash": "a255b600f6829cdf0ef5cb051dcefd5c1c5d52165192003fa636b4dab97f2d44"
        }
    },
    "bin": "LocalDesktopStore.exe",
    "pre_install": [
        "$dotnet = Get-Command 'dotnet.exe' -ErrorAction SilentlyContinue",
        "if ($null -eq $dotnet -or -not (& $dotnet.Source --list-runtimes 2>$null | Select-String -Quiet '^Microsoft\\.WindowsDesktop\\.App 9\\.0\\.')) {",
        "    throw 'LocalDesktopStore requires the Microsoft .NET 9 Desktop Runtime (x64). Install it from https://dotnet.microsoft.com/download/dotnet/9.0/runtime, then retry.'",
        "}"
    ],
    "shortcuts": [
        [
            "LocalDesktopStore.exe",
            "LocalDesktopStore"
        ]
    ],
    "checkver": {
        "github": "https://github.com/SysAdminDoc/LocalDesktopStore"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/SysAdminDoc/LocalDesktopStore/releases/download/v$version/LocalDesktopStore-v$version-win-x64.zip",
                "hash": {
                    "url": "https://api.github.com/repos/SysAdminDoc/LocalDesktopStore/releases/tags/v$version",
                    "jsonpath": "$.assets[?(@.name == 'LocalDesktopStore-v$version-win-x64.zip')].digest"
                }
            }
        }
    }
}
