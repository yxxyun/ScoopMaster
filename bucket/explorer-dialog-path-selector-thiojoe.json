            "ExplorerDialogPathSelector_1.8.1.exe",
            "Explorer Dialog Path Selector - ThioJoe"
        ]
    ],
    "notes": "The signed EXE uses UIAccess. Because Scoop keeps it under its app directory rather than Program Files, it may not interact with elevated Open/Save dialogs. The upstream MSI installs to Program Files and creates a Startup shortcut; this manifest uses the standalone EXE and does not create that startup entry.",
    "checkver": {
        "script": [
            "$headers = @{ 'User-Agent' = 'kirobucket' }",
            "if ($env:GITHUB_TOKEN) { $headers.Authorization = \"Bearer $env:GITHUB_TOKEN\" }",
            "$release = Invoke-RestMethod -Uri 'https://api.github.com/repos/ThioJoe/ThioJoe-AHK-Scripts/releases/latest' -Headers $headers",
            "$asset = @($release.assets | Where-Object { $_.name -match '^ExplorerDialogPathSelector_[\\d.]+\\.exe$' } | Select-Object -First 1)",
            "if ($asset.Count -eq 0) { throw 'Could not find the official portable Explorer Dialog Path Selector executable.' }",
            "$match = [regex]::Match([string]$asset[0].name, '^ExplorerDialogPathSelector_(?<version>[\\d.]+)\\.exe$')",
            "if (-not $match.Success) { throw 'Could not parse the Explorer Dialog Path Selector version.' }",
            "$match.Groups['version'].Value"
        ],
        "regex": "(?<version>\\d+\\.\\d+\\.\\d+)"
    },
    "autoupdate": {
        "url": "https://github.com/ThioJoe/ThioJoe-AHK-Scripts/releases/latest/download/ExplorerDialogPathSelector_$version.exe",
        "shortcuts": [
            [
                "ExplorerDialogPathSelector_$version.exe",
                "Explorer Dialog Path Selector - ThioJoe"
            ]
        ],
        "hash": {
            "url": "https://api.github.com/repos/ThioJoe/ThioJoe-AHK-Scripts/releases/latest",
            "jsonpath": "$.assets[?(@.name == '$basename')].digest",
            "regex": "^sha256:([a-fA-F0-9]{64})$"
        }
    }
