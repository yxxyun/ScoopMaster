    "hash": "07DED7A21E553E221E8D3DA8ECB3A919F238DAB4519B1856C8FB8E1C5A1E375F",
    "innosetup": true,
    "bin": "ChillMate.exe",
    "shortcuts": [
        [
            "ChillMate.exe",
            "Auslogics ChillMate"
        ]
    ],
    "checkver": {
        "script": [
            "$html = (Invoke-WebRequest -Uri 'https://www.auslogics.com/en/software/chillmate/' -UseBasicParsing).Content",
            "$text = [System.Net.WebUtility]::HtmlDecode([regex]::Replace($html, '<[^>]+>', ' '))",
            "$text = [regex]::Replace($text, '\\s+', ' ')",
            "$match = [regex]::Match($text, '(?i)Version\\s+(?<version>\\d+(?:\\.\\d+){3})')",
            "if (-not $match.Success) { throw 'Unable to detect Auslogics ChillMate version from the official product page.' }",
            "$match.Groups['version'].Value"
        ],
        "regex": "(?<version>\\d+(?:\\.\\d+){3})"
    },
    "autoupdate": {
        "url": "https://downloads.auslogics.com/en/chillmate/auslogics-chillmate-setup.exe"
    },
    "notes": [
        "Scoop extracts the official Inno Setup application payload into the app directory; it does not run the setup program.",
        "This extracts the application's installed files but does not guarantee the vendor's own portable mode or suppress any runtime requirements."
    ]
}
