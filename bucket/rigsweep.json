{
    "version": "0.14.0",
    "description": "Frees RAM, CPU and disk on Windows dev machines: leftover dev servers and agent CLIs, node_modules, Rust target folders, package caches. Every change is reversible.",
    "homepage": "https://rigsweep.com/",
    "license": "MIT",
    "notes": [
        "RigSweep is installed for all users in Program Files by its own installer, which asks for admin rights.",
        "The installer asks whether to add a Microsoft Defender exclusion for RigSweep's folder; you can answer No.",
        "RigSweep updates itself; 'scoop update rigsweep' works too."
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/yobotn/rigsweep/releases/download/v0.14.0/RigSweep_0.14.0_x64-setup.exe#/setup.exe",
            "hash": "4977ffbae0324a3a744a0fa6f5fc3ba27e7559aed70100786ed684c795cb06a7"
        }
    },
    "installer": {
        "script": [
            "$p = Start-Process -FilePath \"$dir\\setup.exe\" -ArgumentList '/S' -Verb RunAs -Wait -PassThru",
            "if ($p.ExitCode -ne 0) { throw \"RigSweep installer exited with code $($p.ExitCode)\" }"
        ]
    },
    "uninstaller": {
        "script": [
            "$u = \"$env:ProgramFiles\\RigSweep\\uninstall.exe\"",
            "if (Test-Path $u) { Start-Process -FilePath $u -ArgumentList '/S' -Verb RunAs -Wait }"
        ]
    },
    "checkver": {
        "github": "https://github.com/yobotn/rigsweep"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/yobotn/rigsweep/releases/download/v$version/RigSweep_$version_x64-setup.exe#/setup.exe",
                "hash": {
                    "url": "https://github.com/yobotn/rigsweep/releases/download/v$version/RigSweep_$version_x64-setup.exe.sha256"
                }
            }
        }
    }
}
