{
    "version": "3.9.2.89815",
    "description": "Toolbox App. A control panel for all JetBrains tools.",
    "homepage": "https://www.jetbrains.com/toolbox-app/",
    "license": "Freeware",
    "notes": "Installed to %LOCALAPPDATA%\\JetBrains\\Toolbox by the official installer; 'scoop uninstall' runs the official Uninstall.exe and keeps the tools you installed through Toolbox.",
    "architecture": {
        "64bit": {
            "url": "https://download.jetbrains.com/toolbox/jetbrains-toolbox-3.9.2.89815.exe",
            "hash": "3ee271bcf520aa4f1d19f548ff0be5fcc5013ecdf6ffdebf7118533c0bd5db5f"
        },
        "arm64": {
            "url": "https://download.jetbrains.com/toolbox/jetbrains-toolbox-3.9.2.89815-arm64.exe",
            "hash": "9f2ef0b142d09627995e57a8acaecc152dbd18afceb58ab395ca6d44909cf76b"
        }
    },
    "installer": {
        "args": "/headless"
    },
    "uninstaller": {
        "script": [
            "$uninstallExe = \"$env:LOCALAPPDATA\\JetBrains\\Toolbox\\bin\\Uninstall.exe\"",
            "if (Test-Path $uninstallExe) {",
            "    Start-Process $uninstallExe -ArgumentList '/headless' -Wait",
            "}"
        ]
    },
    "checkver": {
        "url": "https://data.services.jetbrains.com/products/releases?code=TBA&latest=true&type=release",
        "jsonpath": "$.TBA..build"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://download.jetbrains.com/toolbox/jetbrains-toolbox-$version.exe"
            },
            "arm64": {
                "url": "https://download.jetbrains.com/toolbox/jetbrains-toolbox-$version-arm64.exe"
            }
        },
        "hash": {
            "url": "$url.sha256"
        }
    }
}
