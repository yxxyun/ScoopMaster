{
    "version": "2.22.0",
    "description": "Episodic and semantic memory MCP server and CLI",
    "homepage": "https://github.com/n24q02m/mnemo",
    "license": "Apache-2.0",
    "depends": "uv",
    "url": [
        "https://files.pythonhosted.org/packages/95/71/0b6ffcb758e19ee21548ade024aa21883c444fad5c200bad4a8f5bc1a5ea/n24q02m_mnemo-2.22.0-py3-none-any.whl#/n24q02m_mnemo-2.22.0-py3-none-any.whl",
        "https://raw.githubusercontent.com/n24q02m/scoop-bucket/main/locks/mnemo-2.22.0.txt#/requirements.txt",
        "https://raw.githubusercontent.com/n24q02m/scoop-bucket/main/locks/mnemo-2.22.0.build.txt#/build-requirements.txt"
    ],
    "hash": [
        "136862dc1f010c46e74c6cd3b7a8461e501a466fad9a71a68257c2cfe488b7fc",
        "c27bc756c8434e44130bd2dd47b41246412f5b7977268e85cbed11867b7d7726",
        "d385249d54d11125a6ff215710cc25e1fdfcee5e3cd81cb869f465dc0437ce89"
    ],
    "installer": {
        "script": [
            "# Every dependency is pinned by hash: requirements.txt is the release tag's uv.lock exported",
            "# by bump.py, build-requirements.txt the build backends of dependencies that ship only an sdist.",
            "# The lock is the release's resolved environment, uv overrides included, so there is no `uv pip check`.",
            "$py = \"$dir\\venv\\Scripts\\python.exe\"",
            "$pinned = @('--python', $py, '--require-hashes', '--only-binary', ':all:', '--no-deps', '--quiet')",
            "uv venv \"$dir\\venv\" --python 3.13 --quiet",
            "if ($LASTEXITCODE) { throw 'uv venv failed' }",
            "uv pip install @pinned -r \"$dir\\build-requirements.txt\"",
            "if ($LASTEXITCODE) { throw 'uv pip install (build backends) failed' }",
            "uv pip install @pinned --no-build-isolation -r \"$dir\\requirements.txt\"",
            "if ($LASTEXITCODE) { throw 'uv pip install (dependencies) failed' }",
            "uv pip install --python $py --no-deps --quiet (Get-ChildItem \"$dir\\*.whl\").FullName",
            "if ($LASTEXITCODE) { throw 'uv pip install (wheel) failed' }"
        ]
    },
    "bin": [
        [
            "venv\\Scripts\\mnemo.exe",
            "mnemo"
        ],
        [
            "venv\\Scripts\\n24q02m-mnemo.exe",
            "n24q02m-mnemo"
        ]
    ]
}
