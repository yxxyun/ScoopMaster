{
    "version": "1.0.2.1",
    "description": "Skins mod for Clone Hero",
    "homepage": "https://youtu.be/z2IktaEZ90A",
    "license": "Unknown",
    "url": [
        "https://github.com/arceuss/GHLarp/releases/download/v1.0.2.1/GHLarp.v1.02.1.zip#/dl.7z_",
        "https://github.com/arceuss/GHLarpThemes/archive/main.zip#/themes.7z_"
    ],
    "hash": [
        "5617429dd1f10c422d5bb796a66d7efc3fd15d7b49e1c77be4699d7e99df8a2e",
        "a6b94ee582d57f63d34760c847f9a4b9fb1032f1bb100974cd9176f04742d5f9"
    ],
    "pre_install": [
        "$clonehero = (Get-Item \"$dir\\..\\..\\clonehero\\current\" -ErrorAction SilentlyContinue).FullName",
        "Stop-Process -Name 'Clone Hero' -Force -ErrorAction SilentlyContinue",
        "if (Test-Path \"$clonehero\\Clone Hero.exe\") {",
        "   Remove-Item \"$clonehero\\ghlarp\\themes\" -Recurse -Force -ErrorAction SilentlyContinue",
        "   Expand-7zipArchive \"$dir\\dl.7z_\" \"$clonehero\" -Removal",
        "   Expand-7zipArchive \"$dir\\themes.7z_\" \"$clonehero\\ghlarp\\themes\" -ExtractDir 'GHLarpThemes-main' -Switches '-xr!.git*' -Removal",
        "} else { error 'This package requires clonehero to be installed.'; break }"
    ],
    "checkver": {
        "github": "https://api.github.com/repos/arceuss/GHLarp/releases/latest",
        "jsonpath": "$.assets[0].browser_download_url",
        "regex": "/v([\\d.]+)/GHLarp(?<suffix>[\\w._-]+).zip"
    },
    "autoupdate": {
        "url": [
            "https://github.com/arceuss/GHLarp/releases/download/v$version/GHLarp$matchSuffix.zip#/dl.7z_",
            "https://github.com/arceuss/GHLarpThemes/archive/main.zip#/themes.7z_"
        ]
    }
}
