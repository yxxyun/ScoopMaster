{
    "version": "4.3",
    "description": "Portable edition of Vovsoft OCR Reader.",
    "homepage": "https://vovsoft.com/software/ocr-reader/",
    "license": "Proprietary",
    "url": "https://vovsoft.com/files/ocr-reader-portable.zip?v=4.3",
    "checkver": {
        "url": "https://vovsoft.com/download/ocr-reader-portable/",
        "regex": "(?is)Version\\s*(?:<[^>]*>\\s*)*:?\\s*(?:<[^>]*>\\s*)*(?<version>\\d+(?:\\.\\d+)+)"
    },
    "autoupdate": {
        "url": "https://vovsoft.com/files/ocr-reader-portable.zip?v=$version"
    },
    "shortcuts": [
        [
            "ocrreader.exe",
            "Vovsoft OCR Reader"
        ]
    ],
    "pre_install": [
        "if (-not (Test-Path -LiteralPath \"$dir\\key.txt\" -PathType Leaf)) { New-Item -ItemType File -Path \"$dir\\key.txt\" | Out-Null }"
    ],
    "persist": "key.txt"
}
