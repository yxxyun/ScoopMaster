{
    "version": "2.15.0",
    "description": "Minecraft 启动器：由社区强力驱动的 PCL 二次开发版",
    "homepage": "https://pcl-community.github.io/PCL2-CE-Web/",
    "license": "https://github.com/PCL-Community/PCL-CE/blob/dev/LICENCE",
    "architecture": {
        "64bit": {
            "url": "https://github.com/PCL-Community/PCL-CE/releases/download/v2.15.0/PCL2_CE_Release_x64.exe",
            "hash": "39e0f0613902241d448f901d4be9bf2da2f366ed2a5e0a6518a413de4bfbe992"
        },
        "arm64": {
            "url": "https://github.com/PCL-Community/PCL-CE/releases/download/v2.15.0/PCL2_CE_Release_ARM64.exe",
            "hash": "539f4e90b65fca74196e69e715698c263a752730c1fb7617f858a3768ede6cf8"
        }
    },
    "persist": [
        "PCL",
        ".minecraft"
    ],
    "shortcuts": [
        [
            "PCL2_CE.exe",
            "PCL2_CE"
        ]
    ],
    "installer": {
        "script": [
            "if ($architecture -eq '64bit') {",
            "    Rename-Item \"$dir\\PCL2_CE_Release_x64.exe\" 'PCL2_CE.exe' -ErrorAction SilentlyContinue",
            "} else {",
            "    Rename-Item \"$dir\\PCL2_CE_Release_ARM64.exe\" 'PCL2_CE.exe' -ErrorAction SilentlyContinue",
            "}",
            "$target = \"$env:APPDATA\\PCLCE\"",
            "$source = \"$persist_dir\\PCLCE\"",
            "if (-not (Test-Path $source)) { New-Item -Path $source -ItemType Directory -Force | Out-Null }",
            "if (Test-Path $target) {",
            "    $item = Get-Item $target -ErrorAction SilentlyContinue",
            "    if ($item.LinkType -eq 'Junction') {",
            "        Remove-Item $target -Force",
            "    } else {",
            "        Get-ChildItem $target -Force | Move-Item -Destination $source -Force",
            "        Remove-Item $target -Force -Recurse",
            "    }",
            "}",
            "New-Item -Path $target -ItemType Junction -Value $source -Force | Out-Null"
        ]
    },
    "uninstaller": {
        "script": [
            "$target = \"$env:APPDATA\\PCLCE\"",
            "if (Test-Path $target) {",
            "    $item = Get-Item $target -ErrorAction SilentlyContinue",
            "    if ($item.LinkType -eq 'Junction') {",
            "        Remove-Item $target -Force",
            "    }",
            "}"
        ]
    },
    "checkver": {
        "github": "https://github.com/PCL-Community/PCL-CE"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/PCL-Community/PCL-CE/releases/download/v$version/PCL2_CE_Release_x64.exe"
            },
            "arm64": {
                "url": "https://github.com/PCL-Community/PCL-CE/releases/download/v$version/PCL2_CE_Release_ARM64.exe"
            }
        }
    }
}
