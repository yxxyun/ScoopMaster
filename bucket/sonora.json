{
    "version": "0.40.0",
    "description": "A native music streaming client, built with Rust and GPUI",
    "homepage": "https://sonorahq.org/",
    "license": "GPL-3.0-or-later",
    "architecture": {
        "64bit": {
            "url": "https://github.com/sonorahq/sonora/releases/download/v0.40.0/sonora-v0.40.0-x86_64-pc-windows-msvc.exe",
            "hash": "67bc41c9cf990483788e8bc953be1ce3593eedd3ee7a501d928ff2dcb749dfcd"
        }
    },
    "pre_install": "Get-ChildItem \"$dir\" -Filter \"sonora-*.exe\" | Rename-Item -NewName \"sonora.exe\"",
    "post_install": [
        "$links = @{ \"$env:LOCALAPPDATA\\sonora\" = \"$persist_dir\\data\"; \"$env:APPDATA\\sonora\" = \"$persist_dir\\config\" }",
        "foreach ($link in $links.Keys) {",
        "    $target = $links[$link]",
        "    New-Item -ItemType Directory -Path $target -Force | Out-Null",
        "    $item = Get-Item $link -Force -ErrorAction SilentlyContinue",
        "    if ($item -and $item.LinkType) { [System.IO.Directory]::Delete($link) }",
        "    elseif ($item) {",
        "        Copy-Item -Path \"$link\\*\" -Destination $target -Force -Recurse -ErrorAction SilentlyContinue",
        "        Remove-Item $link -Force -Recurse",
        "    }",
        "    New-Item -ItemType Junction -Path $link -Target $target | Out-Null",
        "}"
    ],
    "uninstaller": {
        "script": [
            "foreach ($link in \"$env:LOCALAPPDATA\\sonora\", \"$env:APPDATA\\sonora\") {",
            "    $item = Get-Item $link -Force -ErrorAction SilentlyContinue",
            "    if ($item -and $item.LinkType) { [System.IO.Directory]::Delete($link) }",
            "}"
        ]
    },
    "bin": "sonora.exe",
    "shortcuts": [
        [
            "sonora.exe",
            "Sonora"
        ]
    ],
    "checkver": {
        "url": "https://api.github.com/repos/sonorahq/sonora/releases",
        "jsonpath": "$[0].tag_name",
        "regex": "v?([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/sonorahq/sonora/releases/download/v$version/sonora-v$version-x86_64-pc-windows-msvc.exe"
            }
        }
    }
}
