{
    "version": "7.02",
    "description": "Windows startup manager for reviewing and controlling auto-start entries",
    "homepage": "https://www.chemtable.com/autorun-organizer.htm",
    "license": "Proprietary",
    "url": "https://files.chemtable.com/ao/autorun-organizer-setup.exe",
    "hash": "85BE6F0FC4AFF9BB874E946186301E5509FBF1E1996A9F8DDD75D7FFD9FC165F",
    "innosetup": true,
    "bin": "AutorunOrganizer,1.exe",
    "shortcuts": [
        [
            "AutorunOrganizer,1.exe",
            "ChemTable Autorun Organizer"
        ]
    ],
    "checkver": {
        "script": [
            "$html = (Invoke-WebRequest -Uri 'https://www.chemtable.com/autorun-organizer.htm' -UseBasicParsing).Content",
            "$text = [System.Net.WebUtility]::HtmlDecode([regex]::Replace($html, '<[^>]+>', ' '))",
            "$text = [regex]::Replace($text, '\\s+', ' ')",
            "$match = [regex]::Match($text, '(?i)\\bAutorun Organizer\\s+(?<version>\\d+(?:\\.\\d+){1,3})')",
            "if (-not $match.Success) { throw 'Unable to detect the Autorun Organizer version from the official ChemTable product page.' }",
            "$match.Groups['version'].Value"
        ],
        "regex": "(?<version>\\d+(?:\\.\\d+){1,3})"
    },
    "autoupdate": {
        "url": "https://files.chemtable.com/ao/autorun-organizer-setup.exe"
    },
    "notes": "Scoop extracts the official Inno Setup payload into the app directory instead of executing the installer; installer-registered shell integration or machine-wide components are not installed."
}
