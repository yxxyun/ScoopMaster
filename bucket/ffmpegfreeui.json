    "persist": "Settings.json",
    "checkver": {
        "github": "https://github.com/Lake1059/FFmpegFreeUI",
        "regex": "(?:/releases/tag/|^)([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
