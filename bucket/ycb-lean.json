{
    "version": "1.0.26",
    "description": "less portable YourCopilotBrowser package skipping the .NET 8 Desktop Runtime files",
    "homepage": "https://github.com/Tomcreations/YourCopilotBrowser",
    "license": "unknown",
    "notes": "Requires Microsoft Edge WebView2 Runtime, normally preinstalled on Windows alongside Edge.",
    "url": "https://github.com/Tomcreations/YourCopilotBrowser/releases/download/v1.0.26/YCB-Setup.exe#/dl.7z",
    "hash": "f3272b86fbeaa2899bd7f7ab4484130def39b35d784d7d9c320cca7a8edef02a",
    "pre_install": [
        "# -----------------------------",
        "# Prevent install if the required .NET Desktop Runtime is not present",
        "$runtimeConfigPath = Join-Path $dir 'YCB.runtimeconfig.json'",
        "$runtimeConfig = Get-Content $runtimeConfigPath -Raw | ConvertFrom-Json",
        "$runtimeOptions = $runtimeConfig.runtimeOptions",
        "$desktopFramework = @(",
        "    $runtimeOptions.includedFrameworks |",
        "        Where-Object Name -eq 'Microsoft.WindowsDesktop.App'",
        ")[0]",
        "$minimumVersion = [version]$desktopFramework.version",
        "$requiredMajorMinor = [regex]::Escape(\"$($minimumVersion.Major).$($minimumVersion.Minor)\")",
        "$installedVersion = & dotnet --list-runtimes 2>$null |",
        "    Where-Object { $_ -match \"^Microsoft\\.WindowsDesktop\\.App\\s+($requiredMajorMinor\\.\\d+)\" } |",
        "    ForEach-Object { [version]$matches[1] } |",
        "    Where-Object { $_.Build -ge $minimumVersion.Build }",
        "if (-not $installedVersion) {",
        "    Write-Host \"YCB Lean requires the .NET Desktop Runtime version $minimumVersion or later (x64).\"",
        "    Write-Host 'Download it from: https://dotnet.microsoft.com/en-us/download/dotnet/8.0'",
        "    throw \".NET Desktop Runtime $minimumVersion or later (x64) was not found.\"",
        "}",
        "# -----------------------------",
        "# Convert the runtimeconfig to framework-dependent",
        "$runtimeOptions.PSObject.Properties.Remove('includedFrameworks')",
        "$runtimeOptions | Add-Member -NotePropertyName frameworks -NotePropertyValue @($desktopFramework)",
        "$runtimeConfig | ConvertTo-Json -Depth 100 | Set-Content $runtimeConfigPath -Encoding UTF8",
        "# -----------------------------",
        "# Identify bundled runtime files",
        "$depsPath = Join-Path $dir 'YCB.deps.json'",
        "$deps = Get-Content $depsPath -Raw | ConvertFrom-Json",
        "$runtimeFiles = @(",
        "    $deps.targets.PSObject.Properties |",
        "        ForEach-Object {",
        "            $_.Value.PSObject.Properties |",
        "                Where-Object Name -like 'runtimepack.*' |",
        "                ForEach-Object {",
        "                    $_.Value.PSObject.Properties |",
        "                        Where-Object { $_.Name -in @('runtime', 'native') } |",
        "                        ForEach-Object { $_.Value.PSObject.Properties.Name }",
        "                }",
        "        }",
        ") | Select-Object -Unique",
        "# -----------------------------",
        "# Remove bundled runtime files",
        "$runtimeFiles | ForEach-Object {",
        "    Remove-Item (Join-Path $dir $_) -Force",
        "}",
        "Remove-Item (Join-Path $dir 'runtimes') -Recurse -Force",
        "# ----------------------------- ",
        "# Remove installer and documentation files",
        "Remove-Item (Join-Path $dir 'Uninstall.exe') -Force",
        "Remove-Item (Join-Path $dir 'Microsoft.Web.WebView2.*.xml') -Force",
        "Get-ChildItem -LiteralPath $dir -Force |",
        "    Where-Object { $_.Name.StartsWith('$') } |",
        "    Remove-Item -Recurse -Force",
        "# ----------------------------- ",
        "# Remove runtime-pack metadata",
        "foreach ($target in $deps.targets.PSObject.Properties) {",
        "    @($target.Value.PSObject.Properties |",
        "        Where-Object Name -like 'runtimepack.*') |",
        "        ForEach-Object {",
        "            $deps.libraries.PSObject.Properties.Remove($_.Name)",
        "            $target.Value.PSObject.Properties.Remove($_.Name)",
        "        }",
        "}",
        "$deps | ConvertTo-Json -Depth 100 |",
        "    Set-Content $depsPath -Encoding UTF8",
        "# -----------------------------",
        "# Remove runtime localization directories",
        "Get-ChildItem -Path $dir -Directory |",
        "    Where-Object { $_.Name -cmatch '^[a-z]{2}(?:-[A-Z][A-Za-z]+)?$' } |",
        "    Remove-Item -Recurse -Force"
    ],
    "bin": "YCB.exe",
    "shortcuts": [
        [
            "YCB.exe",
            "YCB"
        ]
    ],
    "checkver": {
        "github": "https://github.com/Tomcreations/YourCopilotBrowser"
    },
    "autoupdate": {
        "url": "https://github.com/Tomcreations/YourCopilotBrowser/releases/download/v$version/YCB-Setup.exe#/dl.7z",
        "hash": {
            "url": "https://api.github.com/repos/Tomcreations/YourCopilotBrowser/releases/tags/v$version",
            "jsonpath": "$.assets[?(@.name == 'YCB-Setup.exe')].digest"
        }
    }
}
