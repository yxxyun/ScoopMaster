{
    "version": "3.5.0",
    "description": "m3u8[m3u8-downloader] 视频在线提取工具 流媒体下载 m3u8下载 桌面客户端 windows mac",
    "homepage": "https://downloader.caorushizi.cn/guides.html?form=github",
    "license": {
        "identifier": "MIT license",
        "url": "https://github.com/mediago-dev/mediago#MIT-1-ov-file"
    },
    "notes": [
        "数据目录不在安装目录：Electron 用户数据（Local Storage / IndexedDB / Partitions / Cache）在 %APPDATA%\\mediago，应用自身数据（app.db、logs）在 %APPDATA%\\mediago-community。本清单把两者都链接到 persist\\mediago，所以升级和 'scoop uninstall mediago'（不带 -p）都不会丢数据；加 -p 会连数据一起删除。",
        "3.5.0 起应用数据根目录改为 %APPDATA%\\mediago-community（含 app.db、config.json、logs 与 tasks 日志），旧版本的数据（%APPDATA%\\mediago 及其 AppData 子目录）不会被新版本自动读取。旧文件仍保留在 persist\\mediago 下，需要沿用可手工复制到 persist\\mediago\\mediago-community\\app.db。"
    ],
    "url": "https://github.com/mediago-dev/mediago/releases/download/v3.5.0/mediago-community-setup-win32-x64-3.5.0.exe#/dl.7z",
    "hash": "sha512:f968fe16293c17c0e7a3ae33b832e7d5a8761751b60f20ceb52c5c09f4c6371ea34b38ac7cc52dda0950e59fcb464f4545fb599bfd89b46e5f3f28ad33a7eaec",
    "pre_install": [
        "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-64.7z\" \"$dir\"",
        "Remove-Item \"$dir\\`$*\" -Force -Recurse"
    ],
    "installer": {
        "script": [
            "# 把 Electron 用户数据与应用数据目录重定向到 persist，升级/卸载（不带 -p）不丢数据；重复执行无副作用",
            "$links = @(",
            "    @{ Path = \"$env:APPDATA\\mediago\"; Target = \"$persist_dir\" },",
            "    @{ Path = \"$env:APPDATA\\mediago-community\"; Target = \"$persist_dir\\mediago-community\" }",
            ")",
            "foreach ($l in $links) {",
            "    if (-not (Test-Path $l.Target)) { New-Item $l.Target -ItemType Directory -Force | Out-Null }",
            "    if (Test-Path $l.Path) {",
            "        $item = Get-Item $l.Path -Force",
            "        if ($item.LinkType -eq 'Junction' -and (Resolve-Path -Path @($item.Target)[0] -ErrorAction SilentlyContinue).Path -eq (Resolve-Path -Path $l.Target).Path) { continue }",
            "        if ($item.LinkType) {",
            "            Remove-Item $l.Path -Force -Recurse",
            "        } elseif (-not (Get-ChildItem $l.Target -Force)) {",
            "            Remove-Item $l.Target -Force -Recurse",
            "            Move-Item $l.Path $l.Target",
            "        } else {",
            "            Move-Item $l.Path \"$($l.Path).old\" -Force -ErrorAction SilentlyContinue",
            "        }",
            "    }",
            "    New-Item $l.Path -ItemType Junction -Target $l.Target | Out-Null",
            "}"
        ]
    },
    "uninstaller": {
        "script": [
            "foreach ($l in @(\"$env:APPDATA\\mediago\", \"$env:APPDATA\\mediago-community\")) {",
            "    if ((Get-Item $l -Force -ErrorAction SilentlyContinue).LinkType -eq 'Junction') { Remove-Item $l -Force -Recurse }",
            "}"
        ]
    },
    "bin": [
        [
            "mediago-community.exe",
            "mediago"
        ]
    ],
    "shortcuts": [
        [
            "mediago-community.exe",
            "mediago"
        ]
    ],
    "checkver": {
        "url": "https://api.github.com/repos/mediago-dev/mediago/releases/latest",
        "regex": "/releases/tag/v([\\d.]+)"
    },
    "autoupdate": {
        "url": "https://github.com/mediago-dev/mediago/releases/download/v$version/mediago-community-setup-win32-x64-$version.exe#/dl.7z",
        "hash": {
            "url": "$baseurl/latest.yml",
            "regex": "(?sm)$basename.*?sha512:\\s+$base64"
        }
    }
}
