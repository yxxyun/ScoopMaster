{
    "version": "2026-11-14",
    "description": "Keyboard and mouse macro automation tool.",
    "homepage": "https://github.com/ChiyukiGana/Quickinput",
    "license": "GPL-3.0-only",
    "architecture": {
        "64bit": {
            "url": "https://github.com/ChiyukiGana/Quickinput/releases/download/2026-11-14/Quickinput_2026-11-14.7z",
            "hash": "2d08d3d666b08647aab33c4979c444b536fa1253d4618ad28e46340d2602615f"
        }
    },
    "pre_install": [
        "if (!(Test-Path \"$persist_dir\\QuickInput.json\")) {",
        "    Set-Content -LiteralPath \"$dir\\QuickInput.json\" -Value '{}' -Encoding UTF8",
        "}",
        "if (!(Test-Path \"$persist_dir\\QuickInput.var\")) {",
        "    New-Item -Path \"$dir\\QuickInput.var\" -ItemType File -Force | Out-Null",
        "}"
    ],
    "bin": [
        [
            "QuickInput.exe",
            "quickinput"
        ]
    ],
    "shortcuts": [
        [
            "QuickInput.exe",
            "QuickInput"
        ]
    ],
    "persist": [
        "QuickInput.json",
        "QuickInput.var",
        "macro",
        "lang",
        "style",
        "OCR"
    ],
    "checkver": {
        "url": "https://api.github.com/repos/ChiyukiGana/Quickinput/releases/latest",
        "jsonpath": "$.tag_name",
        "regex": "^(\\d{4}-\\d{1,2}-\\d{1,2})$"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/ChiyukiGana/Quickinput/releases/download/$version/Quickinput_$version.7z"
            }
        }
    }
}
