{
    "version": "0.0.1",
    "description": "Warm your screen at night, from the tray, like f.lux",
    "homepage": "https://github.com/kidchenko/luz",
    "license": "MIT",
    "notes": "Luz lives in the tray. Quit it from its menu before running `scoop update` or `scoop uninstall`.",
    "architecture": {
        "64bit": {
            "url": "https://github.com/kidchenko/luz/releases/download/v0.0.1/luz-0.0.1-x64.exe#/luz.exe",
            "hash": "1f57a05a0715c52256c280012703d2e69cb0fa712c9845f0f0bb28c2833af1a9"
        }
    },
    "shortcuts": [
        [
            "luz.exe",
            "Luz"
        ]
    ],
    "uninstaller": {
        "script": [
            "# Run at login points at this install; settings in $env:APPDATA\\Luz are kept.",
            "if ($cmd -eq 'uninstall') { Remove-ItemProperty -Path 'HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Run' -Name 'Luz' -ErrorAction SilentlyContinue }"
        ]
    },
    "checkver": {
        "github": "https://github.com/kidchenko/luz"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/kidchenko/luz/releases/download/v$version/luz-$version-x64.exe#/luz.exe"
            }
        },
        "hash": {
            "url": "$baseurl/SHA256SUMS.txt"
        }
    }
}
