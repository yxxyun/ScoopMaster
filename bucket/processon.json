{
    "version": "5.14.25",
    "description": "ProcessOn is a free online flowchart, mind map, and collaborative diagram tool",
    "homepage": "https://www.processon.com",
    "license": "Freeware",
    "url": "https://pocdn.processon.com/pc_client/po/ProcessOn_5.14.25.exe",
    "hash": "241a6d55d681d5d3047df544b6df7fc56a928f9ef12d20657ed53ff27c94476f",
    "pre_install": "if (!(Test-Path \"$persist_dir\\user_data\")) { New-Item -Path \"$persist_dir\\user_data\" -ItemType Directory | Out-Null }",
    "installer": {
        "script": [
            "$archive = Get-ChildItem \"$dir\" -Filter '*.exe' | Select-Object -First 1",
            "if ($archive) {",
            "  Invoke-ExternalCommand 7z -ArgumentList 'x \"-o$dir\" \"$($archive.FullName)\" -y' | Out-Null",
            "  Remove-Item \"$($archive.FullName)\" -Force",
            "}"
        ]
    },
    "shortcuts": [
        [
            "ProcessOn.exe",
            "ProcessOn"
        ]
    ],
    "persist": "user_data",
    "notes": [
        "ProcessOn is a free online flowchart, mind map, and diagram tool.",
        "Visit https://www.processon.com for more information."
    ],
    "checkver": {
        "url": "https://www.processon.com/download",
        "regex": "ProcessOn_([\\d.]+)\\.exe"
    },
    "autoupdate": {
        "url": "https://pocdn.processon.com/pc_client/po/ProcessOn_$version.exe"
    }
}
