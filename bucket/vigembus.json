        ]
    },
    "uninstaller": {
        "script": "$exe = Get-ChildItem \"$dir\\ViGEmBus_*_x64_x86_arm64.exe\" -ErrorAction SilentlyContinue | Select-Object -First 1; if ($exe) { Start-Process -FilePath $exe.FullName -ArgumentList '/uninstall', '/quiet' -Wait }"
