{
    "version": "1.1.0",
    "description": "面向开发者与 AI Agent 的开源流量调试工作台，可筛选业务异常、修改请求并分享排查现场",
    "homepage": "https://github.com/Yricky/proxycrab",
    "license": "MIT",
    "notes": [
        "ProxyCrab 是 MITM 代理工作台，抓包需要把系统或目标应用的代理指向本机监听端口",
        "HTTPS 解密需要安装它自签的根证书，证书在应用内的证书管理里导出",
        "数据目录：%APPDATA%\\me.yricky.proxycrab\\，内含 workspace（会话与请求记录）、skill-paths.json（技能安装路径）",
        "本包将该目录持久化到 persist，并在原路径创建 Junction 指向 persist",
        "工作区可在应用内切换到其它磁盘目录，切换后的目录不在本包的持久化范围内"
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/Yricky/proxycrab/releases/download/v1.1.0/proxy-crab-t_1.1.0_x64-setup.exe#/dl.7z",
            "hash": "94c1bed2ee41624bdc0149e7add43fac4502a2ef046cee63d8516db7cd5a7ae1",
            "pre_install": "Remove-Item \"$dir\\`$*\" -Force -Recurse -ErrorAction SilentlyContinue"
        }
    },
    "shortcuts": [
        [
            "proxy-crab-t.exe",
            "ProxyCrab"
        ]
    ],
    "post_install": [
        "$source = Join-Path $env:APPDATA 'me.yricky.proxycrab'",
        "$target = Join-Path $persist_dir 'data'",
        "ensure $target",
        "",
        "if (Test-Path $source) {",
        "    $item = Get-Item -LiteralPath $source -Force",
        "    if ($item.Attributes -band [IO.FileAttributes]::ReparsePoint) {",
        "        Write-Host \"检测到已存在的联接点：$source，跳过创建\"",
        "        return",
        "    }",
        "    if (-not $item.PSIsContainer) {",
        "        throw \"配置路径已存在且不是目录：$source\"",
        "    }",
        "",
        "    & robocopy $source $target /E /R:1 /W:1 /NFL /NDL /NJH /NJS /NP | Out-Null",
        "    if ($LASTEXITCODE -gt 7) {",
        "        Write-Host \"迁移失败，保留原目录：$source\"",
        "        return",
        "    }",
        "",
        "    $backup = \"$source.backup-$(Get-Date -Format 'yyyyMMdd-HHmmss')\"",
        "    try {",
        "        Move-Item -LiteralPath $source -Destination $backup -Force",
        "        Write-Host \"已备份原配置目录：$backup\"",
        "    } catch {",
        "        Write-Host \"无法重命名原目录：$source\"",
        "        return",
        "    }",
        "}",
        "",
        "New-Item -Path $source -ItemType Junction -Value $target | Out-Null"
    ],
    "persist": "data",
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/Yricky/proxycrab/releases/download/v$version/proxy-crab-t_$version_x64-setup.exe#/dl.7z"
            }
        }
    }
}
