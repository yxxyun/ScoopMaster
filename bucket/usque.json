            "hash": "f6f7f0a1a2bc9bcc15cf563ec1f892d00690a92c086b23ed3211b802209099e7"
        },
        "32bit": {
            "url": "https://github.com/Diniboy1123/usque/releases/download/v4.2.1/usque_4.2.1_windows_386.zip",
            "hash": "be50fb3d9970d5356733ad41ab2a33b932eb1a1b7582062ddc40b5f6e95e1167"
        },
        "arm64": {
            "url": "https://github.com/Diniboy1123/usque/releases/download/v4.2.1/usque_4.2.1_windows_arm64.zip",
            "hash": "52f62bc45dc7b0a1910c92f76286d1970b8ca76a4aee1aa62de22140f02af131"
        }
    },
    "pre_install": "if (!(Test-Path \"$persist_dir\\config.json\")) { New-Item \"$dir\\config.json\" -ItemType File | Out-Null }",
