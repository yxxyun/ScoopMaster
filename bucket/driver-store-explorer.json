{
    "$schema": "https://raw.githubusercontent.com/lukesampson/scoop/master/schema.json",
    "description": "DEPRECATED: use extras/driverstoreexplorer instead. Driver Store Explorer [RAPR] makes it easier to deal with Windows driver store. Supported operations include list/add/install/delete third-party driver packages.",
    "license": "GPL-2.0-only",
    "hash": "b1c4351086d332173cdd6c7b9a12e742d7662ede4bac3a5a19a215cf6656201b",
    "url": "https://github.com/lostindark/DriverStoreExplorer/releases/download/v1.0.28/DriverStoreExplorer-v1.0.28.zip",
    "version": "1.0.28",
    "homepage": "https://github.com/lostindark/DriverStoreExplorer",
    "pre_install": [
        "if (Test-Path \"$dir\\Rapr.log\" -PathType Container) { Remove-Item \"$dir\\Rapr.log\" }",
        "if (Test-Path \"$persist_dir\\Rapr.log\" -PathType Container) { Remove-Item \"$persist_dir\\Rapr.log\" }",
        "if (!(Test-Path \"$dir\\Rapr.log\")) { New-Item \"$dir\\Rapr.log\" -ItemType file | Out-Null }"
    ],
    "bin": "rapr.exe",
    "notes": "DEPRECATED: use extras/driverstoreexplorer instead.",
    "shortcuts": [
        [
            "rapr.exe",
            "Driver Store Explorer (RAPR)"
        ]
    ],
    "persist": [
        "Rapr.exe.config",
        "Rapr.log"
    ],
    "checkver": "github",
    "autoupdate": {
        "url": "https://github.com/lostindark/DriverStoreExplorer/releases/download/v$version/DriverStoreExplorer-v$version.zip"
    }
}
