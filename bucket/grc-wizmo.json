{
    "version": "2008.06.25",
    "description": "GRC Wizmo: Command-line Windows utility for display power, screen savers, audio control, shutdown, and other desktop commands.",
    "homepage": "https://www.grc.com/wizmo/wizmo.htm",
    "license": "Freeware",
    "url": "https://www.grc.com/files/wizmo.exe",
    "bin": "wizmo.exe",
    "shortcuts": [
        [
            "wizmo.exe",
            "GRC Wizmo"
        ]
    ],
    "notes": [
        "GRC does not publish a static SHA-256 checksum for this download. The manifest omits hash rather than inventing a value.",
        "Legacy utility with commands that can power off displays or shut down/restart Windows."
    ],
    "checkver": {
        "script": [
            "$html = (Invoke-WebRequest -Uri 'https://www.grc.com/wizmo/wizmo.htm' -UseBasicParsing).Content",
            "$text = [System.Net.WebUtility]::HtmlDecode([regex]::Replace($html, '<[^>]+>', ' '))",
            "$text = [regex]::Replace($text, '\\s+', ' ')",
            "$match = [regex]::Match($text, '(?is)File stats for:\\s*Wizmo.{0,1800}?Last\\s+Updated:\\s*Size:\\s*[\\d.,]+\\s*[kKmM]?\\s+(?<date>[A-Za-z]{3}\\s+\\d{1,2},\\s+\\d{4})\\s+at\\b')",
            "if (-not $match.Success) { throw 'Unable to read the published Last Updated date for Wizmo.' }",
            "[DateTime]::ParseExact($match.Groups['date'].Value, 'MMM d, yyyy', [Globalization.CultureInfo]::InvariantCulture).ToString('yyyy.MM.dd')"
        ],
        "regex": "(?<version>\\d{4}\\.\\d{2}\\.\\d{2})"
    },
    "autoupdate": {
        "url": "https://www.grc.com/files/wizmo.exe"
    }
}
