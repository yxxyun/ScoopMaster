{
    "version": "0.1.10",
    "description": "Standalone GUI file manager for Windows that lets you edit the filesystem tree like a Neovim buffer",
    "homepage": "https://github.com/sg004baa/fyler.windows",
    "license": "MIT OR Apache-2.0",
    "architecture": {
        "64bit": {
            "url": "https://github.com/sg004baa/fyler.windows/releases/download/v0.1.10/fyler-v0.1.10-windows-x64-portable.zip",
            "hash": "834d7471e7685fcce50861f6c445f344819c6054a6330e49f199e100de9620de",
            "extract_dir": "fyler"
        }
    },
    "bin": "fyler.exe",
    "shortcuts": [
        [
            "fyler.exe",
            "fyler"
        ]
    ],
    "notes": [
        "Neovim is bundled inside the app directory; no separate nvim installation is required.",
        "User data lives outside the Scoop app directory and survives updates:",
        "%APPDATA%\\fyler = config.toml, keymaps, bookmarks, recent roots, session.",
        "%LOCALAPPDATA%\\fyler = undo journal and backup payloads.",
        "'scoop uninstall fyler' does not remove them; delete those folders manually for a full cleanup."
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/sg004baa/fyler.windows/releases/download/v$version/fyler-v$version-windows-x64-portable.zip"
            }
        },
        "hash": {
            "url": "$url.sha256"
        }
    }
}
