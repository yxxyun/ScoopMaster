{
    "##": "Portable extraction from the official Inno Setup package. Scoop's persist feature keeps the application data; the vendor setup is not executed.",
    "version": "0.1.2",
    "description": "Windows disk-space monitor that records free-space changes, storage growth, and the processes writing to disk.",
    "homepage": "https://github.com/AnwarRezk/disk-monitor",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/AnwarRezk/disk-monitor/releases/download/v0.1.2/DiskDrift-Setup-0.1.2.exe",
            "hash": "6a9b655af7d6b7341c9446cda9a214a6ecda47236e645aad2de8f14dd466177c"
        }
    },
    "innosetup": true,
    "post_install": [
        "$configPath = Join-Path $dir 'Collector\\appsettings.json'",
        "if (-not (Test-Path -LiteralPath $configPath -PathType Leaf)) { throw \"DiskDrift configuration file was not found: $configPath\" }",
        "$config = Get-Content -LiteralPath $configPath -Raw | ConvertFrom-Json",
        "$config.DiskDrift.DataDirectory = Join-Path $persist_dir 'data'",
        "$configJson = $config | ConvertTo-Json -Depth 100",
        "[System.IO.File]::WriteAllText($configPath, $configJson + [Environment]::NewLine, [System.Text.UTF8Encoding]::new($false))"
    ],
    "persist": [
        "data"
    ],
    "bin": [
        [
            "Collector\\DiskDrift.Collector.exe",
            "diskdrift-collector"
        ],
        [
            "Tray\\DiskDrift.Tray.exe",
            "diskdrift"
        ]
    ],
    "shortcuts": [
        [
            "Tray\\DiskDrift.Tray.exe",
            "DiskDrift"
        ]
    ],
    "checkver": {
        "github": "https://github.com/AnwarRezk/disk-monitor"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/AnwarRezk/disk-monitor/releases/download/v$version/DiskDrift-Setup-$version.exe",
                "hash": {
                    "mode": "github"
                }
            }
        }
    },
    "notes": [
        "Run `diskdrift-collector` from an elevated PowerShell window and keep it open; launch the dashboard with `diskdrift`. Data is stored in Scoop's persistent `data` directory."
    ]
}
