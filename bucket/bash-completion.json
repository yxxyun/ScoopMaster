{
    "version": "2.18.0",
    "description": "Programmable completion functions for bash",
    "homepage": "https://github.com/scop/bash-completion",
    "license": "GPL-2.0-or-later",
    "url": "https://github.com/scop/bash-completion/releases/download/2.18.0/bash-completion-2.18.0.tar.xz",
    "hash": "sha256:88bcf85124f77f74f2f2f8bcd16ac4382d807a827ede742a64940c7116aea33f",
    "extract_dir": "bash-completion-2.18.0",
    "notes": [
        "bash-completion is configured in your ~/.bashrc (if not already present).",
        "Run 'source ~/.bashrc' or open a new shell to enable it."
    ],
    "post_install": [
        "$template = Join-Path $dir 'bash_completion.sh.in'",
        "$target = Join-Path $dir 'bash_completion.sh'",
        "$root = Split-Path $dir -Parent",
        "$bashRoot = '/' + $root.Substring(0,1).ToLower() + ($root.Substring(2) -replace '\\\\','/')",
        "$bashDir = $bashRoot + '/current'",
        "$content = Get-Content -Raw $template",
        "$content = $content -replace '@datadir@/@PACKAGE@', $bashDir",
        "$content | Set-Content -NoNewline $target",
        "",
        "# 定位 ~/.bashrc（优先 HOME，回退 USERPROFILE）",
        "$homeDir = if ($env:HOME) { $env:HOME } else { $env:USERPROFILE }",
        "$bashrc = Join-Path $homeDir '.bashrc'",
        "$sourceLine = '. \"' + $bashDir + '/bash_completion.sh\"'",
        "",
        "# 若 ~/.bashrc 不存在则新建",
        "if (-not (Test-Path $bashrc)) {",
        "    New-Item -ItemType File -Path $bashrc -Force | Out-Null",
        "    Write-Host \"Created $bashrc\"",
        "}",
        "",
        "# 读取现有内容",
        "$bashrcContent = Get-Content -Raw $bashrc -ErrorAction SilentlyContinue",
        "if ($null -eq $bashrcContent) { $bashrcContent = '' }",
        "$lines = @(Get-Content -Path $bashrc -ErrorAction SilentlyContinue)",
        "",
        "# 需要写入的完整配置块",
        "$configLines = @(",
        "    '# bash-completion',",
        "    $sourceLine,",
        "    'shopt -s completion_strip_exe',",
        "    'EXECIGNORE=*.dll:*.config:*.manifest:*.msc'",
        ")",
        "",
        "# 逐行检查缺失项（整行相等比较，避免注释行误判）",
        "$missing = @($configLines | Where-Object { $lines -notcontains $_ })",
        "",
        "if ($missing.Count -eq 0) {",
        "    Write-Host \"bash-completion already configured in $bashrc\"",
        "} else {",
        "    # 确保文件以换行结尾，避免粘连",
        "    if ($bashrcContent.Length -gt 0 -and -not $bashrcContent.EndsWith(\"`n\")) {",
        "        Add-Content -Path $bashrc -Value ''",
        "    }",
        "    Add-Content -Path $bashrc -Value ''",
        "    foreach ($line in $missing) {",
        "        Add-Content -Path $bashrc -Value $line",
        "    }",
        "    Write-Host \"Added missing bash-completion config to $bashrc\"",
        "}"
    ],
    "pre_uninstall": [
        "# 定位 ~/.bashrc（优先 HOME，回退 USERPROFILE）",
        "$homeDir = if ($env:HOME) { $env:HOME } else { $env:USERPROFILE }",
        "$bashrc = Join-Path $homeDir '.bashrc'",
        "",
        "if (-not (Test-Path $bashrc)) {",
        "    Write-Host \"$bashrc not found, nothing to clean up.\"",
        "} else {",
        "    # 组装安装时写入的 source 行（与 post_install 中的 $bashDir 逻辑保持一致）",
        "    $root = Split-Path $dir -Parent",
        "    $bashRoot = '/' + $root.Substring(0,1).ToLower() + ($root.Substring(2) -replace '\\\\','/')",
        "    $bashDir = $bashRoot + '/current'",
        "    $sourceLine = '. \"' + $bashDir + '/bash_completion.sh\"'",
        "",
        "    # 需要移除的完整配置块",
        "    $configLines = @(",
        "        '# bash-completion',",
        "        $sourceLine,",
        "        'shopt -s completion_strip_exe',",
        "        'EXECIGNORE=*.dll:*.config:*.manifest:*.msc'",
        "    )",
        "",
        "    # 读取 .bashrc 全部行",
        "    $lines = @(Get-Content -Path $bashrc)",
        "",
        "    # 整行相等过滤，只删除由本脚本写入的精确行",
        "    $newLines = New-Object System.Collections.Generic.List[string]",
        "    foreach ($line in $lines) {",
        "        if ($configLines -contains $line) { continue }",
        "        $newLines.Add($line)",
        "    }",
        "",
        "    if ($newLines.Count -eq $lines.Count) {",
        "        Write-Host \"bash-completion config not found in $bashrc, nothing to remove.\"",
        "    } else {",
        "        # 去掉末尾可能多出的空行",
        "        while ($newLines.Count -gt 0 -and $newLines[$newLines.Count - 1] -eq '') {",
        "            $newLines.RemoveAt($newLines.Count - 1)",
        "        }",
        "        if ($newLines.Count -gt 0) {",
        "            Set-Content -Path $bashrc -Value $newLines",
        "        } else {",
        "            Set-Content -Path $bashrc -Value ''",
        "        }",
        "        Write-Host \"Removed bash-completion config from $bashrc\"",
        "    }",
        "}"
    ],
    "checkver": {
        "github": "https://github.com/scop/bash-completion"
    },
    "autoupdate": {
        "url": "https://github.com/scop/bash-completion/releases/download/$version/bash-completion-$version.tar.xz"
    }
}
