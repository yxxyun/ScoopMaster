{
    "version": "0.1.0",
    "description": "Native desktop monitor for Magpie Gateway routing, requests, and provider activity.",
    "homepage": "https://github.com/Fan-chou/magpie-native-routing",
    "license": "Unknown",
    "architecture": {
        "64bit": {
            "url": "https://github.com/Fan-chou/magpie-native-routing/releases/download/v0.1.0/Magpie.Native.Routing.Setup.0.1.0.amd64.exe",
            "hash": "e663ef4ad9b52bf1f9cf6733a663d4131405099a0f56e2fbc175ed2c859fcafc"
        },
        "arm64": {
            "url": "https://github.com/Fan-chou/magpie-native-routing/releases/download/v0.1.0/Magpie.Native.Routing.Setup.0.1.0.arm64.exe",
            "hash": "e87562c9b8b979ed7e79ef648f2f1e3cb57a7acbe6d16b701ac353dcd23fda8e"
        }
    },
    "##": "Installer Type: NSIS",
    "installer": {
        "args": [
            "/S",
            "/D=$dir"
        ]
    },
    "uninstaller": {
        "script": [
            "if ($cmd -ne 'update') {",
            "    $uninstaller = Join-Path $dir 'Uninstall.exe'",
            "    if (-not (Test-Path -LiteralPath $uninstaller -PathType Leaf)) { throw 'MyGo NSIS uninstaller was not found in the Scoop version directory.' }",
            "    $uninstallArgs = @('/S', ('\"' + '_?=' + $dir + '\"'))",
            "    $process = Start-Process -FilePath $uninstaller -ArgumentList $uninstallArgs -Wait -PassThru -ErrorAction Stop",
            "    if ($process.ExitCode -ne 0) { throw \"MyGo NSIS uninstaller exited with code $($process.ExitCode).\" }",
            "}"
        ]
    },
    "checkver": {
        "github": "https://github.com/Fan-chou/magpie-native-routing"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/Fan-chou/magpie-native-routing/releases/download/v$version/Magpie.Native.Routing.Setup.$version.amd64.exe",
                "hash": {
                    "mode": "json",
                    "url": "https://api.github.com/repos/Fan-chou/magpie-native-routing/releases/tags/v$version",
                    "jp": "$.assets[?(@.name == 'Magpie.Native.Routing.Setup.$version.amd64.exe')].digest"
                }
            },
            "arm64": {
                "url": "https://github.com/Fan-chou/magpie-native-routing/releases/download/v$version/Magpie.Native.Routing.Setup.$version.arm64.exe",
                "hash": {
                    "mode": "json",
                    "url": "https://api.github.com/repos/Fan-chou/magpie-native-routing/releases/tags/v$version",
                    "jp": "$.assets[?(@.name == 'Magpie.Native.Routing.Setup.$version.arm64.exe')].digest"
                }
            }
        }
    },
    "notes": [
        "Requires Magpie Desktop and its local Gateway to monitor routing activity.",
        "The upstream repository does not provide an explicit software license."
    ]
}
