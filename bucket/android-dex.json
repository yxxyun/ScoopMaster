            "    Remove-Item \"$dir\\$zipName\" -Force -ErrorAction SilentlyContinue",
            "    $subDir = Get-ChildItem -Path \"$dir\" -Directory | Where-Object { $_.Name -like 'Android_Dex*' } | Select-Object -First 1",
            "    if ($subDir) {",
            "        Move-Item \"$($subDir.FullName)\\*\" \"$dir\\\" -Force -ErrorAction SilentlyContinue",
            "        Remove-Item $subDir.FullName -Recurse -Force -ErrorAction SilentlyContinue",
            "    }",
            "}"
        ]
