{
    "version": "1.42.0",
    "description": "A cross-platform terminal workspace for remote development and AI agents, powered by libghostty-vt.",
    "homepage": "https://wispterm.cc-remote.app/",
    "license": "MIT",
    "notes": [
        "WispTerm stores settings, SSH profiles, AI profiles and history in %APPDATA%\\wispterm, plus WebView2 data in %LOCALAPPDATA%\\wispterm. Both survive upgrades; 'scoop uninstall wispterm -p' purges them.",
        "Upgrade with 'scoop update wispterm' instead of the bundled Replace-WispTerm.cmd, which would install a second copy under %LOCALAPPDATA%\\Programs\\WispTerm."
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/xuzhougeng/wispterm/releases/download/v1.42.0/wispterm-windows-portable-v1.42.0.zip",
            "hash": "ea52beb89dedeeb39699977e711769fac013badf2099b51c1fdf32cdf3867397"
        }
    },
    "bin": "wispterm.exe",
    "shortcuts": [
        [
            "wispterm.exe",
            "WispTerm"
        ]
    ],
    "post_uninstall": [
        "if ($purge) {",
        "    $Directories = [string[]](",
        "        [System.IO.Path]::Combine($env:APPDATA,'wispterm'),",
        "        [System.IO.Path]::Combine($env:LOCALAPPDATA,'wispterm')",
        "    )",
        "    $Directories.ForEach{",
        "        if ([System.IO.Directory]::Exists($_)) {",
        "            $null = [System.IO.Directory]::Delete($_,$true)",
        "        }",
        "    }",
        "}"
    ],
    "checkver": {
        "github": "https://github.com/xuzhougeng/wispterm"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/xuzhougeng/wispterm/releases/download/v$version/wispterm-windows-portable-v$version.zip"
            }
        }
    }
}
