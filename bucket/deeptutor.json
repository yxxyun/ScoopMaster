{
    "version": "1.7.2",
    "description": "Personalized AI tutoring desktop app with a bundled local runtime and learning workspace.",
    "homepage": "https://github.com/HKUDS/DeepTutor",
    "license": "Apache-2.0",
    "url": "https://github.com/HKUDS/DeepTutor/releases/download/v1.7.2/Open-DeepTutor-Windows-v1.7.2-Portable.zip",
    "hash": "f37e02fa7a9e2172db7f1b2c06e02f69ed0ac909e79704abb8ace3e08bc36014",
    "checkver": {
        "script": [
            "$headers = @{ 'Accept' = 'application/vnd.github+json'; 'User-Agent' = 'KiroBucket-ScoopCheckver' }",
            "if ($env:GITHUB_TOKEN) { $headers.Authorization = \"Bearer $env:GITHUB_TOKEN\" }",
            "$releases = Invoke-RestMethod -Uri 'https://api.github.com/repos/HKUDS/DeepTutor/releases?per_page=100' -Headers $headers -TimeoutSec 30 -ErrorAction Stop",
            "$release = $releases | Where-Object { -not $_.draft -and -not $_.prerelease -and @($_.assets | Where-Object { $_.name -match '^Open-DeepTutor-Windows-v[\\d.]+-Portable\\.zip$' }).Count -gt 0 } | Sort-Object { [datetime]$_.published_at } -Descending | Select-Object -First 1",
            "if ($null -eq $release) { throw 'No stable DeepTutor Windows portable ZIP release was found.' }",
            "$tag = [regex]::Match([string]$release.tag_name, '^v(?<version>[\\d.]+)$')",
            "if (-not $tag.Success) { throw 'The DeepTutor release tag does not match the expected version format.' }",
            "$tag.Groups['version'].Value"
        ],
        "regex": "^(?<version>[\\d.]+)$"
    },
    "autoupdate": {
        "url": "https://github.com/HKUDS/DeepTutor/releases/download/v$version/Open-DeepTutor-Windows-v$version-Portable.zip"
    }
}
