        "if (Test-Path \"$persist_dir\\MajorPrivacy.ini\") {",
        "    Copy-Item \"$persist_dir\\MajorPrivacy.ini\" \"$dir\\MajorPrivacy.ini\"",
        "}"
    ],
    "shortcuts": [
        [
            "MajorPrivacy.exe",
            "MajorPrivacy"
        ]
    ],
    "pre_uninstall": [
        "ensure $persist_dir",
        "Copy-Item \"$dir\\MajorPrivacy.ini\" \"$persist_dir\\MajorPrivacy.ini\"",
