{
    "version": "2.3.4",
    "description": "An image-based autosplitter for speedrunning on console or PC.",
    "homepage": "https://github.com/Toufool/AutoSplit",
    "license": "GPL-3.0-or-later",
    "architecture": {
        "64bit": {
            "url": "https://github.com/Toufool/AutoSplit/releases/download/v2.3.4/AutoSplit.v2.3.4.for.win-x64.zip",
            "hash": "898d063f17ec048bc4db259fd6d5b634e9c216819b1000276aece2024f80d056"
        }
    },
    "post_install": [
        "$images = \"$dir/images\" -replace \"\\\\\", \"/\"",
        "Set-Content \"$dir\\settings.toml\" \"split_image_directory = \"\"$images\"\"\"",
        "$reg = \"HKCU:\\SOFTWARE\\AutoSplit\\Check For Updates On Open\"",
        "New-Item -Path \"$reg\" -Force | Out-Null",
        "New-ItemProperty -Path \"$reg\" -Name \"check_for_updates_on_open\" -Value false -Force | Out-Null"
    ],
    "bin": "AutoSplit.exe",
    "shortcuts": [
        [
            "AutoSplit.exe",
            "AutoSplit"
        ]
    ],
    "persist": [
        "images",
        "settings.toml"
    ],
    "post_uninstall": "Remove-Item \"HKCU:\\SOFTWARE\\AutoSplit\" -Recurse -Force 2>&1 | Out-Null",
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/Toufool/AutoSplit/releases/download/v$version/AutoSplit.v$version.for.win-x64.zip"
            }
        }
    }
}
