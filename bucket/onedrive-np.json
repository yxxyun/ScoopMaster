{
    "version": "26.189.0928.0009",
    "description": "Microsoft OneDrive. Save your photos and files to OneDrive and access them from any device, anywhere.",
    "homepage": "https://oneclient.sfx.ms",
    "license": "Proprietary",
    "architecture": {
        "64bit": {
            "url": "https://oneclient.sfx.ms/Win/Installers/26.189.0928.0009/amd64/OneDriveSetup.exe",
            "hash": "f0bd37e59a7c57d045404ffc885dca306e603bee06f9f3cf6b7da0d5ddd58055"
        },
        "arm64": {
            "url": "https://oneclient.sfx.ms/Win/Installers/26.189.0928.0009/arm64/OneDriveSetup.exe",
            "hash": "293fd3bcb019d386254f9ae0f7f76f48863c8fb78129d5f5ff4df1ebe75cd89b"
        }
    },
    "pre_install": "if (!(is_admin)) { error \"$app requires admin rights to $cmd\"; break }",
    "installer": {
        "args": [
            "/silent",
            "/update",
            "/restart",
            "/allusers"
        ]
    },
    "checkver": {
        "script": [
            "$url = & curl.exe --silent --show-error --head --location --max-redirs 10 --max-time 30 --output NUL --write-out '%{url_effective}' 'https://go.microsoft.com/fwlink/?linkid=844652'",
            "if ($LASTEXITCODE -ne 0 -or [string]::IsNullOrWhiteSpace($url)) { throw 'Could not retrieve the official OneDrive installer URL.' }",
            "$match = [regex]::Match($url, '/Installers/(?<version>\\d+(?:\\.\\d+)+)/')",
            "if (-not $match.Success) { throw \"Could not detect the OneDrive version from its final official URL: $url\" }",
            "$match.Groups['version'].Value"
        ],
        "regex": "^(?<version>\\d+(?:\\.\\d+)+)$"
    },
    "notes": "Detects the version from the final installer URL returned by Microsoft's official OneDrive redirect.",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://oneclient.sfx.ms/Win/Installers/$version/amd64/OneDriveSetup.exe"
            },
            "arm64": {
                "url": "https://oneclient.sfx.ms/Win/Installers/$version/arm64/OneDriveSetup.exe"
            }
        }
    }
}
