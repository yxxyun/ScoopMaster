{
    "version": "0.1.10",
    "description": "Fast radial (pie) menu launcher for Windows, written in Rust. A native rewrite of Kando.",
    "homepage": "https://github.com/Goldingeng/Orbit-Actions",
    "license": "MIT",
    "notes": [
        "Start the menu: orbit-actions. Open it with Ctrl+Space or Alt + left click.",
        "To start it with Windows, put a shortcut to $dir\\orbit-actions.exe into shell:startup."
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/Goldingeng/Orbit-Actions/releases/download/v0.1.10/Orbit-Actions-0.1.10-windows-x64.zip",
            "hash": "32ee9868d766878cadef73fd8676eb4f50211c8e98877806191ee3ae4f9c2340"
        },
        "32bit": {
            "url": "https://github.com/Goldingeng/Orbit-Actions/releases/download/v0.1.10/Orbit-Actions-0.1.10-windows-x86.zip",
            "hash": "7744a02fa1454c3ff068a6f166d6716b850616598615fec1a1fda18538d1284b"
        },
        "arm64": {
            "url": "https://github.com/Goldingeng/Orbit-Actions/releases/download/v0.1.10/Orbit-Actions-0.1.10-windows-arm64.zip",
            "hash": "6e7fa2011c66c205a68658cea135872d163f543b7cc94fba006a4b8a2b68bf85"
        }
    },
    "pre_install": [
        "foreach ($name in 'menus.json', 'config.json') {",
        "    if (Test-Path \"$persist_dir\\$name\") { Copy-Item \"$persist_dir\\$name\" \"$dir\\$name\" -Force }",
        "}"
    ],
    "pre_uninstall": [
        "New-Item -ItemType Directory -Force $persist_dir | Out-Null",
        "foreach ($name in 'menus.json', 'config.json') {",
        "    if (Test-Path \"$dir\\$name\") { Copy-Item \"$dir\\$name\" \"$persist_dir\\$name\" -Force }",
        "}",
        "Get-Process orbit-actions, orbit-actions-settings -ErrorAction SilentlyContinue | Where-Object { $_.Path -like \"$dir\\*\" } | Stop-Process -Force"
    ],
    "bin": "orbit-actions.exe",
    "shortcuts": [
        [
            "orbit-actions.exe",
            "Orbit Actions"
        ],
        [
            "orbit-actions-settings.exe",
            "Orbit Actions Settings"
        ]
    ],
    "persist": [
        "icon-themes",
        "sound-themes"
    ],
    "checkver": {
        "github": "https://github.com/Goldingeng/Orbit-Actions"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/Goldingeng/Orbit-Actions/releases/download/v$version/Orbit-Actions-$version-windows-x64.zip"
            },
            "32bit": {
                "url": "https://github.com/Goldingeng/Orbit-Actions/releases/download/v$version/Orbit-Actions-$version-windows-x86.zip"
            },
            "arm64": {
                "url": "https://github.com/Goldingeng/Orbit-Actions/releases/download/v$version/Orbit-Actions-$version-windows-arm64.zip"
            }
        },
        "hash": {
            "url": "$baseurl/SHA256SUMS.txt"
        }
    }
}
