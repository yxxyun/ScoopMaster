        },
        "32bit": {
            "url": "https://deb.fbxl.net/mingw32/FreeBASIC-1.20.6-winlibs-gcc-16.1.0.zip",
            "hash": "2ca7b18d7aaf6971ebab339916fb7e57534c0ddc7d67ae491f28d2f209f042b5",
            "extract_dir": "FreeBASIC-1.20.6-winlibs-gcc-16.1.0",
            "bin": [
                "fbc32.exe",
                "fbc64.exe",
                [
                    "fbc32.exe",
                    "fbc"
                ]
            ]
        }
    },
    "checkver": {
        "url": "https://deb.fbxl.net/mingw32/",
        "script": [
            "$mo = @{ Jan = '01'; Feb = '02'; Mar = '03'; Apr = '04'; May = '05'; Jun = '06'; Jul = '07'; Aug = '08'; Sep = '09'; Oct = '10'; Nov = '11'; Dec = '12' }",
            "$m = [regex]::Matches($page, '<a href=\"(FreeBASIC-[0-9.]+-winlibs-gcc-[0-9.]+)\\.zip\">[^<]*</a>\\s+(\\d{2})-([A-Za-z]{3})-(\\d{4})')",
            "$m | ForEach-Object { '{0}|{1}.{2}.{3}' -f $_.Groups[1].Value, $_.Groups[4].Value, $mo[$_.Groups[3].Value], $_.Groups[2].Value } | Sort-Object { $_.Substring($_.IndexOf('|') + 1) } -Descending | Select-Object -First 1"
        ],
        "regex": "(?<file>FreeBASIC-[0-9.]+-winlibs-gcc-[0-9.]+)\\|(?<version>\\d{4}\\.\\d{2}\\.\\d{2})"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://deb.fbxl.net/mingw32/$matchFile.zip",
                "extract_dir": "$matchFile"
            },
            "32bit": {
                "url": "https://deb.fbxl.net/mingw32/$matchFile.zip",
                "extract_dir": "$matchFile"
            }
        },
        "hash": {
            "url": "$baseurl/SHA256SUMS",
            "find": "([a-fA-F0-9]{64})\\s+$basename"
        }
    }
}
