{
    "version": "2.1",
    "description": "Portable edition of Vovsoft WEBP Converter.",
    "homepage": "https://vovsoft.com/software/webp-converter/",
    "license": "Proprietary",
    "url": "https://vovsoft.com/files/webp-converter-portable.zip?v=2.1",
    "checkver": {
        "url": "https://vovsoft.com/download/webp-converter-portable/",
        "regex": "(?is)Version\\s*(?:<[^>]*>\\s*)*:?\\s*(?:<[^>]*>\\s*)*(?<version>\\d+(?:\\.\\d+)+)"
    },
    "autoupdate": {
        "url": "https://vovsoft.com/files/webp-converter-portable.zip?v=$version"
    },
    "shortcuts": [
        [
            "webpconverter.exe",
            "Vovsoft WEBP Converter"
        ]
    ],
    "pre_install": [
        "if (-not (Test-Path -LiteralPath \"$dir\\key.txt\" -PathType Leaf)) { New-Item -ItemType File -Path \"$dir\\key.txt\" | Out-Null }"
    ],
    "persist": "key.txt"
}
