{
    "version": "20260714",
    "description": "Speedily browse your latest local git branches, checkout with Enter.",
    "homepage": "https://github.com/scillidan/git-recent",
    "license": "MIT",
    "suggest": {
        "git": "main/git",
        "fzf": "main/git"
    },
    "url": "https://github.com/scillidan/git-recent/archive/master.zip",
    "hash": "893bada66a2f08ccd550241ea266f7e23b5f7117edbf073ffbc952399d9edbb2",
    "extract_dir": "git-recent-master",
    "pre_install": "Remove-Item -Path \"$dir\\*\" -Exclude 'git-recent', 'git-recent-og', 'LICENSE', 'readme.md' -Recurse -Force",
    "bin": [
        "git-recent",
        "git-recent-og"
    ],
    "checkver": {
        "url": "https://api.github.com/repos/scillidan/git-recent/commits?per_page=1",
        "jsonpath": "$[0].commit.author.date",
        "regex": "(\\d{4})-(\\d{2})-(\\d{2}).*",
        "replace": "$1$2$3"
    },
    "autoupdate": {
        "url": "https://github.com/scillidan/git-recent/archive/master.zip"
    }
}
