{
    "version": "0.33.0-beta.44",
    "description": "Local web development stack: nginx/Apache, multiple PHP versions, MySQL/MariaDB, PostgreSQL, Redis, MongoDB, Node.js and trusted .test HTTPS",
    "homepage": "https://envkit.net",
    "license": {
        "identifier": "Freeware",
        "url": "https://github.com/Env-Kit/envkit-releases#license"
    },
    "notes": [
        "EnvKit updates itself from inside the app. An in-app update runs the full NSIS installer,",
        "which installs a separate per-machine copy under Program Files. Update with 'scoop update envkit' instead.",
        "Services, sites and databases live in %ProgramData%\\envkit or %LOCALAPPDATA%\\envkit, not in the Scoop folder."
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/Env-Kit/envkit-releases/releases/download/v0.33.0-beta.44/EnvKit-Setup-0.33.0-beta.44.exe#/dl.7z",
            "hash": "49e735ed4cd6e87bfb7e10c731618af244642f279a25af4d2290a6c761ed9e51",
            "pre_install": [
                "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-64.7z\" \"$dir\"",
                "Remove-Item \"$dir\\`$*\", \"$dir\\Uninst*\" -Force -Recurse -ErrorAction SilentlyContinue"
            ]
        }
    },
    "shortcuts": [
        [
            "EnvKit.exe",
            "EnvKit"
        ]
    ],
    "checkver": {
        "github": "https://github.com/Env-Kit/envkit-releases",
        "regex": "(?:tag/|^)v(\\d+\\.\\d+\\.\\d+(?:-beta\\.\\d+)?)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/Env-Kit/envkit-releases/releases/download/v$version/EnvKit-Setup-$version.exe#/dl.7z"
            }
        },
        "hash": {
            "url": "$baseurl/latest.yml",
            "regex": "sha512:\\s+$base64"
        }
    }
}
