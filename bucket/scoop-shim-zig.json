{
    "version": "0.2.1",
    "description": "Scoop shim launcher (Zig implementation). Runs the executable described in its paired .shim file.",
    "homepage": "https://github.com/ScoopInstaller/Shim",
    "license": "Unlicense OR MIT",
    "notes": [
        "Scoop core has no support for the new shim implementations yet, so this manifest overwrites every built-in Scoop shim (supporting\\shims\\71, kiennq and scoopcs).",
        "Whatever 'scoop config shim' is set to (or the default kiennq), Scoop will use this implementation.",
        "Install only one of scoop-shim-cs, scoop-shim-cpp, scoop-shim-rust or scoop-shim-zig at a time."
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/ScoopInstaller/Shim/releases/download/zig/v0.2.1/shim-x64.zip",
            "hash": "dc0e0d213778a0c0a73f0502f8eb166d40373b7395bef5a33d926c8ff998e184"
        },
        "32bit": {
            "url": "https://github.com/ScoopInstaller/Shim/releases/download/zig/v0.2.1/shim-x86.zip",
            "hash": "8ab411ea2b33e8cab9668e05a394394da5df878c404ecd0a902c950c15518867"
        },
        "arm64": {
            "url": "https://github.com/ScoopInstaller/Shim/releases/download/zig/v0.2.1/shim-arm64.zip",
            "hash": "9785e710b7483baa76e9d05a175923d22118f9a607e35055837a569b0d925db9"
        }
    },
    "post_install": [
        "if (scoop config shim) {",
        "    $shimBuild = scoop config shim",
        "} else {",
        "    $shimBuild = \"kiennq\"",
        "}",
        "Copy-Item \"$dir\\shim.exe\" \"$scoopdir\\apps\\scoop\\current\\supporting\\shims\\$shimBuild\\shim.exe\" -Force",
        "git -C \"$scoopdir\\apps\\scoop\\current\" update-index --skip-worktree \"supporting\\shims\\$shimBuild\\shim.exe\""
    ],
    "pre_uninstall": [
        "if (scoop config shim) {",
        "    $shimBuild = scoop config shim",
        "} else {",
        "    $shimBuild = \"kiennq\"",
        "}",
        "git -C \"$scoopdir\\apps\\scoop\\current\" update-index --no-skip-worktree \"supporting\\shims\\$shimBuild\\shim.exe\"",
        "git -C \"$scoopdir\\apps\\scoop\\current\" checkout -- \"supporting\\shims\\$shimBuild\\shim.exe\""
    ],
    "checkver": {
        "url": "https://api.github.com/repos/ScoopInstaller/Shim/releases",
        "jsonpath": "$[*].tag_name",
        "regex": "zig/v([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/ScoopInstaller/Shim/releases/download/zig/v$version/shim-x64.zip"
            },
            "32bit": {
                "url": "https://github.com/ScoopInstaller/Shim/releases/download/zig/v$version/shim-x86.zip"
            },
            "arm64": {
                "url": "https://github.com/ScoopInstaller/Shim/releases/download/zig/v$version/shim-arm64.zip"
            }
        }
    }
}
