{
    "##": "All upstream releases are flagged as pre-releases, so the /releases/latest endpoint returns 404. Use the list endpoint and take the newest entry instead.",
    "version": "0.2.0-rc1",
    "description": "Local-first MCP server and CLI that maintains a Git-versioned index of a codebase and its database schema for coding agents",
    "homepage": "https://github.com/aoci-spec/aoci-code",
    "license": "FSL-1.1-MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/aoci-spec/aoci-code/releases/download/v0.2.0-rc1/aoci_0.2.0-rc1_windows_amd64.zip",
            "hash": "e54b6218f57f22dada49ca06d767f77838f648e69bb2c13f96d6541fc689e296"
        },
        "arm64": {
            "url": "https://github.com/aoci-spec/aoci-code/releases/download/v0.2.0-rc1/aoci_0.2.0-rc1_windows_arm64.zip",
            "hash": "e85facf63668fb735388f68fdb5216a346d30e9c4db2b489887a781fa0b9bf51"
        }
    },
    "bin": "aoci.exe",
    "notes": [
        "AOCI-CODE is both the 'aoci' CLI and a stdio MCP server ('aoci mcp').",
        "Point MCP host config at the version-stable shim: \"$dir\\..\\..\\..\\shims\\aoci.exe\" (same file as the 'aoci' on PATH).",
        "The underlying binary \"$dir\\aoci.exe\" behaves identically if you prefer to skip the wrapper process.",
        "Restart the agent host after 'aoci init' writes its MCP configuration."
    ],
    "checkver": {
        "url": "https://api.github.com/repos/aoci-spec/aoci-code/releases",
        "jsonpath": "$[0].tag_name",
        "regex": "v?([\\d.]+(?:-[0-9A-Za-z.-]+)?)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/aoci-spec/aoci-code/releases/download/v$version/aoci_$version_windows_amd64.zip",
                "hash": {
                    "url": "https://api.github.com/repos/aoci-spec/aoci-code/releases/tags/v$version",
                    "jsonpath": "$.assets[?(@.name == 'aoci_$version_windows_amd64.zip')].digest"
                }
            },
            "arm64": {
                "url": "https://github.com/aoci-spec/aoci-code/releases/download/v$version/aoci_$version_windows_arm64.zip",
                "hash": {
                    "url": "https://api.github.com/repos/aoci-spec/aoci-code/releases/tags/v$version",
                    "jsonpath": "$.assets[?(@.name == 'aoci_$version_windows_arm64.zip')].digest"
                }
            }
        }
    }
}
