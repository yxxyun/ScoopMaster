{
    "version": "3.7.29",
    "description": "Unofficial fork of SumatraPDF, a document reader (PDF, EPUB, MOBI, and more) with improvements for Chinese ebooks, offline lookup, themes, and smart PDF dark mode",
    "homepage": "https://github.com/dengxibo/sumatrapdf-plus",
    "license": "GPL-3.0-only OR BSD-2-Clause",
    "notes": [
        "Full package includes fonts and offline dictionary for double-click word lookup.",
        "This is a community fork of SumatraPDF (GPLv3), not an official release from sumatrapdfreader.org."
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/dengxibo/sumatrapdf-plus/releases/download/3.7.29/Sumatra.PDF.Plus.MainProgram+dictionary.zip",
            "hash": "6c13159103c7a977f69b05e14c3ce06b97eb7c29c748dde2c209ae0e8712a725"
        }
    },
    "pre_install": [
        "$file = 'SumatraPDF-settings.txt'",
        "if (!(Test-Path \"$persist_dir\\$file\")) {",
        "    Write-Host 'File' $file 'does not exist. Creating.' -f Yellow",
        "    Set-Content \"$dir\\$file\" 'CheckForUpdates = false' -Encoding Ascii",
        "}",
        "Get-ChildItem \"$dir\\SumatraPDF-*.exe\" | Rename-Item -NewName 'SumatraPDF.exe'"
    ],
    "bin": "SumatraPDF.exe",
    "shortcuts": [
        [
            "SumatraPDF.exe",
            "Sumatra PDF Plus"
        ]
    ],
    "persist": [
        "SumatraPDF-settings.txt",
        "sumatrapdfcache"
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/dengxibo/sumatrapdf-plus/releases/download/$version/Sumatra.PDF.Plus.MainProgram+dictionary.zip"
            }
        }
    }
}
