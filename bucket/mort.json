{
    "version": "1.325",
    "description": "Real-time game translator with OCR and machine translation.",
    "homepage": "https://github.com/kmonkeyhead/MORT",
    "license": "MIT",
    "suggest": {
        "vcredist": "vcredist",
        "windowsdesktop-runtime": "windowsdesktop-runtime-lts"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/kmonkeyhead/MORT/releases/download/1.325/MORT.1.325v.-.20261123.zip",
            "hash": "70c55bc4be810f66f972dbbb11c7d6b96d3a42e5d5990ff2e9c6e80137c77ba8"
        }
    },
    "bin": "MORT.exe",
    "shortcuts": [
        [
            "MORT.exe",
            "MORT"
        ]
    ],
    "persist": [
        "UserData",
        "setting",
        "DIC",
        "DB",
        "VersionData.txt"
    ],
    "checkver": {
        "url": "https://api.github.com/repos/kmonkeyhead/MORT/releases/latest",
        "jsonpath": "$.assets[*].browser_download_url",
        "regex": "MORT\\.(?<version>[\\d.]+)v\\.-\\.(?<build>[\\d]+)\\.zip",
        "replace": "${version}"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/kmonkeyhead/MORT/releases/download/$matchVersion/MORT.$matchVersionv.-.$matchBuild.zip",
                "hash": {
                    "url": "https://api.github.com/repos/kmonkeyhead/MORT/releases/tags/$matchVersion",
                    "jsonpath": "$.assets[?(@.name == '$basename')].digest"
                }
            }
        }
    }
}
