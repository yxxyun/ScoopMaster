{
    "version": "1.320",
    "description": "Real-time game translator with OCR and machine translation.",
    "homepage": "https://github.com/kmonkeyhead/MORT",
    "license": "MIT",
    "suggest": {
        "vcredist": "vcredist",
        "windowsdesktop-runtime": "windowsdesktop-runtime-lts"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/kmonkeyhead/MORT/releases/download/1.320/MORT.1.320v.-.20260911.zip",
            "hash": "56d85a6855423a6bd05e8cc1f445e593bea28d78170e2c756ed5a4cd17177d27"
        }
    },
    "bin": "MORT.exe",
    "shortcuts": [
        [
            "MORT.exe",
            "MORT"
        ]
    ],
    "persist": [
        "UserData",
        "setting",
        "DIC",
        "DB",
        "VersionData.txt"
    ],
    "checkver": {
        "github": "https://github.com/kmonkeyhead/MORT",
        "jsonpath": "$..browser_download_url",
        "regex": "MORT\\.(?<version>[\\d.]+)v\\.-\\.(?<build>[\\d]+)\\.zip",
        "replace": "${version}"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/kmonkeyhead/MORT/releases/download/$matchVersion/MORT.$matchVersionv.-.$matchBuild.zip",
                "hash": {
                    "url": "https://api.github.com/repos/kmonkeyhead/MORT/releases/tags/$matchVersion",
                    "jsonpath": "$.assets[?(@.name == '$basename')].digest"
                }
            }
        }
    }
}
