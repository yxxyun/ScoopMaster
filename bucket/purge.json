        }
    },
    "shortcuts": [
        [
            "Purge.exe",
            "Purge"
        ]
    ],
    "uninstaller": {
        "script": [
            "if ($cmd -eq 'uninstall') {",
            "    $exe = Join-Path $dir 'Purge.exe'",
            "    if (Test-Path -LiteralPath $exe -PathType Leaf) {",
            "        $process = Start-Process -FilePath $exe -ArgumentList '--uninstall-cleanup' -WorkingDirectory $dir -Wait -PassThru",
            "        if ($process.ExitCode -ne 0) { throw \"Purge integration cleanup failed with exit code $($process.ExitCode).\" }",
            "    }",
            "}"
        ]
    },
    "notes": [
        "Purge stores settings, history, crash logs and update downloads under %LOCALAPPDATA%\\Purge; those files are outside the Scoop app directory and remain after Scoop uninstall.",
        "Purge can register a per-user startup entry and scheduled cleanup task only when enabled in its settings. The Scoop uninstall hook removes those registrations without deleting the user's settings and history.",
        "Purge has its own update installer. Use Scoop to update this package instead of applying updates through Purge's in-app installer, which targets the current installation directory."
    ],
    "checkver": {
        "url": "https://api.github.com/repos/stvekoulo/purge/releases/latest",
        "jsonpath": "$.tag_name",
        "regex": "^v(?<version>[\\d.]+)$"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/stvekoulo/purge/releases/download/v$version/Purge-$version-win-x64.zip"
            },
            "arm64": {
                "url": "https://github.com/stvekoulo/purge/releases/download/v$version/Purge-$version-win-arm64.zip"
            },
            "32bit": {
                "url": "https://github.com/stvekoulo/purge/releases/download/v$version/Purge-$version-win-x86.zip"
            }
        }
    }
}
