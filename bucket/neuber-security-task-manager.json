        "script": [
            "$response = Invoke-WebRequest -Uri 'https://www.neuber.com/taskmanager/update.html' -UseBasicParsing",
            "$html = [string]$response.Content",
            "$text = [System.Net.WebUtility]::HtmlDecode([regex]::Replace($html, '<[^>]+>', ' '))",
            "$match = [regex]::Match($text, '(?is)Security\\s+Task\\s+Manager\\s+(?<version>\\d+\\.\\d+[a-z]?)\\s*\\(')",
            "if (-not $match.Success) { throw 'Could not parse the latest Security Task Manager version from the official update page.' }",
            "$match.Groups['version'].Value"
        ],
        "regex": "(?<version>\\d+\\.\\d+[a-z]?)"
    },
