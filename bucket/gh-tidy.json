{
    "version": "20260814",
    "description": "Github CLI Extension for tidying your Git workspace!",
    "homepage": "https://github.com/HaywardMorihara/gh-tidy",
    "license": "Unlicense",
    "suggest": {
        "gh": "main/gh",
        "git": "main/git"
    },
    "url": "https://github.com/HaywardMorihara/gh-tidy/archive/main.zip",
    "hash": "43bc19a02e5407bb8f55a824ef9ae6910f2f3bab994f897df2fbca5d92712dcd",
    "extract_dir": "gh-tidy-main",
    "pre_install": "Remove-Item -Path \"$dir\\*\" -Exclude 'gh-tidy', 'LICENSE', 'README.md' -Recurse -Force",
    "bin": [
        [
            "gh-tidy",
            "gh-tidy",
            "-skip-update-check"
        ]
    ],
    "checkver": {
        "url": "https://api.github.com/repos/HaywardMorihara/gh-tidy/commits?per_page=1",
        "jsonpath": "$[0].commit.author.date",
        "regex": "(\\d{4})-(\\d{2})-(\\d{2}).*",
        "replace": "$1$2$3"
    },
    "autoupdate": {
        "url": "https://github.com/HaywardMorihara/gh-tidy/archive/main.zip"
    }
}
