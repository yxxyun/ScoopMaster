{
    "version": "2013.02.22",
    "description": "GRC SecurAble: Reports processor support for 64-bit instructions, hardware DEP/NX, and virtualization.",
    "homepage": "https://www.grc.com/securable.htm",
    "license": "Freeware",
    "url": "https://www.grc.com/files/securable.exe",
    "shortcuts": [
        [
            "securable.exe",
            "GRC SecurAble"
        ]
    ],
    "notes": [
        "GRC does not publish a static SHA-256 checksum for this download. The manifest omits hash rather than inventing a value.",
        "Legacy hardware-inspection utility; verify important virtualization and security results using current Windows/system tools."
    ],
    "checkver": {
        "script": [
            "$html = (Invoke-WebRequest -Uri 'https://www.grc.com/securable.htm' -UseBasicParsing).Content",
            "$text = [System.Net.WebUtility]::HtmlDecode([regex]::Replace($html, '<[^>]+>', ' '))",
            "$text = [regex]::Replace($text, '\\s+', ' ')",
            "$match = [regex]::Match($text, '(?is)File stats for:\\s*SecurAble.{0,1800}?Last\\s+Updated:\\s*Size:\\s*[\\d.,]+\\s*[kKmM]?\\s+(?<date>[A-Za-z]{3}\\s+\\d{1,2},\\s+\\d{4})\\s+at\\b')",
            "if (-not $match.Success) { throw 'Unable to read the published Last Updated date for SecurAble.' }",
            "[DateTime]::ParseExact($match.Groups['date'].Value, 'MMM d, yyyy', [Globalization.CultureInfo]::InvariantCulture).ToString('yyyy.MM.dd')"
        ],
        "regex": "(?<version>\\d{4}\\.\\d{2}\\.\\d{2})"
    },
    "autoupdate": {
        "url": "https://www.grc.com/files/securable.exe"
    }
}
