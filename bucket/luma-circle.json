{
    "version": "1.4.0",
    "description": "Offline Windows file converter with multilingual OCR and legacy Excel support",
    "homepage": "https://github.com/aymenki/luma-circle",
    "license": "MIT",
    "url": "https://github.com/aymenki/luma-circle/releases/download/v1.4.0/Luma-Circle-1.4.0.exe",
    "hash": "61f89d4e5d43f75e9b1c4d096b2c6d283781ff7bc36c293434d683c8532ed0cd",
    "pre_install": [
        "$package = Get-ChildItem -LiteralPath $dir -Filter 'Luma-Circle-*.exe' -File | Select-Object -First 1",
        "if (-not $package) { throw 'Luma Circle portable executable was not found.' }",
        "Move-Item -LiteralPath $package.FullName -Destination (Join-Path $dir 'Luma-Circle.exe')"
    ],
    "shortcuts": [
        [
            "Luma-Circle.exe",
            "Luma Circle"
        ]
    ],
    "checkver": {
        "url": "https://api.github.com/repos/aymenki/luma-circle/releases/latest",
        "jsonpath": "$.tag_name",
        "regex": "v(?<version>[\\d.]+)"
    },
    "autoupdate": {
        "url": "https://github.com/aymenki/luma-circle/releases/download/v$version/Luma-Circle-$version.exe"
    }
}
