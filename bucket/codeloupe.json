{
  "version": "0.1.0",
  "description": "On-demand code index for AI coding agents: declarations, outlines, usages and callers instead of whole files.",
  "homepage": "https://github.com/Terrio-cz/CodeLoupe",
  "license": {
    "identifier": "PolyForm-Noncommercial-1.0.0",
    "url": "https://github.com/Terrio-cz/CodeLoupe/blob/main/LICENSE"
  },
  "notes": "CodeLoupe updates through Scoop (scoop update codeloupe); its own updater is off for this install.",
  "architecture": {
    "64bit": {
      "url": "https://github.com/Terrio-cz/CodeLoupe/releases/download/v0.1.0/CodeLoupe-0.1.0-win-x64.exe#/dl.7z",
      "hash": "3c6b92f86cdd74844347ba25074bc524154227af873b96574389c8b71222bf43"
    }
  },
  "pre_install": [
    "$nested = Get-ChildItem \"$dir\\`$PLUGINSDIR\" -Filter app-64.7z -ErrorAction SilentlyContinue | Select-Object -First 1",
    "if ($nested) { Expand-7zipArchive $nested.FullName $dir }",
    "Remove-Item \"$dir\\`$*\", \"$dir\\Uninstall*\" -Recurse -Force -ErrorAction SilentlyContinue"
  ],
  "bin": [
    [
      "resources\\codeloupe\\bin\\codeloupe.bat",
      "codeloupe"
    ]
  ],
  "shortcuts": [
    [
      "CodeLoupe.exe",
      "CodeLoupe"
    ]
  ],
  "checkver": "github",
  "autoupdate": {
    "architecture": {
      "64bit": {
        "url": "https://github.com/Terrio-cz/CodeLoupe/releases/download/v$version/CodeLoupe-$version-win-x64.exe#/dl.7z"
      }
    },
    "hash": {
      "url": "$baseurl/SHA256SUMS.txt",
      "regex": "$sha256\\s+\\*?CodeLoupe-$version-win-x64\\.exe"
    }
  }
}
