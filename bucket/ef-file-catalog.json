{
    "version": "26.10",
    "description": "Catalogs disks and directories for offline browsing and searching, with support for compressed archives.",
    "homepage": "https://efsoftware.com/fc/e.htm",
    "license": "Shareware",
    "architecture": {
        "64bit": {
            "url": "https://efsoftware.com/_p4/fc",
            "extract_dir": "ef_file_catalog_64",
            "shortcuts": [
                [
                    "EFCat.exe",
                    "EF File Catalog"
                ]
            ]
        }
    },
    "checkver": {
        "script": [
            "$response = Invoke-WebRequest -Uri 'https://efsoftware.com/dw/e.htm' -UseBasicParsing",
            "$html = [string]$response.Content",
            "$needle = 'href=\"/fc/e.htm\"'",
            "$start = $html.IndexOf($needle, [System.StringComparison]::OrdinalIgnoreCase)",
            "if ($start -lt 0) { throw 'Could not locate EF File Catalog in the official EFSoftware download page.' }",
            "$versionCell = $html.IndexOf('align=right>', $start, [System.StringComparison]::OrdinalIgnoreCase)",
            "if ($versionCell -lt 0) { throw 'Could not locate the EF File Catalog version cell in the official download page.' }",
            "$valueStart = $versionCell + 'align=right>'.Length",
            "$valueLength = [Math]::Min(80, $html.Length - $valueStart)",
            "$versionText = $html.Substring($valueStart, $valueLength)",
            "$match = [regex]::Match($versionText, '(?<version>\\d+\\.\\d+)')",
            "if (-not $match.Success) { throw 'Could not parse the EF File Catalog version from the official download page.' }",
            "$match.Groups['version'].Value"
        ],
        "regex": "(?<version>\\d+\\.\\d+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://efsoftware.com/_p4/fc",
                "extract_dir": "ef_file_catalog_64"
            }
        }
    }
}
