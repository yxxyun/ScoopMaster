{
    "version": "6.3.1",
    "description": "Screen capture utility for everyday tasks",
    "homepage": "https://www.ntwind.com/software/winsnap.html",
    "license": "Proprietary",
    "url": "https://www.ntwind.com/download/WinSnap_6.3.1-setup.exe",
    "hash": "e829a84216ac72a685eb15eedc11cc79cb03b5a5aa60127e88719d0f2bbb33e3",
    "notes": "If the download is blocked by Cloudflare, download the installer manually from the homepage, then run: scoop cache-import winsnap <path-to-file>",
    "depends": [
        "main/7zip",
        "ntwind/cache-import"
    ],
    "installer": {
        "script": [
            "7z x \"$dir\\$fname\" -o\"$dir\" -aou -y | Out-Null",
            "Remove-Item \"$dir\\$fname\"",
            "Remove-Item \"$dir\\*PLUGINSDIR\" -Recurse -Force -ErrorAction SilentlyContinue",
            "Remove-Item \"$dir\\*.nsis\" -ErrorAction SilentlyContinue",
            "Remove-Item \"$dir\\uninst.exe\" -ErrorAction SilentlyContinue",
            "$machine = @{}",
            "@(\"WinSnap.exe\", \"WinSnap_1.exe\") | Where-Object { Test-Path \"$dir\\$_\" } | ForEach-Object { $fs = [IO.File]::OpenRead(\"$dir\\$_\"); $br = New-Object IO.BinaryReader($fs); $fs.Position = 0x3C; $peOffset = $br.ReadInt32(); $fs.Position = $peOffset + 4; $machine[$_] = $br.ReadUInt16(); $br.Close(); $fs.Close() }",
            "$x64exe = ($machine.GetEnumerator() | Where-Object { $_.Value -eq 0x8664 }).Name",
            "$x86exe = ($machine.GetEnumerator() | Where-Object { $_.Value -eq 0x014c }).Name",
            "if ($x64exe) { Rename-Item \"$dir\\$x64exe\" \"WinSnap64.exe\" }",
            "if ($x86exe) { Rename-Item \"$dir\\$x86exe\" \"WinSnap32.exe\" }"
        ]
    },
    "architecture": {
        "64bit": {
            "bin": [
                [
                    "WinSnap64.exe",
                    "winsnap"
                ],
                "WinSnap64.exe"
            ],
            "shortcuts": [
                [
                    "WinSnap64.exe",
                    "WinSnap"
                ]
            ]
        },
        "32bit": {
            "bin": [
                [
                    "WinSnap32.exe",
                    "winsnap"
                ],
                "WinSnap32.exe"
            ],
            "shortcuts": [
                [
                    "WinSnap32.exe",
                    "WinSnap"
                ]
            ]
        }
    },
    "checkver": {
        "url": "https://www.ntwind.com/download-all.html",
        "regex": "WinSnap_([\\d.]+)-setup\\.exe"
    },
    "autoupdate": {
        "url": "https://www.ntwind.com/download/WinSnap_$version-setup.exe"
    }
}
