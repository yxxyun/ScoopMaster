{
    "version": "1.10.1",
    "description": "Terminal and coding-agent workspace manager",
    "homepage": "https://termilly.com",
    "license": "Apache-2.0",
    "architecture": {
        "64bit": {
            "url": [
                "https://github.com/termilly/termilly/releases/download/v1.10.1/TermillySetup-1.10.1.exe",
                "https://builds.dotnet.microsoft.com/dotnet/WindowsDesktop/10.0.15/windowsdesktop-runtime-10.0.15-win-x64.zip"
            ],
            "hash": [
                "e881bde78736864a93ebe0570466ca7ccece74d79671231866f7bf68d3b65371",
                "60f6a65f98a0882deeba9ab78ac923745b420cb9c0a84b9fe47cf3ac5f61c7ed"
            ]
        }
    },
    "installer": {
        "script": [
            "$ErrorActionPreference = 'Stop'",
            "$downloadName = if ($fname -is [array]) { [string]$fname[0] } else { [string]$fname }",
            "$setupPath = Join-Path $dir $downloadName",
            "$payloadZip = Join-Path $dir '.termilly-payload.zip'",
            "$stream = $null",
            "$reader = $null",
            "",
            "try {",
            "    $stream = [System.IO.File]::OpenRead($setupPath)",
            "    $reader = [System.IO.BinaryReader]::new($stream)",
            "",
            "    if ($stream.Length -lt 512) { throw 'Termilly setup is too small to contain a valid PE payload.' }",
            "",
            "    $stream.Position = 0x3C",
            "    $peOffset = $reader.ReadInt32()",
            "    if ($peOffset -le 0 -or $peOffset -gt ($stream.Length - 256)) {",
            "        throw 'Termilly setup has an invalid PE header offset.'",
            "    }",
            "",
            "    $stream.Position = $peOffset",
            "    if ($reader.ReadUInt32() -ne 0x00004550) { throw 'Termilly setup is not a valid PE executable.' }",
            "",
            "    $optionalHeader = $peOffset + 24",
            "    $stream.Position = $optionalHeader",
            "    $peMagic = $reader.ReadUInt16()",
            "    if ($peMagic -eq 0x20B) {",
            "        $securityDirectory = $optionalHeader + 144",
            "    } elseif ($peMagic -eq 0x10B) {",
            "        $securityDirectory = $optionalHeader + 128",
            "    } else {",
            "        throw 'Unsupported PE optional-header format in Termilly setup.'",
            "    }",
            "",
            "    $stream.Position = $securityDirectory",
            "    $certificateOffset = [long]$reader.ReadUInt32()",
            "    $certificateSize = [long]$reader.ReadUInt32()",
            "    $payloadEnd = $stream.Length",
            "    if ($certificateOffset -gt 0 -and $certificateSize -gt 0 -and",
            "        ($certificateOffset + $certificateSize) -eq $stream.Length) {",
            "        $payloadEnd = $certificateOffset",
            "    }",
            "",
            "    $tailLength = 56",
            "    if ($payloadEnd -lt $tailLength) { throw 'Termilly setup does not contain its embedded payload footer.' }",
            "",
            "    $stream.Position = $payloadEnd - $tailLength",
            "    $tail = $reader.ReadBytes($tailLength)",
            "    if ($tail.Length -ne $tailLength) { throw 'Could not read the Termilly setup payload footer.' }",
            "",
            "    $magic = [System.Text.Encoding]::ASCII.GetBytes('TMLYPAY1')",
            "    $magicAt = -1",
            "    for ($i = $tail.Length - $magic.Length; $i -ge 0; $i--) {",
            "        $same = $true",
            "        for ($j = 0; $j -lt $magic.Length; $j++) {",
            "            if ($tail[$i + $j] -ne $magic[$j]) { $same = $false; break }",
            "        }",
            "        if ($same) { $magicAt = $i; break }",
            "    }",
            "    if ($magicAt -lt 40) { throw 'Termilly setup is missing the TMLYPAY1 payload marker.' }",
            "",
            "    $footerStart = $payloadEnd - $tailLength + $magicAt + $magic.Length - 48",
            "    $stream.Position = $footerStart",
            "    $payloadOffset = $reader.ReadInt64()",
            "    $expectedHashBytes = $reader.ReadBytes(32)",
            "    $payloadLength = $footerStart - $payloadOffset",
            "    if ($payloadOffset -le 0 -or $payloadLength -le 0 -or $expectedHashBytes.Length -ne 32) {",
            "        throw 'Termilly setup contains invalid embedded payload offsets.'",
            "    }",
            "",
            "    $stream.Position = $payloadOffset",
            "    $output = [System.IO.File]::Create($payloadZip)",
            "    try {",
            "        $buffer = [byte[]]::new(1048576)",
            "        $remaining = $payloadLength",
            "        while ($remaining -gt 0) {",
            "            $wanted = [int][Math]::Min($buffer.Length, $remaining)",
            "            $read = $stream.Read($buffer, 0, $wanted)",
            "            if ($read -le 0) { throw 'Unexpected end of Termilly embedded payload.' }",
            "            $output.Write($buffer, 0, $read)",
            "            $remaining -= $read",
            "        }",
            "    } finally {",
            "        $output.Dispose()",
            "    }",
            "} finally {",
            "    if ($null -ne $reader) { $reader.Dispose() }",
            "    elseif ($null -ne $stream) { $stream.Dispose() }",
            "}",
            "",
            "$expectedHash = [BitConverter]::ToString($expectedHashBytes).Replace('-', '').ToLowerInvariant()",
            "$actualHash = (Get-FileHash -LiteralPath $payloadZip -Algorithm SHA256).Hash.ToLowerInvariant()",
            "if ($actualHash -ne $expectedHash) {",
            "    Remove-Item -LiteralPath $payloadZip -Force -ErrorAction SilentlyContinue",
            "    throw \"Termilly embedded payload SHA-256 mismatch. Expected $expectedHash; got $actualHash.\"",
            "}",
            "",
            "Add-Type -AssemblyName System.IO.Compression",
            "Add-Type -AssemblyName System.IO.Compression.FileSystem",
            "$archive = [System.IO.Compression.ZipFile]::OpenRead($payloadZip)",
            "$root = [System.IO.Path]::GetFullPath($dir).TrimEnd('\\') + '\\'",
            "try {",
            "    foreach ($entry in $archive.Entries) {",
            "        if (-not $entry.FullName.StartsWith('app/', [System.StringComparison]::OrdinalIgnoreCase)) { continue }",
            "        $relative = $entry.FullName.Substring(4).Replace('/', [System.IO.Path]::DirectorySeparatorChar)",
            "        if ([string]::IsNullOrWhiteSpace($relative)) { continue }",
            "",
            "        $destination = [System.IO.Path]::GetFullPath((Join-Path $dir $relative))",
            "        if (-not $destination.StartsWith($root, [System.StringComparison]::OrdinalIgnoreCase)) {",
            "            throw \"Unsafe path in Termilly app payload: $($entry.FullName)\"",
            "        }",
            "",
            "        if ($entry.FullName.EndsWith('/')) {",
            "            New-Item -ItemType Directory -Path $destination -Force | Out-Null",
            "        } else {",
            "            $parent = Split-Path -Parent $destination",
            "            New-Item -ItemType Directory -Path $parent -Force | Out-Null",
            "            [System.IO.Compression.ZipFileExtensions]::ExtractToFile($entry, $destination, $true)",
            "        }",
            "    }",
            "} finally {",
            "    $archive.Dispose()",
            "}",
            "",
            "$mainExe = Join-Path $dir 'Termilly.exe'",
            "$cliExe = Join-Path $dir 'agent\\termilly.exe'",
            "if (-not (Test-Path -LiteralPath $mainExe -PathType Leaf)) { throw 'Termilly.exe is missing from the embedded app payload.' }",
            "",
            "$dotnetArchive = Join-Path $dir 'windowsdesktop-runtime-10.0.15-win-x64.zip'",
            "$dotnetRoot = Join-Path $dir 'dotnet'",
            "if (-not (Test-Path -LiteralPath $dotnetArchive -PathType Leaf)) { throw 'The portable .NET Desktop Runtime archive is missing.' }",
            "Expand-Archive -LiteralPath $dotnetArchive -DestinationPath $dotnetRoot -Force",
            "if (-not (Test-Path -LiteralPath (Join-Path $dotnetRoot 'dotnet.exe') -PathType Leaf) -or",
            "    -not (Test-Path -LiteralPath (Join-Path $dotnetRoot 'shared\\Microsoft.WindowsDesktop.App') -PathType Container)) {",
            "    throw 'The portable .NET 10 Desktop Runtime was not extracted correctly.'",
            "}",
            "",
            "if (-not (Test-Path -LiteralPath $cliExe -PathType Leaf)) { throw 'agent\\termilly.exe is missing from the embedded app payload.' }",
            "",
            "$binDir = Join-Path $dir 'bin'",
            "New-Item -ItemType Directory -Path $binDir -Force | Out-Null",
            "$wrapper = @'",
            "@echo off",
            "for %%I in (\"%~dp0..\\dotnet\") do set \"DOTNET_ROOT=%%~fI\"",
            "set \"DOTNET_ROOT_X64=%DOTNET_ROOT%\"",
            "set \"TERMILLY_DATA_DIR=%~dp0..\\data\"",
            "if \"%~1\"==\"\" (",
            "    start \"\" \"%~dp0..\\Termilly.exe\"",
            ") else (",
            "    \"%~dp0..\\agent\\termilly.exe\" %*",
            ")",
            "'@",
            "[System.IO.File]::WriteAllText((Join-Path $binDir 'termilly.cmd'), $wrapper, [System.Text.Encoding]::ASCII)",
            "",
            "Remove-Item -LiteralPath $payloadZip -Force",
            "Remove-Item -LiteralPath $dotnetArchive -Force",
            "Remove-Item -LiteralPath $setupPath -Force"
        ]
    },
    "persist": "data",
    "bin": [
        [
            "bin\\termilly.cmd",
            "termilly"
        ]
    ],
    "shortcuts": [
        [
            "bin\\termilly.cmd",
            "Termilly"
        ]
    ],
    "notes": [
        "Includes the .NET 10.0.15 Desktop Runtime locally; Termilly settings, logs and recordings are stored in Scoop's persistent data directory.",
        "Requires the Microsoft Edge WebView2 Evergreen Runtime."
    ],
    "checkver": {
        "url": "https://api.github.com/repos/termilly/termilly/releases/latest",
        "regex": "\"tag_name\"\\s*:\\s*\"v(?<version>[\\d.]+)\""
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": [
                    "https://github.com/termilly/termilly/releases/download/v$version/TermillySetup-$version.exe",
                    "https://builds.dotnet.microsoft.com/dotnet/WindowsDesktop/10.0.15/windowsdesktop-runtime-10.0.15-win-x64.zip"
                ],
                "hash": [
                    {
                        "url": "https://github.com/termilly/termilly/releases/download/v$version/SHA256SUMS",
                        "find": "([a-fA-F\\d]{64})\\s+TermillySetup-$version\\.exe"
                    },
                    {
                        
                    }
                ]
            }
        }
    },
    "post_install": {
        "script": [
            "$portableData = Join-Path $dir 'data'",
            "New-Item -ItemType Directory -Path $portableData -Force | Out-Null",
            "$settingsFile = Join-Path $portableData 'settings.json'",
            "if (-not (Test-Path -LiteralPath $settingsFile -PathType Leaf)) {",
            "    $settings = [ordered]@{",
            "        version = 2",
            "        logging = [ordered]@{ folder = (Join-Path $portableData 'logs') }",
            "        recording = [ordered]@{ folder = (Join-Path $portableData 'recordings') }",
            "    }",
            "    $settings | ConvertTo-Json -Depth 4 | Set-Content -LiteralPath $settingsFile -Encoding UTF8",
            "}"
        ]
    }
}
