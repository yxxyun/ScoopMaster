{
    "version": "0.1.0",
    "description": "Switch your Windows 11 desktop to a Windows XP look and back with one click. Tray app driving RetroBar and Open-Shell, with a snapshot that puts everything back.",
    "homepage": "https://github.com/Londopy/EraSwitch",
    "license": "MIT",
    "notes": "EraSwitch needs RetroBar and Open-Shell. Install them from its Settings, or: winget install dremin.RetroBar; winget install Open-Shell.Open-Shell-Menu",
    "url": "https://github.com/Londopy/EraSwitch/releases/download/v0.1.0/EraSwitch-v0.1.0-portable.zip",
    "hash": "0a1a34bb7f73e38f0862fed2f379af2efb5297e863cced4c127377e8bd80c60a",
    "extract_dir": "EraSwitch",
    "architecture": {
        "64bit": {
            "bin": "x64\\EraSwitch.exe",
            "shortcuts": [
                [
                    "x64\\EraSwitch.exe",
                    "EraSwitch"
                ]
            ]
        },
        "32bit": {
            "bin": "x86\\EraSwitch.exe",
            "shortcuts": [
                [
                    "x86\\EraSwitch.exe",
                    "EraSwitch"
                ]
            ]
        },
        "arm64": {
            "bin": "arm64\\EraSwitch.exe",
            "shortcuts": [
                [
                    "arm64\\EraSwitch.exe",
                    "EraSwitch"
                ]
            ]
        }
    },
    "persist": [
        "x64\\config.toml",
        "x86\\config.toml",
        "arm64\\config.toml"
    ],
    "pre_install": "@('x64','x86','arm64') | ForEach-Object { $sub = Join-Path $dir $_; if (Test-Path $sub) { $marker = Join-Path $sub 'portable'; if (!(Test-Path $marker)) { New-Item -ItemType File -Path $marker | Out-Null } } }",
    "checkver": {
        "github": "https://github.com/Londopy/EraSwitch"
    },
    "autoupdate": {
        "url": "https://github.com/Londopy/EraSwitch/releases/download/v$version/EraSwitch-v$version-portable.zip",
        "hash": {
            "url": "https://github.com/Londopy/EraSwitch/releases/download/v$version/SHA256SUMS.txt",
            "regex": "$sha256\\s+$basename"
        }
    }
}
