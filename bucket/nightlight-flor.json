{
    "version": "2.0",
    "description": "Portable Windows tray utility for display color temperature, brightness, contrast, and monitor controls",
    "homepage": "https://github.com/iamfromreallife/NightLightFlor",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/iamfromreallife/NightLightFlor/releases/download/v2.0/NightLight.exe",
            "hash": "cf67bf538078013d919769dbcd0fe755d3334e57f263f851b579c6d36c31d98d"
        }
    },
    "pre_install": [
        "$legacyConfig = Join-Path $env:APPDATA 'NightLight\\config.json'",
        "if (!(Test-Path -LiteralPath \"$dir\\config.json\" -PathType Leaf)) {",
        "    if (Test-Path -LiteralPath $legacyConfig -PathType Leaf) {",
        "        Copy-Item -LiteralPath $legacyConfig -Destination \"$dir\\config.json\"",
        "    } else {",
        "        [System.IO.File]::WriteAllText(\"$dir\\config.json\", '{}', [System.Text.UTF8Encoding]::new($false))",
        "    }",
        "}"
    ],
    "persist": [
        "config.json"
    ],
    "shortcuts": [
        [
            "NightLight.exe",
            "NightLight"
        ]
    ],
    "checkver": {
        "url": "https://api.github.com/repos/iamfromreallife/NightLightFlor/releases/latest",
        "jsonpath": "$.tag_name",
        "regex": "v(?<version>\\d+\\.\\d+(?:\\.\\d+)?)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/iamfromreallife/NightLightFlor/releases/download/v$version/NightLight.exe",
                "hash": {
                    "url": "https://api.github.com/repos/iamfromreallife/NightLightFlor/releases/tags/v$version",
                    "jsonpath": "$.assets[?(@.name == '$basename')].digest"
                }
            }
        }
    }
}
