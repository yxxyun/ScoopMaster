    "extract_dir": "LEL-Downloader",
    "post_install": [
        "$source = Join-Path $env:APPDATA 'LEL-Downloader'",
        "$target = Join-Path $persist_dir 'user-data'",
        "$item = Get-Item -LiteralPath $source -Force -ErrorAction SilentlyContinue",
        "if ($item -and $item.LinkType -eq 'Junction' -and @($item.Target)[0] -eq $target) { return }",
        "if ($item) {",
        "    if (-not $item.PSIsContainer -or $item.Attributes -band [IO.FileAttributes]::ReparsePoint) {",
        "        throw \"Cannot migrate data path: $source\"",
        "    }",
        "    $backup = \"$source.pre-scoop\"",
        "    if (Test-Path -LiteralPath $backup) { throw \"Data backup already exists: $backup\" }",
        "    if (-not (Get-ChildItem -LiteralPath $target -Force)) {",
        "        & robocopy $source $target /E /R:1 /W:1 /NFL /NDL /NJH /NJS /NP | Out-Null",
        "        if ($LASTEXITCODE -gt 7) { throw 'Failed to copy existing Xuewuzhi data.' }",
        "    }",
        "    Move-Item -LiteralPath $source -Destination $backup -ErrorAction Stop",
        "    info \"Original data backed up to $backup\"",
        "}",
        "New-Item -Path $source -ItemType Junction -Value $target -ErrorAction Stop | Out-Null"
    ],
    "pre_uninstall": [
        "$source = Join-Path $env:APPDATA 'LEL-Downloader'",
        "$target = Join-Path $persist_dir 'user-data'",
        "$item = Get-Item -LiteralPath $source -Force -ErrorAction SilentlyContinue",
        "if ($purge -and $item.LinkType -eq 'Junction' -and @($item.Target)[0] -eq $target) {",
        "    & $env:COMSPEC /c \"rmdir `\"$source`\"\"",
        "}"
    ],
    "bin": [
