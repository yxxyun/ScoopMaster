{
    "version": "5.0.0-beta.2",
    "description": "A privacy-focused note-taking app for Windows, macOS and Linux.",
    "homepage": "https://github.com/Beaver-Notes/Beaver-Notes",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/Beaver-Notes/Beaver-Notes/releases/download/v5.0.0-beta.2/Beaver.Notes-5.0.0-beta.2-portable-windows-x64.zip",
            "hash": "4005ff1adee55f6845ad361d1b9f4aa83dddd8c05f9b6cbbac844bb17e56b3bc"
        }
    },
    "post_install": [
        "$exe = Join-Path $dir 'beaver-notes.exe'",
        "if (!(Test-Path $exe)) {",
        "    $portable = Get-ChildItem -Path $dir -File | Where-Object { $_.Name -match '^Beaver[.-]Notes-.*-portable\\.exe$' } | Select-Object -First 1",
        "    if ($portable) { Rename-Item -LiteralPath $portable.FullName -NewName 'beaver-notes.exe' }",
        "}",
        "if (!(Test-Path $exe)) { throw 'beaver-notes.exe was not found after installation.' }"
    ],
    "bin": "beaver-notes.exe",
    "shortcuts": [
        [
            "beaver-notes.exe",
            "Beaver Notes"
        ]
    ],
    "checkver": {
        "url": "https://api.github.com/repos/Beaver-Notes/Beaver-Notes/releases?per_page=100",
        "regex": "\"tag_name\":\"(?<tag>v?(?<version>[\\d.]+(?:-[A-Za-z0-9.-]+)?))\"[\\s\\S]*?\"name\":\"(?<file>Beaver[.-]Notes-[^\"]*-portable(?:-windows-x64)?\\.(?:zip|exe))\""
    },
    "autoupdate": {
        "url": "https://github.com/Beaver-Notes/Beaver-Notes/releases/download/$matchTag/$matchFile",
        "hash": {
            "url": "https://api.github.com/repos/Beaver-Notes/Beaver-Notes/releases/tags/$matchTag",
            "regex": "\"name\":\"$matchFile\"[\\s\\S]*?\"digest\":\"sha256:([a-f0-9]{64})\""
        }
    }
}
