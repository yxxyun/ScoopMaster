    "license": {
        "identifier": "PolyForm-Noncommercial-1.0.0",
        "url": "https://polyformproject.org/licenses/noncommercial/1.0.0"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/light-cloud-com/out-loud/releases/download/v2.1.2/Out.Loud.Setup.2.1.2.exe",
            "hash": "b40e61611b84f46458cdbdbb1c38495381b27f686d022a979ef038f1e7743518",
            "installer": {
                "args": [
                    "/S",
                    "/D=$dir"
                ]
            }
        }
    },
    "checkver": {
        "github": "https://github.com/light-cloud-com/out-loud",
        "regex": "v(?<version>[\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/light-cloud-com/out-loud/releases/download/v$version/Out.Loud.Setup.$version.exe"
            }
        }
    },
    "shortcuts": [
        [
            "Out Loud.exe",
            "Out Loud"
        ]
    ],
    "uninstaller": {
        "script": [
            "if (Test-Path \"$dir\\Uninstall Out Loud.exe\") {",
            "    Start-Process -FilePath \"$dir\\Uninstall Out Loud.exe\" -ArgumentList @('/S', \"_?=$dir\") -Wait",
            "}"
        ]
    }
}
