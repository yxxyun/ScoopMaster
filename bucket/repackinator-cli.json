{
    "version": "2.0.5",
    "description": "Convert your full OG Xbox ISO dumps into split ISO images",
    "homepage": "https://github.com/Team-Resurgent/Repackinator",
    "license": "GPL-3.0-only",
    "architecture": {
        "64bit": {
            "url": "https://github.com/Team-Resurgent/Repackinator/releases/download/V2.0.5/Repackinator.Shell-win-x64.zip",
            "hash": "871bb19a40cdf8c19392c249a1fbc344753562e9745b867f2afad7eae188795d"
        }
    },
    "pre_install": [
        "if (!(Test-Path \"$persist_dir\\config.json\")) { Set-Content \"$dir\\config.json\" (@('{', '}') -join \"`r`n\") -Encoding Unicode | Out-Null }",
        "if (!(Test-Path \"$persist_dir\\settings.ini\")) { New-Item \"$dir\\settings.ini\" | Out-Null }"
    ],
    "persist": [
        "config.json",
        "settings.ini"
    ],
    "bin": [
        [
            "repackinator.shell.exe",
            "repackinator"
        ]
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/Team-Resurgent/Repackinator/releases/download/V$version/Repackinator.Shell-win-x64.zip"
            }
        }
    }
}
