{
    "version": "0.72.0",
    "description": "Mobile-first AI workstation for running coding agents from a web interface",
    "homepage": "https://github.com/clawbench-dev/clawbench",
    "license": "MIT",
    "notes": [
        "Runtime data: %USERPROFILE%\\.clawbench\\",
        "This package migrates that directory into Scoop persist and mounts it through a Junction",
        "Stop ClawBench before installing, upgrading, or uninstalling",
        "Use 'scoop update clawbench' instead of the in-app self-updater so Scoop remains the package owner"
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/clawbench-dev/clawbench/releases/download/v0.72.0/clawbench-windows-amd64.zip",
            "hash": "32a48f7a8dead41dbbd832fd7dc0e9a79b335059e2d8d8008fe9a034b0adf4a1"
        }
    },
    "extract_dir": "clawbench",
    "bin": "clawbench.exe",
    "post_install": [
        "$running = @(Get-Process -Name 'clawbench' -ErrorAction SilentlyContinue)",
        "if ($running.Count -gt 0) { throw 'ClawBench is running. Stop it before installing or upgrading this package.' }",
        "",
        "$source = Join-Path $env:USERPROFILE '.clawbench'",
        "$target = Join-Path $persist_dir 'data'",
        "ensure $target",
        "$backup = $null",
        "$needsMount = $true",
        "",
        "if (Test-Path $source) {",
        "    $item = Get-Item -LiteralPath $source -Force",
        "    if ($item.Attributes -band [IO.FileAttributes]::ReparsePoint) {",
        "        $expected = [IO.Path]::GetFullPath($target).TrimEnd('\\')",
        "        $actual = @($item.Target) | Select-Object -First 1",
        "        if ($actual -and [IO.Path]::GetFullPath($actual).TrimEnd('\\') -ieq $expected) {",
        "            $needsMount = $false",
        "            Write-Host \"Junction already managed by Scoop: $source\"",
        "        } else {",
        "            throw \"Path is an existing reparse point not managed by this package: $source\"",
        "        }",
        "    } elseif (-not $item.PSIsContainer) {",
        "        throw \"Path exists and is not a directory: $source\"",
        "    } else {",
        "        & robocopy.exe $source $target /E /R:1 /W:1 /NFL /NDL /NJH /NJS /NP | Out-Null",
        "        $copyExitCode = $LASTEXITCODE",
        "        if ($copyExitCode -gt 7) {",
        "            throw \"Migration failed with robocopy exit code ${copyExitCode}: $source\"",
        "        }",
        "",
        "        $backup = \"$source.backup-$(Get-Date -Format 'yyyyMMdd-HHmmssfff')\"",
        "        Move-Item -LiteralPath $source -Destination $backup",
        "        Write-Host \"Backed up original directory: $backup\"",
        "    }",
        "}",
        "",
        "if ($needsMount) {",
        "    try {",
        "        New-Item -Path $source -ItemType Junction -Value $target -Force | Out-Null",
        "    } catch {",
        "        if ($backup -and (Test-Path $backup) -and -not (Test-Path $source)) {",
        "            Move-Item -LiteralPath $backup -Destination $source",
        "        }",
        "        throw",
        "    }",
        "}",
        "",
        "$configDir = Join-Path $target 'config'",
        "ensure $configDir",
        "$configFile = Join-Path $configDir 'config.yaml'",
        "if (-not (Test-Path $configFile)) { New-Item -Path $configFile -ItemType File | Out-Null }"
    ],
    "post_uninstall": [
        "$running = @(Get-Process -Name 'clawbench' -ErrorAction SilentlyContinue)",
        "if ($running.Count -gt 0) { throw 'ClawBench is running. Stop it before uninstalling this package.' }",
        "",
        "$source = Join-Path $env:USERPROFILE '.clawbench'",
        "if (Test-Path $source) {",
        "    $item = Get-Item -LiteralPath $source -Force",
        "    if ($item.Attributes -band [IO.FileAttributes]::ReparsePoint) {",
        "        $target = Join-Path $persist_dir 'data'",
        "        $expected = [IO.Path]::GetFullPath($target).TrimEnd('\\')",
        "        $actual = @($item.Target) | Select-Object -First 1",
        "        if ($actual -and [IO.Path]::GetFullPath($actual).TrimEnd('\\') -ieq $expected) {",
        "            Remove-Item -LiteralPath $source -Force",
        "        }",
        "    }",
        "}"
    ],
    "persist": "data",
    "checkver": {
        "github": "https://github.com/clawbench-dev/clawbench"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/clawbench-dev/clawbench/releases/download/v$version/clawbench-windows-amd64.zip"
            }
        }
    }
}
