{
    "version": "0.47.19",
    "description": "Cross-platform desktop automation driver for Cua.",
    "homepage": "https://github.com/trycua/cua",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/trycua/cua/releases/download/cua-driver-rs-v0.47.19/cua-driver-rs-0.47.19-windows-x86_64-binary.zip",
            "hash": "b6bbe515167b34446397acbe0a846437cafaa92b8ca5054d7dc51e6c6f003dcf"
        },
        "arm64": {
            "url": "https://github.com/trycua/cua/releases/download/cua-driver-rs-v0.47.19/cua-driver-rs-0.47.19-windows-arm64-binary.zip",
            "hash": "0abbc24ee407c1dd27ec30cbe0a8ed88aefb94be7197ad38e779ac790d48e704"
        }
    },
    "bin": "cua-driver.exe",
    "checkver": {
        "url": "https://api.github.com/repos/trycua/cua/releases?per_page=100",
        "regex": "\\\"tag_name\\\":\\s*\\\"cua-driver-rs-v([\\d.]+)\\\""
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/trycua/cua/releases/download/cua-driver-rs-v$version/cua-driver-rs-$version-windows-x86_64-binary.zip"
            },
            "arm64": {
                "url": "https://github.com/trycua/cua/releases/download/cua-driver-rs-v$version/cua-driver-rs-$version-windows-arm64-binary.zip"
            }
        }
    },
    "pre_install": [
        "$homePath = if ($env:HOME) { $env:HOME } else { $env:USERPROFILE }",
        "$configPath = Join-Path $homePath '.cua-driver\\config.json'",
        "if (!(Test-Path -LiteralPath $configPath)) {",
        "    New-Item -ItemType Directory -Path (Split-Path $configPath) -Force | Out-Null",
        "    [IO.File]::WriteAllText($configPath, '{\"update_check_enabled\":false}', (New-Object Text.UTF8Encoding $false))",
        "} else {",
        "    $text = [IO.File]::ReadAllText($configPath)",
        "    $expected = $text | ConvertFrom-Json -ErrorAction Stop",
        "    if ($null -eq $expected -or $expected -isnot [pscustomobject]) { throw 'Cua Driver configuration must be a JSON object.' }",
        "    $flag = $expected.PSObject.Properties['update_check_enabled']",
        "    if ($flag) {",
        "        if ($flag.Value -isnot [bool]) { throw 'Cua Driver update_check_enabled must be boolean.' }",
        "        $found = [regex]::Matches($text, '\"update_check_enabled\"\\s*:\\s*(true|false)')",
        "        if ($found.Count -ne 1) { throw 'Cannot safely locate Cua Driver update preference.' }",
        "        $changed = [regex]::Replace($text, '(\"update_check_enabled\"\\s*:\\s*)(true|false)', '${1}false')",
        "        $flag.Value = $false",
        "    } else {",
        "        $expected | Add-Member -NotePropertyName update_check_enabled -NotePropertyValue $false",
        "        $comma = if ($text -match '^\\s*\\{\\s*\\}') { '' } else { ',' }",
        "        $changed = $text.Insert($text.LastIndexOf('}'), $comma + '\"update_check_enabled\":false')",
        "    }",
        "    $actual = $changed | ConvertFrom-Json -ErrorAction Stop",
        "    if (($actual | ConvertTo-Json -Depth 100 -Compress) -cne ($expected | ConvertTo-Json -Depth 100 -Compress)) { throw 'Refusing to change unrelated Cua Driver settings.' }",
        "    $temp = Join-Path (Split-Path $configPath) ('.config.' + [guid]::NewGuid() + '.tmp')",
        "    try {",
        "        [IO.File]::WriteAllText($temp, $changed, (New-Object Text.UTF8Encoding $false))",
        "        [IO.File]::Replace($temp, $configPath, ($temp + '.bak'))",
        "        Remove-Item -LiteralPath ($temp + '.bak') -Force",
        "    } finally {",
        "        if (Test-Path -LiteralPath $temp) { Remove-Item -LiteralPath $temp -Force }",
        "    }",
        "}"
    ],
    "notes": "Automatic update checks are disabled; use scoop update cua-driver."
}
