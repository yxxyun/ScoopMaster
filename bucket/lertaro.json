{
    "version": "5.1.0",
    "description": "现代化高颜值且高度可扩展的开源文件检索与启动工具，完美替代并拓展传统商业级桌面检索工作流。",
    "homepage": "https://lertaro.github.io",
    "license": "MIT",
    "notes": [
        "便携模式下，应用配置、索引与缓存保存在 '$persist_dir\\Data'，升级时会自动保留。",
        "提供 CLI 命令 'lff' 和 GUI 命令 'lertaro'。",
        "运行需要 .NET 10 Desktop Runtime（versions/windowsdesktop-runtime-10.0）。",
        "更新前请退出 Lertaro，并执行 'Stop-Service LertaroService -Force -ErrorAction SilentlyContinue'。",
        "建议关闭应用内的静默自动更新，统一使用 'scoop update lertaro'。"
    ],
    "suggest": {
        ".NET Desktop Runtime 10.0": "versions/windowsdesktop-runtime-10.0"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/Lertaro/Lertaro/releases/download/v5.1.0/Lertaro-Portable.zip",
            "hash": "5561c438fcff5b965f1c1a2a8e2c301ebdef7a960863467d43b716b9b7abc613"
        },
        "arm64": {
            "url": "https://github.com/Lertaro/Lertaro/releases/download/v5.1.0/Lertaro-Portable-arm64.zip",
            "hash": "b10b9d60439ca0f474d2abae9fbf05bf7d06e57add51341a019972b684cf48c2"
        }
    },
    "extract_dir": "Lertaro",
    "bin": [
        "lff.exe",
        [
            "Lertaro.App.exe",
            "lertaro"
        ]
    ],
    "shortcuts": [
        [
            "Lertaro.App.exe",
            "Lertaro"
        ]
    ],
    "persist": "Data",
    "pre_uninstall": [
        "Stop-Service -Name 'LertaroService' -Force -ErrorAction SilentlyContinue",
        "Get-Process -Name 'Lertaro.App', 'Lertaro.Service', 'lff' -ErrorAction SilentlyContinue | Stop-Process -Force -ErrorAction SilentlyContinue",
        "if ($cmd -eq 'uninstall') {",
        "    sc.exe stop LertaroService *>$null",
        "    sc.exe delete LertaroService *>$null",
        "    Remove-Item -Path 'HKCU:\\Software\\Classes\\lertaro' -Recurse -Force -ErrorAction SilentlyContinue",
        "    Remove-ItemProperty -Path 'HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Run' -Name 'Lertaro' -Force -ErrorAction SilentlyContinue",
        "    if ($purge) { Remove-Item -Path 'HKCU:\\Software\\Lertaro' -Recurse -Force -ErrorAction SilentlyContinue }",
        "}"
    ],
    "checkver": {
        "github": "https://github.com/Lertaro/Lertaro"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/Lertaro/Lertaro/releases/download/v$version/Lertaro-Portable.zip"
            },
            "arm64": {
                "url": "https://github.com/Lertaro/Lertaro/releases/download/v$version/Lertaro-Portable-arm64.zip"
            }
        }
    }
}
