    "installer": {
        "script": [
            "Expand-7ZipArchive \"$dir\\$fname\" \"$dir\\temp\" -Removal",
            "Get-ChildItem \"$dir\\temp\\`$PLUGINSDIR\" -Filter '*.7z' | ForEach-Object {",
            "    Expand-7ZipArchive $_.FullName \"$dir\"",
            "}",
            "Remove-Item -Recurse -Force \"$dir\\temp\""
        ]
    },
    "bin": "pi-gui.exe",
    "shortcuts": [
        [
            "pi-gui.exe",
            "Pi GUI"
        ]
    ],
    "checkver": {
        "github": "https://github.com/minghinmatthewlam/pi-gui"
    },
    "autoupdate": {
        "url": "https://github.com/minghinmatthewlam/pi-gui/releases/download/v$version/pi-gui-$version-x64.exe"
    }
