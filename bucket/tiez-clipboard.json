{
    "version": "0.3.3",
    "description": "Windows clipboard manager with rich-text history, tags, global search, privacy masking, and device sync.",
    "homepage": "https://github.com/jimuzhe/tiez-clipboard",
    "license": {
        "identifier": "GPL-3.0-only",
        "url": "https://github.com/jimuzhe/tiez-clipboard/blob/master/LICENSE"
    },
    "url": "https://github.com/jimuzhe/tiez-clipboard/releases/download/v0.3.3/TieZ_0.3.3-portable.zip",
    "hash": "74a4cc2561b5ee48fc3788794d157ab45802e1e8fffaae49cfa3574c66e39548",
    "bin": "tiez-app.exe",
    "shortcuts": [
        [
            "tiez-app.exe",
            "TieZ"
        ]
    ],
    "persist": "data",
    "checkver": {
        "script": [
            "$headers = @{ 'Accept' = 'application/vnd.github+json'; 'User-Agent' = 'Scoop-KiroBucket' }",
            "if (-not [string]::IsNullOrWhiteSpace($env:GITHUB_TOKEN)) { $headers['Authorization'] = \"Bearer $env:GITHUB_TOKEN\" }",
            "$releases = Invoke-RestMethod -Uri 'https://api.github.com/repos/jimuzhe/tiez-clipboard/releases?per_page=100' -Headers $headers",
            "$asset = $null",
            "foreach ($release in $releases) {",
            "    $asset = $release.assets | Where-Object { $_.browser_download_url -match 'releases/download/v[\\d.]+/TieZ_[\\d.]+(-portable|_x64_portable)\\.zip$' } | Select-Object -First 1",
            "    if ($asset) { break }",
            "}",
            "if (-not $asset) { throw 'No TieZ portable Windows ZIP was found in the GitHub release assets.' }",
            "Write-Output $asset.browser_download_url"
        ],
        "regex": "releases/download/v(?<version>[\\d.]+)/TieZ_[\\d.]+(?<portableSuffix>-portable|_x64_portable)\\.zip"
    },
    "autoupdate": {
        "url": "https://github.com/jimuzhe/tiez-clipboard/releases/download/v$version/TieZ_$version$matchPortableSuffix.zip",
        "extract_dir": "TieZ_$version$matchPortableSuffix"
    },
    "notes": "Portable ZIP release. Scoop preserves the data directory across updates.",
    "extract_dir": "TieZ_0.3.3-portable"
}
