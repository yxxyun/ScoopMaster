{
    "version": "1.2.8",
    "description": "A free cross platform open-source file manager with two panels side by side. Inspired by Total Commander.",
    "homepage": "https://doublecmd.sourceforge.io/",
    "license": "GPL-2.0-or-later",
    "notes": "Double Commander is compatible with Total Commander plugins. Put your plugins in $persist_dir\\plugins",
    "architecture": {
        "64bit": {
            "url": "https://github.com/doublecmd/doublecmd/releases/download/v1.2.8/doublecmd-1.2.8.x86_64-win64.zip",
            "hash": "45bdb86a58ff36361eff010bd41e4ed817128d63d826ef9692e63def3fcaccb0"
        },
        "32bit": {
            "url": "https://github.com/doublecmd/doublecmd/releases/download/v1.2.8/doublecmd-1.2.8.i386-win32.zip",
            "hash": "42de9ea03212aebafbc22625b5e8bf8f1ba0808ff798646e8816270b2ae55755"
        }
    },
    "extract_dir": "doublecmd",
    "bin": "doublecmd.exe",
    "shortcuts": [
        [
            "doublecmd.exe",
            "Double Commander"
        ]
    ],
    "persist": [
        "settings",
        "plugins"
    ],
    "checkver": {
        "github": "https://github.com/doublecmd/doublecmd",
        "regex": "tag/v([\\w\\.-]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/doublecmd/doublecmd/releases/download/v$version/doublecmd-$version.x86_64-win64.zip"
            },
            "32bit": {
                "url": "https://github.com/doublecmd/doublecmd/releases/download/v$version/doublecmd-$version.i386-win32.zip"
            }
        }
    }
}
