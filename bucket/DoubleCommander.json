{
    "version": "1.2.9",
    "description": "A free cross platform open-source file manager with two panels side by side. Inspired by Total Commander.",
    "homepage": "https://doublecmd.sourceforge.io/",
    "license": "GPL-2.0-or-later",
    "notes": "Double Commander is compatible with Total Commander plugins. Put your plugins in $persist_dir\\plugins",
    "architecture": {
        "64bit": {
            "url": "https://github.com/doublecmd/doublecmd/releases/download/v1.2.9/doublecmd-1.2.9.x86_64-win64.zip",
            "hash": "e8472c0105dbde55db4ffbdbd190eab65e9da0375596454995fae4a1fc128dee"
        },
        "32bit": {
            "url": "https://github.com/doublecmd/doublecmd/releases/download/v1.2.9/doublecmd-1.2.9.i386-win32.zip",
            "hash": "834a573f7fb2850aebd5e3edbd0eb6b7bb05b730f38c0e6b184a2318e76e98e8"
        }
    },
    "extract_dir": "doublecmd",
    "bin": "doublecmd.exe",
    "shortcuts": [
        [
            "doublecmd.exe",
            "Double Commander"
        ]
    ],
    "persist": [
        "settings",
        "plugins"
    ],
    "checkver": {
        "github": "https://github.com/doublecmd/doublecmd",
