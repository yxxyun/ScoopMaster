{
    "version": "0.5.1",
    "description": "Native PC port of Fire Emblem: Fortune's Weave built through static recompilation",
    "homepage": "https://github.com/metrist38/fefw-recomp",
    "license": "GPL-3.0",
    "notes": "Open the launcher and select your own decrypted game dump to complete setup. Run setup again after upgrading.",
    "architecture": {
        "64bit": {
            "url": "https://github.com/metrist38/fefw-recomp/releases/download/v0.5.1/fefw-recomp-0.5.1-win64.zip",
            "hash": "e253130f2a5b95ed12cdbd2c8143c5c24e5bba258aa5ef266ebc22983149f42e"
        }
    },
    "extract_dir": "fefw-recomp-0.5.1",
    "pre_install": [
        "foreach ($file in 'fefw.ini', 'controls.ini') {",
        "    if (Test-Path \"$persist_dir\\$file\") { Copy-Item \"$persist_dir\\$file\" \"$dir\\$file\" -Force }",
        "}"
    ],
    "pre_uninstall": [
        "ensure \"$persist_dir\" | Out-Null",
        "foreach ($file in 'fefw.ini', 'controls.ini') {",
        "    if (Test-Path \"$dir\\$file\") { Copy-Item \"$dir\\$file\" \"$persist_dir\\$file\" -Force }",
        "}"
    ],
    "shortcuts": [
        [
            "fefw-launcher.exe",
            "Fire Emblem - Fortune's Weave"
        ]
    ],
    "persist": [
        "save",
        "mods",
        "upscalers"
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/metrist38/fefw-recomp/releases/download/v$version/fefw-recomp-$version-win64.zip"
            }
        },
        "extract_dir": "fefw-recomp-$version"
    }
}
