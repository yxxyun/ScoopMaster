{
    "version": "202",
    "description": "Floating IPS (or Flips) is a patcher for IPS and BPS files, aiming for a simple interface yet plenty of power under the hood.",
    "homepage": "https://git.disroot.org/Sir_Walrus/Flips",
    "license": "GPL-3.0-only",
    "url": "https://git.disroot.org/Sir_Walrus/Flips/releases/download/v202/flips-windows.zip",
    "hash": "c28fba6fe5c836eda70cea1eef9622f775773ca22943c39a258b35011d0348c1",
    "pre_install": [
        "$batContent = '@echo off', \"`\"%~dp0flips.exe`\" %*\"",
        "Set-Content \"$dir\\flips.cmd\" -Value ($batContent -join \"`r`n\") -Encoding Ascii"
    ],
    "bin": [
        [
            "flips.cmd",
            "flips"
        ]
    ],
    "shortcuts": [
        [
            "flips.exe",
            "Floating IPS"
        ]
    ],
    "checkver": {
        "url": "https://git.disroot.org/api/v1/repos/Sir_Walrus/Flips/releases/latest",
        "jsonpath": "$.tag_name",
        "regex": "v([\\d.]+[a-z]?)"
    },
    "autoupdate": {
        "url": "https://git.disroot.org/Sir_Walrus/Flips/releases/download/v$version/flips-windows.zip"
    }
}
