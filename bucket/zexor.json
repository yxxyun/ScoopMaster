    "pre_install": [
        "$exe = Get-ChildItem -Path $dir -Recurse -File -Filter 'Zexor.exe' | Select-Object -First 1",
        "if (-not $exe) { error 'Zexor.exe was not found in the archive.' }",
        "if ($exe.DirectoryName -ne $dir) { Move-Item -LiteralPath $exe.FullName -Destination (Join-Path $dir 'Zexor.exe') -Force }"
    ],
    "bin": "Zexor.exe",
    "shortcuts": [
        [
            "Zexor.exe",
            "Zexor"
        ]
    ],
