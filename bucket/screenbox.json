{
    "##": "Installs the official sideload MSIX bundle because Screenbox is a UWP app.",
    "version": "0.23.0",
    "description": "LibVLC-based media player for the Universal Windows Platform.",
    "homepage": "https://github.com/huynhsontung/Screenbox",
    "license": "GPL-3.0",
    "architecture": {
        "64bit": {
            "url": "https://github.com/huynhsontung/Screenbox/releases/download/v0.23.0/Screenbox-sideload.zip",
            "hash": "25e8047add15689c751682971b43091ac5ffc2c0f407bbf95376bf1479949d24",
            "extract_dir": "Screenbox_0.23.0.0_Test"
        }
    },
    "post_install": [
        "if ($PSVersionTable.PSVersion.Major -ge 6) { Import-Module Appx -UseWindowsPowerShell 3>$null }",
        "$bundle = Join-Path $dir 'Screenbox_0.23.0.0_x86_x64_arm64.msixbundle'",
        "$dependencies = Get-ChildItem -Path (Join-Path $dir 'Dependencies\\x64') -Filter '*.appx' -File | Select-Object -ExpandProperty FullName",
        "if (!(Test-Path $bundle)) { throw 'Screenbox MSIX bundle was not found.' }",
        "Add-AppxPackage -Path $bundle -DependencyPath $dependencies -AllowUnsigned -ForceApplicationShutdown"
    ],
    "pre_uninstall": [
        "if ($PSVersionTable.PSVersion.Major -ge 6) { Import-Module Appx -UseWindowsPowerShell 3>$null }",
        "Get-AppxPackage -Name '18496Starpine.Screenbox' | Remove-AppxPackage"
    ],
    "checkver": {
        "github": "https://github.com/huynhsontung/Screenbox"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/huynhsontung/Screenbox/releases/download/v$version/Screenbox-sideload.zip",
                "extract_dir": "Screenbox_$version.0_Test"
            }
        }
    }
}
