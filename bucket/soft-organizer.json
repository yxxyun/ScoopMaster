{
    "version": "10.50",
    "description": "Application uninstaller with detection and removal of leftover program traces",
    "homepage": "https://www.chemtable.com/soft-organizer.htm",
    "license": "Proprietary",
    "url": "https://files.chemtable.com/so/soft-organizer-setup.exe",
    "hash": "7F8D7661C83437617D892B6825CD2C8EBE9C3711B67ACC60F76D69E10E71F688",
    "innosetup": true,
    "bin": "SoftOrganizer,1.exe",
    "shortcuts": [
        [
            "SoftOrganizer,1.exe",
            "Soft Organizer"
        ]
    ],
    "checkver": {
        "script": [
            "$html = (Invoke-WebRequest -Uri 'https://www.chemtable.com/soft-organizer.htm' -UseBasicParsing).Content",
            "$text = [System.Net.WebUtility]::HtmlDecode([regex]::Replace($html, '<[^>]+>', ' '))",
            "$text = [regex]::Replace($text, '\\s+', ' ')",
            "$match = [regex]::Match($text, '(?i)\\bSoft Organizer\\s+(?<version>\\d+(?:\\.\\d+){1,3})')",
            "if (-not $match.Success) { throw 'Unable to detect the Soft Organizer version from the official ChemTable product page.' }",
            "$match.Groups['version'].Value"
        ],
        "regex": "(?<version>\\d+(?:\\.\\d+){1,3})"
    },
    "autoupdate": {
        "url": "https://files.chemtable.com/so/soft-organizer-setup.exe"
    },
    "notes": "Scoop extracts the official Inno Setup payload into the app directory instead of executing the installer; installer-registered shell integration or machine-wide components are not installed."
}
