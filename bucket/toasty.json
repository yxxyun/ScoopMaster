{
    "version": "0.8.1",
    "description": "Tiny Windows toast notification CLI (229 KB)",
    "homepage": "https://github.com/shanselman/toasty",
    "license": "Freeware",
    "architecture": {
        "64bit": {
            "url": "https://github.com/shanselman/toasty/releases/download/v0.8.1/toasty-x64.exe#/toasty.exe",
            "hash": "1c6c7a2415cd92a1148cf9e08fd2e85fa48eab5752ce3d7e0fdc1f8ea1fa2da2"
        },
        "arm64": {
            "url": "https://github.com/shanselman/toasty/releases/download/v0.8.1/toasty-arm64.exe#/toasty.exe",
            "hash": "d5f6adc98d238928e958659c29c7d2b77f2b750033666a5db3d28acd85fa525f"
        }
    },
    "bin": "toasty.exe",
    "checkver": {
        "url": "https://api.github.com/repos/shanselman/toasty/releases",
        "script": [
            "$releases = @($page | ConvertFrom-Json)",
            "$release = $releases | Where-Object { -not $_.draft -and -not $_.prerelease -and ($_.assets.name -contains 'toasty-x64.exe') -and ($_.assets.name -contains 'toasty-arm64.exe') } | Select-Object -First 1",
            "$release.tag_name"
        ],
        "regex": "v?([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/shanselman/toasty/releases/download/v$version/toasty-x64.exe#/toasty.exe"
            },
            "arm64": {
                "url": "https://github.com/shanselman/toasty/releases/download/v$version/toasty-arm64.exe#/toasty.exe"
            }
        }
    }
}
