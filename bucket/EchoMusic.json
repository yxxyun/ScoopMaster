{
  "version": "2.2.8",
  "description": "一个简约的第三方酷狗音乐概念版",
  "homepage": "https://github.com/hoowhoami/EchoMusic",
  "license": "MIT",
  "architecture": {
    "64bit": {
      "url": "https://github.com/hoowhoami/EchoMusic/releases/download/v2.2.8/EchoMusic-2.2.8-Windows-Setup-x64.exe",
      "hash": "7a182e007f7d24bce1eb18297d2104bbd720cf386cb8d87f0bf67a16606138cb"
    }
  },
  "installer": {
    "script": [
      "7z x \"$dir\\$fname\" '$PLUGINSDIR\\app-64.7z' -o\"$dir\" -aoa",
      "if (!(Test-Path \"$dir\\`$PLUGINSDIR\\app-64.7z\")) { throw \"提取 app-64.7z 失败\" }",
      "Remove-Item \"$dir\\$fname\" -Force -ErrorAction Ignore",
      "7z x \"$dir\\`$PLUGINSDIR\\app-64.7z\" -o\"$dir\\app\" -aoa",
      "if (!(Test-Path \"$dir\\app\\EchoMusic.exe\")) { throw \"未找到 EchoMusic.exe\" }",
      "Remove-Item \"$dir\\`$PLUGINSDIR\",\"$dir\\`$R0\" -Recurse -Force -ErrorAction Ignore"
    ]
  },
  "post_install": [
    "foreach ($pair in @(@('echo-music', \"$env:APPDATA\\echo-music\"), @('echo-music-nodejs', \"$env:APPDATA\\echo-music-nodejs\"))) {",
    "    $src = \"$persist_dir\\$($pair[0])\"",
    "    $tgt = $pair[1]",
    "    if (!(Test-Path $src)) { New-Item -ItemType Directory $src -Force | Out-Null }",
    "    if (Test-Path $tgt) {",
    "        if ((Get-Item $tgt).LinkType -ne 'Junction') { Get-ChildItem $tgt | Move-Item -Destination $src -Force; Remove-Item $tgt -Force } else { Remove-Item $tgt -Force -Recurse }",
    "    }",
    "    New-Item -ItemType Junction -Path $tgt -Target $src -Force | Out-Null",
    "    if ((Get-Item $tgt).LinkType -ne 'Junction') { throw \"创建 junction 失败\" }",
    "}"
  ],
  "pre_uninstall": [
    "Stop-Process -Name 'EchoMusic' -Force -ErrorAction Ignore",
    "foreach ($tgt in @(\"$env:APPDATA\\echo-music\", \"$env:APPDATA\\echo-music-nodejs\")) {",
    "    if ((Test-Path $tgt) -and ((Get-Item $tgt).LinkType -eq 'Junction')) { Remove-Item $tgt -Force -Recurse }",
    "}",
    "Remove-Item \"$env:LOCALAPPDATA\\echo-music-updater\" -Recurse -Force -ErrorAction Ignore"
  ],
  "shortcuts": [
    [
      "app\\EchoMusic.exe",
      "EchoMusic"
    ]
  ],
  "persist": [
    "echo-music",
    "echo-music-nodejs"
  ],
  "checkver": "github",
  "autoupdate": {
    "architecture": {
      "64bit": {
        "url": "https://github.com/hoowhoami/EchoMusic/releases/download/v$version/EchoMusic-$version-Windows-Setup-x64.exe"
      }
    },
    "hash": {
      "mode": "github"
    }
  }
}
