{
    "version": "2.3.1",
    "description": "一个简约的第三方酷狗音乐概念版",
    "homepage": "https://github.com/hoowhoami/EchoMusic",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/hoowhoami/EchoMusic/releases/download/v2.3.1/EchoMusic-2.3.1-Windows-Setup-x64.exe",
            "hash": "75e9bcbed2b34fe8f5a37f18fff5e05551d4033ac102396c786cc86a04fdfe63"
        }
    },
    "installer": {
        "script": [
            "7z x \"$dir\\$fname\" '$PLUGINSDIR\\app-64.7z' -o\"$dir\" -aoa",
            "if (!(Test-Path \"$dir\\`$PLUGINSDIR\\app-64.7z\")) { throw \"提取 app-64.7z 失败\" }",
            "Remove-Item \"$dir\\$fname\" -Force -ErrorAction Ignore",
            "7z x \"$dir\\`$PLUGINSDIR\\app-64.7z\" -o\"$dir\\app\" -aoa",
            "if (!(Test-Path \"$dir\\app\\EchoMusic.exe\")) { throw \"未找到 EchoMusic.exe\" }",
            "Remove-Item \"$dir\\`$PLUGINSDIR\",\"$dir\\`$R0\" -Recurse -Force -ErrorAction Ignore"
        ]
    },
    "post_install": [
        "if (!(Test-Path \"$persist_dir\\echo-music\")) { New-Item -ItemType Directory \"$persist_dir\\echo-music\" -Force | Out-Null }",
        "if (Test-Path \"$env:APPDATA\\echo-music\") {",
        "    if ((Get-Item \"$env:APPDATA\\echo-music\").LinkType -ne 'Junction') { Get-ChildItem \"$env:APPDATA\\echo-music\" | Move-Item -Destination \"$persist_dir\\echo-music\" -Force; Remove-Item \"$env:APPDATA\\echo-music\" -Force } else { Remove-Item \"$env:APPDATA\\echo-music\" -Force -Recurse }",
        "}",
        "New-Item -ItemType Junction -Path \"$env:APPDATA\\echo-music\" -Target \"$persist_dir\\echo-music\" -Force | Out-Null",
        "if ((Get-Item \"$env:APPDATA\\echo-music\").LinkType -ne 'Junction') { throw \"创建 junction 失败\" }",
        "Remove-Item -Path \"$dir\\app\\resources\\app-update.yml\" -Force -ErrorAction SilentlyContinue"
    ],
    "pre_uninstall": [
        "Stop-Process -Name 'EchoMusic' -Force -ErrorAction Ignore",
        "if ((Test-Path \"$env:APPDATA\\echo-music\") -and ((Get-Item \"$env:APPDATA\\echo-music\").LinkType -eq 'Junction')) { Remove-Item \"$env:APPDATA\\echo-music\" -Force -Recurse }",
        "Remove-Item \"$env:LOCALAPPDATA\\echo-music-updater\" -Recurse -Force -ErrorAction Ignore"
    ],
    "shortcuts": [
        [
            "app\\EchoMusic.exe",
            "EchoMusic"
        ]
    ],
    "persist": "echo-music",
    "checkver": {
        "github": "https://github.com/hoowhoami/EchoMusic"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/hoowhoami/EchoMusic/releases/download/v$version/EchoMusic-$version-Windows-Setup-x64.exe"
            }
        }
    }
}
