{
    "version": "1.0.0-rc.10",
    "description": "A modern cross-platform IRC client with IRCv3 support",
    "homepage": "https://github.com/koshian/cayenchat",
    "license": "GPL-3.0-only",
    "notes": "settings file will be stored in AppData\\Roaming\\CayenChat\\",
    "url": "https://github.com/koshian/cayenchat/releases/download/v1.0.0-rc.10/cayenchat-1.0.0-rc.10-windows-x86_64.zip",
    "hash": "2d004b5e7f20772f2641907ac18bf1b778b0e17456dca8aef9968b288f23a4b7",
    "bin": [
        [
            "cayenchat.exe",
            "cayenchat-latest"
        ]
    ],
    "shortcuts": [
        [
            "cayenchat.exe",
            "CayenChat Latest"
        ]
    ],
    "checkver": {
        "github": "https://api.github.com/repos/koshian/cayenchat/releases",
        "script": [
            "$releases = $page | ConvertFrom-Json",
            "$release = $releases | Where-Object { $_.prerelease -and -not $_.draft } | Sort-Object { [DateTimeOffset]::Parse($_.published_at) } -Descending | Select-Object -First 1",
            "if ($null -eq $release) { throw 'No published prerelease found.' }",
            "$version = $release.tag_name -replace '^[vV]', ''",
            "Write-Output \"$($release.tag_name)|$version\""
        ],
        "regex": "(?<tag>[^|]+)\\|(?<version>[^|]+)"
    },
    "autoupdate": {
        "url": "https://github.com/koshian/cayenchat/releases/download/$matchTag/cayenchat-$version-windows-x86_64.zip"
    }
}
