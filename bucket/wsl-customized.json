{
    "##": "https://learn.microsoft.com/zh-cn/windows/wsl/install-manual",
    "version": "3.0.5",
    "description": "启用并安装 github .msi 版 wsl",
    "homepage": "https://github.com/microsoft/WSL",
    "license": "Freeware",
    "url": [
        "https://github.com/microsoft/WSL/releases/download/3.0.5/wsl.3.0.5.0.x64.msi#/wsl.msi_"
    ],
    "hash": [
        "2313efc5873e3f8552f42e77f950fabd913c0289078fa89d2100f3421a525eaa"
    ],
    "depends": ["ChuckieChen945_Chuckie_s/v2rayn-customized", "main/gsudo"],
    "pre_install": [
        "# Enable WSL 2 and Virtual Machine Platform features",
        "gsudo Enable-WindowsOptionalFeature -FeatureName 'Microsoft-Windows-Subsystem-Linux, VirtualMachinePlatform, Microsoft-Hyper-V-Management-PowerShell' -All -Online -NoRestart -LimitAccess",
        "# wsb",
        "if($env:USERNAME -ne 'WDAGUtilityAccount') {",
        "    gsudo Enable-WindowsOptionalFeature -FeatureName 'Containers-DisposableClientVM' -All -Online -NoRestart -LimitAccess",
        "}"
    ],
    "installer": {
        "script": [
            "Invoke-ExternalCommand 'msiexec' -ArgumentList @('/i', \"$dir\\wsl.msi_\", '/passive', '/norestart')"
        ]
    },
    "post_install": [
        "Get-ChildItem -Path $dir -Recurse | Remove-Item -Force -ErrorAction SilentlyContinue -Recurse",
        "# Set network",
        "Set-NetFirewallHyperVVMSetting -Name '{40E0AC32-46A5-438A-A0B2-2B479E8F2E90}' -DefaultInboundAction Allow",
        "Set-NetFirewallHyperVVMSetting -Name '{40E0AC32-46A5-438A-A0B2-2B479E8F2E90}' -Enabled False",
        "# 为 WSL 应用启用“回环网络访问”权限, 适配 tun 模式",
        "# TODO: 看有什么不依赖 EnableLoopback 这个程序的方式",
        "EnableLoopback -all"
    ],
    "checkver": "github",
    "autoupdate": {
        "url": [
            "https://github.com/microsoft/WSL/releases/download/$version/wsl.$version.0.x64.msi#/wsl.msi_"
        ]
    }
}
