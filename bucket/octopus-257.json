{
    "$schema": "https://raw.githubusercontent.com/ScoopInstaller/Scoop/master/schema.json",
    "version": "0.13.4-post.1",
    "description": "One Hub All LLMs For You | 为个人打造的 LLM API 聚合网关",
    "homepage": "https://github.com/gdm257/octopus",
    "license": "AGPL-3.0-or-later",
    "architecture": {
        "64bit": {
            "url": "https://github.com/gdm257/octopus/releases/download/v0.13.4-post.1/octopus-windows-amd64.zip",
            "hash": "77d4c30d1a9051b256efc00a258c1279da5de6cc266395b0ac809281a8707c99"
        }
    },
    "installer": {
        "script": "Copy-Item -Path (Join-Path $bucketsdir $bucket 'scripts\\command-wrapper\\command-wrapper.cmd') -Destination (Join-Path $dir 'command-wrapper.cmd') -Force"
    },
    "bin": [
        [
            "command-wrapper.cmd",
            "octopus",
            "--workdir . octopus.exe"
        ]
    ],
    "persist": "data",
    "checkver": {
        "github": "https://github.com/gdm257/octopus",
        "regex": "releases/tag/v([\\w.-]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/gdm257/octopus/releases/download/v$version/octopus-windows-amd64.zip"
            }
        }
    }
}
