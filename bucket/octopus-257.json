{
    "$schema": "https://raw.githubusercontent.com/ScoopInstaller/Scoop/master/schema.json",
    "version": "0.13.2-post.1",
    "description": "One Hub All LLMs For You | 为个人打造的 LLM API 聚合网关",
    "homepage": "https://github.com/gdm257/octopus",
    "license": "AGPL-3.0-or-later",
    "architecture": {
        "64bit": {
            "url": "https://github.com/gdm257/octopus/releases/download/v0.13.2-post.1/octopus-windows-amd64.zip",
            "hash": "sha256:49d4ea0a60ac3fe00a0f13ecc6d92dfd584602d6b8aa5509f4f4986ddcea1567"
        }
    },
    "installer": {
        "script": "Copy-Item -Path (Join-Path $bucketsdir $bucket 'scripts\\command-wrapper\\command-wrapper.cmd') -Destination (Join-Path $dir 'command-wrapper.cmd') -Force"
    },
    "bin": [
        [
            "command-wrapper.cmd",
            "octopus",
            "octopus.exe --workdir ."
        ]
    ],
    "persist": "data",
    "checkver": {
        "github": "https://github.com/gdm257/octopus",
        "regex": "releases/tag/v([\\w.-]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/bestruirui/octopus/releases/download/v$version/octopus-windows-amd64.zip"
            }
        }
    }
}
