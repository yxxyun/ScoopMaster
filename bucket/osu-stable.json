{
    "version": "1.3.3.8",
    "description": "A free-to-win rhythm game. Rhythm is just a click away! (stable client)",
    "homepage": "https://osu.ppy.sh/",
    "license": {
        "identifier": "Freeware",
        "url": "https://osu.ppy.sh/legal/terms"
    },
    "notes": "Run osu! after installation to download the latest stable client files.",
    "url": "https://m1.ppy.sh/r/osu!install.exe#/osu!.exe",
    "hash": "6e182c10d1813209d12753dbc70b3a5bba00fef4ecf64bc42051870e6dfe4b7d",
    "bin": "osu!.exe",
    "shortcuts": [
        [
            "osu!.exe",
            "osu!stable"
        ]
    ],
    "persist": [
        "Data",
        "Replays",
        "Screenshots",
        "Skins",
        "Songs"
    ],
    "checkver": {
        "script": [
            "$dl_url = 'https://m1.ppy.sh/r/osu!install.exe#/osu!.exe'",
            "$dl = cache_path 'osu-stable' '32bit' $dl_url",
            "Invoke-WebRequest $dl_url -OutFile $dl",
            "$ver = (Get-Item $dl).VersionInfo.ProductVersion",
            "Move-Item -Force $dl (cache_path 'osu-stable' $ver $dl_url)",
            "$ver"
        ],
        "regex": "(\\S+)"
    },
    "autoupdate": {
        "url": "https://m1.ppy.sh/r/osu!install.exe#/osu!.exe"
    }
}
