{
    "version": "1.8.5",
    "description": "Windows Dynamic Island overlay with media controls, notifications, downloads, prayer times, and desktop widgets.",
    "homepage": "https://github.com/NOVA-TECH-KIT/nova-island",
    "license": {
        "identifier": "GPL-3.0-only",
        "url": "https://github.com/NOVA-TECH-KIT/nova-island/blob/main/LICENSE"
    },
    "url": "https://github.com/NOVA-TECH-KIT/nova-island/releases/download/v1.8.5/Nova-Island-Setup-1.8.5.exe#/dl.7z",
    "hash": "1aef999916396b980ba0c17781a4d3f4c28dc47a4ccbe47f86b599b857929fd6",
    "pre_install": [
        "if (!(Test-Path \"$dir\\Nova Island.exe\" -PathType Leaf)) { throw 'Nova Island.exe was not extracted into the Scoop version directory.' }",
        "Remove-Item \"$dir\\`$*\", \"$dir\\Uninstall*\" -Force -Recurse -ErrorAction SilentlyContinue"
    ],
    "post_install": [
        "$settingsDir = Join-Path $env:APPDATA 'dynamic-nova'",
        "New-Item -ItemType Directory -Path $settingsDir -Force | Out-Null",
        "$featuresPath = Join-Path $settingsDir 'features.json'",
        "$features = [ordered]@{}",
        "if (Test-Path -LiteralPath $featuresPath -PathType Leaf) {",
        "    $existing = Get-Content -LiteralPath $featuresPath -Raw | ConvertFrom-Json -ErrorAction Stop",
        "    if ($null -ne $existing) { foreach ($property in $existing.PSObject.Properties) { $features[$property.Name] = $property.Value } }",
        "}",
        "$features['autoUpdate'] = $false",
        "[System.IO.File]::WriteAllText($featuresPath, ($features | ConvertTo-Json -Depth 100), [System.Text.UTF8Encoding]::new($false))"
    ],
    "bin": [
        [
            "Nova Island.exe",
            "nova-island"
        ]
    ],
    "shortcuts": [
        [
            "Nova Island.exe",
            "Nova Island"
        ]
    ],
    "checkver": {
        "github": "https://github.com/NOVA-TECH-KIT/nova-island",
        "regex": "v(?<version>[\\d.]+)"
    },
    "autoupdate": {
        "url": "https://github.com/NOVA-TECH-KIT/nova-island/releases/download/v$version/Nova-Island-Setup-$version.exe#/dl.7z",
        "hash": {
            "url": "https://api.github.com/repos/NOVA-TECH-KIT/nova-island/releases/tags/v$version",
            "jsonpath": "$.assets[?(@.name == 'Nova-Island-Setup-$version.exe')].digest"
        }
    }
}
