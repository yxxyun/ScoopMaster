{
    "version": "1.3.26",
    "description": "Portable console emulator for Windows. (Mini version)",
    "homepage": "https://cmder.app",
    "license": "MIT",
    "url": "https://github.com/cmderdev/cmder/releases/download/v1.3.26/cmder_mini.zip",
    "hash": "cfb3accdf0f90d4e56a51f6b82eeaf96b6c9f8f7cd9f58e5c996ff1f515d19c6",
    "pre_install": [
        "if (!(Test-Path \"$persist_dir\\vendor\\conemu-maximus5\\ConEmu.xml\")) {",
        "    Copy-Item \"$dir\\vendor\\ConEmu.xml.default\" \"$dir\\vendor\\conemu-maximus5\\ConEmu.xml\"",
        "}"
    ],
    "post_install": [
        "'Cmder.exe', 'vendor\\conemu-maximus5' | % {",
        "   Remove-Item \"$dir\\$_\" -Recurse",
        "}"
    ],
    "persist": [
        "bin",
        "config",
        "opt"
    ],
    "env_set": {
        "CMDER_ROOT": "$dir"
    },
    "checkver": {
        "github": "https://github.com/cmderdev/cmder"
    },
    "autoupdate": {
        "url": "https://github.com/cmderdev/cmder/releases/download/v$version/cmder_mini.zip",
        "hash": {
            "url": "$baseurl/hashes.txt",
            "regex": "$basename\\s+$sha256"
        }
    }
}
