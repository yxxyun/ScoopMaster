{
    "##": "Why here? Testing.",
    "version": "1.8.0",
    "description": "Fast, private, local-first notes.",
    "homepage": "https://notes.futo.tech",
    "license": {
        "identifier": "Proprietary",
        "url": "https://gitlab.futo.org/futo-notes/futo-notes/-/blob/main/LICENSE.md"
    },
    "architecture": {
        "64bit": {
            "url": "https://gitlab.futo.org/api/v4/projects/488/packages/generic/futo-notes/v1.8.0/FUTO-Notes-1.8.0-x64-setup.exe#dl.zip",
            "hash": "9f20fd3ec795fe98bb41ca39c72787652e025164b7d6748522707fce1e2a955b"
        }
    },
    "post_install": [
        "Get-ChildItem -Path \"$dir\" | ",
        "Where-Object -Property 'Name' -NE 'futo-notes-tauri.exe' | ",
        "Remove-Item -Force -Recurse"
    ],
    "bin": [
        [
            "futo-notes-tauri.exe",
            "futo-notes"
        ]
    ],
    "shortcuts": [
        [
            "futo-notes-tauri.exe",
            "FUTO Notes"
        ]
    ],
    "post_uninstall": [
        "# Inform of leftover directories if any was found",
        "$LeftoverDirs = [string[]](",
        "    ('{0}\\com.futo.notes' -f $env:APPDATA),",
        "    ('{0}\\com.futo.notes' -f $env:LOCALAPPDATA) | Where-Object -FilterScript {",
        "        [System.IO.Directory]::Exists($_)",
        "    }",
        ")",
        "if ($LeftoverDirs.Count -gt 0) {",
        "    $Message = [string] \"`r`nFound some leftover directories you might want to delete:\"",
        "    $LeftoverDirs.ForEach{",
        "        $Message += \"`r`n* '{0}'\" -f $_",
        "    }",
        "    info $Message",
        "}"
    ],
    "checkver": {
        "url": "https://notes.futo.tech/rss.xml",
        "regex": "<title>FUTO Notes (?<version>[\\d.]+)</title>"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://gitlab.futo.org/api/v4/projects/488/packages/generic/futo-notes/v$version/FUTO-Notes-$version-x64-setup.exe#dl.zip"
            }
        }
    }
}
