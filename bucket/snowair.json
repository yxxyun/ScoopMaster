{
    "version": "0.1.26",
    "description": "Lightweight Windows screenshot and annotation tool with long screenshots, screen recording, OCR and pinning",
    "homepage": "https://github.com/CM-idea/SnowAir",
    "license": "Apache-2.0",
    "notes": [
        "Lite 版为单文件程序；配置与数据保存在 %APPDATA%\\SnowAir（config.json、local.json、Lang、plugin），升级不会丢失，卸载后仍保留。",
        "程序默认开启开机自启，会写入 HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Run 或计划任务 SnowAir；卸载时本清单会清理这些自启项。"
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/CM-idea/SnowAir/releases/download/v0.1.26-lite/SnowAir-Lite.exe#/SnowAir.exe",
            "hash": "bbda0d83fa25f54ddcb5e12a6b0522548ed88e3ac56098cd203cad6ebb91dabf"
        }
    },
    "bin": "SnowAir.exe",
    "shortcuts": [
        [
            "SnowAir.exe",
            "SnowAir"
        ]
    ],
    "pre_uninstall": [
        "# 程序默认驻留托盘，进程在跑会导致版本目录删不掉；升级与卸载前都先结束它",
        "Get-Process -Name 'SnowAir' -ErrorAction SilentlyContinue | Stop-Process -Force -ErrorAction SilentlyContinue",
        "Start-Sleep -Milliseconds 500"
    ],
    "post_uninstall": [
        "# scoop update 也会执行 post_uninstall（此时 $old_version 有值），只在真正卸载时清理自启项",
        "if (-not $old_version) {",
        "    Remove-ItemProperty -Path 'HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Run' -Name 'SnowAir' -ErrorAction SilentlyContinue",
        "    Remove-ItemProperty -Path 'HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\StartupApproved\\Run' -Name 'SnowAir' -ErrorAction SilentlyContinue",
        "    if (Get-Command Get-ScheduledTask -ErrorAction SilentlyContinue) {",
        "        Get-ScheduledTask -TaskName 'SnowAir' -ErrorAction SilentlyContinue | Unregister-ScheduledTask -Confirm:$false -ErrorAction SilentlyContinue",
        "    }",
        "}"
    ],
    "checkver": {
        "url": "https://github.com/CM-idea/SnowAir/releases.atom",
        "regex": "Repository/\\d+/v([\\d.]+)-lite<"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/CM-idea/SnowAir/releases/download/v$version-lite/SnowAir-Lite.exe#/SnowAir.exe"
            }
        }
    }
}
