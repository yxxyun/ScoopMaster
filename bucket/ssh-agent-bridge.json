{
	"version": "1.1",
	"description": "Bridge from/to any of pageant, Git, Windows OpenSSH, WSL, Cygwin/MSYS2 ssh-agent protocols.",
	"homepage": "https://github.com/amurzeau/ssh-agent-bridge",
	"license": "GPL-3.0-only",
	"url": [
	    "https://github.com/amurzeau/ssh-agent-bridge/releases/download/v1.1/ssh-agent-bridge-noconsole.exe",
		"https://github.com/amurzeau/ssh-agent-bridge/releases/download/v1.1/ssh-agent-bridge.exe"
	],
	"hash": [
	    "54394689e8ba37a6a791a3b68ce630b4989aed585533127e8f9cbd1cff51cf58",
		"599073103ee799c36ed27876ff652cd117819bd93a6b9e2608f4daa8a9435460"
	],
	"bin": ["ssh-agent-bridge.exe"],
	"shortcuts": [
		[
			"ssh-agent-bridge-noconsole.exe",
			"SSH Agent Bridge",
			"-from cygwin,pageant,pageant-pipe -cygwin-socket \"%LOCALAPPDATA%/ssh-agent-bridge-cw.sock\" -to pipe"
		]
	],
	"post_install": [
		"$programsPath = \"$env:AppData\\Microsoft\\Windows\\Start Menu\\Programs\"",
		"$startupPath = \"$programsPath\\Startup\\SSH Agent Bridge.lnk\"",
		"$appsPath = \"$programsPath\\Scoop Apps\\SSH Agent Bridge.lnk\"",
		"if (Test-Path $appsPath) {",
		"    Move-Item -Path $appsPath -Destination $startupPath -Force",
		"    $shell = New-Object -ComObject WScript.Shell",
		"    $shortcut = $shell.CreateShortcut($startupPath)",
		"    $shortcut.IconLocation = \"$env:SystemRoot\\System32\\SHELL32.dll,314\"",
		"    $shortcut.Save()",
		"    $shell.Run(\"`\"$startupPath`\"\")",
		"}"
	],
	"pre_uninstall": "taskkill /f /im ssh-agent-bridge-noconsole.exe >nul 2>&1",
	"uninstaller": {
		"script": [
		    "$programsPath = \"$env:AppData\\Microsoft\\Windows\\Start Menu\\Programs\"",
			"$startupPath = \"$programsPath\\Startup\\SSH Agent Bridge.lnk\"",
			"if (Test-Path $startupPath) {",
			"    Remove-Item -Path $startupPath -Force",
			"}"
		]
	}
}
