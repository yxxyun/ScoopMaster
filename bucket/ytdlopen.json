{
    "version": "1.0.0",
    "description": "Open YTDownloader and copy a URL to the clipboard without pasting it.",
    "homepage": "https://github.com/huxiaoning/scoop_bucket",
    "license": "MIT",
    "depends": [
        "ytdownloader",
        "native-client"
    ],
    "architecture": {
        "64bit": {
            "url": "https://raw.githubusercontent.com/ScoopInstaller/Main/master/.gitattributes",
            "hash": "ff0c272f0fe28fdaa027733c9f7b25ce913a2cca24d2268f6bf7ae7cbd229114"
        }
    },
    "installer": {
        "script": [
            "Remove-Item -LiteralPath \"$dir\\.gitattributes\" -Force -ErrorAction SilentlyContinue",
            "$source = Join-Path $bucketsdir 'huxiaoning_scoop_bucket\\bucket\\ytdlopen.ps1'",
            "if (-not (Test-Path -LiteralPath $source)) { error \"ytdlopen.ps1 was not found at $source\"; exit 1 }",
            "Copy-Item -LiteralPath $source -Destination \"$dir\\ytdlopen.ps1\" -Force"
        ]
    },
    "bin": "ytdlopen.ps1",
    "notes": [
        "Recommended setup:",
        "  1. scoop install ytdownloader native-client ytdlopen",
        "  2. Install External Application Button:",
        "     Chrome / Edge: https://chromewebstore.google.com/detail/external-application-butt/bifmfjgpgndemajpeeoiopbeilbaifdo",
        "     Firefox: https://addons.mozilla.org/firefox/addon/external-application/",
        "     Edge can also install the Chrome extension from the Chrome Web Store.",
        "  3. In the extension, add this command:",
        "     wt pwsh -NoExit -Command \"ytdlopen '[HREF]'\"",
        "",
        "native-client is the local host that lets the extension run that command. ytdlopen copies the URL first, then starts ytdownloader when it is not running and activates the ytDownloader window. It does not send Ctrl+V; paste it yourself if you want to download."
    ]
}
