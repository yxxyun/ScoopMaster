{
    "version": "9.96",
    "description": "Windows maintenance, registry cleanup, and optimization utility",
    "homepage": "https://www.chemtable.com/organizer.htm",
    "license": "Proprietary",
    "url": "https://files.chemtable.com/ro/reg-organizer-setup.exe",
    "hash": "8360A00453B0360AE7B07D68E28B61953B96623798D9DE9305E7A86D0D5724B7",
    "innosetup": true,
    "bin": "RegOrganizer,1.exe",
    "shortcuts": [
        [
            "RegOrganizer,1.exe",
            "Reg Organizer"
        ]
    ],
    "checkver": {
        "script": [
            "$html = (Invoke-WebRequest -Uri 'https://www.chemtable.com/organizer.htm' -UseBasicParsing).Content",
            "$text = [System.Net.WebUtility]::HtmlDecode([regex]::Replace($html, '<[^>]+>', ' '))",
            "$text = [regex]::Replace($text, '\\s+', ' ')",
            "$match = [regex]::Match($text, '(?i)\\bReg Organizer\\s+(?<version>\\d+(?:\\.\\d+){1,3})')",
            "if (-not $match.Success) { throw 'Unable to detect the Reg Organizer version from the official ChemTable product page.' }",
            "$match.Groups['version'].Value"
        ],
        "regex": "(?<version>\\d+(?:\\.\\d+){1,3})"
    },
    "autoupdate": {
        "url": "https://files.chemtable.com/ro/reg-organizer-setup.exe"
    },
    "notes": "Scoop extracts the official Inno Setup payload into the app directory instead of executing the installer; installer-registered shell integration or machine-wide components are not installed."
}
