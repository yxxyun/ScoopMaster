    "hash": "sha512:cc78a23d4b79a50feaac396afe796c4af43f012aa8c45b05a2dde4b52fdeb3d663586ae9500fb68278e85cc59dd08cbefe0d5d983a6395f871d87a7ed2093277",
    "architecture": {
