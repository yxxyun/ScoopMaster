    "url": "https://github.com/keeps/dbptk-desktop/releases/download/v4.3.1/dbptk-desktop-4.3.1.exe#/dl.7z",
    "hash": "sha512:8e2c80cec9b7209db697a2d90df0a0fcb439a8191c30a402e1a628d2f40c6e1b79012984010ebc3a6c4fd94d7d72456e946a81ab061bfba16d28e7e2f4cb3c5e",
    "architecture": {
