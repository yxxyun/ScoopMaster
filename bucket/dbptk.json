    },
    "autoupdate": {
        "url": "https://github.com/keeps/dbptk-desktop/releases/download/v$version/dbptk-desktop-$version.exe#/dl.7z",
        "hash": {
            "url": "$baseurl/latest.yml",
            "regex": "sha512:\\s+$base64"
        }
    }
