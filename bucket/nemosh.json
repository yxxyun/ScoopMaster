{
    "version": "1.7.0",
    "description": "A native Windows-first, BusyBox-style POSIX shell and utility bundle. One binary, no runtime dependencies.",
    "homepage": "https://github.com/xiongnemo/nemosh",
    "license": "Apache-2.0",
    "notes": [
        "nemosh is a multicall binary: only the nemosh shim is installed, because two of its applets would shadow Windows commands of the same name and different meaning -- find.exe takes a literal string and a file, and sort.exe is not POSIX sort.",
        "Run 'nemosh --list' to see the bundled applets, and 'nemosh --help' for the command line.",
        "To use an applet directly, add a shim yourself, for example: scoop shim add cat \"$(scoop prefix nemosh)\\nemosh.exe\" cat"
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/xiongnemo/nemosh/releases/download/v1.7.0/nemosh-v1.7.0-windows-amd64.zip",
            "hash": "8cf08666a9d969ee6457e08f0298940725c4ec34149d6678056ead37c48abd15",
            "extract_dir": "nemosh-v1.7.0-windows-amd64"
        },
        "32bit": {
            "url": "https://github.com/xiongnemo/nemosh/releases/download/v1.7.0/nemosh-v1.7.0-windows-386.zip",
            "hash": "71afbbaaabd45ba6f9db94a5fc017fda46ceca44b411648a205f2bb3a2a921f4",
            "extract_dir": "nemosh-v1.7.0-windows-386"
        },
        "arm64": {
            "url": "https://github.com/xiongnemo/nemosh/releases/download/v1.7.0/nemosh-v1.7.0-windows-arm64.zip",
            "hash": "71ff75ff7865186b8dfd6f0102b7fa14bf615d68fa906d10ad1aa607b525008d",
            "extract_dir": "nemosh-v1.7.0-windows-arm64"
        }
    },
    "bin": "nemosh.exe",
    "checkver": {
        "script": [
            "$headers = @{ Accept = 'application/vnd.github+json' }",
            "if ($token = Get-GitHubToken) { $headers.Authorization = \"token $token\" }",
            "(Invoke-WebRequest -UseBasicParsing -Headers $headers -Uri 'https://api.github.com/repos/xiongnemo/nemosh/releases/latest').Content"
        ],
        "regex": "\"tag_name\":\\s*\"v(?<version>[\\d.]+)\""
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/xiongnemo/nemosh/releases/download/v$version/nemosh-v$version-windows-amd64.zip",
                "extract_dir": "nemosh-v$version-windows-amd64"
            },
            "32bit": {
                "url": "https://github.com/xiongnemo/nemosh/releases/download/v$version/nemosh-v$version-windows-386.zip",
                "extract_dir": "nemosh-v$version-windows-386"
            },
            "arm64": {
                "url": "https://github.com/xiongnemo/nemosh/releases/download/v$version/nemosh-v$version-windows-arm64.zip",
                "extract_dir": "nemosh-v$version-windows-arm64"
            }
        }
    }
}
