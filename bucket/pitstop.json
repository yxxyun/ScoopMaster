{
    "version": "1.4.0",
    "description": "Native Windows manager for setting up, updating and configuring portable Chrome with Chrome++ Next.",
    "homepage": "https://github.com/Bush2021/pitstop",
    "license": "GPL-3.0",
    "architecture": {
        "64bit": {
            "url": "https://github.com/Bush2021/pitstop/releases/download/v1.4.0/pitstop-1.4.0-windows-amd64.tar.gz",
            "hash": "32a5e00a719545f536c3c4338bb87c94eeee62b7ef76752aec6543cf4b797024"
        },
        "arm64": {
            "url": "https://github.com/Bush2021/pitstop/releases/download/v1.4.0/pitstop-1.4.0-windows-arm64.tar.gz",
            "hash": "1e06beab8416519360ef9abc3060c839a2fd5b7e05a5a9fd8258baffc5a33603"
        }
    },
    "bin": "pitstop.exe",
    "shortcuts": [
        [
            "pitstop.exe",
            "Pitstop"
        ]
    ],
    "persist": [
        "App",
        "Data",
        "Cache",
        ".pitstop"
    ],
    "checkver": {
        "github": "https://github.com/Bush2021/pitstop"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/Bush2021/pitstop/releases/download/v$version/pitstop-$version-windows-amd64.tar.gz"
            },
            "arm64": {
                "url": "https://github.com/Bush2021/pitstop/releases/download/v$version/pitstop-$version-windows-arm64.tar.gz"
            }
        }
    },
    "notes": "Pitstop expects pitstop.exe beside App, Data and Cache. These folders and .pitstop are persisted across Scoop updates to retain Chrome, profile and Pitstop state. It manages portable Chrome and Chrome++ Next; review the selected installation root before removing the manifest."
}
