            "hash": "0f4e412c28039aff0b8f0ec3fe449e5cd3ede44829b99bd0e316f2ab7d0e2c4b"
        },
        "arm64": {
            "url": "https://github.com/Bush2021/pitstop/releases/download/v1.3.1/pitstop-1.3.1-windows-arm64.tar.gz",
            "hash": "762a363970074498b2098de9383d216e00e7c4a2cab607b0df1adcf9b8fdc71e"
        }
    },
    "bin": "pitstop.exe",
    "shortcuts": [
        [
            "pitstop.exe",
            "Pitstop"
        ]
    ],
    "persist": [
        "App",
        "Data",
        "Cache",
        ".pitstop"
    ],
    "checkver": {
        "github": "https://github.com/Bush2021/pitstop"
    },
    "autoupdate": {
