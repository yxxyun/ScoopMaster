                "url": "https://github.com/Bush2021/pitstop/releases/download/v$version/pitstop-$version-windows-amd64.tar.gz"
            },
            "arm64": {
                "url": "https://github.com/Bush2021/pitstop/releases/download/v$version/pitstop-$version-windows-arm64.tar.gz"
            }
        }
    },
    "notes": "Pitstop expects pitstop.exe beside App, Data and Cache. These folders and .pitstop are persisted across Scoop updates to retain Chrome, profile and Pitstop state. It manages portable Chrome and Chrome++ Next; review the selected installation root before removing the manifest."
