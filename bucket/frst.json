    "checkver": {
        "url": "https://www.bleepingcomputer.com/download/farbar-recovery-scan-tool/",
        "script": [
            "$base = 'https://www.bleepingcomputer.com/download/farbar-recovery-scan-tool/'",
            "$page32 = (Invoke-WebRequest -Uri ($base + 'dl/81/') -UseBasicParsing -ErrorAction Stop).Content",
            "$page64 = (Invoke-WebRequest -Uri ($base + 'dl/82/') -UseBasicParsing -ErrorAction Stop).Content",
            "$url32 = [regex]::Match($page32, 'https?://download\\.bleepingcomputer\\.com/dl/[^\"''\\s<>]+/FRST\\.exe').Value",
