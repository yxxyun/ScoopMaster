            "if ([string]::IsNullOrWhiteSpace($url32) -or [string]::IsNullOrWhiteSpace($url64)) { throw 'Could not extract both current official FRST download URLs.' }",
            "$temp = Join-Path ([System.IO.Path]::GetTempPath()) ('frst-checkver-' + [guid]::NewGuid().ToString('N') + '.exe')",
            "try {",
            "  Invoke-WebRequest -Uri $url64 -OutFile $temp -UseBasicParsing -ErrorAction Stop",
            "  $version = [System.Diagnostics.FileVersionInfo]::GetVersionInfo($temp).FileVersion",
            "} finally {",
            "  Remove-Item -LiteralPath $temp -Force -ErrorAction SilentlyContinue",
            "}",
            "if ([string]::IsNullOrWhiteSpace($version) -or $version -notmatch '^[0-9]+(\\.[0-9]+)+$') { throw \"Could not read a valid FRST file version: $version\" }",
            "\"version=$version`nurl32=$url32`nurl64=$url64\""
        ],
        "regex": "version=(?<version>[0-9.]+)\\s+url32=(?<url32>https://download\\.bleepingcomputer\\.com/dl/[^\"'\\s<>]+/FRST\\.exe)\\s+url64=(?<url64>https://download\\.bleepingcomputer\\.com/dl/[^\"'\\s<>]+/FRST64\\.exe)",
