{
  "version": "25.05",
  "description": "LizardSystems Wi-Fi Scanner",
  "homepage": "https://lizardsystems.com/wi-fi-scanner/",
  "license": "Freeware",
  "url": "https://lizardsystems.com/download/wifiscanner_setup.exe",
  "hash": "sha256:2302d8c19eff829d6a7dd2eb35488bd97bc97ea51b647b170a3a66436491d46c",
  "installer": {
    "script": [
      "Start-Process \"$dir\\wifiscanner_setup.exe\" -ArgumentList '/VERYSILENT', '/SP-', '/NORESTART', '/CURRENTUSER', '/MERGETASKS=!desktopicon' -Wait",
      "$wifiScannerPath = \"${env:LOCALAPPDATA}\\Programs\\LizardSystems\\Wi-Fi Scanner\\wifiscanner.exe\"",
      "if (!(Test-Path $wifiScannerPath)) {",
      "    Write-Error \"Wi-Fi Scanner was not installed where expected: $wifiScannerPath\"",
      "    exit 1",
      "}",
      "$launcherScript = \"@echo off`nstart `\"$wifiScannerPath`\"`n\"",
      "Set-Content -Path \"$dir\\wifiscanner.bat\" -Value $launcherScript"
    ]
  },
  "uninstaller": {
    "script": [
      "$uninstaller = \"${env:LOCALAPPDATA}\\Programs\\LizardSystems\\Wi-Fi Scanner\\unins000.exe\"",
      "if (Test-Path $uninstaller) {",
      "    Start-Process \"$uninstaller\" -ArgumentList '/VERYSILENT' -Wait",
      "}"
    ]
  },
  "bin": "wifiscanner.bat"
}
