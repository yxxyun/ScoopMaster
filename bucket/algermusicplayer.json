{
    "##": "electron-builder NSIS installer (contains Nullsoft stub). Installed silently into $dir; removal delegates to the bundled uninstaller.",
    "version": "5.1.0",
    "description": "第三方音乐播放器：本地服务、桌面歌词、音乐下载、远程控制",
    "homepage": "https://github.com/algerkong/AlgerMusicPlayer",
    "license": {
        "identifier": "MIT",
        "url": "https://github.com/algerkong/AlgerMusicPlayer/blob/main/LICENSE"
    },
    "notes": [
        "Windows 版只有 NSIS 安装包，本 manifest 用 /S 静默装到 Scoop 目录",
        "卸载调用安装器自带的 Uninstall 程序"
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/algerkong/AlgerMusicPlayer/releases/download/v5.1.0/AlgerMusicPlayer-5.1.0-win-x64.exe",
            "hash": "a46e74cbb167df6968b6ca26313713c32e129925cfe164aef31743a9d46d3dac"
        }
    },
    "installer": {
        "script": [
            "$installer = Join-Path $dir $fname",
            "Start-Process -FilePath $installer -ArgumentList '/S', \"/D=$dir\" -Wait",
            "Remove-Item $installer -Force"
        ]
    },
    "uninstaller": {
        "script": [
            "$candidates = @((Join-Path $dir 'Uninstall AlgerMusicPlayer.exe'), (Join-Path $dir 'uninstall.exe'), (Join-Path $env:LOCALAPPDATA 'Programs\\AlgerMusicPlayer\\Uninstall AlgerMusicPlayer.exe'))",
            "foreach ($u in $candidates) { if (Test-Path -LiteralPath $u) { Start-Process -FilePath $u -ArgumentList '/S' -Wait; break } }"
        ]
    },
    "checkver": {
        "url": "https://github.com/algerkong/AlgerMusicPlayer/releases.atom",
        "regex": "releases/tag/v([\\d.]+)\""
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/algerkong/AlgerMusicPlayer/releases/download/v$version/AlgerMusicPlayer-$version-win-x64.exe"
            }
        },
        "hash": {
            "url": "https://api.github.com/repos/algerkong/AlgerMusicPlayer/releases/tags/v$version",
            "regex": "\"name\":\"AlgerMusicPlayer-$version-win-x64\\.exe\".*?\"digest\":\"sha256:([0-9a-f]{64})\""
        }
    }
}
