{
    "version": "0.2.21",
    "description": "Your prompt vocabulary, one hotkey away, in every window",
    "homepage": "https://promptline.cc",
    "license": "MIT",
    "notes": "Promptline's own setup exe installed it for the current user under %LOCALAPPDATA%\\Promptline, and the app updates itself.",
    "url": "https://github.com/bekalpaslan/promptline/releases/download/v0.2.21/Promptline_0.2.21_x64-setup.exe",
    "hash": "626a61be00e03d90353394b80cebb788d22638fba92dd2669f5f52fd28468484",
    "installer": {
        "args": "/S"
    },
    "uninstaller": {
        "script": [
            "if ($cmd -eq 'uninstall') {",
            "    $key = 'HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\Promptline'",
            "    $un = (Get-ItemProperty -Path $key -ErrorAction SilentlyContinue).UninstallString",
            "    if ($un) {",
            "        Start-Process -FilePath $un.Trim('\"') -ArgumentList '/S' -Wait",
            "        for ($i = 0; $i -lt 60 -and (Test-Path $key); $i++) { Start-Sleep -Seconds 1 }",
            "    }",
            "}"
        ]
    },
    "checkver": {
        "url": "https://promptline.cc/latest.json",
        "jsonpath": "$.version"
    },
    "autoupdate": {
        "url": "https://github.com/bekalpaslan/promptline/releases/download/v$version/Promptline_$version_x64-setup.exe"
    }
}
