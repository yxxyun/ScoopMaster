{
    "version": "7.2.9-jinmo.5",
    "description": "AyuGram fork with Jinmo customizations (Windows x64 portable test build)",
    "homepage": "https://github.com/jinmo100/AyuGramDesktop",
    "license": {
        "identifier": "GPL-3.0-only",
        "url": "https://github.com/jinmo100/AyuGramDesktop/blob/dev/LICENSE"
    },
    "notes": [
        "This package follows the maintainer's AyuGram fork pre-releases: Debug builds with the built-in updater disabled.",
        "Update with 'scoop update ayugram-jinmo'; the application cannot update itself.",
        "Account data is kept in 'persist\\ayugram-jinmo\\TelegramForcePortable\\tdata' and survives updates."
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/jinmo100/AyuGramDesktop/releases/download/v7.2.9-jinmo.5/AyuGram-Jinmo-v7.2.9-jinmo.5.zip",
            "hash": "09ca8742fad26f1bcb663558e23bea608de6ba9e92c3d1ccaed13575bea5aa89"
        }
    },
    "extract_dir": "AyuGram-Jinmo-v7.2.9-jinmo.5",
    "shortcuts": [
        [
            "AyuGram.exe",
            "AyuGram (Jinmo)"
        ]
    ],
    "persist": "TelegramForcePortable",
    "checkver": {
        "url": "https://api.github.com/repos/jinmo100/AyuGramDesktop/releases?per_page=100",
        "script": [
            "$releases = ConvertFrom-Json $page",
            "$release = $releases | Where-Object { $_.prerelease -and -not $_.draft -and $_.published_at } | Sort-Object { [DateTime]$_.published_at } -Descending | Select-Object -First 1",
            "$release.tag_name"
        ],
        "regex": "^v(\\d+(?:\\.\\d+)*-[0-9A-Za-z][0-9A-Za-z.-]*)$"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/jinmo100/AyuGramDesktop/releases/download/v$version/AyuGram-Jinmo-v$version.zip"
            }
        },
        "extract_dir": "AyuGram-Jinmo-v$version"
    }
}
