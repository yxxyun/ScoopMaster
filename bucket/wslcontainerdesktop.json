{
    "##": "上游只发布 MSIX。解包直跑会因缺少包标识在启动时崩溃，故必须真正侧载；开始菜单项由系统在安装包时自动创建，因此不写 shortcuts。",
    "version": "2.4.0",
    "description": "WSL Container Desktop：图形化管理 WSL 容器（WSL 原生容器与外部 Docker 引擎）。",
    "homepage": "https://github.com/mhackermsft/wslcontainerdesktop",
    "license": "GPL-3.0-only",
    "url": [
        "https://github.com/mhackermsft/wslcontainerdesktop/releases/download/v2.4.0/WSLContainerDesktop_2.4.0_x64.msix",
        "https://github.com/mhackermsft/wslcontainerdesktop/releases/download/v2.4.0/WSLContainerDesktop-Signing.cer"
    ],
    "hash": [
        "bd21e0d6b87d5425a0497f73d06eda67ff8c932b997e390e4933944da8965fe1",
        "c00c709f618dae0f782f6f76b7602942fa965e3b088fa9942c2eff9b07a53028"
    ],
    "installer": {
        "script": [
            "$pkgName = '393193CD-4A5B-4502-BC94-7C6AF142CD28'",
            "$msix = (Get-ChildItem -Path $dir -Filter '*.msix' | Select-Object -First 1).FullName",
            "$cer = (Get-ChildItem -Path $dir -Filter '*.cer' | Select-Object -First 1).FullName",
            "if (!$msix -or !$cer) { abort '安装包或签名证书缺失，请先清除缓存后重试: scoop cache rm wslcontainerdesktop' }",
            "# pwsh 7 下 Appx 模块要经 Windows PowerShell 加载，否则 Add-AppxPackage 不可用",
            "if ($PSVersionTable.PSVersion.Major -ge 6) { Import-Module Appx -UseWindowsPowershell 3>$null }",
            "$cert = New-Object System.Security.Cryptography.X509Certificates.X509Certificate2 $cer",
            "$trusted = [bool](Get-ChildItem 'Cert:\\LocalMachine\\TrustedPeople' | Where-Object { $_.Thumbprint -eq $cert.Thumbprint })",
            "# 证书已机器级信任时无需管理员（首次安装才需要），避免每次升级都要求提权",
            "if (!$trusted -and !(is_admin)) { abort '首次安装需要管理员权限：MSIX 由自签证书签名，必须先把证书装入本机「受信任人」。请以管理员身份打开终端后执行: scoop install wslcontainerdesktop' }",
            "Get-Process -Name 'WslContainerDesktop' -ErrorAction SilentlyContinue | Stop-Process -Force",
            "if (!$trusted) {",
            "    Import-Certificate -FilePath $cer -CertStoreLocation 'Cert:\\LocalMachine\\TrustedPeople' | Out-Null",
            "    New-Item -ItemType File -Path (Join-Path $dir '.cert-imported') -Force | Out-Null",
            "    Write-Host \"已导入发布者证书 $($cert.Thumbprint)\"",
            "}",
            "Add-AppxPackage -Path $msix -ForceUpdateFromAnyVersion",
            "$pkg = Get-AppxPackage -Name $pkgName",
            "if (!$pkg) { abort 'Add-AppxPackage 已执行，但未检测到已安装的应用包。' }",
            "$appId = $pkg.PackageFamilyName + '!App'",
            "# 必须经 AppsFolder 启动才能保留包标识，直接运行 exe 会崩",
            "Set-Content -Path (Join-Path $dir 'launch.cmd') -Encoding ASCII -Value '@echo off', ('start \"\" \"shell:AppsFolder' + [char]92 + $appId + '\"')",
            "$persistTarget = if ($persist_dir) { Join-Path $persist_dir 'data' } else { Join-Path (Join-Path (Join-Path $scoopdir 'persist') $app) 'data' }",
            "if ($env:SCOOP_WSLCD_PERSIST_DATA -eq '0') {",
            "    Write-Host '按 SCOOP_WSLCD_PERSIST_DATA=0 跳过数据重定向，数据保留在 MSIX 容器内。'",
            "} else {",
            "    if ($env:SCOOP_WSLCD_PERSIST_DATA) { $persistTarget = $env:SCOOP_WSLCD_PERSIST_DATA }",
            "    $dataDir = Join-Path $env:LOCALAPPDATA ('Packages\\' + $pkg.PackageFamilyName + '\\LocalCache\\Local\\WslContainerDesktop')",
            "    New-Item -ItemType Directory -Force -Path $persistTarget | Out-Null",
            "    $item = Get-Item -LiteralPath $dataDir -Force -ErrorAction SilentlyContinue",
            "    if ($item -and $item.LinkType) {",
            "        Write-Host \"数据目录已是链接，保持不动: $dataDir\"",
            "    } elseif ($item) {",
            "        Copy-Item -Path (Join-Path $dataDir '*') -Destination $persistTarget -Recurse -Force",
            "        [System.IO.Directory]::Delete($dataDir, $true)",
            "    }",
            "    if (-not (Test-Path -LiteralPath $dataDir)) {",
            "        New-Item -ItemType Directory -Force -Path (Split-Path -Parent $dataDir) | Out-Null",
            "        New-Item -ItemType Junction -Path $dataDir -Target $persistTarget | Out-Null",
            "        Write-Host \"应用数据已重定向: $dataDir -> $persistTarget\"",
            "    }",
            "}"
        ]
    },
    "uninstaller": {
        "script": [
            "$pkgName = '393193CD-4A5B-4502-BC94-7C6AF142CD28'",
            "if ($PSVersionTable.PSVersion.Major -ge 6) { Import-Module Appx -UseWindowsPowershell 3>$null }",
            "Get-Process -Name 'WslContainerDesktop' -ErrorAction SilentlyContinue | Stop-Process -Force",
            "$pkg = Get-AppxPackage -Name $pkgName",
            "if ($pkg) {",
            "    $dataDir = Join-Path $env:LOCALAPPDATA ('Packages\\' + $pkg.PackageFamilyName + '\\LocalCache\\Local\\WslContainerDesktop')",
            "    $item = Get-Item -LiteralPath $dataDir -Force -ErrorAction SilentlyContinue",
            "    # 先只摘掉重解析点，避免删除包容器时顺着链接删到 persist 里的数据",
            "    if ($item -and $item.LinkType) { [System.IO.Directory]::Delete($dataDir, $false) }",
            "    Remove-AppxPackage -Package $pkg.PackageFullName",
            "} else {",
            "    Write-Host '未检测到已安装的应用包，跳过移除。'",
            "}",
            "$marker = Join-Path $dir '.cert-imported'",
            "if (Test-Path $marker) {",
            "    $cer = (Get-ChildItem -Path $dir -Filter '*.cer' | Select-Object -First 1).FullName",
            "    if ($cer -and (is_admin)) {",
            "        $thumb = (New-Object System.Security.Cryptography.X509Certificates.X509Certificate2 $cer).Thumbprint",
            "        $store = 'Cert:\\LocalMachine\\TrustedPeople\\' + $thumb",
            "        if (Test-Path $store) { Remove-Item $store -Force; Write-Host \"已移除发布者证书 $thumb\" }",
            "        Remove-Item $marker -Force",
            "    } else {",
            "        warn '未以管理员身份运行：发布者证书仍留在本机「受信任人」存储中，如需清理请以管理员身份删除对应指纹的证书。'",
            "    }",
            "}"
        ]
    },
    "bin": [
        [
            "launch.cmd",
            "wslcd"
        ]
    ],
    "persist": "data",
    "notes": [
        "首次安装需要管理员权限：会把发布者证书（CN=Michael Hacker，自签）导入本机「受信任人」存储，再用 Add-AppxPackage 侧载 MSIX。证书装好之后，后续 scoop update 在普通终端即可完成。",
        "应用数据默认重定向到 $persist_dir\\data；安装前设置环境变量 SCOOP_WSLCD_PERSIST_DATA=0 可关闭，设为其它路径则改用该目录。",
        "启动：开始菜单中的 WSL Container Desktop，或命令行执行 wslcd。",
        "升级后若启动器或数据链接丢失，重新执行 scoop update wslcontainerdesktop 即可重建（不影响 persist 中的数据）。"
    ],
    "checkver": {
        "github": "https://github.com/mhackermsft/wslcontainerdesktop"
    },
    "autoupdate": {
        "url": [
            "https://github.com/mhackermsft/wslcontainerdesktop/releases/download/v$version/WSLContainerDesktop_$version_x64.msix",
            "https://github.com/mhackermsft/wslcontainerdesktop/releases/download/v$version/WSLContainerDesktop-Signing.cer"
        ]
    }
}
