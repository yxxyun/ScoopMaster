                "hash": {
                    "url": "https://api.github.com/repos/KnugiHK/WhatsApp-Chat-Exporter/releases/tags/$version",
                    "jsonpath": "$.assets[?(@.name == 'wtsexporter_win_x64.exe')].digest"
                }
            },
            "arm64": {
                "url": "https://github.com/KnugiHK/WhatsApp-Chat-Exporter/releases/download/$version/wtsexporter_win_arm64.exe",
