        "Move-Item -LiteralPath $executables[0].FullName -Destination (Join-Path $dir 'wtsexporter.exe')"
    ],
    "bin": "wtsexporter.exe",
    "checkver": {
        "url": "https://api.github.com/repos/KnugiHK/WhatsApp-Chat-Exporter/releases?per_page=1",
        "jsonpath": "$[0].tag_name"
    },
