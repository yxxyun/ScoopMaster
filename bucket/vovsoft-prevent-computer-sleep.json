{
    "version": "1.3",
    "description": "Portable edition of Vovsoft Prevent Computer Sleep.",
    "homepage": "https://vovsoft.com/software/prevent-computer-sleep/",
    "license": "Proprietary",
    "url": "https://vovsoft.com/files/prevent-computer-sleep-portable.zip?v=1.3",
    "checkver": {
        "url": "https://vovsoft.com/download/prevent-computer-sleep-portable/",
        "regex": "(?is)Version\\s*(?:<[^>]*>\\s*)*:?\\s*(?:<[^>]*>\\s*)*(?<version>\\d+(?:\\.\\d+)+)"
    },
    "autoupdate": {
        "url": "https://vovsoft.com/files/prevent-computer-sleep-portable.zip?v=$version"
    },
    "shortcuts": [
        [
            "pcsleep.exe",
            "Vovsoft Prevent Computer Sleep"
        ]
    ],
    "notes": [
        "SHA-256 has not been verified; archive contents and the shortcut target have been checked."
    ],
    "pre_install": [
        "if (-not (Test-Path -LiteralPath \"$dir\\key.txt\" -PathType Leaf)) { New-Item -ItemType File -Path \"$dir\\key.txt\" | Out-Null }"
    ],
    "persist": "key.txt"
}
