{
    "version": "9.96",
    "description": "Official portable distribution of Reg Organizer for Windows maintenance and registry cleanup",
    "homepage": "https://www.chemtable.com/organizer.htm",
    "license": "Proprietary",
    "url": "https://files.chemtable.com/ro/portable/reg-organizer-portable-setup.exe",
    "hash": "8FA8E8FA23421A0E56C851DD82EB4D989D2F81C04235F699A739698C11BFC0CF",
    "innosetup": true,
    "bin": "RegOrganizerPortable.exe",
    "shortcuts": [
        [
            "RegOrganizerPortable.exe",
            "ChemTable Reg Organizer Portable"
        ]
    ],
    "checkver": {
        "script": [
            "$html = (Invoke-WebRequest -Uri 'https://www.chemtable.com/organizer.htm' -UseBasicParsing).Content",
            "$text = [System.Net.WebUtility]::HtmlDecode([regex]::Replace($html, '<[^>]+>', ' '))",
            "$text = [regex]::Replace($text, '\\s+', ' ')",
            "$match = [regex]::Match($text, '(?i)\\bReg Organizer\\s+(?<version>\\d+(?:\\.\\d+){1,3})')",
            "if (-not $match.Success) { throw 'Unable to detect the Reg Organizer version from the official ChemTable product page.' }",
            "$match.Groups['version'].Value"
        ],
        "regex": "(?<version>\\d+(?:\\.\\d+){1,3})"
    },
    "autoupdate": {
        "url": "https://files.chemtable.com/ro/portable/reg-organizer-portable-setup.exe"
    },
    "notes": "Scoop extracts the official ChemTable portable package into the app directory; it does not execute the setup program."
}
