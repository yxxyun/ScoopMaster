{
    "version": "0.17.0.1",
    "description": "The Chromium-based web browser made for people, with love. Best privacy by default, unbiased ad-blocking, no bloat and no noise.",
    "homepage": "https://helium.computer",
    "license": "BSD-3-Clause AND GPL-3.0-or-later",
    "depends": "chrome-plus",
    "architecture": {
        "64bit": {
            "url": "https://github.com/imputnet/helium-windows/releases/download/0.17.0.1/helium_0.17.0.1_x64-windows.zip",
            "hash": "f8e1be67222c16636aab1995733a9316c6e3156346a81b6a8093b14be0a66e7d",
            "extract_dir": "helium_0.17.0.1_x64-windows"
        },
        "arm64": {
            "url": "https://github.com/imputnet/helium-windows/releases/download/0.17.0.1/helium_0.17.0.1_arm64-windows.zip",
            "hash": "5c24cb3ea15a697b716fd6e459511bd3450bf5418ea2ed7231902e12136c680a",
            "extract_dir": "helium_0.17.0.1_arm64-windows"
        }
    },
    "pre_install": [
        "ensure \"$persist_dir\\cache\"",
        "ensure \"$persist_dir\\data\"",
        "Copy-Item -Path \"$(scoop prefix chrome-plus)\\*\" -Destination \"$dir\" -Recurse",
        "",
        "foreach ($src in @(",
        "    \"$(scoop prefix googlechrome)\\*\\WidevineCdm\"",
        "    \"$(scoop prefix chrome-portable)\\*\\WidevineCdm\"",
        "    \"$(scoop prefix webview2)\\WidevineCdm\"",
        "    \"$env:ProgramFiles\\Microsoft\\Edge\\Application\\*\\WidevineCdm\"",
        "    \"$env:ProgramFiles\\Microsoft\\EdgeWebView\\Application\\*\\WidevineCdm\"",
        "    \"${env:ProgramFiles(x86)}\\Microsoft\\Edge\\Application\\*\\WidevineCdm\"",
        "    \"${env:ProgramFiles(x86)}\\Microsoft\\EdgeWebView\\Application\\*\\WidevineCdm\"",
        ")) {",
        "    try {",
        "        Copy-Item $src \"$dir\\WidevineCdm\" -Recurse",
        "        break",
        "    } catch {}",
        "}"
    ],
    "bin": [
        [
            "chrome.exe",
            "helium-portable",
            "--user-data-dir=\"$persist_dir\\data\" --disk-cache-dir=\"$persist_dir\\cache\""
        ]
    ],
    "shortcuts": [
        [
            "chrome.exe",
            "Helium Portable",
            "--user-data-dir=\"$persist_dir\\data\" --disk-cache-dir=\"$persist_dir\\cache\""
        ]
    ],
    "persist": "chrome++.ini",
    "checkver": {
        "github": "https://github.com/imputnet/helium-windows"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/imputnet/helium-windows/releases/download/$version/helium_$version_x64-windows.zip",
                "extract_dir": "helium_$version_x64-windows"
            },
            "arm64": {
                "url": "https://github.com/imputnet/helium-windows/releases/download/$version/helium_$version_arm64-windows.zip",
                "extract_dir": "helium_$version_arm64-windows"
            }
        }
    }
}
