{
    "version": "0.15.7.1",
    "description": "The Chromium-based web browser made for people, with love. Best privacy by default, unbiased ad-blocking, no bloat and no noise.",
    "homepage": "https://helium.computer",
    "license": "BSD-3-Clause AND GPL-3.0-or-later",
    "depends": "chrome-plus",
    "architecture": {
        "64bit": {
            "url": "https://github.com/imputnet/helium-windows/releases/download/0.15.7.1/helium_0.15.7.1_x64-mini-installer.exe#/dl.7z",
            "hash": "f27c0628fc44f9ccb1ee43d37366c139994c123372552d7b0d21489d9f025e60"
        },
        "arm64": {
            "url": "https://github.com/imputnet/helium-windows/releases/download/0.15.7.1/helium_0.15.7.1_arm64-mini-installer.exe#/dl.7z",
            "hash": "caf6344c793f80f0e4b98369cad3cea2e106b8a8fb2a5ef3e1f39694f13584d0"
        }
    },
    "pre_install": [
        "Expand-7zipArchive \"$dir\\helium.7z\" -Removal",
        "Rename-Item \"$dir\\Helium-bin\" App",
        "ensure \"$persist\\Data\"",
        "ensure \"$persist\\Cache\"",
        "$ChromePlusDir = (scoop prefix chrome-plus).Trim()",
        "Copy-Item -Path \"$ChromePlusDir\\App\\*\" -Destination \"$dir\\App\\\" -Recurse"
    ],
    "bin": [
        [
            "App\\chrome.exe",
            "helium"
        ]
    ],
    "shortcuts": [
        [
            "App\\chrome.exe",
            "Helium"
        ]
    ],
    "persist": [
        "App\\chrome++.ini",
        "Cache",
        "Data"
    ],
    "checkver": {
        "github": "https://github.com/imputnet/helium-windows"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/imputnet/helium-windows/releases/download/$version/helium_$version_x64-mini-installer.exe#/dl.7z"
            },
            "arm64": {
                "url": "https://github.com/imputnet/helium-windows/releases/download/$version/helium_$version_arm64-mini-installer.exe#/dl.7z"
            }
        }
    }
}
