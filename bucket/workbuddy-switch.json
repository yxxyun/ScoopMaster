{
    "##": "Tauri app; upstream only ships an NSIS setup.exe for Windows (installer-license/silent mode is '/S'). Installed silently into $dir; removal delegates to the installer's own uninstaller.",
    "version": "0.1.62",
    "description": "WorkBuddy / CodeBuddy 多账号切换工具，支持积分到期监控、积分与 Token 统计、agent 状态悬浮窗",
    "homepage": "https://github.com/changexbc/workbuddy-switch",
    "license": {
        "identifier": "MIT",
        "url": "https://github.com/changexbc/workbuddy-switch/blob/main/LICENSE"
    },
    "notes": [
        "Windows 版只有 NSIS 安装器，本 manifest 用 /S 静默装到 Scoop 目录",
        "卸载走安装器自带的 uninstall.exe（找不到时再试 %LOCALAPPDATA% 下的默认位置）",
        "账号数据存在 WorkBuddy/CodeBuddy 自己的配置里，卸载不会清账号"
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/changexbc/workbuddy-switch/releases/download/v0.1.62/workbuddy-switch_0.1.62_x64-setup.exe",
            "hash": "9368c31f1c3286249efb5ed57fe8067e2e4d22269906e9430f41c5754131ec08"
        }
    },
    "installer": {
        "script": [
            "$installer = Join-Path $dir $fname",
            "Start-Process -FilePath $installer -ArgumentList '/S', \"/D=$dir\" -Wait",
            "Remove-Item $installer -Force"
        ]
    },
    "uninstaller": {
        "script": [
            "$candidates = @((Join-Path $dir 'uninstall.exe'), (Join-Path $dir 'Uninstall workbuddy-switch.exe'), (Join-Path $env:LOCALAPPDATA 'workbuddy-switch\\uninstall.exe'), (Join-Path $env:LOCALAPPDATA 'Programs\\workbuddy-switch\\uninstall.exe'))",
            "foreach ($u in $candidates) { if (Test-Path -LiteralPath $u) { Start-Process -FilePath $u -ArgumentList '/S' -Wait; break } }"
        ]
    },
    "checkver": {
        "url": "https://github.com/changexbc/workbuddy-switch/releases.atom",
        "regex": "releases/tag/v([\\d.]+)\""
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/changexbc/workbuddy-switch/releases/download/v$version/workbuddy-switch_$version_x64-setup.exe"
            }
        },
        "hash": {
            "url": "https://api.github.com/repos/changexbc/workbuddy-switch/releases/tags/v$version",
            "regex": "\"name\":\"workbuddy-switch_$version_x64-setup\\.exe\".*?\"digest\":\"sha256:([0-9a-f]{64})\""
        }
    }
}
