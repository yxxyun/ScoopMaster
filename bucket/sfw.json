    "license": "GPL-3.0-or-later",
    "notes": "SFW is distributed as an NSIS installer; this manifest extracts its embedded payload. The GUI binary is 'sing-box.exe' but it is NOT the sing-box core CLI, so no bin shim is created to avoid conflicting with the 'sing-box' package.",
    "architecture": {
        "64bit": {
