            "hash": "9720433083bb00cacbc439cad79b89d337814fe8af31a8ff6f8dc5b807782446"
        },
        "arm64": {
            "url": "https://github.com/SagerNet/sing-box/releases/download/v1.14.4/SFW-1.14.4-arm64.exe#/dl.7z",
            "hash": "65f2813f83616c9e43625873fcc80fdf522aca66d560600d6edb721366efb781"
        }
    },
    "pre_install": [
        "Get-ChildItem \"$dir\\`$PLUGINSDIR\" -Filter 'app-*.7z' | ForEach-Object { 7z x $_.FullName -o\"$dir\" -y | Out-Null }",
        "Remove-Item \"$dir\\`$*\" -Recurse -Force"
    ],
    "shortcuts": [
        [
            "sing-box.exe",
            "SFW"
        ]
    ],
    "checkver": {
        "github": "https://github.com/SagerNet/sing-box"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
