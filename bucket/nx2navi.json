{
    "version": "0.5.0",
    "description": "Ocarina of Time for Nintendo Switch 2 recompiled to run natively on Windows",
    "homepage": "https://github.com/tangerineturtle1/NX2navi",
    "license": {
        "identifier": "Proprietary",
        "url": "https://github.com/tangerineturtle1/NX2navi/blob/main/LICENSE-ADDITIONS"
    },
    "notes": [
        "Run NX2navi and select your own game dump to complete setup.",
        "After updating with Scoop, select Rebuild the Game in the launcher."
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/tangerineturtle1/NX2navi/releases/download/v0.5.0/NX2navi-Setup-0.5.0.exe#/dl.7z",
            "hash": "aad1d8e1dfe6b7de7be9ac679d0a838b0fffad089038ba8ba2929e6c20317576"
        }
    },
    "pre_install": [
        "if (!(Test-Path \"$persist_dir\\data\\launcher.json\")) {",
        "    New-Item \"$dir\\data\" -ItemType Directory -Force | Out-Null",
        "    $settings = @{ game_dir = \"$persist_dir\\game\"; auto_check = $false; desktop_shortcut = $false } | ConvertTo-Json",
        "    [System.IO.File]::WriteAllText(\"$dir\\data\\launcher.json\", $settings, (New-Object System.Text.UTF8Encoding $false))",
        "}"
    ],
    "shortcuts": [
        [
            "NX2navi.exe",
            "NX2navi"
        ]
    ],
    "persist": [
        "data",
        "game",
        "pydeps",
        "toolchain"
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/tangerineturtle1/NX2navi/releases/download/v$version/NX2navi-Setup-$version.exe#/dl.7z"
            }
        }
    }
}
