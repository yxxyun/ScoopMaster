    "license": "Apache-2.0",
    "architecture": {
        "64bit": {
            "url": "https://github.com/milind-soni/OpenMausBot/releases/download/v0.1.144/OpenMausBot-0.1.144-setup.exe#/dl.7z",
            "hash": "sha512:ac7f6f5773738b8bee7b8366d108ad46b3b5927b6eb6cbe65469c9f537491826f7ba73b40ec7c0590d8b657ea77640e552e0cf6ee203aa3ff242261d2cfda04e"
        }
    },
    "installer": {
        "script": [
            "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-64.7z\" \"$dir\"",
            "Remove-Item \"$dir\\`$PLUGINSDIR\", \"$dir\\Uninstall*\", \"$dir\\`$R0\" -Force -Recurse -ErrorAction SilentlyContinue"
        ]
    },
    "bin": [
        [
            "OpenMausBot.exe",
            "openmausbot"
        ]
    ],
    "shortcuts": [
        [
            "OpenMausBot.exe",
            "OpenMausBot"
        ]
    ],
    "checkver": {
        "github": "https://github.com/milind-soni/OpenMausBot"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/milind-soni/OpenMausBot/releases/download/v$version/OpenMausBot-$version-setup.exe#/dl.7z"
            }
        },
        "hash": {
            "url": "$baseurl/latest.yml",
            "regex": "(?sm)$basename.*?sha512:\\s+$base64"
        }
    }
}
