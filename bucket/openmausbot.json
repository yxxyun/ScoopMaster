    "homepage": "https://mausbot.com",
    "license": "Apache-2.0",
    "architecture": {
        "64bit": {
            "url": "https://github.com/milind-soni/OpenMausBot/releases/download/v0.1.152/OpenMausBot-0.1.152-setup.exe#/dl.7z",
            "hash": "sha512:ba2b568c6b9ce0818506bb875816eaea26d6404fb841b764dc3401fd7440c22d48a7fac11a873d962b05f2d8f1b7aed2e4e212fbb387937540d2ab00310d2fc1"
        }
    },
    "installer": {
        "script": [
            "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-64.7z\" \"$dir\"",
            "Remove-Item \"$dir\\`$PLUGINSDIR\", \"$dir\\Uninstall*\", \"$dir\\`$R0\" -Force -Recurse -ErrorAction SilentlyContinue"
        ]
    },
    "bin": [
        [
            "OpenMausBot.exe",
            "openmausbot"
        ]
    ],
    "shortcuts": [
        [
            "OpenMausBot.exe",
            "OpenMausBot"
        ]
    ],
    "checkver": {
        "github": "https://github.com/milind-soni/OpenMausBot"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/milind-soni/OpenMausBot/releases/download/v$version/OpenMausBot-$version-setup.exe#/dl.7z"
            }
        },
        "hash": {
            "url": "$baseurl/latest.yml",
            "regex": "(?sm)$basename.*?sha512:\\s+$base64"
        }
    }
}
