            "hash": "sha512:35595c5566f954836afcefcf2799f609d28bd7c734c42d6070b580582977377613c5b27fc5a90960b2b6016b75680414fb092eaa55f36076ea7a42db9068c720"
        }
    },
    "installer": {
        "script": [
            "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-64.7z\" \"$dir\"",
