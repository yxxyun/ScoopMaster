{
    "version": "0.1.147",
    "description": "Open-source Grok Bot alternative — local-first AI bots with a computer they can use",
    "homepage": "https://mausbot.com",
    "license": "Apache-2.0",
    "architecture": {
        "64bit": {
            "url": "https://github.com/milind-soni/OpenMausBot/releases/download/v0.1.147/OpenMausBot-0.1.147-setup.exe#/dl.7z",
            "hash": "sha512:3a046ae3b0e536730331ecbfbc5a58dd43577ff093aa5b273c4397e50cf3c9eee5cc7a1346191fc3a5da05f4fab02abc5e014d94decb3a14ff4449daf5c14502"
        }
    },
    "installer": {
        "script": [
            "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-64.7z\" \"$dir\"",
            "Remove-Item \"$dir\\`$PLUGINSDIR\", \"$dir\\Uninstall*\", \"$dir\\`$R0\" -Force -Recurse -ErrorAction SilentlyContinue"
        ]
    },
    "bin": [
        [
            "OpenMausBot.exe",
            "openmausbot"
        ]
    ],
    "shortcuts": [
        [
            "OpenMausBot.exe",
            "OpenMausBot"
        ]
    ],
    "checkver": {
        "github": "https://github.com/milind-soni/OpenMausBot"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/milind-soni/OpenMausBot/releases/download/v$version/OpenMausBot-$version-setup.exe#/dl.7z"
            }
        },
        "hash": {
            "url": "$baseurl/latest.yml",
            "regex": "(?sm)$basename.*?sha512:\\s+$base64"
        }
    }
}
