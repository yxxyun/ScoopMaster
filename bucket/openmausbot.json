{
    "version": "0.1.158",
    "description": "Open-source Grok Bot alternative — local-first AI bots with a computer they can use",
    "homepage": "https://mausbot.com",
    "license": "Apache-2.0",
    "architecture": {
        "64bit": {
            "url": "https://github.com/milind-soni/OpenMausBot/releases/download/v0.1.158/OpenMausBot-0.1.158-setup.exe#/dl.7z",
            "hash": "sha512:adacb42e72d7c6a570f1900daedbfa9ae796cc738d06dca2144bcee217ae11deded81e91351954555e07266bc34271c56ef9b8b2c2fa671b78012ecf92b47490"
        }
    },
    "installer": {
        "script": [
            "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-64.7z\" \"$dir\"",
            "Remove-Item \"$dir\\`$PLUGINSDIR\", \"$dir\\Uninstall*\", \"$dir\\`$R0\" -Force -Recurse -ErrorAction SilentlyContinue"
        ]
    },
    "bin": [
        [
            "OpenMausBot.exe",
            "openmausbot"
        ]
    ],
    "shortcuts": [
        [
            "OpenMausBot.exe",
            "OpenMausBot"
        ]
    ],
    "checkver": {
        "github": "https://github.com/milind-soni/OpenMausBot"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/milind-soni/OpenMausBot/releases/download/v$version/OpenMausBot-$version-setup.exe#/dl.7z"
            }
        },
        "hash": {
            "url": "$baseurl/latest.yml",
            "regex": "(?sm)$basename.*?sha512:\\s+$base64"
        }
    }
}
