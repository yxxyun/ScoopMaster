{
    "version": "0.1.151",
    "description": "Open-source Grok Bot alternative — local-first AI bots with a computer they can use",
    "homepage": "https://mausbot.com",
    "license": "Apache-2.0",
    "architecture": {
        "64bit": {
            "url": "https://github.com/milind-soni/OpenMausBot/releases/download/v0.1.151/OpenMausBot-0.1.151-setup.exe#/dl.7z",
            "hash": "sha512:bed2fd318e088255be847c0ab0c055e5d57b23ee8913cf42f8e0769b019d3f9fcc9d42674f929589efac4946209d000d48fe35da8a77158dc3948d9ba38843cb"
        }
    },
    "installer": {
        "script": [
            "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-64.7z\" \"$dir\"",
            "Remove-Item \"$dir\\`$PLUGINSDIR\", \"$dir\\Uninstall*\", \"$dir\\`$R0\" -Force -Recurse -ErrorAction SilentlyContinue"
        ]
    },
    "bin": [
        [
            "OpenMausBot.exe",
            "openmausbot"
        ]
    ],
    "shortcuts": [
        [
            "OpenMausBot.exe",
            "OpenMausBot"
        ]
    ],
    "checkver": {
        "github": "https://github.com/milind-soni/OpenMausBot"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/milind-soni/OpenMausBot/releases/download/v$version/OpenMausBot-$version-setup.exe#/dl.7z"
            }
        },
        "hash": {
            "url": "$baseurl/latest.yml",
            "regex": "(?sm)$basename.*?sha512:\\s+$base64"
        }
    }
}
