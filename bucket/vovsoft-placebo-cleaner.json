{
    "version": "1.2",
    "description": "Portable edition of Vovsoft Placebo Cleaner.",
    "homepage": "https://vovsoft.com/software/placebo-cleaner/",
    "license": "Proprietary",
    "url": "https://vovsoft.com/files/placebo-cleaner-portable.zip?v=1.2",
    "checkver": {
        "url": "https://vovsoft.com/download/placebo-cleaner-portable/",
        "regex": "(?is)Version\\s*(?:<[^>]*>\\s*)*:?\\s*(?:<[^>]*>\\s*)*(?<version>\\d+(?:\\.\\d+)+)"
    },
    "autoupdate": {
        "url": "https://vovsoft.com/files/placebo-cleaner-portable.zip?v=$version"
    },
    "shortcuts": [
        [
            "pcleaner.exe",
            "Vovsoft Placebo Cleaner"
        ]
    ],
    "pre_install": [
        "if (-not (Test-Path -LiteralPath \"$dir\\key.txt\" -PathType Leaf)) { New-Item -ItemType File -Path \"$dir\\key.txt\" | Out-Null }"
    ],
    "persist": "key.txt"
}
