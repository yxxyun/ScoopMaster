{
    "version": "5.4",
    "description": "Portable edition of Vovsoft Filename Lister.",
    "homepage": "https://vovsoft.com/software/filename-lister/",
    "license": "Proprietary",
    "url": "https://vovsoft.com/files/filename-lister-portable.zip?v=5.4",
    "checkver": {
        "url": "https://vovsoft.com/download/filename-lister-portable/",
        "regex": "(?is)Version\\s*(?:<[^>]*>\\s*)*:?\\s*(?:<[^>]*>\\s*)*(?<version>\\d+(?:\\.\\d+)+)"
    },
    "autoupdate": {
        "url": "https://vovsoft.com/files/filename-lister-portable.zip?v=$version"
    },
    "shortcuts": [
        [
            "flister.exe",
            "Vovsoft Filename Lister"
        ]
    ],
    "notes": [
        "SHA-256 has not been verified; archive contents and the shortcut target have been checked."
    ],
    "pre_install": [
        "if (-not (Test-Path -LiteralPath \"$dir\\key.txt\" -PathType Leaf)) { New-Item -ItemType File -Path \"$dir\\key.txt\" | Out-Null }"
    ],
    "persist": "key.txt"
}
