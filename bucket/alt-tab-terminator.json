{
    "version": "6.8",
    "description": "Alt-Tab replacement with search, live previews and app cloud",
    "homepage": "https://www.ntwind.com/software/alttabter.html",
    "license": "Proprietary",
    "url": "https://www.ntwind.com/download/AltTabTer_6.8-setup.exe",
    "hash": "dce0aaf78e7b9a908f0a1221a6decdab90c46f2fb28fbc58bb369705195693dd",
    "depends": "main/7zip",
    "installer": {
        "script": [
            "7z x \"$dir\\$fname\" -o\"$dir\" -aou -y | Out-Null",
            "Remove-Item \"$dir\\$fname\"",
            "Remove-Item \"$dir\\*PLUGINSDIR\" -Recurse -Force -ErrorAction SilentlyContinue",
            "Remove-Item \"$dir\\*.nsis\" -ErrorAction SilentlyContinue",
            "Remove-Item \"$dir\\uninst.exe\" -ErrorAction SilentlyContinue",
            "$machine = @{}",
            "@(\"AltTabTer.exe\", \"AltTabTer_1.exe\") | Where-Object { Test-Path \"$dir\\$_\" } | ForEach-Object { $fs = [IO.File]::OpenRead(\"$dir\\$_\"); $br = New-Object IO.BinaryReader($fs); $fs.Position = 0x3C; $peOffset = $br.ReadInt32(); $fs.Position = $peOffset + 4; $machine[$_] = $br.ReadUInt16(); $br.Close(); $fs.Close() }",
            "$x64exe = ($machine.GetEnumerator() | Where-Object { $_.Value -eq 0x8664 }).Name",
            "$x86exe = ($machine.GetEnumerator() | Where-Object { $_.Value -eq 0x014c }).Name",
            "Rename-Item \"$dir\\$x64exe\" \"AltTabTer64.exe\"",
            "Rename-Item \"$dir\\$x86exe\" \"AltTabTer32.exe\""
        ]
    },
    "architecture": {
        "64bit": {
            "bin": [
                [
                    "AltTabTer64.exe",
                    "alttabterminator"
                ]
            ],
            "shortcuts": [
                [
                    "AltTabTer64.exe",
                    "Alt-Tab Terminator"
                ]
            ]
        },
        "32bit": {
            "bin": [
                [
                    "AltTabTer32.exe",
                    "alttabterminator"
                ]
            ],
            "shortcuts": [
                [
                    "AltTabTer32.exe",
                    "Alt-Tab Terminator"
                ]
            ]
        }
    },
    "checkver": {
        "url": "https://www.ntwind.com/download-all.html",
        "regex": "AltTabTer_([\\d.]+)-setup\\.exe"
    },
    "autoupdate": {
        "url": "https://www.ntwind.com/download/AltTabTer_$version-setup.exe"
    }
}
