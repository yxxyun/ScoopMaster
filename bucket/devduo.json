{
    "version": "0.1.6",
    "description": "Desktop WebKit viewport simulator for testing iPhone Duo layouts",
    "homepage": "https://github.com/aitiotekt/DevDuo",
    "license": {
        "identifier": "MIT",
        "url": "https://github.com/aitiotekt/DevDuo/blob/main/LICENSE"
    },
    "depends": "extras/vcredist2022",
    "architecture": {
        "64bit": {
            "url": "https://github.com/aitiotekt/DevDuo/releases/download/v0.1.6/DevDuo-v0.1.6-win-x64.zip",
            "hash": "accc6d85e68455b749fc53c7821b882eb9dcc31cf47ffa8ad8965c05e4ce88ff"
        }
    },
    "extract_dir": "DevDuo",
    "installer": {
        "script": [
            "$helperBucket = if ($bucket) { $bucket } else { 'apeiraco' }",
            ". \"$bucketsdir\\$helperBucket\\bin\\persist-utils.ps1\"",
            "Set-PersistLinks -PersistDir $persist_dir -LinkMap @{ 'localappdata' = '$env:LOCALAPPDATA\\DevDuo' }"
        ]
    },
    "uninstaller": {
        "script": [
            "$helperBucket = if ($bucket) { $bucket } else { 'apeiraco' }",
            ". \"$bucketsdir\\$helperBucket\\bin\\persist-utils.ps1\"",
            "Remove-PersistLinks -PersistDir $persist_dir -LinkMap @{ 'localappdata' = '$env:LOCALAPPDATA\\DevDuo' }"
        ]
    },
    "bin": "DevDuo.exe",
    "shortcuts": [
        [
            "DevDuo.exe",
            "DevDuo"
        ]
    ],
    "checkver": {
        "url": "https://api.github.com/repos/aitiotekt/DevDuo/releases",
        "regex": "\"tag_name\":\\s*\"v([\\d.]+)\""
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/aitiotekt/DevDuo/releases/download/v$version/DevDuo-v$version-win-x64.zip"
            }
        }
    }
}
