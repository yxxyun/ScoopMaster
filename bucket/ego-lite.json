{
    "version": "0.6.3.14",
    "description": "The fastest browser for AI agents to run browser automation (ego lite)",
    "homepage": "https://lite.ego.app/",
    "license": "MIT",
    "notes": [
        "安装时会联网向 Citro Labs 更新服务下载约 300 MB 的浏览器本体，并校验其 SHA256。",
        "首次启动需在 GUI 内完成 onboarding（可选择从其他浏览器导入数据）。",
        "ego-browser 命令由本清单的 shim 提供，不依赖 onboarding 写入的 PATH。",
        "升级 / 重装前请先完全退出 ego lite。",
        "清单版本取官网安装器版本与更新服务载荷版本中的较高者；实际运行版本可用 ego-browser --version 查看。",
        "用户数据保存在 %LOCALAPPDATA%\\Citro Labs\\ego\\User Data，不随 Scoop 升级或卸载删除。",
        "首次启动会在 ~/.local/share/ego 建立指向 current 的 junction 并写入用户 PATH；卸载时本清单会自动清理这两个链接和 PATH 项。"
    ],
    "architecture": {
        "64bit": {
            "url": "https://cdn.ego.app/setup/windows/x64/egoliteSetup.exe",
            "hash": "b2e5881312201d2b03c306c1446d4ce996b92fa45611a9f60b224a1082cc5a65"
        }
    },
    "installer": {
        "script": [
            "$ErrorActionPreference = 'Stop'",
            "Write-Host 'Resolving the latest ego lite package...' -ForegroundColor Cyan",
            "$body = @{ request = @{ protocol = '4.0'; acceptformat = 'crx3,download,puff,run,xz,zucc'; os = @{ platform = 'win'; arch = 'x64' }; apps = @(@{ appid = '{712B23BF-E734-4038-BE42-D5736B6D9570}'; updatecheck = @{} }) } } | ConvertTo-Json -Depth 5",
            "$raw = (Invoke-WebRequest -Uri 'https://update.citrolabs.ai/service/update2' -Method Post -Body $body -ContentType 'application/json' -UseBasicParsing).Content",
            "$json = ($raw -replace '^[^{\\[]+', '') | ConvertFrom-Json",
            "$op = $json.response.apps[0].updatecheck.pipelines.operations | Where-Object { $_.type -eq 'download' } | Select-Object -First 1",
            "if (!$op -or !$op.urls[0].url) { abort 'Could not resolve the ego lite download URL from the update service.' }",
            "if (!$op.out.sha256) { abort 'The update service did not provide a SHA256 for the ego lite package.' }",
            "$crx = \"$dir\\package.crx3\"",
            "Write-Host 'Downloading ego lite browser package...' -ForegroundColor Cyan",
            "curl.exe --fail --location --retry 3 -s -S $op.urls[0].url -o $crx",
            "if ($LASTEXITCODE -ne 0 -or !(Test-Path $crx)) { abort 'Failed to download the ego lite browser package.' }",
            "$actual = (Get-FileHash $crx -Algorithm SHA256).Hash.ToLower()",
            "$expected = $op.out.sha256.ToLower()",
            "if ($actual -ne $expected) { abort \"Hash mismatch for the ego lite package: expected $expected, got $actual\" }",
            "Write-Host 'Extracting ego lite...' -ForegroundColor Cyan",
            "$stream = [System.IO.File]::OpenRead($crx)",
            "$buf = New-Object byte[] 12",
            "$stream.Read($buf, 0, 12) | Out-Null",
            "$headerLen = [System.BitConverter]::ToUInt32($buf, 8)",
            "$stream.Seek(12 + $headerLen, [System.IO.SeekOrigin]::Begin) | Out-Null",
            "$zip = \"$dir\\package.zip\"",
            "$out = [System.IO.File]::Create($zip)",
            "$stream.CopyTo($out)",
            "$stream.Close()",
            "$out.Close()",
            "Remove-Item $crx -Force",
            "Expand-7zipArchive \"$zip\" -DestinationPath $dir -Removal",
            "Expand-7zipArchive \"$dir\\mini_installer_uncompressed.exe\" -DestinationPath $dir -ExtractDir 'Chrome-bin' -Removal",
            "$helper = Get-ChildItem -Path $dir -Filter 'ego-browser.exe' -Recurse -File | Select-Object -First 1",
            "if ($helper) { Copy-Item $helper.FullName \"$dir\\ego-browser.exe\" -Force }",
            "Remove-Item \"$dir\\egoliteSetup.exe\" -Force -ErrorAction SilentlyContinue",
            "if (!(Test-Path \"$dir\\ego.exe\")) { abort 'ego lite installation failed: ego.exe was not extracted.' }"
        ]
    },
    "uninstaller": {
        "script": [
            "$egoHome = \"$env:USERPROFILE\\.local\\share\\ego\"",
            "$active = \"$egoHome\\active_version_dir\"",
            "if (Test-Path $active) {",
            "    $target = (Get-Item $active -Force).Target",
            "    if ($target -like \"$scoopdir\\apps\\$app\\*\") {",
            "        foreach ($link in @($active, \"$egoHome\\ego-skills\")) {",
            "            $item = Get-Item $link -Force -ErrorAction SilentlyContinue",
            "            if ($item -and $item.LinkType -eq 'Junction') { [System.IO.Directory]::Delete($link) }",
            "        }",
            "        Remove-Item $egoHome -Force -ErrorAction SilentlyContinue",
            "        $userPath = [Environment]::GetEnvironmentVariable('Path', 'User')",
            "        if ($userPath) {",
            "            $normalized = [System.IO.Path]::GetFullPath($active)",
            "            $entries = @($userPath -split ';' | Where-Object { $_ -and ([System.IO.Path]::GetFullPath($_) -ne $normalized) })",
            "            $newPath = $entries -join ';'",
            "            if ($newPath -ne $userPath) { [Environment]::SetEnvironmentVariable('Path', $newPath, 'User') }",
            "        }",
            "    }",
            "}"
        ]
    },
    "bin": [
        [
            "ego.exe",
            "ego"
        ],
        [
            "ego.exe",
            "ego-lite"
        ],
        "ego-browser.exe"
    ],
    "shortcuts": [
        [
            "ego.exe",
            "ego lite"
        ]
    ],
    "checkver": {
        "script": [
            "$body = @{ request = @{ protocol = '4.0'; acceptformat = 'crx3,download,puff,run,xz,zucc'; os = @{ platform = 'win'; arch = 'x64' }; apps = @(@{ appid = '{712B23BF-E734-4038-BE42-D5736B6D9570}'; updatecheck = @{} }) } } | ConvertTo-Json -Depth 5",
            "$latest = $null",
            "try {",
            "    $raw = (Invoke-WebRequest -Uri 'https://update.citrolabs.ai/service/update2' -Method Post -Body $body -ContentType 'application/json' -UseBasicParsing).Content",
            "    $latest = (($raw -replace '^[^{\\\\[]+', '') | ConvertFrom-Json).response.apps[0].updatecheck.nextversion",
            "} catch { }",
            "$stub = (Invoke-WebRequest -Uri 'https://cdn.ego.app/setup/windows/x64/egoliteSetup.exe' -Method Head -UseBasicParsing).Headers['x-amz-meta-omaha-version']",
            "if ($latest -and ([version]$latest -gt [version]([string]$stub))) { $latest } else { [string]$stub }"
        ],
        "regex": "([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://cdn.ego.app/setup/windows/x64/egoliteSetup.exe"
            }
        }
    }
}
