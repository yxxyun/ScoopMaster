{
    "version": "8.2.0",
    "description": "Universal One-Click Launcher. Easiest way for humans and AIs to install, launch, and control any open source app.",
    "homepage": "https://desktop.pinokio.co/",
    "license": "GPL-3.0-only",
    "url": "https://github.com/pinokiocomputer/pinokio/releases/download/v8.2.0/Pinokio.exe#/Pinokio.exe",
    "hash": "sha512:fc8aa02f927bffe68029761466627f0c0b03017ef1078b31e7d0809c23254e744f91dd48fd8021146c40754d8e31d029810a3c2adea705d984874e0eb94e75c3",
    "installer": {
        "script": "Invoke-ExternalCommand -FilePath \"$dir\\Pinokio.exe\" -Args @('/S', '/noredist', \"/D=$dir\") | Out-Null"
    },
    "uninstaller": {
        "script": "Invoke-ExternalCommand -FilePath \"$dir\\Uninstall Pinokio.exe\" -Args @('/S', '/noredist', \"/D=$dir\") | Out-Null"
    },
    "bin": "Pinokio.exe",
    "shortcuts": [
        [
            "Pinokio.exe",
            "Pinokio"
        ]
    ],
    "checkver": {
        "github": "https://github.com/pinokiocomputer/pinokio"
    },
    "autoupdate": {
        "url": "https://github.com/pinokiocomputer/pinokio/releases/download/v$version/Pinokio.exe#/Pinokio.exe",
        "hash": {
            "url": "$baseurl/latest.yml",
            "regex": "sha512: $base64"
        }
    }
}
