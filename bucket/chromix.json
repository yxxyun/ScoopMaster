{
    "version": "152.0.7977.82",
    "description": "Chromium-based browser build with coherent per-launch browser personas for automation, compatibility testing and controlled fingerprinting experiments, built on ungoogled-chromium",
    "homepage": "https://github.com/xiaozhou26/Chromix",
    "license": "BSD-3-Clause",
    "notes": [
        "Chromix 是基于 ungoogled-chromium 的浏览器构建，用于浏览器自动化、兼容性测试、隐私研究与可控指纹实验",
        "自定义浏览器不能让自动化完全不可检测，网络信誉、行为特征、账号历史等信号仍然有效",
        "版本号跟随 Chromium 上游，tag 格式为 v152.0.7977.75",
        "通过 chromix 命令或 chrome.exe 启动，可用 --fingerprint=123456789 等参数复现测试人设",
        "浏览器用户数据默认写入 %LOCALAPPDATA%\\Chromix\\User Data，由本包持久化到 Scoop persist"
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/xiaozhou26/Chromix/releases/download/v152.0.7977.82/chromix-win-x64.zip",
            "hash": "b4eed76824f5eae0b85de57081aa6b8c7ab8fcbee0432453ffb494900cae0c1e",
            "extract_dir": "chromix"
        }
    },
    "bin": "chrome.exe",
    "shortcuts": [
        [
            "chrome.exe",
            "Chromix"
        ]
    ],
    "post_install": [
        "$source = Join-Path $env:LOCALAPPDATA 'Chromix'",
        "$target = Join-Path $persist_dir 'user-data'",
        "ensure $target",
        "",
        "if (Test-Path $source) {",
        "    $item = Get-Item -LiteralPath $source -Force",
        "    if ($item.Attributes -band [IO.FileAttributes]::ReparsePoint) {",
        "        Write-Host \"检测到已存在的联接点：$source，跳过创建\"",
        "        return",
        "    }",
        "    if (-not $item.PSIsContainer) {",
        "        throw \"配置路径已存在且不是目录：$source\"",
        "    }",
        "",
        "    & robocopy $source $target /E /R:1 /W:1 /NFL /NDL /NJH /NJS /NP | Out-Null",
        "    if ($LASTEXITCODE -gt 7) {",
        "        Write-Host \"迁移失败，保留原目录：$source\"",
        "        return",
        "    }",
        "",
        "    $backup = \"$source.backup-$(Get-Date -Format 'yyyyMMdd-HHmmss')\"",
        "    try {",
        "        Move-Item -LiteralPath $source -Destination $backup -Force",
        "        Write-Host \"已备份原配置目录：$backup\"",
        "    } catch {",
        "        Write-Host \"无法重命名原目录：$source\"",
        "        return",
        "    }",
        "}",
        "",
        "New-Item -Path $source -ItemType Junction -Value $target | Out-Null"
    ],
    "post_uninstall": [
        "$source = Join-Path $env:LOCALAPPDATA 'Chromix'",
        "if (Test-Path $source) {",
        "    $item = Get-Item -LiteralPath $source -Force",
        "    if ($item.Attributes -band [IO.FileAttributes]::ReparsePoint) {",
        "        Remove-Item -LiteralPath $source -Force",
        "    }",
        "}"
    ],
    "persist": "user-data",
    "checkver": {
        "github": "https://github.com/xiaozhou26/Chromix"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/xiaozhou26/Chromix/releases/download/v$version/chromix-win-x64.zip",
                "extract_dir": "chromix"
            }
        }
    }
}
