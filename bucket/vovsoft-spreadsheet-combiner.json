{
    "version": "1.3",
    "description": "Portable edition of Vovsoft Spreadsheet Combiner.",
    "homepage": "https://vovsoft.com/software/spreadsheet-combiner/",
    "license": "Proprietary",
    "url": "https://vovsoft.com/files/spreadsheet-combiner-portable.zip?v=1.3",
    "checkver": {
        "url": "https://vovsoft.com/download/spreadsheet-combiner-portable/",
        "regex": "(?is)Version\\s*(?:<[^>]*>\\s*)*:?\\s*(?:<[^>]*>\\s*)*(?<version>\\d+(?:\\.\\d+)+)"
    },
    "autoupdate": {
        "url": "https://vovsoft.com/files/spreadsheet-combiner-portable.zip?v=$version"
    },
    "shortcuts": [
        [
            "spreadsheet.exe",
            "Vovsoft Spreadsheet Combiner"
        ]
    ],
    "pre_install": [
        "if (-not (Test-Path -LiteralPath \"$dir\\key.txt\" -PathType Leaf)) { New-Item -ItemType File -Path \"$dir\\key.txt\" | Out-Null }"
    ],
    "persist": "key.txt"
}

