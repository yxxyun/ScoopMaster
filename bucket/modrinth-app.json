{
    "version": "0.22.0",
    "description": "The Modrinth App is a unique, open source launcher that allows you to play your favorite Minecraft mods, and keep them up to date, all in one neat little package.",
    "homepage": "https://modrinth.com/app",
    "license": {
        "identifier": "GPL-3.0-or-later",
        "url": "https://github.com/modrinth/code/blob/main/apps/app/LICENSE"
    },
    "url": "https://launcher-files.modrinth.com/versions/0.22.0/windows/Modrinth%20App_0.22.0_x64-setup.exe#/dl.7z",
    "hash": "7275eee11220128f4c5697186b7d27bb8016534ab7b573194a6040998c0839bc",
    "bin": [
        [
            "Modrinth App.exe",
            "modrinth-app"
        ]
    ],
    "env_set": {
        "THESEUS_CONFIG_DIR": "$dir\\data"
    },
    "shortcuts": [
        [
            "Modrinth App.exe",
            "Modrinth App"
        ]
    ],
    "persist": [
        [
            "data",
            "."
        ]
    ],
    "post_install": [
        "Remove-Item -LiteralPath \"$dir\\uninstall.exe\" -Force -ErrorAction SilentlyContinue",
        "Remove-Item -LiteralPath \"$dir\\`$PLUGINSDIR\" -Recurse -Force -ErrorAction SilentlyContinue"
    ],
    "checkver": {
        "github": "https://github.com/modrinth/code"
    },
    "autoupdate": {
        "url": "https://launcher-files.modrinth.com/versions/$version/windows/Modrinth%20App_$version_x64-setup.exe#/dl.7z"
    }
