{
    "version": "1.10.0",
    "description": "Windows taskbar monitor for Codex, Claude Code, and Antigravity usage quotas",
    "homepage": "https://github.com/upstream-ray/codex-usage-monitor",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/upstream-ray/codex-usage-monitor/releases/download/v1.10.0/codex-usage.exe",
            "hash": "9b0158cb7e8f2c43ceb1086c2b4da5ec514b337d6182a0969720a19415af2439"
        }
    },
    "bin": [
        [
            "launch.cmd",
            "codex-usage"
        ]
    ],
    "shortcuts": [
        [
            "launch.vbs",
            "Codex Usage",
            "",
            "codex-usage.exe"
        ]
    ],
    "persist": "profile",
    "pre_install": [
        "$vbs = @(",
        "    'Set fso = CreateObject(\"Scripting.FileSystemObject\")'",
        "    'Set shell = CreateObject(\"WScript.Shell\")'",
        "    'folder = fso.GetParentFolderName(WScript.ScriptFullName)'",
        "    'shell.Environment(\"PROCESS\")(\"APPDATA\") = fso.BuildPath(folder, \"profile\")'",
        "    'shell.Run Chr(34) & fso.BuildPath(folder, \"codex-usage.exe\") & Chr(34), 0, False'",
        ")",
        "Set-Content -LiteralPath (Join-Path $dir 'launch.vbs') -Value $vbs -Encoding ASCII",
        "Set-Content -LiteralPath (Join-Path $dir 'launch.cmd') -Value @('@echo off', 'set \"APPDATA=%~dp0profile\"', 'start \"\" \"%~dp0codex-usage.exe\" %*') -Encoding ASCII"
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/upstream-ray/codex-usage-monitor/releases/download/v$version/codex-usage.exe"
            }
        }
    },
    "notes": [
        "Launch via the Codex Usage shortcut or `codex-usage` shim; running codex-usage.exe directly bypasses the portable profile.",
        "Do not use the application's Start with Windows option or in-app self-update; these operate outside Scoop and can bypass the launcher."
    ]
}
