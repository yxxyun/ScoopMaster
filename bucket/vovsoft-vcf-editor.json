{
    "version": "3.4",
    "description": "Portable edition of Vovsoft VCF Editor.",
    "homepage": "https://vovsoft.com/software/vcf-editor/",
    "license": "Proprietary",
    "url": "https://vovsoft.com/files/vcf-editor-portable.zip?v=3.4",
    "checkver": {
        "url": "https://vovsoft.com/download/vcf-editor-portable/",
        "regex": "(?is)Version\\s*(?:<[^>]*>\\s*)*:?\\s*(?:<[^>]*>\\s*)*(?<version>\\d+(?:\\.\\d+)+)"
    },
    "autoupdate": {
        "url": "https://vovsoft.com/files/vcf-editor-portable.zip?v=$version"
    },
    "shortcuts": [
        [
            "vcfeditor.exe",
            "Vovsoft VCF Editor"
        ]
    ],
    "notes": "SHA-256 has not been verified; archive contents and the shortcut target have been checked.",
    "pre_install": "if (-not (Test-Path -LiteralPath \"$dir\\key.txt\" -PathType Leaf)) { New-Item -ItemType File -Path \"$dir\\key.txt\" | Out-Null }",
    "persist": "key.txt"
}
