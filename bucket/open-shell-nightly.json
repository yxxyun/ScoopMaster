{
    "version": "4.4.201",
    "description": "A collection of utilities bringing back classic features to Windows. Latest Open-Shell pre-release build.",
    "homepage": "https://github.com/Open-Shell/Open-Shell-Menu",
    "license": "MIT",
    "url": "https://github.com/Open-Shell/Open-Shell-Menu/releases/download/v4.4.201/OpenShellSetup_4_4_201.exe",
    "hash": "b97eaf75e45834b729927aa366b90e8107f625b9927dbceb3c1e1cd95cf4e388",
    "installer": {
        "args": [
            "/qn",
            "REBOOT=ReallySuppress"
        ],
        "keep": true
    },
    "uninstaller": {
        "script": [
            "$setup = Get-ChildItem -Path $dir -Filter 'OpenShellSetup*.exe' -File | Select-Object -First 1",
            "if ($setup) { Start-Process -FilePath $setup.FullName -ArgumentList '/x %MSI% /qn REBOOT=ReallySuppress' -Wait }"
        ]
    },
    "checkver": {
        "url": "https://api.github.com/repos/Open-Shell/Open-Shell-Menu/releases",
        "jsonpath": "$[?(@.prerelease == true)].assets[?(@.name =~ /OpenShellSetup/i)].browser_download_url",
        "regex": "download/v([\\d.]+)/OpenShellSetup_([\\d_]+)\\.exe"
    },
    "autoupdate": {
        "url": "https://github.com/Open-Shell/Open-Shell-Menu/releases/download/v$version/OpenShellSetup_$underscoreVersion.exe",
        "hash": {
            "url": "https://api.github.com/repos/Open-Shell/Open-Shell-Menu/releases/tags/v$version",
            "regex": "(?s)\\\"name\\\":\\\"$basename\\\".*?\\\"digest\\\":\\\"sha256:([a-f0-9]{64})\\\""
        }
    }
}
