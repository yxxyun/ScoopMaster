{
    "version": "1.1.7",
    "description": "磁盘空间变化对比小工具：对比两次快照，快速定位是哪些文件吃掉了新增空间",
    "homepage": "https://github.com/Kami958/WhoShitsonMyC",
    "license": "GPL-3.0-only",
    "notes": [
        "应用数据（快照数据库、语言与主题设置、删除黑名单、固定快照）全部位于 %LOCALAPPDATA%\\WhoShitsOnMyC，本包用目录级联接点托管到 persist\\WhoShitsOnMyC\\appdata，升级与重装都不会丢失",
        "本包使用上游单文件 exe，无需安装，快捷方式与命令行入口 wsmc 都指向同一个可执行文件",
        "应用内的“删除文件”与“卸载后清理数据”功能会请求管理员权限，Scoop 安装与卸载都不会触碰这些操作",
        "扫描结果为本地快照数据，不含云端同步"
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/Kami958/WhoShitsonMyC/releases/download/v1.1.7/wsmc-v1.1.7.exe#/wsmc.exe",
            "hash": "8a78448d59174ccc224868178041b6e6b14f6462670a043df84311ced782d912"
        }
    },
    "bin": "wsmc.exe",
    "shortcuts": [
        [
            "wsmc.exe",
            "WhoShitsonMyC"
        ]
    ],
    "post_install": [
        "$source = Join-Path $env:LOCALAPPDATA 'WhoShitsOnMyC'",
        "$target = Join-Path $persist_dir 'appdata'",
        "ensure $target",
        "",
        "if (Test-Path $source) {",
        "    $item = Get-Item -LiteralPath $source -Force",
        "    if ($item.Attributes -band [IO.FileAttributes]::ReparsePoint) {",
        "        Write-Host \"检测到已存在的联接点：$source，跳过创建\"",
        "        return",
        "    }",
        "    if (-not $item.PSIsContainer) {",
        "        throw \"数据路径已存在且不是目录：$source\"",
        "    }",
        "",
        "    & robocopy $source $target /E /R:1 /W:1 /NFL /NDL /NJH /NJS /NP | Out-Null",
        "    if ($LASTEXITCODE -gt 7) {",
        "        Write-Host \"迁移失败，保留原目录：$source\"",
        "        return",
        "    }",
        "",
        "    $backup = \"$source.backup-$(Get-Date -Format 'yyyyMMdd-HHmmss')\"",
        "    try {",
        "        Move-Item -LiteralPath $source -Destination $backup -Force",
        "        Write-Host \"已备份原数据目录：$backup\"",
        "    } catch {",
        "        Write-Host \"无法重命名原目录：$source\"",
        "        return",
        "    }",
        "}",
        "",
        "New-Item -Path $source -ItemType Junction -Value $target | Out-Null"
    ],
    "post_uninstall": [
        "$source = Join-Path $env:LOCALAPPDATA 'WhoShitsOnMyC'",
        "if (Test-Path -LiteralPath $source) {",
        "    $item = Get-Item -LiteralPath $source -Force",
        "    if ($item.Attributes -band [IO.FileAttributes]::ReparsePoint) {",
        "        Remove-Item -LiteralPath $source -Force",
        "    }",
        "}"
    ],
    "checkver": {
        "github": "https://github.com/Kami958/WhoShitsonMyC"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/Kami958/WhoShitsonMyC/releases/download/v$version/wsmc-v$version.exe#/wsmc.exe"
            }
        },
        "hash": {
            "mode": "download"
        }
    }
}
