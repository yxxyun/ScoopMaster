{
    "version": "3.18.0.367",
    "description": "Unofficial Minecraft Launcher which is multi-functional, cross-platform and popular",
    "homepage": "https://github.com/HMCL-dev/HMCL",
    "license": "GPL-3.0-only",
    "suggest": {
        "JDK": "java/openjdk"
    },
    "url": "https://github.com/HMCL-dev/HMCL/releases/download/v3.18.0.367/HMCL-3.18.0.367.jar#/hmcl.jar",
    "hash": "10f6cf30ea5dda7c50cfeef458e8348a618710c638e2d5ffa5c1f368222dd6bb",
    "pre_install": [
        "@(",
        "   '@echo off'",
        "   'pushd %~dp0'",
        "   'start /b \"\" javaw.exe -Dhmcl.home=.hmcl -jar hmcl.jar'",
        ") | Set-Content \"$dir\\hmcl.cmd\" -Encoding ASCII"
    ],
    "bin": "hmcl.cmd",
    "shortcuts": [
        [
            "hmcl.cmd",
            "HMCL"
        ]
    ],
    "persist": [
        ".minecraft",
        ".hmcl"
    ],
    "checkver": {
        "github": "https://api.github.com/repos/HMCL-dev/HMCL/releases",
        "jsonpath": "$[*].tag_name"
    },
    "autoupdate": {
        "url": "https://github.com/HMCL-dev/HMCL/releases/download/v$version/HMCL-$version.jar#/hmcl.jar"
    }
}
