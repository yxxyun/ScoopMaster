{
    "version": "12.25.1",
    "description": "Postman 中文注入版 - Complete API development environment with Chinese UI (postman-chinese-injector)",
    "homepage": "https://github.com/hlmd/postman-chinese-injector",
    "license": {
        "identifier": "Freeware",
        "url": "https://www.getpostman.com/licenses/postman_eula"
    },
    "notes": [
        "汉化由 postman-chinese-injector v1.5.2 在安装/升级时自动注入；应用数据目录（%APPDATA%\\Postman）与官方版共享。",
        "已移除 Squirrel 自更新组件（Update.exe / squirrel.exe），请统一使用 scoop update postman-cn 更新。"
    ],
    "architecture": {
        "64bit": {
            "url": [
                "https://dl.pstmn.io/download/12.25.1/Postman%20v12.25.1%20(x64).exe#/dl.7z",
                "https://github.com/hlmd/postman-chinese-injector/releases/download/v1.5.2/postman-chinese-injector-win-x64.zip"
            ],
            "hash": [
                "sha1:cf87eb10fbe4c65fdb2bc48c9fed7253a059a648",
                "166b5793658340417b2d71bbd548dfc78454f4932813d5451f000399781bf780"
            ]
        }
    },
    "installer": {
        "script": [
            "Expand-7zipArchive \"$dir\\Postman-$version-full.nupkg\" \"$dir\\postman\" -ExtractDir 'lib\\net45' -Removal",
            "'background.gif', 'RELEASES', 'setupIcon.ico', 'Update.exe' | ForEach-Object { Remove-Item \"$dir\\$_\" -Force -ErrorAction SilentlyContinue }",
            "Remove-Item \"$dir\\postman\\squirrel.exe\" -Force -ErrorAction SilentlyContinue"
        ]
    },
    "post_install": [
        "Get-Process -Name 'Postman' -ErrorAction SilentlyContinue | Stop-Process -Force -ErrorAction SilentlyContinue",
        "& \"$dir\\postman-chinese-injector-win-x64.exe\" --resources \"$dir\\postman\\resources\"",
        "if ($LASTEXITCODE -ne 0) { throw \"postman-chinese-injector failed with exit code $LASTEXITCODE\" }",
        "Remove-Item \"$dir\\postman-chinese-injector-win-x64.exe\" -Force"
    ],
    "shortcuts": [
        [
            "postman/Postman.exe",
            "Postman CN"
        ]
    ],
    "pre_uninstall": "Get-Process -Name 'Postman' -ErrorAction SilentlyContinue | Stop-Process -Force -ErrorAction SilentlyContinue",
    "checkver": {
        "url": "https://dl.pstmn.io/changelog?channel=stable&platform=win64",
        "jsonpath": "$.changelog[0].name"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": [
                    "https://dl.pstmn.io/download/$version/Postman%20v$version%20(x64).exe#/dl.7z",
                    "https://github.com/hlmd/postman-chinese-injector/releases/download/v1.5.2/postman-chinese-injector-win-x64.zip"
                ],
                "hash": [
                    {
                        "url": "https://dl.pstmn.io/RELEASES?platform=win64&from=$version",
                        "regex": "(?sm)$basename.*?$sha1"
                    },
                    {
                        "url": "https://api.github.com/repos/hlmd/postman-chinese-injector/releases/tags/v1.5.2",
                        "jsonpath": "$.assets[?(@.name == 'postman-chinese-injector-win-x64.zip')].digest"
                    }
                ]
            }
        }
    }
}
