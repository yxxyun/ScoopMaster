{
    "version": "3.6.2",
    "description": "Open-source controller for Flydigi BS-series laptop coolers, featuring smart fan curves, hardware monitoring, RGB control, profiles, and Windows/Linux support.",
    "homepage": "https://github.com/TIANLI0/THRM",
    "license": "MIT",
    "depends": "pawnio",
    "architecture": {
        "64bit": {
            "url": "https://github.com/TIANLI0/THRM/releases/download/v3.6.2/THRM-windows-portable.zip",
            "hash": "f1478a10d41e28e092829c2c694f3c18b8016e382d37bd36663dc92a5753269d"
        }
    },
    "post_install": [
        "if (Test-Path $env:USERPROFILE\\.thrm) {",
        "    Copy-Item -Path $env:USERPROFILE\\.thrm\\* -Destination \"$persist_dir\\config\" -Force -Recurse",
        "    Remove-Item $env:USERPROFILE\\.thrm -Force -Recurse",
        "}",
        "New-Item -ItemType Junction -Path $env:USERPROFILE\\.thrm -Target $persist_dir\\config | Out-Null",
        "Remove-Item \"$dir\\PawnIO_setup.exe\" -Force -ErrorAction SilentlyContinue",
        "New-Item -ItemType Directory -Path \"$dir\\drivers\" -Force | Out-Null",
        "New-Item -ItemType Junction -Path \"$dir\\drivers\\PawnIO\" -Target \"$(appdir 'pawnio')\\current\" -Force | Out-Null"
    ],
    "post_uninstall": "Remove-Item $env:USERPROFILE\\.thrm -Force -Recurse -ErrorAction SilentlyContinue",
    "shortcuts": [["THRM.exe", "THRM"]],
    "persist": ["config", "themes", "telemetry"],
    "checkver": {
        "github": "https://github.com/TIANLI0/THRM"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/TIANLI0/THRM/releases/download/v$version/THRM-windows-portable.zip"
            }
        }
    }
}
