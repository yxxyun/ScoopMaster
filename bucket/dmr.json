{
    "version": "0.1.0",
    "description": "Standalone Docker Model Runner CLI for running and serving local models",
    "homepage": "https://docs.docker.com/ai/model-runner/",
    "license": "Apache-2.0",
    "architecture": {
        "64bit": {
            "url": "https://github.com/docker/model-runner/releases/download/dmr-v0.1.0/dmr-windows-amd64.zip",
            "hash": "7a867617b6ec11ea362a1ae694e119fbaca6fa832cc98330bf2c7450789b3684"
        }
    },
    "bin": "dmr.exe",
    "checkver": {
        "script": [
            "$releases = Invoke-RestMethod 'https://api.github.com/repos/docker/model-runner/releases?per_page=100'",
            "($releases | Where-Object { $_.tag_name -like 'dmr-v*' } | Select-Object -First 1).tag_name"
        ],
        "regex": "dmr-v([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/docker/model-runner/releases/download/dmr-v$version/dmr-windows-amd64.zip"
            }
        }
    }
}
