{
    "version": "1.6.0",
    "description": "Checks presence of various command line tools and their versions on the path.",
    "homepage": "https://github.com/kdabir/has",
    "license": "MIT",
    "suggest": {
        "Git": "main/git"
    },
    "notes": [
        "It must be used inside a Bash/Zsh session,",
        "The easiest Windows option is Git Bash.",
        "(Experimental) To keep the right tools first, add these to the TOP of your System PATH",
        "  $env:SCOOP\\apps\\git\\current\\bin",
        "  $env:SCOOP\\apps\\git\\current\\usr\\bin"
    ],
    "url": "https://github.com/kdabir/has/archive/refs/tags/v1.6.0.zip",
    "hash": "a0a6cf6084f0aabb719bfc78cceeb9c58f5e71e6a1013362dfc6232ed496f43c",
    "extract_dir": "has-1.6.0",
    "pre_install": [
        "Remove-Item -Path \"$dir\\*\" -Exclude 'has', 'LICENSE' -Recurse -Force",
        "New-Item -Path \"$dir\\has.cmd\" -ItemType File -Force",
        "Add-Content -Path \"$dir\\has.cmd\" -Value \"bash $env:SCOOP\\apps\\has\\current\\has %*\""
    ],
    "bin": "has.cmd",
    "checkver": "github",
    "autoupdate": {
        "url": "https://github.com/kdabir/has/archive/refs/tags/v$version.zip",
        "extract_dir": "has-$version"
    }
}
