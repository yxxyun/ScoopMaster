{
    "version": "2.6",
    "description": "Portable edition of Vovsoft Health Break Reminder.",
    "homepage": "https://vovsoft.com/software/health-break-reminder/",
    "license": "Proprietary",
    "url": "https://vovsoft.com/files/health-break-reminder-portable.zip?v=2.6",
    "checkver": {
        "url": "https://vovsoft.com/download/health-break-reminder-portable/",
        "regex": "(?is)Version\\s*(?:<[^>]*>\\s*)*:?\\s*(?:<[^>]*>\\s*)*(?<version>\\d+(?:\\.\\d+)+)"
    },
    "autoupdate": {
        "url": "https://vovsoft.com/files/health-break-reminder-portable.zip?v=$version"
    },
    "shortcuts": [
        [
            "healthbreak.exe",
            "Vovsoft Health Break Reminder"
        ]
    ],
    "notes": "SHA-256 has not been verified; archive contents and the shortcut target have been checked.",
    "pre_install": "if (-not (Test-Path -LiteralPath \"$dir\\key.txt\" -PathType Leaf)) { New-Item -ItemType File -Path \"$dir\\key.txt\" | Out-Null }",
    "persist": "key.txt"
}
