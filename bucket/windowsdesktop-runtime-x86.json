    },
    "notes": "You can now remove this installer with 'scoop uninstall windowsdesktop-runtime-x86'",
    "architecture": {
        "32bit": {
            "url": "https://builds.dotnet.microsoft.com/dotnet/WindowsDesktop/11.0.0/windowsdesktop-runtime-11.0.0-win-x86.exe",
            "hash": "sha512:f00eba69062f8b1c8a3eb496d4a874558282f6680af3064e495997c0ddfa7c494e6876d9fd91f5fe9245219e87268962c81182323ddd09acf4554c018d282342"
        }
    },
    "pre_install": "if (!(is_admin)) { error 'Admin privileges are required.'; break }",
    "installer": {
        "script": "Invoke-ExternalCommand \"$dir\\$fname\" -ArgumentList '/install', '/quiet', '/norestart' -RunAs | Out-Null"
    },
    "checkver": {
        "url": "https://dotnetcli.blob.core.windows.net/dotnet/WindowsDesktop/Current/latest.version",
        "regex": "([\\d.]+)$"
    },
    "autoupdate": {
        "architecture": {
            "32bit": {
                "url": "https://dotnetcli.blob.core.windows.net/dotnet/WindowsDesktop/$version/windowsdesktop-runtime-$version-win-x86.exe",
                "hash": {
                    "url": "https://dotnet.microsoft.com/download/dotnet/thank-you/runtime-desktop-$version-windows-x86-installer",
                    "regex": "value=\"$sha512\""
                }
            }
        }
    }
}
