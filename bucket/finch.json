    "homepage": "https://finchwork.app/",
    "license": "Proprietary",
    "architecture": {
        "64bit": {
            "url": "https://github.com/finchtoys/finch-releases/releases/download/v1.8.1/Finch-1.8.1-setup-x64.exe#/dl.7z",
            "hash": "sha512:ad91f0257291668d92ea837c14874b901750b9a048b32ff6526f9582f773fbdfcc4d0becac865353b0a4a6e30de4b02f114138a56e3c2e6a58bc186f08c62f48"
