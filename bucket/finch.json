    "shortcuts": [
        [
            "Finch.exe",
            "Finch"
        ]
    ],
    "checkver": {
        "github": "https://github.com/finchtoys/finch-releases"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/finchtoys/finch-releases/releases/download/v$version/Finch-$version-setup-x64.exe#/dl.7z"
            }
        },
        "hash": {
            "url": "$baseurl/latest.yml",
            "regex": "(?sm)$basename.*?sha512:\\s+$base64"
        }
    }
