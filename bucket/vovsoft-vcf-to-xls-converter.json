{
    "version": "3.2",
    "description": "Portable edition of Vovsoft VCF to XLS Converter.",
    "homepage": "https://vovsoft.com/software/vcf-to-xls-converter/",
    "license": "Proprietary",
    "url": "https://vovsoft.com/files/vcf-to-xls-converter-portable.zip?v=3.2",
    "checkver": {
        "url": "https://vovsoft.com/download/vcf-to-xls-converter-portable/",
        "regex": "(?is)Version\\s*(?:<[^>]*>\\s*)*:?\\s*(?:<[^>]*>\\s*)*(?<version>\\d+(?:\\.\\d+)+)"
    },
    "autoupdate": {
        "url": "https://vovsoft.com/files/vcf-to-xls-converter-portable.zip?v=$version"
    },
    "shortcuts": [
        [
            "vcfconv.exe",
            "Vovsoft VCF to XLS Converter"
        ]
    ],
    "notes": [
        "SHA-256 has not been verified; archive contents and the shortcut target have been checked."
    ],
    "pre_install": [
        "if (-not (Test-Path -LiteralPath \"$dir\\key.txt\" -PathType Leaf)) { New-Item -ItemType File -Path \"$dir\\key.txt\" | Out-Null }"
    ],
    "persist": "key.txt"
}
