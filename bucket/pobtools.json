{
    "version": "1.8.13",
    "description": "Open-source Chinese launcher and tools for Path of Building (Path of Exile 1 and 2)",
    "homepage": "https://github.com/Hsiung-Shao/PobTools-zh",
    "license": "MIT",
    "depends": "games/pathofbuilding-community",
    "architecture": {
        "64bit": {
            "url": "https://github.com/Hsiung-Shao/PobTools-zh/releases/download/v1.8.13/PobTools-1.8.13.zip",
            "hash": "b2212898ec6d56754110039ebeb91b993f48dbedb3e290c22cf510fbda92163b"
        }
    },
    "pre_install": [
        "$pobDir = \"$(appdir 'pathofbuilding-community' $global)\\current\"",
        "New-Item -ItemType Junction -Path \"$dir\\PathOfBuildingCommunity\" -Target $pobDir | Out-Null",
        "if (!(Test-Path \"$dir\\pob-zh.ini\")) {",
        "    Set-Content \"$dir\\pob-zh.ini\" '[PobTools]' -Encoding ASCII",
        "}"
    ],
    "bin": [
        [
            "pob-zh.exe",
            "pobtools"
        ]
    ],
    "shortcuts": [
        [
            "pob-zh.exe",
            "PobTools"
        ]
    ],
    "persist": [
        "pob-zh.ini",
        "PobTools",
        "Filters"
    ],
    "checkver": {
        "url": "https://api.github.com/repos/Hsiung-Shao/PobTools-zh/releases/latest",
        "jsonpath": "$.tag_name",
        "regex": "v([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/Hsiung-Shao/PobTools-zh/releases/download/v$version/PobTools-$version.zip"
            }
        }
    },
    "notes": [
        "启动命令：pobtools，或使用开始菜单中的 PobTools。",
        "已关联 PoE 1 的 Path of Building Community；在启动器内点击启动即可使用中文 PoB。",
        "PoE 2 也受支持，可将其 PoB 目录放在 PobTools 旁边，且目录名称需包含 PoE2。",
        "语言可在启动器内切换繁体中文、简体中文、韩文和英文。"
    ]
}
