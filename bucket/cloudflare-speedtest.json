{
    "version": "2.3.5",
    "description": "Test Cloudflare CDN latency and download speed to get the fastest IP (IPv4/IPv6)",
    "homepage": "https://github.com/XIU2/CloudflareSpeedTest",
    "license": "GPL-3.0-only",
    "notes": [
        "cfst：读取随包 ip.txt（IPv4 段）测速，结果写入当前目录 result.csv",
        "cfst-ipv6：读取随包 ipv6.txt（IPv6 段）测速",
        "ip.txt / ipv6.txt 已持久化到 persist，可自行添加 IP 段，升级不丢失；也可用 -f <文件> 覆盖"
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/XIU2/CloudflareSpeedTest/releases/download/v2.3.5/cfst_windows_amd64.zip",
            "hash": "67d06a0c68b7fd6998d5e6abea1dbf850cac2c19c5d8c5980aa32fc7aba1ff5f"
        },
        "32bit": {
            "url": "https://github.com/XIU2/CloudflareSpeedTest/releases/download/v2.3.5/cfst_windows_386.zip",
            "hash": "1ce8beb838bd01a9bfa520ad6a592fc1973a6b4b70e5aac3c25db98105f67935"
        },
        "arm64": {
            "url": "https://github.com/XIU2/CloudflareSpeedTest/releases/download/v2.3.5/cfst_windows_arm64.zip",
            "hash": "84db1fd918fbc4e6fc1fc127681b24810dfdb4b31aa22374e5e129c6ec529573"
        }
    },
    "bin": [
        [
            "cfst.exe",
            "cfst",
            "-f",
            "$dir\\ip.txt"
        ],
        [
            "cfst.exe",
            "cfst-ipv6",
            "-f",
            "$dir\\ipv6.txt"
        ]
    ],
    "persist": [
        "ip.txt",
        "ipv6.txt"
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/XIU2/CloudflareSpeedTest/releases/download/v$version/cfst_windows_amd64.zip"
            },
            "32bit": {
                "url": "https://github.com/XIU2/CloudflareSpeedTest/releases/download/v$version/cfst_windows_386.zip"
            },
            "arm64": {
                "url": "https://github.com/XIU2/CloudflareSpeedTest/releases/download/v$version/cfst_windows_arm64.zip"
            }
        }
    }
}
