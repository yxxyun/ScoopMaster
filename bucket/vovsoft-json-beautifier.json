{
    "version": "2.0",
    "description": "Portable edition of Vovsoft JSON Beautifier.",
    "homepage": "https://vovsoft.com/software/json-beautifier/",
    "license": "Proprietary",
    "url": "https://vovsoft.com/files/json-beautifier-portable.zip?v=2.0",
    "checkver": {
        "url": "https://vovsoft.com/download/json-beautifier-portable/",
        "regex": "(?is)Version\\s*(?:<[^>]*>\\s*)*:?\\s*(?:<[^>]*>\\s*)*(?<version>\\d+(?:\\.\\d+)+)"
    },
    "autoupdate": {
        "url": "https://vovsoft.com/files/json-beautifier-portable.zip?v=$version"
    },
    "shortcuts": [
        [
            "jsonbeautifier.exe",
            "Vovsoft JSON Beautifier"
        ]
    ],
    "notes": [
        "SHA-256 has not been verified; archive contents and the shortcut target have been checked."
    ],
    "pre_install": [
        "if (-not (Test-Path -LiteralPath \"$dir\\key.txt\" -PathType Leaf)) { New-Item -ItemType File -Path \"$dir\\key.txt\" | Out-Null }"
    ],
    "persist": "key.txt"
}
