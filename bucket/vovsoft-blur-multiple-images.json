{
    "version": "2.2",
    "description": "Portable edition of Vovsoft Blur Multiple Images.",
    "homepage": "https://vovsoft.com/software/blur-multiple-images/",
    "license": "Proprietary",
    "url": "https://vovsoft.com/files/blur-multiple-images-portable.zip?v=2.2",
    "checkver": {
        "url": "https://vovsoft.com/download/blur-multiple-images-portable/",
        "regex": "(?is)Version\\s*(?:<[^>]*>\\s*)*:?\\s*(?:<[^>]*>\\s*)*(?<version>\\d+(?:\\.\\d+)+)"
    },
    "autoupdate": {
        "url": "https://vovsoft.com/files/blur-multiple-images-portable.zip?v=$version"
    },
    "shortcuts": [
        [
            "blur.exe",
            "Vovsoft Blur Multiple Images"
        ]
    ],
    "pre_install": [
        "if (-not (Test-Path -LiteralPath \"$dir\\key.txt\" -PathType Leaf)) { New-Item -ItemType File -Path \"$dir\\key.txt\" | Out-Null }"
    ],
    "persist": "key.txt"
}

