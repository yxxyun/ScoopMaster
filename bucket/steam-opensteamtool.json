{
    "version": "nightly",
    "description": "The ultimate entertainment platform.",
    "homepage": "https://store.steampowered.com/",
    "license": {
        "identifier": "Freeware",
        "url": "https://store.steampowered.com/legal/"
    },
    "notes": "Changing Steam library folder is HIGHLY recommended.",
    "depends": "opensteamtool",
    "url": "https://steamcdn-a.akamaihd.net/client/installer/SteamSetup.exe#/dl.7z",
    "pre_install": [
        "Remove-Item \"$dir\\`$PLUGINSDIR\" -Force -Recurse",
        "if (!(Test-Path \"$dir\\opensteamtool.toml\")) {",
        "    New-Item \"$dir\\opensteamtool.toml\" -Type File | Out-Null",
        "}"
    ],
    "post_install": [
        "$src = \"$scoopdir\\apps\\opensteamtool\\current\"",
        "if (Test-Path $src) {",
        "    Copy-Item \"$src\\dwmapi.dll\" $dir -Force",
        "    Copy-Item \"$src\\xinput1_4.dll\" $dir -Force",
        "    Copy-Item \"$src\\OpenSteamTool.dll\" $dir -Force",
        "}"
    ],
    "shortcuts": [
        [
            "Steam.exe",
            "Steam OpenSteamTool",
            "-dev"
        ]
    ],
    "persist": [
        "skins",
        "steamapps",
        "userdata",
        "config\\lua",
        "opensteamtool.toml"
    ]
}
