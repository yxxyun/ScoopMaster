{
    "version": "2.3",
    "description": "Portable edition of Vovsoft Find And Replace Multiple Files.",
    "homepage": "https://vovsoft.com/software/find-and-replace-multiple-files/",
    "license": "Proprietary",
    "url": "https://vovsoft.com/files/find-and-replace-multiple-files-portable.zip?v=2.3",
    "checkver": {
        "url": "https://vovsoft.com/download/find-and-replace-multiple-files-portable/",
        "regex": "(?is)Version\\s*(?:<[^>]*>\\s*)*:?\\s*(?:<[^>]*>\\s*)*(?<version>\\d+(?:\\.\\d+)+)"
    },
    "autoupdate": {
        "url": "https://vovsoft.com/files/find-and-replace-multiple-files-portable.zip?v=$version"
    },
    "shortcuts": [
        [
            "findreplace.exe",
            "Vovsoft Find And Replace Multiple Files"
        ]
    ],
    "pre_install": [
        "if (-not (Test-Path -LiteralPath \"$dir\\key.txt\" -PathType Leaf)) { New-Item -ItemType File -Path \"$dir\\key.txt\" | Out-Null }"
    ],
    "persist": "key.txt"
}

