{
    "version": "0.1.0",
    "description": "An app that can automatically execute tasks at late night.",
    "homepage": "https://github.com/rujax/late-night",
    "license": {
        "identifier": "GPL-3.0",
        "url": "https://github.com/rujax/late-night/blob/main/LICENSE"
    },
    "notes": "Settings are stored in '%APPDATA%\\LateNight', and are not persisted by Scoop.",
    "architecture": {
        "64bit": {
            "url": "https://github.com/rujax/late-night/releases/download/v0.1.0/LateNight_0.1.0_x64-setup.exe",
            "hash": "b136b15a989a480111f2473d3a601f5cddad1a78a65ba6c3df90ccf6d9e5c066"
        }
    },
    "installer": {
        "args": [
            "/S",
            "/D=$dir"
        ]
    },
    "uninstall": {
        "args": "/S"
    },
    "shortcuts": [
        [
            "LateNight.exe",
            "LateNight"
        ]
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/rujax/late-night/releases/download/v$version/LateNight_$version_x64-setup.exe"
            }
        }
    }
}
