{
    "version": "0.6.2",
    "description": "ApkStart - 轻量级 Windows 安卓应用运行器，双击 APK 即装，应用以独立窗口和桌面图标运行",
    "homepage": "https://github.com/RoutineMiku/apkstart",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/RoutineMiku/apkstart/releases/download/v0.6.2/ApkStart-v0.6.2-win64-portable.zip",
            "hash": "aedd4ddb37e4b9d64527fe623e8fa64c80d2218e7b545b4c6b9d63b8724c86f3"
        }
    },
    "bin": [
        "ApkStart.exe",
        [
            "ApkStart.exe",
            "apkstart"
        ]
    ],
    "shortcuts": [
        [
            "ApkStart.exe",
            "ApkStart"
        ]
    ],
    "post_install": [
        "# --- ApkStart x Scoop：数据目录重定向 + 文件关联 + 快捷方式/自启修复 ---",
        "$appRoot = Split-Path -Parent $dir",
        "$dataDir = Join-Path $env:APPDATA 'apkstart'",
        "$progId = 'ApkStart.apk'",
        "$exePath = Join-Path $dir 'ApkStart.exe'",
        "# 1. 结束本程序自己的进程（含它拉起的模拟器）；不碰其他安卓工具",
        "$killRoots = @($appRoot, $persist_dir) | Where-Object { $_ } | ForEach-Object { $_.TrimEnd('\\') }",
        "Get-Process -ErrorAction SilentlyContinue | Where-Object {",
        "    $p = $null",
        "    try { $p = $_.Path } catch { }",
        "    if (-not $p) { return $false }",
        "    foreach ($r in $killRoots) { if ($p.StartsWith($r + '\\', [StringComparison]::OrdinalIgnoreCase)) { return $true } }",
        "    return $false",
        "} | Stop-Process -Force -ErrorAction SilentlyContinue",
        "Start-Sleep -Milliseconds 500",
        "# 2. %APPDATA%\\apkstart -> persist\\apkstart（Junction，跨版本稳定）",
        "if (-not (Test-Path -LiteralPath $persist_dir -PathType Container)) { New-Item -ItemType Directory -Path $persist_dir -Force | Out-Null }",
        "$needLink = $true",
        "if (Test-Path -LiteralPath $dataDir) {",
        "    $item = Get-Item -LiteralPath $dataDir -Force -ErrorAction SilentlyContinue",
        "    if ($item -and ($item.Attributes -band [IO.FileAttributes]::ReparsePoint)) {",
        "        $cur = @($item.Target)[0]",
        "        if ($cur -and ([IO.Path]::GetFullPath($cur).TrimEnd('\\') -ieq [IO.Path]::GetFullPath($persist_dir).TrimEnd('\\'))) {",
        "            $needLink = $false",
        "        } else {",
        "            [IO.Directory]::Delete($dataDir, $false)",
        "        }",
        "    } else {",
        "        Get-ChildItem -LiteralPath $dataDir -Force -ErrorAction SilentlyContinue | ForEach-Object {",
        "            $dst = Join-Path $persist_dir $_.Name",
        "            if (-not (Test-Path -LiteralPath $dst)) { Move-Item -LiteralPath $_.FullName -Destination $dst -Force -ErrorAction SilentlyContinue }",
        "        }",
        "        if (@(Get-ChildItem -LiteralPath $dataDir -Force -ErrorAction SilentlyContinue).Count -gt 0) {",
        "            Write-Host 'ApkStart: 原数据目录仍有文件未能迁移到 persist，暂不建立重定向（数据保留在原处，未删除）。' -ForegroundColor Yellow",
        "            $needLink = $false",
        "        } else {",
        "            Remove-Item -LiteralPath $dataDir -Recurse -Force -ErrorAction SilentlyContinue",
        "        }",
        "    }",
        "}",
        "if ($needLink -and -not (Test-Path -LiteralPath $dataDir)) {",
        "    New-Item -ItemType Junction -Path $dataDir -Target $persist_dir -ErrorAction SilentlyContinue | Out-Null",
        "}",
        "# 3. 关联图标（与 app 内部注册路径一致：<data>\\icons\\apkstart.ico）",
        "$iconDir = Join-Path $persist_dir 'icons'",
        "if (-not (Test-Path -LiteralPath $iconDir)) { New-Item -ItemType Directory -Path $iconDir -Force | Out-Null }",
        "$icon = Join-Path $iconDir 'apkstart.ico'",
        "$srcIco = Join-Path $dir 'resources\\app\\src\\ui\\assets\\appicon.ico'",
        "if ((-not (Test-Path -LiteralPath $icon)) -and (Test-Path -LiteralPath $srcIco)) { Copy-Item -LiteralPath $srcIco -Destination $icon -Force }",
        "# 4. 注册 .apk/.xapk/.apks -> ApkStart.apk（command 指向 current，升级后依然有效）",
        "$hkcu = [Microsoft.Win32.Registry]::CurrentUser",
        "$classes = $hkcu.CreateSubKey('Software\\Classes')",
        "$assocStore = $hkcu.CreateSubKey('Software\\ApkStart\\ScoopAssoc')",
        "$progRoot = $classes.CreateSubKey($progId)",
        "$progRoot.SetValue('', 'Android 应用包')",
        "$progRoot.SetValue('FriendlyTypeName', 'Android 应用包')",
        "$progRoot.CreateSubKey('DefaultIcon').SetValue('', ('\"' + $icon + '\",0'))",
        "$cmdKey = $progRoot.CreateSubKey('shell\\open')",
        "$cmdKey.SetValue('', '安装到 ApkStart')",
        "$cmdKey.CreateSubKey('command').SetValue('', ('\"' + $exePath + '\" \"%1\"'))",
        "foreach ($ext in @('.apk', '.xapk', '.apks')) {",
        "    $extKey = $classes.CreateSubKey($ext)",
        "    $prev = [string]$extKey.GetValue('')",
        "    if ($prev -eq $progId) { $prev = '' }",
        "    $bk = $assocStore.CreateSubKey($ext)",
        "    if ($null -eq $bk.GetValue('prev')) { $bk.SetValue('prev', $prev) }",
        "    $extKey.SetValue('', $progId)",
        "    $extKey.CreateSubKey('OpenWithProgids').SetValue($progId, [byte[]]@(), [Microsoft.Win32.RegistryValueKind]::None)",
        "    $extKey.Close(); $bk.Close()",
        "}",
        "$cmdKey.Close(); $progRoot.Close(); $assocStore.Close(); $classes.Close()",
        "# 5. 开机自启项若指向已删除的版本路径，改回当前路径（不主动新增启动项）",
        "$runKey = $hkcu.OpenSubKey('Software\\Microsoft\\Windows\\CurrentVersion\\Run', $true)",
        "if ($runKey) {",
        "    $v = [string]$runKey.GetValue('ApkStart')",
        "    if ($v -match '^\"([^\"]+)\"') {",
        "        $runExe = $Matches[1]",
        "        if (-not (Test-Path -LiteralPath $runExe)) { $runKey.SetValue('ApkStart', ('\"' + $exePath + '\" --autostart')) }",
        "    }",
        "    $runKey.Close()",
        "}",
        "# 6. 清理指向已删除文件的安卓应用快捷方式（仍在的留给 app 启动时自愈重建）",
        "$ws = New-Object -ComObject WScript.Shell",
        "foreach ($d in @([Environment]::GetFolderPath('Desktop'), (Join-Path $env:APPDATA 'Microsoft\\Windows\\Start Menu\\Programs\\ApkStart'))) {",
        "    if (-not (Test-Path -LiteralPath $d)) { continue }",
        "    Get-ChildItem -LiteralPath $d -Filter '*.lnk' -File -ErrorAction SilentlyContinue | ForEach-Object {",
        "        try { $t = $ws.CreateShortcut($_.FullName).TargetPath } catch { $t = '' }",
        "        if ($t -and $t.StartsWith($appRoot + '\\', [StringComparison]::OrdinalIgnoreCase) -and (-not (Test-Path -LiteralPath $t))) { Remove-Item -LiteralPath $_.FullName -Force -ErrorAction SilentlyContinue }",
        "    }",
        "}",
        "# 7. 通知资源管理器刷新关联与图标",
        "$sig = '[DllImport(\"shell32.dll\")] public static extern void SHChangeNotify(int eventId, int flags, IntPtr item1, IntPtr item2);'",
        "try { Add-Type -MemberDefinition $sig -Name 'ApkStartNotify' -Namespace 'ScoopApkStart' -ErrorAction Stop | Out-Null; [ScoopApkStart.ApkStartNotify]::SHChangeNotify(0x08000000, 0x0000, [IntPtr]::Zero, [IntPtr]::Zero) } catch { }"
    ],
    "pre_uninstall": [
        "# --- 卸载/升级前：先结束进程；只有真正卸载才还原关联并拆掉映射 ---",
        "$appRoot = Split-Path -Parent $dir",
        "$progId = 'ApkStart.apk'",
        "$dataDir = Join-Path $env:APPDATA 'apkstart'",
        "# 1. 结束本程序自己的进程（Scoop 的“运行中”检查在本钩子之后，必须先杀掉才不会被跳过）",
        "$killRoots = @($appRoot, $persist_dir) | Where-Object { $_ } | ForEach-Object { $_.TrimEnd('\\') }",
        "Get-Process -ErrorAction SilentlyContinue | Where-Object {",
        "    $p = $null",
        "    try { $p = $_.Path } catch { }",
        "    if (-not $p) { return $false }",
        "    foreach ($r in $killRoots) { if ($p.StartsWith($r + '\\', [StringComparison]::OrdinalIgnoreCase)) { return $true } }",
        "    return $false",
        "} | Stop-Process -Force -ErrorAction SilentlyContinue",
        "Start-Sleep -Milliseconds 800",
        "# 2. 区分 scoop update 与 scoop uninstall：升级时保留关联/映射/快捷方式，避免升级窗口期丢配置",
        "$isUpgrade = $false",
        "try { $isUpgrade = [bool]@(Get-PSCallStack | Where-Object { $_.ScriptName -match 'scoop-update\\.ps1$' }).Count } catch { }",
        "if (-not $isUpgrade) {",
        "    try {",
        "        $cl = (Get-CimInstance Win32_Process -Filter ('ProcessId = ' + $PID) -ErrorAction Stop).CommandLine",
        "        if ($cl -match 'scoop-update|scoop\\.ps1.*\\bupdate\\b') { $isUpgrade = $true }",
        "    } catch { }",
        "}",
        "if (-not $isUpgrade) {",
        "    $hkcu = [Microsoft.Win32.Registry]::CurrentUser",
        "    $classes = $hkcu.OpenSubKey('Software\\Classes', $true)",
        "    $assocStore = $hkcu.OpenSubKey('Software\\ApkStart\\ScoopAssoc')",
        "    # 3. 取消扩展名关联，并按安装前记录的默认程序还原",
        "    foreach ($ext in @('.apk', '.xapk', '.apks')) {",
        "        $extKey = if ($classes) { $classes.OpenSubKey($ext, $true) } else { $null }",
        "        if (-not $extKey) { continue }",
        "        $owp = $extKey.OpenSubKey('OpenWithProgids', $true)",
        "        if ($owp) { $owp.DeleteValue($progId, $false); if (($owp.ValueCount -eq 0) -and ($owp.SubKeyCount -eq 0)) { $owp.Close(); $extKey.DeleteSubKey('OpenWithProgids', $false) } else { $owp.Close() } }",
        "        $bk = if ($assocStore) { $assocStore.OpenSubKey($ext) } else { $null }",
        "        $prev = if ($bk) { [string]$bk.GetValue('prev') } else { '' }",
        "        if ($bk) { $bk.Close() }",
        "        $cur = [string]$extKey.GetValue('')",
        "        if ($cur -eq $progId) { if ($prev) { $extKey.SetValue('', $prev) } else { $extKey.DeleteValue('', $false) } }",
        "        $extKey.Close()",
        "    }",
        "    if ($classes) { if ($classes.OpenSubKey($progId)) { $classes.DeleteSubKeyTree($progId, $false) }; $classes.Close() }",
        "    if ($assocStore) { $assocStore.Close(); $hkcu.DeleteSubKeyTree('Software\\ApkStart\\ScoopAssoc', $false) }",
        "    # 4. app 自己的「关联前备份」若指向我们的 ProgID，一并清掉",
        "    $appStore = $hkcu.OpenSubKey('Software\\ApkStart', $true)",
        "    if ($appStore) { if ([string]$appStore.GetValue('assocPrev') -eq $progId) { $appStore.DeleteValue('assocPrev', $false) }; $empty = (($appStore.ValueCount -eq 0) -and ($appStore.SubKeyCount -eq 0)); $appStore.Close(); if ($empty) { $hkcu.DeleteSubKeyTree('Software\\ApkStart', $false) } }",
        "    # 5. 拆除 %APPDATA%\\apkstart -> persist 的 Junction（数据留在 persist，除非 --purge）",
        "    $item = Get-Item -LiteralPath $dataDir -Force -ErrorAction SilentlyContinue",
        "    if ($item -and ($item.Attributes -band [IO.FileAttributes]::ReparsePoint)) {",
        "        $cur = @($item.Target)[0]",
        "        if ($cur -and ([IO.Path]::GetFullPath($cur).TrimEnd('\\') -ieq [IO.Path]::GetFullPath($persist_dir).TrimEnd('\\'))) {",
        "            [IO.Directory]::Delete($dataDir, $false)",
        "        }",
        "    }",
        "    # 6. 删除本程序创建的安卓应用快捷方式（否则卸载后桌面/开始菜单全是死链）",
        "    $ws = New-Object -ComObject WScript.Shell",
        "    foreach ($d in @([Environment]::GetFolderPath('Desktop'), (Join-Path $env:APPDATA 'Microsoft\\Windows\\Start Menu\\Programs\\ApkStart'))) {",
        "        if (-not (Test-Path -LiteralPath $d)) { continue }",
        "        Get-ChildItem -LiteralPath $d -Filter '*.lnk' -File -ErrorAction SilentlyContinue | ForEach-Object {",
        "            try { $t = $ws.CreateShortcut($_.FullName).TargetPath } catch { $t = '' }",
        "            if ($t -and $t.StartsWith($appRoot + '\\', [StringComparison]::OrdinalIgnoreCase)) { Remove-Item -LiteralPath $_.FullName -Force -ErrorAction SilentlyContinue }",
        "        }",
        "    }",
        "}",
        "# 7. 通知资源管理器刷新关联与图标",
        "$sig = '[DllImport(\"shell32.dll\")] public static extern void SHChangeNotify(int eventId, int flags, IntPtr item1, IntPtr item2);'",
        "try { Add-Type -MemberDefinition $sig -Name 'ApkStartNotify2' -Namespace 'ScoopApkStart2' -ErrorAction Stop | Out-Null; [ScoopApkStart2.ApkStartNotify2]::SHChangeNotify(0x08000000, 0x0000, [IntPtr]::Zero, [IntPtr]::Zero) } catch { }"
    ],
    "notes": [
        "Scoop 适配说明：",
        "- 双击 .apk/.xapk/.apks 即可直接安装到 ApkStart；关联写在 HKCU（不需要管理员），卸载时会还原你原来的默认程序。",
        "- 若双击仍用旧程序打开，请右键 → 打开方式 → 选择 ApkStart（Windows 记住的“打开方式”优先级高于默认关联）。",
        "- 设置、已装应用、内核运行时与 AVD 已通过 NTFS Junction 持久化到 '$persist_dir'，卸载/升级都不会丢失；实际占用较大（运行时约 3GB，AVD 约 6~24GB），请留足磁盘空间。",
        "- 请用 'scoop update apkstart' 升级，不要用应用内的「立即更新」（它会覆盖版本目录，导致 Scoop 记录失真）。",
        "- 升级后安卓应用的桌面/开始菜单快捷方式会在下次启动 ApkStart 时自动重建。",
        "- 安卓与 Windows 的共享目录仍是 '%USERPROFILE%\\ApkStartShared'；若在设置里把运行时或 AVD 改到其他盘，那部分数据不再受 persist 管理。",
        "- 卸载：'scoop uninstall apkstart'（保留 persist 数据）；连 persist 数据一起删用 'scoop uninstall apkstart --purge'。若迁移被占用文件阻止，原 %APPDATA%\\apkstart 会保留，需手动处理。"
    ],
    "checkver": {
        "github": "https://github.com/RoutineMiku/apkstart"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/RoutineMiku/apkstart/releases/download/v$version/ApkStart-v$version-win64-portable.zip"
            }
        }
    }
}
