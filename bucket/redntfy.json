{
    "version": "1.10.0",
    "description": "Redmine ticket update notifier daemon with Windows Toast notifications",
    "homepage": "https://github.com/aviscaerulea/redntfy",
    "license": "Freeware",
    "notes": "Set your Redmine url, api_key and query_ids in persist\\redntfy\\redntfy.local.toml before use.",
    "architecture": {
        "64bit": {
            "url": "https://github.com/aviscaerulea/redntfy/releases/download/v1.10.0/redntfy-1.10.0-x64.zip",
            "hash": "6a4ebd18128d33c32ca382ee286913244953bbcd7cde5df35db8af06e8eaab82"
        }
    },
    "bin": "redntfy.exe",
    "pre_install": "taskkill /f /im redntfy.exe 2>$null; $LASTEXITCODE = 0; Wait-Process -Name redntfy -Timeout 10 -ErrorAction SilentlyContinue",
    "persist": [
        "redntfy.toml",
        "redntfy.local.toml"
    ],
    "pre_uninstall": "taskkill /f /im redntfy.exe 2>$null; $LASTEXITCODE = 0; Wait-Process -Name redntfy -Timeout 10 -ErrorAction SilentlyContinue",
    "post_install": "Start-Process -FilePath \"$dir\\redntfy.exe\" -WorkingDirectory $dir -WindowStyle Hidden",
    "checkver": {
        "github": "https://github.com/aviscaerulea/redntfy"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/aviscaerulea/redntfy/releases/download/v$version/redntfy-$version-x64.zip"
            }
        }
    }
}
