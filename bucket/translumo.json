{
    "version": "1.1.0",
    "description": "Advanced real-time screen translator.",
    "homepage": "https://github.com/ramjke/Translumo",
    "license": "Apache-2.0",
    "url": "https://github.com/ramjke/Translumo/releases/download/v.1.1.0/Translumo_1.1.0.zip",
    "hash": "e4217a38d68f54f443655db9948f42dde4cbe44bef42122b4108e86c0b61cf5c",
    "bin": "Translumo.exe",
    "shortcuts": [
        [
            "Translumo.exe",
            "Translumo"
        ]
    ],
    "notes": [
        "DeepL and Yandex translation require API keys in Translumo settings."
    ],
    "checkver": {
        "script": [
            "$headers = @{ 'Accept' = 'application/vnd.github+json'; 'User-Agent' = 'Scoop-KiroBucket' }",
            "if (-not [string]::IsNullOrWhiteSpace($env:GITHUB_TOKEN)) { $headers['Authorization'] = \"Bearer $env:GITHUB_TOKEN\" }",
            "$release = Invoke-RestMethod -Uri 'https://api.github.com/repos/ramjke/Translumo/releases/latest' -Headers $headers",
            "if ($release.tag_name -notmatch '^v\\.[\\d.]+$') { throw 'The latest Translumo release tag is not in the expected v.<version> format.' }",
            "Write-Output $release.tag_name"
        ],
        "regex": "^v\\.(?<version>[\\d.]+)$"
    },
    "autoupdate": {
        "url": "https://github.com/ramjke/Translumo/releases/download/v.$version/Translumo_$version.zip"
    }
}
