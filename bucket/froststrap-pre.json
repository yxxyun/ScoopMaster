{
    "version": "2.0.7",
    "description": "A Bloxstrap/Fishstrap fork focused on performance and customization.",
    "homepage": "https://github.com/Froststrap/Froststrap",
    "license": {
        "identifier": "MPL-2.0,AGPL-3.0-only,MIT,Unlicense",
        "url": "https://github.com/Froststrap/Froststrap/blob/main/LICENSE"
    },
    "notes": "The installer adds its own Start menu and desktop shortcuts. Settings live in %LOCALAPPDATA%\\Froststrap.",
    "architecture": {
        "64bit": {
            "url": "https://github.com/Froststrap/Froststrap/releases/download/v2.0.7/Froststrap-windows-x64.msi#/setup.msi_",
            "hash": "090beb0ff4bfe5896003dcf7635f21b66ca6a070db90c7cedb0d4417ea640a60"
        }
    },
    "installer": {
        "script": [
            "# Velopack MSI: install into $dir instead of %LOCALAPPDATA%, keep the package for uninstalling",
            "Rename-Item -LiteralPath \"$dir\\$fname\" -NewName 'setup.msi'",
            "$msi = Start-Process msiexec.exe -ArgumentList @('/i', \"`\"$dir\\setup.msi`\"\", '/qn', '/norestart', \"VELOPACK_INSTALLDIR=`\"$dir`\"\") -Wait -PassThru",
            "if ($msi.ExitCode -notin 0, 3010) { throw \"msiexec failed with exit code $($msi.ExitCode)\" }"
        ]
    },
    "uninstaller": {
        "script": [
            "if (Test-Path -LiteralPath \"$dir\\setup.msi\") {",
            "    Start-Process msiexec.exe -ArgumentList @('/x', \"`\"$dir\\setup.msi`\"\", '/qn', '/norestart') -Wait",
            "}"
        ]
    },
    "bin": "Froststrap.exe",
    "checkver": {
        "url": "https://api.github.com/repos/Froststrap/Froststrap/releases",
        "jsonpath": "$[0].tag_name",
        "regex": "v?([\\d.]+(?:-[\\w.]+)?)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/Froststrap/Froststrap/releases/download/v$version/Froststrap-windows-x64.msi#/setup.msi_"
            }
        }
    }
}
