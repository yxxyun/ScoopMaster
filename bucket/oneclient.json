{
    "version": "2.8.0",
    "description": "A Minecraft client featuring fully 100% open-source components, offering many packaged and pre-configured mods in one click.",
    "homepage": "https://polyfrost.org/projects/oneclient",
    "license": "GPL-3.0",
    "suggest": {
        "JDK": "java/microsoft-jdk"
    },
    "url": "https://github.com/Polyfrost/OneLauncher/releases/download/oneclient-2.8.0/OneClient_2.8.0_windows_x86_64.exe#/dl.7z_",
    "hash": "8b0c29506394a7c69d9173619d9da046e51d2bb8e878590f2177df16ee6b234f",
    "installer": {
        "script": [
            "Expand-7zipArchive \"$dir\\dl.7z_\" -Switches '-x!$*' -Removal",
            "",
            "## Steps to block the built-in Java autoinstaller ##",
            "if ($cmd -eq 'install') {",
            "    info \"Blocking the built-in autoinstaller for Java.\"",
            "    $javaFile = \"$env:APPDATA\\Polyfrost\\OneClient\\metadata\\java\"",
            "    ensure \"$javaFile\\..\" | Out-Null",
            "    Remove-Item \"$javaFile\" -Force -Recurse -ErrorAction SilentlyContinue",
            "    New-Item \"$javaFile\" -ItemType File -Value \"Created by Scoop to block the built-in Java autoinstaller.\" | Out-Null",
            "    Set-ItemProperty \"$javaFile\" -Name IsReadOnly -Value $true",
            "}"
        ]
    },
    "env_set": {
        "ONECLIENT_DISABLE_AUTOUPDATE": "1"
    },
    "shortcuts": [
        [
            "oneclient_app.exe",
            "OneClient"
        ]
    ],
    "uninstaller": {
        "script": "if ($purge) { Remove-Item \"$env:APPDATA\\Polyfrost\\OneClient\" -Force -Recurse -ErrorAction SilentlyContinue }"
    },
    "checkver": {
        "github": "https://github.com/Polyfrost/OneLauncher",
        "regex": "oneclient-([\\d.]+)"
    },
    "autoupdate": {
        "url": "https://github.com/Polyfrost/OneLauncher/releases/download/oneclient-$version/OneClient_$version_windows_x86_64.exe#/dl.7z_"
    }
}
