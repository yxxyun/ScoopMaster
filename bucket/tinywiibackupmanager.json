{
    "version": "6.1.10",
    "description": "A tiny game backup and homebrew app manager for the Wii",
    "homepage": "https://github.com/mq1/TinyWiiBackupManager",
    "license": "GPL-3.0-only",
    "env_set": {
        "TWBM_DISABLE_UPDATES": "1"
    },
    "pre_install": [
        "$oldData = \"$env:APPDATA\\mq1\\TinyWiiBackupManager\\data\"",
        "$targetData = \"$dir\\TinyWiiBackupManager-data\"",
        "if (Test-Path $oldData) {",
        "    $choice = Read-Host \"`nExisting configuration found. We now use portable mode, would you like to migrate? (Y/N)\"",
        "    if ($choice -match '^[Yy]') {",
        "        Write-Host 'Migrating AppData configuration...' -ForegroundColor Cyan",
        "        Move-Item -Path $oldData -Destination $targetData -Force",
        "        $appFolder = Split-Path $oldData -Parent",
        "        $vendorFolder = Split-Path $appFolder -Parent",
        "        if ((Test-Path $appFolder) -and (Get-ChildItem $appFolder).Count -eq 0) {",
        "            Remove-Item -Path $appFolder -Force",
        "        }",
        "        if ((Test-Path $vendorFolder) -and (Get-ChildItem $vendorFolder).Count -eq 0) {",
        "            Remove-Item -Path $vendorFolder -Force",
        "        }",
        "    }",
        "}",
        "if (!(Test-Path $targetData)) {",
        "    New-Item -ItemType Directory -Path $targetData | Out-Null",
        "}"
    ],
    "persist": "TinyWiiBackupManager-data",
    "shortcuts": [
        [
            "TinyWiiBackupManager-portable.exe",
            "TinyWiiBackupManager"
        ]
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/mq1/TinyWiiBackupManager/releases/download/v6.1.10/TinyWiiBackupManager-v6.1.10-windows-x64.exe#/TinyWiiBackupManager-portable.exe",
            "hash": "88290d72564a12e6c6aca6728ef2e5324e009a3fa1b29d25b90d3917d22ebf75"
        },
        "arm64": {
            "url": "https://github.com/mq1/TinyWiiBackupManager/releases/download/v6.1.10/TinyWiiBackupManager-v6.1.10-windows-arm64.exe#/TinyWiiBackupManager-portable.exe",
            "hash": "b9bbaa9103068fe413697c3b15c583e716925a012911cac95a940cbf5d8172b0"
        },
        "32bit": {
            "url": "https://github.com/mq1/TinyWiiBackupManager/releases/download/v6.1.10/TinyWiiBackupManager-v6.1.10-windows-x86.exe#/TinyWiiBackupManager-portable.exe",
            "hash": "9a0fb32e7184447a83ef40f4058b0f59d8870415c69d9f363cbe124597e19a7c"
        }
    },
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/mq1/TinyWiiBackupManager/releases/download/v$version/TinyWiiBackupManager-v$version-windows-x64.exe#/TinyWiiBackupManager-portable.exe"
            },
            "arm64": {
                "url": "https://github.com/mq1/TinyWiiBackupManager/releases/download/v$version/TinyWiiBackupManager-v$version-windows-arm64.exe#/TinyWiiBackupManager-portable.exe"
            },
            "32bit": {
                "url": "https://github.com/mq1/TinyWiiBackupManager/releases/download/v$version/TinyWiiBackupManager-v$version-windows-x86.exe#/TinyWiiBackupManager-portable.exe"
            }
        }
    }
}
