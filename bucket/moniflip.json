{
    "version": "0.1.2",
    "description": "Windows tray utility for switching monitor inputs between computers over DDC/CI.",
    "homepage": "https://github.com/qzz0518/Moniflip",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/qzz0518/Moniflip/releases/download/v0.1.2/Moniflip.Setup.0.1.2.amd64.exe",
            "hash": "cccf148305fef2987d67faddb0fed5d2e96f8b9c6b9ef64535baa54770cd654b"
        }
    },
    "installer": {
        "args": "/S"
    },
    "uninstaller": {
        "script": [
            "$uninstaller = Join-Path $env:LOCALAPPDATA 'Programs\\Moniflip\\Uninstall.exe'",
            "if (Test-Path -LiteralPath $uninstaller -PathType Leaf) {",
            "    & $uninstaller /S",
            "    if ($LASTEXITCODE -ne 0) { throw \"Vendor uninstaller failed with exit code $LASTEXITCODE.\" }",
            "}"
        ]
    },
    "checkver": {
        "github": "https://github.com/qzz0518/Moniflip"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/qzz0518/Moniflip/releases/download/v$version/Moniflip.Setup.$version.amd64.exe",
                "hash": {
                    "mode": "json",
                    "url": "https://api.github.com/repos/qzz0518/Moniflip/releases/tags/v$version",
                    "jp": "$.assets[?(@.name == 'Moniflip.Setup.$version.amd64.exe')].digest"
                }
            }
        }
    },
    "notes": "Requires a DDC/CI-capable monitor with DDC/CI enabled. The Windows installer is unsigned and may trigger SmartScreen."
}
