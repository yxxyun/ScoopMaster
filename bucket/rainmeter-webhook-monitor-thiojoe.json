{
    "version": "1.1.1",
    "description": "Receive webhooks and execute configured commands in Rainmeter skins. Developer: ThioJoe.",
    "homepage": "https://github.com/ThioJoe/Rainmeter-Webhook-Monitor",
    "license": "Unknown",
    "url": "https://github.com/ThioJoe/Rainmeter-Webhook-Monitor/releases/download/v1.1.1/RainmeterWebhookMonitor.exe",
    "pre_install": [
        "if (-not (Test-Path -LiteralPath (Join-Path $persist_dir 'appsettings.json'))) {",
        "    $config = '{\"Logging\":{\"LogLevel\":{\"Default\":\"Information\",\"Microsoft\":\"Warning\",\"Microsoft.Hosting.Lifetime\":\"Information\"}},\"WebhookSettings\":{\"Port\":\"9999\",\"URL_Path\":\"/rainmeter\"},\"RainmeterSettings\":{\"RainmeterPath\":\"C:\\\\Program Files\\\\Rainmeter\\\\Rainmeter.exe\",\"Commands\":[]},\"ApplicationSettings\":{\"DebugMode\":false,\"Delay_Between_Multiple_Commands_ms\":\"5\",\"ShowSystemTrayIcon\":true}}'",
        "    [System.IO.File]::WriteAllText((Join-Path $dir 'appsettings.json'), $config, [System.Text.UTF8Encoding]::new($false))",
        "}"
    ],
    "persist": [
        "appsettings.json",
        "RainmeterWebhookMonitor_DebugLogs"
    ],
    "shortcuts": [
        [
            "RainmeterWebhookMonitor.exe",
            "Rainmeter Webhook Monitor - ThioJoe"
        ]
    ],
    "checkver": {
        "github": "https://github.com/ThioJoe/Rainmeter-Webhook-Monitor"
    },
    "autoupdate": {
        "url": "https://github.com/ThioJoe/Rainmeter-Webhook-Monitor/releases/download/v$version/RainmeterWebhookMonitor.exe",
        "shortcuts": [
            [
                "RainmeterWebhookMonitor.exe",
                "Rainmeter Webhook Monitor - ThioJoe"
            ]
        ]
    },
    "notes": "Requires Rainmeter to be installed. The configuration file and debug logs are persisted across updates. The executable is a self-contained .NET 8 single-file application.",
    "hash": "f508cfb41aed64da14b00ea4c9811140ed317f9f3030011d2491418b60ceda23"
}
