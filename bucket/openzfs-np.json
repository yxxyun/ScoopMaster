{
    "version": "2.4.1rc17b",
    "description": "The open source port of OpenZFS on Windows",
    "homepage": "https://github.com/openzfsonwindows/openzfs",
    "license": "Freeware",
    "url": "https://github.com/openzfsonwindows/openzfs/releases/download/zfswin-2.4.1rc17/OpenZFSOnWindows-debug-2.4.1rc17b.exe#/setup.exe",
    "hash": "1498437731876ce2bf6c4f00511bac3ba7d5a0cd6d05c443202ffcfae0a205e6",
    "installer": {
        "args": [
            "/VERYSILENT",
            "/NOCANCEL",
            "/NORESTART",
            "/CLOSEAPPLICATIONS"
        ]
    },
    "checkver": {
        "script": [
            "$headers = @{ 'User-Agent' = 'KiroBucket-ScoopCheckver'; 'Accept' = 'application/vnd.github+json' }",
            "$release = Invoke-RestMethod -Uri 'https://api.github.com/repos/openzfsonwindows/openzfs/releases/latest' -Headers $headers -TimeoutSec 30",
            "if ([string]::IsNullOrWhiteSpace([string]$release.tag_name)) { throw 'GitHub did not return the latest OpenZFS release tag.' }",
            "$assets = @($release.assets | Where-Object { $_.name -match '^OpenZFSOnWindows-debug-.+\\.exe$' } | Sort-Object updated_at)",
            "if ($assets.Count -eq 0) { throw 'The latest OpenZFS release has no matching Windows debug installer.' }",
            "$name = $assets[-1].name",
            "$versionMatch = [regex]::Match($name, '^OpenZFSOnWindows-debug-(?<version>.+)\\.exe$')",
            "if (-not $versionMatch.Success) { throw 'Could not extract the OpenZFS installer version from the asset name.' }",
            "Write-Output \"$($versionMatch.Groups['version'].Value) $($release.tag_name)\""
        ],
        "regex": "^(?<version>\\S+)\\s(?<tag>\\S+)$"
    },
    "autoupdate": {
        "url": "https://github.com/openzfsonwindows/openzfs/releases/download/$matchTag/OpenZFSOnWindows-debug-$version.exe#/setup.exe"
    }
}
