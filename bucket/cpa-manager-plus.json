    "pre_install": [
        "if (!(Test-Path \"$persist_dir\\config.json\") -and !(Test-Path \"$dir\\config.json\")) {",
        "    [System.IO.File]::WriteAllText(\"$dir\\config.json\", (@{ httpAddr = '0.0.0.0:18317'; dataDir = \"$persist_dir\\data\" } | ConvertTo-Json))",
        "}",
        "@('@echo off', '\"%SystemRoot%\\System32\\WindowsPowerShell\\v1.0\\powershell.exe\" -NoProfile -ExecutionPolicy Bypass -File \"%~dp0cpa-manager-plusctl.ps1\" %*') | Set-Content \"$dir\\cpa-manager-plusctl.cmd\" -Encoding Ascii"
    ],
    "bin": [
        "cpa-manager-plus.exe",
        "cpa-manager-plusctl.cmd"
    ],
    "persist": [
        "config.json",
        "data"
    ],
    "notes": [
        "Run 'cpa-manager-plus' in the foreground, or 'cpa-manager-plusctl start' in the background.",
        "Open http://localhost:18317/management.html and use the generated Admin Key from the console or 'cpa-manager-plusctl logs'.",
        "Requires a separately running CPA / CLIProxyAPI instance and its Management Key.",
        "Configuration and data are persisted in '$persist_dir'. Stop the server before updating."
    ],
