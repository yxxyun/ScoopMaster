{
    "version": "2001.12.28",
    "description": "GRC UnPlug n' Pray: Legacy utility for checking and enabling/disabling the historical Windows UPnP service.",
    "homepage": "https://www.grc.com/unpnp/unpnp.htm",
    "license": "Freeware",
    "url": "https://www.grc.com/files/unpnp.exe",
    "shortcuts": [
        [
            "unpnp.exe",
            "GRC UnPlug n' Pray"
        ]
    ],
    "notes": [
        "GRC does not publish a static SHA-256 checksum for this download. The manifest omits hash rather than inventing a value.",
        "Designed for Windows XP/ME-era UPnP issues. Do not use it to manage networking security on modern Windows."
    ],
    "checkver": {
        "script": [
            "$html = (Invoke-WebRequest -Uri 'https://www.grc.com/unpnp/unpnp.htm' -UseBasicParsing).Content",
            "$text = [System.Net.WebUtility]::HtmlDecode([regex]::Replace($html, '<[^>]+>', ' '))",
            "$text = [regex]::Replace($text, '\\s+', ' ')",
            "$match = [regex]::Match($text, '(?is)File stats for:.*?Last\\s+Updated:\\s*Size:\\s*[\\d.,]+\\s*[kKmM]?\\s+(?<date>[A-Za-z]{3}\\s+\\d{1,2},\\s+\\d{4})\\s+at\\b')",
            "if (-not $match.Success) { throw 'Unable to read the UnPlug n'' Pray last-updated date.' }",
            "[DateTime]::ParseExact($match.Groups['date'].Value, 'MMM d, yyyy', [Globalization.CultureInfo]::InvariantCulture).ToString('yyyy.MM.dd')"
        ],
        "regex": "(?<version>\\d{4}\\.\\d{2}\\.\\d{2})"
    },
    "autoupdate": {
        "url": "https://www.grc.com/files/unpnp.exe"
    }
}
