  },
  "installer": {
    "script": [
      "$exe = \"$dir\\\\$fname\"",
      "Start-Process -FilePath $exe -ArgumentList \"/S /D=$dir\" -Wait",
      "Remove-Item $exe"
    ]
  },
  "uninstaller": {
    "script": [
      "& \"$dir\\\\Uninstall Ioruba.exe\" /S"
    ]
  },
  "checkver": {
