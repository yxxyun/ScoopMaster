{
    "##": "electron-builder NSIS installer; silent install into $dir, removal via the bundled 'Uninstall AIRI.exe'.",
    "version": "0.14.1",
    "description": "AI 虚拟角色桌面伴侣（AIRI）",
    "homepage": "https://github.com/moeru-ai/airi",
    "license": {
        "identifier": "MIT",
        "url": "https://github.com/moeru-ai/airi/blob/main/LICENSE"
    },
    "notes": [
        "Windows 版只有 NSIS 安装器，静默装进 Scoop 目录",
        "卸载走安装器自带的 Uninstall AIRI.exe"
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/moeru-ai/airi/releases/download/v0.14.1/AIRI-0.14.1-windows-x64-setup.exe",
            "hash": "8605f58c7755da5e7a5a4402db9c025886775d3b2e4dbc5c45c77cc76d42fbdb"
        }
    },
    "installer": {
        "script": [
            "$installer = Join-Path $dir $fname",
            "Start-Process -FilePath $installer -ArgumentList '/S', \"/D=$dir\" -Wait",
            "Remove-Item $installer -Force"
        ]
    },
    "uninstaller": {
        "script": [
            "$c=@((Join-Path $dir 'Uninstall AIRI.exe'), (Join-Path $env:LOCALAPPDATA 'Programs\\AIRI\\Uninstall AIRI.exe'))",
            "foreach ($u in $c) { if (Test-Path -LiteralPath $u) { Start-Process -FilePath $u -ArgumentList '/S' -Wait; break } }"
        ]
    },
    "checkver": {
        "url": "https://github.com/moeru-ai/airi/releases.atom",
        "regex": "releases/tag/v([\\d.]+)\""
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/moeru-ai/airi/releases/download/v$version/AIRI-$version-windows-x64-setup.exe"
            }
        },
        "hash": {
            "url": "https://api.github.com/repos/moeru-ai/airi/releases/tags/v$version",
            "regex": "\"name\":\"AIRI-$version-windows-x64-setup\\.exe\".*?\"digest\":\"sha256:([0-9a-f]{64})\""
        }
    }
}
