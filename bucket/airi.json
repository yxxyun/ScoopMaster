{
    "$schema": "https://raw.githubusercontent.com/ScoopInstaller/Scoop/master/schema.json",
    "version": "0.12.0-beta.5",
    "description": "Self hosted, you-owned Grok Companion, a container of souls of waifu, cyber livings to bring them into our worlds, wishing to achieve Neuro-sama's altitude. Capable of realtime voice chat, Minecraft, Factorio playing. Web / macOS / Windows supported",
    "homepage": "https://github.com/moeru-ai/airi",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/moeru-ai/airi/releases/download/v0.12.0-beta.5/AIRI-0.12.0-beta.5-windows-x64-setup.exe#/dl.7z",
            "hash": "f64473fd54f905b5a5ec8d6d3c93277f0fc7a5368f53e0938b46d25a0d8a336b"
        }
    },
    "installer": {
        "script": [
            "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-64.7z\" \"$dir\"",
            "Remove-Item \"$dir\\`$*\", \"$dir\\Uninstall*\" -Recurse"
        ]
    },
    "shortcuts": [
        [
            "airi.exe",
            "AIRI"
        ]
    ],
    "checkver": {
        "github": "https://github.com/moeru-ai/airi",
        "regex": "v?([\\d.]+(?:-beta(?:\\.\\d+)?)?)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/moeru-ai/airi/releases/download/v$version/AIRI-$version-windows-x64-setup.exe#/dl.7z"
            }
        }
    }
}
