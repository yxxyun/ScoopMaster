{
    "version": "0.9.3",
    "description": "Open-source desktop video editor with multitrack editing, effects, captions, masking, color grading, and 3D clips.",
    "homepage": "https://cutwire.org/drift",
    "license": "GPL-3.0-only",
    "architecture": {
        "64bit": {
            "url": "https://github.com/CutWire-Studios/Drift/releases/download/v0.9.3/Drift-Portable-0.9.3-x64.zip",
            "hash": "4e34d9393f5206e47c7004301430c79016a3baf88c950823275e4febf654e9f3"
        }
    },
    "extract_dir": "Drift",
    "bin": "drift.exe",
    "shortcuts": [
        [
            "drift.exe",
            "Drift"
        ]
    ],
    "checkver": {
        "github": "https://github.com/CutWire-Studios/Drift",
        "regex": "v([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/CutWire-Studios/Drift/releases/download/v$version/Drift-Portable-$version-x64.zip",
                "hash": {
                    "url": "$baseurl/SHA256SUMS"
                }
            }
        }
    },
    "notes": "Settings, add-ons, models and caches are stored under %APPDATA%\\Drift, outside the Scoop app directory. Optional fonts, stickers, speech models and GPU/CPU acceleration runtimes are not bundled."
}
