{
    "version": "0.3.0",
    "description": "Floating Windows desktop notch with a customizable utility panel",
    "homepage": "https://github.com/Geguchh024/nook",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/Geguchh024/nook/releases/download/v0.3.0/Nook-Setup-0.3.0.exe",
            "hash": "80220e00e8708abb58d477812bc80674d7fb71b992a818c6e309c7a8983c22d5"
        }
    },
    "innosetup": true,
    "shortcuts": [
        [
            "nook.exe",
            "Nook"
        ]
    ],
    "notes": [
        "Nook registers the nook:// URL protocol under the current user's HKCU settings when it starts. Scoop removes this registration on uninstall only while it still points to this Scoop installation.",
        "Nook 0.3.0 is the final open-source release in this repository. The successor is branded Fenn; this manifest intentionally remains on the last Nook release."
    ],
    "pre_uninstall": [
        "$exe = Join-Path $dir 'nook.exe'",
        "$schemeKey = 'HKCU:\\Software\\Classes\\nook'",
        "$schemeCommandKey = Join-Path $schemeKey 'shell\\open\\command'",
        "$schemeCommand = if (Test-Path -LiteralPath $schemeCommandKey) { (Get-Item -LiteralPath $schemeCommandKey).GetValue('') }",
        "$expectedCommand = '\"' + $exe + '\" \"%1\"'",
        "if ($schemeCommand -and $schemeCommand -eq $expectedCommand) { Remove-Item -LiteralPath $schemeKey -Recurse -Force }",
        "$runKey = 'HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Run'",
        "$runValue = if (Test-Path -LiteralPath $runKey) { (Get-Item -LiteralPath $runKey).GetValue('Nook') }",
        "$expectedRunValue = '\"' + $exe + '\"'",
        "if ($runValue -and $runValue -eq $expectedRunValue) { Remove-ItemProperty -LiteralPath $runKey -Name 'Nook' -Force }"
    ],
    "checkver": {
        "url": "https://api.github.com/repos/Geguchh024/nook/releases/tags/v0.3.0",
        "jsonpath": "$.tag_name",
        "regex": "^v([\\d.]+)$"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/Geguchh024/nook/releases/download/v$version/Nook-Setup-$version.exe"
            }
        }
    }
}
