{
    "version": "202609082347",
    "description": "Enhanced ruleset for V2Ray (unofficial)",
    "homepage": "https://github.com/Loyalsoldier/v2ray-rules-dat",
    "license": "GPL-3.0-only",
    "depends": "v2ray",
    "url": "https://github.com/Loyalsoldier/v2ray-rules-dat/releases/download/202609082347/rules.zip",
    "hash": "ce9b4c8e46a7b874575635849c9a5d55abcfe4ad56dab39bfd1dfb133ca6e2d4",
    "installer": {
        "script": [
            "function LinkFile([String] $file, [String] $source = $file) {",
            "    Write-Host \"Creating SymbolicLink for $file\"",
            "    New-Item -Force -ItemType SymbolicLink -Path \"$(appdir v2ray $global)\\current\" -Name $file -Target \"$dir\\$source\" | Out-Null",
            "}",
            "LinkFile 'geoip.dat'",
            "LinkFile 'geosite.dat'"
        ]
    },
    "checkver": "github",
    "autoupdate": {
        "url": "https://github.com/Loyalsoldier/v2ray-rules-dat/releases/download/$version/rules.zip",
        "hash": {
            "url": "$url.sha256sum"
        }
    }
}
