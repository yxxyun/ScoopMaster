{
    "version": "26.09.3",
    "description": "Powerful and intelligent flash cards (latest available release, including prereleases)",
    "homepage": "https://apps.ankiweb.net",
    "license": "AGPL-3.0-only",
    "architecture": {
        "64bit": {
            "url": "https://github.com/ankitects/anki/releases/download/26.09.3/anki-26.09.3-win-x64.msi",
            "hash": "8a45823d1c31017cebb7d3af4493d69b6ae3c185345fcb2390ede4af01e0a950",
            "extract_dir": "PFiles64\\Anki"
        }
    },
    "bin": "anki.exe",
    "shortcuts": [
        [
            "anki.exe",
            "Anki Latest"
        ]
    ],
    "checkver": {
        "url": "https://api.github.com/repos/ankitects/anki/releases?per_page=100",
        "script": [
            "$latest = $null",
            "foreach ($release in ($page | ConvertFrom-Json)) {",
            "    if ($release.draft) { continue }",
            "    $tag = [string]$release.tag_name",
            "    if ($tag -notmatch '^(?<base>\\d+\\.\\d{2}(?:\\.\\d+)?)(?:(?<channel>a|b|rc)(?<seq>\\d+))?$') { continue }",
            "    $candidateVersion = $Matches['base']",
            "    $channel = $Matches['channel']",
            "    $sequence = $Matches['seq']",
            "    if ($channel) {",
            "        $label = @{ a = 'alpha'; b = 'beta'; rc = 'rc' }[$channel]",
            "        $candidateVersion = \"$candidateVersion-$label$sequence\"",
            "    }",
            "    $asset = @($release.assets | Where-Object { $_.name -ceq \"anki-$tag-win-x64.msi\" -and $_.state -eq 'uploaded' })",
            "    if ($asset.Count -ne 1) { continue }",
            "    if (!$latest -or (Compare-Version -ReferenceVersion $latest.version -DifferenceVersion $candidateVersion) -gt 0) {",
            "        $latest = [PSCustomObject]@{ version = $candidateVersion; tag = $tag }",
            "    }",
            "}",
            "if (!$latest) { throw 'No published Anki release with a Windows x64 MSI was found.' }",
            "\"$($latest.version)|$($latest.tag)\""
        ],
        "regex": "^(?<version>[^\\s|]+)\\|(?<tag>[^\\s|]+)$"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/ankitects/anki/releases/download/$matchTag/anki-$matchTag-win-x64.msi"
            }
        }
    },
    "##": "Based on ScoopInstaller/Extras anki; latest Windows x64 release includes alpha, beta and RC builds."
}
