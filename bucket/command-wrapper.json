{
    "$schema": "https://raw.githubusercontent.com/ScoopInstaller/Scoop/master/schema.json",
    "version": "1.0.0",
    "description": "Run the first available command from a candidate list; --workdir sets the working dir (resolved against the script's dir)",
    "homepage": "https://github.com/gdm257/scoop-257",
    "license": "Unlicense",
    "url": ["https://unlicense.org/UNLICENSE"],
    "installer": {
        "script": [
            "Copy-Item -Path (Join-Path $bucketsdir $bucket 'scripts\\command-wrapper\\command-wrapper.cmd') -Destination (Join-Path $dir 'command-wrapper.cmd') -Force",
            "Copy-Item -Path (Join-Path $bucketsdir $bucket 'scripts\\command-wrapper\\command-wrapper.ps1') -Destination (Join-Path $dir 'command-wrapper.ps1') -Force",
            "Copy-Item -Path (Join-Path $bucketsdir $bucket 'scripts\\command-wrapper\\command-wrapper.vbs') -Destination (Join-Path $dir 'command-wrapper.vbs') -Force"
        ]
    },
    "bin": [
        ["command-wrapper.cmd", "command-wrapper"],
        ["command-wrapper.cmd", "command-wrapper-cmd"],
        ["command-wrapper.ps1", "command-wrapper-ps1"],
        ["command-wrapper.vbs", "command-wrapper-vbs"]
    ]
}
