{
    "version": "1.0.12.0",
    "description": "SnowDesktop is a Windows desktop organization and personalization app built around components.",
    "homepage": "https://snowdesktop.com",
    "license": "AGPL-3.0-only",
    "architecture": {
        "64bit": {
            "url": "https://github.com/FreeFallingSnow/SnowDesktop/releases/download/v1.0.12.0/SnowDesktop-portable-x64-1.0.12.0.zip",
            "hash": "f6c1fd538ea8c7128110911f938688cb5a89a63f5f9f309e44b9e9ff3a3cebf2"
        }
    },
    "bin": [
        [
            "SnowDesktop.exe",
            "SnowDesktop"
        ]
    ],
    "shortcuts": [
        [
            "SnowDesktop.exe",
            "SnowDesktop"
        ]
    ],
    "persist": "data",
    "pre_uninstall": [
        "$tasks = Get-ScheduledTask -TaskPath '\\SnowDesktop\\' -ErrorAction SilentlyContinue",
        "if ($tasks) { $tasks | Unregister-ScheduledTask -Confirm:$false -ErrorAction SilentlyContinue }",
        "if (Get-ScheduledTask -TaskPath '\\SnowDesktop\\' -ErrorAction SilentlyContinue) { throw 'SnowDesktop scheduled task still exists. Run this in an Administrator PowerShell, then retry: Get-ScheduledTask -TaskPath ''\\SnowDesktop\\'' | Unregister-ScheduledTask -Confirm:$false' }",
        "Get-Process -Name 'SnowDesktop*','SnowDesktopWallpaperInjector*' -ErrorAction SilentlyContinue | Stop-Process -Force -ErrorAction SilentlyContinue",
        "Start-Sleep -Milliseconds 1000",
        "Get-Process -Name 'SnowDesktop*','SnowDesktopWallpaperInjector*' -ErrorAction SilentlyContinue | Stop-Process -Force -ErrorAction SilentlyContinue"
    ],
    "post_uninstall": [
        "Remove-Item \"$env:APPDATA\\Microsoft\\Windows\\Start Menu\\Programs\\SnowDesktop.lnk\" -Force -ErrorAction SilentlyContinue",
        "$answer = Read-Host 'SnowDesktop injected ShellHook DLLs into explorer.exe. Restart explorer now to release locked files? (Y/N)'",
        "if ($answer -match '^[Yy]$') { Write-Host 'Restarting explorer...'; Stop-Process -Name explorer -Force -ErrorAction SilentlyContinue; Start-Sleep -Seconds 3 }"
    ],
    "checkver": {
        "github": "https://api.github.com/repos/FreeFallingSnow/SnowDesktop/releases/latest",
        "jsonpath": "$.assets[*].name",
        "regex": "SnowDesktop-portable-x64-([\\d.]+)\\.zip"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/FreeFallingSnow/SnowDesktop/releases/download/v$version/SnowDesktop-portable-x64-$version.zip"
            }
        }
    }
}
