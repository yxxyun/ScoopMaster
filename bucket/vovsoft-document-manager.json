{
    "version": "2.0",
    "description": "Portable edition of Vovsoft Document Manager.",
    "homepage": "https://vovsoft.com/software/document-manager/",
    "license": "Proprietary",
    "url": "https://vovsoft.com/files/document-manager-portable.zip?v=2.0",
    "checkver": {
        "url": "https://vovsoft.com/download/document-manager-portable/",
        "regex": "(?is)Version\\s*(?:<[^>]*>\\s*)*:?\\s*(?:<[^>]*>\\s*)*(?<version>\\d+(?:\\.\\d+)+)"
    },
    "autoupdate": {
        "url": "https://vovsoft.com/files/document-manager-portable.zip?v=$version"
    },
    "shortcuts": [
        [
            "dmanager.exe",
            "Vovsoft Document Manager"
        ]
    ],
    "pre_install": [
        "if (-not (Test-Path -LiteralPath \"$dir\\key.txt\" -PathType Leaf)) { New-Item -ItemType File -Path \"$dir\\key.txt\" | Out-Null }"
    ],
    "persist": "key.txt"
}
