{
    "version": "6.18.48",
    "description": "Rolling Release LTS Kernel Addon Packages (Modules, Headers, Docs) for Windows Subsystem for Linux2 (WSL2)",
    "homepage": "https://github.com/Nevuly/WSL2-Linux-Kernel-Rolling-LTS",
    "license": "GPL-2.0",
    "notes": "This kernel addon package require WSL v2.5.1 or later",
    "architecture": {
        "64bit": {
            "url": "https://github.com/Nevuly/WSL2-Linux-Kernel-Rolling-LTS/releases/download/linux-wsl-lts-6.18.48/bzImage-x86_64-addon.vhdx.7z",
            "hash": "eac96c2ab2fb672bc77f8044277d1aabd9f9338310c2d95e1b73c46a6e660e3b",
            "post_install": [
                ". $bucketsdir\\$bucket\\scripts\\SetVhdxAcl.ps1",
                "$kernel_addon_file = \"$original_dir\\bzImage-x86_64-addon.vhdx\"",
                "SetVhdxAcl -Path $kernel_addon_file",
                ". $bucketsdir\\$bucket\\scripts\\IniFile.ps1",
                "$kernel_addon_path = $kernel_addon_file -replace \"\\\\\", \"\\\\\"",
                "$null = [IniFile]::WritePrivateProfileString(\"wsl2\", \"kernelModules\", $kernel_addon_path, \"$env:USERPROFILE\\.wslconfig\")"
            ],
            "post_uninstall": [
                ". $bucketsdir\\$($install.bucket)\\scripts\\IniFile.ps1",
                "$null = [IniFile]::WritePrivateProfileString(\"wsl2\", \"kernelModules\", $null, \"$env:USERPROFILE\\.wslconfig\")"
            ]
        },
        "arm64": {
            "url": "https://github.com/Nevuly/WSL2-Linux-Kernel-Rolling-LTS/releases/download/linux-wsl-lts-6.18.48/Image-arm64-addon.vhdx.7z",
            "hash": "8fa26dace7aa5ac2a181e7287b23e71189f6939173155d5dcb137a32568c55ad",
            "post_install": [
                ". $bucketsdir\\$bucket\\scripts\\SetVhdxAcl.ps1",
                "$kernel_addon_file = \"$original_dir\\Image-arm64-addon.vhdx\"",
                "SetVhdxAcl -Path $kernel_addon_file",
                ". $bucketsdir\\$bucket\\scripts\\IniFile.ps1",
                "$kernel_addon_path = $kernel_addon_file -replace \"\\\\\", \"\\\\\"",
                "$null = [IniFile]::WritePrivateProfileString(\"wsl2\", \"kernelModules\", $kernel_addon_path, \"$env:USERPROFILE\\.wslconfig\")"
            ],
            "post_uninstall": [
                ". $bucketsdir\\$($install.bucket)\\scripts\\IniFile.ps1",
                "$null = [IniFile]::WritePrivateProfileString(\"wsl2\", \"kernelModules\", $null, \"$env:USERPROFILE\\.wslconfig\")"
            ]
        }
    },
    "checkver": {
        "url": "https://github.com/Nevuly/WSL2-Linux-Kernel-Rolling-LTS/releases/latest",
        "regex": "linux-wsl-lts-([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/Nevuly/WSL2-Linux-Kernel-Rolling-LTS/releases/download/linux-wsl-lts-$version/bzImage-x86_64-addon.vhdx.7z"
            },
            "arm64": {
                "url": "https://github.com/Nevuly/WSL2-Linux-Kernel-Rolling-LTS/releases/download/linux-wsl-lts-$version/Image-arm64-addon.vhdx.7z"
            }
        }
    }
}
