{
    "version": "2020.12.24",
    "description": "GRC ReadSpeed: Creates a bootable DOS USB device to run GRC's precise mass-storage read-performance benchmark.",
    "homepage": "https://www.grc.com/readspeed.htm",
    "license": "Freeware",
    "url": "https://www.grc.com/files/readspeed.exe",
    "shortcuts": [
        [
            "readspeed.exe",
            "GRC ReadSpeed"
        ]
    ],
    "notes": [
        "GRC does not publish a static SHA-256 checksum for this download. The manifest omits hash rather than inventing a value.",
        "It prepares and reformats the selected USB drive. Back up its contents before use; all existing data on the target drive can be erased."
    ],
    "checkver": {
        "script": [
            "$html = (Invoke-WebRequest -Uri 'https://www.grc.com/readspeed.htm' -UseBasicParsing).Content",
            "$text = [System.Net.WebUtility]::HtmlDecode([regex]::Replace($html, '<[^>]+>', ' '))",
            "$text = [regex]::Replace($text, '\\s+', ' ')",
            "$match = [regex]::Match($text, '(?is)File stats for:\\s*ReadSpeed.{0,1800}?Last\\s+Updated:\\s*Size:\\s*[\\d.,]+\\s*[kKmM]?\\s+(?<date>[A-Za-z]{3}\\s+\\d{1,2},\\s+\\d{4})\\s+at\\b')",
            "if (-not $match.Success) { throw 'Unable to read the published Last Updated date for ReadSpeed.' }",
            "[DateTime]::ParseExact($match.Groups['date'].Value, 'MMM d, yyyy', [Globalization.CultureInfo]::InvariantCulture).ToString('yyyy.MM.dd')"
        ],
        "regex": "(?<version>\\d{4}\\.\\d{2}\\.\\d{2})"
    },
    "autoupdate": {
        "url": "https://www.grc.com/files/readspeed.exe"
    }
}
