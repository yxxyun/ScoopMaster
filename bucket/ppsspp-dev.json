    "checkver": {
        "url": "https://builds.ppsspp.org/meta/history-20.json",
        "regex": "^v(?<version>\\d+(?:\\.\\d+)+-\\d+)-(?<build>g[0-9a-f]+)$",
        "script": [
            "if ($page -notmatch '^\\s*\\[') { return }",
            "try { $builds = ConvertFrom-Json -InputObject $page -ErrorAction Stop } catch { return }",
            "foreach ($entry in $builds) {",
            "    if ($entry.description -cnotmatch '^v\\d+(?:\\.\\d+)+-\\d+-g[0-9a-f]+$') { continue }",
            "    $tag = $entry.description",
            "    if ($entry.builds.Windows -ccontains \"ppsspp_win_$tag.zip\" -and",
            "        $entry.builds.WindowsARM64 -ccontains \"PPSSPPWindowsARM64_$tag.zip\") { return $tag }",
            "}"
        ]
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://builds.ppsspp.org/builds/v$version-$matchBuild/ppsspp_win_v$version-$matchBuild.zip"
            },
            "32bit": {
                "url": "https://builds.ppsspp.org/builds/v$version-$matchBuild/ppsspp_win_v$version-$matchBuild.zip"
            },
            "arm64": {
                "url": "https://builds.ppsspp.org/builds/v$version-$matchBuild/PPSSPPWindowsARM64_v$version-$matchBuild.zip"
            }
        }
    }
