{
    "version": "1.0.0",
    "description": "Add a manually downloaded installer to the Scoop cache, for manifests whose download is blocked (e.g. by Cloudflare). Adds the 'scoop cache-import' command",
    "homepage": "https://github.com/warthurton/scoop-ntwind",
    "license": "Unlicense",
    "url": "https://raw.githubusercontent.com/warthurton/scoop-ntwind/master/bin/cache-import.ps1",
    "hash": "a0457d83b1c98367e26068f0f1fad20c42879e51c01027441dd618e7009c6f12",
    "bin": [
        [
            "cache-import.ps1",
            "scoop-cache-import"
        ]
    ],
    "checkver": {
        "url": "https://raw.githubusercontent.com/warthurton/scoop-ntwind/master/bin/cache-import.ps1",
        "regex": "\\.VERSION\\s+([\\d.]+)"
    },
    "autoupdate": {
        "url": "https://raw.githubusercontent.com/warthurton/scoop-ntwind/master/bin/cache-import.ps1"
    }
}
