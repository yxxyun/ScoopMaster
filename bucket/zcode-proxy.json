{
    "version": "4.8.8",
    "description": "A reverse proxy-ish that delegates your requests to bigmodel.cn or z.ai, using the same oauth login process like zcode did.",
    "homepage": "https://github.com/TriDefender/zcode-api",
    "license": "Unknown",
    "architecture": {
        "64bit": {
            "url": "https://github.com/TriDefender/zcode-api/releases/download/v4.8.8/zcode-proxy.exe",
            "hash": "15c8f11584674501bf455c2f844a5caccdef995de4558808657ac25cb74ec5e4"
        }
    },
    "bin": "zcode-proxy.exe",
    "pre_install": [
        "if (!(Test-Path \"$dir/config.yaml\")) { New-Item \"$dir/config.yaml\" | Out-Null }"
    ],
    "env_set": {
        "ZCODE_PROXY_CONFIG": "$dir\\config.yaml"
    },
    "persist": "config.yaml",
    "checkver": {
        "url": "https://api.github.com/repos/TriDefender/zcode-api/releases",
        "jsonpath": "$..tag_name",
        "regex": "v([\\d.]+)$"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/TriDefender/zcode-api/releases/download/v$version/zcode-proxy.exe"
            }
        }
    }
}
