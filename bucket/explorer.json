    "pre_install": "if (!(Test-Path \"$dir\\file-explorer.exe\") -and (Test-Path \"$dir\\explorer.exe\")) { Rename-Item \"$dir\\explorer.exe\" 'file-explorer.exe' }",
    "post_install": "if ([version]$Manifest.version -ge [version]'0.23.0' -and (Test-Path \"$dir\\file-explorer.exe\")) { & \"$dir\\file-explorer.exe\" --register-file-associations }",
