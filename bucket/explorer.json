{
    "version": "0.20.0",
    "description": "Windows File Explorer for macOS, Linux, and Windows.",
    "homepage": "https://github.com/hmerritt/explorer",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/hmerritt/explorer/releases/download/0.20.0/explorer-0.20.0-windows-amd64.zip",
            "hash": "f5f2a9488b9013a12c94ad92d3873bf819ed6cdc625af95c2ef1c2b7d29f79ee"
        }
    },
    "pre_install": "if (!(Test-Path \"$dir\\file-explorer.exe\") -and (Test-Path \"$dir\\explorer.exe\")) { Rename-Item \"$dir\\explorer.exe\" 'file-explorer.exe' }",
    "post_install": "if ([version]$Manifest.version -ge [version]'0.20.0' -and (Test-Path \"$dir\\file-explorer.exe\")) { & \"$dir\\file-explorer.exe\" --register-file-associations }",
    "pre_uninstall": "if ([version]$Manifest.version -ge [version]'0.20.0' -and (Test-Path \"$dir\\file-explorer.exe\")) { & \"$dir\\file-explorer.exe\" --unregister-file-associations }",
    "bin": [["file-explorer.exe", "explorer"]],
    "shortcuts": [["file-explorer.exe", "Explorer"]]
}
