{
    "version": "0.22.1",
    "description": "Manim Community Edition: engine for programmatic math animations",
    "homepage": "https://www.manim.community/",
    "license": "MIT",
    "url": "https://raw.githubusercontent.com/ManimCommunity/manim/v0.22.1/LICENSE",
    "hash": "c6a922fc1cfaed7ac0f87aa1dc77ebf5a3c8d1ccc5ab01da33153f0d013bf019",
    "depends": ["uv", "ffmpeg"],
    "suggest": {
        "LaTeX (needed for Tex/MathTex)": "miktex"
    },
    "installer": {
        "script": [
            "uv venv \"$dir\\venv\" --python 3.12",
            "uv pip install --python \"$dir\\venv\\Scripts\\python.exe\" manim==$version"
        ]
    },
    "bin": [
        ["venv\\Scripts\\manim.exe", "manim"]
    ],
    "checkver": {
        "url": "https://pypi.org/pypi/manim/json",
        "jsonpath": "$.info.version"
    },
    "autoupdate": {
        "url": "https://raw.githubusercontent.com/ManimCommunity/manim/v$version/LICENSE"
    }
}
