{
    "version": "1.1",
    "description": "Portable edition of Vovsoft Image to Cartoon Converter.",
    "homepage": "https://vovsoft.com/software/image-to-cartoon-converter/",
    "license": "Proprietary",
    "url": "https://vovsoft.com/files/image-to-cartoon-converter-portable.zip?v=1.1",
    "checkver": {
        "url": "https://vovsoft.com/download/image-to-cartoon-converter-portable/",
        "regex": "(?is)Version\\s*(?:<[^>]*>\\s*)*:?\\s*(?:<[^>]*>\\s*)*(?<version>\\d+(?:\\.\\d+)+)"
    },
    "autoupdate": {
        "url": "https://vovsoft.com/files/image-to-cartoon-converter-portable.zip?v=$version"
    },
    "shortcuts": [
        [
            "image2cartoon.exe",
            "Vovsoft Image to Cartoon Converter"
        ]
    ],
    "pre_install": [
        "if (-not (Test-Path -LiteralPath \"$dir\\key.txt\" -PathType Leaf)) { New-Item -ItemType File -Path \"$dir\\key.txt\" | Out-Null }"
    ],
    "persist": "key.txt"
}

