{
    "version": "1.5",
    "description": "Portable edition of Vovsoft Screen Reader.",
    "homepage": "https://vovsoft.com/software/screen-reader/",
    "license": "Proprietary",
    "url": "https://vovsoft.com/files/screen-reader-portable.zip?v=1.5",
    "checkver": {
        "url": "https://vovsoft.com/download/screen-reader-portable/",
        "regex": "(?is)Version\\s*(?:<[^>]*>\\s*)*:?\\s*(?:<[^>]*>\\s*)*(?<version>\\d+(?:\\.\\d+)+)"
    },
    "autoupdate": {
        "url": "https://vovsoft.com/files/screen-reader-portable.zip?v=$version"
    },
    "shortcuts": [
        [
            "screenreader.exe",
            "Vovsoft Screen Reader"
        ]
    ],
    "notes": [
        "SHA-256 has not been verified; archive contents and the shortcut target have been checked."
    ],
    "pre_install": [
        "if (-not (Test-Path -LiteralPath \"$dir\\key.txt\" -PathType Leaf)) { New-Item -ItemType File -Path \"$dir\\key.txt\" | Out-Null }"
    ],
    "persist": "key.txt"
}
