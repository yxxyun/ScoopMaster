            "New-Item $env:APPDATA\\Astrarium -ItemType Junction -Target \"$persist_dir\" | Out-Null"
        ]
    },
    "shortcuts": [
        [
            "Astrarium.exe",
            "Astrarium"
        ]
    ],
    "uninstaller": {
