{
    "version": "0.27.0",
    "description": "The Nanyx programming language: compiles .nyx files to WebAssembly and runs them on an embedded Wasmtime engine",
    "homepage": "https://github.com/nanyx-lang/nanyx",
    "license": "Unknown",
    "architecture": {
        "64bit": {
            "url": "https://github.com/nanyx-lang/nanyx/releases/download/compiler/0.27.0/nanyx-0.27.0-win-x64.zip",
            "hash": "01a3301523b1ec762a96cd3c9df1fa3bc057ff5e70194f9ac40f7bc0b6dc84dd"
        }
    },
    "bin": "nanyx.exe",
    "checkver": {
        "script": [
            "$headers = @{ 'User-Agent' = 'scoop-nanyx' }",
            "if ($env:GITHUB_TOKEN) { $headers.Authorization = \"Bearer $env:GITHUB_TOKEN\" }",
            "$releases = Invoke-RestMethod -Headers $headers -Uri 'https://api.github.com/repos/nanyx-lang/nanyx/releases?per_page=100'",
            "$versions = $releases | Where-Object { -not $_.draft -and -not $_.prerelease } | ForEach-Object { if ($_.tag_name -match '^compiler/(\\d+(?:\\.\\d+)+)$') { [version]$Matches[1] } }",
            "$latest = $versions | Sort-Object -Descending | Select-Object -First 1",
            "if ($latest) { \"compiler/$latest\" }"
        ],
        "regex": "compiler/([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/nanyx-lang/nanyx/releases/download/compiler/$version/nanyx-$version-win-x64.zip"
            }
        }
    }
}
