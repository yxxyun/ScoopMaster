{
    "version": "1.1.0",
    "description": "System-tray launcher for managing and running Windows batch scripts.",
    "homepage": "https://github.com/Jayich-Lab/tray-launcher",
    "license": "MIT",
    "depends": [
        "python"
    ],
    "url": "https://github.com/Jayich-Lab/tray-launcher/archive/refs/tags/v1.1.0.zip",
    "bin": "venv\\Scripts\\launcher.exe",
    "shortcuts": [
        [
            "venv\\Scripts\\launcher.exe",
            "Tray Launcher",
            "run"
        ]
    ],
    "checkver": {
        "url": "https://api.github.com/repos/Jayich-Lab/tray-launcher/releases/latest",
        "jsonpath": "$.tag_name",
        "regex": "^v([\\d.]+)$"
    },
    "autoupdate": {
        "url": "https://github.com/Jayich-Lab/tray-launcher/archive/refs/tags/v$version.zip"
    },
    "pre_install": [
        "$source = Get-ChildItem -LiteralPath $dir -Filter 'pyproject.toml' -Recurse -File | Select-Object -First 1 -ExpandProperty DirectoryName",
        "if (-not $source) { throw 'Could not find the tray-launcher source directory.' }",
        "$venv = Join-Path $dir 'venv'",
        "& python -m venv $venv",
        "if ($LASTEXITCODE -ne 0) { throw 'Failed to create the Python virtual environment.' }",
        "$venvPython = Join-Path $venv 'Scripts\\python.exe'",
        "& $venvPython -m pip install --disable-pip-version-check --no-cache-dir $source",
        "if ($LASTEXITCODE -ne 0) { throw 'Failed to install tray-launcher and its Python dependencies.' }"
    ],
    "hash": "e2361626d9775b0f01c49396cb1f02f565142bd96070292cc782f3ee1ddfd735"
}
