{
    "version": "0.2.1",
    "description": "Lightweight Windows WhatsApp Web client with a system tray, notifications, and persistent sessions.",
    "homepage": "https://github.com/Casellus/LiteChat",
    "license": "MIT",
    "url": "https://github.com/Casellus/LiteChat/releases/download/v0.2.1/LiteChat-v0.2.1-windows-x64.zip",
    "hash": "adffb884836a47dcabf23b5be419d976b17ff7d522a3f1134adfd3f5f958a54a",
    "persist": "profile",
    "post_install": [
        "$ErrorActionPreference = 'Stop'",
        "$appDataPath = Join-Path $env:LOCALAPPDATA 'LiteChat'",
        "$legacyPath = Join-Path $env:LOCALAPPDATA 'Talkapp'",
        "$persistProfilePath = Join-Path $persist_dir 'profile'",
        "New-Item -ItemType Directory -Path $persistProfilePath -Force | Out-Null",
        "if (-not (Test-Path -LiteralPath $appDataPath) -and (Test-Path -LiteralPath $legacyPath)) {",
        "    $legacyItems = @(Get-ChildItem -LiteralPath $legacyPath -Force)",
        "    $persistItems = @(Get-ChildItem -LiteralPath $persistProfilePath -Force)",
        "    if ($legacyItems.Count -gt 0 -and $persistItems.Count -gt 0) {",
        "        throw ('Both the legacy Talkapp profile and ' + $persistProfilePath + ' contain data; refusing to overwrite either location.')",
        "    }",
        "    if ($legacyItems.Count -gt 0) { $legacyItems | Move-Item -Destination $persistProfilePath }",
        "    Remove-Item -LiteralPath $legacyPath -Force",
        "}",
        "$existing = Get-Item -LiteralPath $appDataPath -Force -ErrorAction SilentlyContinue",
        "$alreadyLinked = $false",
        "if ($null -ne $existing) {",
        "    if (($existing.Attributes -band [IO.FileAttributes]::ReparsePoint) -ne 0) {",
        "        if ($existing.LinkType -eq 'Junction' -and [IO.Path]::GetFullPath([string]$existing.Target) -ieq [IO.Path]::GetFullPath($persistProfilePath)) {",
        "            $alreadyLinked = $true",
        "        } else {",
        "            throw ('Refusing to replace an unexpected reparse point at ' + $appDataPath)",
        "        }",
        "    } else {",
        "        $appItems = @(Get-ChildItem -LiteralPath $appDataPath -Force)",
        "        $persistItems = @(Get-ChildItem -LiteralPath $persistProfilePath -Force)",
        "        if ($appItems.Count -gt 0 -and $persistItems.Count -gt 0) {",
        "            throw ('Both ' + $appDataPath + ' and ' + $persistProfilePath + ' contain data; refusing to overwrite either location.')",
        "        }",
        "        if ($appItems.Count -gt 0) { $appItems | Move-Item -Destination $persistProfilePath }",
        "        Remove-Item -LiteralPath $appDataPath -Force",
        "    }",
        "}",
        "if (-not $alreadyLinked) { New-Item -ItemType Junction -Path $appDataPath -Target $persistProfilePath | Out-Null }"
    ],
    "pre_uninstall": [
        "$appDataPath = Join-Path $env:LOCALAPPDATA 'LiteChat'",
        "$persistProfilePath = Join-Path $persist_dir 'profile'",
        "$existing = Get-Item -LiteralPath $appDataPath -Force -ErrorAction SilentlyContinue",
        "if ($null -ne $existing -and",
        "    ($existing.Attributes -band [IO.FileAttributes]::ReparsePoint) -ne 0 -and",
        "    $existing.LinkType -eq 'Junction' -and",
        "    [IO.Path]::GetFullPath([string]$existing.Target) -ieq [IO.Path]::GetFullPath($persistProfilePath)) {",
        "    $removeCommand = 'rmdir \"' + $appDataPath + '\"'",
        "    & $env:ComSpec /d /c $removeCommand",
        "    if ($LASTEXITCODE -ne 0) { throw ('Failed to remove the LiteChat LocalAppData junction; cmd exit code: ' + $LASTEXITCODE) }",
        "}"
    ],
    "shortcuts": [
        [
            "litechat.exe",
            "LiteChat"
        ]
    ],
    "checkver": {
        "url": "https://api.github.com/repos/Casellus/LiteChat/releases/latest",
        "jsonpath": "$.tag_name",
        "regex": "^v(?<version>[\\d.]+)$"
    },
    "autoupdate": {
        "url": "https://github.com/Casellus/LiteChat/releases/download/v$version/LiteChat-v$version-windows-x64.zip",
        "hash": {
            "url": "https://api.github.com/repos/Casellus/LiteChat/releases/tags/v$version",
            "jsonpath": "$.assets[?(@.name == 'LiteChat-v$version-windows-x64.zip')].digest"
        }
    },
    "notes": [
        "Extracts the official ZIP directly; LiteChat's install.ps1 is intentionally not run because it copies files outside the Scoop directory.",
        "The WebView2 session and local profile under %LOCALAPPDATA%\\LiteChat are redirected to Scoop persist; an older %LOCALAPPDATA%\\Talkapp profile is migrated without overwriting existing data.",
        "Windows 11 includes WebView2 Runtime. Windows 10 requires Microsoft Edge WebView2 Runtime."
    ]
}
