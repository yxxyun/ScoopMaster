    "installer": {
        "script": [
            "Set-StrictMode -Version Latest",
            "$ErrorActionPreference = 'Stop'",
            "$files = @{",
            "    'w64-libl.dll' = 'w64\\libl.dll'",
            "    'w64-yong-config.exe' = 'w64\\yong-config.exe'",
            "    'w64-libcloud.so' = 'w64\\libcloud.so'",
            "    'w64-yong-vim.exe' = 'w64\\yong-vim.exe'",
            "    'w64-libmb.so' = 'w64\\libmb.so'",
            "    'w64-libgbk.so' = 'w64\\libgbk.so'",
            "    'w64-yong.exe' = 'w64\\yong.exe'",
            "    'tsf-uninstall.bat' = 'tsf\\uninstall.bat'",
            "    'tsf-tsf-reg64.exe' = 'tsf\\tsf-reg64.exe'",
            "    'tsf-install.bat' = 'tsf\\install.bat'",
            "    'tsf-tsf-reg.exe' = 'tsf\\tsf-reg.exe'",
            "    'tsf-yong64.dll' = 'tsf\\yong64.dll'",
            "    'tsf-yong.dll' = 'tsf\\yong.dll'",
            "    'mb-yong.txt' = 'mb\\yong.txt'",
            "    'mb-pypre.bin' = 'mb\\pypre.bin'",
            "    'mb-pinyin.txt' = 'mb\\pinyin.txt'",
            "    'libl.dll' = 'libl.dll'",
            "    'yong-config.exe' = 'yong-config.exe'",
            "    'libcloud.so' = 'libcloud.so'",
            "    'yong.chm' = 'yong.chm'",
            "    'bihua.bin' = 'bihua.bin'",
            "    'yong-vim.exe' = 'yong-vim.exe'",
            "    'libmb.so' = 'libmb.so'",
            "    'yong.exe' = 'yong.exe'",
            "    'libgbk.so' = 'libgbk.so'",
            "}",
            "foreach ($file in $files.GetEnumerator()) {",
            "    $target = Join-Path $dir $file.Value",
            "    $parent = Split-Path $target -Parent",
            "    New-Item -ItemType Directory -Force -Path $parent | Out-Null",
            "    Move-Item -Force (Join-Path $dir $file.Key) $target",
            "}"
        ]
    },
    "bin": "w64\\yong.exe",
    "persist": ".yong",
    "checkver": {
        "url": "https://yong.dgod.net/sync/update.php?latest=1",
        "regex": "(?m)^(\\d{4})年(\\d{1,2})月(\\d{1,2})日",
        "replace": "$1.$2.$3"
    },
    "##": [
        "Windows package currently mirrors every entry in https://yong.dgod.net/sync/yong-win.xml.",
        "Files are downloaded individually and verified with the MD5 values from yong-win.xml, then moved into their original paths."
    ]
