    "hash": "d365c3102dd4330e92cf8675f8694985d64d3b108b698b7efe92d18c128fbeb4",
    "post_install": [
        "Rename-Item \"$dir\\`$_22_\" \"$dir\\$version\"",
        "Remove-Item \"$dir\\$*\" -Recurse -Force -ErrorAction SilentlyContinue",
        "Remove-Item \"$dir\\wemeetapp_new.exe\" -Force -ErrorAction SilentlyContinue",
        "if (-NOT (Test-Path \"$persist_dir\\data\\WeMeet\")) {",
        "    New-Item -ItemType Directory -Path \"$persist_dir\\data\\WeMeet\" -Force | Out-Null",
        "}",
        "if (-NOT (Test-Path \"$env:APPDATA\\Tencent\\WeMeet\")) {",
        "    New-Item -ItemType Junction -Path \"$env:APPDATA\\Tencent\\WeMeet\" -Target \"$persist_dir\\data\\WeMeet\" | Out-Null",
        "} else {",
        "    $existing = Get-Item \"$env:APPDATA\\Tencent\\WeMeet\" -Force",
        "    if (-NOT ($existing.Attributes -band [IO.FileAttributes]::ReparsePoint)) {",
        "        Copy-Item \"$env:APPDATA\\Tencent\\WeMeet\\*\" \"$persist_dir\\data\\WeMeet\" -Recurse -Force -ErrorAction SilentlyContinue",
        "        Remove-Item \"$env:APPDATA\\Tencent\\WeMeet\" -Recurse -Force -ErrorAction SilentlyContinue",
        "        New-Item -ItemType Junction -Path \"$env:APPDATA\\Tencent\\WeMeet\" -Target \"$persist_dir\\data\\WeMeet\" | Out-Null",
        "    }",
        "}"
    ],
    "post_uninstall": [
        "if(Test-Path \"$env:APPDATA\\Tencent\\WeMeet\") {",
        "    Remove-Item \"$env:APPDATA\\Tencent\\WeMeet\" -Force",
        "}"
    ],
