    "pre_install": [
        "$setup = (Get-Item \"$dir\\*win-x64-setup.exe\").FullName",
        "Expand-7zipArchive -Path $setup -DestinationPath \"$dir\" -Removal",
        "Move-Item \"$dir\\`$PLUGINSDIR\\app-64.7z\" \"$dir\"",
        "Remove-Item \"$dir\\`$PLUGINSDIR\" -Recurse -Force"
    ],
    "post_install": [
        "Expand-7zipArchive -Path \"$dir\\app-64.7z\" -DestinationPath \"$dir\" -Removal",
        "Remove-Item \"$dir\\Uninstall PilotDeck.exe\", \"$dir\\uninstallerIcon.ico\" -Force -ErrorAction SilentlyContinue"
    ],
    "bin": "PilotDeck.exe",
    "shortcuts": [
        [
            "PilotDeck.exe",
            "PilotDeck"
        ]
    ],
    "checkver": {
        "url": "https://api.github.com/repos/OpenBMB/PilotDeck/releases/latest",
        "regex": "\"tag_name\":\\s*\"v([\\d.]+)\"[\\s\\S]*?PilotDeck-([\\d.]+)-win-x64-setup\\.exe"
    },
    "autoupdate": {
        "url": "https://github.com/OpenBMB/PilotDeck/releases/download/v$match1/PilotDeck-$match2-win-x64-setup.exe",
        "hash": {
            "url": "https://github.com/OpenBMB/PilotDeck/releases/download/v$match1/SHA256SUMS.txt",
            "regex": "([a-fA-F0-9]{64})\\s+PilotDeck-$match2-win-x64-setup\\.exe"
        }
    },
    "notes": "NSIS installer with two-layer packaging: an NSIS wrapper containing app-64.7z (~436 MB) with the full portable app. pre_install extracts the NSIS package via Expand-7zipArchive and pulls out app-64.7z; post_install extracts it into $dir. User data lives in %USERPROFILE%\\.pilotdeck (outside the app directory), so no persist is needed. Requires the 7-Zip helper (scoop install 7zip)."
}
