{
    "version": "1.1.0",
    "description": "Task Manager by retired Microsoft engineer Dave Plummer",
    "homepage": "https://www.tmog.org",
    "license": "Proprietary",
    "notes": [
        "Settings are stored in '$persist_dir\\Task Manager' and linked from '%LOCALAPPDATA%\\TMOG\\Task Manager'.",
        "The built-in 'Replace Windows Task Manager' option only works from an all-users install in Program Files.",
        "To set it for this install run: & '$dir\\replace-taskmgr.ps1'",
        "To undo it run: & '$dir\\replace-taskmgr.ps1' -Disable"
    ],
    "architecture": {
        "64bit": {
            "url": "https://www.tmog.org/rtm/downloads/TMOG-Task-Manager-Setup-1.1.0-0-x64-3936d8d1d870.exe",
            "hash": "3936d8d1d870f86d5e204fe139e056a6a0ad398e8e1e53bb0ef876cdc0e3dac6"
        },
        "arm64": {
            "url": "https://www.tmog.org/rtm/downloads/TMOG-Task-Manager-Setup-1.1.0-0-arm64-01408820f65f.exe",
            "hash": "01408820f65f0f67290a1088fc32924c55f0c345675f35c3028033f046104036"
        }
    },
    "innosetup": true,
    "bin": [
        [
            "Task Manager.exe",
            "tmog"
        ]
    ],
    "shortcuts": [
        [
            "Task Manager.exe",
            "Task Manager TMOG"
        ]
    ],
    "post_install": [
        "# Keep settings in the persist dir and link the folder the app reads from to it",
        "$data = \"$env:LOCALAPPDATA\\TMOG\\Task Manager\"",
        "$target = \"$persist_dir\\Task Manager\"",
        "ensure (Split-Path $data) | Out-Null",
        "ensure $target | Out-Null",
        "$item = Get-Item $data -Force -ErrorAction SilentlyContinue",
        "if ($item -and $item.LinkType) {",
        "    $item.Delete()",
        "} elseif ($item) {",
        "    Copy-Item \"$data\\*\" $target -Recurse -Force -ErrorAction Stop",
        "    Remove-Item $data -Recurse -Force",
        "}",
        "New-Item -ItemType Junction -Path $data -Target $target | Out-Null",
        "# Optional helper to replace Windows Task Manager, see notes",
        "$helper = \"$bucketsdir\\$bucket\\scripts\\tmog\\replace-taskmgr.ps1\"",
        "if ($bucket -and (Test-Path $helper)) { Copy-Item $helper $dir }"
    ],
    "pre_uninstall": [
        "# Undo the Task Manager replacement so taskmgr.exe is not left pointing at a removed app",
        "if ($cmd -eq 'uninstall' -and (Test-Path \"$dir\\replace-taskmgr.ps1\")) {",
        "    $ifeo = Get-Item 'HKLM:\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Image File Execution Options\\taskmgr.exe' -ErrorAction SilentlyContinue",
        "    if ($ifeo -and \"$($ifeo.GetValue('TMOG.Debugger'))\".Contains(\"\\apps\\$app\\\")) { & \"$dir\\replace-taskmgr.ps1\" -Disable }",
        "}",
        "$data = \"$env:LOCALAPPDATA\\TMOG\\Task Manager\"",
        "$item = Get-Item $data -Force -ErrorAction SilentlyContinue",
        "if ($item -and $item.LinkType) { $item.Delete() }",
        "$parent = Split-Path $data",
        "if ((Test-Path $parent) -and !(Get-ChildItem $parent -Force)) { Remove-Item $parent -Force }"
    ],
    "post_uninstall": [
        "# Inform of leftover directories if any was found",
        "$LeftoverDirs = [string[]](",
        "    ('{0}\\TMOG' -f $env:LOCALAPPDATA) | Where-Object -FilterScript {",
        "        [System.IO.Directory]::Exists($_)",
        "    }",
        ")",
        "if ($LeftoverDirs.Count -gt 0) {",
        "    $Message = [string] \"`r`nFound some leftover directories you might want to delete:\"",
        "    $LeftoverDirs.ForEach{",
        "        $Message += \"`r`n* '{0}'\" -f $_",
        "    }",
        "    info $Message",
        "}"
    ],
    "checkver": {
        "script": [
            "# Each architecture has its own release manifest pointing at an immutable, versioned installer",
            "$x64 = Invoke-RestMethod -Uri 'https://www.tmog.org/rtm/downloads/release-windows.json'",
            "$arm64 = Invoke-RestMethod -Uri 'https://www.tmog.org/rtm/downloads/release-windows-arm64.json'",
            "if ($x64.version -eq $arm64.version) {",
            "    Write-Output ('{0} {1} {2}' -f $x64.version, $x64.versionedArtifact, $arm64.versionedArtifact)",
            "}"
        ],
        "regex": "([\\d.]+) \\S*/downloads/(?<x64>\\S+) \\S*/downloads/(?<arm64>\\S+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://www.tmog.org/rtm/downloads/$matchX64",
                "hash": {
                    "url": "https://www.tmog.org/rtm/downloads/release-windows.json",
                    "jsonpath": "$.sha256"
                }
            },
            "arm64": {
                "url": "https://www.tmog.org/rtm/downloads/$matchArm64",
                "hash": {
                    "url": "https://www.tmog.org/rtm/downloads/release-windows-arm64.json",
                    "jsonpath": "$.sha256"
                }
            }
        }
    }
}
