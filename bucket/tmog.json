{
    "##": "Why here? Testing. See if checkver and autoupdate mechanism keeps working.",
    "version": "1.0.1",
    "description": "Task Manager by retired Microsoft engineer Dave Plummer",
    "homepage": "https://www.tmog.org",
    "license": "Proprietary",
    "architecture": {
        "64bit": {
            "url": "https://www.tmog.org/rtm/downloads/TMOG-Task-Manager-Setup.exe",
            "hash": "b4edf70fa040968958c662ffb09feeeb0eeca07759e6ed7742606bcc39f29fc6"
        },
        "arm64": {
            "url": "https://www.tmog.org/rtm/downloads/TMOG-Task-Manager-Setup-arm64.exe",
            "hash": "a317a09fc59ed7ec094739fcddefd80cf4eeac8fbb239fb12d0c8c0466a9d21b"
        }
    },
    "innosetup": true,
    "bin": [
        [
            "Task Manager.exe",
            "tmog"
        ]
    ],
    "shortcuts": [
        [
            "Task Manager.exe",
            "Task Manager TMOG"
        ]
    ],
    "post_uninstall": [
        "# Inform of leftover directories if any was found",
        "$LeftoverDirs = [string[]](",
        "    ('{0}\\TMOG' -f $env:LOCALAPPDATA) | Where-Object -FilterScript {",
        "        [System.IO.Directory]::Exists($_)",
        "    }",
        ")",
        "if ($LeftoverDirs.Count -gt 0) {",
        "    $Message = [string] \"`r`nFound some leftover directories you might want to delete:\"",
        "    $LeftoverDirs.ForEach{",
        "        $Message += \"`r`n* '{0}'\" -f $_",
        "    }",
        "    info $Message",
        "}"
    ],
    "checkver": {
        "url": "https://www.tmog.org/rtm/downloads/release-windows-arm64.json",
        "jsonpath": "$.version",
        "regex": "([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://www.tmog.org/rtm/downloads/TMOG-Task-Manager-Setup.exe",
                "hash": {
                    "url": "https://www.tmog.org/rtm/downloads/release-windows.json",
                    "jsonpath": "$.sha256"
                }
            },
            "arm64": {
                "url": "https://www.tmog.org/rtm/downloads/TMOG-Task-Manager-Setup-arm64.exe",
                "hash": {
                    "url": "https://www.tmog.org/rtm/downloads/release-windows-arm64.json",
                    "jsonpath": "$.sha256"
                }
            }
        }
    }
}
