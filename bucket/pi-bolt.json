            "extract_dir": "pi-bolt-win32-x64"
        }
    },
    "bin": "pi-bolt.exe",
    "checkver": {
        "github": "https://github.com/opensec-git/Pi-Bolt",
        "regex": "bolt-v([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
