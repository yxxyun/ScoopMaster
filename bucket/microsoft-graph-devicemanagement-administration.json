{
    "version": "2.40.0",
    "description": "Microsoft Graph PowerShell Cmdlets",
    "homepage": "https://github.com/microsoftgraph/msgraph-sdk-powershell",
    "license": "https://aka.ms/devservicesagreement",
    "depends": "microsoft-graph-authentication",
    "pre_install": "Remove-Item \"$dir\\_rels\", \"$dir\\package\", \"$dir\\*Content_Types*.xml\" -Recurse",
    "pre_uninstall": [
        "$InstalledDeps = $manifest.depends | Where-Object { Test-Path \"$(appdir $_)\\current\" }",
        "if (-not $InstalledDeps) { return }",
        "if ($global) { scoop uninstall --global $InstalledDeps }",
        "else { scoop uninstall $InstalledDeps }"
    ],
    "checkver": {
        "regex": "<h2>([\\d\\.]+)</h2>",
        "url": "https://www.powershellgallery.com/packages/microsoft.graph.devicemanagement.administration"
    },
    "autoupdate": {
        "url": "https://www.powershellgallery.com/api/v2/package/microsoft.graph.devicemanagement.administration/$version#/microsoft.graph.devicemanagement.administration.nupkg"
    },
    "hash": "2677f2618e3e8f78aff0a888fab1bb230e820181a8992595478c7d650ab92571",
    "url": "https://www.powershellgallery.com/api/v2/package/microsoft.graph.devicemanagement.administration/2.40.0#/microsoft.graph.devicemanagement.administration.nupkg",
