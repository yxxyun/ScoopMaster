{
    "version": "1.3.138",
    "description": "A fast, native Windows terminal built on Ghostty's terminal core",
    "homepage": "https://noctty.com",
    "license": "MIT",
    "notes": [
        "Requires Windows 10 1809+ or Windows 11, x64 or ARM64. The default renderer needs OpenGL 4.3 and switches to a Direct3D 11 renderer where OpenGL cannot start.",
        "On Windows on Arm without a vendor OpenGL driver, install the free OpenCL, OpenGL, and Vulkan Compatibility Pack from the Microsoft Store.",
        "Default-terminal registration is experimental: run 'noctty +register-default-terminal', and close noctty before 'scoop uninstall'."
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/amanthanvi/noctty/releases/download/v1.3.138/noctty-1.3.138-windows-x64-portable.zip",
            "hash": "83a52a96f8f2ce04323a4fc932d439775cafe9f83b49b6dae89dc02e855e954b"
        },
        "arm64": {
            "url": "https://github.com/amanthanvi/noctty/releases/download/v1.3.138/noctty-1.3.138-windows-arm64-portable.zip",
            "hash": "ae117a2329b56a2fd23c7f47b177080c509ec6ee8b2ed759e6f5623e9813f00a"
        }
    },
    "extract_dir": "noctty",
    "bin": "noctty.exe",
    "shortcuts": [
        [
            "noctty.exe",
            "Noctty"
        ]
    ],
    "pre_uninstall": [
        "if ($cmd -eq 'uninstall') {",
        "    $key = Get-Item -LiteralPath 'HKCU:\\Software\\Classes\\CLSID\\{33368C6F-D328-410C-B225-26DC9F12C728}\\LocalServer32' -ErrorAction Ignore",
        "    $registered = if ($key) { $key.GetValue('').Trim('\"') }",
        "    $running = @(Get-Process noctty -ErrorAction Ignore | Where-Object { $_.Path -and $_.Path.StartsWith($dir, [StringComparison]::OrdinalIgnoreCase) })",
        "    if ($running.Count -eq 0 -and $registered -and $registered.StartsWith($dir, [StringComparison]::OrdinalIgnoreCase) -and (Test-Path -LiteralPath \"$dir\\noctty.com\")) {",
        "        & \"$dir\\noctty.com\" '+unregister-default-terminal'",
        "    }",
        "}"
    ],
    "checkver": {
        "github": "https://github.com/amanthanvi/noctty"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/amanthanvi/noctty/releases/download/v$version/noctty-$version-windows-x64-portable.zip"
            },
            "arm64": {
                "url": "https://github.com/amanthanvi/noctty/releases/download/v$version/noctty-$version-windows-arm64-portable.zip"
            }
        }
    }
}
