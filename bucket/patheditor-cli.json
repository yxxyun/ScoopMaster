                "hash": {
                    "url": "https://api.github.com/repos/LHY0125/PathEditor/releases/tags/v$version",
                    "jsonpath": "$.assets[?(@.name == 'patheditor-cli_$version_x64.exe')].digest"
                }
            }
        }
    }
