    "pre_install": "Set-Content -Path \"$dir\\relnote.cmd\" -Value '@python \"%~dp0relnote.pyz\" %*' -Encoding Ascii",
    "bin": "relnote.cmd",
    "checkver": "github",
    "autoupdate": {
        "url": "https://github.com/loki-inu/relnote/releases/download/v$version/relnote.pyz",
