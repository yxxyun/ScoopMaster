{
    "version": "0.3.0",
    "description": "Local, offline, CPU-only speech-to-text terminal application powered by whisper.cpp.",
    "homepage": "https://github.com/programmersd21/scribe",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/programmersd21/scribe/releases/download/v0.3.0/scribe-windows-x86_64.exe",
            "hash": "680a556d3390a19d3f2d15324d353a09b48b250637edf7a5d19f9aada0b61fd8"
        }
    },
    "pre_install": [
        "$launcher = @('@echo off', 'set \"XDG_CONFIG_HOME=%~dp0data\\config\"', 'set \"XDG_CACHE_HOME=%~dp0data\\cache\"', '\"%~dp0scribe-windows-x86_64.exe\" %*')",
        "Set-Content -LiteralPath (Join-Path $dir 'scribe.cmd') -Value $launcher -Encoding ASCII"
    ],
    "persist": "data",
    "bin": "scribe.cmd",
    "shortcuts": [
        [
            "scribe.cmd",
            "Scribe (Terminal)"
        ]
    ],
    "checkver": {
        "url": "https://api.github.com/repos/programmersd21/scribe/releases/latest",
        "jsonpath": "$.tag_name",
        "regex": "^v(?<version>[\\d.]+)$"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/programmersd21/scribe/releases/download/v$version/scribe-windows-x86_64.exe"
            }
        }
    },
    "notes": "The launcher redirects XDG configuration and cache paths into the persisted Scoop data folder. Models are downloaded on first use; after downloading a model, transcription can run offline."
}
