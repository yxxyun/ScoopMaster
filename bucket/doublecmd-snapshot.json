{
    "##": "ltguillaume/schep",
    "version": "1.3.0.r13520",
    "description": "Snapshot releases of the two pane file manager inspired by Total Commander. Portable",
    "homepage": "https://doublecmd.sourceforge.io",
    "license": "GPL-2.0-only",
    "architecture": {
        "64bit": {
            "url": "https://github.com/doublecmd/snapshots/releases/download/13520/doublecmd-1.3.0.r13520.x86_64-win64.7z#dl.7z",
            "hash": "d8faea83df9cff7e1cebe8f399c04e6e21835a491f42eaf94905f4cbc4cf5b6d"
        }
    },
    "shortcuts": [
        [
            "doublecmd.exe",
            "Double Commander Snapshot"
        ]
    ],
    "post_install": [
        "New-Item \"$dir\\settings\\doublecmd.inf\" 2>$null",
        "Copy-Item -Path \"$persist_dir\\language\\*\" -Destination \"$dir\\language\" -Force -Recurse -ErrorAction SilentlyContinue"
    ],
    "bin": "doublecmd.exe",
    "persist": "settings",
    "checkver": {
        "url": "https://api.github.com/repos/doublecmd/snapshots/releases/latest",
        "regex": "doublecmd-([\\d.]+?r(?<rev>\\d+))\\.x86_64-win64.7z"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/doublecmd/snapshots/releases/download/$matchRev/doublecmd-$version.x86_64-win64.7z#dl.7z"
            }
        }
    }
}
