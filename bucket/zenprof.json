    "depends": "chris/zen_np",
    "installer": {
        "script": [
            "[void](mkdir -force -ea 0 \"$persist_dir\")",
            "mv -force \"$dir\\profile\" \"$persist_dir\\profile\"",
            "zen -CreateProfile \"Scoop $persist_dir\\profile\""
        ]
    },
    "persist": "profile",
    "checkver": "github",
    "autoupdate": {
        "url": "https://github.com/chrishenn/zenprof/releases/download/v$version/zenprof.zip"
    }
}
