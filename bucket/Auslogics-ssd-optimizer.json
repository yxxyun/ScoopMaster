{
    "version": "2.2.0.6",
    "description": "SSD optimization and health utility",
    "homepage": "https://www.auslogics.com/en/software/ssd-optimizer/",
    "license": "Proprietary",
    "url": "https://downloads.auslogics.com/en/ssd-optimizer/auslogics-ssd-optimizer-setup.exe",
    "hash": "13de8a27c69368a7b397878e5612b47a0ff036cd79e57e1f96c766da0443bbda",
    "innosetup": true,
    "bin": "SSDOptimizer.exe",
    "shortcuts": [
        [
            "SSDOptimizer.exe",
            "Auslogics SSD Optimizer"
        ]
    ],
    "checkver": {
        "script": [
            "$html = (Invoke-WebRequest -Uri 'https://www.auslogics.com/en/software/ssd-optimizer/' -UseBasicParsing).Content",
            "$text = [System.Net.WebUtility]::HtmlDecode([regex]::Replace($html, '<[^>]+>', ' '))",
            "$text = [regex]::Replace($text, '\\s+', ' ')",
            "$match = [regex]::Match($text, '(?i)Version\\s+(?<version>\\d+(?:\\.\\d+){3})')",
            "if (-not $match.Success) { throw 'Unable to detect the Auslogics SSD Optimizer version from the official product page.' }",
            "$match.Groups['version'].Value"
        ],
        "regex": "(?<version>\\d+(?:\\.\\d+){3})"
    },
    "autoupdate": {
        "url": "https://downloads.auslogics.com/en/ssd-optimizer/auslogics-ssd-optimizer-setup.exe"
    },
    "notes": "Scoop uses Inno Setup extraction to unpack the official installer into the application directory; the installer is not executed."
}
