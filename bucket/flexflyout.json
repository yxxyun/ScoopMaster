{
    "version": "0.3.2",
    "description": "Media flyout for Windows 11: cover art, title, position, playback controls and volume when the volume or the track changes, sized and placed where you want",
    "homepage": "https://github.com/akivajp/flexflyout",
    "license": "MIT|Apache-2.0",
    "notes": [
        "Start FlexFlyout from the Start menu; its tray icon can make it start with Windows.",
        "Quit it from the tray icon before 'scoop update flexflyout'."
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/akivajp/flexflyout/releases/download/v0.3.2/flexflyout-v0.3.2-x86_64-pc-windows-msvc.zip",
            "hash": "5109edad0187083b0ead4772c90d1ae28022b9e8ee60f19fab58dd602563a396",
            "extract_dir": "flexflyout-v0.3.2-x86_64-pc-windows-msvc"
        }
    },
    "bin": "flexflyout.exe",
    "shortcuts": [
        [
            "flexflyout.exe",
            "FlexFlyout"
        ]
    ],
    "uninstaller": {
        "script": [
            "# Only when uninstalling (an update runs this too): remove the",
            "# 'Start with Windows' entry, which would point to a deleted file.",
            "if ($cmd -eq 'uninstall') {",
            "    Remove-ItemProperty -Path 'HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Run' -Name 'FlexFlyout' -ErrorAction SilentlyContinue",
            "    Remove-ItemProperty -Path 'HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\StartupApproved\\Run' -Name 'FlexFlyout' -ErrorAction SilentlyContinue",
            "}"
        ]
    },
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/akivajp/flexflyout/releases/download/v$version/flexflyout-v$version-x86_64-pc-windows-msvc.zip",
                "extract_dir": "flexflyout-v$version-x86_64-pc-windows-msvc"
            }
        },
        "hash": {
            "url": "$baseurl/SHA256SUMS"
        }
    }
}
