{
    "version": "2.0.0",
    "description": "Automates batch Delphi project builds, code signing and executable version information patching.",
    "homepage": "https://www.mitec.cz/wp/pm/",
    "license": "Proprietary",
    "url": "https://www.mitec.cz/wp/files/PMInstall.exe",
    "shortcuts": [
        [
            "ProjectMaker.exe",
            "MiTeC Project Maker"
        ]
    ],
    "innosetup": true,
    "checkver": {
        "script": [
            "$response = Invoke-WebRequest -Uri 'https://www.mitec.cz/wp/pm/' -UseBasicParsing",
            "$text = [System.Net.WebUtility]::HtmlDecode([regex]::Replace($response.Content, '<[^>]+>', ' '))",
            "$entry = [regex]::Match($text, '(?im)(?<version>\\d+(?:\\.\\d+)+)\\s*(?:\\|\\s*)?(?<date>\\d{1,2}\\.\\d{1,2}\\.\\d{4})')",
            "if (-not $entry.Success) { throw 'No released Project Maker version with a release date was found.' }",
            "$entry.Groups['version'].Value"
        ],
        "regex": "(?<version>\\d+\\.\\d+\\.\\d+)"
    },
    "autoupdate": {
        "url": "https://www.mitec.cz/wp/files/PMInstall.exe"
    },
    "notes": "This is the vendor's 30-day trial download; a paid license is required for continued licensed use."
}

