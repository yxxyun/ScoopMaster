{
    "version": "2003.04.26",
    "description": "GRC Shoot The Messenger: Legacy utility for managing the Windows Messenger Service on older Windows releases.",
    "homepage": "https://www.grc.com/stm/shootthemessenger.htm",
    "license": "Freeware",
    "url": "https://www.grc.com/files/shootthemessenger.exe",
    "shortcuts": [
        [
            "shootthemessenger.exe",
            "GRC Shoot The Messenger"
        ]
    ],
    "notes": [
        "GRC does not publish a static SHA-256 checksum for this download. The manifest omits hash rather than inventing a value.",
        "Targets the obsolete Windows Messenger Service associated with Windows NT/2000/XP-era systems; not useful for modern Windows."
    ],
    "checkver": {
        "script": [
            "$html = (Invoke-WebRequest -Uri 'https://www.grc.com/stm/shootthemessenger.htm' -UseBasicParsing).Content",
            "$text = [System.Net.WebUtility]::HtmlDecode([regex]::Replace($html, '<[^>]+>', ' '))",
            "$text = [regex]::Replace($text, '\\s+', ' ')",
            "$match = [regex]::Match($text, '(?is)File stats for:\\s*Shoot The Messenger.{0,1800}?Last\\s+Updated:\\s*Size:\\s*[\\d.,]+\\s*[kKmM]?\\s+(?<date>[A-Za-z]{3}\\s+\\d{1,2},\\s+\\d{4})\\s+at\\b')",
            "if (-not $match.Success) { throw 'Unable to read the published Last Updated date for Shoot The Messenger.' }",
            "[DateTime]::ParseExact($match.Groups['date'].Value, 'MMM d, yyyy', [Globalization.CultureInfo]::InvariantCulture).ToString('yyyy.MM.dd')"
        ],
        "regex": "(?<version>\\d{4}\\.\\d{2}\\.\\d{2})"
    },
    "autoupdate": {
        "url": "https://www.grc.com/files/shootthemessenger.exe"
    }
}
