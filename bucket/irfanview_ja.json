{
    "version": "4.76",
    "description": "A fast, compact and innovative graphic viewer (with PlugIns and Japanese language files)",
    "homepage": "https://www.irfanview.com/",
    "license": {
        "identifier": "Freeware",
        "url": "https://www.irfanview.com/eula.htm"
    },
    "notes": [
        "Japanese UI is enabled by default (i_view64.ini: DLL=JAPANESE.DLL). Use 'Properties > Change language' to switch languages.",
        "irfanview_lang_japanese.zip is updated by the translator independently of IrfanView releases. If a hash check fails on it, update the third hash in this manifest (autoupdate refreshes it on every version bump)."
    ],
    "architecture": {
        "64bit": {
            "url": [
                "https://www.irfanview.info/files/iview476_x64.zip",
                "https://www.irfanview.info/files/iview476_plugins_x64.zip",
                "https://www.irfanview.net/lang/irfanview_lang_japanese.zip"
            ],
            "hash": [
                "37f10e9c6ecfeba3d5c0f16cc6f07bdda4ffdf85069613d25ec51f8e4733a9eb",
                "13eb6e1cbe51c4b2c4f8a3a08166b8b9fbbcec03488ba5a8d112454c23fc715d",
                "d23fbe51f8e7d20f81fb801648b1f5a000543dafffda552cb4d00ac3e31ff57f"
            ],
            "bin": [
                [
                    "i_view64.exe",
                    "irfanview"
                ]
            ],
            "shortcuts": [
                [
                    "i_view64.exe",
                    "IrfanView"
                ]
            ]
        }
    },
    "extract_to": [
        "",
        "Plugins",
        ""
    ],
    "pre_install": [
        "if (!(Test-Path \"$persist_dir\\i_view64.ini\")) {",
        "    Write-Output \"[Language]`r`nDLL=JAPANESE.DLL`r`nLang=Japanese\" | Out-File -Encoding ASCII \"$dir\\i_view64.ini\"",
        "}",
        "New-Item \"$dir\\Languages\" -ItemType Directory -Force | Out-Null",
        "Move-Item \"$dir\\Japanese.dll\" \"$dir\\Languages\\Japanese.dll\" -Force -ErrorAction SilentlyContinue",
        "Move-Item \"$dir\\Japanese_YuGothic.dll\" \"$dir\\Languages\\Japanese_YuGothic.dll\" -Force -ErrorAction SilentlyContinue",
        "Move-Item \"$dir\\IP_Japanese.lng\" \"$dir\\Languages\\IP_Japanese.lng\" -Force -ErrorAction SilentlyContinue"
    ],
    "persist": [
        "i_view64.ini",
        "Toolbars"
    ],
    "checkver": {
        "url": "https://www.irfanview.com/",
        "regex": ">\\s*version\\s+([\\d.-]+)\\s*<"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": [
                    "https://www.irfanview.info/files/iview$cleanVersion_x64.zip",
                    "https://www.irfanview.info/files/iview$cleanVersion_plugins_x64.zip",
                    "https://www.irfanview.net/lang/irfanview_lang_japanese.zip"
                ],
                "hash": [
                    {
                        "url": "https://www.irfanview.com/64bit.htm",
                        "regex": "iview\\d+_x64\\.zip.+\\s+.+checksum:\\s*$sha256"
                    },
                    {
                        "url": "https://www.irfanview.com/64bit.htm",
                        "regex": "iview\\d+_plugins_x64\\.zip.+\\s+.+checksum:\\s*$sha256"
                    },
                    {
                        "url": "https://www.irfanview.com/languages.htm",
                        "regex": "irfanview_lang_japanese\\.zip.+\\s+.+checksum:\\s*$sha256"
                    }
                ]
            }
        }
    }
}
