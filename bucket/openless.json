{
    "version": "2.0.1",
    "description": "An open-source, privacy-focused voice-input application",
    "homepage": "https://github.com/Open-Less/openless",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/Open-Less/openless/releases/download/v2.0.1-tauri/OpenLess_2.0.1+build.20261016_x64_en-US.msi",
            "hash": "2084d718a6b408c291451f42a3bee857f16c85969d75c596b8c2015ba3a33930"
        }
    },
    "extract_dir": "PFiles\\OpenLess",
    "bin": [
        [
            "openless.exe",
            "openless"
        ]
    ],
    "shortcuts": [
        [
            "openless.exe",
            "OpenLess"
        ]
    ],
    "post_install": [
        "$dll64 = \"$dir\\windows-ime\\x64\\OpenLessIme.dll\"",
        "$dll86 = \"$dir\\windows-ime\\x86\\OpenLessIme.dll\"",
        "$cmd = \"regsvr32.exe /s `\\`\"$dll64`\\`\"; & `\\`\"$env:SystemRoot\\SysWOW64\\regsvr32.exe`\\`\" /s `\\`\"$dll86`\\`\"\"",
        "Start-Process powershell -ArgumentList \"-NoProfile -Command `\"$cmd`\"\" -Verb RunAs -Wait"
    ],
    "pre_uninstall": [
        "$dll64 = \"$dir\\windows-ime\\x64\\OpenLessIme.dll\"",
        "$dll86 = \"$dir\\windows-ime\\x86\\OpenLessIme.dll\"",
        "$cmd = \"regsvr32.exe /s /u `\\`\"$dll64`\\`\"; & `\\`\"$env:SystemRoot\\SysWOW64\\regsvr32.exe`\\`\" /s /u `\\`\"$dll86`\\`\"\"",
        "Start-Process powershell -ArgumentList \"-NoProfile -Command `\"$cmd`\"\" -Verb RunAs -Wait"
    ],
    "checkver": {
        "script": [
            "$headers = @{ 'User-Agent' = 'Scoop' }",
            "$release = Invoke-RestMethod -Headers $headers -Uri 'https://api.github.com/repos/Open-Less/openless/releases/latest'",
            "$tag = $release.tag_name",
            "$asset = ($release.assets | Where-Object { $_.name -like 'OpenLess_*_x64_en-US.msi' } | Select-Object -First 1).name",
            "Write-Output \"$asset $tag\""
        ],
        "regex": "^OpenLess_(?<version>[\\d.]+)(?<build>\\+build\\.[0-9]+)?_x64_en-US\\.msi (?<tag>v[\\d.]+-tauri)$"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/Open-Less/openless/releases/download/$matchTag/OpenLess_$version$matchBuild_x64_en-US.msi"
            }
        },
        "hash": {
            "url": "https://github.com/Open-Less/openless/releases/download/$matchTag/SHA256SUMS"
        }
    }
}
