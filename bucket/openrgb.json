{
    "version": "1.0rc3",
    "description": "开源 RGB 灯光控制软件，支持众多厂商的设备。",
    "homepage": "https://openrgb.org",
    "license": "GPL-2.0-only",
    "architecture": {
        "64bit": {
            "url": "https://github.com/CalcProgrammer1/OpenRGB/releases/download/release_candidate_1.0rc3/OpenRGB_1.0rc3_Windows_64_6fbcf62.zip",
            "hash": "a6bb0fbcb7b6eb84214287e3808fadae2777c902efb3dd6cd1e2976f14271c8c",
            "extract_dir": "OpenRGB Windows 64-bit"
        }
    },
    "shortcuts": [
        [
            "OpenRGB.exe",
            "OpenRGB"
        ]
    ],
    "post_install": [
        "if (!(Test-Path \"$persist_dir\")) { New-Item -ItemType Directory \"$persist_dir\" -Force | Out-Null }",
        "if (Test-Path \"$env:APPDATA\\OpenRGB\") {",
        "    if ((Get-Item \"$env:APPDATA\\OpenRGB\").LinkType -ne 'Junction') { Get-ChildItem \"$env:APPDATA\\OpenRGB\" | Move-Item -Destination \"$persist_dir\" -Force; Remove-Item \"$env:APPDATA\\OpenRGB\" -Force } else { Remove-Item \"$env:APPDATA\\OpenRGB\" -Force -Recurse }",
        "}",
        "New-Item -ItemType Junction -Path \"$env:APPDATA\\OpenRGB\" -Target \"$persist_dir\" -Force | Out-Null"
    ],
    "pre_uninstall": [
        "if ((Test-Path \"$env:APPDATA\\OpenRGB\") -and ((Get-Item \"$env:APPDATA\\OpenRGB\").LinkType -eq 'Junction')) { Remove-Item \"$env:APPDATA\\OpenRGB\" -Force -Recurse }"
    ],
    "checkver": {
        "url": "https://api.github.com/repos/CalcProgrammer1/OpenRGB/releases/latest",
        "jsonpath": "$.assets..browser_download_url",
        "regex": "release_candidate_(?<version>[\\w.]+)/OpenRGB_[\\w.]+_Windows_64_(?<commit>[a-f0-9]{7})\\.zip"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/CalcProgrammer1/OpenRGB/releases/download/release_candidate_$version/OpenRGB_$version_Windows_64_$commit.zip",
                "extract_dir": "OpenRGB Windows 64-bit"
            }
        }
    }
}
