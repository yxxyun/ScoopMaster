{
    "version": "0.1.116",
    "description": "Windows dock and top bar with desktop widgets, Quick Settings, and a desktop assistant",
    "homepage": "https://nopbard.com/nopbar",
    "license": "GPL-3.0-only",
    "architecture": {
        "64bit": {
            "url": "https://github.com/nopbard/nopbar-releases/releases/download/v0.1.116/NopBar-0.1.116-portable.zip",
            "hash": "5c94e534568ea01e4c7f0da196309ced82a64f2f1ca23220ee3a1bc6698faac4"
        }
    },
    "shortcuts": [
        [
            "nopbar.exe",
            "NopBar"
        ]
    ],
    "pre_uninstall": "if ($cmd -eq 'uninstall') { & \"$dir\\nopbar.exe\" --uninstall --quiet | Out-Null } else { & \"$dir\\nopbar.exe\" --quit | Out-Null }",
    "checkver": {
        "url": "https://nopbard.com/nopbar/version.json",
        "jsonpath": "$.version"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/nopbard/nopbar-releases/releases/download/v$version/NopBar-$version-portable.zip",
                "hash": {
                    "url": "https://api.github.com/repos/nopbard/nopbar-releases/releases/tags/v$version",
                    "jsonpath": "$.assets[?(@.name == '$basename')].digest"
                }
            }
        }
    },
    "notes": "Settings remain in %APPDATA%\\NopBar after uninstall. If the Windows taskbar remains hidden after NopBar exits, run nopbar.exe --restore-taskbar."
}
