{
    "version": "1.11.1",
    "description": "Fast, reliable, open-source download manager with multi-segment downloads, queue management, browser extensions, and SQLite persistence.",
    "homepage": "https://github.com/novincode/dlman",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/novincode/dlman/releases/latest/download/DLMan_1.11.1_x64-setup.exe",
            "hash": "c6739ff35a2592e3b093da26aaf8646eb405483b61203645aa29b12386e33d71"
        }
    },
    "installer": {
        "args": [
            "/S",
            "/D=$dir"
        ]
    },
    "bin": "dlman-desktop.exe",
    "shortcuts": [
        [
            "dlman-desktop.exe",
            "DLMan"
        ]
    ],
    "checkver": {
        "url": "https://api.github.com/repos/novincode/dlman/releases/latest",
        "jsonpath": "$.assets[*].browser_download_url",
        "regex": "DLMan_(?<version>[\\d.]+)_x64-setup\\.exe"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/novincode/dlman/releases/latest/download/DLMan_$version_x64-setup.exe",
                "hash": {
                    "url": "https://api.github.com/repos/novincode/dlman/releases/latest",
                    "jsonpath": "$.assets[?(@.name == '$basename')].digest"
                }
            }
        }
    }
}
