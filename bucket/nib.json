{
    "version": "0.10.0",
    "description": "A simple, lightweight markdown editor offering all the features you could ever need.",
    "homepage": "https://nibeditor.com",
    "license": "AGPL-3.0-only",
    "notes": "Themes and note history live in '%APPDATA%\\ch.emilvinu.nib', which is junctioned into Scoop's persist directory, so they survive updates and uninstalls.",
    "architecture": {
        "64bit": {
            "url": "https://github.com/lxorb/nibeditor/releases/download/v0.10.0/Nib-0.10.0-windows-x64-setup.exe#/dl.7z",
            "hash": "42090f70e5e1c9a12aad21d31a4f03f40d8e684c1363af0276a8481f281fb0d9"
        },
        "arm64": {
            "url": "https://github.com/lxorb/nibeditor/releases/download/v0.10.0/Nib-0.10.0-windows-arm64-setup.exe#/dl.7z",
            "hash": "7cdfc4754a5e1ea0e131d630bc65ed6a89715af09739121139306e6c1259d0d3"
        }
    },
    "pre_install": "Remove-Item \"$dir\\`$*\", \"$dir\\uninstall.exe\" -Force -Recurse -ErrorAction 'Ignore'",
    "installer": {
        "script": [
            "ensure \"$persist_dir\" | Out-Null",
            "$appdata = \"$env:APPDATA\\ch.emilvinu.nib\"",
            "if (Test-Path $appdata) {",
            "    if ((Get-Item -LiteralPath $appdata -Force).LinkType -eq 'Junction') {",
            "        Remove-Item -LiteralPath $appdata -Force",
            "    } else {",
            "        Get-ChildItem -LiteralPath $appdata -Force | Move-Item -Destination \"$persist_dir\" -Force",
            "        Remove-Item -LiteralPath $appdata -Recurse -Force",
            "    }",
            "}",
            "New-Item -Path $appdata -ItemType Junction -Target \"$persist_dir\" | Out-Null"
        ]
    },
    "bin": "nib.exe",
    "shortcuts": [
        [
            "nib.exe",
            "Nib"
        ]
    ],
    "uninstaller": {
        "script": "Remove-Item \"$env:APPDATA\\ch.emilvinu.nib\" -Force -Recurse -ErrorAction 'Ignore'"
    },
    "checkver": {
        "github": "https://github.com/lxorb/nibeditor"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/lxorb/nibeditor/releases/download/v$version/Nib-$version-windows-x64-setup.exe#/dl.7z"
            },
            "arm64": {
                "url": "https://github.com/lxorb/nibeditor/releases/download/v$version/Nib-$version-windows-arm64-setup.exe#/dl.7z"
            }
        }
    }
}
