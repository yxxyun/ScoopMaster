{
    "version": "0.1.0",
    "description": "Lightweight instant replay for Windows: a rolling buffer of your screen and sound, saved as a clip with one key.",
    "homepage": "https://github.com/Zyrecx/ombra",
    "license": "GPL-3.0-or-later",
    "notes": "Quit Ombra from its tray icon before 'scoop update ombra' or 'scoop uninstall ombra'.",
    "architecture": {
        "64bit": {
            "url": "https://github.com/Zyrecx/ombra/releases/download/v0.1.0/Ombra-Portable.zip",
            "hash": "d99aa8eb36df8386c7c15d388d03e0d263078704afe92cd0625b41e83f2fc76b"
        }
    },
    "post_install": [
        "# Start at login through 'current', not this version's folder, which the next update replaces.",
        "$run = 'HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Run'",
        "$appdir = Split-Path $dir",
        "$value = (Get-ItemProperty $run -Name Ombra -ErrorAction SilentlyContinue).Ombra",
        "if ($value -and $value.Trim('\"').StartsWith(\"$appdir\\\", [StringComparison]::OrdinalIgnoreCase)) {",
        "    Set-ItemProperty $run -Name Ombra -Value ('\"' + \"$appdir\\current\\ombra.exe\" + '\"')",
        "}"
    ],
    "shortcuts": [
        [
            "ombra-ui.exe",
            "Ombra"
        ]
    ],
    "checkver": {
        "github": "https://github.com/Zyrecx/ombra"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/Zyrecx/ombra/releases/download/v$version/Ombra-Portable.zip"
            }
        },
        "hash": {
            "url": "$baseurl/SHA256SUMS.txt"
        }
    }
}
