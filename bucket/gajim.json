{
    "##": "ltguillaume/schep",
    "version": "2.7.0",
    "description": "A fully-featured XMPP client. Fully portable version.",
    "homepage": "https://gajim.org",
    "license": "GPL-3.0",
    "architecture": {
        "64bit": {
            "url": "https://gajim.org/downloads/2.7/Gajim-Portable-2.7.0-64bit.exe#/gajim-portable.exe",
            "hash": "e79833517ba5f02f2d9cc23a4e9e5e149aaec322fa1af5f4e88535f7df1ee86e"
        }
    },
    "bin": "bin/Gajim.exe",
    "shortcuts": [
        [
            "bin/Gajim.exe",
            "Gajim"
        ]
    ],
    "persist": [
        "UserData",
        [
            "share/hunspell",
            "hunspell"
        ]
    ],
    "installer": {
        "file": "gajim-portable.exe",
        "args": "\" /S /LANG=en /D=$dir \""
    },
    "checkver": {
        "url": "https://gajim.org/current-version.json",
        "jsonpath": "$.current_version"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://gajim.org/downloads/$majorVersion.$minorVersion/Gajim-Portable-$version-64bit.exe#/gajim-portable.exe"
            }
        }
    }
}
