{
    "version": "4.0.1-alpha.4",
    "description": "Dynamic wallpaper client for Windows",
    "homepage": "https://github.com/GiantappMan/livewallpaper",
    "license": "GPL-3.0",
    "url": "https://github.com/GiantappMan/livewallpaper/releases/download/v4.0.1-alpha.4/GiantappWallpaper_4.0.1-alpha.4_x64-setup.exe",
    "hash": "de94726bbad684840fad871dbeec2d292e9c6ebfd90c3bdce4a60c8f5af77ca3",
    "installer": {
        "script": "Invoke-ExternalCommand \"$dir\\$fname\" -ArgumentList @('/VERYSILENT', '/SUPPRESSMSGBOXES', '/NORESTART', \"/DIR=$dir\") -RunAs | Out-Null"
    },
    "uninstaller": {
        "script": "$uninstaller = Get-ChildItem -LiteralPath $dir -Filter 'unins*.exe' -File -ErrorAction SilentlyContinue | Select-Object -First 1; if ($uninstaller) { Invoke-ExternalCommand $uninstaller.FullName -ArgumentList '/VERYSILENT', '/SUPPRESSMSGBOXES', '/NORESTART' -RunAs | Out-Null }"
    },
    "bin": "LiveWallpaper3.exe",
    "shortcuts": [
        [
            "LiveWallpaper3.exe",
            "LiveWallpaper"
        ]
    ],
    "checkver": {
        "github": "https://api.github.com/repos/GiantappMan/livewallpaper/releases",
        "jsonpath": "$[0].assets[*].browser_download_url",
        "regex": "download/v(?<version>[^/]+)/(?<file>(?:LiveWallpaper\\.Installer\\.v[^/]+\\.exe|GiantappWallpaper_[^/]+_x64-setup\\.exe))"
    },
    "autoupdate": {
        "url": "https://github.com/GiantappMan/livewallpaper/releases/download/v$version/$matchFile"
    }
}
