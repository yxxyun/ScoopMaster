{
    "version": "26.928.1915.0",
    "description": "Official ChatGPT desktop app with Codex, unpacked from the Store-signed MSIX without AppX registration.",
    "homepage": "https://learn.chatgpt.com/docs/windows/windows-app",
    "license": "Proprietary",
    "architecture": {
        "64bit": {
            "url": "https://persistent.oaistatic.com/codex-app-prod/releases/26.928.1915.0/ChatGPT-x64.msix#/ChatGPT-x64.zip",
            "hash": "410c7f2323ebf36d16e43f369828d7f4c60d3d967afcf9f73220603de8735df2"
        },
        "arm64": {
            "url": "https://persistent.oaistatic.com/codex-app-prod/releases/26.928.1915.0/ChatGPT-arm64.msix#/ChatGPT-arm64.zip",
            "hash": "21faa2c2959c4678c3a33de9dd25e62f161ae00e7c5a23da34a484d9c484744f"
        }
    },
    "pre_install": [
        "Get-ChildItem -LiteralPath (Join-Path $dir 'app\\resources\\cua_node\\bin\\node_modules') -Recurse -Force | Where-Object Name -Match '%[0-9A-Fa-f]{2}' | Sort-Object { $_.FullName.Length } -Descending | ForEach-Object { Rename-Item -LiteralPath $_.FullName -NewName ([Uri]::UnescapeDataString($_.Name)) -ErrorAction Stop }",
        "$protocolKey = 'Registry::HKEY_CURRENT_USER\\Software\\Classes\\codex'",
        "New-Item -Path \"$protocolKey\\shell\\open\\command\" -Force | Out-Null",
        "Set-Item -LiteralPath $protocolKey -Value 'URL:codex'",
        "New-ItemProperty -LiteralPath $protocolKey -Name 'URL Protocol' -Value '' -PropertyType String -Force | Out-Null",
        "Set-Item -LiteralPath \"$protocolKey\\shell\\open\\command\" -Value ('\"' + (Join-Path (Join-Path (Split-Path -Parent $dir) 'current') 'app\\ChatGPT.exe') + '\" \"%1\"')"
    ],
    "pre_uninstall": "Remove-Item -LiteralPath 'Registry::HKEY_CURRENT_USER\\Software\\Classes\\codex' -Recurse -Force",
    "shortcuts": [
        [
            "app\\ChatGPT.exe",
            "ChatGPT (Scoop)"
        ]
    ],
    "env_set": {
        "CODEX_CLI_PATH": "$dir\\app\\resources\\codex.exe"
    },
    "checkver": {
        "url": "https://persistent.oaistatic.com/codex-app-prod/windows-store-update.json",
        "script": [
            "$release = $page | ConvertFrom-Json",
            "if ($release.buildVersion -ceq $expected_ver) { $release.buildVersion; return }",
            "$reader = Join-Path (Split-Path -Parent (Split-Path -Parent $file)) 'bin\\get-remote-msix-manifest.ps1'",
            "$versions = 'x64', 'arm64' | ForEach-Object { (& $reader -Uri \"https://persistent.oaistatic.com/codex-app-prod/releases/$($release.buildVersion)/ChatGPT-$_.msix\").Version }",
            "if (@($versions | Where-Object { $_ -cne $release.buildVersion }).Count -eq 0) { $release.buildVersion } else { $expected_ver }"
        ],
        "regex": "([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://persistent.oaistatic.com/codex-app-prod/releases/$version/ChatGPT-x64.msix#/ChatGPT-x64.zip"
            },
            "arm64": {
                "url": "https://persistent.oaistatic.com/codex-app-prod/releases/$version/ChatGPT-arm64.msix#/ChatGPT-arm64.zip"
            }
        }
    },
    "notes": [
        "CODEX_CLI_PATH is set automatically - it must point to the bundled CLI for this unpacked installation to start without MSIX package identity and keep desktop API compatibility.",
        "Codex state remains in ~/.codex, %APPDATA%\\Codex, and %LOCALAPPDATA%\\OpenAI\\Codex; Scoop does not move or delete it.",
        "Scoop does not configure in-app updates. You would want to disable them: add the following to %ProgramData%\\OpenAI\\Codex\\requirements.toml, merge it into an existing [features] table if needed, then fully quit and reopen app:",
        "[features]",
        "in_app_updates = false"
    ]
}
