{
    "version": "2.6.18.0",
    "description": "OyaziViewer",
    "homepage": "https://oyaziviewer.com/",
    "license": "Freeware",
    "url": "https://ftp.vector.co.jp/78/91/2345/OyaziViewer2.6.18.zip",
    "hash": "73e7a21e37ad7e1e2bb4114fb53a0f934a3a4a37ad4fd976e2f76643dba8b6f7",
    "extract_dir": "OyaziViewer2.6.18",
    "post_install": [
        "ensure \"$persist_dir\" | Out-Null",
        "Get-ChildItem \"$persist_dir\\*\" | ForEach-Object {",
        "    if (Test-Path $_.FullName) {",
        "        New-Item -Path (Join-Path $dir $_.Name) -Value $_ -ItemType HardLink -Force",
        "    }",
        "}"
    ],
    "shortcuts": [["OyaziViewer.exe", "OyaziViewer"]],
    "checkver": {
        "url": "https://www.vector.co.jp/soft/winnt/util/se511187.html",
        "regex": "https://ftp\\.vector\\.co\\.jp/(\\d+/\\d+/\\d+)/OyaziViewer([\\d.]+)\\.zip",
        "replace": "${2}.0"
    },
    "autoupdate": {
        "url": "https://ftp.vector.co.jp/$match1/OyaziViewer$match2.zip",
        "extract_dir": "OyaziViewer$match2",
        "hash": {
            "url": "$url"
        }
    }
}
