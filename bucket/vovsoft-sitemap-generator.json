{
    "version": "4.5",
    "description": "Portable edition of Vovsoft Sitemap Generator.",
    "homepage": "https://vovsoft.com/software/sitemap-generator/",
    "license": "Proprietary",
    "url": "https://vovsoft.com/files/sitemap-generator-portable.zip?v=4.5",
    "checkver": {
        "url": "https://vovsoft.com/download/sitemap-generator-portable/",
        "regex": "(?is)Version\\s*(?:<[^>]*>\\s*)*:?\\s*(?:<[^>]*>\\s*)*(?<version>\\d+(?:\\.\\d+)+)"
    },
    "autoupdate": {
        "url": "https://vovsoft.com/files/sitemap-generator-portable.zip?v=$version"
    },
    "shortcuts": [
        [
            "sitemap.exe",
            "Vovsoft Sitemap Generator"
        ]
    ],
    "pre_install": [
        "if (-not (Test-Path -LiteralPath \"$dir\\key.txt\" -PathType Leaf)) { New-Item -ItemType File -Path \"$dir\\key.txt\" | Out-Null }"
    ],
    "persist": "key.txt"
}
