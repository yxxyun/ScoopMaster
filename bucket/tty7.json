{
    "version": "26.9.0",
    "description": "A GPU-rendered terminal workbench for shells, persistent sessions, SSH, and coding agents",
    "homepage": "https://github.com/l0ng-ai/tty7",
    "license": "Apache-2.0",
    "notes": [
        "Requires Windows 10 or later",
        "tty7 state is stored in Scoop persist and selected through TTY7_CONFIG_DIR",
        "An existing %APPDATA%\\tty7 directory is migrated and retained as a timestamped backup",
        "Installing, updating, or uninstalling stops the persistent daemon and ends its live shell sessions",
        "SSH secrets remain in Windows Credential Manager; external coding-agent configs are not managed by this package",
        "The current Windows portable archive does not bundle tty7-server for offline WSL deployment"
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/l0ng-ai/tty7/releases/download/v26.9.0/tty7-26.9.0-windows-x86_64.zip",
            "hash": "0802b29cb65beb6504ec18b0ff86c81f54fbde080c7b96436a8ca16d77592252"
        }
    },
    "pre_install": [
        "$source = Join-Path $env:APPDATA 'tty7'",
        "$target = Join-Path $persist_dir 'data'",
        "$expected = [IO.Path]::GetFullPath($target).TrimEnd('\\')",
        "$configured = [Environment]::GetEnvironmentVariable('TTY7_CONFIG_DIR', 'User')",
        "if ($configured) {",
        "    $actual = [IO.Path]::GetFullPath([Environment]::ExpandEnvironmentVariables($configured)).TrimEnd('\\')",
        "    if ($actual -ine $expected) {",
        "        throw \"TTY7_CONFIG_DIR is already managed outside this package: $configured\"",
        "    }",
        "}",
        "ensure $target",
        "",
        "$stopDaemon = {",
        "    param([string]$configDir)",
        "    $arguments = \"--config-dir `\"$configDir`\" --stop-daemon\"",
        "    $process = Start-Process -FilePath (Join-Path $dir 'tty7.exe') -ArgumentList $arguments -WindowStyle Hidden -Wait -PassThru",
        "    if ($process.ExitCode -ne 0) {",
        "        throw \"tty7 --stop-daemon failed with exit code $($process.ExitCode): $configDir\"",
        "    }",
        "}",
        "& $stopDaemon $target",
        "",
        "if (Test-Path $source) {",
        "    $item = Get-Item -LiteralPath $source -Force",
        "    if ($item.Attributes -band [IO.FileAttributes]::ReparsePoint) {",
        "        throw \"Refusing to migrate an existing reparse point: $source\"",
        "    }",
        "    if (-not $item.PSIsContainer) {",
        "        throw \"Existing tty7 path is not a directory: $source\"",
        "    }",
        "",
        "    & $stopDaemon $source",
        "    & robocopy $source $target /E /R:1 /W:1 /NFL /NDL /NJH /NJS /NP | Out-Null",
        "    $copyExitCode = $LASTEXITCODE",
        "    if ($copyExitCode -gt 7) {",
        "        throw \"tty7 data migration failed with robocopy exit code ${copyExitCode}: $source\"",
        "    }",
        "",
        "    $backup = \"$source.backup-$(Get-Date -Format 'yyyyMMdd-HHmmss')\"",
        "    Move-Item -LiteralPath $source -Destination $backup -Force",
        "    Write-Host \"Backed up original tty7 data directory: $backup\"",
        "}"
    ],
    "bin": "tty7.exe",
    "shortcuts": [
        [
            "tty7.exe",
            "tty7"
        ]
    ],
    "pre_uninstall": [
        "$configDir = Join-Path $persist_dir 'data'",
        "$arguments = \"--config-dir `\"$configDir`\" --stop-daemon\"",
        "$process = Start-Process -FilePath (Join-Path $dir 'tty7.exe') -ArgumentList $arguments -WindowStyle Hidden -Wait -PassThru",
        "if ($process.ExitCode -ne 0) {",
        "    throw \"tty7 --stop-daemon failed with exit code $($process.ExitCode): $configDir\"",
        "}"
    ],
    "env_set": {
        "TTY7_CONFIG_DIR": "$persist_dir\\data"
    },
    "persist": "data",
    "checkver": {
        "github": "https://github.com/l0ng-ai/tty7"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/l0ng-ai/tty7/releases/download/v$version/tty7-$version-windows-x86_64.zip"
            }
        }
    }
}
