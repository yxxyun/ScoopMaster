{
    "version": "1.5",
    "description": "Portable edition of Vovsoft Merge XML Files.",
    "homepage": "https://vovsoft.com/software/merge-xml-files/",
    "license": "Proprietary",
    "url": "https://vovsoft.com/files/merge-xml-files-portable.zip?v=1.5",
    "checkver": {
        "url": "https://vovsoft.com/download/merge-xml-files-portable/",
        "regex": "(?is)Version\\s*(?:<[^>]*>\\s*)*:?\\s*(?:<[^>]*>\\s*)*(?<version>\\d+(?:\\.\\d+)+)"
    },
    "autoupdate": {
        "url": "https://vovsoft.com/files/merge-xml-files-portable.zip?v=$version"
    },
    "shortcuts": [
        [
            "mergexml.exe",
            "Vovsoft Merge XML Files"
        ]
    ],
    "notes": [
        "SHA-256 has not been verified; archive contents and the shortcut target have been checked."
    ],
    "pre_install": [
        "if (-not (Test-Path -LiteralPath \"$dir\\key.txt\" -PathType Leaf)) { New-Item -ItemType File -Path \"$dir\\key.txt\" | Out-Null }"
    ],
    "persist": "key.txt"
}
