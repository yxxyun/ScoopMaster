{
    "version": "0.10.54",
    "description": "Local document reader and research workspace with bundled Python runtime.",
    "homepage": "https://github.com/chenxiachan/textfold",
    "license": "Apache-2.0",
    "architecture": {
        "64bit": {
            "url": "https://github.com/chenxiachan/textfold/releases/download/v0.10.54/TextFold-win-x64-setup.exe#/dl.7z",
            "hash": "4e34f33e58e6143d8fa99aab66495f2f94210344fde33499f10dde35e64bc1a9"
        }
    },
    "extract_dir": "$PLUGINSDIR",
    "pre_install": "Expand-7zipArchive \"$dir\\app-64.7z\" \"$dir\" -Removal",
    "pre_uninstall": [
        "$exe = [System.IO.Path]::GetFullPath((Join-Path $dir 'TextFold.exe'))",
        "$schemeKey = 'HKCU:\\Software\\Classes\\textfold'",
        "$schemeCommandKey = Join-Path $schemeKey 'shell\\open\\command'",
        "$schemeCommand = if (Test-Path -LiteralPath $schemeCommandKey) { [string](Get-Item -LiteralPath $schemeCommandKey).GetValue('') }",
        "if ($schemeCommand -and $schemeCommand.IndexOf($exe, [System.StringComparison]::OrdinalIgnoreCase) -ge 0) { Remove-Item -LiteralPath $schemeKey -Recurse -Force }"
    ],
    "bin": "TextFold.exe",
    "shortcuts": [
        [
            "TextFold.exe",
            "TextFold"
        ]
    ],
    "checkver": {
        "url": "https://api.github.com/repos/chenxiachan/textfold/releases/latest",
        "jsonpath": "$.tag_name",
        "regex": "v([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/chenxiachan/textfold/releases/download/v$version/TextFold-win-x64-setup.exe#/dl.7z",
                "hash": {
                    "url": "https://api.github.com/repos/chenxiachan/textfold/releases/tags/v$version",
                    "regex": "\"name\"\\s*:\\s*\"TextFold-win-x64-setup\\.exe\"[\\s\\S]*?\"digest\"\\s*:\\s*\"sha256:([a-f0-9]{64})\""
                }
            }
        }
    },
    "notes": [
        "The textfold:// protocol is registered on first launch. Scoop removes the registration on updates and uninstall only when it points to this Scoop installation; launch TextFold again after updating to re-register it.",
        "The document library remains under %LOCALAPPDATA%\\TextFold and application settings under %USERPROFILE%\\.textfold, outside the Scoop app directory. Use Scoop for updates."
    ]
}
