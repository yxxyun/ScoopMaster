{
    "version": "0.0.2.2",
    "description": "A reimplementation of Windows conhost.",
    "homepage": "https://github.com/YexuanXiao/corehost",
    "license": "MIT",
    "notes": "Install selects CoreHost. Uninstall clears the selection. Requires HKCU:\\Console\\%%Startup.",
    "architecture": {
        "64bit": {
            "url": "https://github.com/YexuanXiao/corehost/releases/download/v0.0.2.2/corehost_x64.exe#/corehost.exe",
            "hash": "95b64cb22ad345baf87069cc61cc62807a03ce89c81ac30b2af15b1606482a07"
        },
        "arm64": {
            "url": "https://github.com/YexuanXiao/corehost/releases/download/v0.0.2.2/corehost_arm64.exe#/corehost.exe",
            "hash": "6a296856190d4528d6ea6be9fc22b0a32d814d67eada34bb351c8d96d0b4c469"
        }
    },
    "post_install": [
        "$corehostClsid = '{47A3A1A0-2D3C-4F5E-8B1A-9C3D4E5F6A7B}'",
        "$serverKey = \"HKCU:\\Software\\Classes\\CLSID\\$corehostClsid\\LocalServer32\"",
        "",
        "$null = New-Item $serverKey -Force",
        "Set-ItemProperty $serverKey -Name '(Default)' -Value \"$dir\\corehost.exe\"",
        "",
        "Set-ItemProperty 'HKCU:\\Console\\%%Startup' -Name DelegationConsole -Value $corehostClsid"
    ],
    "uninstaller": {
        "script": [
            "Remove-ItemProperty 'HKCU:\\Console\\%%Startup' -Name DelegationConsole",
            "Remove-Item 'HKCU:\\Software\\Classes\\CLSID\\{47A3A1A0-2D3C-4F5E-8B1A-9C3D4E5F6A7B}' -Recurse"
        ]
    },
    "bin": "corehost.exe",
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/YexuanXiao/corehost/releases/download/v$version/corehost_x64.exe#/corehost.exe"
            },
            "arm64": {
                "url": "https://github.com/YexuanXiao/corehost/releases/download/v$version/corehost_arm64.exe#/corehost.exe"
            }
        }
    }
}
