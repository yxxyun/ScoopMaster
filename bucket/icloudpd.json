{
    "version": "1.32.4",
    "description": "A command-line tool to download photos from iCloud",
    "homepage": "https://github.com/pedoc/icloud_photos_downloader",
    "license": "MIT",
    "notes": "Includes indexing state diagnostics from the pedoc fork. This does not bypass Apple's indexing check.",
    "architecture": {
        "64bit": {
            "url": "https://gh-proxy.org/https://github.com/pedoc/icloud_photos_downloader/releases/download/v1.32.4-windows.1/icloudpd-1.32.4-windows-amd64.exe",
            "hash": "5bcd9570bc7b1a2eca5b1779a027852a6a7af18cd832d070b0b99f036472971f"
        }
    },
    "bin": [
        [
            "icloudpd-1.32.4-windows-amd64.exe",
            "icloudpd"
        ]
    ],
    "checkver": {
        "url": "https://api.github.com/repos/pedoc/icloud_photos_downloader/releases/latest",
        "jsonpath": "$.assets[*].browser_download_url",
        "regex": "download/(?<tag>v(?<ver>[\\d.]+)-windows\\.(?<revision>\\d+))/(?<asset>icloudpd-[\\d.]+-windows-amd64\\.exe)(?![\\w.])",
        "replace": "${ver}-windows.${revision}"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://gh-proxy.org/https://github.com/pedoc/icloud_photos_downloader/releases/download/$matchTag/$matchAsset"
            }
        },
        "bin": [
            [
                "$matchAsset",
                "icloudpd"
            ]
        ]
    }
}
