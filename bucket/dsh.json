{
    "##": "Stable channel. Upstream only ships an electron-builder NSIS installer (no portable zip) for this channel, so this manifest runs it silently into $dir and delegates removal to the app's own 'Uninstall DSH NEXT.exe'.",
    "version": "2.0.18",
    "description": "DeepSeek Harness 桌面端（stable 通道）—— 万事皆插件的 Electron 桌面壳",
    "homepage": "https://github.com/anywhere-labs/dsh-desktop",
    "license": {
        "identifier": "MIT",
        "url": "https://github.com/anywhere-labs/dsh-desktop/blob/master/LICENSE"
    },
    "notes": [
        "stable 通道用官方 NSIS 安装器静默装到 Scoop 目录；卸载走官方 Uninstall DSH NEXT.exe",
        "想跟预览版请装 dsh-next（便携 zip，免安装器）",
        "配置与数据在 %APPDATA%\\DSH NEXT，Scoop 不接管"
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/anywhere-labs/dsh-desktop/releases/download/v2.0.18/DSH-Desktop-2.0.18-x64-Setup.exe",
            "hash": "d1edf6ef53156542e06836e2a478dc3508599a3290c5402eb32f771e7bb09f39"
        }
    },
    "installer": {
        "script": [
            "$installer = Join-Path $dir $fname",
            "Start-Process -FilePath $installer -ArgumentList '/S', \"/D=$dir\" -Wait",
            "Remove-Item $installer -Force"
        ]
    },
    "uninstaller": {
        "script": [
            "$uninst = Join-Path $dir 'Uninstall DSH NEXT.exe'",
            "if (!(Test-Path -LiteralPath $uninst)) { $uninst = Join-Path $env:LOCALAPPDATA 'Programs\\DSH NEXT\\Uninstall DSH NEXT.exe' }",
            "if (Test-Path -LiteralPath $uninst) { Start-Process -FilePath $uninst -ArgumentList '/S' -Wait }"
        ]
    },
    "checkver": {
        "url": "https://github.com/anywhere-labs/dsh-desktop/releases.atom",
        "regex": "releases/tag/v([\\d.]+)\""
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/anywhere-labs/dsh-desktop/releases/download/v$version/DSH-Desktop-$version-x64-Setup.exe"
            }
        },
        "hash": {
            "url": "https://github.com/anywhere-labs/dsh-desktop/releases/download/v$version/SHA256SUMS.txt"
        }
    }
}
