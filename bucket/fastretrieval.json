{
    "version": "1.16.0",
    "description": "Multi-model retrieval runtime for ONNX and GGUF embeddings and reranking",
    "homepage": "https://github.com/n24q02m/fastretrieval",
    "license": "Apache-2.0",
    "depends": "uv",
    "url": [
        "https://files.pythonhosted.org/packages/f1/1b/8a1b10c24a2d61af8d5f94791cf5aaace924f26f7aaa7f2f0128502869c1/fastretrieval-1.16.0-py3-none-any.whl#/fastretrieval-1.16.0-py3-none-any.whl",
        "https://raw.githubusercontent.com/n24q02m/scoop-bucket/main/locks/fastretrieval-1.16.0.txt#/requirements.txt",
        "https://raw.githubusercontent.com/n24q02m/scoop-bucket/main/locks/fastretrieval-1.16.0.build.txt#/build-requirements.txt"
    ],
    "hash": [
        "4729ad3ef6fb087258e48d4fea4091ae69bbcac876da06711e4414105abcb092",
        "80a097724634c6fb1bdc99cfc0110b13ca92612f34336b492af3464772f37ec8",
        "3b55c1e0bf042180847028148bcb5e23f3e9a9e8ab4f5c8ec4d10d1ffacee21f"
    ],
    "installer": {
        "script": [
            "# Every dependency is pinned by hash: requirements.txt is the release tag's uv.lock exported",
            "# by bump.py, build-requirements.txt the build backends of dependencies that ship only an sdist.",
            "# The lock is the release's resolved environment, uv overrides included, so there is no `uv pip check`.",
            "$py = \"$dir\\venv\\Scripts\\python.exe\"",
            "$pinned = @('--python', $py, '--require-hashes', '--only-binary', ':all:', '--no-deps', '--quiet')",
            "uv venv \"$dir\\venv\" --python 3.13 --quiet",
            "if ($LASTEXITCODE) { throw 'uv venv failed' }",
            "uv pip install @pinned -r \"$dir\\build-requirements.txt\"",
            "if ($LASTEXITCODE) { throw 'uv pip install (build backends) failed' }",
            "uv pip install @pinned --no-build-isolation -r \"$dir\\requirements.txt\"",
            "if ($LASTEXITCODE) { throw 'uv pip install (dependencies) failed' }",
            "uv pip install --python $py --no-deps --quiet (Get-ChildItem \"$dir\\*.whl\").FullName",
            "if ($LASTEXITCODE) { throw 'uv pip install (wheel) failed' }"
        ]
    },
    "bin": [
        [
            "venv\\Scripts\\fastretrieval-server.exe",
            "fastretrieval-server"
        ]
    ]
}
