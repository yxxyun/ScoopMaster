        },
        "arm64": {
            "url": "https://github.com/yetone/magpie-releases/releases/download/v0.1.4829/magpie-windows-arm64.exe#/magpie.exe",
            "hash": "31f7135f27b32251bfae89ea4d759c90343644778d98d2510b25291fe5102d22"
        }
    },
    "pre_install": [
        "if (-not (Test-Path -LiteralPath \"$persist_dir\\data\\settings.json\" -PathType Leaf)) {",
        "    ensure \"$dir\\data\" | Out-Null",
