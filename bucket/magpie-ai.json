        },
        "arm64": {
            "url": "https://github.com/yetone/magpie-releases/releases/download/v0.1.4510/magpie-windows-arm64.exe#/magpie.exe",
            "hash": "15a3155399ca787623e02132ddd7c61a38fa521be9f9b8f30a8fbac0fa74d5a2"
        }
    },
    "pre_install": [
        "if (-not (Test-Path -LiteralPath \"$persist_dir\\data\\settings.json\" -PathType Leaf)) {",
        "    ensure \"$dir\\data\" | Out-Null",
        "    @{ noAutoUpdate = $true } | ConvertTo-Json | Set-Content -LiteralPath \"$dir\\data\\settings.json\" -Force -Encoding ASCII",
        "}"
    ],
    "shortcuts": [
        [
            "magpie.exe",
            "Magpie"
        ]
    ],
    "persist": "data",
    "checkver": {
        "github": "https://github.com/yetone/magpie-releases"
    },
    "autoupdate": {
