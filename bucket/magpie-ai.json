            "hash": "6ce92f13eb153b0b835a55aee52744403ae4086375087a0038cd60f2abf062c6"
        }
    },
    "pre_install": [
        "if (-not (Test-Path -LiteralPath \"$persist_dir\\data\\settings.json\" -PathType Leaf)) {",
