{
    "version": "0.1.3820",
    "description": "Unified model, provider, and gateway manager for AI coding agents. (rolling release, tracks GitHub latest)",
    "homepage": "https://usemagpie.ai",
    "license": "MIT",
    "notes": [
        "Tracks the latest GitHub releases of Magpie (rolling channel), auto-updated by CI every 6 hours.",
        "To update: exit Magpie (tray - Quit) first, then run 'scoop update' followed by 'scoop update magpie-ai'. Scoop silently skips update/uninstall while Magpie is running.",
        "In-app auto update is preset off via data/settings.json (only when it doesn't already exist; existing settings are kept as-is).",
        "scoop uninstall won't remove external integration (Open at login, magpie:// handler, user PATH entry from Settings - Command line). Use in-app Settings - Uninstall magpie to clean up, or 'magpie uninstall --keep-data' to keep settings."
    ],
    "suggest": {
        "WebView2": "extras/webview2"
    },
    "architecture": {
        "64bit": {
            "url": [
                "https://github.com/yetone/magpie-releases/releases/download/v0.1.3820/magpie-windows-amd64.exe#/magpie.exe",
                "https://github.com/yetone/magpie-releases/releases/download/v0.1.3820/magpie-cli-windows-amd64.exe#/magpie-cli.exe"
            ],
            "hash": [
                "d886df636105f10ccecc6e55cb02bc7df3824ff5fd6a9912541baa7db0f0d8e2",
                "25e3fd4420ef58824e1938002631979986bf1e80e17873d396219a03d7022fe3"
            ]
        },
        "arm64": {
            "url": [
                "https://github.com/yetone/magpie-releases/releases/download/v0.1.3820/magpie-windows-arm64.exe#/magpie.exe",
                "https://github.com/yetone/magpie-releases/releases/download/v0.1.3820/magpie-cli-windows-arm64.exe#/magpie-cli.exe"
            ],
            "hash": [
                "c9984c09f2e219e2e19465d53bb4b863300f5b35b1a564bb1b1dce12272f3e24",
                "c6fb2180e00bb5a5de7565c939ddebab93d9882a29d77a3b3e4e7abbbf8aea58"
            ]
        }
    },
    "pre_install": [
        "if (-not (Test-Path -LiteralPath \"$persist_dir\\data\\settings.json\" -PathType Leaf)) {",
        "    ensure \"$dir\\data\" | Out-Null",
        "    @{ noAutoUpdate = $true } | ConvertTo-Json | Set-Content -LiteralPath \"$dir\\data\\settings.json\" -Force -Encoding ASCII",
        "}"
    ],
    "bin": [
        [
            "magpie-cli.exe",
            "magpie"
        ]
    ],
    "shortcuts": [
        [
            "magpie.exe",
            "Magpie AI"
        ]
    ],
    "persist": "data",
    "checkver": {
        "github": "https://github.com/yetone/magpie-releases"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": [
                    "https://github.com/yetone/magpie-releases/releases/download/v$version/magpie-windows-amd64.exe#/magpie.exe",
                    "https://github.com/yetone/magpie-releases/releases/download/v$version/magpie-cli-windows-amd64.exe#/magpie-cli.exe"
                ]
            },
            "arm64": {
                "url": [
                    "https://github.com/yetone/magpie-releases/releases/download/v$version/magpie-windows-arm64.exe#/magpie.exe",
                    "https://github.com/yetone/magpie-releases/releases/download/v$version/magpie-cli-windows-arm64.exe#/magpie-cli.exe"
                ]
            }
        },
        "hash": {
            "url": "$baseurl/SHA256SUMS"
        }
    }
}
