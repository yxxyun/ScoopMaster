            "hash": "df08b9753e1bf01a26eacfc8457de97475f787709105bc2e6e6d93d6fc3f42dd"
        },
        "arm64": {
            "url": "https://github.com/yetone/magpie-releases/releases/download/v0.1.1566/magpie-windows-arm64.exe#/magpie.exe",
            "hash": "f7fa380ea71e5953ac7647600f5f06c8a7edc9e3dedf424fe0cb4e5764b3bd5e"
        }
    },
    "pre_install": [
        "if (-not (Test-Path -LiteralPath \"$persist_dir\\data\\settings.json\" -PathType Leaf)) {",
        "    ensure \"$dir\\data\" | Out-Null",
        "    @{ noAutoUpdate = $true } | ConvertTo-Json | Set-Content -LiteralPath \"$dir\\data\\settings.json\" -Force -Encoding ASCII",
        "}"
    ],
    "shortcuts": [
        [
            "magpie.exe",
            "Magpie"
        ]
    ],
    "persist": "data",
    "checkver": {
        "github": "https://github.com/yetone/magpie-releases"
    },
    "autoupdate": {
        "architecture": {
