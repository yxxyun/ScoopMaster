        },
        "arm64": {
            "url": "https://github.com/yetone/magpie-releases/releases/download/v0.1.2357/magpie-windows-arm64.exe#/magpie.exe",
            "hash": "a1385689dbb95e7a406b199ec2c9f2e0ca207b818b79fc2f45aae2c4e2fbf203"
        }
    },
    "pre_install": [
        "if (-not (Test-Path -LiteralPath \"$persist_dir\\data\\settings.json\" -PathType Leaf)) {",
        "    ensure \"$dir\\data\" | Out-Null",
