            "hash": "82eec25b019a9df221c4f8b31a0df56d00ba09fbddd23e3b9c02bf9ccf1d0d10"
        },
        "arm64": {
            "url": "https://github.com/yetone/magpie-releases/releases/download/v0.1.2281/magpie-windows-arm64.exe#/magpie.exe",
            "hash": "1f785c188d0cfc07dc2ceb24cf4b3867c0c0b8c51aef45cd5fd2a4d8916341c8"
        }
    },
    "pre_install": [
        "if (-not (Test-Path -LiteralPath \"$persist_dir\\data\\settings.json\" -PathType Leaf)) {",
        "    ensure \"$dir\\data\" | Out-Null",
        "    @{ noAutoUpdate = $true } | ConvertTo-Json | Set-Content -LiteralPath \"$dir\\data\\settings.json\" -Force -Encoding ASCII",
