            "hash": "308355cc2cf1eb578d0fb9afa22a039b22c5e74684c0c972949fe6aae91a561b"
        }
    },
    "pre_install": [
        "if (-not (Test-Path -LiteralPath \"$persist_dir\\data\\settings.json\" -PathType Leaf)) {",
