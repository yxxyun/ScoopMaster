            "hash": "6797a6d9336001e23a0690e9c2a81724a4adc3230a76a653f88df1085a8b65ac"
        },
        "arm64": {
            "url": "https://github.com/yetone/magpie-releases/releases/download/v0.1.4332/magpie-windows-arm64.exe#/magpie.exe",
            "hash": "8bc1c85339b2d6a697c55d66cf3b58f6144d674e1574a23e83bae7870cc2cc5e"
        }
    },
    "pre_install": [
        "if (-not (Test-Path -LiteralPath \"$persist_dir\\data\\settings.json\" -PathType Leaf)) {",
        "    ensure \"$dir\\data\" | Out-Null",
        "    @{ noAutoUpdate = $true } | ConvertTo-Json | Set-Content -LiteralPath \"$dir\\data\\settings.json\" -Force -Encoding ASCII",
        "}"
    ],
    "shortcuts": [
        [
            "magpie.exe",
            "Magpie"
        ]
    ],
    "persist": "data",
    "checkver": {
        "github": "https://github.com/yetone/magpie-releases"
    },
    "autoupdate": {
