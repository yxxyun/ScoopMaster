        },
        "arm64": {
            "url": "https://github.com/yetone/magpie-releases/releases/download/v0.1.1127/magpie-windows-arm64.exe#/magpie.exe",
            "hash": "3aa2e915b4f4c7e03081dde8f8668698f66376b1e01b599831e4d14a89c6afa6"
        }
    },
    "pre_install": [
        "if (-not (Test-Path -LiteralPath \"$persist_dir\\data\\settings.json\" -PathType Leaf)) {",
        "    ensure \"$dir\\data\" | Out-Null",
