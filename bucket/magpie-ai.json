        },
        "arm64": {
            "url": "https://github.com/yetone/magpie-releases/releases/download/v0.1.3329/magpie-windows-arm64.exe#/magpie.exe",
            "hash": "09fa5e3d63ab0361f3369d89c4a56e69b4bb0ec6f5f44a0adc6082ce17ed40d3"
        }
    },
    "pre_install": [
        "if (-not (Test-Path -LiteralPath \"$persist_dir\\data\\settings.json\" -PathType Leaf)) {",
        "    ensure \"$dir\\data\" | Out-Null",
