{
    "version": "0.9.4",
    "description": "Free, portable Windows toolkit for PC technicians, IT pros, and sysadmins: profile backup and restore, partition management, diagnostics, app deployment and removal, file and network tools, USB image flashing, and email archive tools.",
    "homepage": "https://sakutility.com/",
    "license": "AGPL-3.0-or-later",
    "notes": [
        "S.A.K. Utility keeps its settings, logs and reports in a 'data' folder beside the program.",
        "It refuses a 'data' folder that is a link, so this manifest copies the folder to $persist_dir on update or uninstall and back on install, instead of using Scoop's junction-based persist."
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/RandyNorthrup/S.A.K.-Utility/releases/download/v0.9.4/SAK-Utility-Windows-x64.zip",
            "hash": "ecd73d9b8af0bb9a1496d07d5f4f6b701a26d5bffa015271def6167d154e62da"
        }
    },
    "pre_install": "if (Test-Path \"$persist_dir\\data\" -PathType Container) { Copy-Item \"$persist_dir\\data\" \"$dir\" -Recurse -Force }",
    "shortcuts": [
        [
            "sak_utility.exe",
            "S.A.K. Utility"
        ]
    ],
    "pre_uninstall": [
        "if (Test-Path \"$dir\\data\" -PathType Container) {",
        "    New-Item \"$persist_dir\" -ItemType Directory -Force | Out-Null",
        "    if (Test-Path \"$persist_dir\\data\") { Remove-Item \"$persist_dir\\data\" -Recurse -Force }",
        "    Copy-Item \"$dir\\data\" \"$persist_dir\" -Recurse -Force",
        "}"
    ],
    "checkver": {
        "github": "https://github.com/RandyNorthrup/S.A.K.-Utility"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/RandyNorthrup/S.A.K.-Utility/releases/download/v$version/SAK-Utility-Windows-x64.zip"
            }
        },
        "hash": {
            "url": "$baseurl/SHA256SUMS.txt",
            "regex": "$basename:\\s+$sha256"
        }
    }
}
