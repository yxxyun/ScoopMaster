{
    "version": "1.0.0",
    "description": "Turns a physical numeric keypad into a customizable Windows shortcut and macro controller.",
    "homepage": "https://github.com/Naveen-io/NumDeck",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/Naveen-io/NumDeck/releases/download/v1.0.0/NumDeck-Portable.exe",
            "hash": "fea3dacf61942a7ab67f3e1bf25d270271a666a5afb9e5287e2364dec3f8da80"
        }
    },
    "shortcuts": [
        [
            "NumDeck-Portable.exe",
            "NumDeck"
        ]
    ],
    "checkver": {
        "github": "https://github.com/Naveen-io/NumDeck",
        "regex": "^v(?<version>[\\d.]+)$"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/Naveen-io/NumDeck/releases/download/v$version/NumDeck-Portable.exe"
            }
        },
        "hash": {
            "mode": "json",
            "url": "https://api.github.com/repos/Naveen-io/NumDeck/releases/tags/v$version",
            "jp": "$.assets[?(@.name == '$basename')].digest"
        }
    },
    "notes": "Settings and profiles are stored under %APPDATA%\\NumpadDeck and remain after Scoop uninstall."
}
