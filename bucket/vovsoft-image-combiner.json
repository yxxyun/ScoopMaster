{
    "version": "2.2",
    "description": "Portable edition of Vovsoft Image Combiner.",
    "homepage": "https://vovsoft.com/software/image-combiner/",
    "license": "Proprietary",
    "url": "https://vovsoft.com/files/image-combiner-portable.zip?v=2.2",
    "checkver": {
        "url": "https://vovsoft.com/download/image-combiner-portable/",
        "regex": "(?is)Version\\s*(?:<[^>]*>\\s*)*:?\\s*(?:<[^>]*>\\s*)*(?<version>\\d+(?:\\.\\d+)+)"
    },
    "autoupdate": {
        "url": "https://vovsoft.com/files/image-combiner-portable.zip?v=$version"
    },
    "shortcuts": [
        [
            "combiner.exe",
            "Vovsoft Image Combiner"
        ]
    ],
    "notes": [
        "SHA-256 has not been verified; archive contents and the shortcut target have been checked."
    ],
    "pre_install": [
        "if (-not (Test-Path -LiteralPath \"$dir\\key.txt\" -PathType Leaf)) { New-Item -ItemType File -Path \"$dir\\key.txt\" | Out-Null }"
    ],
    "persist": "key.txt"
}
