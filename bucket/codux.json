    },
    "post_install": "Remove-Item \"$dir\\codux*windows-x86_64-setup.exe\", \"$dir\\Uninstall.exe\" -Force -ErrorAction SilentlyContinue",
    "bin": "Codux.exe",
    "shortcuts": [
        [
            "Codux.exe",
            "Codux"
        ]
    ],
    "checkver": {
        "url": "https://github.com/duxweb/codux/releases",
        "regex": "download/v([\\d.]+)/codux-windows-x86_64-setup\\.exe"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/duxweb/codux/releases/download/v$version/codux-windows-x86_64-setup.exe"
            }
        }
    }
