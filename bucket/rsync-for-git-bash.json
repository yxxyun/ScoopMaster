{
  "version": "3.5.2.256004",
  "description": "rsync optimized for Git for Windows (Git Bash) environment",
  "homepage": "https://github.com/bvarnai/rsync-for-git-bash",
  "license": "GPL-3.0-or-later",
  "url": "https://github.com/bvarnai/rsync-for-git-bash/releases/download/rsync-3.5.2-for-git-2.56.0.windows.4/rsync-3.5.2-for-git-2.56.0.windows.4-64-bit.zip",
  "hash": "a6d6a45e9ca00505b81ab6a4a4b1c11a8bb9c45bea23cce9f51d1a392aa75519",
  "env_add_path": "bin",
  "post_install": [
    "Remove-Item \"$scoopdir\\shims\\rsync.exe\" -Force -ErrorAction SilentlyContinue",
    "$bashShim = @('#!/bin/sh', 'basedir=$(dirname \"$0\")', 'exec \"$basedir/../apps/rsync-for-git-bash/current/bin/rsync.exe\" \"$@\"')",
    "[IO.File]::WriteAllText(\"$scoopdir\\shims\\rsync\", ($bashShim -join \"`n\") + \"`n\")",
    "$cmdShim = @('@echo off', '\"%~dp0..\\apps\\rsync-for-git-bash\\current\\bin\\rsync.exe\" %*')",
    "[IO.File]::WriteAllText(\"$scoopdir\\shims\\rsync.cmd\", ($cmdShim -join \"`r`n\") + \"`r`n\")"
  ],
  "uninstaller": {
    "script": [
      "Remove-Item \"$scoopdir\\shims\\rsync\" -Force -ErrorAction SilentlyContinue",
      "Remove-Item \"$scoopdir\\shims\\rsync.cmd\" -Force -ErrorAction SilentlyContinue",
      "Remove-Item \"$scoopdir\\shims\\rsync.exe\" -Force -ErrorAction SilentlyContinue"
    ]
  },
  "checkver": "github",
  "autoupdate": {
    "url": "https://github.com/bvarnai/rsync-for-git-bash/releases/download/$tag/rsync-$version-for-git-$matchGit-64-bit.zip",
    "hash": {
      "url": "$url.sha256"
    }
  }
}
