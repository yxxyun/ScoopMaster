{
    "version": "0.7.7",
    "description": "Desktop Companion for Hermes Agent",
    "homepage": "https://github.com/fathah/hermes-desktop",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/fathah/hermes-desktop/releases/download/v0.7.7/hermes-desktop-0.7.7-setup.exe#/dl.7z",
            "hash": "sha512:a62de81da48d9c6349d6d6e3e470f34f1c84e608f1cf49ec0326e82428b75d749e9d679d6a4614f380fabfad74e442b05c28d6b18fbcbd359b5a6f9187516ee7"
        }
    },
    "installer": {
        "script": [
            "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-64.7z\" \"$dir\"",
            "Remove-Item \"$dir\\`$PLUGINSDIR\", \"$dir\\Uninstall*\", \"$dir\\`$R0\" -Force -Recurse -ErrorAction SilentlyContinue"
        ]
    },
    "bin": [
        [
            "hermes-agent.exe",
            "hermes-desktop"
        ]
    ],
    "shortcuts": [
        [
            "hermes-agent.exe",
            "Hermes Desktop"
        ]
    ],
    "checkver": {
        "github": "https://github.com/fathah/hermes-desktop"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/fathah/hermes-desktop/releases/download/v$version/hermes-desktop-$version-setup.exe#/dl.7z"
            }
        },
        "hash": {
            "url": "$baseurl/latest.yml",
            "regex": "(?sm)$basename.*?sha512:\\s+$base64"
        }
    }
}
