{
    "version": "0.7.9",
    "description": "Desktop Companion for Hermes Agent",
    "homepage": "https://github.com/fathah/hermes-desktop",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/fathah/hermes-desktop/releases/download/v0.7.9/hermes-desktop-0.7.9-setup.exe#/dl.7z",
            "hash": "sha512:1a94aceb47b210c9eb4db54dd91c93f9c1a2b790f337de07363b7d17a7f24e1d58dc88d59e5c66a92a47191a753572931a6061aa0a3c76cd9ecec95495babfbb"
        }
    },
    "installer": {
        "script": [
            "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-64.7z\" \"$dir\"",
            "Remove-Item \"$dir\\`$PLUGINSDIR\", \"$dir\\Uninstall*\", \"$dir\\`$R0\" -Force -Recurse -ErrorAction SilentlyContinue"
        ]
    },
    "bin": [
        [
            "hermes-agent.exe",
            "hermes-desktop"
        ]
    ],
    "shortcuts": [
        [
            "hermes-agent.exe",
            "Hermes Desktop"
        ]
    ],
    "checkver": {
        "github": "https://github.com/fathah/hermes-desktop"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/fathah/hermes-desktop/releases/download/v$version/hermes-desktop-$version-setup.exe#/dl.7z"
            }
        },
        "hash": {
            "url": "$baseurl/latest.yml",
            "regex": "(?sm)$basename.*?sha512:\\s+$base64"
        }
    }
}
