{
    "version": "0.7.8",
    "description": "Desktop Companion for Hermes Agent",
    "homepage": "https://github.com/fathah/hermes-desktop",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/fathah/hermes-desktop/releases/download/v0.7.8/hermes-desktop-0.7.8-setup.exe#/dl.7z",
            "hash": "sha512:53e9bde7d7403839a0d9548011ce73d930a6440170493073c796022ef259ee92f8af14d5ed53963ae8694e8789c6d0edee808c8a7471ebe7b94812774c1baf87"
        }
    },
    "installer": {
        "script": [
            "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-64.7z\" \"$dir\"",
            "Remove-Item \"$dir\\`$PLUGINSDIR\", \"$dir\\Uninstall*\", \"$dir\\`$R0\" -Force -Recurse -ErrorAction SilentlyContinue"
        ]
    },
    "bin": [
        [
            "hermes-agent.exe",
            "hermes-desktop"
        ]
    ],
    "shortcuts": [
        [
            "hermes-agent.exe",
            "Hermes Desktop"
        ]
    ],
    "checkver": {
        "github": "https://github.com/fathah/hermes-desktop"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/fathah/hermes-desktop/releases/download/v$version/hermes-desktop-$version-setup.exe#/dl.7z"
            }
        },
        "hash": {
            "url": "$baseurl/latest.yml",
            "regex": "(?sm)$basename.*?sha512:\\s+$base64"
        }
    }
}
