{
    "version": "0.0.1",
    "description": "A volume slider for every app, in the tray",
    "homepage": "https://github.com/kidchenko/sonus",
    "license": "MIT",
    "notes": "Sonus lives in the tray. Quit it from its menu before running `scoop update` or `scoop uninstall`.",
    "architecture": {
        "64bit": {
            "url": "https://github.com/kidchenko/sonus/releases/download/v0.0.1/sonus-0.0.1-x64.exe#/sonus.exe",
            "hash": "86c07306015722299734b3411dbb9f2aa4e22f73ab29a41ed0f8f9c1605a8cea"
        }
    },
    "shortcuts": [
        [
            "sonus.exe",
            "Sonus"
        ]
    ],
    "uninstaller": {
        "script": [
            "# Run at login points at this install; settings in $env:APPDATA\\Sonus are kept.",
            "if ($cmd -eq 'uninstall') { Remove-ItemProperty -Path 'HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Run' -Name 'Sonus' -ErrorAction SilentlyContinue }"
        ]
    },
    "checkver": {
        "github": "https://github.com/kidchenko/sonus"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/kidchenko/sonus/releases/download/v$version/sonus-$version-x64.exe#/sonus.exe"
            }
        },
        "hash": {
            "url": "$baseurl/SHA256SUMS.txt"
        }
    }
}
