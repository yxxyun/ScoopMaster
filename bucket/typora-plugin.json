{
    "version": "1.19.4",
    "description": "Typora plugin. feature enhancement tool | Typora 插件，功能增强工具",
    "homepage": "https://github.com/obgnail/typora_plugin",
    "license": "MIT",
    "notes": [
        "Close Typora before installing or uninstalling, then restart it afterwards.",
        "To verify the install: right-click in the Typora editor area and look for the plugin menu.",
        "If Typora reports 'file write failed' when saving plugin settings, grant write permission to the 'plugin' folder or run its 'bin\\ensure_permissions.ps1'.",
        "User settings (plugin\\global\\settings\\settings.user.toml) are preserved when updating the plugin."
    ],
    "depends": "typora",
    "url": "https://github.com/obgnail/typora_plugin/releases/download/1.19.4/typora-plugin@v1.19.4.zip",
    "hash": "6b1e80bc89498c7b6e4a3d9ce1e137f182d898abc7404d817b6c97cc2a324dd8",
    "installer": {
        "script": [
            "$typora = \"$(scoop prefix typora)\"",
            "$resources = \"$typora\\resources\"",
            "$windowHtml = \"$resources\\window.html\"",
            "$pluginScript = '<script src=\"./plugin/index.js\" defer=\"defer\"></script>'",
            "if (Get-Process -Name 'Typora' -ErrorAction SilentlyContinue) { throw 'Please close Typora before installing typora-plugin.' }",
            "if (!(Test-Path -LiteralPath $windowHtml)) { throw \"Typora window.html not found at $windowHtml (expected the official Typora layout).\" }",
            "$pluginDir = \"$resources\\plugin\"",
            "$settingsUser = \"$pluginDir\\global\\settings\\settings.user.toml\"",
            "$settingsBackup = Join-Path $dir 'settings.user.toml.bak'",
            "if (Test-Path -LiteralPath $settingsUser) { Copy-Item -LiteralPath $settingsUser -Destination $settingsBackup -Force }",
            "Copy-Item -LiteralPath \"$dir\\plugin\" -Destination $pluginDir -Recurse -Force",
            "if (Test-Path -LiteralPath $settingsBackup) { New-Item -ItemType Directory -Force -Path \"$pluginDir\\global\\settings\" | Out-Null; Copy-Item -LiteralPath $settingsBackup -Destination $settingsUser -Force }",
            "$bytes = [System.IO.File]::ReadAllBytes($windowHtml)",
            "$hasBom = ($bytes.Length -ge 3) -and ($bytes[0] -eq 0xEF) -and ($bytes[1] -eq 0xBB) -and ($bytes[2] -eq 0xBF)",
            "$content = [System.Text.Encoding]::UTF8.GetString($bytes)",
            "if (-not $content.Contains($pluginScript)) {",
            "    $frameScript = $null",
            "    if (Test-Path -LiteralPath \"$resources\\appsrc\") { $frameScript = '<script src=\"./appsrc/window/frame.js\" defer=\"defer\"></script>' }",
            "    elseif (Test-Path -LiteralPath \"$resources\\app\") { $frameScript = '<script src=\"./app/window/frame.js\" defer=\"defer\"></script>' }",
            "    else { throw \"Could not detect the Typora layout: neither 'appsrc' nor 'app' exists under $resources.\" }",
            "    if (-not $content.Contains($frameScript)) { throw 'Unexpected Typora window.html: expected frame script tag was not found.' }",
            "    Copy-Item -LiteralPath $windowHtml -Destination \"$resources\\window.html.bak\" -Force",
            "    $newContent = $content.Replace($frameScript, ($frameScript + $pluginScript))",
            "    [System.IO.File]::WriteAllBytes($windowHtml, (New-Object System.Text.UTF8Encoding($hasBom)).GetBytes($newContent))",
            "}"
        ]
    },
    "uninstaller": {
        "script": [
            "$resources = \"$(scoop prefix typora)\\resources\"",
            "$windowHtml = \"$resources\\window.html\"",
            "$pluginScript = '<script src=\"./plugin/index.js\" defer=\"defer\"></script>'",
            "if (Get-Process -Name 'Typora' -ErrorAction SilentlyContinue) { throw 'Please close Typora before uninstalling typora-plugin.' }",
            "if (Test-Path -LiteralPath $windowHtml) {",
            "    $bytes = [System.IO.File]::ReadAllBytes($windowHtml)",
            "    $hasBom = ($bytes.Length -ge 3) -and ($bytes[0] -eq 0xEF) -and ($bytes[1] -eq 0xBB) -and ($bytes[2] -eq 0xBF)",
            "    $content = [System.Text.Encoding]::UTF8.GetString($bytes)",
            "    if ($content.Contains($pluginScript)) {",
            "        $newContent = $content.Replace($pluginScript, '')",
            "        [System.IO.File]::WriteAllBytes($windowHtml, (New-Object System.Text.UTF8Encoding($hasBom)).GetBytes($newContent))",
            "    }",
            "}",
            "Remove-Item -LiteralPath \"$resources\\window.html.bak\" -Force -ErrorAction SilentlyContinue",
            "Remove-Item -LiteralPath \"$resources\\plugin\" -Recurse -Force -ErrorAction SilentlyContinue"
        ]
    },
    "checkver": "github",
    "autoupdate": {
        "url": "https://github.com/obgnail/typora_plugin/releases/download/$version/typora-plugin@v$version.zip"
    }
}
