{
    "##": "The official launcher uses the adjacent persisted data and downloads folders.",
    "version": "0.3.0",
    "description": "Self-hosted BitTorrent client with a web panel, torrent management, a media library, and Android TV streaming.",
    "homepage": "https://github.com/JonathanNet/NordTorrent",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/JonathanNet/NordTorrent/releases/download/v0.3.0/nordtorrent-0.3.0-windows-x64.zip",
            "hash": "d2c108e4523e6135692af612f5083de76a0380f6818f3d205aefa5593539b3e8"
        }
    },
    "shortcuts": [
        [
            "run-nordtorrent.cmd",
            "NordTorrent"
        ]
    ],
    "persist": [
        "data",
        "downloads"
    ],
    "checkver": {
        "github": "https://github.com/JonathanNet/NordTorrent"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/JonathanNet/NordTorrent/releases/download/v$version/nordtorrent-$version-windows-x64.zip",
                "hash": {
                    "url": "https://api.github.com/repos/JonathanNet/NordTorrent/releases/tags/v$version",
                    "jsonpath": "$.assets[?(@.name == '$basename')].digest"
                }
            }
        }
    },
    "notes": "The server listens on 0.0.0.0:8080 by default; BitTorrent peer traffic uses TCP/UDP 42000–42009. Do not expose port 8080 directly to the internet; use HTTPS through a reverse proxy."
}
