{
    "version": "1.1.7",
    "description": "一个 AI 终端管理工具，支持多项目、多终端布局管理",
    "homepage": "https://github.com/dreamlonglll/mini-term",
    "license": "Unknown",
    "notes": [
        "Mini-Term 是一个 AI 终端管理工具，支持多项目、多标签、分屏布局",
        "主程序文件名为 mini-term.exe，已注册为命令 mini-term",
        "用户数据目录：%APPDATA%\\com.mini-term.app\\（config.json、config.db、themes、usage.db 等）",
        "本包会将该目录持久化到 Scoop 的 persist，并在原路径创建 Junction 指向 persist",
        "Claude Code、Codex 等外部工具自身的配置仍保留在 %USERPROFILE%\\.claude\\、%USERPROFILE%\\.codex\\，不由本包管理"
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/dreamlonglll/mini-term/releases/download/v1.1.7/Mini-Term_1.1.7_x64-setup.exe#/dl.7z",
            "hash": "869d7a2cd6dc4a74576a9bcf36f26455c2d123e05c5e2dd9746063132c480128"
        }
    },
    "pre_install": "Remove-Item \"$dir\\`$*\", \"$dir\\uninstall.exe\" -Force -Recurse -ErrorAction SilentlyContinue",
    "bin": [
        [
            "mini-term.exe",
            "mini-term"
        ]
    ],
    "shortcuts": [
        [
            "mini-term.exe",
            "Mini-Term"
        ]
    ],
    "post_install": [
        "$source = Join-Path $env:APPDATA 'com.mini-term.app'",
        "$target = Join-Path $persist_dir 'data'",
        "ensure $target",
        "",
        "if (Test-Path $source) {",
        "    $item = Get-Item -LiteralPath $source -Force",
        "    if ($item.Attributes -band [IO.FileAttributes]::ReparsePoint) {",
        "        Write-Host \"检测到已存在的联接点：$source，跳过创建\"",
        "        return",
        "    }",
        "    if (-not $item.PSIsContainer) {",
        "        throw \"配置路径已存在且不是目录：$source\"",
        "    }",
        "",
        "    & robocopy $source $target /E /R:1 /W:1 /NFL /NDL /NJH /NJS /NP | Out-Null",
        "    if ($LASTEXITCODE -gt 7) {",
        "        Write-Host \"迁移失败，保留原目录：$source\"",
        "        return",
        "    }",
        "",
        "    $backup = \"$source.backup-$(Get-Date -Format 'yyyyMMdd-HHmmss')\"",
        "    try {",
        "        Move-Item -LiteralPath $source -Destination $backup -Force",
        "        Write-Host \"已备份原配置目录：$backup\"",
        "    } catch {",
        "        Write-Host \"无法重命名原目录：$source\"",
        "        return",
        "    }",
        "}",
        "",
        "New-Item -Path $source -ItemType Junction -Value $target | Out-Null"
    ],
    "post_uninstall": [
        "$source = Join-Path $env:APPDATA 'com.mini-term.app'",
        "if (Test-Path $source) {",
        "    $item = Get-Item -LiteralPath $source -Force",
        "    if ($item.Attributes -band [IO.FileAttributes]::ReparsePoint) {",
        "        Remove-Item -LiteralPath $source -Force",
        "    }",
        "}"
    ],
    "persist": "data",
    "checkver": {
        "github": "https://github.com/dreamlonglll/mini-term"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/dreamlonglll/mini-term/releases/download/v$version/Mini-Term_$version_x64-setup.exe#/dl.7z"
            }
        }
    }
}
