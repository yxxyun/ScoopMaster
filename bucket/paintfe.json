{
    "version": "1.5.5",
    "description": "Free portable raster image editor with layers, brushes, filters, animation and Rhai scripting",
    "homepage": "https://paintfe.com/",
    "license": "MIT",
    "notes": [
        "The portable executable is unsigned. SmartScreen may show \"Windows protected your PC\"; choose More info, then Run anyway.",
        "JPEG XL opening is built in. Saving as JPEG XL needs the optional encoder from Preferences > Optional features (or import PaintFE-pack-jxl-*.pfepack).",
        "This install uses portable storage. paintfe_data, paintfe_settings.cfg and paintfe_storage.cfg are kept across Scoop updates."
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/kylejckson/PaintFE/releases/download/v1.5.5/PaintFE-windows-x64.zip",
            "hash": "c714c569a9d0d421d14e0ed5cc44594891cc5c23e2ec345b1d2e3e683dd04561",
            "extract_dir": "PaintFE-windows-x64"
        }
    },
    "pre_install": [
        "if (!(Test-Path \"$persist_dir\\paintfe_settings.cfg\")) { New-Item \"$dir\\paintfe_settings.cfg\" -ItemType File -Force | Out-Null }",
        "if (!(Test-Path \"$persist_dir\\paintfe_storage.cfg\")) { Set-Content -LiteralPath \"$dir\\paintfe_storage.cfg\" -Value 'portable' -NoNewline -Encoding ascii }"
    ],
    "bin": "PaintFE.exe",
    "shortcuts": [
        [
            "PaintFE.exe",
            "PaintFE"
        ]
    ],
    "persist": [
        "paintfe_data",
        "paintfe_settings.cfg",
        "paintfe_storage.cfg"
    ],
    "checkver": {
        "github": "https://github.com/kylejckson/PaintFE"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/kylejckson/PaintFE/releases/download/v$version/PaintFE-windows-x64.zip"
            }
        },
        "hash": {
            "url": "https://github.com/kylejckson/PaintFE/releases/download/v$version/checksums-SHA256.txt"
        }
    }
}
