{
    "version": "0.7.2",
    "description": "OpenRGB compatible high-performance SDK server for VIA per-key RGB",
    "homepage": "https://github.com/Azarattum/ColorHoster",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/Azarattum/ColorHoster/releases/download/v0.7.2/ColorHoster-Windows-msvc-x86_64.zip",
            "hash": "c3d38044c25e0d3c8cbd845dab323a1123466b3492fe28c270375f371b8d7598"
        }
    },
    "bin": "ColorHoster.exe",
    "persist": [
        "configs",
        "profiles"
    ],
    "post_install": [
        "if (!(Test-Path \"$dir\\configs\")) { New-Item -ItemType Directory -Path \"$dir\\configs\" | Out-Null }",
        "if ((Test-Path \"$persist_dir\\colorhoster.toml\") -and !(Test-Path \"$dir\\colorhoster.toml\")) { Copy-Item \"$persist_dir\\colorhoster.toml\" \"$dir\\colorhoster.toml\" -Force }"
    ],
    "pre_uninstall": [
        "if (Test-Path \"$dir\\colorhoster.toml\") {",
        "    Copy-Item \"$dir\\colorhoster.toml\" \"$persist_dir\\colorhoster.toml\" -Force",
        "}"
    ],
    "notes": [
        "Copy your VIA keyboard configuration files to the configs folder and create the ColorHoster service.",
        "",
        "To create service, run PowerShell or Windows Terminal in any directory as Administrator and execute:",
        "colorhoster.exe -b -p 6743 -d configs -s create",
        "colorhoster.exe -s start",
        "",
        "Now Open OpenRGB, go to Client SDK, type port 6743, click connect, click Save Connection"
    ],
    "checkver": {
        "github": "https://github.com/Azarattum/ColorHoster"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/Azarattum/ColorHoster/releases/download/v$version/ColorHoster-Windows-msvc-x86_64.zip"
            }
        }
    }
}
