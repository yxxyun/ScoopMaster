{
    "version": "0.7.2",
    "description": "OpenRGB compatible high-performance SDK server for VIA per-key RGB",
    "homepage": "https://github.com/Azarattum/ColorHoster",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/Azarattum/ColorHoster/releases/download/v0.7.2/ColorHoster-Windows-msvc-x86_64.zip",
            "hash": "c3d38044c25e0d3c8cbd845dab323a1123466b3492fe28c270375f371b8d7598"
        }
    },
    "bin": "ColorHoster.exe",
    "persist": [
        "configs",
        "profiles"
    ],
    "post_install": [
        "$ErrorActionPreference = 'Stop'",
        "$exe = \"$dir\\ColorHoster.exe\"",
        "$configDir = \"$dir\\configs\"",
        "if (!(Test-Path $configDir)) { New-Item -ItemType Directory -Path $configDir -Force | Out-Null }",
        "$identity = [Security.Principal.WindowsIdentity]::GetCurrent()",
        "$principal = [Security.Principal.WindowsPrincipal]::new($identity)",
        "if (!$principal.IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)) {",
        "    Write-Host ''",
        "    Write-Host 'Administrator privileges are required to create the ColorHoster service.' -ForegroundColor Yellow",
        "    $existing = Get-CimInstance Win32_Service | Where-Object { $_.PathName -like '*ColorHoster*' }",
        "    if (!$existing) {",
        "        $command = \"`$ErrorActionPreference = 'Stop'; & '$exe' -p 6743 -b -d '$configDir' -s create; if (`$LASTEXITCODE -ne 0) { exit `$LASTEXITCODE }; & '$exe' -s start; exit `$LASTEXITCODE\"",
        "        $encoded = [Convert]::ToBase64String([Text.Encoding]::Unicode.GetBytes($command))",
        "        try {",
        "            $process = Start-Process powershell.exe -Verb RunAs -ArgumentList \"-NoProfile -ExecutionPolicy Bypass -EncodedCommand $encoded\" -Wait -PassThru -ErrorAction Stop",
        "            if ($process.ExitCode -ne 0) { throw \"Service setup failed with exit code $($process.ExitCode).\" }",
        "        } catch {",
        "            Write-Host 'Administrator privileges were denied or service setup failed. Rolling back ColorHoster installation...' -ForegroundColor Red",
        "            $scoop = Get-Command scoop -ErrorAction SilentlyContinue",
        "            if ($scoop) {",
        "                & $scoop.Source uninstall colorhoster",
        "            }",
        "            throw 'ColorHoster installation cancelled because administrator privileges were not granted or service setup failed.'",
        "        }",
        "    }",
        "} else {",
        "    $existing = Get-CimInstance Win32_Service | Where-Object { $_.PathName -like '*ColorHoster*' }",
        "    if (!$existing) {",
        "        & $exe -p 6743 -b -d $configDir -s create",
        "        if ($LASTEXITCODE -ne 0) { throw 'Failed to create the ColorHoster service.' }",
        "        & $exe -s start",
        "        if ($LASTEXITCODE -ne 0) { throw 'Failed to start the ColorHoster service.' }",
        "    }",
        "}"
    ],
    "pre_uninstall": [
        "$ErrorActionPreference = 'Stop'",
        "$exe = \"$dir\\ColorHoster.exe\"",
        "$identity = [Security.Principal.WindowsIdentity]::GetCurrent()",
        "$principal = [Security.Principal.WindowsPrincipal]::new($identity)",
        "$service = Get-CimInstance Win32_Service | Where-Object { $_.PathName -like '*ColorHoster*' }",
        "if ($service) {",
        "    Write-Host ''",
        "    Write-Host 'Administrator privileges are required to remove the ColorHoster service.' -ForegroundColor Yellow",
        "    if (!$principal.IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)) {",
        "        $command = \"& '$exe' -s stop; if (`$LASTEXITCODE -ne 0) { exit `$LASTEXITCODE }; & '$exe' -s delete; exit `$LASTEXITCODE\"",
        "        $encoded = [Convert]::ToBase64String([Text.Encoding]::Unicode.GetBytes($command))",
        "        try {",
        "            $process = Start-Process powershell.exe -Verb RunAs -ArgumentList \"-NoProfile -ExecutionPolicy Bypass -EncodedCommand $encoded\" -Wait -PassThru -ErrorAction Stop",
        "            if ($process.ExitCode -ne 0) { throw \"Service removal failed with exit code $($process.ExitCode).\" }",
        "        } catch {",
        "            throw \"ColorHoster uninstallation failed: $($_.Exception.Message)\"",
        "        }",
        "    } else {",
        "        & $exe -s stop",
        "        if ($LASTEXITCODE -ne 0) { throw 'Failed to stop the ColorHoster service.' }",
        "        & $exe -s delete",
        "        if ($LASTEXITCODE -ne 0) { throw 'Failed to remove the ColorHoster service.' }",
        "    }",
        "}"
    ],
    "notes": [
        "VIA keyboard JSON definitions can be added to the following directory after installation:",
        "$dir\\configs",
        "After adding or modifying keyboard definitions, restart the ColorHoster service",
        "To connect ColorHoster, open OpenRGB > Client SDK > enter port 6743 > Connect > Save Connection."
    ],
    "checkver": {
        "github": "https://github.com/Azarattum/ColorHoster"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/Azarattum/ColorHoster/releases/download/v$version/ColorHoster-Windows-msvc-x86_64.zip"
            }
        }
    }
}
