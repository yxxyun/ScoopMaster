{
    "version": "0.6.17",
    "description": "Image Comparison & Analysis Tool (ICAT)",
    "homepage": "https://www.nvidia.com/en-us/geforce/technologies/icat/",
    "license": "Freeware",
    "architecture": {
        "64bit": {
            "url": "https://icat-public-releases.s3.amazonaws.com/ICAT-0.6.17.exe#/dl.7z",
            "hash": "02b25072944451a64f1f051b2adf0bbebb1ebb8919bc2017ebc59b631fb717c9",
            "pre_install": [
                "$file = (Get-ChildItem -File -Filter 'app-64.7z' -Path \"$original_dir/tmp\" -Recurse)[0].FullName",
                "Expand-7ZipArchive $file \"$original_dir\"",
                "Remove-Item -Force -Recurse -Path \"$original_dir/tmp\""
            ]
        }
    },
    "shortcuts": [
        [
            "ICAT.exe",
            "ICAT"
        ]
    ],
    "extract_to": "tmp",
    "checkver": {
        "script": [
            "$response = Invoke-WebRequest -Uri 'https://www.nvidia.com/en-us/geforce/technologies/icat/' -UseBasicParsing -TimeoutSec 30",
            "$html = [System.Net.WebUtility]::HtmlDecode([string]$response.Content)",
            "$match = [regex]::Match($html, '(?i)ICAT-(?<version>\\d+(?:\\.\\d+)+)\\.exe')",
            "if (-not $match.Success) { throw 'Could not find an ICAT versioned executable link on the official NVIDIA page.' }",
            "$match.Groups['version'].Value"
        ],
        "regex": "^(?<version>\\d+(?:\\.\\d+)+)$"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://icat-public-releases.s3.amazonaws.com/ICAT-$version.exe#/dl.7z"
            }
        }
    }
}
