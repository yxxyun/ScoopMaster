{
    "version": "2.4.0",
    "description": "jPipe — a compiler for justification models (Justified Pipelines)",
    "homepage": "https://github.com/jpipe-mcscert/jpipe-compiler",
    "license": "MIT",
    "depends": [
        "java/temurin25-jre",
        "main/graphviz"
    ],
    "url": "https://github.com/jpipe-mcscert/jpipe-compiler/releases/download/v2.4.0/jpipe-2.4.0.zip",
    "hash": "a2c470fedb48f61b98100256c147c9876bbc9c97959f6fa3dfb834609e5aab81",
    "bin": [
        [
            "jpipe.ps1",
            "jpipe"
        ]
    ],
    "post_install": [
        "$java = Join-Path (& scoop prefix temurin25-jre) 'bin\\java.exe'",
        "$p = Join-Path $dir 'jpipe.ps1'",
        "(Get-Content $p -Raw).Replace('@@JAVA@@', $java).Replace('@@PREFIX@@', $dir) | Set-Content $p -NoNewline"
    ],
    "autoupdate": {
        "url": "https://github.com/jpipe-mcscert/jpipe-compiler/releases/download/v$version/jpipe-$version.zip"
    }
}
