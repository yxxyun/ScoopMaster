{
    "version": "4.1.0",
    "description": "jPipe — a compiler for justification models (Justified Pipelines)",
    "homepage": "https://github.com/jpipe-mcscert/jpipe-compiler",
    "license": "MIT",
    "depends": [
        "java/temurin25-jre",
        "main/graphviz"
    ],
    "url": "https://github.com/jpipe-mcscert/jpipe-compiler/releases/download/v4.1.0/jpipe-4.1.0.zip",
    "hash": "a9132ce44e57d6f4c37c12409ec1f9c6f4c4d00cfb61a376c342da533a7e1ffb",
    "bin": [
        [
            "jpipe.ps1",
            "jpipe"
        ]
    ],
    "post_install": [
        "$java = Join-Path (& scoop prefix temurin25-jre) 'bin\\java.exe'",
        "$p = Join-Path $dir 'jpipe.ps1'",
        "(Get-Content $p -Raw).Replace('@@JAVA@@', $java.Replace(\"'\", \"''\")).Replace('@@PREFIX@@', $dir.Replace(\"'\", \"''\")) | Set-Content $p -NoNewline",
        "try { & $p --create-aot-cache } catch { Write-Warning \"jPipe runs without its AOT cache: $_\" }"
    ],
    "autoupdate": {
        "url": "https://github.com/jpipe-mcscert/jpipe-compiler/releases/download/v$version/jpipe-$version.zip"
    }
}
