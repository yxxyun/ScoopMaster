{
    "version": "5.0.0.481-beta",
    "description": "DRipGrepper is a UI to search files with ripgrep.",
    "homepage": "https://github.com/mattia72/DRipGrepper",
    "license": "MIT",
    "notes": [
        "DRipGrepper is a UI for configuring ripgrep for superfast text search ",
        "and allows you to easily open matched files at the matched location in external applications.",
        "Note: ripgrep must be installed on your system."
    ],
    "suggests": {
        "packages including ripgrep": [
            "ripgrep",
            "vscode"
        ]
    },
    "architecture": {
        "64bit": {
            "url": [
                "https://github.com/mattia72/DRipGrepper/releases/download/v5.0.0-beta/DRipGrepper.x64.v5.0.0.481-beta.zip",
                "https://github.com/mattia72/DRipGrepper/releases/download/v5.0.0-beta/DRipExtension.Dll.x86.Delphi11.v5.0.0.233-beta.zip"
            ],
            "hash": [
                "1737c2fc4663b2c2845b6893ccb9e58f15e281fade3e4bcec76cd17ea93ca748",
                "1c981736cbbe770477dab2361f35e33010fd9f7776ab7de5887a6fea4f9737af"
            ]
        },
        "32bit": {
            "url": [
                "https://github.com/mattia72/DRipGrepper/releases/download/v5.0.0-beta/DRipGrepper.x86.v5.0.0.481-beta.zip",
                "https://github.com/mattia72/DRipGrepper/releases/download/v5.0.0-beta/DRipExtension.Dll.x86.Delphi11.v5.0.0.233-beta.zip"
            ],
            "hash": [
                "f00d65a20cdca44386e4259ea129595a85e9fc349fa886dc9e1c0d9d898c6258",
                "1c981736cbbe770477dab2361f35e33010fd9f7776ab7de5887a6fea4f9737af"
            ]
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": [
                    "$matchAsset0",
                    "$matchAsset1"
                ]
            },
            "32bit": {
                "url": [
                    "$matchAsset2",
                    "$matchAsset1"
                ]
            }
        }
    },
    "bin": [
        [
            "dripgrepper.exe",
            "DRipGrepper"
        ]
    ],
    "pre_install": "New-Item $dir\\DripGrepper.ini",
    "persist": "DRipGrepper.ini",
    "shortcuts": [
        [
            "dripgrepper.exe",
            "DRipGrepper"
        ]
    ],
    "depends": "ripgrep",
    "checkver": {
        "url": "https://api.github.com/repos/mattia72/DRipGrepper/releases",
        "script": [
            "$release = $page | ConvertFrom-Json | Where-Object { -not $_.draft } | Select-Object -First 1",
            "$release.assets | Sort-Object -Property @{ Expression = {",
            "    if ($_.name -match \"\\.v?(\\d+\\.\\d+\\.\\d+(?:\\.\\d+)?)(?:-[0-9A-Za-z.-]+)?\\.zip$\") { [version]$matches[1] } else { [version]\"0.0\" }",
            "}; Descending = $true } | ForEach-Object { $_.browser_download_url }"
        ],
        "regex": "(?s)^(?=.*?(?<asset0>https://github\\.com/mattia72/DRipGrepper/releases/download/[^/\\s\"]+/DRipGrepper\\.x64\\.v?(\\d+\\.\\d+\\.\\d+(?:\\.\\d+)?(?:-[0-9A-Za-z.-]+)?)\\.zip))(?=.*?(?<asset1>https://github\\.com/mattia72/DRipGrepper/releases/download/[^/\\s\"]+/DRipExtension\\.Dll\\.x86\\.Delphi11\\.v?\\d+\\.\\d+\\.\\d+(?:\\.\\d+)?(?:-[0-9A-Za-z.-]+)?\\.zip))(?=.*?(?<asset2>https://github\\.com/mattia72/DRipGrepper/releases/download/[^/\\s\"]+/DRipGrepper\\.x86\\.v?\\d+\\.\\d+\\.\\d+(?:\\.\\d+)?(?:-[0-9A-Za-z.-]+)?\\.zip))"
    }
}
