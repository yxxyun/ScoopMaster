{
    "$schema": "https://raw.githubusercontent.com/ScoopInstaller/Scoop/master/schema.json",
    "version": "0.1.0",
    "description": "URI handler that routes scoop:// and winget:// links to the right package manager, and registers both schemes for the current user.",
    "homepage": "https://github.com/shanto/pkgproxy",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/shanto/pkgproxy/releases/download/v0.1.0/pkgproxy_0.1.0_windows_amd64.zip",
            "hash": "3cab9fc788e736f341f9a08911b88840bb4de4e973b03fe8964ce42a911b90cb"
        }
    },
    "bin": "pkgproxy.exe",
    "post_install": "& \"$dir\\pkgproxy.exe\" register",
    "pre_uninstall": "& \"$dir\\pkgproxy.exe\" unregister",
    "notes": [
        "The scoop:// and winget:// URL schemes are now registered for the current user.",
        "Try it: pkgproxy \"scoop://install/ripgrep?repo=main\""
    ],
    "checkver": {
        "github": "https://github.com/shanto/pkgproxy"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/shanto/pkgproxy/releases/download/v$version/pkgproxy_$version_windows_amd64.zip"
            }
        }
    }
}
