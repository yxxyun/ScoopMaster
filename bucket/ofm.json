{
    "version": "0.2.0",
    "description": "Open FM sound card modem with a VARA FM compatible host interface",
    "homepage": "https://github.com/Londopy/ofm",
    "license": "MIT|Apache-2.0",
    "url": "https://github.com/Londopy/ofm/releases/download/v0.2.0/ofm-v0.2.0-portable.zip",
    "hash": "43096ee2d254fe047a6e985e8247f33d2fb1a5f3b4e2266db1544fb6767c238d",
    "extract_dir": "ofm",
    "architecture": {
        "64bit": {
            "bin": "x64\\ofm.exe",
            "shortcuts": [
                [
                    "x64\\ofm.exe",
                    "ofm",
                    "gui"
                ]
            ]
        },
        "32bit": {
            "bin": "x86\\ofm.exe",
            "shortcuts": [
                [
                    "x86\\ofm.exe",
                    "ofm",
                    "gui"
                ]
            ]
        },
        "arm64": {
            "bin": "arm64\\ofm.exe",
            "shortcuts": [
                [
                    "arm64\\ofm.exe",
                    "ofm",
                    "gui"
                ]
            ]
        }
    },
    "persist": [
        "x64\\config.toml",
        "x86\\config.toml",
        "arm64\\config.toml"
    ],
    "pre_install": [
        "@('x64', 'x86', 'arm64') | ForEach-Object {",
        "    $sub = Join-Path $dir $_",
        "    if (!(Test-Path $sub)) { return }",
        "    if (!(Test-Path \"$sub\\portable\")) { New-Item -ItemType File -Path \"$sub\\portable\" | Out-Null }",
        "    # persist turns a path that doesn't exist yet into a folder, so start with an empty config file",
        "    if (!(Test-Path \"$persist_dir\\$_\\config.toml\")) { New-Item -ItemType File -Path \"$sub\\config.toml\" | Out-Null }",
        "}"
    ],
    "checkver": {
        "github": "https://github.com/Londopy/ofm"
    },
    "autoupdate": {
        "url": "https://github.com/Londopy/ofm/releases/download/v$version/ofm-v$version-portable.zip",
        "hash": {
            "url": "https://github.com/Londopy/ofm/releases/download/v$version/SHA256SUMS.txt",
            "regex": "$sha256\\s+$basename"
        }
    }
}
