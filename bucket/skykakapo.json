{
    "version": "156.0.1",
    "description": "Firefox-based web browser optimized by tete009.",
    "homepage": "https://tete009.pages.dev/en-US/software",
    "license": "MPL-2.0",
    "architecture": {
        "64bit": {
            "url": "https://downloads.sourceforge.net/project/skykakapo/156.0.1/skykakapo-156.0.1-2026092213.en-US.win64-sse3-cspgo.7z",
            "hash": "sha1:610eda6ad8ffd344934ba522c37d3af5e617a50f",
            "extract_dir": "skykakapo-156.0.1-2026092213.en-US.win64-sse3-cspgo",
            "bin": "skykakapo.exe",
            "shortcuts": [
                [
                    "skykakapo.exe",
                    "SkyKakapo"
                ]
            ]
        }
    },
    "pre_install": [
        "\"[General]`r`nPortable=1`r`nPortableDataPath=PortableData`r`n`r`n[Env]`r`nMOZ_LEGACY_PROFILES=1`r`nTT_DISABLE_PRIVATE_BROWSING_SHORTCUT_CREATION=1\" | Out-File -Encoding ASCII \"$dir\\tmemutil.ini\"",
        "ForEach ($emptyFile in $manifest.persist | Where-Object { $_ -ne 'PortableData' }) {New-Item \"$dir\\$emptyFile\" -ItemType file -ErrorAction SilentlyContinue | Out-Null}"
    ],
    "persist": [
        "PortableData",
        "tmemutil.ini"
    ],
    "checkver": {
        "sourceforge": "skykakapo",
        "regex": "skykakapo-([\\d.]+)-(?<date>\\d+)\\.en-US\\.win64(?<buildtag>-(?![\\w-]*-test[\\w-]*\\.7z)[\\w-]+)?\\.7z"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://downloads.sourceforge.net/project/skykakapo/$version/skykakapo-$version-$matchDate.en-US.win64$matchBuildtag.7z",
                "extract_dir": "skykakapo-$version-$matchDate.en-US.win64$matchBuildtag"
            }
        }
    }
}
