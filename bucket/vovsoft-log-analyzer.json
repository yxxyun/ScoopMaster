{
    "version": "3.0",
    "description": "Portable edition of Vovsoft Log Analyzer.",
    "homepage": "https://vovsoft.com/software/log-analyzer/",
    "license": "Proprietary",
    "url": "https://vovsoft.com/files/log-analyzer-portable.zip?v=3.0",
    "checkver": {
        "url": "https://vovsoft.com/download/log-analyzer-portable/",
        "regex": "(?is)Version\\s*(?:<[^>]*>\\s*)*:?\\s*(?:<[^>]*>\\s*)*(?<version>\\d+(?:\\.\\d+)+)"
    },
    "autoupdate": {
        "url": "https://vovsoft.com/files/log-analyzer-portable.zip?v=$version"
    },
    "shortcuts": [
        [
            "loganalyzer.exe",
            "Vovsoft Log Analyzer"
        ]
    ],
    "notes": [
        "SHA-256 has not been verified; archive contents and the shortcut target have been checked."
    ],
    "pre_install": [
        "if (-not (Test-Path -LiteralPath \"$dir\\key.txt\" -PathType Leaf)) { New-Item -ItemType File -Path \"$dir\\key.txt\" | Out-Null }"
    ],
    "persist": "key.txt"
}
