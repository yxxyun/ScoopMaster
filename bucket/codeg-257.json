{
    "$schema": "https://raw.githubusercontent.com/ScoopInstaller/Scoop/master/schema.json",
    "version": "0.38.0",
    "description": "Aggregate and browse AI coding agent sessions (Claude Code, Codex, Gemini CLI, etc.) in one place. Desktop app, self-hosted server, or Docker",
    "homepage": "https://github.com/gdm257/codeg",
    "license": "Apache-2.0",
    "depends": "main/nanazip",
    "architecture": {
        "64bit": {
            "url": "https://github.com/gdm257/codeg/releases/download/v0.38.0/codeg_0.38.0_x64-setup.exe#/nsis.exe",
            "hash": "sha256:516fc49d6b19d8552864b96cd6d606e6419d2b54628f5cbbf1c7463c7ff707a4"
        }
    },
    "installer": {
        "script": [
            "7z x -bso0 -bsp0 -y \"$dir\\nsis.exe\" \"-o$dir\"",
            "Remove-Item -Path \"$dir\\nsis.exe\" -Recurse",
            "Remove-Item -Path \"$dir\\*.nsi\" -Recurse",
            "Remove-Item -Path \"$dir\\`$*\" -Recurse"
        ]
    },
    "shortcuts": [
        [
            "codeg.exe",
            "Codeg"
        ]
    ],
    "bin": [
        "codeg-cli.exe",
        ["codeg-cli.exe", "codeg"],
        "codeg-computer-helper.exe",
        "codeg-mcp.exe"
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/gdm257/codeg/releases/download/v$version/codeg_$version_x64-setup.exe#/nsis.exe"
            }
        }
    }
}
