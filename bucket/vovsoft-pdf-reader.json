{
    "version": "6.0",
    "description": "Portable edition of Vovsoft PDF Reader.",
    "homepage": "https://vovsoft.com/software/pdf-reader/",
    "license": "Proprietary",
    "url": "https://vovsoft.com/files/pdf-reader-portable.zip?v=6.0",
    "checkver": {
        "url": "https://vovsoft.com/download/pdf-reader-portable/",
        "regex": "(?is)Version\\s*(?:<[^>]*>\\s*)*:?\\s*(?:<[^>]*>\\s*)*(?<version>\\d+(?:\\.\\d+)+)"
    },
    "autoupdate": {
        "url": "https://vovsoft.com/files/pdf-reader-portable.zip?v=$version"
    },
    "shortcuts": [
        [
            "pdfreader.exe",
            "Vovsoft PDF Reader"
        ]
    ],
    "pre_install": [
        "if (-not (Test-Path -LiteralPath \"$dir\\key.txt\" -PathType Leaf)) { New-Item -ItemType File -Path \"$dir\\key.txt\" | Out-Null }"
    ],
    "persist": "key.txt"
}
