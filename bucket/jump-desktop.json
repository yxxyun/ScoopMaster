{
    "version": "10.15.31",
    "description": "Fast and secure remote desktop (RDP, VNC, Fluid) application for Windows",
    "homepage": "https://jumpdesktop.com/",
    "license": "proprietary",
    "notes": [
        "Jump Desktop provides remote desktop access via RDP, VNC, and Fluid protocols with end-to-end encryption.",
        "The built-in updater is not configured for this portable install. Use 'scoop update jump-desktop' instead.",
        "Saved servers are stored in '$persist_dir\\Servers' and linked from '%LOCALAPPDATA%\\Jump Desktop\\Client\\Servers'."
    ],
    "architecture": {
        "64bit": {
            "url": "https://mirror.jumpdesktop.com/downloads/viewer/JumpDesktop-10.15.31.msi",
            "hash": "e6e198222e52bb14924569f0c0e201570319a09065aa8643c5a407d40d4ff8ec"
        }
    },
    "pre_install": [
        "# lessmsi extracts into an APPDIR subfolder, msiexec extracts into the root",
        "if (Test-Path \"$dir\\APPDIR\") {",
        "    Get-ChildItem \"$dir\\APPDIR\" -Force | Move-Item -Destination $dir -Force",
        "    Remove-Item \"$dir\\APPDIR\" -Recurse -Force",
        "}"
    ],
    "post_install": [
        "# Keep saved servers in the persist dir and link the folder the client reads from to it",
        "$client = \"$env:LOCALAPPDATA\\Jump Desktop\\Client\"",
        "$servers = \"$client\\Servers\"",
        "$target = \"$persist_dir\\Servers\"",
        "ensure $client | Out-Null",
        "ensure $target | Out-Null",
        "$item = Get-Item $servers -Force -ErrorAction SilentlyContinue",
        "if ($item -and $item.LinkType) {",
        "    $item.Delete()",
        "} elseif ($item) {",
        "    Copy-Item \"$servers\\*\" $target -Recurse -Force -ErrorAction Stop",
        "    Remove-Item $servers -Recurse -Force",
        "}",
        "New-Item -ItemType Junction -Path $servers -Target $target | Out-Null",
        "# Register the .jump file association for the current user",
        "$classes = 'HKCU:\\Software\\Classes'",
        "$progId = 'Phase Five Systems.Jump Desktop.jump'",
        "New-Item \"$classes\\$progId\" -Value 'Jump Desktop Server File' -Force | Out-Null",
        "New-Item \"$classes\\$progId\\DefaultIcon\" -Value \"$dir\\JumpClient.exe,0\" -Force | Out-Null",
        "New-Item \"$classes\\$progId\\shell\\open\\command\" -Value \"`\"$dir\\JumpClient.exe`\" `\"%1`\"\" -Force | Out-Null",
        "New-Item \"$classes\\.jump\" -Value $progId -Force | Out-Null"
    ],
    "pre_uninstall": [
        "$servers = \"$env:LOCALAPPDATA\\Jump Desktop\\Client\\Servers\"",
        "$item = Get-Item $servers -Force -ErrorAction SilentlyContinue",
        "if ($item -and $item.LinkType) { $item.Delete() }",
        "$classes = 'HKCU:\\Software\\Classes'",
        "$progId = 'Phase Five Systems.Jump Desktop.jump'",
        "Remove-Item \"$classes\\$progId\" -Recurse -Force -ErrorAction SilentlyContinue",
        "$ext = Get-Item \"$classes\\.jump\" -ErrorAction SilentlyContinue",
        "if ($ext -and $ext.GetValue('') -eq $progId) { Remove-Item \"$classes\\.jump\" -Recurse -Force }"
    ],
    "shortcuts": [
        [
            "JumpClient.exe",
            "Jump Desktop"
        ]
    ],
    "checkver": {
        "url": "https://mirror.jumpdesktop.com/downloads/viewer/viewer-win-prod-relmgr.txt",
        "regex": "ProductVersion = ([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://mirror.jumpdesktop.com/downloads/viewer/JumpDesktop-$version.msi"
            }
        }
    }
}
