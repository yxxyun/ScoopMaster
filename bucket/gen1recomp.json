{
    "version": "0.3.33",
    "description": "A native Lua / LÖVE2D recreation of Gen 1 Poke",
    "homepage": "https://github.com/bryanthaboi/gen1recomp",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/bryanthaboi/gen1recomp/releases/download/v0.3.33/gen1recomp-0.3.33-windows.zip",
            "hash": "cacec0b449b8ec768e0026234681182cd399ebc45ce2b7980f84d20b46b57675",
            "extract_dir": "gen1recomp-win64"
        }
    },
    "post_install": "Set-Content -Value $null -Path \"$dir\\portable.txt\"",
    "shortcuts": [
        [
            "gen1recomp.exe",
            "Gen1Recomp"
        ]
    ],
    "pre_install": [
        "'options.lua', 'options.lua.bak' | ForEach-Object {",
        "    if (-not (Test-Path \"$persist_dir\\$_\")) { New-Item -Path \"$dir\\$_\" -ItemType File -Force | Out-Null }",
        "}"
    ],
    "persist": [
        "red",
        "blue",
        "yellow",
        "gold",
        "silver",
        "crystal",
        "saves",
        "mods",
        "options.lua",
        "options.lua.bak"
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/bryanthaboi/gen1recomp/releases/download/v$version/gen1recomp-$version-windows.zip"
            }
        }
    }
}
