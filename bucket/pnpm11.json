{
    "version": "11.18.0",
    "description": "PNPM 11.x",
    "homepage": "https://pnpm.io",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/pnpm/pnpm/releases/download/v11.18.0/pnpm-win32-x64.zip",
            "hash": "16cc9dbbf86f723936eb9aa5dd37f9d13bdb2068fc7319162236c86746706249"
        },
        "arm64": {
            "url": "https://github.com/pnpm/pnpm/releases/download/v11.18.0/pnpm-win32-arm64.zip",
            "hash": "9d77b3dd6c5a218495dea5f1edc9dbdbb324694ed9cc5fabf9d7e8ba454b0e2f"
        }
    },
    "bin": [
        "pnpm.exe",
        [
            "pnpm.exe",
            "pn"
        ],
        [
            "pnpm.exe",
            "pnpx",
            "dlx"
        ],
        [
            "pnpm.exe",
            "pnx",
            "dlx"
        ]
    ],
    "post_install": [
        "pnpm config set storeDir \"$dir\\store\"",
        "pnpm config set cacheDir \"$dir\\cache\"",
        "pnpm config set stateDir \"$dir\\state\""
    ],
    "env_add_path": "bin",
    "env_set": {
        "PNPM_HOME": "$dir"
    },
    "persist": [
        "store",
        "cache",
        "state"
    ],
    "checkver": {
        "script": [
            "$auth = Get-GitHubToken",
            "$head = @{}",
            "if($auth) { $head.add('authorization', \"Bearer $auth\") }",
            "$url = 'https://api.github.com/repos/pnpm/pnpm/releases?per_page=100'",
            "$latest_ver = [Version]::new(0,0,0,0)",
            "$releases = $(Invoke-WebRequest -Headers $head $url).Content | ConvertFrom-Json",
            "$releases | ForEach-Object {",
            "    if (!($_.tag_name -match '([\\d.]+)')) { return }",
            "    if ($_.prerelease) { return }",
            "    $ver = [Version]::new($matches[1])",
            "    if ($ver.Major -ne 11) { return } # 메이저 버전 고정",
            "    if ($ver -gt $latest_ver) { $latest_ver = $ver }",
            "}",
            "if ($latest_ver -eq [Version]::new(0,0,0,0)) { error \"Could not match version string in '$url'\"; continue }",
            "Write-Output $latest_ver"
        ],
        "regex": "v([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/pnpm/pnpm/releases/download/v$version/pnpm-win32-x64.zip"
            },
            "arm64": {
                "url": "https://github.com/pnpm/pnpm/releases/download/v$version/pnpm-win32-arm64.zip"
            }
        }
    }
}
