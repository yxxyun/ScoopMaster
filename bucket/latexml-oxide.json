{
    "version": "0.7.6",
    "description": "A TeX to XML/HTML/ePub converter: a LaTeXML reimplementation in Rust",
    "homepage": "https://github.com/dginev/latexml-oxide",
    "license": "CC0-1.0",
    "architecture": {
        "64bit": {
            "url": "https://github.com/dginev/latexml-oxide/releases/download/0.7.6/latexml-oxide-0.7.6-x86_64-pc-windows-msvc.zip",
            "hash": "5db31e19875ce49fb42bd9f2e75be0d940f81aa73b70b46e865c8e72e3d2d591",
            "extract_dir": "latexml-oxide-0.7.6-x86_64-pc-windows-msvc"
        }
    },
    "post_install": [
        "[void](New-Item -ItemType Directory \"$dir\\bin\")",
        "Move-Item \"$dir\\*.exe\" -Destination \"$dir\\bin\""
    ],
    "env_add_path": "bin",
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/dginev/latexml-oxide/releases/download/$version/latexml-oxide-$version-x86_64-pc-windows-msvc.zip",
                "extract_dir": "latexml-oxide-$version-x86_64-pc-windows-msvc"
            }
        }
    },
    "suggest": {
        "non-web images to PNG": "imagemagick",
        "EPS/PS to PNG": [
            "ghostscript",
            "imagemagick",
            "miktex"
        ],
        "PDF to SVG": [
            "extras/mupdf",
            "poppler",
            "miktex"
        ],
        "TeX": "miktex"
    }
}
