{
    "version": "3.3.4",
    "description": "A general purpose HTTP reverse proxy and forwarding tool",
    "homepage": "https://github.com/tobychui/zoraxy",
    "license": "AGPL-3.0",
    "architecture": {
        "64bit": {
            "url": "https://github.com/tobychui/zoraxy/releases/download/v3.3.4/zoraxy_windows_amd64.exe#/zoraxy.exe",
            "hash": "61feea197354e499b0f5b4024bce883fb697e4dc0db62e816eaca54a02108745"
        }
    },
    "installer": {
        "script": "Copy-Item -Path (Join-Path $bucketsdir $bucket 'scripts\\command-wrapper\\command-wrapper.cmd') -Destination (Join-Path $dir 'command-wrapper.cmd') -Force"
    },
    "bin": [
        [
            "command-wrapper.cmd",
            "zoraxy",
            "--workdir . zoraxy.exe"
        ]
    ],
    "persist": [
        "conf",
        "log",
        "plugins",
        "www"
    ],
    "checkver": {
        "url": "https://github.com/tobychui/zoraxy/releases.atom",
        "regex": "<title[^>]*>v(\\d+(?:\\.\\d+)+)</title>"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/tobychui/zoraxy/releases/download/v$version/zoraxy_windows_amd64.exe#/zoraxy.exe"
            }
        }
    }
}
