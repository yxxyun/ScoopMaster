{
    "version": "1.3.6",
    "description": "Lightweight and customizable desktop hardware monitoring tool",
    "homepage": "https://github.com/Diorser/LiteMonitor",
    "license": "MIT",
    "notes": [
        "LiteMonitor 的配置、网络流量历史、自定义插件和主题均保存在持久化目录（$persist_dir），更新时会保留。",
        "主要文件：settings.json、TrafficHistory.json，以及 resources\\plugins、resources\\themes。"
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/Diorser/LiteMonitor/releases/download/v1.3.6/LiteMonitor_v1.3.6-win-x64.zip",
            "hash": "966c60e0e327d995f8f6edf59c630331a24fdc7aeb4c5765ab539cbf6a6471d7",
            "extract_dir": "LiteMonitor_v1.3.6-win-x64"
        }
    },
    "pre_install": [
        "if (!(Test-Path \"$dir\\settings.json\") -or !(Get-Item \"$dir\\settings.json\").Length) {",
        "    New-Item \"$dir\\settings.json\" -ItemType File -Force | Out-Null",
        "    Set-Content -Path \"$dir\\settings.json\" -Value '{}'",
        "}",
        "if (!(Test-Path \"$dir\\TrafficHistory.json\") -or !(Get-Item \"$dir\\TrafficHistory.json\").Length) {",
        "    New-Item \"$dir\\TrafficHistory.json\" -ItemType File -Force | Out-Null",
        "    Set-Content -Path \"$dir\\TrafficHistory.json\" -Value '[]'",
        "}"
    ],
    "shortcuts": [
        [
            "LiteMonitor.exe",
            "LiteMonitor"
        ]
    ],
    "persist": [
        "settings.json",
        "TrafficHistory.json",
        "resources\\plugins",
        "resources\\themes"
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/Diorser/LiteMonitor/releases/download/v$version/LiteMonitor_v$version-win-x64.zip",
                "extract_dir": "LiteMonitor_v$version-win-x64"
            }
        }
    }
}
