{
    "version": "0.4.0-beta",
    "description": "Unifying frontend for Windows app stores and package managers.",
    "homepage": "https://github.com/yoshiask/FluentStore",
    "license": "MPL-2.0",
    "architecture": {
        "64bit": {
            "url": "https://github.com/yoshiask/FluentStore/releases/download/v0.4.0-beta/FluentStoreBeta_Installer_x64.exe",
            "installer": {
                "file": "FluentStoreBeta_Installer_x64.exe",
                "keep": "true"
            },
            "uninstaller": {
                "script": "Get-AppxPackage -Name '52374YoshiAskharoun.FluentStore' | Remove-AppxPackage"
            }
        }
    },
    "notes": [
        "This is the official Windows installer, not a portable build.",
        "The installer registers the Fluent Store MSIX package and may install the required .NET runtime."
    ],
    "checkver": {
        "github": "https://github.com/yoshiask/FluentStore",
        "regex": "v([0-9]+\\.[0-9]+\\.[0-9]+-beta)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/yoshiask/FluentStore/releases/download/v$version/FluentStoreBeta_Installer_x64.exe"
            }
        }
    }
}
