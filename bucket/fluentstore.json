{
    "version": "0.4.0-beta",
    "description": "Unifying frontend for Windows app stores and package managers.",
    "homepage": "https://github.com/yoshiask/FluentStore",
    "license": "MPL-2.0",
    "architecture": {
        "64bit": {
            "url": "https://github.com/yoshiask/FluentStore/releases/download/v0.4.0-beta/FluentStoreBeta_Installer_x64.exe",
            "installer": {
                "file": "FluentStoreBeta_Installer_x64.exe",
                "keep": "true"
            },
            "uninstaller": {
                "script": "Get-AppxPackage -Name '52374YoshiAskharoun.FluentStore' | Remove-AppxPackage"
            }
        }
    },
    "notes": [
        "This is the official Windows installer, not a portable build.",
        "The installer registers the Fluent Store MSIX package and may install the required .NET runtime."
    ],
    "checkver": {
        "script": [
            "$headers = @{ 'Accept' = 'application/vnd.github+json'; 'User-Agent' = 'Scoop-KiroBucket' }",
            "if (-not [string]::IsNullOrWhiteSpace($env:GITHUB_TOKEN)) { $headers['Authorization'] = \"Bearer $env:GITHUB_TOKEN\" }",
            "$releases = Invoke-RestMethod -Uri 'https://api.github.com/repos/yoshiask/FluentStore/releases?per_page=100' -Headers $headers",
            "$release = $releases | Where-Object { $_.tag_name -match '^v[\\d.]+-beta$' -and ($_.assets | Where-Object { $_.name -eq 'FluentStoreBeta_Installer_x64.exe' } | Select-Object -First 1) } | Select-Object -First 1",
            "if (-not $release) { throw 'No FluentStore beta release containing the x64 installer was found.' }",
            "Write-Output $release.tag_name"
        ],
        "regex": "^v(?<version>[\\d.]+-beta)$"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/yoshiask/FluentStore/releases/download/v$version/FluentStoreBeta_Installer_x64.exe"
            }
        }
    }
}
