{
    "version": "0.1.4682",
    "description": "Unified model, provider, and gateway manager for AI coding agents.",
    "homepage": "https://usemagpie.ai",
    "license": "MIT",
    "notes": "This manifest tracks the daily releases of Magpie. For stable releases, use 'extras/magpie-ai'",
    "architecture": {
        "64bit": {
            "url": "https://github.com/yetone/magpie-releases/releases/download/v0.1.4682/magpie-windows-amd64.exe#/magpie.exe",
            "hash": "b30da998cf8d6f3218f7e9a88fe69639fa748288300a44601d4350a358bc9d69"
        },
        "arm64": {
            "url": "https://github.com/yetone/magpie-releases/releases/download/v0.1.4682/magpie-windows-arm64.exe#/magpie.exe",
            "hash": "c13dec4298511733f7e9d25d554f625c79d84866b347be618954f178deb12cc0"
        }
    },
    "pre_install": [
        "if (-not (Test-Path -LiteralPath \"$persist_dir\\data\\settings.json\" -PathType Leaf)) {",
        "    ensure \"$dir\\data\" | Out-Null",
        "    @{ noAutoUpdate = $true } | ConvertTo-Json | Set-Content -LiteralPath \"$dir\\data\\settings.json\" -Force -Encoding ASCII",
        "}"
    ],
    "shortcuts": [
        [
            "magpie.exe",
            "Magpie"
        ]
    ],
    "persist": "data",
    "checkver": {
        "url": "https://usemagpie.ai/api/latest?channel=daily",
        "jsonpath": "$.version"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/yetone/magpie-releases/releases/download/v$version/magpie-windows-amd64.exe#/magpie.exe"
            },
            "arm64": {
                "url": "https://github.com/yetone/magpie-releases/releases/download/v$version/magpie-windows-arm64.exe#/magpie.exe"
            }
        },
        "hash": {
            "url": "$baseurl/SHA256SUMS"
        }
    }
}
