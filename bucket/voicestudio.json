{
    "version": "0.5.7",
    "description": "Open-source voice cloning, voice design, video dubbing, dictation, transcription & audiobook creation in 646 languages.",
    "homepage": "https://voicestudio.sh",
    "license": {
        "identifier": "AGPL-3.0-only",
        "url": "https://github.com/debpalash/VoiceStudio/blob/main/LICENSE-NOTICE.md"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/debpalash/VoiceStudio/releases/download/v0.5.7/VoiceStudio-0.5.7-win-x64.exe#/dl.7z",
            "hash": "76c6385d404ae9f11b9e47d42996432ea4cd6c065afb06718c4842b39020cd80"
        }
    },
    "pre_install": [
        "Remove-Item \"$dir\\resources\" -Recurse -Force -ErrorAction SilentlyContinue",
        "$payload = Get-ChildItem -LiteralPath \"$dir\\`$PLUGINSDIR\" -Filter 'app*.7z' -File | Select-Object -First 1",
        "if (-not $payload) { throw 'VoiceStudio nested app archive was not found.' }",
        "$payload | Expand-7zipArchive -DestinationPath $dir",
        "Remove-Item \"$dir\\`$*\", \"$dir\\Uninst*\" -Force -Recurse -ErrorAction Ignore"
    ],
    "bin": "VoiceStudio.exe",
    "shortcuts": [
        [
            "VoiceStudio.exe",
            "VoiceStudio"
        ]
    ],
    "checkver": {
        "github": "https://github.com/debpalash/VoiceStudio"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/debpalash/VoiceStudio/releases/download/v$version/VoiceStudio-$version-win-x64.exe#/dl.7z"
            }
        },
        "hash": {
            "url": "$baseurl/SHA256SUMS.txt",
            "regex": "$sha256\\s+\\*?$basename"
        }
    },
    "##": "Installer Type: NSIS",
    "notes": [
        "This is the official Electron/NSIS Windows setup package. Scoop extracts the outer NSIS container and the embedded $PLUGINSDIR\\app-64.7z payload; it does not execute the vendor installer.",
        "VoiceStudio stores its projects, voices, runtime, and model cache outside the Scoop version directory. Removing the Scoop app does not clean those user-data folders."
    ]
}
