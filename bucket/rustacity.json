{
    "version": "0.5.0",
    "description": "Audacity 2.4.1 fork with a Rust-based DSP core and extension engine; multi-track audio editor and recorder",
    "homepage": "https://github.com/prantosmss/Rustacity",
    "license": "GPL-2.0-or-later",
    "architecture": {
        "64bit": {
            "url": "https://github.com/prantosmss/Rustacity/releases/download/rustacity-0.5.0/rustacity-win-0.5.0-x86_64.7z",
            "hash": "63bd3c32aca735b4732468e527e4ec2074a9f5479162e02801f1796c26237f39",
            "extract_dir": "Windows_64bit_c5e7265"
        }
    },
    "bin": "rustacity.exe",
    "shortcuts": [
        [
            "rustacity.exe",
            "Rustacity"
        ]
    ],
    "persist": "Portable Settings",
    "checkver": {
        "script": [
            "$headers = @{ 'User-Agent' = 'Scoop'; 'Accept' = 'application/vnd.github+json' }",
            "$tag = (Invoke-RestMethod 'https://api.github.com/repos/prantosmss/Rustacity/releases/latest' -Headers $headers).tag_name",
            "$ref = Invoke-RestMethod \"https://api.github.com/repos/prantosmss/Rustacity/git/ref/tags/$tag\" -Headers $headers",
            "$sha = $ref.object.sha",
            "if ($ref.object.type -eq 'tag') { $sha = (Invoke-RestMethod \"https://api.github.com/repos/prantosmss/Rustacity/git/tags/$sha\" -Headers $headers).object.sha }",
            "Write-Output $tag $sha.Substring(0, 7)"
        ],
        "regex": "rustacity-(?<version>[\\d.]+) (?<commit>\\w{7})"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/prantosmss/Rustacity/releases/download/rustacity-$version/rustacity-win-$version-x86_64.7z",
                "extract_dir": "Windows_64bit_$matchCommit"
            }
        }
    }
}
