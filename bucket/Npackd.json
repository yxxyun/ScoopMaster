{
    "version": "1.27.1",
    "description": "Windows package manager for finding, installing, updating, and uninstalling software.",
    "homepage": "https://www.npackd.org",
    "license": "GPL-3.0",
    "url": "https://github.com/npackd/npackd-cpp/releases/download/version_1.27.1/Npackd-1.27.1.0.zip",
    "hash": "e392e33db321794270c935597feb85d93b6403c6dccf5a1a0838fa2dd5388f45",
    "shortcuts": [
        [
            "npackdg.exe",
            "Npackd"
        ]
    ],
    "checkver": {
        "script": [
            "$headers = @{ 'Accept' = 'application/vnd.github+json'; 'User-Agent' = 'Scoop-KiroBucket' }",
            "if (-not [string]::IsNullOrWhiteSpace($env:GITHUB_TOKEN)) { $headers['Authorization'] = \"Bearer $env:GITHUB_TOKEN\" }",
            "$releases = Invoke-RestMethod -Uri 'https://api.github.com/repos/npackd/npackd-cpp/releases?per_page=100' -Headers $headers",
            "$release = $null",
            "foreach ($candidate in $releases) {",
            "  if ($candidate.tag_name -match '^version_(?<version>\\d+\\.\\d+\\.\\d+)$') {",
            "    $assetName = 'Npackd-' + $Matches.version + '.0.zip'",
            "    if (@($candidate.assets | Where-Object { $_.name -eq $assetName }).Count -gt 0) { $release = $candidate; break }",
            "  }",
            "}",
            "if (-not $release) { throw 'No Npackd GUI ZIP release with a numbered version tag was found.' }",
            "Write-Output $release.tag_name"
        ],
        "regex": "^version_(?<version>[\\d.]+)$"
    },
    "autoupdate": {
        "url": "https://github.com/npackd/npackd-cpp/releases/download/version_$version/Npackd-$version.0.zip",
        "hash": {
            "url": "https://api.github.com/repos/npackd/npackd-cpp/releases/tags/version_$version",
            "regex": "\"name\"\\s*:\\s*\"Npackd-$version\\.0\\.zip\"[\\s\\S]*?\"digest\"\\s*:\\s*\"sha256:([a-f0-9]{64})\""
        }
    },
    "notes": [
        "Uses the official GUI ZIP archive rather than the MSI installer. The current upstream release 1.27.1 is marked as a prerelease.",
        "Npackd manages packages independently of Scoop. Its cache and package database are stored under Windows application data; this manifest does not relocate them to D:."
    ]
}
