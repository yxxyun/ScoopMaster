{
    "version": "9.3.0",
    "description": "A PC port of Legend of Zelda: Ocarina of Time",
    "homepage": "https://www.shipofharkinian.com",
    "license": "Unknown",
    "notes": [
        "Ship of Harkinian requires specific ROM(s) of Ocarina of Time to function.",
        "Learn more at https://www.shipofharkinian.com/setup-guide/windows and https://ship.equipment."
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/HarbourMasters/Shipwright/releases/download/9.3.0/SoH-Dewey-Alpha-Win64.zip",
            "hash": "bf46cfc41be17f3b63901db46dac46ac2a63ed3851aa13e3ba6c9ec5d0ac2632"
        }
    },
    "pre_install": [
        "'shipofharkinian.json', 'imgui.ini' | % {",
        "   if (!(Test-Path \"$persist_dir\\$_\")) {",
        "      New-Item \"$dir\\$_\" | Out-Null",
        "   }",
        "}"
    ],
    "post_install": [
        "'oot.o2r', 'oot-mq.o2r' | % {",
        "   if (Test-Path \"$persist_dir\\$_\") {",
        "       Copy-Item \"$persist_dir\\$_\" \"$dir\\$_\" -Force",
        "   }",
        "}"
    ],
    "shortcuts": [
        [
            "soh.exe",
            "Ship of Harkinian"
        ]
    ],
    "persist": [
        "logs",
        "mods",
        "Randomizer",
        "Save",
        "shipofharkinian.json",
        "imgui.ini"
    ],
    "pre_uninstall": [
        "'oot.o2r', 'oot-mq.o2r' | % {",
        "   if (Test-Path \"$dir\\$_\") {",
        "       Copy-Item \"$dir\\$_\" \"$persist_dir\\$_\" -Force",
        "   }",
        "}"
    ],
    "checkver": {
        "github": "https://api.github.com/repos/HarbourMasters/Shipwright/releases/latest",
        "jsonpath": "$.name",
        "regex": "(?<major>\\w+)\\s(?<minor>\\w+)\\s(?<version>[\\d\\.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/HarbourMasters/Shipwright/releases/download/$version/SoH-$matchMajor-$matchMinor-Win64.zip"
            }
        }
    }
}
