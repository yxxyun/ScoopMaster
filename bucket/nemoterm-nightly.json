{
    "version": "0.0.1",
    "description": "Lightweight native Windows terminal: PuTTY's pterm with ConPTY built in. Nightly build from main.",
    "homepage": "https://github.com/xiongnemo/nemoterm",
    "license": "MIT",
    "notes": [
        "This is a prerelease built from main; there is no stable nemoterm yet.",
        "Start it with nemoterm, or nt for short (like Windows Terminal's wt). The Start menu has a Nemoterm shortcut.",
        "Settings are kept in the registry, under HKCU\\Software\\Nemo\\Nemoterm, apart from PuTTY's. Uninstalling leaves them; to remove them as well, run: reg delete HKCU\\Software\\Nemo\\Nemoterm /f",
        "Known issues: https://github.com/xiongnemo/nemoterm/blob/main/docs/KNOWN_ISSUES.md"
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/xiongnemo/nemoterm/releases/download/v0.0.1/nemoterm-v0.0.1-windows-amd64.zip",
            "hash": "d974dcaccfdc16842d7db2b5b200372d392613fd3c579b4ceee05345e94b528b"
        }
    },
    "bin": [
        "nemoterm.exe",
        [
            "nemoterm.exe",
            "nt"
        ]
    ],
    "shortcuts": [
        [
            "nemoterm.exe",
            "Nemoterm"
        ]
    ],
    "checkver": {
        "script": [
            "$headers = @{ Accept = 'application/vnd.github+json' }",
            "if ($token = Get-GitHubToken) { $headers.Authorization = \"token $token\" }",
            "(Invoke-WebRequest -UseBasicParsing -Headers $headers -Uri 'https://api.github.com/repos/xiongnemo/nemoterm/releases').Content"
        ],
        "regex": "(?s)\"tag_name\":\\s*\"v(?<version>[^\"]+)\"(?:(?!\"tag_name\").)*?\"prerelease\":\\s*true(?:(?!\"tag_name\").)*?\"name\":\\s*\"nemoterm-v\\k<version>-windows-amd64\\.zip\""
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/xiongnemo/nemoterm/releases/download/v$version/nemoterm-v$version-windows-amd64.zip"
            }
        }
    }
}
