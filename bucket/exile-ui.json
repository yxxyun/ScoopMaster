{
    "version": "1.65.4",
    "description": "UI and QoL overlay for Path of Exile 1 and 2",
    "homepage": "https://github.com/Lailloken/Exile-UI",
    "license": "MIT",
    "depends": [
        "versions/autohotkey1.1",
        "exile-ui-layouts"
    ],
    "architecture": {
        "64bit": {
            "url": "https://codeload.github.com/Lailloken/Exile-UI/zip/refs/tags/v1.65.4#/dl.zip",
            "hash": "76bc4264a1336c5a05a9823c201f8b6132b80ed243aaa9ae09bb857a5636e70a",
            "extract_dir": "Exile-UI-1.65.4"
        }
    },
    "pre_install": [
        "Set-Content \"$dir\\exile-ui.cmd\" '@start \"\" autohotkeyu64.exe \"%~dp0Exile UI.ahk\" %*' -Encoding Ascii",
        "$layoutsDir = \"$(appdir 'exile-ui-layouts' $global)\\current\"",
        "New-Item -ItemType Junction -Path \"$dir\\img\\GUI\\act-decoder\" -Target $layoutsDir -Force | Out-Null"
    ],
    "bin": "exile-ui.cmd",
    "shortcuts": [
        [
            "exile-ui.cmd",
            "Exile UI",
            "",
            "img\\GUI\\tray.ico"
        ]
    ],
    "persist": [
        "add-ons",
        "cheat-sheets",
        "cheat-sheets 2",
        "exports",
        "ini",
        "ini 2",
        "data\\ko-KR",
        "data\\fr"
    ],
    "checkver": {
        "github": "https://github.com/Lailloken/Exile-UI"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://codeload.github.com/Lailloken/Exile-UI/zip/refs/tags/v$version#/dl.zip",
                "extract_dir": "Exile-UI-$version"
            }
        }
    },
    "notes": [
        "啟動命令：exile-ui，或使用開始功能表中的 Exile UI 捷徑。",
        "Exile UI 啟動時需要 Path of Exile 遊戲視窗。",
        "按住 Esc 約半秒開啟功能選單；按住 Tab 顯示章節地圖與練級提示。",
        "PoE 1 與 PoE 2 章節地圖素材會透過 exile-ui-layouts 自動安裝與更新，無需在工具內另行下載。",
        "繁中語言包會依 Path of Exile 的 language 設定同步客戶端語言資料；fr 目錄已持久化，升級後不會遺失。"
    ]
}
