{
    "version": "0.3.4",
    "description": "Dynamic wallpaper player with a native Windows settings interface and local video rendering.",
    "homepage": "https://github.com/Alpenl/wallpaper",
    "license": "PolyForm-Strict-1.0.0",
    "architecture": {
        "64bit": {
            "url": "https://github.com/Alpenl/wallpaper/releases/download/v0.3.4/Wallpaper-0.3.4-windows-amd64-setup.exe",
            "hash": "3d848fcf3ce46cb036526674bb86e65f538a992d17b0358d36b1cce945a623d5"
        },
        "arm64": {
            "url": "https://github.com/Alpenl/wallpaper/releases/download/v0.3.4/Wallpaper-0.3.4-windows-arm64-setup.exe",
            "hash": "bef3f4d4db6bd7d182ca790c994c9015b75d1d9cddbe21283b803456a84eb7cd"
        }
    },
    "installer": {
        "args": "/S"
    },
    "uninstaller": {
        "script": [
            "$uninstaller = Join-Path $env:LOCALAPPDATA 'Programs\\Wallpaper\\uninstall.exe'",
            "if (Test-Path -LiteralPath $uninstaller -PathType Leaf) {",
            "    & $uninstaller /S",
            "    if ($LASTEXITCODE -ne 0) { throw \"Vendor uninstaller failed with exit code $LASTEXITCODE.\" }",
            "}"
        ]
    },
    "checkver": {
        "url": "https://api.github.com/repos/Alpenl/wallpaper/releases?per_page=100",
        "jsonpath": "$[0].tag_name",
        "regex": "v([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/Alpenl/wallpaper/releases/download/v$version/Wallpaper-$version-windows-amd64-setup.exe",
                "hash": {
                    "mode": "json",
                    "url": "https://api.github.com/repos/Alpenl/wallpaper/releases/tags/v$version",
                    "jp": "$.assets[?(@.name == 'Wallpaper-$version-windows-amd64-setup.exe')].digest"
                }
            },
            "arm64": {
                "url": "https://github.com/Alpenl/wallpaper/releases/download/v$version/Wallpaper-$version-windows-arm64-setup.exe",
                "hash": {
                    "mode": "json",
                    "url": "https://api.github.com/repos/Alpenl/wallpaper/releases/tags/v$version",
                    "jp": "$.assets[?(@.name == 'Wallpaper-$version-windows-arm64-setup.exe')].digest"
                }
            }
        }
    },
    "notes": "The upstream PolyForm Strict 1.0.0 license permits non-commercial use only. mpv is not bundled and must be installed separately for default video playback."
}
