{
    "version": "0.1.0",
    "description": "Desktop workspace for managing AI coding-agent sessions, projects, and terminals.",
    "homepage": "https://github.com/onlynor/Sessionary-Desktop",
    "license": "Apache-2.0",
    "url": "https://github.com/onlynor/Sessionary-Desktop/releases/download/v0.1.0/Sessionary-Setup-0.1.0-amd64.exe",
    "hash": "01e8edd93d174fe4c7b23acef247c8e53be157c8fc3024675ceeebdcf1bf8e22",
    "##": "Installer Type: NSIS",
    "installer": {
        "args": [
            "/S",
            "/D=$dir"
        ]
    },
    "uninstaller": {
        "script": [
            "if ($cmd -ne 'update') {",
            "    $uninstaller = Join-Path $dir 'Uninstall.exe'",
            "    if (-not (Test-Path -LiteralPath $uninstaller -PathType Leaf)) { throw 'MyGo NSIS uninstaller was not found in the Scoop version directory.' }",
            "    $uninstallArgs = @('/S', ('\"' + '_?=' + $dir + '\"'))",
            "    $process = Start-Process -FilePath $uninstaller -ArgumentList $uninstallArgs -Wait -PassThru -ErrorAction Stop",
            "    if ($process.ExitCode -ne 0) { throw \"MyGo NSIS uninstaller exited with code $($process.ExitCode).\" }",
            "}"
        ]
    },
    "checkver": {
        "github": "https://github.com/onlynor/Sessionary-Desktop"
    },
    "autoupdate": {
        "url": "https://github.com/onlynor/Sessionary-Desktop/releases/download/v$version/Sessionary-Setup-$version-amd64.exe",
        "hash": {
            "mode": "json",
            "url": "https://api.github.com/repos/onlynor/Sessionary-Desktop/releases/tags/v$version",
            "jp": "$.assets[?(@.name == 'Sessionary-Setup-$version-amd64.exe')].digest"
        }
    },
    "notes": "Requires at least one supported coding-agent CLI installed and available on PATH; agent CLIs are not bundled."
}
