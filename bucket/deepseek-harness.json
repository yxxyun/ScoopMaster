{
    "$schema": "https://raw.githubusercontent.com/ScoopInstaller/Scoop/master/schema.json",
    "version": "0.2.1",
    "description": "DeepSeek official desktop client for the Harness agent runtime, supporting background tasks, local file access and plugin management.",
    "homepage": "https://www.deepseek.com/download",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://download.deepseek.com/desktop/dsh-latest-windows-x64.exe#/dl.7z",
            "hash": "d61cd8882f8b8a1251144320493ad27920d15139503eba2465b9579eee720cfc",
            "installer": {
                "script": [
                    "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-64.7z\" \"$dir\" -Removal",
                    "Remove-Item \"$dir\\`$PLUGINSDIR\", \"$dir\\Uninstall DeepSeek Harness.exe\" -Recurse -Force -ErrorAction SilentlyContinue"
                ]
            }
        }
    },
    "bin": "resources/runtime/cli/bin/dsh.cmd",
    "shortcuts": [
        [
            "DeepSeek Harness.exe",
            "DeepSeek Harness"
        ]
    ],
    "checkver": {
        "url": "https://github.com/deepseek-ai/deepseek-harness/releases",
        "regex": "/releases/tag/dsh-v([\\d.]+(?:-rc\\.[\\d]+)?)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://download.deepseek.com/desktop/dsh-latest-windows-x64.exe#/dl.7z"
            }
        }
    }
}
