{
    "version": "0.2.0-rc.1",
    "description": "DeepSeek Harness desktop application with a bundled DSH runtime and external plugins.",
    "homepage": "https://www.deepseek.com/",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://download.deepseek.com/dsh-desk/bin/win-x64/deepseek-harness-0.2.0-rc.1-win-x64.exe#/dl.7z",
            "hash": "9dd8538e554d3139998a8458e21c64a6f99470915cbf6cfd22bb71f356c7f399"
        }
    },
    "pre_install": [
        "# Unpack the Electron payload (app-64.7z) carried inside the NSIS installer.",
        "Get-ChildItem \"$dir\" -Filter '*.exe' | Remove-Item -Force -ErrorAction SilentlyContinue",
        "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-64.7z\" \"$dir\"",
        "Remove-Item \"$dir\\`$PLUGINSDIR\" -Recurse -Force -ErrorAction SilentlyContinue"
    ],
    "installer": {
        "script": [
            "# Keep the app's roaming data across updates by linking it to the persist directory.",
            "$dataPath = \"$env:APPDATA\\@deepseek-ai\\dsh-desktop\"",
            "$persistPath = \"$persist_dir\\AppData\"",
            "New-Item $persistPath -ItemType Directory -Force | Out-Null",
            "if (Test-Path $dataPath) {",
            "    $dataPathItem = Get-Item $dataPath -Force",
            "    if ($dataPathItem.LinkType -eq 'Junction') {",
            "        $dataPathItem.Delete()",
            "    } else {",
            "        Get-ChildItem $dataPath -Force | ForEach-Object { Move-Item $_.FullName $persistPath -Force }",
            "        Remove-Item $dataPath -Recurse -Force",
            "    }",
            "}",
            "New-Item -ItemType Junction -Path $dataPath -Target $persistPath | Out-Null",
            "# Register the app identity, the dsh:// URL protocol and an uninstall entry.",
            "$registryRoot = 'HKCU:\\SOFTWARE'",
            "$appId = '1bf39983-50d0-5fe0-9ef4-cece76f67c5e'",
            "$appKey = \"$registryRoot\\$appId\"",
            "New-Item $appKey -Force | Out-Null",
            "New-ItemProperty -Path $appKey -Name 'InstallLocation' -Value $dir -PropertyType String -Force | Out-Null",
            "New-ItemProperty -Path $appKey -Name 'KeepShortcuts' -Value 'true' -PropertyType String -Force | Out-Null",
            "New-ItemProperty -Path $appKey -Name 'ShortcutName' -Value 'DeepSeek Harness' -PropertyType String -Force | Out-Null",
            "New-Item \"$registryRoot\\Classes\\dsh\" -Force -ItemType String -Value 'URL:dsh' | Out-Null",
            "New-ItemProperty -Path \"$registryRoot\\Classes\\dsh\" -Name 'URL Protocol' -Value '' -PropertyType String -Force | Out-Null",
            "New-Item \"$registryRoot\\Classes\\dsh\\shell\\open\\command\" -Force -ItemType String -Value \"`\"$dir\\DeepSeek Harness.exe`\" `\"%1`\"\" | Out-Null",
            "$uninstallKey = \"$registryRoot\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\$appId\"",
            "New-Item $uninstallKey -Force | Out-Null",
            "New-ItemProperty -Path $uninstallKey -Name 'Comments' -Value 'Electron desktop shell for a bundled dsh runtime and external plugins' -PropertyType String -Force | Out-Null",
            "New-ItemProperty -Path $uninstallKey -Name 'DisplayIcon' -Value \"$dir\\DeepSeek Harness.exe,0\" -PropertyType String -Force | Out-Null",
            "New-ItemProperty -Path $uninstallKey -Name 'DisplayName' -Value \"DeepSeek Harness $version\" -PropertyType String -Force | Out-Null",
            "New-ItemProperty -Path $uninstallKey -Name 'DisplayVersion' -Value $version -PropertyType String -Force | Out-Null",
            "New-ItemProperty -Path $uninstallKey -Name 'InstallLocation' -Value $dir -PropertyType String -Force | Out-Null",
            "New-ItemProperty -Path $uninstallKey -Name 'NoModify' -Value 1 -PropertyType DWord -Force | Out-Null",
            "New-ItemProperty -Path $uninstallKey -Name 'NoRepair' -Value 1 -PropertyType DWord -Force | Out-Null",
            "New-ItemProperty -Path $uninstallKey -Name 'UninstallString' -Value 'scoop uninstall deepseek-harness' -PropertyType String -Force | Out-Null",
            "New-ItemProperty -Path $uninstallKey -Name 'QuietUninstallString' -Value 'scoop uninstall deepseek-harness' -PropertyType String -Force | Out-Null"
        ]
    },
    "post_install": "Remove-Item \"$dir\\`$PLUGINSDIR\", \"$dir\\Uninstall*\" -Force -Recurse -ErrorAction SilentlyContinue | Out-Null",
    "shortcuts": [
        [
            "DeepSeek Harness.exe",
            "DeepSeek Harness"
        ]
    ],
    "persist": "AppData",
    "pre_uninstall": [
        "# Close the app so its files and the data junction can be released.",
        "Get-Process -ErrorAction SilentlyContinue | Where-Object { ($_.Modules | Where-Object { $_.FileName -like \"$dir\\*\" }) } | Stop-Process -Force -ErrorAction SilentlyContinue",
        "$dataPath = \"$env:APPDATA\\@deepseek-ai\\dsh-desktop\"",
        "if (Test-Path $dataPath) {",
        "    $dataPathItem = Get-Item $dataPath -Force",
        "    if ($dataPathItem.LinkType -eq 'Junction') { $dataPathItem.Delete() }",
        "}",
        "Remove-Item 'HKCU:\\SOFTWARE\\1bf39983-50d0-5fe0-9ef4-cece76f67c5e' -Recurse -Force -ErrorAction SilentlyContinue",
        "Remove-Item 'HKCU:\\SOFTWARE\\Classes\\dsh' -Recurse -Force -ErrorAction SilentlyContinue",
        "Remove-Item 'HKCU:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\1bf39983-50d0-5fe0-9ef4-cece76f67c5e' -Recurse -Force -ErrorAction SilentlyContinue"
    ],
    "checkver": {
        "script": [
            "$feed = [System.Text.Encoding]::UTF8.GetString((Invoke-WebRequest -Uri 'https://download.deepseek.com/dsh-desk/feeds/win-x64/nightly.yml' -UseBasicParsing).Content)",
            "$version = [regex]::Match($feed, '(?m)^version:\\s*(\\S+)').Groups[1].Value",
            "$url = [regex]::Match($feed, '(?m)^\\s+- url:\\s*>-\\s*\\r?\\n\\s*(\\S+)').Groups[1].Value",
            "\"$version=====$url\""
        ],
        "regex": "(?<version>[^=]+)=====(?<url>.+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "$matchUrl#/dl.7z"
            }
        }
    }
}
