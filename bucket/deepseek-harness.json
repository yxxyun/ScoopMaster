{
    "version": "0.2.3-alpha.2",
    "description": "Official DeepSeek Harness desktop application for AI agents, coding, research and task automation.",
    "homepage": "https://www.deepseek.com/en/harness/",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://download.deepseek.com/desktop/dsh-latest-windows-x64.exe#/dl.7z",
            "hash": "013e28bc8c714749331308386d814108336851914d243aa6bcfd14de1ab30923"
        }
    },
    "depends": "7zip",
    "post_install": [
        "$payloads = @(Get-ChildItem -LiteralPath $dir -Filter 'app-64.7z' -File -Recurse)",
        "if ($payloads.Count -ne 1) { throw ('Expected one app-64.7z payload; found {0}.' -f $payloads.Count) }",
        "$archive = $payloads[0].FullName",
        "$sevenZip = (Get-Command '7z.exe' -ErrorAction Stop).Source",
        "& $sevenZip x $archive \"-o$dir\" -y -bd",
        "if ($LASTEXITCODE -ne 0) { throw ('7-Zip failed to extract app-64.7z (exit code {0}).' -f $LASTEXITCODE) }",
        "$mainExe = Join-Path $dir 'DeepSeek Harness.exe'",
        "if (-not (Test-Path -LiteralPath $mainExe -PathType Leaf)) { throw 'DeepSeek Harness.exe was not found after extracting the application payload.' }",
        "Remove-Item -LiteralPath $archive -Force",
        "$pluginDir = Join-Path $dir '$PLUGINSDIR'",
        "if (Test-Path -LiteralPath $pluginDir -PathType Container) { Remove-Item -LiteralPath $pluginDir -Recurse -Force }",
        "$uninstaller = Join-Path $dir 'Uninstall DeepSeek Harness.exe'",
        "if (Test-Path -LiteralPath $uninstaller -PathType Leaf) { Remove-Item -LiteralPath $uninstaller -Force }"
    ],
    "shortcuts": [
        [
            "DeepSeek Harness.exe",
            "DeepSeek Harness"
        ]
    ],
    "checkver": {
        "url": "https://api.github.com/repos/deepseek-ai/deepseek-harness/releases?per_page=1",
        "jsonpath": "$[0].tag_name",
        "regex": "dsh-v([0-9][0-9A-Za-z.+-]*)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://download.deepseek.com/desktop/dsh-latest-windows-x64.exe#/dl.7z",
                "hash": {
                    "mode": "download"
                }
            }
        }
    },
    "notes": "The official NSIS setup contains a nested app-64.7z archive. Scoop extracts both layers into the version directory without running the installer. The 7zip dependency is used for the second extraction. The desktop package includes its own Node.js and Python runtimes."
}
