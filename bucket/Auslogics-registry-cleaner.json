{
    "version": "11.2.0.6",
    "description": "Windows registry cleanup and repair utility",
    "homepage": "https://www.auslogics.com/en/software/registry-cleaner/",
    "license": "Proprietary",
    "url": "https://downloads.auslogics.com/en/registry-cleaner/auslogics-registry-cleaner-setup.exe",
    "hash": "1cf328e611bed67c32672fb40ffc7eb52af893ac4d28102b018b7625300e3455",
    "innosetup": true,
    "bin": "RegistryCleaner.exe",
    "shortcuts": [
        [
            "RegistryCleaner.exe",
            "Auslogics Registry Cleaner"
        ]
    ],
    "checkver": {
        "script": [
            "$html = (Invoke-WebRequest -Uri 'https://www.auslogics.com/en/software/registry-cleaner/' -UseBasicParsing).Content",
            "$text = [System.Net.WebUtility]::HtmlDecode([regex]::Replace($html, '<[^>]+>', ' '))",
            "$text = [regex]::Replace($text, '\\s+', ' ')",
            "$match = [regex]::Match($text, '(?i)Version\\s+(?<version>\\d+(?:\\.\\d+){3})')",
            "if (-not $match.Success) { throw 'Unable to detect the Auslogics Registry Cleaner version from the official product page.' }",
            "$match.Groups['version'].Value"
        ],
        "regex": "(?<version>\\d+(?:\\.\\d+){3})"
    },
    "autoupdate": {
        "url": "https://downloads.auslogics.com/en/registry-cleaner/auslogics-registry-cleaner-setup.exe"
    },
    "notes": "Scoop uses Inno Setup extraction to unpack the official installer into the application directory; the installer is not executed."
}
