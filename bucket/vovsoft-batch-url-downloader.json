{
    "version": "6.5",
    "description": "Portable edition of Vovsoft Batch URL Downloader.",
    "homepage": "https://vovsoft.com/software/batch-url-downloader/",
    "license": "Proprietary",
    "url": "https://vovsoft.com/files/batch-url-downloader-portable.zip?v=6.5",
    "checkver": {
        "url": "https://vovsoft.com/download/batch-url-downloader-portable/",
        "regex": "(?is)Version\\s*(?:<[^>]*>\\s*)*:?\\s*(?:<[^>]*>\\s*)*(?<version>\\d+(?:\\.\\d+)+)"
    },
    "autoupdate": {
        "url": "https://vovsoft.com/files/batch-url-downloader-portable.zip?v=$version"
    },
    "shortcuts": [
        [
            "batchurl.exe",
            "Vovsoft Batch URL Downloader"
        ]
    ],
    "pre_install": "if (-not (Test-Path -LiteralPath \"$dir\\key.txt\" -PathType Leaf)) { New-Item -ItemType File -Path \"$dir\\key.txt\" | Out-Null }",
    "persist": "key.txt"
}

