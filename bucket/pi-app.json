    "url": "https://github.com/justhil/pi-app/releases/download/v0.7.6/pi.Desktop-Portable-0.7.6-x64.exe",
    "hash": "aa50315a34e80c3cc9c259353843755aa01a3fe74a3ef6c263fd8101286672e8",
    "installer": {
        "script": [
            "Expand-7ZipArchive \"$dir\\$fname\" \"$dir\\temp\" -Removal",
            "Get-ChildItem \"$dir\\temp\\`$PLUGINSDIR\" -Filter '*.7z' | ForEach-Object {",
            "    Expand-7ZipArchive $_.FullName \"$dir\"",
            "}",
            "Remove-Item -Recurse -Force \"$dir\\temp\""
        ]
    },
    "bin": "pi Desktop.exe",
    "shortcuts": [
        [
            "pi Desktop.exe",
            "Pi Desktop"
        ]
    ],
    "checkver": {
        "github": "https://github.com/justhil/pi-app"
    },
    "autoupdate": {
        "url": "https://github.com/justhil/pi-app/releases/download/v$version/pi.Desktop-Portable-$version-x64.exe"
    }
}
