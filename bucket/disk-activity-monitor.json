{
    "version": "1.4.16",
    "description": "Windows SSD/HDD endurance monitor with ETW process attribution, SMART telemetry, write trends, and alerts.",
    "homepage": "https://github.com/andrewtheart/DiskActivityMonitor",
    "license": "Unknown",
    "architecture": {
        "64bit": {
            "url": "https://github.com/andrewtheart/DiskActivityMonitor/releases/download/v1.4.16/DiskActivityMonitor-Setup-1.4.16-x64.exe",
            "hash": "358f9924e194a3227ad87b71f0f4009ae6a4dbdde52901c867ae5b64ca867835"
        }
    },
    "installer": {
        "args": [
            "/VERYSILENT",
            "/SUPPRESSMSGBOXES",
            "/NORESTART",
            "/SP-",
            "/TASKS=!autostart"
        ]
    },
    "uninstaller": {
        "script": [
            "$programFiles = [Environment]::GetFolderPath([Environment+SpecialFolder]::ProgramFiles)",
            "$uninstaller = Join-Path $programFiles 'Disk Activity Monitor\\unins000.exe'",
            "if (Test-Path -LiteralPath $uninstaller) {",
            "    $process = Start-Process -FilePath $uninstaller -ArgumentList '/VERYSILENT','/SUPPRESSMSGBOXES','/NORESTART' -Wait -PassThru",
            "    if ($process.ExitCode -ne 0) { throw \"Disk Activity Monitor uninstaller failed with exit code $($process.ExitCode).\" }",
            "} else {",
            "    $service = Get-Service -Name 'DiskActivityMonitor' -ErrorAction SilentlyContinue",
            "    if ($service) {",
            "        if ($service.Status -ne 'Stopped') { Stop-Service -Name 'DiskActivityMonitor' -Force -ErrorAction Stop; $service.WaitForStatus('Stopped', [TimeSpan]::FromSeconds(20)) }",
            "        & \"$env:SystemRoot\\System32\\sc.exe\" delete DiskActivityMonitor | Out-Null",
            "        if ($LASTEXITCODE -ne 0) { throw 'Failed to delete the DiskActivityMonitor service.' }",
            "    }",
            "}"
        ]
    },
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/andrewtheart/DiskActivityMonitor/releases/download/v$version/DiskActivityMonitor-Setup-$version-x64.exe"
            }
        },
        "hash": {
            "mode": "download"
        }
    },
    "notes": [
        "Nonportable: the vendor installer registers a Windows service and installs files under Program Files; installation requires elevation.",
        "The vendor uninstaller removes the service and application files. Monitoring data and settings outside the application directory are retained."
    ]
}
