            "Set-Content -Path \"$dir\\email.cmd\" -Value '@\"%~dp0..\\..\\nodejs\\current\\node.exe\" \"%~dp0bin\\cli.mjs\" %*' -Encoding ascii"
        ]
    },
    "bin": "email.cmd"
