{
    "version": "0.21.1",
    "description": "Fast, native WhatsApp client built in Rust with egui",
    "homepage": "https://zapfast.rocks/",
    "license": {
        "identifier": "MIT",
        "url": "https://github.com/crmne/zapfast/blob/main/LICENSE"
    },
    "notes": "Update through Scoop ('scoop update zapfast'); ZapFast's built-in updater replaces the exe next to the portable marker, which is the copy Scoop manages.",
    "architecture": {
        "64bit": {
            "url": "https://github.com/crmne/zapfast/releases/download/v0.21.1/zapfast-v0.21.1-x86_64-pc-windows-msvc.zip",
            "hash": "4099ebdeb2b650714902d69827299712bf5e63b51755ce5f900afdc13ccec773"
        },
        "arm64": {
            "url": "https://github.com/crmne/zapfast/releases/download/v0.21.1/zapfast-v0.21.1-aarch64-pc-windows-msvc.zip",
            "hash": "ab232f7e660fa2d8cb862f4251f57aa627d169b24c6c10931762477ec4e9e013"
        }
    },
    "pre_install": [
        "# The zip holds one versioned folder (zapfast-v<version>-<target>); lift its contents so bin/shortcuts stay version-independent",
        "Get-ChildItem -Path \"$dir\" -Directory | ForEach-Object {",
        "    Get-ChildItem -Path $_.FullName -Force | Move-Item -Destination $dir -Force",
        "    Remove-Item -Path $_.FullName -Recurse -Force",
        "}"
    ],
    "bin": "zapfast.exe",
    "shortcuts": [
        [
            "zapfast.exe",
            "ZapFast"
        ]
    ],
    "checkver": {
        "github": "https://github.com/crmne/zapfast"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/crmne/zapfast/releases/download/v$version/zapfast-v$version-x86_64-pc-windows-msvc.zip"
            },
            "arm64": {
                "url": "https://github.com/crmne/zapfast/releases/download/v$version/zapfast-v$version-aarch64-pc-windows-msvc.zip"
            }
        }
    }
}
