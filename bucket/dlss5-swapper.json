{
    "version": "2.2.9",
    "description": "DLSS 5 Swapper installs, tunes and restores DLSS 5 in games and emulators, with native RenoDX, DLSS5-Feeder, OptiScaler and multipass routes for DirectX 8/9/11/12 and OpenGL.",
    "homepage": "https://github.com/rakanki911/DLSS5-Swapper",
    "license": "MIT",
    "notes": [
        "Portable build: library, history and backups live under %APPDATA%\\dlss5-swapper.",
        "Installer is unsigned upstream."
    ],
    "depends": "7zip",
    "architecture": {
        "64bit": {
            "url": "https://github.com/rakanki911/DLSS5-Swapper/releases/download/v2.2.9/DLSS5-Swapper-2.2.9-portable.exe",
            "hash": "6b064ecba6e487a87302c1d75c3fd2d8189e78fdf3c91e705eee3d4539ae23c8"
        }
    },
    "pre_install": [
        "Expand-7zipArchive \"$dir\\$fname\" -DestinationPath \"$dir\\_tmp\" -ExtractDir '$PLUGINSDIR'",
        "Expand-7zipArchive \"$dir\\_tmp\\app-64.7z\" -DestinationPath \"$dir\" -Removal",
        "Remove-Item \"$dir\\_tmp\", \"$dir\\$fname\" -Recurse -Force"
    ],
    "bin": "DLSS 5 Swapper.exe",
    "shortcuts": [
        [
            "DLSS 5 Swapper.exe",
            "DLSS 5 Swapper"
        ]
    ],
    "persist": "addons",
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/rakanki911/DLSS5-Swapper/releases/download/v$version/DLSS5-Swapper-$version-portable.exe"
            }
        }
    }
}
