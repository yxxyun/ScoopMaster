{
    "$schema": "https://raw.githubusercontent.com/lukesampson/scoop/master/schema.json",
    "version": "1.2.1.81",
    "description": "re:Blue rebuilds Blue Dragon (2007) as a native application. Nightly build.",
    "homepage": "https://github.com/zolaware/reblue",
    "license": "BSD-3-Clause",
    "suggest": {
        "vcredist": "extras/vcredist2022"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/zolaware/reblue/releases/download/nightly-v1.2.1-d72be1ec4-s923c1a59/reblue-1.2.1-dev-72be1ec4-923c1a59-win-amd64.zip",
            "hash": "88a32c8104c347982d0e1c64e6e903b74a9bad725c1c9252a88541bb651d22a0"
        }
    },
    "shortcuts": [
        [
            "reblue.exe",
            "reBlue Nightly"
        ]
    ],
    "persist": [
        "cache",
        "dlc",
        "game",
        "logs",
        "mods",
        "profiles",
        "user"
    ],
    "checkver": {
        "url": "https://api.github.com/repos/zolaware/reblue/releases",
        "script": [
            "$releases = $page | ConvertFrom-Json",
            "$latest = $releases | Where-Object { $_.prerelease -and $_.name -match '^reblue v[\\d.]+ dev nightly$' } | Sort-Object { [version]([regex]::Match($_.name, '[\\d.]+').Value) } -Descending | Select-Object -First 1",
            "$asset = $latest.assets.name | Where-Object { $_ -match '^reblue-[\\d.]+-dev-[a-f\\d]+-[a-f\\d]+-win-amd64\\.zip$' } | Select-Object -First 1",
            "'{0} {1}' -f ([regex]::Match($latest.name, '[\\d.]+').Value), $asset"
        ],
        "regex": "^(?<version>[\\d.]+) reblue-(?<base>[\\d.]+)-dev-(?<commit>[a-f\\d]+)-(?<sdk>[a-f\\d]+)-win-amd64\\.zip$"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/zolaware/reblue/releases/download/nightly-v$matchBase-d$matchCommit-s$matchSdk/reblue-$matchBase-dev-$matchCommit-$matchSdk-win-amd64.zip"
            }
        }
    }
}
