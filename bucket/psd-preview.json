{
    "version": "0.1.3",
    "description": "PSD/PSB thumbnails and preview pane in Windows Explorer, powered by a native Zig COM shell extension.",
    "homepage": "https://github.com/CYoJkoY/psd-preview",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/CYoJkoY/psd-preview/releases/download/v0.1.3/psd-preview-v0.1.3-x86_64-windows.zip",
            "hash": "d5a5bffd0662baa105837c75df3aec5dd010b90bebcf1d325a0d8cf6aafc960c"
        }
    },
    "post_install": [
        "Start-Process -FilePath regsvr32.exe -ArgumentList @('/s', '/n', '/i:auto', \"`\"$dir\\psd_preview.dll`\"\") -Wait"
    ],
    "pre_uninstall": [
        "if (Test-Path -LiteralPath \"$dir\\psd_preview.dll\") {",
        "    Start-Process -FilePath regsvr32.exe -ArgumentList @('/u', '/s', '/n', '/i:auto', \"`\"$dir\\psd_preview.dll`\"\") -Wait",
        "}"
    ],
    "notes": "Registers the handler machine-wide (HKLM) when elevated, falling back to the current user (HKCU) otherwise; Explorer thumbnails require the machine registration. If thumbnails do not refresh immediately, restart Explorer or clear the thumbnail cache.",
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/CYoJkoY/psd-preview/releases/download/v$version/psd-preview-v$version-x86_64-windows.zip"
            }
        }
    }
}
