{
    "version": "1.0.0",
    "description": "Original YTerminal portable from a private VaultS3 bucket.",
    "homepage": "https://www.yterminal.xyz/",
    "license": "Proprietary",
    "architecture": {
        "64bit": {
            "url": "https://raw.githubusercontent.com/GOKORURI007/ruri-scoop/master/scripts/yterminal/1.0.0/install.ps1",
            "hash": "e65690e4bd093606f5172806824d12b9fb7b4153cfefb19ca4bb06fc6dca92c8"
        }
    },
    "depends": ["main/aws", "main/7zip"],
    "pre_install": [
        "$bootstrap = Join-Path $dir 'install.ps1'",
        "& $bootstrap -InstallDir $dir",
        "Remove-Item -LiteralPath $bootstrap -Force -ErrorAction Stop"
    ],
    "bin": [["YTerminal.exe", "yterminal"]],
    "shortcuts": [["YTerminal.exe", "YTerminal"]],
    "notes": "Requires a local AWS CLI profile named yterminal-s3 with endpoint_url set to your VaultS3 S3 API and read access to the installation script and original YTerminal package."
}
