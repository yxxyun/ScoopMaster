{
    "version": "2.2.1.121",
    "description": "Flix - Share files like chatting. Cross-platform LAN file transfer tool for fast sharing between devices.",
    "homepage": "https://flix.center",
    "license": "Freeware",
    "architecture": {
        "64bit": {
            "url": "https://github.com/Tobiichi-Origuchi/flix-pkg/releases/download/windows-v2.2.1.121/Flix-Windows-portable-2.2.1.121.zip",
            "hash": "56a47962a0924ca1c13751c7dceeb2b74f57f3561f099fce8844969cdb3962f6"
        }
    },
    "installer": {
        "script": [
            ". \"$bucketsdir\\$bucket\\scripts\\utils.ps1\"",
            "New-PersistDirectory \"$env:APPDATA\\com.ifreedomer\\flix\" \"$persist_dir\\AppData\" -Migrate"
        ]
    },
    "shortcuts": [
        [
            "flix.exe",
            "..\\Flix"
        ]
    ],
    "pre_uninstall": [
        "$bucket = $install.bucket",
        ". \"$bucketsdir\\$bucket\\scripts\\utils.ps1\"",
        "Remove-Junction \"$env:APPDATA\\com.ifreedomer\\flix\"",
        "Remove-EmptyDirectory \"$env:APPDATA\\com.ifreedomer\""
    ],
    "checkver": {
        "github": "https://github.com/Tobiichi-Origuchi/flix-pkg",
        "regex": "windows-v(?<version>[\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/Tobiichi-Origuchi/flix-pkg/releases/download/windows-v$version/Flix-Windows-portable-$version.zip"
            }
        }
    }
}
