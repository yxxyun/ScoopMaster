{
    "version": "2.4.1",
    "description": "跨平台桌宠 BongoCat，为桌面增添乐趣！",
    "homepage": "https://github.com/ayangweb/BongoCat",
    "license": {
        "identifier": "MIT license",
        "url": "https://github.com/ayangweb/BongoCat#MIT-1-ov-file"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/ayangweb/BongoCat/releases/download/v2.4.1/BongoCat_2.4.1_x64.exe",
            "hash": "5c70890939c404fa3bfa4399a216ebebb6b96f5f5752f3ae0f9d73473813739b"
        }
    },
    "pre_install": "Remove-Item \"$dir\\`$*\", \"$dir\\uninst*\" -Force -Recurse",
    "installer": {
        "script": [
            "# handle runtime cache",
            "if (Test-Path \"$env:LOCALAPPDATA\\com.ayangweb.BongoCat\") { Remove-Item \"$env:LOCALAPPDATA\\com.ayangweb.BongoCat\" -Recurse -Force }",
            "if (Test-Path \"$env:APPDATA\\com.ayangweb.BongoCat\") { Remove-Item \"$env:APPDATA\\com.ayangweb.BongoCat\" -Recurse -Force }",
            "New-Item -ItemType Junction -Path \"$env:LOCALAPPDATA\\com.ayangweb.BongoCat\" -Target \"$persist_dir\\appdata\" -Force | Out-Null",
            "New-Item -ItemType Junction -Path \"$env:APPDATA\\com.ayangweb.BongoCat\" -Target \"$persist_dir\\userdata\" -Force | Out-Null"
        ]
    },
    "bin": "bongo-cat.exe",
    "shortcuts": [
        [
            "bongo-cat.exe",
            "bongo-cat"
        ]
    ],
    "checkver": {
        "github": "https://github.com/ayangweb/BongoCat",
        "regex": "tag/v([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/ayangweb/BongoCat/releases/download/v$version/BongoCat_$version_x64.exe"
            }
        }
    }
}
