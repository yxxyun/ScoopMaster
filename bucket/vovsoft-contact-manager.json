{
    "version": "2.3",
    "description": "Portable edition of Vovsoft Contact Manager.",
    "homepage": "https://vovsoft.com/software/contact-manager/",
    "license": "Proprietary",
    "url": "https://vovsoft.com/files/contact-manager-portable.zip?v=2.3",
    "checkver": {
        "url": "https://vovsoft.com/download/contact-manager-portable/",
        "regex": "(?is)Version\\s*(?:<[^>]*>\\s*)*:?\\s*(?:<[^>]*>\\s*)*(?<version>\\d+(?:\\.\\d+)+)"
    },
    "autoupdate": {
        "url": "https://vovsoft.com/files/contact-manager-portable.zip?v=$version"
    },
    "notes": [
        "SHA-256 and archive contents are not yet verified; inspect the ZIP and confirm the executable path before considering this manifest production-ready."
    ],
    "pre_install": [
        "if (-not (Test-Path -LiteralPath \"$dir\\key.txt\" -PathType Leaf)) { New-Item -ItemType File -Path \"$dir\\key.txt\" | Out-Null }"
    ],
    "persist": "key.txt"
}
