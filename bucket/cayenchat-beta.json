    "notes": "settings file will be stored in AppData\\Roaming\\CayenChat\\",
    "url": "https://github.com/koshian/cayenchat/releases/download/beta/cayenchat-windows-x86_64.zip",
    "hash": "bb8caaf26790b1ba6de111c5ce5c02cc41a6f22fbc186de7796c2ce3aa3ce71a",
    "bin": [
        [
            "cayenchat.exe",
            "cayenchat-beta"
        ]
    ],
    "shortcuts": [
        [
            "cayenchat.exe",
            "CayenChat Beta"
        ]
    ],
    "checkver": {
        "github": "https://api.github.com/repos/koshian/cayenchat/releases/tags/beta",
        "script": [
            "$release = $page | ConvertFrom-Json",
            "$date = ([DateTimeOffset]::Parse($release.created_at)).UtcDateTime.ToString('yyyyMMdd')",
            "$commit = $release.target_commitish",
            "if ($commit -notmatch '^[0-9a-f]{40}$') { throw 'target_commitish is not a commit SHA' }",
            "$commit = $commit.Substring(0, 7)",
            "Write-Output \"$($release.tag_name)|$date|$commit\""
        ],
        "regex": "(?<tag>[^|]+)\\|(?<date>\\d{8})\\|(?<commit>[0-9a-f]{7})",
        "replace": "0.0.0-${tag}.${date}.${commit}"
    },
    "autoupdate": {
        "url": "https://github.com/koshian/cayenchat/releases/download/$matchTag/cayenchat-windows-x86_64.zip"
    }
}
