            "url": "https://github.com/Nevuly/WSL2-Linux-Kernel-Rolling-LTS/releases/download/linux-wsl-lts-6.18.63.1/Image-arm64",
            "hash": "d896b31f74a71cb47881928993fa8c0dc79cf09495ea82900a5ea66225b81fff",
            "post_install": [
                ". $bucketsdir\\$bucket\\scripts\\IniFile.ps1",
