{
    "version": "0.4.0",
    "description": "Xray and sing-box desktop client with EasyTier and Tailscale mesh",
    "homepage": "https://github.com/zuoxinyu/xrose",
    "license": "GPL-3.0-or-later",
    "architecture": {
        "64bit": {
            "url": "https://github.com/zuoxinyu/xrose/releases/download/v0.4.0/Xrose-0.4.0-windows-amd64-full.zip",
            "hash": "2410563f796bd215a5d295d832f1e22054ec1ec1eb84fbc891d91ff991b1bb6a"
        },
        "arm64": {
            "url": "https://github.com/zuoxinyu/xrose/releases/download/v0.4.0/Xrose-0.4.0-windows-arm64-full.zip",
            "hash": "5013eff85445883415e590097aef43b4db570bc6ff17488a678bfba8cc91abd0"
        }
    },
    "pre_install": [
        "New-Item -ItemType Directory -Force -Path $dir | Out-Null",
        "@('@echo off', 'setlocal', 'if not defined XROSE_HOME set \"XROSE_HOME=%~dp0XroseData\"', '\"%~dp0resources\\xrose-seed\\xrose-cli.exe\" %*') | Set-Content -Path \"$dir\\xrose-cli.cmd\" -Encoding Ascii"
    ],
    "bin": [
        "Xrose.exe",
        "xrose-cli.cmd"
    ],
    "shortcuts": [
        [
            "Xrose.exe",
            "Xrose"
        ]
    ],
    "persist": "XroseData",
    "post_install": [
        "$proc = Start-Process -FilePath \"$dir\\Xrose.exe\" -ArgumentList '--prepare-resources' -Wait -PassThru",
        "if ($proc.ExitCode -ne 0) { Write-Warning \"Xrose resource preparation exited with code $($proc.ExitCode)\" }"
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/zuoxinyu/xrose/releases/download/v$version/Xrose-$version-windows-amd64-full.zip"
            },
            "arm64": {
                "url": "https://github.com/zuoxinyu/xrose/releases/download/v$version/Xrose-$version-windows-arm64-full.zip"
            }
        },
        "hash": {
            "url": "$baseurl/SHA256SUMS"
        }
    }
}
