{
    "$schema": "https://raw.githubusercontent.com/lukesampson/scoop/master/schema.json",
    "version": "1.1.2",
    "description": "A lightweight, cross-platform music studio built for clarity, automation, and sound creation.",
    "homepage": "https://kirastudio.org",
    "license": "Proprietary",
    "architecture": {
        "64bit": {
            "url": "https://github.com/BleuBleu/KiraStudioPublic/releases/download/1.1.2/KiraStudio112-WinPortableExe.zip",
            "hash": "9d937ea3319077f0458965719b541b99ae307e682a5bc3346f009e2ab0248575"
        }
    },
    "pre_install": "if (!(Test-Path $dir/KiraStudio.ini)) { New-Item -Path $dir/KiraStudio.ini -ItemType File }",
    "bin": "KiraStudio.exe",
    "shortcuts": [
        [
            "KiraStudio.exe",
            "KiraStudio"
        ]
    ],
    "persist": [
        "AutoSaves",
        "KiraStudio.ini"
    ],
    "checkver": {
        "url": "https://api.github.com/repos/BleuBleu/KiraStudioPublic/releases",
        "regex": "releases/download/(?<version>[\\d.]+)/KiraStudio(?<build>\\d+)-WinPortableExe.zip"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/BleuBleu/KiraStudioPublic/releases/download/$version/KiraStudio$matchBuild-WinPortableExe.zip"
            }
        }
    }
}
