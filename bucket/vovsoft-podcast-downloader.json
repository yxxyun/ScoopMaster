{
    "version": "3.5",
    "description": "Portable edition of Vovsoft Podcast Downloader.",
    "homepage": "https://vovsoft.com/software/podcast-downloader/",
    "license": "Proprietary",
    "url": "https://vovsoft.com/files/podcast-downloader-portable.zip?v=3.5",
    "checkver": {
        "url": "https://vovsoft.com/download/podcast-downloader-portable/",
        "regex": "(?is)Version\\s*(?:<[^>]*>\\s*)*:?\\s*(?:<[^>]*>\\s*)*(?<version>\\d+(?:\\.\\d+)+)"
    },
    "autoupdate": {
        "url": "https://vovsoft.com/files/podcast-downloader-portable.zip?v=$version"
    },
    "shortcuts": [
        [
            "podcast.exe",
            "Vovsoft Podcast Downloader"
        ]
    ],
    "notes": [
        "SHA-256 has not been verified; archive contents and the shortcut target have been checked."
    ],
    "pre_install": [
        "if (-not (Test-Path -LiteralPath \"$dir\\key.txt\" -PathType Leaf)) { New-Item -ItemType File -Path \"$dir\\key.txt\" | Out-Null }"
    ],
    "persist": "key.txt"
}
