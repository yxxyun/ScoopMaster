{
    "version": "1.0.8",
    "description": "Safety-first disk cleaner and disk space analyzer for macOS and Windows, with a duplicate file finder, large file cleanup, and app uninstaller",
    "homepage": "https://github.com/harry0703/MangoDisk",
    "license": "GPL-3.0-only",
    "notes": [
        "MangoDisk 是一个磁盘清理与空间分析工具，内置重复文件查找、大文件清理和应用卸载",
        "用户数据目录 1：%APPDATA%\\app.mangodisk.desktop\\（settings.json、installation.json、.window-state.json）",
        "用户数据目录 2：%LOCALAPPDATA%\\app.mangodisk.desktop\\（data、cache、runtime、logs）",
        "本包会将这两个目录持久化到 Scoop 的 persist，并在原路径创建 Junction 指向 persist",
        "应用内置自动更新（mangodisk.app），建议在设置中关闭，避免与 Scoop 的更新机制冲突"
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/harry0703/MangoDisk/releases/download/v1.0.8/MangoDisk-1.0.8-windows.exe#/dl.7z",
            "hash": "bbf9d26c470f08728c51a2090124944f648b0fc9ac7ffcc59c9a6d698a400c7b"
        }
    },
    "pre_install": "Remove-Item \"$dir\\`$*\", \"$dir\\uninstall.exe\" -Force -Recurse -ErrorAction SilentlyContinue",
    "bin": "MangoDisk.exe",
    "shortcuts": [
        [
            "MangoDisk.exe",
            "MangoDisk"
        ]
    ],
    "post_install": [
        "$createJunction = {",
        "    param($source, $name)",
        "    $target = Join-Path $persist_dir $name",
        "    ensure $target",
        "",
        "    if (Test-Path $source) {",
        "        $item = Get-Item -LiteralPath $source -Force",
        "        if ($item.Attributes -band [IO.FileAttributes]::ReparsePoint) {",
        "            Write-Host \"检测到已存在的联接点：$source，跳过创建\"",
        "            return",
        "        }",
        "        if (-not $item.PSIsContainer) {",
        "            throw \"配置路径已存在且不是目录：$source\"",
        "        }",
        "",
        "        & robocopy $source $target /E /R:1 /W:1 /NFL /NDL /NJH /NJS /NP | Out-Null",
        "        if ($LASTEXITCODE -gt 7) {",
        "            Write-Host \"迁移失败，保留原目录：$source\"",
        "            return",
        "        }",
        "",
        "        $backup = \"$source.backup-$(Get-Date -Format 'yyyyMMdd-HHmmss')\"",
        "        try {",
        "            Move-Item -LiteralPath $source -Destination $backup -Force",
        "            Write-Host \"已备份原配置目录：$backup\"",
        "        } catch {",
        "            Write-Host \"无法重命名原目录：$source\"",
        "            return",
        "        }",
        "    }",
        "",
        "    New-Item -Path $source -ItemType Junction -Value $target | Out-Null",
        "}",
        "",
        "& $createJunction (Join-Path $env:APPDATA 'app.mangodisk.desktop') 'appdata'",
        "& $createJunction (Join-Path $env:LOCALAPPDATA 'app.mangodisk.desktop') 'localdata'"
    ],
    "persist": [
        "appdata",
        "localdata"
    ],
    "checkver": {
        "github": "https://github.com/harry0703/MangoDisk"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/harry0703/MangoDisk/releases/download/v$version/MangoDisk-$version-windows.exe#/dl.7z"
            }
        }
    }
}
