{
    "##": "Douzy 桌面版官方 Windows 安装包（NSIS setup.exe，用户级安装）。release tag 为 desktop-v<version>，资产名固定 Douzy-Setup.exe。",
    "version": "0.15.3",
    "description": "Douzy 桌面应用（官方 Windows 安装包，NSIS 用户级安装）",
    "homepage": "https://github.com/0X-42/douzy",
    "license": "Proprietary",
    "notes": [
        "安装官方 setup.exe：用 NSIS 静默参数 /S /D=$dir 装进 Scoop 版本目录，无需管理员权限",
        "release tag 带 desktop-v 前缀，资产名固定 Douzy-Setup.exe；checkver/autoupdate 自动跟随上游",
        "应用内置自动更新可能与 Scoop 管理冲突，建议关闭应用内自动更新，统一用 scoop update douzy",
        "卸载：scoop uninstall douzy"
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/0X-42/douzy/releases/download/desktop-v0.15.3/Douzy-Setup.exe",
            "hash": "83745e15dc57d8c81e4ff226740c000ab2fd07d8a531d16d6e829d02f506672a"
        }
    },
    "installer": {
        "script": [
            "$installer = Join-Path $dir $fname",
            "Start-Process -FilePath $installer -ArgumentList '/S', \"/D=$dir\" -Wait",
            "Remove-Item $installer -Force -ErrorAction SilentlyContinue"
        ]
    },
    "uninstaller": {
        "script": [
            "$u = Join-Path $dir 'Uninstall Douzy.exe'",
            "if (Test-Path -LiteralPath $u) { Start-Process -FilePath $u -ArgumentList '/S' -Wait }"
        ]
    },
    "bin": [
        [
            "Douzy.exe",
            "douzy"
        ]
    ],
    "shortcuts": [
        [
            "Douzy.exe",
            "Douzy"
        ]
    ],
    "checkver": {
        "url": "https://github.com/0X-42/douzy/releases/latest",
        "regex": "releases/tag/desktop-v([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/0X-42/douzy/releases/download/desktop-v$version/Douzy-Setup.exe"
            }
        },
        "hash": {
            "url": "https://github.com/0X-42/douzy/releases/download/desktop-v$version/SHA256SUMS.txt",
            "regex": "([0-9a-fA-F]{64})\\s+Douzy-Setup\\.exe"
        }
    }
}
