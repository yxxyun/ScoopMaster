{
    "version": "3.6",
    "description": "Device Guard and Credential Guard hardware readiness tool",
    "homepage": "https://www.microsoft.com/en-us/download/details.aspx?id=53337",
    "license": "Proprietary",
    "url": "https://download.microsoft.com/download/B/D/8/BD821B1F-05F2-4A7E-AA03-DF6C4F687B07/dgreadiness_v3.6.zip#/dl.7z",
    "hash": "b351be8e77c8d7994d97b8b9e60ef310ea5873a336fb8d3b5b009379f29bc6fc",
    "extract_dir": "dgreadiness_v3.6",
    "checkver": {
        "script": [
            "$response = Invoke-WebRequest -Uri 'https://www.microsoft.com/en-us/download/details.aspx?id=53337' -UseBasicParsing",
            "$html = [string]$response.Content",
            "$text = [System.Net.WebUtility]::HtmlDecode([regex]::Replace($html, '<[^>]+>', ' '))",
            "$match = [regex]::Match($text, '(?is)Version:\\s*(?<version>\\d+(?:\\.\\d+)+)')",
            "if (-not $match.Success) { throw 'Could not read the Device Guard tool version from Microsoft Download Center.' }",
            "$match.Groups['version'].Value"
        ],
        "regex": "^(?<version>\\d+(?:\\.\\d+)+)$"
    },
    "autoupdate": {
        "url": "https://download.microsoft.com/download/B/D/8/BD821B1F-05F2-4A7E-AA03-DF6C4F687B07/dgreadiness_v$version.zip#/dl.7z",
        "extract_dir": "dgreadiness_v$version"
    }
}
