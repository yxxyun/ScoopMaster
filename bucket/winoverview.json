{
    "version": "1.0.0",
    "description": "Windows 11 virtual desktop overview with live app previews, drag-and-drop desktop switching, and snap layouts.",
    "homepage": "https://github.com/yoursfriendlyghost/WinOverview",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/yoursfriendlyghost/WinOverview/releases/download/v1.0.0/WinOverview.exe",
            "hash": "a270a9d9eb1076e92b74049312714d00ab38834e631025093489bf6028804307"
        }
    },
    "shortcuts": [
        [
            "WinOverview.exe",
            "WinOverview"
        ]
    ],
    "suggest": {
        ".NET 10 Desktop Runtime": "versions/windowsdesktop-runtime-10.0"
    },
    "pre_uninstall": [
        "Stop-Process -Name 'WinOverview' -Force -ErrorAction SilentlyContinue",
        "Remove-ItemProperty -LiteralPath 'HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Run' -Name 'WinOverview' -ErrorAction SilentlyContinue",
        "Remove-Item -LiteralPath (Join-Path $env:APPDATA 'Microsoft\\Windows\\Start Menu\\Programs\\Startup\\WinOverview.lnk') -Force -ErrorAction SilentlyContinue",
        "Remove-Item -LiteralPath (Join-Path $env:LOCALAPPDATA 'WinOverview') -Recurse -Force -ErrorAction SilentlyContinue",
        "Remove-Item -LiteralPath (Join-Path $env:TEMP '.net\\WinOverview') -Recurse -Force -ErrorAction SilentlyContinue"
    ],
    "checkver": {
        "github": "https://github.com/yoursfriendlyghost/WinOverview"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/yoursfriendlyghost/WinOverview/releases/download/v$version/WinOverview.exe",
                "hash": {
                    "mode": "github"
                }
            }
        }
    },
    "notes": [
        "Requires the .NET 10 Desktop Runtime (x64) and 64-bit Windows 11 24H2 or newer. Install versions/windowsdesktop-runtime-10.0 if the runtime is missing.",
        "The published v1.0.0 release is WPF/.NET 10; the default branch has newer, unreleased Rust 2.0.0 code. The current executable extracts required components outside Scoop. The uninstall hook removes those components and optional startup entries while preserving settings under %APPDATA%\\WinOverview. Recheck the runtime and cleanup when upstream publishes the Rust build."
    ]
}
