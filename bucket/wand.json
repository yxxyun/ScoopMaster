{
    "version": "12.44.1",
    "description": "Thousands of free mods and trainers for your favorite single-player PC games — all in one place",
    "homepage": "https://www.wand.com",
    "license": {
        "identifier": "Freeware",
        "url": "https://www.wand.com/terms"
    },
    "architecture": {
        "64bit": {
            "url": "https://storage-cdn.wemod.com/app/releases/stable/Wand-12.44.1-full.nupkg",
            "hash": "179220381bcd3513ba9cdd41c83ed95aeca6b1a4b756bc0c53e645d0a68f8ce1"
        }
    },
    "pre_install": [
        "Get-ChildItem -Path \"$original_dir\" -Exclude lib | Remove-Item -Recurse -Force",
        "$unzip_dir = (Get-ChildItem -Path \"$original_dir\\lib\" -Directory)[0].FullName",
        "Move-Item -Path \"${unzip_dir}\\*\" -Destination \"$original_dir\" -Force",
        "Remove-Item -Path \"$original_dir\\lib\" -Recurse -Force"
    ],
    "post_install": [
        "if (Test-Path $env:APPDATA\\Wand) {",
        "    Copy-Item -Path $env:APPDATA\\Wand\\* -Destination \"$persist_dir\\roaming_data\" -Force -Recurse",
        "    Remove-Item $env:APPDATA\\Wand -Force -Recurse",
        "}",
        "if (Test-Path $env:LOCALAPPDATA\\Wand) {",
        "    Copy-Item -Path $env:LOCALAPPDATA\\Wand\\* -Destination \"$persist_dir\\local_data\" -Force -Recurse",
        "    Remove-Item $env:LOCALAPPDATA\\Wand -Force -Recurse",
        "}",
        "New-Item -ItemType Junction -Path $env:APPDATA\\Wand -Target $persist_dir\\roaming_data | Out-Null",
        "New-Item -ItemType Junction -Path $env:LOCALAPPDATA\\Wand -Target $persist_dir\\local_data | Out-Null",
        "$app_dir = \"$env:LOCALAPPDATA\\Wand\\app-$($manifest.version)\"",
        "if (Test-Path $app_dir) {",
        "    Remove-Item -Path $app_dir -Recurse -Force",
        "}",
        "New-Item -ItemType Junction -Path $app_dir -Target (Get-Item $dir).Target | Out-Null"
    ],
    "post_uninstall": [
        "Remove-Item -Path \"$env:APPDATA\\Wand\" -Recurse -Force",
        "Remove-Item -Path \"$env:LOCALAPPDATA\\Wand\" -Recurse -Force",
        "Remove-Item -Path \"$persist_dir\\local_data\\app-$($manifest.version)\" -Recurse -Force"
    ],
    "shortcuts": [["Wand.exe", "Wand"]],
    "persist": ["local_data", "roaming_data"],
    "checkver": {
        "script": [
            "$resp = Invoke-WebRequest -Uri 'https://api.wemod.com/client/channels/stable/RELEASES'",
            "$body = $resp.Content -replace '^\\xEF\\xBB\\xBF', ''",
            "$download_url = $body -split '\\s' -match '^http(s?)://'",
            "$version = $download_url -split '-' -match '\\d(\\.\\d+)+'",
            "Write-Output $version"
        ],
        "regex": "(?<version>[\\d\\.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://storage-cdn.wemod.com/app/releases/stable/Wand-$version-full.nupkg"
            }
        }
    }
}
