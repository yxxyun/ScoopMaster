{
    "version": "1.2.1",
    "description": "A glossy dock for launching EXE, LNK, and Steam URLs on Windows 10/11.",
    "homepage": "https://github.com/Suraween/GlowZ-Dock",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/Suraween/GlowZ-Dock/releases/download/1.2.1/GlowZ_Dock_1.2.1_Setup.exe",
            "hash": "48f4cd52bdabdb813dc7b079c7606d28a9864c4d39c5687c65795144fc35973c"
        }
    },
    "pre_install": "Start-Process -FilePath (Join-Path $dir 'GlowZ_Dock_1.2.0_Setup.exe') -ArgumentList '/VERYSILENT','/SUPPRESSMSGBOXES','/NORESTART',('/DIR=\"{0}\"' -f $dir),'/NOICONS' -Wait; Remove-Item (Join-Path $dir 'GlowZ_Dock_1.2.0_Setup.exe') -Force",
    "bin": "GlowZ Dock.exe",
    "shortcuts": [
        [
            "GlowZ Dock.exe",
            "GlowZ Dock"
        ],
        [
            "GlowZ Dock Settings.exe",
            "GlowZ Dock Settings"
        ]
    ],
    "checkver": {
        "github": "https://github.com/Suraween/GlowZ-Dock"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/Suraween/GlowZ-Dock/releases/download/$version/GlowZ_Dock_$version_Setup.exe"
            }
        }
    },
    "notes": "Uses the official Inno Setup installer in silent mode and targets the Scoop app directory. GlowZ Dock is not fully portable: the application stores data in %USERPROFILE%\\.dock_cache and %APPDATA%\\GlowZ-Dock according to the upstream README."
}
