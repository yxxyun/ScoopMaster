{
    "version": "5.0",
    "description": "Portable edition of Vovsoft Batch Translator.",
    "homepage": "https://vovsoft.com/software/batch-translator/",
    "license": "Proprietary",
    "url": "https://vovsoft.com/files/batch-translator-portable.zip?v=5.0",
    "checkver": {
        "url": "https://vovsoft.com/download/batch-translator-portable/",
        "regex": "(?is)Version\\s*(?:<[^>]*>\\s*)*:?\\s*(?:<[^>]*>\\s*)*(?<version>\\d+(?:\\.\\d+)+)"
    },
    "autoupdate": {
        "url": "https://vovsoft.com/files/batch-translator-portable.zip?v=$version"
    },
    "shortcuts": [
        [
            "batchtranslator.exe",
            "Vovsoft Batch Translator"
        ]
    ],
    "notes": [
        "SHA-256 has not been verified; archive contents and the shortcut target have been checked."
    ],
    "pre_install": [
        "if (-not (Test-Path -LiteralPath \"$dir\\key.txt\" -PathType Leaf)) { New-Item -ItemType File -Path \"$dir\\key.txt\" | Out-Null }"
    ],
    "persist": "key.txt"
}
