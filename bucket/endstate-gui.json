{
    "version": "3.11.0",
    "description": "The official desktop app for Endstate, for restoring apps and settings from a portable file.",
    "homepage": "https://github.com/Artexis10/endstate-gui",
    "license": "Apache-2.0",
    "architecture": {
        "64bit": {
            "url": "https://github.com/Artexis10/endstate-gui/releases/download/gui-v3.11.0/Endstate_3.11.0_x64-setup.exe",
            "hash": "e9c2c9778d6fe99eaf62caa0bd1f3f4df6793975bab3f522c486f23b3bac9db9"
        }
    },
    "installer": {
        "args": [
            "/S",
            "/NS",
            "/D=$dir"
        ]
    },
    "uninstaller": {
        "script": [
            "if (Test-Path (Join-Path $dir 'uninstall.exe')) { Invoke-ExternalCommand (Join-Path $dir 'uninstall.exe') -ArgumentList '/S' | Out-Null }"
        ]
    },
    "bin": "Endstate.exe",
    "shortcuts": [
        [
            "Endstate.exe",
            "Endstate"
        ]
    ],
    "checkver": {
        "github": "https://github.com/Artexis10/endstate-gui",
        "regex": "gui-v([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/Artexis10/endstate-gui/releases/download/gui-v$version/Endstate_$version_x64-setup.exe"
            }
        }
    }
}
