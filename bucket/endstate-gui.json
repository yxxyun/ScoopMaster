{
    "version": "3.12.0",
    "description": "The official desktop app for Endstate, for restoring apps and settings from a portable file.",
    "homepage": "https://github.com/Artexis10/endstate-gui",
    "license": "Apache-2.0",
    "architecture": {
        "64bit": {
            "url": "https://github.com/Artexis10/endstate-gui/releases/download/gui-v3.12.0/Endstate_3.12.0_x64-setup.exe",
            "hash": "9574b4b770d88b13ea21cb8b5b44f7dc0617d32a50612a912c90a17af8835868"
        }
    },
    "installer": {
        "args": [
            "/S",
            "/NS",
            "/D=$dir"
        ]
    },
    "uninstaller": {
        "script": "if (Test-Path (Join-Path $dir 'uninstall.exe')) { Invoke-ExternalCommand (Join-Path $dir 'uninstall.exe') -ArgumentList '/S' | Out-Null }"
    },
    "bin": "Endstate.exe",
    "shortcuts": [
        [
            "Endstate.exe",
            "Endstate"
        ]
    ],
    "checkver": {
        "github": "https://github.com/Artexis10/endstate-gui",
        "regex": "gui-v([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/Artexis10/endstate-gui/releases/download/gui-v$version/Endstate_$version_x64-setup.exe"
            }
        }
    }
}
