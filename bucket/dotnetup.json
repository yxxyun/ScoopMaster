        }
    },
    "post_install": "shim \"$(versiondir $app $version $global)\\dotnetup.exe\" $global 'dotnetup'",
    "pre_uninstall": "rm_shim 'dotnetup' (shimdir $global) $app",
    "checkver": {
        "script": [
            "$r = (Invoke-WebRequest -Uri 'https://aka.ms/dotnet/dotnetup/preview/dotnetup-win-x64.exe' -Method Head -UseBasicParsing).BaseResponse",
            "if ($r.ResponseUri) { $r.ResponseUri.AbsoluteUri } else { $r.RequestMessage.RequestUri.AbsoluteUri }"
        ],
        "regex": "/dotnetup/([^/]+)/dotnetup-win-x64\\.exe"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://ci.dot.net/public/dotnetup/$version/dotnetup-win-x64.exe#/dotnetup.exe",
                "hash": {
                    "url": "https://ci.dot.net/public-checksums/dotnetup/$version/dotnetup-win-x64.exe.sha512"
                }
            },
            "arm64": {
                "url": "https://ci.dot.net/public/dotnetup/$version/dotnetup-win-arm64.exe#/dotnetup.exe",
                "hash": {
                    "url": "https://ci.dot.net/public-checksums/dotnetup/$version/dotnetup-win-arm64.exe.sha512"
                }
            }
        }
    },
    "notes": [
        "dotnetup is a public preview and tracks the 'preview' channel. 'dotnetup self update' would modify the Scoop-managed exe; use 'scoop update dotnetup' instead.",
        "Run 'dotnetup init' to set up. On Windows the suggested 'everywhere' mode changes the system PATH and takes precedence over machine-wide .NET installs; choose 'shell' or 'none' to avoid that."
    ]
}
