{
    "version": "0.1.0",
    "description": "A desktop harness for Overleaf: the real editor, plus folder sync, snapshots, local compiles with a PDF preview, and offline editing.",
    "homepage": "https://github.com/Londopy/canopy",
    "license": "MIT OR Apache-2.0",
    "notes": "Canopy runs in portable mode here: its settings, sign-ins and sync history are kept in Scoop's persist folder. Local compiles need a TeX install (MiKTeX, TeX Live or Tectonic).",
    "url": "https://github.com/Londopy/canopy/releases/download/v0.1.0/Canopy-v0.1.0-portable.zip",
    "hash": "0a6e5962b15fae3b89df91468c1ce390c384511fc2a775463696867a9a3f0196",
    "architecture": {
        "64bit": {
            "extract_dir": "Canopy\\x64"
        },
        "32bit": {
            "extract_dir": "Canopy\\x86"
        },
        "arm64": {
            "extract_dir": "Canopy\\arm64"
        }
    },
    "bin": "Canopy.exe",
    "shortcuts": [
        [
            "Canopy.exe",
            "Canopy"
        ]
    ],
    "pre_install": "if (!(Test-Path \"$persist_dir\\config.toml\")) { New-Item \"$dir\\config.toml\" -ItemType File | Out-Null }",
    "persist": [
        "config.toml",
        "webviews",
        "sync",
        "dashboard",
        "tools"
    ],
    "checkver": {
        "github": "https://github.com/Londopy/canopy"
    },
    "autoupdate": {
        "url": "https://github.com/Londopy/canopy/releases/download/v$version/Canopy-v$version-portable.zip",
        "hash": {
            "url": "https://github.com/Londopy/canopy/releases/download/v$version/SHA256SUMS.txt",
            "regex": "$sha256\\s+$basename"
        }
    }
}
