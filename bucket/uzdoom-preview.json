{
    "version": "5.0.0-pre.548+0a29289",
    "description": "Feature-centric port for all Doom engine games, based on GZDoom, adding an advanced renderer and powerful scripting capabilities (preview build)",
    "homepage": "https://zdoom.org/",
    "license": "GPL-3.0-or-later",
    "notes": [
        "Place WAD files (game data) in:",
        "",
        "    $persist_dir\\..\\_doom"
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/UZDoom/UZDoom/releases/download/x-preview/Windows-UZDoom-Preview-x86_64.zip",
            "hash": "a48c657e5528ab2289cd545cba791068f2b745f5a102e48f7518b93ad1a89f44"
        }
    },
    "pre_install": [
        "if (!(Test-Path \"$persist_dir\\uzdoom_portable.ini\")) {",
        "   New-Item \"$dir\\uzdoom_portable.ini\" -ItemType File | Out-Null",
        "}",
        "if (!(Test-Path \"$persist_dir\\..\\_doom\")) {",
        "   New-item \"$persist_dir\\..\\_doom\" -ItemType Directory | Out-Null",
        "}"
    ],
    "env_set": {
        "DOOMWADDIR": "$persist_dir\\..\\_doom"
    },
    "bin": [
        [
            "uzdoom.exe",
            "uzdoom-pre"
        ]
    ],
    "shortcuts": [
        [
            "uzdoom.exe",
            "UZDoom (preview)"
        ]
    ],
    "persist": [
        "uzdoom_portable.ini",
        "Save",
        "Screenshots"
    ],
    "checkver": {
        "url": "https://github.com/UZDoom/UZDoom/releases/tag/x-preview",
        "regex": "(?<version>\\d+\\.\\d+\\.\\d+-pre\\.(?<build>\\d+)\\+(?<commit>[a-f0-9]+))"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/UZDoom/UZDoom/releases/download/x-preview/Windows-UZDoom-Preview-x86_64.zip"
            }
        }
    }
}
