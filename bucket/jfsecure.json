{
    "version": "2.6.3",
    "description": "Secrets and snippets at a global hotkey: offline encrypted vault with a deniable password, CLI and SSH agent",
    "homepage": "https://secure.jfolio.org/",
    "license": "Freeware",
    "notes": [
        "JFSecure is installed per-user into %LOCALAPPDATA%\\JFSecure (the same place as the setup from the website),",
        "so the app can update itself; `scoop update jfsecure` works too. The `jfs` command is on PATH after the first start.",
        "Vaults stay in %APPDATA%\\JFSecure when it is uninstalled."
    ],
    "architecture": {
        "64bit": {
            "url": "https://secure.jfolio.org/api/updates/download/2.6.3/win-x64?src=scoop#/JFSecure.Setup.2.6.3.exe",
            "hash": "2c224a6efac6f652cdda2801a43a6eebaaeeebcfb14dc4fb94e7da880e2740f9"
        }
    },
    "installer": {
        "script": [
            "Start-Process -Wait -FilePath \"$dir\\JFSecure.Setup.$version.exe\" -ArgumentList '/S'",
            "Remove-Item \"$dir\\JFSecure.Setup.$version.exe\""
        ]
    },
    "uninstaller": {
        "script": [
            "$u = \"$env:LOCALAPPDATA\\JFSecure\\uninstall.exe\"",
            "if ($cmd -eq 'uninstall' -and (Test-Path $u)) { Start-Process -Wait -FilePath $u -ArgumentList '/S' }"
        ]
    },
    "checkver": {
        "url": "https://secure.jfolio.org/api/updates/latest?platform=win&arch=x64",
        "jsonpath": "$.version"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://secure.jfolio.org/api/updates/download/$version/win-x64?src=scoop#/JFSecure.Setup.$version.exe",
                "hash": {
                    "url": "https://secure.jfolio.org/api/updates/latest?platform=win&arch=x64",
                    "jsonpath": "$.file.sha256"
                }
            }
        }
    }
}
