{
    "version": "1.0.0",
    "description": "Unofficial tray app that shows and sets the hardware volume of Edifier MR studio monitors (MR4.5, MR3, MR5) over Bluetooth LE",
    "homepage": "https://github.com/tomcoolpxl/edifier-mr-volume",
    "license": {
        "identifier": "MIT",
        "url": "https://github.com/tomcoolpxl/edifier-mr-volume/blob/main/LICENSE"
    },
    "notes": [
        "The speaker's volume appears as a number in the notification area. Windows 11 hides new icons there: switch it on under Settings > Personalization > Taskbar > Other system tray icons.",
        "To start it when you sign in, right-click the number and tick Start with Windows."
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/tomcoolpxl/edifier-mr-volume/releases/download/v1.0.0/edifier-mr-volume-v1.0.0-win-x64.zip",
            "hash": "32423fdb8d85ab2f2090872867a0bf3b7361b96c2733ba36243f84f11c69b2ec"
        }
    },
    "shortcuts": [
        [
            "EdifierMrVolume.exe",
            "Edifier MR Volume"
        ]
    ],
    "pre_uninstall": [
        "# Close a running copy cleanly (it releases the speaker's Bluetooth link at once).",
        "if (Test-Path \"$dir\\EdifierMrVolume.exe\") { & \"$dir\\EdifierMrVolume.exe\" --exit; Start-Sleep -Seconds 3 }",
        "if ($cmd -eq 'uninstall') {",
        "    # Remove 'Start with Windows' only when it points at this Scoop copy.",
        "    $run = 'HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Run'",
        "    $value = (Get-ItemProperty $run -Name EdifierMrVolume -ErrorAction SilentlyContinue).EdifierMrVolume",
        "    if ($value -and $value -like \"*$(Split-Path $dir)*\") { Remove-ItemProperty $run -Name EdifierMrVolume }",
        "}"
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/tomcoolpxl/edifier-mr-volume/releases/download/v$version/edifier-mr-volume-v$version-win-x64.zip",
                "hash": {
                    "url": "$url.sha256"
                }
            }
        }
    }
}
