{
    "version": "0.5.3",
    "description": "Windows 11 update monitor that checks pending updates against Microsoft's known issues and pauses affected updates.",
    "homepage": "https://github.com/G4SBO/PatchLight",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/G4SBO/PatchLight/releases/download/v0.5.3/PatchLight-win-x64.zip",
            "hash": "8f4170f4bfdcca7435da644343edfe98d7cbe43455fe8c981a2837523ab184c1"
        }
    },
    "extract_dir": "PatchLight",
    "shortcuts": [
        [
            "PatchLight.exe",
            "PatchLight"
        ]
    ],
    "checkver": {
        "github": "https://github.com/G4SBO/PatchLight",
        "regex": "v([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/G4SBO/PatchLight/releases/download/v$version/PatchLight-win-x64.zip",
                "hash": {
                    "url": "https://api.github.com/repos/G4SBO/PatchLight/releases/tags/v$version",
                    "regex": "\"name\"\\s*:\\s*\"PatchLight-win-x64\\.zip\"[\\s\\S]*?\"digest\"\\s*:\\s*\"sha256:([a-f0-9]{64})\""
                }
            }
        }
    },
    "notes": [
        "PatchLight is intended for Windows 11.",
        "The ZIP does not register PatchLight's hourly SYSTEM scheduled task. Hourly checks and automatic pausing are therefore not configured; those features require the official installer and administrator rights.",
        "The upstream releases are not code-signed, so Windows SmartScreen may display a warning."
    ]
}
