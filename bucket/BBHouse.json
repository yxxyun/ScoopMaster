{
    "version": "2.0.3",
    "description": "哔哩哔哩第三方桌面客户端（Qt/C++ 原生实现），以动态流为首页，支持直播、港澳台番剧、弹幕播放、下载管理与本地历史缓存",
    "homepage": "https://github.com/endcloud/bbhouse-tauri-qt",
    "license": "GPL-3.0-only",
    "notes": [
        "应用数据由 Scoop 托管：数据库、历史导出、特别关注列表、头像缓存与定时服务配置统一存入 persist 的 data 目录（通过 BBHOUSE_DATA_DIR 环境变量重定向，快捷方式与命令行启动都会读到同一份数据）",
        "偏好设置 %APPDATA%\\shizi\\bbhouse-qt.ini 由 Scoop 接管（该目录是链到 persist\\appdata 的联接点）",
        "登录 Cookie 存放在 Scoop apps 目录根的 bilibili.cookie.txt（应用会从版本目录向上查找该文件），卸载时备份到 persist\\cookie；升级、scoop cleanup 与卸载都不会丢失登录态，请勿手动删除",
        "应用内置 ffmpeg 与 aria2c，下载能力开箱可用；curl 使用 Windows 系统自带版本",
        "“本地历史定时同步”需要在应用内以管理员权限注册 Windows 服务（以 LocalService 运行），Scoop 安装与卸载都不会注册或删除该系统服务",
        "Scoop apps 目录根下的 bilibili.cookie.txt 为空文件属正常状态，首次登录后才会写入内容"
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/endcloud/bbhouse-tauri-qt/releases/download/v2.0.3/BBHouse-2.0.3-win-x64.zip",
            "hash": "eb6af64a04fe85496075cb7fd36abdff2dfdb3ff5867e9567193da1e4bbd4942"
        }
    },
    "pre_install": [
        "# 上游 zip 的顶层目录带提交号（BBHouse[xxxxxxx]），逐版本变化，不能固定 extract_dir",
        "$inner = Get-ChildItem -LiteralPath $dir -Directory | Where-Object { $_.Name -like 'BBHouse*' } | Select-Object -First 1",
        "if ($inner) {",
        "    Get-ChildItem -LiteralPath $inner.FullName -Force | Move-Item -Destination $dir -Force",
        "    Remove-Item -LiteralPath $inner.FullName -Recurse -Force",
        "}"
    ],
    "shortcuts": [
        [
            "BBHouse.exe",
            "BBHouse"
        ]
    ],
    "post_install": [
        "$dataDir = Join-Path $persist_dir 'data'",
        "ensure $dataDir",
        "",
        "# 偏好 ini 位于 %APPDATA%\\shizi，用目录级联接点托管，避免对单个 ini 文件使用 persist 而生出同名目录",
        "$createJunction = {",
        "    param($source, $name)",
        "    $target = Join-Path $persist_dir $name",
        "    ensure $target",
        "",
        "    if (Test-Path $source) {",
        "        $item = Get-Item -LiteralPath $source -Force",
        "        if ($item.Attributes -band [IO.FileAttributes]::ReparsePoint) {",
        "            Write-Host \"检测到已存在的联接点：$source，跳过创建\"",
        "            return",
        "        }",
        "        if (-not $item.PSIsContainer) {",
        "            throw \"配置路径已存在且不是目录：$source\"",
        "        }",
        "",
        "        & robocopy $source $target /E /R:1 /W:1 /NFL /NDL /NJH /NJS /NP | Out-Null",
        "        if ($LASTEXITCODE -gt 7) {",
        "            Write-Host \"迁移失败，保留原目录：$source\"",
        "            return",
        "        }",
        "",
        "        $backup = \"$source.backup-$(Get-Date -Format 'yyyyMMdd-HHmmss')\"",
        "        try {",
        "            Move-Item -LiteralPath $source -Destination $backup -Force",
        "            Write-Host \"已备份原配置目录：$backup\"",
        "        } catch {",
        "            Write-Host \"无法重命名原目录：$source\"",
        "            return",
        "        }",
        "    }",
        "",
        "    New-Item -Path $source -ItemType Junction -Value $target | Out-Null",
        "}",
        "& $createJunction (Join-Path $env:APPDATA 'shizi') 'appdata'",
        "",
        "# Cookie 无法用单文件 persist：目标不存在时 Scoop 会建同名目录占名，对文件则建硬链接，",
        "# 而应用用 QSaveFile 原子替换写入，硬链接会被换掉、持久副本停留在旧内容。",
        "# 改放 Scoop apps 根目录：不在版本目录内，scoop cleanup 只处理 app 子目录，",
        "# 应用 AppPaths::repoRoot() 从 current 向上查找即可命中，升级与清理都不受影响。",
        "$appsRoot = Split-Path -Parent (Split-Path -Parent $dir)",
        "$cookie = Join-Path $appsRoot 'bilibili.cookie.txt'",
        "$cookieBackup = Join-Path (Join-Path $persist_dir 'cookie') 'bilibili.cookie.txt'",
        "if (-not (Test-Path -LiteralPath $cookie)) {",
        "    if (Test-Path -LiteralPath $cookieBackup) {",
        "        Copy-Item -LiteralPath $cookieBackup -Destination $cookie -Force",
        "        Write-Host \"已恢复上次登录凭据：$cookie\"",
        "    } else {",
        "        New-Item -ItemType File -Path $cookie -Force | Out-Null",
        "    }",
        "}"
    ],
    "pre_uninstall": [
        "# Scoop 卸载会删除 app 目录，先把 Cookie 备份到 persist，重装时自动恢复",
        "$appsRoot = Split-Path -Parent (Split-Path -Parent $dir)",
        "$cookie = Join-Path $appsRoot 'bilibili.cookie.txt'",
        "$cookieBackupDir = Join-Path $persist_dir 'cookie'",
        "if (Test-Path -LiteralPath $cookie) {",
        "    if (-not (Test-Path -LiteralPath $cookieBackupDir)) { New-Item -ItemType Directory -Path $cookieBackupDir -Force | Out-Null }",
        "    Copy-Item -LiteralPath $cookie -Destination (Join-Path $cookieBackupDir 'bilibili.cookie.txt') -Force -ErrorAction SilentlyContinue",
        "}"
    ],
    "post_uninstall": [
        "$source = Join-Path $env:APPDATA 'shizi'",
        "if (Test-Path -LiteralPath $source) {",
        "    $item = Get-Item -LiteralPath $source -Force",
        "    if ($item.Attributes -band [IO.FileAttributes]::ReparsePoint) {",
        "        Remove-Item -LiteralPath $source -Force",
        "    }",
        "}"
    ],
    "env_set": {
        "BBHOUSE_DATA_DIR": "$persist_dir\\data"
    },
    "checkver": {
        "github": "https://github.com/endcloud/bbhouse-tauri-qt"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/endcloud/bbhouse-tauri-qt/releases/download/v$version/BBHouse-$version-win-x64.zip"
            }
        },
        "hash": {
            "mode": "download"
        }
    }
}
