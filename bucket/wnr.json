            "hash": "d361209d3d168f76369a66fb705222c00c7c4be2dae8f78cb0382edf169117cc"
        },
        "arm64": {
            "url": "https://github.com/RoderickQiu/wnr/releases/download/v1.35.0-patch/wnr-1.35.0-patch-Win-arm64.7z",
            "hash": "2401b93f23c69d598de03f1321bd4db728299e978f9909b39381beeae123f0b3"
        }
    },
    "installer": {
        "script": [
            "function CreateFile([String] $file, [String] $content = $null) {",
            "    if (-not (Test-Path \"$persist_dir\\$file\")) {",
            "        Write-Host 'File' $file 'does not exists. Creating.' -f Yellow",
            "        Set-Content \"$dir\\$file\" $content",
            "    }",
            "}",
            "CreateFile 'wnr-config.json'",
            "CreateFile 'wnr-statistics.json'"
        ]
    },
    "uninstaller": {
        "script": [
            "function BackupFile([String] $file) {",
            "    Copy-Item \"$dir\\$file\" \"$persist_dir\" -Force",
            "}",
            "BackupFile 'wnr-config.json'",
            "BackupFile 'wnr-statistics.json'"
        ]
    },
    "shortcuts": [
        [
            "wnr.exe",
            "Work & Rest"
        ]
    ],
    "persist": [
        "wnr-config.json",
        "wnr-statistics.json"
    ],
    "checkver": {
        "github": "https://github.com/RoderickQiu/wnr",
        "regex": "/releases/tag/(?:v|V)?([\\w.-]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/RoderickQiu/wnr/releases/download/v$version/wnr-$version-Win-x64.7z"
            },
            "arm64": {
                "url": "https://github.com/RoderickQiu/wnr/releases/download/v$version/wnr-$version-Win-arm64.7z"
            }
        }
    }
}
