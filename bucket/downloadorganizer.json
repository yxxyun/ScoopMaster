{
    "version": "0.2.0",
    "description": "Organize downloads by file type with change previews, undo history and optional automatic sorting.",
    "homepage": "https://github.com/thonyydev/DownloadOrganizer",
    "license": "MIT",
    "url": "https://github.com/thonyydev/DownloadOrganizer/releases/download/v0.2.0/Download.Organizer_0.2.0_x64-setup.exe",
    "hash": "e1bc78ae48c9983c71d4859e3e850e2ecd5b515dcf94a5d1d555cd9d98b34f88",
    "installer": {
        "args": [
            "/S",
            "/D=$dir"
        ]
    },
    "uninstaller": {
        "file": "uninstall.exe",
        "args": "/S"
    },
    "bin": "download-organizer.exe",
    "shortcuts": [
        [
            "download-organizer.exe",
            "Download Organizer"
        ]
    ],
    "checkver": {
        "url": "https://api.github.com/repos/thonyydev/DownloadOrganizer/releases/latest",
        "jsonpath": "$.tag_name",
        "regex": "^v(?<version>[\\d.]+)$"
    },
    "autoupdate": {
        "url": "https://github.com/thonyydev/DownloadOrganizer/releases/download/v$version/Download.Organizer_$version_x64-setup.exe",
        "hash": {
            "mode": "json",
            "url": "https://api.github.com/repos/thonyydev/DownloadOrganizer/releases/tags/v$version",
            "jp": "$.assets[?(@.name == '$basename')].digest"
        }
    },
    "notes": [
        "The application has its own signed GitHub updater. Disable automatic updates in the application Settings if Scoop is to manage application updates.",
        "Settings and operation history remain outside Scoop under %APPDATA%\\com.thonyy.download-organizer and are not removed by Scoop uninstall."
    ]
}
