{
    "version": "1.1",
    "description": "Portable edition of Vovsoft Create Multiple Folders.",
    "homepage": "https://vovsoft.com/software/create-multiple-folders/",
    "license": "Proprietary",
    "url": "https://vovsoft.com/files/create-multiple-folders-portable.zip?v=1.1",
    "checkver": {
        "url": "https://vovsoft.com/download/create-multiple-folders-portable/",
        "regex": "(?is)Version\\s*(?:<[^>]*>\\s*)*:?\\s*(?:<[^>]*>\\s*)*(?<version>\\d+(?:\\.\\d+)+)"
    },
    "autoupdate": {
        "url": "https://vovsoft.com/files/create-multiple-folders-portable.zip?v=$version"
    },
    "shortcuts": [
        [
            "createmf.exe",
            "Vovsoft Create Multiple Folders"
        ]
    ],
    "pre_install": "if (-not (Test-Path -LiteralPath \"$dir\\key.txt\" -PathType Leaf)) { New-Item -ItemType File -Path \"$dir\\key.txt\" | Out-Null }",
    "persist": "key.txt"
}

