{
    "version": "1.11.0",
    "description": "Cool Again Shell: a Bash-language shell for Windows, with its Unix tools built in",
    "homepage": "https://github.com/tomcoolpxl/cash",
    "license": {
        "identifier": "MIT",
        "url": "https://github.com/tomcoolpxl/cash/blob/main/LICENSE"
    },
    "notes": [
        "If Scoop listed a running cash above, that is this window: it keeps the old version until you close it. New tabs start the new one.",
        "Windows Terminal has a \"cash\" profile. cash doctor checks the install."
    ],
    "suggest": {
        "carapace": "extras/carapace-bin",
        "Nerd Font": "nerd-fonts/CascadiaMono-NF"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/tomcoolpxl/cash/releases/download/v1.11.0/cash-v1.11.0-x86_64-pc-windows-msvc.zip",
            "hash": "629fd95549ee3fce2ee540b371c62042d58ee9c33d53f7c8de61771bf946a2fe"
        }
    },
    "bin": "cash.exe",
    "persist": "bin",
    "post_install": [
        "$cash = \"$(Split-Path $dir)\\current\\cash.exe\"",
        "& $cash --terminal-profile *> $null",
        "if (Test-Path \"$persist_dir\\bin\\.cash-links\") { & $cash --link-tools *> $null }",
        "& $cash --init-rc --once *> $null"
    ],
    "pre_uninstall": [
        "if ($cmd -eq 'uninstall') {",
        "    if (Test-Path \"$persist_dir\\bin\\.cash-links\") { & \"$dir\\cash.exe\" --unlink-tools *> $null }",
        "    & \"$dir\\cash.exe\" --remove-terminal-profile *> $null",
        "}"
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/tomcoolpxl/cash/releases/download/v$version/cash-v$version-x86_64-pc-windows-msvc.zip",
                "hash": {
                    "url": "$url.sha256"
                }
            }
        }
    }
}
