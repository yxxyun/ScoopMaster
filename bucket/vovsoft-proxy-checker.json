{
    "version": "1.3",
    "description": "Portable edition of Vovsoft Proxy Checker.",
    "homepage": "https://vovsoft.com/software/proxy-checker/",
    "license": "Proprietary",
    "url": "https://vovsoft.com/files/proxy-checker-portable.zip?v=1.3",
    "checkver": {
        "url": "https://vovsoft.com/download/proxy-checker-portable/",
        "regex": "(?is)Version\\s*(?:<[^>]*>\\s*)*:?\\s*(?:<[^>]*>\\s*)*(?<version>\\d+(?:\\.\\d+)+)"
    },
    "autoupdate": {
        "url": "https://vovsoft.com/files/proxy-checker-portable.zip?v=$version"
    },
    "shortcuts": [
        [
            "proxychecker.exe",
            "Vovsoft Proxy Checker"
        ]
    ],
    "notes": [
        "SHA-256 has not been verified; archive contents and the shortcut target have been checked."
    ],
    "pre_install": [
        "if (-not (Test-Path -LiteralPath \"$dir\\key.txt\" -PathType Leaf)) { New-Item -ItemType File -Path \"$dir\\key.txt\" | Out-Null }"
    ],
    "persist": "key.txt"
}
