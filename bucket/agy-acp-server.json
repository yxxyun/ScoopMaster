{
    "version": "1.5.0",
    "description": "Google Antigravity ACP server, for driving Antigravity from ACP clients such as acpx or Zed.",
    "homepage": "https://github.com/agentclientprotocol/registry/tree/main/antigravity-acp",
    "license": {
        "identifier": "Proprietary",
        "url": "https://antigravity.google/terms"
    },
    "notes": [
        "To sign in with a personal Google account, create",
        "  %USERPROFILE%\\.gemini\\antigravity-acp\\settings.json",
        "containing: { \"auth\": { \"type\": \"oauth-personal\" } }",
        "Open a new terminal so ANTIGRAVITY_HARNESS_PATH is picked up."
    ],
    "architecture": {
        "64bit": {
            "url": "https://dl.google.com/agy-extensions/releases/windows/agy-acp-server-1.5.0-windows-x86_64.zip",
            "hash": "6163f6b59b381bae419652dbae167bc8cda0ef29d665c0ba8af3d8c7fddd8867"
        },
        "arm64": {
            "url": "https://dl.google.com/agy-extensions/releases/windows/agy-acp-server-1.5.0-windows-arm64.zip",
            "hash": "340092b8af6dafc71eb15f4a8ec54b4d1f0bce16d1fa4d163b562c50b905f8f4"
        }
    },
    "bin": "agy_acp_server.exe",
    "env_set": {
        "ANTIGRAVITY_HARNESS_PATH": "$dir\\localharness_external.exe"
    },
    "checkver": {
        "url": "https://raw.githubusercontent.com/agentclientprotocol/registry/main/antigravity-acp/agent.json",
        "jsonpath": "$.distribution.binary['windows-x86_64'].archive",
        "regex": "releases/windows/(?<prefix>agy-acp-server-(?<version>[\\d.]+)-windows)-x86_64\\.zip"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://dl.google.com/agy-extensions/releases/windows/$matchPrefix-x86_64.zip"
            },
            "arm64": {
                "url": "https://dl.google.com/agy-extensions/releases/windows/$matchPrefix-arm64.zip"
            }
        }
    }
}
