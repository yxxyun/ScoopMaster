{
    "version": "2026.10.20-0503080",
    "description": "Free, privacy-focused PDF toolkit with professional tools for editing, converting, merging, splitting, and securing PDF files.",
    "homepage": "https://github.com/PDFCraftTool/pdfcraft",
    "license": "AGPL-3.0",
    "url": "https://github.com/PDFCraftTool/pdfcraft/releases/download/v2026.10.20-0503080/PDFCraft-Windows-x64-Portable.zip",
    "hash": "a2106415915c1c7bf169226f8f32ea1dfdb03b560cbaa570d174fc8ad8776d90",
    "bin": "PDFCraft-Portable.exe",
    "shortcuts": [
        [
            "PDFCraft-Portable.exe",
            "PDFCraftTool"
        ]
    ],
    "pre_install": [
        "$legacyData = Join-Path $env:LOCALAPPDATA 'com.pdfcraft.app'",
        "$persistedData = Join-Path $persist_dir 'data'",
        "$portableData = Join-Path $dir 'data'",
        "if (-not (Test-Path -LiteralPath $persistedData -PathType Container) -and (Test-Path -LiteralPath $legacyData -PathType Container)) {",
        "    $legacyItems = @(Get-ChildItem -LiteralPath $legacyData -Force)",
        "    if ($legacyItems.Count -gt 0) {",
        "        New-Item -ItemType Directory -Path $portableData -Force | Out-Null",
        "        try {",
        "            $legacyItems | Copy-Item -Destination $portableData -Recurse -Force -ErrorAction Stop",
        "        } catch {",
        "            Remove-Item -LiteralPath $portableData -Recurse -Force -ErrorAction SilentlyContinue",
        "            throw 'Could not copy the existing PDFCraft WebView2 profile. The original data was left untouched.'",
        "        }",
        "    }",
        "}"
    ],
    "persist": "data",
    "checkver": {
        "github": "https://github.com/PDFCraftTool/pdfcraft"
    },
    "autoupdate": {
        "url": "https://github.com/PDFCraftTool/pdfcraft/releases/download/v$version/PDFCraft-Windows-x64-Portable.zip"
    }
}
