{
    "version": "0.5.0",
    "description": "GUI Windows service manager with searchable inventory, previewed changes, service history, and configuration-drift snapshots.",
    "homepage": "https://betterwindowsservices.donislawdev.com/",
    "license": "GPL-3.0-or-later",
    "architecture": {
        "64bit": {
            "url": "https://github.com/donislawdev/BetterWindowsServices/releases/download/v0.5.0/BetterWindowsServices-win-x64.zip",
            "hash": "a96423ac6f1574c479a8d5cdd6b5d892fe00099519f51a689e8395c4bee750a2"
        }
    },
    "extract_dir": "BetterWindowsServices",
    "pre_install": [
        "$dataDir = Join-Path $dir 'data\\Roaming'",
        "New-Item -ItemType Directory -Path $dataDir -Force | Out-Null",
        "$launcher = Join-Path $dir 'BetterWindowsServices-launch.cmd'",
        "$launcherLines = @(",
        "    '@echo off',",
        "    'setlocal',",
        "    'set \"APPDATA=%~dp0data\\Roaming\"',",
        "    'set \"DOTNET_BUNDLE_EXTRACT_BASE_DIR=%~dp0data\\dotnet\"',",
        "    'start \"\" /D \"%~dp0\" \"%~dp0BetterWindowsServices.exe\" %*',",
        "    'exit /b 0'",
        ")",
        "[System.IO.File]::WriteAllLines($launcher, $launcherLines, [System.Text.Encoding]::ASCII)"
    ],
    "bin": [
        [
            "BetterWindowsServices-launch.cmd",
            "better-windows-services"
        ]
    ],
    "shortcuts": [
        [
            "BetterWindowsServices-launch.cmd",
            "Better Windows Services"
        ]
    ],
    "persist": "data",
    "checkver": {
        "github": "https://github.com/donislawdev/BetterWindowsServices",
        "regex": "^v(?<version>[\\d.]+)$"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/donislawdev/BetterWindowsServices/releases/download/v$version/BetterWindowsServices-win-x64.zip"
            }
        }
    },
    "notes": [
        "Requires Windows 10 1809 or Windows Server 2019 and later (x64). Administrator privileges are required only to apply service changes."
    ]
}
