{
    "version": "0.1.0",
    "description": "Hotkey window snapping for Windows (successor of RectangleWin/RectangleWinPlus).",
    "homepage": "https://github.com/scillidan/window-tools-rs",
    "license": "MIT",
    "notes": [
        "Config: window-tools.toml and resize.toml live next to the exe and are kept across updates.",
        "Start with Windows, suspend/resume and quit are in the tray menu."
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/scillidan/window-tools-rs/releases/download/v0.1.0/window-tools-rs-v0.1.0-win64.zip",
            "hash": "542fe017f43ff307e10d10d488f7953bc6ca04dce6bc34d57bdff5950d12f8b8"
        }
    },
    "bin": "window-tools-rs.exe",
    "shortcuts": [
        [
            "window-tools-rs.exe",
            "Window Tools"
        ]
    ],
    "persist": [
        "window-tools.toml",
        "resize.toml"
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/scillidan/window-tools-rs/releases/download/v$version/window-tools-rs-v$version-win64.zip",
                "hash": {
                    "url": "$url.sha256"
                }
            }
        }
    }
}
