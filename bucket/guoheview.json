{
    "homepage": "https://pic.ghxi.com",
    "description": "极速看图，不止于快。",
    "version": "3.3.3",
    "license": "Freeware",
    "url": "https://rj.lovestu.com/api/v1/release-files/151/download?filename=1#/dl.zip",
    "extract_dir": "GuoheViewPortable",
    "shortcuts": [
        [
            "GuoheView.exe",
            "果核看图"
        ]
    ],
    "persist": [
        "config.ini",
        "plugins"
    ],
    "checkver": {
        "script": [
            "$response = Invoke-RestMethod -Uri 'https://rj.lovestu.com/download/gh_view'",
            "$version = $response.data.version",
            "$file = $response.data.files | Where-Object { $_.name -like '*.7z' }",
            "return \"$version=====$($file.url)\""
        ],
        "regex": "(.*)=====(?<url>.*)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "$matchUrl#/dl.7z"
            }
        }
    }
}
