    "checkver": {
        "script": [
            "$html = (Invoke-WebRequest -Uri 'https://www.bitreplica.com/download/' -UseBasicParsing).Content",
            "$text = [System.Net.WebUtility]::HtmlDecode([regex]::Replace($html, '<[^>]+>', ' '))",
            "$text = [regex]::Replace($text, '\\s+', ' ')",
            "$match = [regex]::Match($text, '(?i)Version\\s*:\\s*(?<version>\\d+(?:\\.\\d+){3})')",
            "if (-not $match.Success) { throw 'Unable to detect BitReplica version from the official download page.' }",
            "$match.Groups['version'].Value"
        ],
        "regex": "(?<version>\\d+(?:\\.\\d+){3})"
    },
    "autoupdate": {
        "url": "https://www.bitreplica.com/download/auslogics-bitreplica-setup.exe"
    },
    "notes": [
        "Scoop extracts the official Inno Setup application payload into its app directory; it does not run the setup program.",
