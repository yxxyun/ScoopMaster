{
    "version": "ec9cb179-29946500",
    "description": "Act Decoder layout assets for Path of Exile 1 and 2",
    "homepage": "https://github.com/Lailloken/Exile-UI",
    "license": "MIT",
    "url": [
        "https://codeload.github.com/Lailloken/Exile-UI/zip/ec9cb1790134ec5a52a4a090b705a0919b7d10fb#/poe1.zip",
        "https://codeload.github.com/Lailloken/Exile-UI/zip/299465000cdca442856a623f04b2c362aa9005e0#/poe2.zip"
    ],
    "hash": [
        "2a15c8cd84710f27f6fee3e635e5b16364b499853871662c48298cff03f9f8e4",
        "ac1d00640814ff48c712e0c4af065af0080b9a27d7ffc119c6dba1df6ec5c517"
    ],
    "extract_dir": [
        "Exile-UI-ec9cb1790134ec5a52a4a090b705a0919b7d10fb",
        "Exile-UI-299465000cdca442856a623f04b2c362aa9005e0"
    ],
    "checkver": {
        "script": [
            "$branches = Invoke-RestMethod -Uri 'https://api.github.com/repos/Lailloken/Exile-UI/branches?per_page=100'",
            "$poe1 = ($branches | Where-Object { $_.name -eq 'layouts' }).commit.sha",
            "$poe2 = ($branches | Where-Object { $_.name -eq 'layouts_2' }).commit.sha",
            "if (!$poe1 -or !$poe2) { throw 'Could not find both layout branches.' }",
            "Write-Output \"$poe1-$poe2\""
        ],
        "regex": "(?<poe1>(?<poe1short>[a-f0-9]{8})[a-f0-9]{32})-(?<poe2>(?<poe2short>[a-f0-9]{8})[a-f0-9]{32})",
        "replace": "${poe1short}-${poe2short}"
    },
    "autoupdate": {
        "url": [
            "https://codeload.github.com/Lailloken/Exile-UI/zip/$matchPoe1#/poe1.zip",
            "https://codeload.github.com/Lailloken/Exile-UI/zip/$matchPoe2#/poe2.zip"
        ],
        "extract_dir": [
            "Exile-UI-$matchPoe1",
            "Exile-UI-$matchPoe2"
        ]
    },
    "notes": "PoE 1 與 PoE 2 章節地圖素材已安裝，Exile UI 會自動載入。"
}
