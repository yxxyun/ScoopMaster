{
    "version": "0.7.16",
    "description": "Native PC port of Super Mario Maker 2 built through static recompilation",
    "homepage": "https://github.com/smm2recomp/smm2recomp",
    "license": "GPL-3.0-or-later",
    "notes": [
        "Launch SMM2 Recomp from the Start menu or run smm2recomp to keep game data and settings in the persistent data folder.",
        "Setup requires your own Super Mario Maker 2 dump with update 3.0.3, console prod.keys and firmware. A Vulkan 1.3 graphics driver is required."
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/smm2recomp/smm2recomp/releases/download/v0.7.16/SMM2Recomp-windows-x86_64.zip",
            "hash": "8b99bc9a5f7cc2975fac3caf40b99e9ace8b706a954f9251e3ecf85e000b5f98"
        }
    },
    "extract_dir": "SMM2Recomp-windows-x86_64",
    "pre_install": [
        "@('@echo off', 'setlocal', 'set \"LARECOMP_DATA_ROOT=%~dp0data\"', 'start \"\" \"%~dp0smm2recomp.exe\" %*') | Set-Content \"$dir\\smm2recomp.cmd\" -Encoding Ascii"
    ],
    "bin": "smm2recomp.cmd",
    "shortcuts": [
        [
            "smm2recomp.cmd",
            "SMM2 Recomp",
            "",
            "SMM2Recomp.ico"
        ]
    ],
    "persist": "data",
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/smm2recomp/smm2recomp/releases/download/v$version/SMM2Recomp-windows-x86_64.zip",
                "hash": {
                    "url": "https://github.com/smm2recomp/smm2recomp/releases/download/v$version/SHA256SUMS.txt"
                }
            }
        }
    }
}
