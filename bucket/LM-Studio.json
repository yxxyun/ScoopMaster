            "hash": "8f7e0a098049f5d4bfafc45c61348ba5fcf76e579589639c599ff52d76c397a2"
        },
        "arm64": {
            "url": "https://installers.lmstudio.ai/win32/arm64/0.4.23-1/LM-Studio-0.4.23-1-arm64.exe#/dl.7z",
            "hash": "dab08fcd35f8f72e51442231badf55785fc3dd5b93061de8d33a575134c06c0c"
        }
    },
    "installer": {
        "script": [
            "$pkgfile = (Get-ChildItem \"$dir\" '*.nupkg' | Select-Object -First 1).FullName",
            "Expand-7ZipArchive \"$pkgfile\" \"$dir\" -Removal",
            "Move-Item \"$dir\\lib\\net45\\*\" \"$dir\""
        ]
    },
    "shortcuts": [
        [
            "LM Studio.exe",
            "LM Studio"
        ]
    ],
    "checkver": {
        "url": "https://formulae.brew.sh/api/cask/lm-studio.json",
        "regex": "\"version\":\\s*\"([\\d.]+),([\\d]+)\"",
        "replace": "$1-$2"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://installers.lmstudio.ai/win32/x64/$version/LM-Studio-$version-x64.exe#/dl.7z"
            },
            "arm64": {
                "url": "https://installers.lmstudio.ai/win32/arm64/$version/LM-Studio-$version-arm64.exe#/dl.7z"
            }
        }
    }
}
