{
    "version": "2.0.1",
    "description": "Offline-first notes app with local Wi-Fi sync between desktop and mobile.",
    "homepage": "https://zincnotes.com/",
    "url": "https://zincnotes.com/release/v2.0.1/Zinc-2.0.1-win.7z",
    "pre_install": [
        "$exe = Get-ChildItem -Path $dir -Recurse -File -Filter '*.exe' | Where-Object { $_.Name -match '^Zinc(?:\\.exe|[-_].*\\.exe)$' } | Select-Object -First 1",
        "if ($exe -and $exe.FullName -ne (Join-Path $dir 'Zinc.exe')) { Move-Item -LiteralPath $exe.FullName -Destination (Join-Path $dir 'Zinc.exe') -Force }"
    ],
    "bin": "Zinc.exe",
    "shortcuts": [
        [
            "Zinc.exe",
            "Zinc"
        ]
    ],
    "checkver": {
        "url": "https://zincnotes.com/download/desktop/",
        "regex": "Zinc-(?<version>[\\d.]+)-win\\.7z"
    },
    "autoupdate": {
        "url": "https://zincnotes.com/release/v$version/Zinc-$version-win.7z"
    }
}
