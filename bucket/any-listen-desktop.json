    "checkver": {
        "url": "https://api.github.com/repos/any-listen/any-listen-desktop/releases?per_page=100",
        "script": [
            "$releases = ConvertFrom-Json $page",
            "$release = $releases | Where-Object { $_.prerelease -and -not $_.draft -and $_.published_at } | Sort-Object { [DateTime]$_.published_at } -Descending | Select-Object -First 1",
            "$release.tag_name"
        ],
        "regex": "^v(\\d+(?:\\.\\d+)*-[0-9A-Za-z][0-9A-Za-z.-]*)$"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/any-listen/any-listen-desktop/releases/download/v$version/any-listen-$version-win_x64-green.7z"
            }
        }
    }
