    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/HeyOkay/HaloBattery/releases/download/v1.15.0/HaloBattery-1.15.0.zip",
            "hash": "92ce6de7c5f9dd3408bb0bf1f7b37510bea10cd84ad4231015cc27eda020d836"
        }
    },
    "extract_dir": "HaloBattery",
    "shortcuts": [
        [
            "HaloBattery.exe",
            "HaloBattery"
        ]
    ],
    "notes": [
        "The app's built-in updater replaces its own program files inside the Scoop directory.",
        "Prefer 'scoop update halobattery' so Scoop keeps the installed version in sync."
    ],
    "uninstaller": {
        "script": [
            "if ($cmd -eq 'uninstall') {",
            "    Remove-ItemProperty -Path 'HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Run' -Name 'HaloBattery' -ErrorAction SilentlyContinue",
            "    Remove-Item 'HKCU:\\Software\\Classes\\AppUserModelId\\HaloBattery' -Recurse -Force -ErrorAction SilentlyContinue",
            "}"
        ]
    },
    "checkver": {
        "github": "https://github.com/HeyOkay/HaloBattery"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/HeyOkay/HaloBattery/releases/download/v$version/HaloBattery-$version.zip"
            }
        }
    }
}
