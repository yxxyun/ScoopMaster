{
    "version": "3.4",
    "description": "Portable edition of Vovsoft Keep Software Alive.",
    "homepage": "https://vovsoft.com/software/keep-software-alive/",
    "license": "Proprietary",
    "url": "https://vovsoft.com/files/keep-software-alive-portable.zip?v=3.4",
    "checkver": {
        "url": "https://vovsoft.com/download/keep-software-alive-portable/",
        "regex": "(?is)Version\\s*(?:<[^>]*>\\s*)*:?\\s*(?:<[^>]*>\\s*)*(?<version>\\d+(?:\\.\\d+)+)"
    },
    "autoupdate": {
        "url": "https://vovsoft.com/files/keep-software-alive-portable.zip?v=$version"
    },
    "shortcuts": [
        [
            "keepalive.exe",
            "Vovsoft Keep Software Alive"
        ]
    ],
    "notes": [
        "SHA-256 has not been verified; archive contents and the shortcut target have been checked."
    ],
    "pre_install": [
        "if (-not (Test-Path -LiteralPath \"$dir\\key.txt\" -PathType Leaf)) { New-Item -ItemType File -Path \"$dir\\key.txt\" | Out-Null }"
    ],
    "persist": "key.txt"
}
