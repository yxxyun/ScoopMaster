{
    "version": "20.3.3",
    "description": "The official launcher for Epic Games Store (Portable)",
    "homepage": "https://store.epicgames.com/",
    "license": {
        "identifier": "Freeware",
        "url": "https://www.epicgames.com/site/en-US/tos"
    },
    "notes": "This package needs an elevated (Administrator) PowerShell to install, update and uninstall.",
    "url": "https://epicgames-download1.akamaized.net/Builds/UnrealEngineLauncher/Installers/Windows/EpicInstaller-20.3.3.msi#/setup.msi_",
    "hash": "d55d79710edfeaa107a62f2ea007bec1eeeac8b715a43c2ba3858eec7bc60337",
    "installer": {
        "script": [
            "if (!(is_admin)) {",
            "    error \"$app requires Administrator privileges to install the Epic components.\"",
            "    error \"Please open PowerShell with 'Run as administrator' and run again: scoop install $app\"",
            "    abort",
            "}",
            "",
            "# 1. Silent install, redirecting the files to $dir",
            "$msiArgs = @('/i', \"`\"$dir\\setup.msi_`\"\", '/qn', \"INSTALLDIR=`\"$dir`\"\", \"TARGETDIR=`\"$dir`\"\", 'SHOULD_RUN_LAUNCHER=0', '/norestart')",
            "$proc = Start-Process 'msiexec.exe' -ArgumentList $msiArgs -Wait -PassThru",
            "if ($proc.ExitCode -notin 0, 3010) {",
            "    error \"msiexec failed with exit code $($proc.ExitCode).\"",
            "    abort",
            "}",
            "",
            "# 2. Stop background processes and services that the MSI starts automatically",
            "Stop-Process -Name 'EpicGamesLauncher' -Force -ErrorAction SilentlyContinue",
            "Stop-Process -Name 'EpicWebHelper' -Force -ErrorAction SilentlyContinue",
            "Stop-Service -Name 'EpicOnlineServices' -Force -ErrorAction SilentlyContinue",
            "",
            "# 3. Remove the temporary installer to save ~250MB",
            "Remove-Item \"$dir\\setup.msi_\" -Force -ErrorAction SilentlyContinue"
        ]
    },
    "shortcuts": [
        [
            "Launcher\\Portal\\Binaries\\Win64\\EpicGamesLauncher.exe",
            "Epic Games Launcher"
        ]
    ],
    "bin": [
        [
            "Launcher\\Portal\\Binaries\\Win64\\EpicGamesLauncher.exe",
            "epic-games-launcher"
        ]
    ],
    "post_install": [
        "# Resolve Scoop's dynamic 'current' path",
        "$appRoot = Split-Path $dir -Parent",
        "$currentDir = Join-Path $appRoot 'current'",
        "$currentSlash = $currentDir -replace '\\\\', '/'",
        "$progDataSlash = $env:ProgramData -replace '\\\\', '/'",
        "",
        "# Link a system folder to persist (NTFS junction)",
        "function Link-EpicDir($sysPath, $persistTarget) {",
        "    if (!(Test-Path $persistTarget)) {",
        "        New-Item -ItemType Directory -Path $persistTarget -Force | Out-Null",
        "    }",
        "    if (Test-Path $sysPath) {",
        "        $item = Get-Item $sysPath -Force",
        "        if (!($item.Attributes -band [System.IO.FileAttributes]::ReparsePoint)) {",
        "            # Merge existing data into persist WITHOUT overwriting files that already exist there",
        "            robocopy $sysPath $persistTarget /E /XC /XN /XO /NFL /NDL /NJH /NJS /NP | Out-Null",
        "            if ($LASTEXITCODE -lt 8) {",
        "                Remove-Item $sysPath -Recurse -Force -ErrorAction SilentlyContinue",
        "            } else {",
        "                warn \"Could not migrate '$sysPath' to persist (robocopy exit code $LASTEXITCODE).\"",
        "            }",
        "        }",
        "    }",
        "    if (!(Test-Path $sysPath)) {",
        "        $parentDir = Split-Path $sysPath -Parent",
        "        if (!(Test-Path $parentDir)) { New-Item -ItemType Directory -Path $parentDir -Force | Out-Null }",
        "        New-Item -ItemType Junction -Path $sysPath -Target $persistTarget -Force | Out-Null",
        "    }",
        "    $final = Get-Item $sysPath -Force -ErrorAction SilentlyContinue",
        "    if (!$final -or !($final.Attributes -band [System.IO.FileAttributes]::ReparsePoint)) {",
        "        warn \"'$sysPath' is not linked to persist; its data will not be portable.\"",
        "    }",
        "}",
        "",
        "# Persist game manifests (C:\\ProgramData\\Epic)",
        "Link-EpicDir \"$env:ProgramData\\Epic\" \"$persist_dir\\ProgramData_Epic\"",
        "",
        "# Persist credentials and settings (AppData\\Local\\EpicGamesLauncher)",
        "Link-EpicDir \"$env:LOCALAPPDATA\\EpicGamesLauncher\" \"$persist_dir\\AppData_EpicGamesLauncher\"",
        "",
        "# Persist overlay data (AppData\\Local\\Epic Games)",
        "Link-EpicDir \"$env:LOCALAPPDATA\\Epic Games\" \"$persist_dir\\AppData_EpicGames\"",
        "",
        "# Write registry keys pointing to 'current' so they don't break on update",
        "$eosReg = 'HKCU:\\Software\\Epic Games\\EOS'",
        "if (!(Test-Path $eosReg)) { New-Item -Path $eosReg -Force | Out-Null }",
        "Set-ItemProperty -Path $eosReg -Name 'ModSdkCommand' -Value \"$currentSlash/Launcher/Portal/Binaries/Win64/EpicGamesLauncher.exe\" -Force",
        "Set-ItemProperty -Path $eosReg -Name 'ModSdkMetadataDir' -Value \"$progDataSlash/Epic/EpicGamesLauncher/Data/Manifests\" -Force",
        "",
        "$hklmLauncher = 'HKLM:\\SOFTWARE\\Epic Games\\EpicGamesLauncher'",
        "if (!(Test-Path $hklmLauncher)) { New-Item -Path $hklmLauncher -Force | Out-Null }",
        "Set-ItemProperty -Path $hklmLauncher -Name 'AppDataPath' -Value \"$env:ProgramData\\Epic\\EpicGamesLauncher\\Data\\\" -Force",
        "",
        "$ueReg = 'HKLM:\\SOFTWARE\\EpicGames\\Unreal Engine'",
        "if (!(Test-Path $ueReg)) { New-Item -Path $ueReg -Force | Out-Null }",
        "Set-ItemProperty -Path $ueReg -Name 'INSTALLDIR' -Value \"$currentDir\\\" -Force",
        "",
        "# Register the com.epicgames.launcher protocol for the web (OAuth) login",
        "$protoKey = 'HKCU:\\Software\\Classes\\com.epicgames.launcher'",
        "if (!(Test-Path \"$protoKey\\shell\\open\\command\")) { New-Item -Path \"$protoKey\\shell\\open\\command\" -Force | Out-Null }",
        "Set-ItemProperty -Path $protoKey -Name '(Default)' -Value 'URL:com.epicgames.launcher Protocol' -Force",
        "Set-ItemProperty -Path $protoKey -Name 'URL Protocol' -Value '' -Force",
        "Set-ItemProperty -Path \"$protoKey\\shell\\open\\command\" -Name '(Default)' -Value \"`\"$currentDir\\Launcher\\Portal\\Binaries\\Win64\\EpicGamesLauncher.exe`\" `\"%1`\"\" -Force"
    ],
    "pre_uninstall": [
        "if (!(is_admin)) {",
        "    error \"$app requires Administrator privileges to uninstall.\"",
        "    abort",
        "}",
        "# 1. Stop processes and services",
        "@('EpicGamesLauncher', 'EpicWebHelper', 'UnrealCEFSubProcess') | ForEach-Object {",
        "    Stop-Process -Name $_ -Force -ErrorAction SilentlyContinue",
        "}",
        "Stop-Service -Name 'EpicOnlineServices' -Force -ErrorAction SilentlyContinue",
        "",
        "# 2. Safely remove the junctions without deleting the data in persist",
        "@(\"$env:ProgramData\\Epic\", \"$env:LOCALAPPDATA\\EpicGamesLauncher\", \"$env:LOCALAPPDATA\\Epic Games\") | ForEach-Object {",
        "    if (Test-Path $_) {",
        "        $item = Get-Item $_ -Force",
        "        if ($item.Attributes -band [System.IO.FileAttributes]::ReparsePoint) {",
        "            [System.IO.Directory]::Delete($_)",
        "        }",
        "    }",
        "}",
        "",
        "# 3. Uninstall the MSI using its ProductCode (exact name match, 64-bit and 32-bit registry views)",
        "$uninstKey = @(",
        "    'HKLM:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Uninstall',",
        "    'HKLM:\\SOFTWARE\\WOW6432Node\\Microsoft\\Windows\\CurrentVersion\\Uninstall'",
        ") | ForEach-Object { Get-ChildItem $_ -ErrorAction SilentlyContinue } |",
        "    Where-Object { $_.GetValue('DisplayName') -eq 'Epic Games Launcher' -and $_.PSChildName -match '^\\{[0-9A-Fa-f-]{36}\\}$' } |",
        "    Select-Object -First 1 -ExpandProperty PSChildName",
        "if ($uninstKey) {",
        "    $proc = Start-Process 'msiexec.exe' -Wait -PassThru -ArgumentList @('/x', $uninstKey, '/qn', '/norestart')",
        "    if ($proc.ExitCode -notin 0, 3010) {",
        "        warn \"msiexec uninstall returned exit code $($proc.ExitCode).\"",
        "    }",
        "} else {",
        "    warn \"Could not find the Epic Games Launcher MSI in the registry; skipping MSI uninstall.\"",
        "}",
        "",
        "# 4. Clean up temporary files and registry leftovers",
        "Remove-Item \"$env:ProgramData\\EpicInstallerTemp\" -Recurse -Force -ErrorAction SilentlyContinue",
        "Remove-Item 'HKCU:\\Software\\Classes\\com.epicgames.launcher' -Recurse -Force -ErrorAction SilentlyContinue"
    ],
    "checkver": {
        "url": "https://scoop.sh",
        "useragent": "$app/$version",
        "script": [
            "$redirUrl = [Net.HttpWebRequest]::Create('https://launcher-public-service-prod06.ol.epicgames.com/launcher/api/installer/download/EpicGamesLauncherInstaller.msi')",
            "$redirUrl.method = 'head'",
            "[Web.HttpUtility]::ParseQueryString($redirUrl.GetResponse().ResponseUri.Query).Get('launcherfilename')"
        ],
        "regex": "\\AEpicInstaller-([\\d.]+)\\.msi\\Z"
    },
    "autoupdate": {
        "url": "https://epicgames-download1.akamaized.net/Builds/UnrealEngineLauncher/Installers/Windows/EpicInstaller-$version.msi#/setup.msi_"
    }
}
