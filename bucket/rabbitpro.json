{
    "version": "1.6.2",
    "description": "RabbitPro network client with built-in mihomo (Clash.Meta) core",
    "homepage": "https://rabbitgo.pro/",
    "license": "Proprietary",
    "url": "https://kf-app.dinghaoinc.com/202610212200/823779e102ecf75152f4559a5cecf0cb/storage/files/2026/06/26/4/5154620944/17824578486061.gz?filename=Rabbit-1.6.2.zip&p=null-13781895-48152471409",
    "hash": "778e107143ac10599aa71c1ac015f429f27361544ab5d9c5da5ec57ce35bbb6f",
    "installer": {
        "script": [
            "$proc = Start-Process -Wait -FilePath \"$dir\\RabbitPro Setup 1.6.2.exe\" -ArgumentList '/S', \"/D=$dir\" -Verb RunAs -PassThru",
            "if ($proc.ExitCode -ne 0) { throw \"RabbitPro installer exited with code $($proc.ExitCode)\" }",
            "Remove-Item \"$dir\\RabbitPro Setup 1.6.2.exe\" -Force -ErrorAction SilentlyContinue"
        ]
    },
    "uninstaller": {
        "script": [
            "if (Test-Path \"$dir\\Uninstall RabbitPro.exe\") { Start-Process -Wait -FilePath \"$dir\\Uninstall RabbitPro.exe\" -ArgumentList '/S' -Verb RunAs }",
            "Remove-Item \"$env:LOCALAPPDATA\\rabbitpro-updater\" -Recurse -Force -ErrorAction SilentlyContinue",
            "Remove-Item \"$env:USERPROFILE\\Desktop\\RabbitPro.lnk\", \"$env:APPDATA\\Microsoft\\Windows\\Start Menu\\Programs\\RabbitPro.lnk\" -Force -ErrorAction SilentlyContinue"
        ]
    },
    "bin": "RabbitPro.exe"
}
