{
    "version": "2.2.0",
    "description": "Native desktop email client with local encrypted credential storage and integrated message viewing.",
    "homepage": "https://github.com/CarlOpenLab/ccmail",
    "license": "Unknown",
    "architecture": {
        "64bit": {
            "url": "https://github.com/CarlOpenLab/ccmail/releases/download/v2.2.0/ccmail.Setup.2.2.0.amd64.exe",
            "hash": "908529398d6cf6bb87d9b83ac471f56d6bc167d75c3f5338ff7db33181cc7745"
        }
    },
    "installer": {
        "args": [
            "/S",
            "/D=$dir"
        ]
    },
    "uninstaller": {
        "script": [
            "$uninstaller = Get-ChildItem -LiteralPath $dir -File -Recurse -ErrorAction SilentlyContinue | Where-Object { $_.Name -match '(?i)^(unins\\d*|uninstall.*)\\.exe$' } | Select-Object -First 1",
            "if (-not $uninstaller) { throw 'The application uninstaller was not found in the Scoop version directory.' }",
            "$process = Start-Process -FilePath $uninstaller.FullName -ArgumentList '/S' -WorkingDirectory $uninstaller.DirectoryName -Wait -PassThru",
            "if ($process.ExitCode -ne 0) { throw ('The application uninstaller exited with code {0}.' -f $process.ExitCode) }"
        ]
    },
    "bin": "ccmail.exe",
    "shortcuts": [
        [
            "ccmail.exe",
            "ccmail"
        ]
    ],
    "checkver": {
        "github": "https://github.com/CarlOpenLab/ccmail"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/CarlOpenLab/ccmail/releases/download/v$version/ccmail.Setup.$version.amd64.exe",
                "hash": {
                    "mode": "json",
                    "url": "https://api.github.com/repos/CarlOpenLab/ccmail/releases/tags/v$version",
                    "jp": "$.assets[?(@.name == 'ccmail.Setup.$version.amd64.exe')].digest"
                }
            }
        }
    }
}
