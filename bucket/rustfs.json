{
    "version": "1.0.4",
    "description": "RustFS is an open-source, S3-compatible high-performance object storage system supporting migration and coexistence with other S3-compatible platforms such as MinIO and Ceph.",
    "homepage": "https://github.com/rustfs/rustfs",
    "notes": "Please set the RUSTFS_ACCESS_KEY and RUSTFS_SECRET_KEY environment variables to your desired access key and secret key before running RustFS.",
    "license": "Apache-2.0",
    "architecture": {
        "64bit": {
            "url": "https://github.com/rustfs/rustfs/releases/download/1.0.4/rustfs-windows-x86_64-v1.0.4.zip",
            "hash": "2e3af0b187dd70435dfdefe5f61aae7eede5a21fc9a2a2f07e289f727adbcfa6"
        }
    },
    "env_set": {
        "RUSTFS_ACCESS_KEY": "<change_me>",
        "RUSTFS_SECRET_KEY": "<change_me>",
        "RUSTFS_VOLUMES": "$persist_dir\\data\\rustfs0",
        "RUSTFS_ADDRESS": ":9000",
        "RUSTFS_CONSOLE_ADDRESS": ":9001",
        "RUSTFS_CONSOLE_ENABLE": "true",
        "RUSTFS_OBS_LOGGER_LEVEL": "error",
        "RUSTFS_OBS_LOG_DIRECTORY": "$persist_dir\\logs"
    },
    "post_install": [
        "New-Item -ItemType Directory -Path \"$persist_dir\\data\\rustfs0\" -Force | Out-Null",
        "New-Item -ItemType Directory -Path \"$persist_dir\\logs\" -Force | Out-Null"
    ],
    "bin": "rustfs.exe",
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/rustfs/rustfs/releases/download/$version/rustfs-windows-x86_64-v$version.zip"
            }
        }
    }
}
