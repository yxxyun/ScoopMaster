            "hash": "3a87abd8fe0c4b2154edbfbfa1ab5d5b693d46a20bda18f66bbe55671e8febbb"
        }
    },
    "pre_install": "Remove-Item \"$dir\\`$PLUGINSDIR\" -Recurse -Force -ErrorAction SilentlyContinue",
    "shortcuts": [
        [
            "tolaria.exe",
            "Tolaria"
        ]
    ],
    "checkver": {
        "script": [
            "$ErrorActionPreference = 'Stop'",
            "$json = Invoke-RestMethod 'https://github.com/refactoringhq/tolaria/releases/latest/download/stable-latest.json'",
            "$tag = [regex]::Match($json.platforms.'windows-x86_64'.url, '/download/(v[^/]+)/').Groups[1].Value",
            "\"$($json.version) $tag\""
        ],
        "regex": "^(\\S+) (\\S+)$",
        "replace": "$1"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/refactoringhq/tolaria/releases/download/$match2/Tolaria_$version_x64-setup.exe#/dl.7z"
            }
        }
    }
}
