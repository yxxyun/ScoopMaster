{
    "version": "4.49.0.6162",
    "description": "网易UU远程，提供低延迟远程连接与云游戏体验。",
    "homepage": "https://uuyc.163.com/",
    "license": {
        "identifier": "Proprietary",
        "url": "https://uuyc.163.com/"
    },
    "url": "https://a56.gdl.netease.com/UURemote_Setup_4.49.0.6162_1126083648_gwqd.exe?key1=d3531afb584e277450acf4ee9f606cfd&key2=6b0950a2&n=uuyc_4.49.0.exe",
    "hash": "6466c6b00a7bff54bed8ff25486e5e120f80f741c9f8070d566a14c713325d3f",
    "installer": {
        "script": [
            ". \"$bucketsdir\\$bucket\\bin\\utils.ps1\"",
            "$isAdmin = ([Security.Principal.WindowsPrincipal] [Security.Principal.WindowsIdentity]::GetCurrent()).IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)",
            "if (-not $isAdmin) { Write-Warning \"`nuuyc installation requires administrator privileges.`nPlease rerun Scoop in an elevated PowerShell.`n\"; exit 1 }",
            "Stop-App -ProcessNames @('GameViewer', 'GameViewerService')",
            "Stop-Service -Name 'GameViewerService' -Force -ErrorAction SilentlyContinue",
            "Write-Host (\"`nPersisting $env:LOCALAPPDATA\\GameViewer ... \") -NoNewline",
            "New-PersistDirectory \"$env:LOCALAPPDATA\\GameViewer\" \"$persist_dir\\AppData\" -Migrate",
            "Write-Host (\"`nPersisting $env:ProgramData\\Netease\\GameViewer ... \") -NoNewline",
            "New-PersistDirectory \"$env:ProgramData\\Netease\\GameViewer\" \"$persist_dir\\ProgramData\" -Migrate",
            "$installer = Get-ChildItem \"$dir\\*.exe\" | Select-Object -First 1",
            "Start-Process -FilePath $installer.FullName -ArgumentList \"/S /D=$dir\" -Wait",
            "Remove-Item 'HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\GameViewer' -Force -Recurse -ErrorAction SilentlyContinue | Out-Null",
            "Remove-ItemProperty 'HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Run' -Name 'GameViewer' -ErrorAction SilentlyContinue",
            "Get-ChildItem \"$env:USERPROFILE\\Desktop\", \"$env:PUBLIC\\Desktop\", \"$env:APPDATA\\Microsoft\\Windows\\Start Menu\\Programs\", \"$env:ProgramData\\Microsoft\\Windows\\Start Menu\\Programs\" -Filter '*UU*.lnk' -ErrorAction SilentlyContinue | Remove-Item -Force -ErrorAction SilentlyContinue",
            "Start-Service -Name 'GameViewerService' -ErrorAction SilentlyContinue"
        ]
    },
    "pre_uninstall": [
        "$bucket = $install.bucket",
        ". \"$bucketsdir\\$bucket\\bin\\utils.ps1\"",
        "Require-Admin",
        "Stop-App -ProcessNames @('GameViewer', 'GameViewerService')",
        "Stop-Service -Name 'GameViewerService' -Force -ErrorAction SilentlyContinue"
    ],
    "post_uninstall": [
        "$bucket = $install.bucket",
        ". \"$bucketsdir\\$bucket\\bin\\utils.ps1\"",
        ". \"$bucketsdir\\$bucket\\scripts\\uuyc\\uninstall.ps1\""
    ],
    "bin": "GameViewer\\GameViewer.exe",
    "shortcuts": [
        [
            "GameViewer\\GameViewer.exe",
            "UU远程"
        ]
    ],
    "checkver": {
        "script": [
            "$url = 'https://api.nrd.nie.163.com/api/v1/release/dl/1?channel=gwqd'",
            "$request = [System.Net.HttpWebRequest]::Create($url)",
            "$request.AllowAutoRedirect = $false",
            "$response = $request.GetResponse()",
            "$location = $response.Headers['Location']",
            "$response.Close()",
            "return $location"
        ],
        "regex": "(?<url>https://a56\\.gdl\\.netease\\.com/UURemote_Setup_(?<version>[\\d.]+)_[^?]+\\.exe\\?.*)"
    },
    "autoupdate": {
        "url": "$matchUrl",
        "hash": {
            "mode": "download"
        }
    },
    "notes": "User data is persisted in \"$persist_dir\"."
}
