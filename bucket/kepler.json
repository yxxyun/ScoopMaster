            "hash": "sha512:6d543c2bdc926542c319e6a413de6b13bd0569142fc5e21266948b0f61edd6368a951f9ab48606655d3703d21cc195fdb6a098ec2f2eb1dc724aab15af256b65",
            "pre_install": [
                "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-64.7z\" \"$dir\"",
                "Remove-Item \"$dir\\`$*\", \"$dir\\*.nsi\" -Recurse"
            ]
        },
        "arm64": {
            "url": "https://kepler.gitkraken.com/production/0.25.0/kepler-arm64-setup.exe#/dl.7z",
            "hash": "sha512:d68585b6e71884a1ff19c9c1cfdca6e98b2561fd6e0edaa3a38bcc2841cdeaaa5b800975e6ccc5a610241325fee7d8920dcaa24dd6b66d41b365d875671fbcf9",
            "pre_install": [
                "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-arm64.7z\" \"$dir\"",
                "Remove-Item \"$dir\\`$*\", \"$dir\\*.nsi\" -Recurse"
            ]
        }
    },
    "shortcuts": [
        [
            "Kepler.exe",
            "Kepler"
        ]
    ],
    "checkver": {
        "url": "https://kepler.gitkraken.com/production/latest-windows.yml",
        "regex": "version:\\s*([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://kepler.gitkraken.com/production/$version/kepler-x64-setup.exe#/dl.7z"
            },
            "arm64": {
                "url": "https://kepler.gitkraken.com/production/$version/kepler-arm64-setup.exe#/dl.7z"
            }
        },
        "hash": {
            "url": "https://kepler.gitkraken.com/production/latest-windows.yml",
            "regex": "(?s)$basename.*?$base64"
        }
    }
}
