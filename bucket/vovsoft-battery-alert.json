{
    "version": "1.3",
    "description": "Portable edition of Vovsoft Battery Alert.",
    "homepage": "https://vovsoft.com/software/battery-alert/",
    "license": "Proprietary",
    "url": "https://vovsoft.com/files/battery-alert-portable.zip?v=1.3",
    "checkver": {
        "url": "https://vovsoft.com/download/battery-alert-portable/",
        "regex": "(?is)Version\\s*(?:<[^>]*>\\s*)*:?\\s*(?:<[^>]*>\\s*)*(?<version>\\d+(?:\\.\\d+)+)"
    },
    "autoupdate": {
        "url": "https://vovsoft.com/files/battery-alert-portable.zip?v=$version"
    },
    "shortcuts": [
        [
            "battery.exe",
            "Vovsoft Battery Alert"
        ]
    ],
    "pre_install": "if (-not (Test-Path -LiteralPath \"$dir\\key.txt\" -PathType Leaf)) { New-Item -ItemType File -Path \"$dir\\key.txt\" | Out-Null }",
    "persist": "key.txt"
}
