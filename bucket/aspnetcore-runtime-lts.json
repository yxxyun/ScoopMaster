    },
    "pre_install": [
        "if (!(is_admin)) { \"$app requires admin rights to $cmd\"; break }",
        "Start-Process \"$dir\\$fname\" -ArgumentList @('/install', '/quiet', '/norestart') -Wait -Verb RunAs"
    ],
    "post_install": "Remove-Item \"$dir\\$fname\"",
    "checkver": {
        "url": "https://builds.dotnet.microsoft.com/dotnet/aspnetcore/Runtime/LTS/latest.version",
        "regex": "([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://builds.dotnet.microsoft.com/dotnet/aspnetcore/Runtime/$version/aspnetcore-runtime-$version-win-x64.exe"
            },
            "32bit": {
                "url": "https://builds.dotnet.microsoft.com/dotnet/aspnetcore/Runtime/$version/aspnetcore-runtime-$version-win-x86.exe"
            },
            "arm64": {
                "url": "https://builds.dotnet.microsoft.com/dotnet/aspnetcore/Runtime/$version/aspnetcore-runtime-$version-win-arm64.exe"
            }
        }
    }
