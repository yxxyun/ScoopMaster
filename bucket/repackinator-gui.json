        }
    },
    "pre_install": [
        "if (!(Test-Path \"$persist_dir\\config.json\")) { Set-Content \"$dir\\config.json\" (@('{', '}') -join \"`r`n\") -Encoding Unicode | Out-Null }",
        "if (!(Test-Path \"$persist_dir\\settings.ini\")) { New-Item \"$dir\\settings.ini\" | Out-Null }"
    ],
    "persist": [
        "config.json",
        "settings.ini"
    ],
    "shortcuts": [
        [
            "repackinator.ui.exe",
            "Repackinator"
        ]
    ],
