{
    "version": "0.13.2",
    "description": "Spotify, native and fast",
    "homepage": "https://spotifast.rocks/",
    "license": {
        "identifier": "MIT",
        "url": "https://github.com/crmne/spotifast/blob/main/LICENSE"
    },
    "url": "https://github.com/crmne/spotifast/releases/download/v0.13.2/spotifast-v0.13.2-x86_64-pc-windows-msvc.zip",
    "hash": "6363bfb89f5b9f43a93fe9f65c8ddfaddcfd6c4f71cd3cc067531d3841e9b60a",
    "extract_dir": "spotifast-v0.13.2-x86_64-pc-windows-msvc",
    "post_install": [
        "# Spotifast stores its data under AppData (Local: data/cache, Roaming: config).",
        "# Move any existing data into the persist dir and redirect the app via junctions.",
        "$localParent = \"$env:LOCALAPPDATA\\paolino\"",
        "$roamingParent = \"$env:APPDATA\\paolino\"",
        "$localAppData = \"$localParent\\spotifast\"",
        "$roamingAppData = \"$roamingParent\\spotifast\"",
        "",
        "function Merge-Into-Persist($source, $name) {",
        "    $dest = \"$persist_dir\\$name\"",
        "    if (!(Test-Path $dest)) {",
        "        New-Item -ItemType Directory -Path $persist_dir -Force | Out-Null",
        "        Move-Item -Path $source -Destination $dest -Force",
        "    } else {",
        "        Copy-Item -Path \"$source\\*\" -Destination $dest -Force -Recurse",
        "        Remove-Item -Path $source -Force -Recurse",
        "    }",
        "}",
        "",
        "if (Test-Path $localAppData) {",
        "    Get-ChildItem -Path $localAppData -Force | ForEach-Object {",
        "        if ($_.Name -eq 'data' -or $_.Name -eq 'cache') {",
        "            Merge-Into-Persist $_ $_.Name",
        "        }",
        "    }",
        "}",
        "",
        "if (Test-Path $roamingAppData) {",
        "    Get-ChildItem -Path $roamingAppData -Force | ForEach-Object {",
        "        if ($_.Name -eq 'config') {",
        "            Merge-Into-Persist $_ $_.Name",
        "        }",
        "    }",
        "}",
        "",
        "if (!(Test-Path $localParent)) { New-Item -ItemType Directory -Path $localParent -Force | Out-Null }",
        "if (!(Test-Path $roamingParent)) { New-Item -ItemType Directory -Path $roamingParent -Force | Out-Null }",
        "if (!(Test-Path $localAppData)) { New-Item -ItemType Junction -Path $localAppData -Target $persist_dir | Out-Null }",
        "if (!(Test-Path $roamingAppData)) { New-Item -ItemType Junction -Path $roamingAppData -Target $persist_dir | Out-Null }"
    ],
    "uninstaller": {
        "script": "Remove-Item $env:LOCALAPPDATA\\paolino\\spotifast, $env:APPDATA\\paolino\\spotifast -Force -Recurse -ErrorAction Ignore"
    },
    "bin": "spotifast.exe",
    "shortcuts": [
        [
            "spotifast.exe",
            "Spotifast"
        ]
    ],
    "persist": [
        "data",
        "cache",
        "config"
    ],
    "checkver": {
        "url": "https://api.github.com/repos/crmne/spotifast/releases",
        "jsonpath": "$[0].tag_name",
        "regex": "v?([\\d.]+)"
    },
    "autoupdate": {
        "url": "https://github.com/crmne/spotifast/releases/download/v$version/spotifast-v$version-x86_64-pc-windows-msvc.zip",
        "extract_dir": "spotifast-v$version-x86_64-pc-windows-msvc"
    }
}
