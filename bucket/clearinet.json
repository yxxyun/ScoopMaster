{
    "version": "0.0.2.6",
    "description": "A locally-running web debugging proxy for visualizing, generating, and modifying HTTP(S) traffic; a spiritual successor to Fiddler Classic.",
    "homepage": "https://clearinet.app",
    "license": "MIT",
    "url": "https://github.com/ericlaw1979/Clearinet/releases/download/0.0.2.6/ClearinetSetup.exe#/dl.7z",
    "hash": "16d4850f295b6f449554937ec5ecf5e3ece42dd8141b4a026588c6dcd7ac7cf8",
    "pre_install": "Remove-Item \"$dir\\`$PLUGINSDIR\", \"$dir\\uninst.exe.nsis\" -Recurse -Force -ErrorAction SilentlyContinue",
    "post_install": [
        "$exe = (\"$(Split-Path $dir)\\current\\Clearinet.exe\").Replace('\\', '\\\\')",
        "$ico = $exe -replace 'Clearinet\\.exe$', 'SAZFile.ico'",
        "@\"",
        "Windows Registry Editor Version 5.00",
        "",
        "[HKEY_CURRENT_USER\\Software\\Classes\\.saz]",
        "@=\"Clearinet.ArchiveZip\"",
        "",
        "[HKEY_CURRENT_USER\\Software\\Classes\\Clearinet.ArchiveZip]",
        "@=\"Clearinet Session Archive\"",
        "\"Content Type\"=\"application/x-zip-compressed+SessionArchive\"",
        "",
        "[HKEY_CURRENT_USER\\Software\\Classes\\Clearinet.ArchiveZip\\DefaultIcon]",
        "@=\"$ico\"",
        "",
        "[HKEY_CURRENT_USER\\Software\\Classes\\Clearinet.ArchiveZip\\Shell\\Open\\command]",
        "@=\"\\\"$exe\\\" -noattach \\\"%1\\\"\"",
        "",
        "[HKEY_CURRENT_USER\\Software\\Classes\\Clearinet.ArchiveZip\\Shell\\Open V&iewer Mode\\command]",
        "@=\"\\\"$exe\\\" -viewer \\\"%1\\\"\"",
        "",
        "[HKEY_CURRENT_USER\\Software\\Classes\\Clearinet.HARFile]",
        "@=\"HTTP Archive File\"",
        "\"FriendlyTypeName\"=\"HTTP Archive File\"",
        "",
        "[HKEY_CURRENT_USER\\Software\\Classes\\Clearinet.HARFile\\DefaultIcon]",
        "@=\"$exe,0\"",
        "",
        "[HKEY_CURRENT_USER\\Software\\Classes\\Clearinet.HARFile\\shell\\open\\command]",
        "@=\"\\\"$exe\\\" \\\"%1\\\"\"",
        "",
        "[HKEY_CURRENT_USER\\Software\\Classes\\.har\\OpenWithProgids]",
        "\"Clearinet.HARFile\"=\"\"",
        "",
        "[HKEY_CURRENT_USER\\Software\\Classes\\Applications\\Clearinet.exe\\SupportedTypes]",
        "\".har\"=\"\"",
        "\".saz\"=\"\"",
        "",
        "[HKEY_CURRENT_USER\\Software\\Classes\\Applications\\Clearinet.exe\\shell\\open\\command]",
        "@=\"\\\"$exe\\\" \\\"%1\\\"\"",
        "\"@ | Set-Content \"$dir\\clearinet-install-associations.reg\" -Encoding Unicode",
        "@\"",
        "Windows Registry Editor Version 5.00",
        "",
        "[-HKEY_CURRENT_USER\\Software\\Classes\\.saz]",
        "",
        "[-HKEY_CURRENT_USER\\Software\\Classes\\Clearinet.ArchiveZip]",
        "",
        "[-HKEY_CURRENT_USER\\Software\\Classes\\Clearinet.HARFile]",
        "",
        "[-HKEY_CURRENT_USER\\Software\\Classes\\Applications\\Clearinet.exe]",
        "",
        "[HKEY_CURRENT_USER\\Software\\Classes\\.har\\OpenWithProgids]",
        "\"Clearinet.HARFile\"=-",
        "\"@ | Set-Content \"$dir\\clearinet-uninstall-associations.reg\" -Encoding Unicode",
        "if (is_admin) {",
        "    & \"$env:WINDIR\\Microsoft.NET\\Framework64\\v4.0.30319\\ngen.exe\" install \"$dir\\Clearinet.exe\" /queue | Out-Null",
        "} else {",
        "    warn 'Not running as administrator; skipping NGEN of Clearinet.exe (optional startup optimization).'",
        "}"
    ],
    "pre_uninstall": [
        "if (is_admin) {",
        "    & \"$env:WINDIR\\Microsoft.NET\\Framework64\\v4.0.30319\\ngen.exe\" uninstall \"$dir\\Clearinet.exe\" | Out-Null",
        "}"
    ],
    "notes": [
        "To associate .saz and .har files with Clearinet (optional), run:",
        "reg import \"$dir\\clearinet-install-associations.reg\"",
        "To remove the associations again, run:",
        "reg import \"$dir\\clearinet-uninstall-associations.reg\""
    ],
    "bin": "Clearinet.exe",
    "shortcuts": [
        [
            "Clearinet.exe",
            "Clearinet"
        ]
    ],
    "checkver": {
        "github": "https://github.com/ericlaw1979/Clearinet"
    },
    "autoupdate": {
        "url": "https://github.com/ericlaw1979/Clearinet/releases/download/$version/ClearinetSetup.exe#/dl.7z"
    }
}
