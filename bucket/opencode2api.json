{
    "version": "1.3.7",
    "description": "Go gateway for OpenCode Zen with OpenAI and Anthropic API compatibility, key and proxy pooling, automatic routing and a built-in WebUI",
    "homepage": "https://github.com/jasonxu114514/opencode2api",
    "license": "GPL-3.0",
    "architecture": {
        "64bit": {
            "url": "https://github.com/jasonxu114514/opencode2api/releases/download/v1.3.7/opencode2api_v1.3.7_windows_amd64.zip",
            "hash": "611b872057ba9aed1bb1376cd3d5e4ee3ace68076fd273c057a75a6d089d5b2e"
        },
        "arm64": {
            "url": "https://github.com/jasonxu114514/opencode2api/releases/download/v1.3.7/opencode2api_v1.3.7_windows_arm64.zip",
            "hash": "4538bb9203b54b46115810a22e1ff0072b5d553a0d0fe23c67af1f4023a8d65c"
        }
    },
    "bin": [
        [
            "opencode2api.exe",
            "opencode2api",
            "-config \"$persist_dir\\config.json\""
        ]
    ],
    "installer": {
        "script": [
            "$src = Get-ChildItem -LiteralPath $dir -Directory | Select-Object -First 1",
            "Get-ChildItem -LiteralPath $src.FullName -Force | Move-Item -Destination $dir -Force",
            "Remove-Item -LiteralPath $src.FullName -Recurse -Force",
            "if (-not (Test-Path \"$persist_dir\\config.json\")) { Copy-Item \"$dir\\config.example.json\" \"$dir\\config.json\" }"
        ]
    },
    "persist": "config.json",
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/jasonxu114514/opencode2api/releases/download/v$version/opencode2api_v$version_windows_amd64.zip",
                "hash": "611b872057ba9aed1bb1376cd3d5e4ee3ace68076fd273c057a75a6d089d5b2e"
            },
            "arm64": {
                "url": "https://github.com/jasonxu114514/opencode2api/releases/download/v$version/opencode2api_v$version_windows_arm64.zip",
                "hash": "4538bb9203b54b46115810a22e1ff0072b5d553a0d0fe23c67af1f4023a8d65c"
            }
        }
    },
    "notes": [
        "Run 'opencode2api' to start the gateway. It reads ~/scoop/persist/opencode2api/config.json, which is created from the bundled config.example.json on first install.",
        "The example config listens for the API on 127.0.0.1:8080 and for the WebUI on 0.0.0.0:8081. Replace server_keys and webui.password before exposing it to a network."
    ]
}
