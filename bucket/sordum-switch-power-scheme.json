            "shortcuts": [
                [
                    "sPowers.exe",
                    "Sordum - Switch Power Scheme"
                ]
            ]
        }
    },
    "checkver": {
        "url": "https://www.sordum.org/12818/switch-power-scheme-v1-3/",
