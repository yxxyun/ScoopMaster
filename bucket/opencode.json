{
    "version": "2.2.4",
    "description": "The open source AI coding agent. V2",
    "homepage": "https://opencode.ai/",
    "license": {
        "identifier": "MIT",
        "url": "https://github.com/anomalyco/opencode/blob/dev/LICENSE"
    },
    "url": "https://registry.npmjs.org/@opencode/cli-windows-x64/-/cli-windows-x64-2.2.4.tgz",
    "hash": "sha512:57022520e4328c0048cd7e093b86d7df13b1683ffe1721c8cb3831e986878220007388449ccb197b38980704dd6de081e11f335776a0e7032ba4bb47da8d8aa6",
    "extract_dir": "package\\bin",
    "pre_install": [
        "# Please keep the folder list the same in both pre_install and uninstaller scripts.",
        "$folders = @{",
        "    'config' = if ($env:XDG_CONFIG_HOME) { $env:XDG_CONFIG_HOME } else { \"$env:USERPROFILE\\.config\" }",
        "    'cache' = if ($env:XDG_CACHE_HOME) { $env:XDG_CACHE_HOME } else { \"$env:USERPROFILE\\.cache\" }",
        "    'data' = if ($env:XDG_DATA_HOME) { $env:XDG_DATA_HOME } else { \"$env:USERPROFILE\\.local\\share\" }",
        "    'state' = if ($env:XDG_STATE_HOME) { $env:XDG_STATE_HOME } else { \"$env:USERPROFILE\\.local\\state\" }",
        "}",
        "foreach ($name in $folders.Keys) {",
        "    $link = \"$($folders[$name])\\opencode\"",
        "    $target = \"$persist_dir\\$name\"",
        "    $item = Get-Item -Path $link -Force -ErrorAction Ignore",
        "    if ($item -and ($item.Attributes -band [IO.FileAttributes]::ReparsePoint)) {",
        "        [IO.Directory]::Delete($link)",
        "    } elseif ($item) {",
        "        if (!(Test-Path \"$target\")) {",
        "            Write-Host \"Migrating '$link' to persist directory...\" -ForegroundColor Yellow",
        "            New-Item \"$persist_dir\" -ItemType Directory -Force | Out-Null",
        "            Copy-Item -Path $link -Destination $target -Recurse -Force",
        "            Remove-Item -Path $link -Recurse -Force",
        "        } else {",
        "            $backup = \"opencode.bak-$(Get-Date -Format 'yyyyMMddHHmmss')\"",
        "            Write-Host \"Persist data already exists, '$link' renamed to '$backup'.\" -ForegroundColor Yellow",
        "            Rename-Item -Path $link -NewName $backup",
        "        }",
        "    }",
        "    if (!(Test-Path \"$target\")) { New-Item \"$target\" -ItemType Directory -Force | Out-Null }",
        "    if (!(Test-Path \"$($folders[$name])\")) { New-Item \"$($folders[$name])\" -ItemType Directory -Force | Out-Null }",
        "    New-Item -Path $link -ItemType Junction -Value $target | Out-Null",
        "}"
    ],
    "bin": "opencode.exe",
    "persist": [
        "config",
        "cache",
        "data",
        "state"
    ],
    "uninstaller": {
        "script": [
            "if ($cmd -eq 'uninstall') {",
            "    # Please keep the folder list the same in both pre_install and uninstaller scripts.",
            "    $folders = @{",
            "        'config' = if ($env:XDG_CONFIG_HOME) { $env:XDG_CONFIG_HOME } else { \"$env:USERPROFILE\\.config\" }",
            "        'cache' = if ($env:XDG_CACHE_HOME) { $env:XDG_CACHE_HOME } else { \"$env:USERPROFILE\\.cache\" }",
            "        'data' = if ($env:XDG_DATA_HOME) { $env:XDG_DATA_HOME } else { \"$env:USERPROFILE\\.local\\share\" }",
            "        'state' = if ($env:XDG_STATE_HOME) { $env:XDG_STATE_HOME } else { \"$env:USERPROFILE\\.local\\state\" }",
            "    }",
            "    foreach ($name in $folders.Keys) {",
            "        $link = \"$($folders[$name])\\opencode\"",
            "        $item = Get-Item -Path $link -Force -ErrorAction Ignore",
            "        if ($item -and ($item.Attributes -band [IO.FileAttributes]::ReparsePoint)) { [IO.Directory]::Delete($link) }",
            "    }",
            "}"
        ]
    },
    "checkver": {
        "url": "https://registry.npmjs.org/@opencode/cli/latest",
        "jsonpath": "$.version"
    },
    "autoupdate": {
        "url": "https://registry.npmjs.org/@opencode/cli-windows-x64/-/cli-windows-x64-$version.tgz",
        "hash": {
            "url": "https://registry.npmjs.org/@opencode/cli-windows-x64/$version",
            "regex": "sha512-$base64"
        }
    }
}
