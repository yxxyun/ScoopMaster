{
    "version": "1.18.10",
    "description": "The open source AI coding agent.",
    "homepage": "https://opencode.ai/",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/anomalyco/opencode/releases/download/v1.18.10/opencode-windows-x64.zip",
            "hash": "b1d85ce5211bfefbc2b4940a19e1639fc75cb87ff82eb79806ffb84b01dd1482"
        },
        "arm64": {
            "url": "https://github.com/anomalyco/opencode/releases/download/v1.18.10/opencode-windows-arm64.zip",
            "hash": "0ef987b43df4ff427f55b805f6d44231313ef098296fa154d2043837656e092f"
        }
    },
    "bin": "opencode.exe",
    "pre_install": [
        "# 将 ~/.config/opencode 软链接到 persist/config，升级时数据不丢失",
        "$opencode_dir = Join-Path $env:USERPROFILE \".config\\opencode\"",
        "$persist_config = Join-Path $persist_dir \"config\"",
        "& \"$bucketsdir\\\\code\\\\scripts\\\\link.ps1\" $opencode_dir $persist_config"
    ],
    "post_uninstall": [
        "$opencode_dir = Join-Path $env:USERPROFILE \".config\\opencode\"",
        "& \"$bucketsdir\\\\code\\\\scripts\\\\unlink.ps1\" $opencode_dir"
    ],
    "persist": "config",
    "checkver": {
        "github": "https://github.com/anomalyco/opencode"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/anomalyco/opencode/releases/download/v$version/opencode-windows-x64.zip"
            },
            "arm64": {
                "url": "https://github.com/anomalyco/opencode/releases/download/v$version/opencode-windows-arm64.zip"
            }
        }
    }
}
