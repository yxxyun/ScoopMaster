{
    "version": "0.33.0-rzyns.2",
    "description": "Desktop interface for Beads issue tracking, with Windows compatibility fixes from the rzyns fork.",
    "homepage": "https://github.com/rzyns/beadbox",
    "license": "MIT",
    "notes": [
        "Requires the Beads CLI (bd) 1.1.0 or newer on PATH: https://github.com/gastownhall/beads/releases",
        "Requires Microsoft Edge WebView2 Runtime. Install extras/webview2 if it is not already available.",
        "Updates are managed by Scoop; the upstream in-app updater is disabled. App settings and project databases remain outside the installation directory."
    ],
    "suggest": {
        "Microsoft Edge WebView2 Runtime": "extras/webview2"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/rzyns/beadbox/releases/download/scoop-v0.33.0-rzyns.2/beadbox_0.33.0-rzyns.2_windows_x64.zip",
            "hash": "25d2f804343634aad8eed3e967a7061574fe9d55d3dea7154e1f80d82aa9023a"
        }
    },
    "shortcuts": [
        [
            "beadbox.exe",
            "Beadbox"
        ]
    ],
    "checkver": {
        "url": "https://api.github.com/repos/rzyns/beadbox/releases/latest",
        "jsonpath": "$.tag_name",
        "regex": "^scoop-v([\\d.]+-rzyns\\.\\d+)$"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/rzyns/beadbox/releases/download/scoop-v$version/beadbox_$version_windows_x64.zip",
                "hash": {
                    "url": "$url.sha256"
                }
            }
        }
    }
}
