{
    "version": "0.26.18",
    "description": "Windows desktop client for managing multiple aTrust access points with local proxy and system proxy integration.",
    "homepage": "https://github.com/weigram/aTrustHub",
    "license": "AGPL-3.0",
    "architecture": {
        "64bit": {
            "url": "https://github.com/weigram/aTrustHub/releases/download/v0.26.18/atrusthub-setup-0.26.18-amd64.exe",
            "hash": "4f17ae46d107178e3d4f193e32ca3ee68e95d6371fb2ffaf8aabd3a9645b4966"
        }
    },
    "installer": {
        "args": [
            "/S",
            "/D=$dir"
        ]
    },
    "uninstaller": {
        "script": [
            "$uninstaller = Get-ChildItem -LiteralPath $dir -File -Recurse -ErrorAction SilentlyContinue | Where-Object { $_.Name -match '(?i)^(unins\\d*|uninstall.*)\\.exe$' } | Select-Object -First 1",
            "if (-not $uninstaller) { throw 'The application uninstaller was not found in the Scoop version directory.' }",
            "$process = Start-Process -FilePath $uninstaller.FullName -ArgumentList '/S' -WorkingDirectory $uninstaller.DirectoryName -Wait -PassThru",
            "if ($process.ExitCode -ne 0) { throw ('The application uninstaller exited with code {0}.' -f $process.ExitCode) }"
        ]
    },
    "bin": "aTrustHub.exe",
    "shortcuts": [
        [
            "aTrustHub.exe",
            "aTrustHub"
        ]
    ],
    "checkver": {
        "github": "https://github.com/weigram/aTrustHub"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/weigram/aTrustHub/releases/download/v$version/atrusthub-setup-$version-amd64.exe",
                "hash": {
                    "mode": "json",
                    "url": "https://api.github.com/repos/weigram/aTrustHub/releases/tags/v$version",
                    "jp": "$.assets[?(@.name == 'atrusthub-setup-$version-amd64.exe')].digest"
                }
            }
        }
    }
}
