{
    "version": "0.14.4b1-plus.2",
    "description": "ActivityWatch 个人增强版 — 自动时间追踪，在官方桌面版基础上为 aw-qt 增加 WebDAV 自动备份",
    "homepage": "https://github.com/guyu-guyu/activitywatch-plus",
    "license": "MPL-2.0",
    "notes": [
        "个人 fork：可与 aw-android-plus 共用同一个 WebDAV 备份目录",
        "与官方版 ActivityWatch 共用数据目录和端口，同一时间只能运行一个；若已安装官方版，建议先 scoop uninstall activitywatch 再安装",
        "开机启动：New-ItemProperty -Path HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Run -Name ActivityWatchPlus -PropertyType String -Value \"$dir\\aw-qt.exe\"",
        "构建未签名，首次运行可能触发 SmartScreen 提示"
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/guyu-guyu/activitywatch-plus/releases/download/v0.14.4b1-plus.2/activitywatch-v0.14.4b1-plus.2-windows-x86_64.zip",
            "hash": "ae895a7fad8d143e56003f3cfc57a0a3a1e02bc5d68468f47745f4da6be8ca40"
        }
    },
    "extract_dir": "activitywatch",
    "bin": "aw-qt.exe",
    "shortcuts": [
        [
            "aw-qt.exe",
            "ActivityWatch Plus"
        ]
    ],
    "pre_uninstall": [
        "if (Get-Service -Name 'aw-qt.exe' -ErrorAction 'SilentlyContinue') {",
        "    if (!(is_admin)) { error \"Admin rights required to remove ActivityWatch service\"; break }",
        "    Start-Process \"$dir\\aw-qt.exe\" -Wait -Verb 'RunAs' -ArgumentList 'uninstall' -WindowStyle 'Hidden'",
        "}"
    ],
    "checkver": {
        "github": "https://api.github.com/repos/guyu-guyu/activitywatch-plus/releases",
        "jsonpath": "$[0].tag_name",
        "regex": "v?([\\d.]+(?:b\\d+)?(?:-plus\\.\\d+)?)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/guyu-guyu/activitywatch-plus/releases/download/v$version/activitywatch-v$version-windows-x86_64.zip"
            }
        }
    }
}
