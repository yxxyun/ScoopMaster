{
    "version": "3.7.1143",
    "description": "Portable Windows privacy utility for reviewing and changing Windows 10 and 11 settings.",
    "homepage": "https://www.oo-software.com/en/shutup10",
    "license": "Freeware",
    "url": "https://dl5.oo-software.com/files/ooshutup10/OOSU10.exe",
    "hash": "EA2790422AA81D62F22AE93E995C205D4D7A6AC9825877CF34AD4E65A8253ECE",
    "shortcuts": [
        [
            "OOSU10.exe",
            "O&O ShutUp10++"
        ]
    ],
    "checkver": {
        "script": [
            "$ErrorActionPreference = 'Stop'",
            "$ProgressPreference = 'SilentlyContinue'",
            "$html = (Invoke-WebRequest -Uri 'https://www.oo-software.com/en/support/productreleases' -UseBasicParsing).Content",
            "$rows = [regex]::Matches($html, '(?is)<tr\\b[^>]*>.*?</tr>')",
            "$version = $null",
            "foreach ($row in $rows) {",
            "    $text = [System.Net.WebUtility]::HtmlDecode([regex]::Replace($row.Value, '<[^>]+>', ' '))",
            "    $text = [regex]::Replace($text, '\\s+', ' ').Trim()",
            "    if ($text -match '(?i)O&O ShutUp10 10 Premium Edition\\s+(?<version>\\d+(?:\\.\\d+){1,3})\\b') {",
            "        $version = $Matches['version']",
            "        break",
            "    }",
            "}",
            "if (-not $version) { throw 'Unable to detect the O&O ShutUp10++ version on the official O&O product releases page.' }",
            "$version"
        ],
        "regex": "(?<version>\\d+(?:\\.\\d+){1,3})"
    },
    "autoupdate": {
        "url": "https://dl5.oo-software.com/files/ooshutup10/OOSU10.exe"
    },
    "notes": "Review each privacy setting before applying it; disabling Windows features or services can affect system and application behavior."
}
