    "extract_dir": "Steamcommunity_302",
    "##": [
        "pac_user.txt",
        "S302.ini",
        "S302_rules.ini",
        "S302.log",
        "dns_blacklist.txt",
        "dns_hosts.txt",
        "steamcommunity.crt",
        "steamcommunity.csr",
        "steamcommunity.key",
        "steamcommunityCA.crl",
        "steamcommunityCA.key",
        "steamcommunityCA.pem"
    ],
    "post_install": [
        "New-Item $persist_dir -ItemType Directory -Force | Out-Null",
        "$manifest.'##' | ForEach-Object {",
        "    $src = Join-Path $persist_dir $_",
        "    if (Test-Path $src -PathType Leaf) {",
        "        Copy-Item $src $dir -Force",
        "    }",
        "}"
    ],
    "pre_uninstall": [
        "@('Steamcommunity_302', 'steamcommunity_302.cli', 'steamcommunity_302.caddy') | ForEach-Object {",
        "    if (Get-Process -Name $_ -ErrorAction SilentlyContinue) {",
        "        throw '请先关闭服务和UI再进行卸载.'",
        "    }",
        "}",
        "New-Item $persist_dir -ItemType Directory -Force | Out-Null",
        "$manifest.'##' | ForEach-Object {",
        "    $src = Join-Path $dir $_",
        "    if (Test-Path $src -PathType Leaf) {",
        "        Copy-Item $src $persist_dir -Force",
        "    }",
        "}"
    ],
    "shortcuts": [["steamcommunity_302.exe", "SteamCommunity 302"]],
    "checkver": {
        "url": "https://www.dogfight360.com/blog/18682",
        "regex": "uploads/(?<date>[\\d/]+)/steamcommunity_302_AMD64_V([\\d.]+)\\.zip"
    },
    "autoupdate": {
        "url": "https://www.dogfight360.com/blog/wp-content/uploads/$matchDate/steamcommunity_302_AMD64_V$version.zip"
    }
