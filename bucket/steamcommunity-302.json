    "pre_install": [
        "$programDataDir = \"$env:ProgramData\\Steamcommunity_302\"",
        "New-Item -Path $persist_dir -ItemType Directory -Force -ErrorAction Stop | Out-Null",
        "$existingItem = Get-Item -LiteralPath $programDataDir -Force -ErrorAction SilentlyContinue",
        "if ($existingItem) {",
        "    if ($existingItem.LinkType -eq 'Junction' -and $existingItem.Target -eq $persist_dir) {",
