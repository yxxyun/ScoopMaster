    "uninstaller": {
        "script": [
            "if ($cmd -eq 'uninstall' -and $purge) {",
            "    if (!(is_admin)) {",
            "        throw 'Purging Steamcommunity 302 requires administrator rights. Run this command from an elevated PowerShell session.'",
            "    }",
            "    if (Get-Process -Name 'Steamcommunity_302', 'steamcommunity_302.cli' -ErrorAction SilentlyContinue) {",
            "        throw 'Stop the Steamcommunity 302 service and exit the application before purging.'",
            "    }",
            "    $appDataDir = \"$env:APPDATA\\Steamcommunity_302.exe\"",
            "    info \"Removing Steamcommunity 302 WebView2 data at '$appDataDir'...\"",
            "    Remove-Item -LiteralPath $appDataDir -Recurse -Force -ErrorAction SilentlyContinue",
            "    $tasks = Get-ScheduledTask -ErrorAction Stop | Where-Object { $_.TaskPath -eq '\\' -and $_.TaskName -in @('Steamcommunity302 V15 UI', 'Steamcommunity302 V15') }",
            "    foreach ($task in $tasks) {",
            "        info \"Removing Steamcommunity 302 startup task '$($task.TaskName)'...\"",
            "        Unregister-ScheduledTask -TaskPath '\\' -TaskName $task.TaskName -Confirm:$false -ErrorAction Stop",
            "    }",
            "    $machineCertificates = Get-ChildItem -LiteralPath Cert:\\LocalMachine\\Root -ErrorAction Stop | Where-Object Subject -match '^CN=Steamcommunity302 - \\d{4} ECC Root$'",
            "    foreach ($certificate in $machineCertificates) {",
            "        $certPath = \"Cert:\\LocalMachine\\Root\\$($certificate.Thumbprint)\"",
            "        info \"Removing Steamcommunity 302 root certificate at '$certPath'...\"",
            "        Remove-Item -LiteralPath $certPath -Force -ErrorAction Stop",
            "    }",
            "    $programDataDir = \"$env:ProgramData\\Steamcommunity_302\"",
            "    if (Test-Path -LiteralPath $programDataDir) {",
            "        info \"Removing Steamcommunity 302 data at '$programDataDir'...\"",
            "        Remove-Item -LiteralPath $programDataDir -Recurse -Force -ErrorAction Stop",
            "    }",
            "}"
        ]
    },
