        "    }",
        "    info \"Moving Steamcommunity 302 data from '$programDataDir' to '$persist_dir'...\"",
        "    Get-ChildItem -LiteralPath $programDataDir -Force -ErrorAction Stop | Move-Item -Destination $persist_dir -ErrorAction Stop",
        "    [IO.Directory]::Delete($programDataDir)",
        "}",
        "info \"Creating Steamcommunity 302 data junction from '$programDataDir' to '$persist_dir'...\"",
        "New-Item -Path $programDataDir -ItemType Junction -Target $persist_dir -ErrorAction Stop | Out-Null"
    ],
    "uninstaller": {
        "script": [
            "if ($cmd -eq 'uninstall') {",
            "    $programDataDir = \"$env:ProgramData\\Steamcommunity_302\"",
            "    $existingItem = Get-Item -LiteralPath $programDataDir -Force -ErrorAction SilentlyContinue",
            "    if ($existingItem -and $existingItem.LinkType -eq 'Junction' -and $existingItem.Target -eq $persist_dir) {",
