{
    "version": "2.3.0",
    "description": "跨品牌电竞外设电量管理与硬件调度引擎, 支持雷蛇、罗技、雷柏、NuPhy 及主流国产电竞外设",
    "homepage": "https://github.com/Ferris-echo/FerrisPulse",
    "license": "GPL-3.0-only",
    "notes": "安装和更新时会关闭程序内置的自动更新, 请用 scoop update ferris-pulse 升级。更新或卸载前请先退出程序。",
    "architecture": {
        "64bit": {
            "url": "https://github.com/Ferris-echo/FerrisPulse/releases/download/v2.3.0/FerrisPulse_v2.3.0_Portable.zip",
            "hash": "0db5c1654f2061a0a9878acf37a5eaa57423499a9e3fe99da9d772675eaacdfb"
        }
    },
    "post_install": [
        "Restore-AppRegistry -Map @{ 'config.reg' = 'HKCU\\Software\\FerrisPulse'; 'legacy.reg' = 'HKCU\\Software\\RazerBatteryTray'; 'aumid.reg' = 'HKCU\\Software\\Classes\\AppUserModelId\\FerrisPulse.App'; 'notifications.reg' = 'HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Notifications\\Settings\\FerrisPulse.App' }",
        "Restore-RegistryEntry -Map @{ 'run.json' = 'HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Run\\FerrisPulse' } -Path \"$dir\\FerrisPulse.exe\"",
        "if (!(Test-Path 'HKCU:\\Software\\FerrisPulse')) { New-Item 'HKCU:\\Software\\FerrisPulse' | Out-Null }",
        "New-ItemProperty 'HKCU:\\Software\\FerrisPulse' -Name 'AutoCheckUpdate' -Value 0 -PropertyType DWord -Force | Out-Null"
    ],
    "post_uninstall": [
        "$backup = ensure $persist_dir",
        "Save-AppRegistry -To $backup -Map @{ 'config.reg' = 'HKCU\\Software\\FerrisPulse'; 'legacy.reg' = 'HKCU\\Software\\RazerBatteryTray'; 'aumid.reg' = 'HKCU\\Software\\Classes\\AppUserModelId\\FerrisPulse.App'; 'notifications.reg' = 'HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Notifications\\Settings\\FerrisPulse.App' } -Delete",
        "Save-RegistryEntry -Map @{ 'run.json' = 'HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Run\\FerrisPulse' } -To $backup -Delete"
    ],
    "shortcuts": [
        [
            "FerrisPulse.exe",
            "FerrisPulse"
        ]
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/Ferris-echo/FerrisPulse/releases/download/v$version/FerrisPulse_v$version_Portable.zip"
            }
        }
    }
}
