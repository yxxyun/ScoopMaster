{
    "version": "1.2.2",
    "description": "Liferay Local Instance Manager - CLI tool for managing local side-by-side Liferay environments.",
    "homepage": "https://github.com/peterrichards-lr/lfr-local",
    "license": "MIT",
    "url": "https://github.com/peterrichards-lr/lfr-local/archive/refs/tags/v1.2.2.tar.gz",
    "hash": "4cd603bc7b293152e30378b69cb9280bf49ff0aad16a13f5338743e532e07680",
    "extract_dir": "lfr-local-1.2.2",
    "depends": "rustup",
    "installer": {
        "script": [
            "Set-Location \"$dir\"",
            "cargo install --path . --root \"$dir\""
        ]
    },
    "bin": "bin/lfr-local.exe",
    "checkver": "github",
    "autoupdate": {
        "url": "https://github.com/peterrichards-lr/lfr-local/archive/refs/tags/v$version.tar.gz",
        "extract_dir": "lfr-local-$version",
        "hash": {
            "url": "$url",
            "mode": "download"
        }
    }
}
