{
    "version": "1.0.0",
    "description": "Windows launcher with app search, calculator and system commands.",
    "homepage": "https://github.com/JoaoVitorOli/althea",
    "license": "GPL-3.0-or-later",
    "architecture": {
        "64bit": {
            "url": "https://github.com/JoaoVitorOli/althea/releases/download/v1.0.0/Althea-1.0.0-portable-amd64.zip",
            "hash": "337fd86f38031cbdef60e042db03b38cc115c7711627334651af533bbe10e82b",
            "extract_dir": "Althea"
        }
    },
    "pre_install": "Remove-Item -LiteralPath (Join-Path $dir 'althea.portable') -Force -ErrorAction SilentlyContinue",
    "bin": "Althea.exe",
    "shortcuts": [
        [
            "Althea.exe",
            "Althea"
        ]
    ],
    "checkver": {
        "github": "https://github.com/JoaoVitorOli/althea"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/JoaoVitorOli/althea/releases/download/v$version/Althea-$version-portable-amd64.zip",
                "extract_dir": "Althea",
                "hash": {
                    "mode": "json",
                    "url": "https://api.github.com/repos/JoaoVitorOli/althea/releases/tags/v$version",
                    "jp": "$.assets[?(@.name == 'Althea-$version-portable-amd64.zip')].digest"
                }
            }
        }
    },
    "notes": "Scoop removes the upstream althea.portable marker so settings remain under %APPDATA% across app upgrades."
}
