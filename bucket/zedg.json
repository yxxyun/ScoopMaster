{
  "version": "1.27.0",
  "description": "Zed Editor (Localized / 汉化版)",
  "homepage": "https://github.com/zhtshan/zed-globalization",
  "license": "GPL-3.0-only",
  "architecture": {
    "64bit": {
      "url": "https://github.com/zhtshan/zed-globalization/releases/download/v1.27.0/zedg-zh-cn-windows-x86_64-v1.27.0.zip",
      "hash": "4730393c4034bf142b5c2123124ee659afe850d127770c17d03103054ae185e0"
    },
    "arm64": {
      "url": "https://github.com/zhtshan/zed-globalization/releases/download/v1.27.0/zedg-zh-cn-windows-aarch64-v1.27.0.zip",
      "hash": "689e99a1e5eb67e408380fe0edb96094beda87980994f81d989ef6099a599841"
    }
  },
  "bin": [
    [
      "bin\\ZedG.exe",
      "zedg"
    ]
  ],
  "shortcuts": [
    [
      "ZedG.exe",
      "ZedG"
    ]
  ],
  "post_install": [
    "$desktop = [Environment]::GetFolderPath(\"Desktop\")",
    "$ws = New-Object -ComObject WScript.Shell",
    "$lnk = $ws.CreateShortcut(\"$desktop\\ZedG.lnk\")",
    "$lnk.TargetPath = \"$dir\\ZedG.exe\"",
    "$lnk.WorkingDirectory = \"$dir\"",
    "$lnk.Save()"
  ],
  "pre_uninstall": [
    "$desktop = [Environment]::GetFolderPath(\"Desktop\")",
    "Remove-Item \"$desktop\\ZedG.lnk\" -ErrorAction SilentlyContinue"
  ],
  "checkver": {
    "github": "https://github.com/zhtshan/zed-globalization"
  },
  "autoupdate": {
    "architecture": {
      "64bit": {
        "url": "https://github.com/zhtshan/zed-globalization/releases/download/v$version/zedg-zh-cn-windows-x86_64-v$version.zip",
        "hash": {
          "url": "https://github.com/zhtshan/zed-globalization/releases/download/v$version/sha256sums.txt",
          "regex": "([a-f0-9]{64})\\s+zedg-zh-cn-windows-x86_64-v\\$version\\.zip"
        }
      },
      "arm64": {
        "url": "https://github.com/zhtshan/zed-globalization/releases/download/v$version/zedg-zh-cn-windows-aarch64-v$version.zip",
        "hash": {
          "url": "https://github.com/zhtshan/zed-globalization/releases/download/v$version/sha256sums.txt",
          "regex": "([a-f0-9]{64})\\s+zedg-zh-cn-windows-aarch64-v\\$version\\.zip"
        }
      }
    }
  }
}
