{
    "##": "Upstream moved from x6nux/zed-globalization to the x6nux-oss org, and the old owner now 404s, so homepage, checkver and every URL use the new owner. autoupdate.hash.regex must keep $version unescaped: Scoop substitutes it with [Regex]::Escape(version), so a backslash written before it turns the version into a regex backreference that never matches and every update falls back to downloading the whole ~130 MB zip just to compute the hash.",
    "version": "1.28.1",
    "description": "Zed Editor (Localized / 汉化版)",
    "homepage": "https://github.com/x6nux-oss/zed-globalization",
    "license": "GPL-3.0-only",
    "architecture": {
        "64bit": {
            "url": "https://github.com/x6nux-oss/zed-globalization/releases/download/v1.28.1/zedg-zh-cn-windows-x86_64-v1.28.1.zip",
            "hash": "135f2150a39270ac7883f95aada2ab47ba18df234638b688320831705aa8bb75"
        },
        "arm64": {
            "url": "https://github.com/x6nux-oss/zed-globalization/releases/download/v1.28.1/zedg-zh-cn-windows-aarch64-v1.28.1.zip",
            "hash": "3e0fd632c9c66c21b386ca6814a99bc744bf0a4fe98bfe0026b90c73a37211dc"
        }
    },
    "pre_install": [
        ". \"$bucketsdir\\$bucket\\scripts\\utils.ps1\"",
        "New-PersistDirectory \"$env:APPDATA\\Zed\" \"$persist_dir\\AppData\" -Migrate",
        "New-PersistDirectory \"$env:LOCALAPPDATA\\Zed\" \"$persist_dir\\LocalAppData\" -Migrate",
        "if (!(Test-Path \"$persist_dir\\AppData\\settings.json\") -or !(Get-Item \"$persist_dir\\AppData\\settings.json\").Length) {",
        "    New-Item \"$persist_dir\\AppData\\settings.json\" -ItemType File -Force -ErrorAction SilentlyContinue | Out-Null",
        "    Set-Content -Path \"$persist_dir\\AppData\\settings.json\" -Value '{\"auto_update\":false,\"telemetry\":{\"diagnostics\":false,\"metrics\":false}}'",
        "}"
    ],
    "bin": [
        [
            "bin\\ZedG.exe",
            "zedg"
        ],
        [
            "bin\\ZedG.exe",
            "zed"
        ]
    ],
    "shortcuts": [
        [
            "ZedG.exe",
            "ZedG"
        ]
    ],
    "pre_uninstall": [
        "$bucket = $install.bucket",
        ". \"$bucketsdir\\$bucket\\scripts\\utils.ps1\"",
        "Remove-Junction \"$env:APPDATA\\Zed\"",
        "Remove-Junction \"$env:LOCALAPPDATA\\Zed\""
    ],
    "checkver": {
        "github": "https://github.com/x6nux-oss/zed-globalization"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/x6nux-oss/zed-globalization/releases/download/v$version/zedg-zh-cn-windows-x86_64-v$version.zip",
                "hash": {
                    "url": "https://github.com/x6nux-oss/zed-globalization/releases/download/v$version/sha256sums.txt",
                    "regex": "([a-f0-9]{64})\\s+zedg-zh-cn-windows-x86_64-v$version\\.zip"
                }
            },
            "arm64": {
                "url": "https://github.com/x6nux-oss/zed-globalization/releases/download/v$version/zedg-zh-cn-windows-aarch64-v$version.zip",
                "hash": {
                    "url": "https://github.com/x6nux-oss/zed-globalization/releases/download/v$version/sha256sums.txt",
                    "regex": "([a-f0-9]{64})\\s+zedg-zh-cn-windows-aarch64-v$version\\.zip"
                }
            }
        }
    }
}
