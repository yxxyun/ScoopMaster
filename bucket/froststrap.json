{
    "version": "2.0.0-beta.11",
    "description": "A fork of Fishstrap, focused on performance and customization.",
    "homepage": "https://froststrap.xyz",
    "license": "AGPL-3.0-or-later,MIT,Unlicense",
    "architecture": {
        "64bit": {
            "url": "https://github.com/Froststrap/Froststrap/releases/download/v2.0.0-beta.11/Froststrap-Setup.exe",
            "hash": "e56ee0d542e3987347e801682a1b91812d93256d162e4b87912776efd9814b57"
        }
    },
    "bin": "Froststrap.exe",
    "shortcuts": [
        [
            "Froststrap.exe",
            "Froststrap"
        ]
    ],
    "persist": [
        "CustomCursorsSets",
        "CustomThemes",
        "Downloads",
        "Integrations",
        "Modifications",
        "Versions",
        "Data.json",
        "Settings.json",
        "State.json"
    ],
    "pre_install": [
        "if (!(Test-Path \"$persist_dir\")) { New-Item \"$persist_dir\" -ItemType Directory | Out-Null }",
        "'Data.json', 'Settings.json', 'State.json' | ForEach-Object {",
        "    $item = \"$persist_dir\\$_\"",
        "    if (Test-Path $item -PathType Container) { Remove-Item $item -Force -Recurse }",
        "    if (!(Test-Path $item)) { Set-Content -Path $item -Value '{}' -Encoding Ascii }",
        "}"
    ],
    "installer": {
        "script": "Start-Process -FilePath \"$dir\\Froststrap-Setup.exe\" -ArgumentList \"/S /D=$dir\" -Wait"
    },
    "post_install": [
        "Remove-Item \"$dir\\Froststrap-Setup.exe\" -Force -ErrorAction SilentlyContinue",
        "Remove-Item \"$env:DESKTOP\\Froststrap.lnk\" -Force -ErrorAction SilentlyContinue",
        "Remove-Item \"$env:APPDATA\\Microsoft\\Windows\\Start Menu\\Programs\\Froststrap.lnk\" -Force -ErrorAction SilentlyContinue"
    ],
    "uninstaller": {
        "script": "if (Test-Path \"$dir\\uninstall.exe\") { Start-Process -FilePath \"$dir\\uninstall.exe\" -ArgumentList \"/S\" -Wait }"
    },
    "checkver": {
        "url": "https://api.github.com/repos/Froststrap/Froststrap/releases",
        "jsonpath": "$[0].tag_name",
        "regex": "v?([\\d.]+(?:-[\\w.]+)?)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/Froststrap/Froststrap/releases/download/v$version/Froststrap-Setup.exe"
            }
        }
    }
}
