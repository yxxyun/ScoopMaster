{
    "version": "2.0.5",
    "description": "A fork of Fishstrap, focused on performance and customization.",
    "homepage": "https://froststrap.xyz",
    "license": {
        "identifier": "MPL-2.0",
        "url": "https://github.com/Froststrap/Froststrap/blob/main/LICENSE"
    },
    "url": "https://github.com/Froststrap/Froststrap/releases/download/v2.0.5/Froststrap-windows-x64.msi",
    "hash": "b8140f062863d31a146b130fe49e2b3f30513287fb74149e8c190197e8d798c5",
    "extract_dir": "Froststrap",
    "bin": "Froststrap.exe",
    "shortcuts": [
        [
            "Froststrap.exe",
            "Froststrap"
        ]
    ],
    "post_install": [
        "$data = \"$env:LOCALAPPDATA\\Froststrap\"",
        "if (!(Test-Path $persist_dir)) { New-Item $persist_dir -ItemType Directory | Out-Null }",
        "$item = Get-Item $data -Force -ErrorAction SilentlyContinue",
        "if ($item -and ($item.Attributes -band [IO.FileAttributes]::ReparsePoint)) {",
        "    cmd /c rmdir \"$data\"",
        "} elseif ($item) {",
        "    Get-ChildItem $data -Force | ForEach-Object {",
        "        if (!(Test-Path \"$persist_dir\\$($_.Name)\")) { Move-Item $_.FullName $persist_dir }",
        "    }",
        "    Remove-Item $data -Recurse -Force",
        "}",
        "New-Item -ItemType Junction -Path $data -Target $persist_dir | Out-Null"
    ],
    "uninstaller": {
        "script": [
            "$data = \"$env:LOCALAPPDATA\\Froststrap\"",
            "$item = Get-Item $data -Force -ErrorAction SilentlyContinue",
            "if ($item -and ($item.Attributes -band [IO.FileAttributes]::ReparsePoint)) { cmd /c rmdir \"$data\" }"
        ]
    },
    "checkver": {
        "url": "https://api.github.com/repos/Froststrap/Froststrap/releases",
        "jsonpath": "$[0].tag_name",
        "regex": "v?([\\d.]+(?:-[\\w.]+)?)"
    },
    "autoupdate": {
        "url": "https://github.com/Froststrap/Froststrap/releases/download/v$version/Froststrap-windows-x64.msi"
    }
}
