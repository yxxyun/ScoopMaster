{
    "version": "0.1.0",
    "description": "Human-friendly Python package metadata viewer (uv tool install)",
    "homepage": "https://github.com/hasansezertasan/peta",
    "license": "MIT",
    "depends": "uv",
    "url": "https://raw.githubusercontent.com/hasansezertasan/scoop-bucket/main/scripts/noop.ps1",
    "hash": "fdcbbea851292d9aa67f598bc6f1ab96e58873385972cd3d209ccab239cbad87",
    "installer": {
        "script": "uv tool install peta==$version --force"
    },
    "uninstaller": {
        "script": "uv tool uninstall peta"
    },
    "checkver": {
        "url": "https://pypi.org/pypi/peta/json",
        "jsonpath": "$.info.version"
    },
    "autoupdate": {
        "url": "https://raw.githubusercontent.com/hasansezertasan/scoop-bucket/main/scripts/noop.ps1"
    }
}
