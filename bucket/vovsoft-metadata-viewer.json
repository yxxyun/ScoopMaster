{
    "version": "1.4",
    "description": "Portable edition of Vovsoft Metadata Viewer.",
    "homepage": "https://vovsoft.com/software/metadata-viewer/",
    "license": "Proprietary",
    "url": "https://vovsoft.com/files/metadata-viewer-portable.zip?v=1.4",
    "checkver": {
        "url": "https://vovsoft.com/download/metadata-viewer-portable/",
        "regex": "(?is)Version\\s*(?:<[^>]*>\\s*)*:?\\s*(?:<[^>]*>\\s*)*(?<version>\\d+(?:\\.\\d+)+)"
    },
    "autoupdate": {
        "url": "https://vovsoft.com/files/metadata-viewer-portable.zip?v=$version"
    },
    "shortcuts": [
        [
            "metadataviewer.exe",
            "Vovsoft Metadata Viewer"
        ]
    ],
    "notes": [
        "SHA-256 has not been verified; archive contents and the shortcut target have been checked."
    ],
    "pre_install": [
        "if (-not (Test-Path -LiteralPath \"$dir\\key.txt\" -PathType Leaf)) { New-Item -ItemType File -Path \"$dir\\key.txt\" | Out-Null }"
    ],
    "persist": "key.txt"
}
