    "hash": "33f5f679dfa296974e38fe55ada95010c21eca4ce9fed07a2fbe2c3390f3935f",
    "installer": {
        "script": [
            "$page = curl.exe -sL -k 'https://www.jrjr.com/mt5-down/'",
            "$match = [regex]::Match($page, 'href=\"(https?://[^\"]+\\.exe)\"')",
            "if (-not $match.Success) { throw 'No .exe link found on page' }",
            "$exeUrl = $match.Groups[1].Value",
            "$installerPath = \"$dir\\upwaymt5setup.exe\"",
            "curl.exe -L -k -o \"$installerPath\" $exeUrl",
            "if ($LASTEXITCODE -ne 0) { throw \"Download failed (exit=$LASTEXITCODE)\" }",
            "Start-Process -FilePath \"$installerPath\" -ArgumentList '/auto' -Wait"
        ]
    },
    "checkver": {
        "url": "https://cdn.rainte.com/scoop/scoop.md",
        "script": [
            "[string]$date = Get-Date -Format 'yyyy.MM.dd'",
            "Write-Output $date"
        ],
        "regex": "([\\d.]+)"
    },
    "autoupdate": {
        "url": "https://cdn.rainte.com/scoop/scoop.md"
    }
}
