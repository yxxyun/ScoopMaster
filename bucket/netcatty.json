{
    "version": "1.1.85",
    "description": "SSH workspace, SFTP, and terminals in one.",
    "homepage": "https://netcatty.app",
    "license": "GPL-3.0-only",
    "architecture": {
        "64bit": {
            "url": "https://github.com/binaricat/Netcatty/releases/download/v1.1.85/Netcatty-1.1.85-win-x64.exe",
            "hash": "de4c937af6e255ca42db6e17ec2ee24a64845a305789bc2b6588f7e0005ed005"
        }
    },
    "pre_install": [
        "Expand-7zipArchive $(Get-Item \"$dir\\Netcatty*.exe\").FullName -Destination \"$dir\" -Removal",
        "Get-Item \"$dir\\`$PLUGINSDIR\\app*.7z\" | Expand-7zipArchive -Destination \"$dir\"",
        "Remove-Item \"$dir\\`$*\", \"$dir\\Uninstall*\" -Recurse"
    ],
    "shortcuts": [
        [
            "Netcatty.exe",
            "Netcatty",
            "--user-data-dir=\"$persist_dir\\User Data\""
        ]
    ],
    "checkver": {
        "github": "https://github.com/binaricat/Netcatty"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/binaricat/Netcatty/releases/download/v$version/Netcatty-$version-win-x64.exe"
            }
        }
    }
}
