{
    "version": "0.5.0",
    "description": "Secure, local clipboard synchronization across Windows, macOS, and Linux.",
    "homepage": "https://github.com/keithvassallomt/ClusterCut",
    "license": "GPL-3.0",
    "url": "https://github.com/keithvassallomt/ClusterCut/releases/download/v0.5.0/ClusterCut_0.5.0_x64-setup.exe",
    "hash": "53987ba3c0d0b44a28164b529f4d67496120e797c48aac9212a979513ca5f9a3",
    "installer": {
        "args": [
            "/S",
            "/NS",
            "/D=$dir"
        ]
    },
    "post_install": [
        "$exe = Join-Path $dir 'ClusterCut.exe'",
        "if (!(Test-Path $exe)) { throw 'ClusterCut.exe was not found after installation.' }"
    ],
    "uninstaller": {
        "script": "if (Test-Path (Join-Path $dir 'uninstall.exe')) { Invoke-ExternalCommand (Join-Path $dir 'uninstall.exe') -ArgumentList '/S' | Out-Null }"
    },
    "bin": "ClusterCut.exe",
    "shortcuts": [
        [
            "ClusterCut.exe",
            "ClusterCut"
        ]
    ],
    "checkver": "github",
    "autoupdate": {
        "url": "https://github.com/keithvassallomt/ClusterCut/releases/download/v$version/ClusterCut_$version_x64-setup.exe"
    }
}
