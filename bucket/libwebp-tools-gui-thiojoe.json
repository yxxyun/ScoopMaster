{
    "version": "1.0.0",
    "description": "GUI front ends for encoding images to WebP and decoding WebP images using the libwebp command-line tools.",
    "homepage": "https://github.com/ThioJoe/LibWebpToolsGUI",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": [
                "https://github.com/ThioJoe/LibWebpToolsGUI/releases/download/v1.0.0/ConvertFromWebp.bat",
                "https://github.com/ThioJoe/LibWebpToolsGUI/releases/download/v1.0.0/ConvertToWebp.bat",
                "https://github.com/ThioJoe/LibWebpToolsGUI/releases/download/v1.0.0/cWebpGUI.exe",
                "https://github.com/ThioJoe/LibWebpToolsGUI/releases/download/v1.0.0/dWebpGUI.exe"
            ],
            "hash": [
                "5f1ae49365b2c257eabd0dc917c44e8708c71812a33ab28d4f3331e83b49629d",
                "d2b25459aacd91ea9ea528b7e644041144f553183b6af8c19062fe0c08ce36a2",
                "c04a6a498a658f2939cfa74d5b44debf095db00a91967560e99e2396126c1da3",
                "9c6032f3fca34ebbcd2defabb68ba2ea95afce49a63b621f433ca63444342ff3"
            ]
        }
    },
    "depends": "libwebp",
    "post_install": [
        "$libwebpBin = Join-Path (appdir 'libwebp') 'current\\bin'",
        "foreach ($requiredFile in @('cwebp.exe', 'dwebp.exe')) {",
        "    $sourceFile = Join-Path $libwebpBin $requiredFile",
        "    if (-not (Test-Path -LiteralPath $sourceFile -PathType Leaf)) { throw \"Required libwebp file not found: $sourceFile\" }",
        "    Copy-Item -LiteralPath $sourceFile -Destination $dir -Force",
        "}",
        "Get-ChildItem -LiteralPath $libwebpBin -Filter '*.dll' -File | ForEach-Object { Copy-Item -LiteralPath $_.FullName -Destination $dir -Force }"
    ],
    "shortcuts": [
        [
            "cWebpGUI.exe",
            "cWebpGUI - ThioJoe"
        ],
        [
            "dWebpGUI.exe",
            "dWebpGUI - ThioJoe"
        ]
    ],
    "checkver": {
        "github": "https://github.com/ThioJoe/LibWebpToolsGUI"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": [
                    "https://github.com/ThioJoe/LibWebpToolsGUI/releases/download/v$version/ConvertFromWebp.bat",
                    "https://github.com/ThioJoe/LibWebpToolsGUI/releases/download/v$version/ConvertToWebp.bat",
                    "https://github.com/ThioJoe/LibWebpToolsGUI/releases/download/v$version/cWebpGUI.exe",
                    "https://github.com/ThioJoe/LibWebpToolsGUI/releases/download/v$version/dWebpGUI.exe"
                ],
                "shortcuts": [
                    [
                        "cWebpGUI.exe",
                        "cWebpGUI - ThioJoe"
                    ],
                    [
                        "dWebpGUI.exe",
                        "dWebpGUI - ThioJoe"
                    ]
                ]
            }
        }
    },
    "notes": "Requires the Scoop Main libwebp package. The manifest copies cwebp.exe, dwebp.exe, and the libwebp DLLs beside both GUI executables, as required by the upstream project."
}
