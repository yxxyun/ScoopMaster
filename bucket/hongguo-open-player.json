{
    "version": "1.6.4",
    "description": "An open-source desktop client for Hongguo short dramas.",
    "homepage": "https://github.com/zfdang/hongguo-open-player",
    "license": "AGPL-3.0-only",
    "architecture": {
        "64bit": {
            "url": "https://github.com/zfdang/hongguo-open-player/releases/download/v1.6.4/hongguo-open-player-1.6.4-win-x64.zip",
            "hash": "6a777a230a1d0405ac751cb0423a75abed2d7a5cbb3e859461b3d2f6c265c58b"
        }
    },
    "shortcuts": [
        [
            "红果开源播放器.exe",
            "Hongguo Open Player",
            "--user-data-dir=\"$persist_dir\\data\""
        ]
    ],
    "persist": "data",
    "checkver": {
        "github": "https://github.com/zfdang/hongguo-open-player"
    },
    "autoupdate": {
