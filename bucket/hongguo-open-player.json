{
    "version": "1.4.3",
    "description": "An open-source desktop client for Hongguo short dramas.",
    "homepage": "https://github.com/zfdang/hongguo-open-player",
    "license": "AGPL-3.0-only",
    "architecture": {
        "64bit": {
            "url": "https://github.com/zfdang/hongguo-open-player/releases/download/v1.4.3/hongguo-open-player-1.4.3-win-x64.zip",
            "hash": "bdc66f0e3db41136020c7b8cf6b774703106b7ae00f64622a9901df208228ba5"
        }
    },
    "shortcuts": [
        [
            "红果开源播放器.exe",
            "Hongguo Open Player",
            "--user-data-dir=\"$persist_dir\\data\""
        ]
    ],
    "persist": "data",
    "checkver": {
        "github": "https://github.com/zfdang/hongguo-open-player"
    },
    "autoupdate": {
