{
    "version": "1.6.3",
    "description": "An open-source desktop client for Hongguo short dramas.",
    "homepage": "https://github.com/zfdang/hongguo-open-player",
    "license": "AGPL-3.0-only",
    "architecture": {
        "64bit": {
            "url": "https://github.com/zfdang/hongguo-open-player/releases/download/v1.6.3/hongguo-open-player-1.6.3-win-x64.zip",
            "hash": "3441bf0157ebcc12d32a8e593090f8b8d2453a997e27be856ecd9821b2ff714d"
        }
    },
    "shortcuts": [
        [
            "红果开源播放器.exe",
            "Hongguo Open Player",
            "--user-data-dir=\"$persist_dir\\data\""
        ]
    ],
    "persist": "data",
    "checkver": {
        "github": "https://github.com/zfdang/hongguo-open-player"
    },
    "autoupdate": {
