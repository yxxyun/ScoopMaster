    "pre_install": [
        "$scriptdir = \"$bucketsdir\\$bucket\\scripts\\$app\"",
        "Copy-Item \"$scriptdir\\install.xml\" \"$dir\\\"",
        "Copy-Item \"$scriptdir\\uninstall.xml\" \"$dir\\\""
    ],
    "installer": {
        "script": [
            "Start-Process -Wait 7z -ArgumentList @('x', '-bso0', \"`\"$dir\\dl.7z_`\"\", \"`\"-o$dir`\"\")",
            "Start-Process -Wait \"$dir\\setup.exe\" -ArgumentList @('/configure', \"`\"$dir\\install.xml`\"\")"
        ]
    },
    "uninstaller": {
        "script": "Start-Process -Wait \"$dir\\setup.exe\" -ArgumentList @('/configure', \"`\"$dir\\uninstall.xml`\"\")"
    },
    "checkver": {
        "url": "https://www.microsoft.com/en-au/download/details.aspx?id=49117",
        "script": [
            "$ProgressPreference = 'SilentlyContinue'",
            "$url = 'https://www.microsoft.com/en-au/download/details.aspx?id=49117'",
            "$cont = (Invoke-WebRequest $url).Content",
            "",
            "if (!($cont -match '\"version\":\"(?<ver>\\d+\\.\\d+\\.\\d+\\.\\d+)\"')) { Write-Error 'Could not match version'; return }",
            "$app_ver = $matches['ver']",
            "",
            "if (!($cont -match '\"url\":\"(?<url>https://download\\.microsoft\\.com/download/[a-z0-9\\-]+/officedeploymenttool_[0-9\\-]+\\.exe)\"')) { Write-Error 'Could not match download URL'; return }",
            "$download_url = $matches['url']",
            "",
            "Write-Output \"$app_ver $download_url\""
        ],
        "regex": "(?<version>[\\d.]+) (?<url>https://download\\.microsoft\\.com/download/[a-z0-9\\-]+/officedeploymenttool_[0-9\\-]+\\.exe)"
    },
    "autoupdate": {
        "url": "$matchUrl#/dl.7z_"
    }
}
