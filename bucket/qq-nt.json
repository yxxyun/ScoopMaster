{
    "version": "9.9.35.260902",
    "description": "QQ-NT",
    "homepage": "https://im.qq.com",
    "license": "Freeware",
    "url": "https://qq-web.cdn-go.cn/im.qq.com_new/latest/rainbow/windowsConfig.js",
    "hash": "9d3f3363a2dcd880b0bd37b6f984cab5f79e2cf824cca5a5015d1514b6c16c33",
    "pre_install": [
        "$config = Get-Content -Raw -LiteralPath \"$dir\\windowsConfig.js\"",
        "$urlPattern = '\"ntDownloadX64Url\"\\s*:\\s*\"(?<url>https://qqdl\\.gtimg\\.cn/qqfile/QQNT(?:V2)?/(?<release>\\d+(?:\\.\\d+)*)/release/[^/]+/QQ_\\k<release>_(?<build>\\d+)_x64_01\\.exe)\"'",
        "$download = [regex]::Match($config, $urlPattern)",
        "if (!$download.Success) { throw 'Unable to find the QQ x64 download URL.' }",
        "$downloadUrl = $download.Groups['url'].Value",
        "$detectedVersion = \"$($download.Groups['release'].Value).$($download.Groups['build'].Value)\"",
        "if ($detectedVersion -ne $version) { throw \"QQ download version $detectedVersion does not match manifest version $version.\" }",
        "$signHeaders = @{ 'x-oidb' = '{\"uint32_command\":\"0x9b8e\",\"uint32_service_type\":1}'; 'Origin' = 'https://im.qq.com'; 'Referer' = 'https://im.qq.com/index/' }",
        "$signBody = @{ url = $downloadUrl } | ConvertTo-Json -Compress",
        "$signResponse = Invoke-RestMethod -Method Post -Uri 'https://im.qq.com/http2rpc/gotrpc/noauth/trpc.qqntv2.urlsign.UrlSign/GetSign' -ContentType 'application/json' -Headers $signHeaders -Body $signBody",
        "$signedUrl = $signResponse.data.url",
        "if (!$signedUrl) { throw \"QQ did not return a signed download URL: $($signResponse.message)\" }",
        "$cacheFile = [IO.Path]::ChangeExtension((cache_path 'QQ-NT' $version 'https://qq-web.cdn-go.cn/im.qq.com_new/latest/rainbow/windowsConfig.js'), 'exe')",
        "$cacheDir = Split-Path -Parent $cacheFile",
        "$cacheComplete = \"${cacheFile}.ok\"",
        "if (!(Test-Path -LiteralPath $cacheComplete) -or !(Test-Path -LiteralPath $cacheFile)) {",
        "    $aria2 = Get-Command aria2c -ErrorAction SilentlyContinue",
        "    if (!$aria2) { throw 'aria2c is required to download QQ. Install aria2 and try again.' }",
        "    & $aria2.Source \"--dir=$cacheDir\" \"--out=$([IO.Path]::GetFileName($cacheFile))\" '--allow-overwrite=true' '--auto-file-renaming=false' '--continue=true' '--file-allocation=none' '--max-tries=5' '--retry-wait=5' '--summary-interval=0' $signedUrl",
        "    if ($LASTEXITCODE -ne 0) { throw \"aria2c failed to download QQ (exit code: $LASTEXITCODE).\" }",
        "    New-Item -ItemType File -Path $cacheComplete -Force | Out-Null",
        "}",
        "Expand-7zipArchive -Path $cacheFile -DestinationPath $dir -ExtractDir 'Files'",
        "Remove-Item \"$dir\\windowsConfig.js\" -Force"
    ],
    "shortcuts": [
        [
            "QQ.exe",
            "QQ"
        ]
    ],
    "checkver": {
        "url": "https://qq-web.cdn-go.cn/im.qq.com_new/latest/rainbow/windowsConfig.js",
        "regex": "QQNT(?:V2)?/[\\d.]+/release/([a-f0-9]+)/QQ_([\\d.]+)_(\\d+)_x64_01\\.exe",
        "replace": "${2}.${3}"
    },
    "autoupdate": {
        "url": "https://qq-web.cdn-go.cn/im.qq.com_new/latest/rainbow/windowsConfig.js"
    }
}
