{
    "version": "1.8",
    "description": "Portable edition of Vovsoft Website File Collector.",
    "homepage": "https://vovsoft.com/software/website-file-collector/",
    "license": "Proprietary",
    "url": "https://vovsoft.com/files/website-file-collector-portable.zip?v=1.8",
    "checkver": {
        "url": "https://vovsoft.com/download/website-file-collector-portable/",
        "regex": "(?is)Version\\s*(?:<[^>]*>\\s*)*:?\\s*(?:<[^>]*>\\s*)*(?<version>\\d+(?:\\.\\d+)+)"
    },
    "autoupdate": {
        "url": "https://vovsoft.com/files/website-file-collector-portable.zip?v=$version"
    },
    "shortcuts": [
        [
            "wsfilecollector.exe",
            "Vovsoft Website File Collector"
        ]
    ],
    "notes": "SHA-256 has not been verified; archive contents and the shortcut target have been checked.",
    "pre_install": "if (-not (Test-Path -LiteralPath \"$dir\\key.txt\" -PathType Leaf)) { New-Item -ItemType File -Path \"$dir\\key.txt\" | Out-Null }",
    "persist": "key.txt"
}
