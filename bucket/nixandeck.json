{
    "version": "1.0.0-beta.1",
    "description": "Windows 11 shell replacement with a macOS-style top menu bar, Dynamic Island, and floating dock.",
    "homepage": "https://github.com/nurikhsanuddin/nixandeck",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/nurikhsanuddin/nixandeck/releases/download/v1.0.0-beta.1/NixanDeck-Windows11-x64.zip",
            "hash": "97c275417e4ee3355241ee015a5dde4753358b44f9f4e4b15bf101bb31fe5af8"
        }
    },
    "pre_install": [
        "$activeProcesses = @(Get-Process -Name 'WinMacShell', 'NixanDeck.Watchdog' -ErrorAction SilentlyContinue)",
        "if ($activeProcesses.Count -gt 0) { throw 'Close NixanDeck and its Watchdog before installing or updating this Scoop package.' }",
        "$msixPath = Join-Path $dir 'NixanDeck.msix'",
        "$msixZipPath = Join-Path $dir 'NixanDeck.msix.zip'",
        "$payloadDir = Join-Path $dir 'app'",
        "if (!(Test-Path -LiteralPath $msixPath -PathType Leaf)) { throw 'NixanDeck.msix was not found in the official release ZIP.' }",
        "New-Item -ItemType Directory -Path $payloadDir -Force | Out-Null",
        "Copy-Item -LiteralPath $msixPath -Destination $msixZipPath -Force",
        "Expand-ZipArchive -Path $msixZipPath -DestinationPath $payloadDir -Removal",
        "$appxManifestPath = Join-Path $payloadDir 'AppxManifest.xml'",
        "if (!(Test-Path -LiteralPath $appxManifestPath -PathType Leaf)) { throw 'AppxManifest.xml was not extracted from NixanDeck.msix.' }",
        "[xml]$packageManifest = Get-Content -LiteralPath $appxManifestPath -Raw",
        "$identity = $packageManifest.SelectSingleNode(\"//*[local-name()='Identity']\")",
        "$application = $packageManifest.SelectSingleNode(\"//*[local-name()='Application']\")",
        "if ($null -eq $identity -or $identity.GetAttribute('Name') -ne 'NixanDeck') { throw 'Unexpected MSIX package identity.' }",
        "if ($identity.GetAttribute('Publisher') -ne 'CN=NixanDeck' -or $identity.GetAttribute('ProcessorArchitecture') -ne 'x64') { throw 'Unexpected NixanDeck publisher or architecture.' }",
        "if ($null -eq $application -or $application.GetAttribute('Id') -ne 'NixanDeckApp') { throw 'The NixanDeck application entry was not found.' }",
        "$exeName = $application.GetAttribute('Executable')",
        "if ([string]::IsNullOrWhiteSpace($exeName) -or [System.IO.Path]::IsPathRooted($exeName) -or $exeName -match '(^|[\\\\/])\\.\\.([\\\\/]|$)') { throw 'The MSIX executable path is invalid.' }",
        "$exePath = Join-Path $payloadDir $exeName",
        "if (!(Test-Path -LiteralPath $exePath -PathType Leaf)) { throw \"The application executable was not extracted: $exeName\" }",
        "if (!(Test-Path -LiteralPath (Join-Path $payloadDir 'NixanDeck.Watchdog.exe') -PathType Leaf)) { throw 'NixanDeck.Watchdog.exe is missing from the extracted payload.' }",
        "if ($PSVersionTable.PSVersion.Major -ge 6) { Import-Module Appx -UseWindowsPowerShell -ErrorAction Stop } else { Import-Module Appx -ErrorAction Stop }",
        "$oldPackages = @(Get-AppxPackage -Name 'NixanDeck' -ErrorAction SilentlyContinue)",
        "foreach ($oldPackage in $oldPackages) { Remove-AppxPackage -Package $oldPackage.PackageFullName -ErrorAction Stop }",
        "if (@(Get-AppxPackage -Name 'NixanDeck' -ErrorAction SilentlyContinue).Count -gt 0) { throw 'The previous NixanDeck MSIX registration could not be removed.' }",
        "Remove-Item -LiteralPath $msixPath -Force",
        "Remove-Item -LiteralPath (Join-Path $dir 'NixanDeck.cer'), (Join-Path $dir 'Install.bat') -Force -ErrorAction SilentlyContinue"
    ],
    "persist": [
        "WinMacShell"
    ],
    "post_install": [
        "$appDataPath = Join-Path $env:APPDATA 'WinMacShell'",
        "$persistedDataPath = Join-Path $persist_dir 'WinMacShell'",
        "$junctionMarker = Join-Path $persistedDataPath '.scoop-appdata-junction'",
        "if (!(Test-Path -LiteralPath $persistedDataPath -PathType Container)) { New-Item -ItemType Directory -Path $persistedDataPath -Force | Out-Null }",
        "if (Test-Path -LiteralPath $appDataPath) {",
        "    $existingAppData = Get-Item -LiteralPath $appDataPath -Force",
        "    if (($existingAppData.Attributes -band [System.IO.FileAttributes]::ReparsePoint) -ne 0) {",
        "        if (!(Test-Path -LiteralPath $junctionMarker -PathType Leaf) -or (Get-Content -LiteralPath $junctionMarker -Raw).Trim() -ine $appDataPath) { throw 'An existing AppData junction is present but is not owned by this Scoop installation; it was not changed.' }",
        "    } else {",
        "        if (!$existingAppData.PSIsContainer) { throw 'The existing AppData\\WinMacShell path is not a directory.' }",
        "        $sourceFiles = @(Get-ChildItem -LiteralPath $appDataPath -File -Recurse -Force -ErrorAction SilentlyContinue)",
        "        $targetFiles = @(Get-ChildItem -LiteralPath $persistedDataPath -File -Recurse -Force -ErrorAction SilentlyContinue)",
        "        if ($sourceFiles.Count -gt 0 -and $targetFiles.Count -gt 0) { throw 'Both the existing AppData folder and Scoop persist contain files; refusing to overwrite either copy.' }",
        "        Get-ChildItem -LiteralPath $appDataPath -Force | ForEach-Object { Copy-Item -LiteralPath $_.FullName -Destination $persistedDataPath -Recurse -Force }",
        "        Remove-Item -LiteralPath $appDataPath -Recurse -Force",
        "    }",
        "}",
        "if (!(Test-Path -LiteralPath $appDataPath)) { New-Item -ItemType Junction -Path $appDataPath -Target $persistedDataPath | Out-Null }",
        "Set-Content -LiteralPath $junctionMarker -Value $appDataPath -Encoding UTF8",
        "New-Item -Path 'HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Run' -Force | Out-Null"
    ],
    "shortcuts": [
        [
            "app\\WinMacShell.exe",
            "NixanDeck"
        ]
    ],
    "post_uninstall": [
        "$appDataPath = Join-Path $env:APPDATA 'WinMacShell'",
        "$persistedDataPath = Join-Path $persist_dir 'WinMacShell'",
        "$junctionMarker = Join-Path $persistedDataPath '.scoop-appdata-junction'",
        "if (Test-Path -LiteralPath $junctionMarker -PathType Leaf) {",
        "    $markerValue = (Get-Content -LiteralPath $junctionMarker -Raw).Trim()",
        "    if ($markerValue -ieq $appDataPath -and (Test-Path -LiteralPath $appDataPath)) {",
        "        $appDataItem = Get-Item -LiteralPath $appDataPath -Force",
        "        if (($appDataItem.Attributes -band [System.IO.FileAttributes]::ReparsePoint) -ne 0) { Remove-Item -LiteralPath $appDataPath -Force }",
        "    }",
        "    Remove-Item -LiteralPath $junctionMarker -Force",
        "}",
        "$runKey = [Microsoft.Win32.Registry]::CurrentUser.OpenSubKey('Software\\Microsoft\\Windows\\CurrentVersion\\Run', $true)",
        "if ($null -ne $runKey) {",
        "    try {",
        "        $runValue = [string]$runKey.GetValue('NixanDeck', $null, 'DoNotExpandEnvironmentNames')",
        "        $registeredExe = $null",
        "        if ($runValue -match '^\\s*\"([^\"]+)\"') { $registeredExe = $matches[1] } elseif ($runValue -match '^\\s*(.+?\\.exe)(?:\\s|$)') { $registeredExe = $matches[1] }",
        "        if ($registeredExe) {",
        "            $registeredFullPath = [System.IO.Path]::GetFullPath($registeredExe)",
        "            $appRoot = appdir $app $global",
        "            $expectedPaths = @((Join-Path $appRoot 'current\\app\\WinMacShell.exe'), (Join-Path $dir 'app\\WinMacShell.exe'))",
        "            foreach ($expectedPath in $expectedPaths) {",
        "                if ($registeredFullPath -ieq [System.IO.Path]::GetFullPath($expectedPath)) { $runKey.DeleteValue('NixanDeck', $false); break }",
        "            }",
        "        }",
        "    } finally { $runKey.Dispose() }",
        "}",
        "$localAppDataPath = Join-Path $env:LOCALAPPDATA 'WinMacShell'",
        "$watchdogPidPath = Join-Path $localAppDataPath 'watchdog.pid'",
        "if (Test-Path -LiteralPath $watchdogPidPath -PathType Leaf) {",
        "    $watchdogPid = 0",
        "    if (![int]::TryParse((Get-Content -LiteralPath $watchdogPidPath -Raw).Trim(), [ref]$watchdogPid)) {",
        "        Remove-Item -LiteralPath $watchdogPidPath -Force",
        "    } else {",
        "        $pidProcess = Get-Process -Id $watchdogPid -ErrorAction SilentlyContinue",
        "        if ($null -eq $pidProcess -or $pidProcess.ProcessName -ne 'WinMacShell') { Remove-Item -LiteralPath $watchdogPidPath -Force }",
        "    }",
        "}",
        "if ((Test-Path -LiteralPath $localAppDataPath -PathType Container) -and @(Get-ChildItem -LiteralPath $localAppDataPath -Force).Count -eq 0) { Remove-Item -LiteralPath $localAppDataPath -Force }"
    ],
    "checkver": {
        "url": "https://api.github.com/repos/nurikhsanuddin/nixandeck/releases?per_page=1",
        "regex": "\"tag_name\"\\s*:\\s*\"v([\\w.-]+)\""
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/nurikhsanuddin/nixandeck/releases/download/v$version/NixanDeck-Windows11-x64.zip",
                "hash": {
                    "url": "https://api.github.com/repos/nurikhsanuddin/nixandeck/releases/tags/v$version",
                    "regex": "\"name\"\\s*:\\s*\"NixanDeck-Windows11-x64\\.zip\"[\\s\\S]*?\"digest\"\\s*:\\s*\"sha256:([a-f0-9]{64})\""
                }
            }
        }
    },
    "##": "Installer Type: MSIX (extracted to Scoop; unpackaged execution)",
    "notes": [
        "The MSIX payload is extracted into the Scoop version directory and WinMacShell.exe runs directly; the package is not registered with Windows and its signing certificate is not installed.",
        "NixanDeck settings in %APPDATA%\\WinMacShell are redirected to Scoop persist and retained after uninstall.",
        "Unpackaged execution has no MSIX Package Identity. Features that depend on packaged identity, including StartupTask and UserNotificationListener access, may be limited; the app has its own Run-key and WPN database fallbacks.",
        "During migration from the previous MSIX manifest, the hook removes only the current Windows user's NixanDeck package registration. The old machine TrustedPeople certificate is left untouched."
    ]
}
