    "homepage": "https://www.codebuddy.cn/work/",
    "license": "Proprietary",
    "architecture": {
        "64bit": {
            "url": "https://download.codebuddy.cn/workbuddy/saas/win32-x64-user/WorkBuddy-win32-x64-user-5.8.2.41111488-b8f6c953.exe#/dl.7z",
            "hash": "ec233185f6fb48ed8a7040e70c7810888b56311c830096a660bc33b3cf1ad0cc"
        }
    },
    "pre_install": [
        "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-64.7z\" \"$dir\"",
        "Remove-Item \"$dir\\`$PLUGINSDIR\", \"$dir\\`$R0\" -Force -Recurse -ErrorAction SilentlyContinue"
    ],
    "post_install": [
        "$configDir = \"$env:USERPROFILE\\.workbuddy\"",
        "$persistConfigDir = \"$persist_dir\\.workbuddy\"",
        "if ((Test-Path $configDir) -and !(Get-Item $configDir -Force).LinkType) {",
        "    warn \"$configDir already exists and is not managed by Scoop, user data will stay in %USERPROFILE%.\"",
        "} else {",
        "    if (Test-Path $configDir) { Remove-Item $configDir -Force }",
        "    New-Item -ItemType Junction -Path $configDir -Target $persistConfigDir -Force | Out-Null",
        "    info \"Created junction: %USERPROFILE%\\.workbuddy -> $persistConfigDir\"",
        "}"
    ],
    "pre_uninstall": [
        "$configDir = \"$env:USERPROFILE\\.workbuddy\"",
        "if ((Test-Path $configDir) -and (Get-Item $configDir -Force).LinkType) {",
        "    Remove-Item $configDir -Force",
        "    info 'Removed junction: %USERPROFILE%\\.workbuddy (data kept in Scoop persist directory)'",
        "}"
    ],
    "shortcuts": [
        [
            "WorkBuddy.exe",
            "WorkBuddy"
        ]
    ],
    "persist": ".workbuddy",
    "checkver": {
        "url": "https://www.codebuddy.cn/v2/update?platform=workbuddy-win32-x64-user",
        "regex": "WorkBuddy-win32-x64-user-([\\d.]+(?:-[\\da-f]+)?)\\.exe"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://download.codebuddy.cn/workbuddy/saas/win32-x64-user/WorkBuddy-win32-x64-user-$version.exe#/dl.7z"
            }
        }
    }
}
