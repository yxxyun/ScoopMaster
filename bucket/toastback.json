{
    "version": "1.5.0",
    "description": "Windows toast notifications for WSL and scripts: buttons that run commands, progress bars, and a drop-in notify-send",
    "homepage": "https://github.com/gergodrazsdik/toastback",
    "license": "GPL-3.0-or-later",
    "notes": [
        "toastback registered itself in %LOCALAPPDATA%\\toastback and wrote its WSL shim to the default distro.",
        "Check it with `toastback-cli doctor`; see https://github.com/gergodrazsdik/toastback#install for other distros."
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/gergodrazsdik/toastback/releases/download/v1.5.0/toastback-x86_64.zip",
            "hash": "20881bc78187766cd3ff57b3a7ca48604835b0a4567de00801c5e6a52943dc3a"
        }
    },
    "bin": "toastback-cli.exe",
    "installer": {
        "script": [
            "& \"$dir\\toastback-cli.exe\" install --quiet",
            "if ($LASTEXITCODE) { throw \"toastback install failed (exit $LASTEXITCODE)\" }"
        ]
    },
    "pre_uninstall": [
        "# `scoop update` runs this too: only `scoop uninstall` removes the installation, so updates keep its settings",
        "if ($cmd -eq 'uninstall') {",
        "    if ($purge) { & \"$dir\\toastback-cli.exe\" uninstall --purge } else { & \"$dir\\toastback-cli.exe\" uninstall }",
        "}"
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/gergodrazsdik/toastback/releases/download/v$version/toastback-x86_64.zip"
            }
        },
        "hash": {
            "url": "$baseurl/SHA256SUMS",
            "regex": "$sha256\\s+$basename"
        }
    }
}
