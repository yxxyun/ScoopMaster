{
    "version": "0.4.0",
    "description": "Windows file-copy utility that verifies every file and never lets one failure abort the batch",
    "homepage": "https://github.com/yunicopy/yunicopy",
    "license": "MIT|Apache-2.0",
    "notes": [
        "Scoop installs the portable build: settings and logs stay inside the app directory",
        "(the yunicopy.portable marker file). 'yunicopy' is the console tool; the window is",
        "available as the 'YuniCopy' shortcut or via 'yunicopy-gui'.",
        "Optional Explorer right-click integration: yunicopy-gui --install-shell",
        "(and yunicopy-gui --uninstall-shell before 'scoop uninstall yunicopy').",
        "Settings, saved jobs and logs are kept in the persist folder, so 'scoop update' does not lose them."
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/yunicopy/yunicopy/releases/download/v0.4.0/YuniCopy-0.4.0-x64-portable.zip",
            "hash": "47b7d0e251077e3e481fd759f4d4c4f027510fc3dd6295bf3ff9a7f40d9676dd"
        },
        "arm64": {
            "url": "https://github.com/yunicopy/yunicopy/releases/download/v0.4.0/YuniCopy-0.4.0-arm64-portable.zip",
            "hash": "6150cf7682d4360c39c2b07d2f9ad8b172c7060f405158d3a0caae8f6454d385"
        }
    },
    "bin": [
        "yunicopy.exe",
        "yunicopy-gui.exe"
    ],
    "shortcuts": [
        [
            "yunicopy-gui.exe",
            "YuniCopy"
        ]
    ],
    "persist": [
