{
    "version": "2.2",
    "description": "Portable edition of Vovsoft Directory Monitor.",
    "homepage": "https://vovsoft.com/software/directory-monitor/",
    "license": "Proprietary",
    "url": "https://vovsoft.com/files/directory-monitor-portable.zip?v=2.2",
    "checkver": {
        "url": "https://vovsoft.com/download/directory-monitor-portable/",
        "regex": "(?is)Version\\s*(?:<[^>]*>\\s*)*:?\\s*(?:<[^>]*>\\s*)*(?<version>\\d+(?:\\.\\d+)+)"
    },
    "autoupdate": {
        "url": "https://vovsoft.com/files/directory-monitor-portable.zip?v=$version"
    },
    "shortcuts": [
        [
            "dirmonitor.exe",
            "Vovsoft Directory Monitor"
        ]
    ],
    "pre_install": [
        "if (-not (Test-Path -LiteralPath \"$dir\\key.txt\" -PathType Leaf)) { New-Item -ItemType File -Path \"$dir\\key.txt\" | Out-Null }"
    ],
    "persist": "key.txt"
}
