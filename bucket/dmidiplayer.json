{
    "version": "1.7.5",
    "description": "a multiplatform MIDI file player for Linux, Windows and macOS",
    "homepage": "https://dmidiplayer.sourceforge.io",
    "license": "GPL-3.0-or-later",
    "notes": "The installer hardcodes its target directory to Program Files and cannot be redirected, and its DLLs are packed under NSIS runtime temp names (unpackable by 7-Zip). This manifest runs the installer silently, copies the result into the scoop app dir, then silently removes the Program Files copy.",
    "architecture": {
        "64bit": {
            "url": "https://sourceforge.net/projects/dmidiplayer/files/v1.7.5/dmidiplayer-1.7.5a-win-x64-setup.exe",
            "hash": "bb0c8113199579e9c78be6693dda80b6ea5e95e334a52772c0a632d0f2402342"
        }
    },
    "installer": {
        "script": [
            "Start-Process -Wait -FilePath \"$dir\\$fname\" -ArgumentList '/S'",
            "Copy-Item -Recurse -Force \"$env:ProgramFiles\\dmidiplayer\\*\" \"$dir\"",
            "Start-Process -Wait -FilePath \"$env:ProgramFiles\\dmidiplayer\\uninstall.exe\" -ArgumentList '/S'",
            "Remove-Item \"$dir\\$fname\" -Force"
        ]
    },
    "shortcuts": [
        [
            "dmidiplayer.exe",
            "dmidiplayer"
        ]
    ],
    "checkver": {
        "sourceforge": "dmidiplayer",
        "regex": "dmidiplayer-(?<version>[\\d.]+)(?<suffix>[a-z]?)-win-x64-setup\\.exe"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://sourceforge.net/projects/dmidiplayer/files/v$version/dmidiplayer-$matchVersion$matchSuffix-win-x64-setup.exe"
            }
        }
    }
}
