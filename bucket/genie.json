{
    "version": "2026-08-21-f7055e3",
    "description": "GENie: Project generator tool",
    "homepage": "https://github.com/bkaradzic/GENie",
    "license": "BSD-3-Clause",
    "notes": "This app is compiled from source on install. It depends on mingw-winlibs for gcc/mingw32-make. First install (or update) may take a minute while it builds.",
    "depends": "mingw-winlibs",
    "url": "https://github.com/bkaradzic/GENie/archive/refs/heads/master.zip",
    "hash": "07f549f3d2adf08ab6c2ba7c525de0849fdb8cc117bd42ebb08d3a07bf2224e3",
    "extract_dir": "GENie-master",
    "installer": {
        "script": [
            "Push-Location \"$dir\"",
            "& mingw32-make.exe OS=windows PROJECT_TYPE=gmake 2>&1 | Out-Host",
            "Pop-Location",
            "if (!(Test-Path \"$dir\\bin\\windows\\genie.exe\")) { Write-Host -f Red 'GENie build failed - see log above.'; throw 'genie.exe was not produced by the build' }"
        ]
    },
    "bin": "bin\\windows\\genie.exe",
    "checkver": {
        "url": "https://github.com/bkaradzic/GENie/commits/master.atom",
        "regex": "Commit/(?<hash>[0-9a-f]{7})[0-9a-f]{33}[\\S\\s]*?<updated>(?<date>\\d{4}-\\d{2}-\\d{2})T",
        "replace": "${date}-${hash}"
    },
    "autoupdate": {
        "url": "https://github.com/bkaradzic/GENie/archive/refs/heads/master.zip"
    }
}
