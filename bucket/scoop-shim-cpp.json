{
    "version": "0.2.2",
    "description": "Scoop shim launcher (C++ implementation). Runs the executable described in its paired .shim file.",
    "homepage": "https://github.com/ScoopInstaller/Shim",
    "license": "Unlicense OR MIT",
    "notes": [
        "Scoop core has no support for the new shim implementations yet, so this manifest overwrites every built-in Scoop shim (supporting\\shims\\71, kiennq and scoopcs).",
        "Whatever 'scoop config shim' is set to (or the default kiennq), Scoop will use this implementation.",
        "Install only one of scoop-shim-cs, scoop-shim-cpp, scoop-shim-rust or scoop-shim-zig at a time."
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/ScoopInstaller/Shim/releases/download/cpp/v0.2.2/shim-x64.zip",
            "hash": "7b725a2d01f835aeb42c979251bd44a5cdb3c1da12afcbf78e91db4edd0c0fdb"
        },
        "32bit": {
            "url": "https://github.com/ScoopInstaller/Shim/releases/download/cpp/v0.2.2/shim-x86.zip",
            "hash": "9395aa8119dd4293ae93a7f81d2b673946b0336de40a1643ce35646584fee79d"
        },
        "arm64": {
            "url": "https://github.com/ScoopInstaller/Shim/releases/download/cpp/v0.2.2/shim-arm64.zip",
            "hash": "5126673c659475d0fe67912d27ceca0c260896fe7a7a74b1ab4beede46819bc5"
        }
    },
    "post_install": [
        "if (scoop config shim) {",
        "    $shimBuild = scoop config shim",
        "} else {",
        "    $shimBuild = \"kiennq\"",
        "}",
        "Copy-Item \"$dir\\shim.exe\" \"$scoopdir\\apps\\scoop\\current\\supporting\\shims\\$shimBuild\\shim.exe\" -Force",
        "git -C \"$scoopdir\\apps\\scoop\\current\" update-index --skip-worktree \"supporting\\shims\\$shimBuild\\shim.exe\""
    ],
    "pre_uninstall": [
        "if (scoop config shim) {",
        "    $shimBuild = scoop config shim",
        "} else {",
        "    $shimBuild = \"kiennq\"",
        "}",
        "git -C \"$scoopdir\\apps\\scoop\\current\" update-index --no-skip-worktree \"supporting\\shims\\$shimBuild\\shim.exe\"",
        "git -C \"$scoopdir\\apps\\scoop\\current\" checkout -- \"supporting\\shims\\$shimBuild\\shim.exe\""
    ],
    "checkver": {
        "url": "https://api.github.com/repos/ScoopInstaller/Shim/releases",
        "jsonpath": "$[*].tag_name",
        "regex": "cpp/v([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/ScoopInstaller/Shim/releases/download/cpp/v$version/shim-x64.zip"
            },
            "32bit": {
                "url": "https://github.com/ScoopInstaller/Shim/releases/download/cpp/v$version/shim-x86.zip"
            },
            "arm64": {
                "url": "https://github.com/ScoopInstaller/Shim/releases/download/cpp/v$version/shim-arm64.zip"
            }
        }
    }
}
