{
    "version": "5.7",
    "description": "A desktop app for browsing, playing, and downloading Hongguo short dramas.",
    "homepage": "https://github.com/jackotom/hongguo-drama",
    "license": "GPL-3.0-only",
    "architecture": {
        "64bit": {
            "url": "https://github.com/jackotom/hongguo-drama/releases/download/v5.7/hongguo-downloader-5.7-win-x64.zip",
            "hash": "5eeca5e9e40e67edda905d004b4e3b0f72594370e3034938a92044555c0cf99c"
        }
    },
    "pre_install": "Get-ChildItem -LiteralPath $dir -Filter 'hongguo-downloader-*.exe' -File | Select-Object -First 1 | Rename-Item -NewName 'hongguo-drama.exe'",
    "shortcuts": [
        [
            "hongguo-drama.exe",
            "Hongguo Drama"
        ]
    ],
    "persist": "data",
    "checkver": {
        "github": "https://github.com/jackotom/hongguo-drama"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/jackotom/hongguo-drama/releases/download/v$version/hongguo-downloader-$version-win-x64.zip"
            }
        },
        "hash": {
            "url": "$baseurl/SHA256SUMS.txt",
            "regex": "$sha256\\s+$basename"
        }
    }
}
