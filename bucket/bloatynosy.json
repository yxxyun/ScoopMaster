{
  "version": "1.0.50",
  "description": "Windows debloater for reviewing privacy tweaks, system settings, and installed apps",
  "homepage": "https://github.com/builtbybel/Bloatynosy",
  "license": "MIT",
  "architecture": {
    "64bit": {
      "url": "https://github.com/builtbybel/Bloatynosy/releases/download/1.0.0/BloatynosyOrigin-1.0.50.zip",
      "hash": "b96753890c2979d3716ccd267dab2ed50018e0980595f7bb22d7006084552b4b"
    }
  },
  "pre_install": [
    "New-Item -ItemType Directory -Path \"$dir\\Data\" -Force | Out-Null",
    "if (!(Test-Path \"$dir\\Data\\Settings.json\")) { Set-Content -Path \"$dir\\Data\\Settings.json\" -Value '{}' -Encoding UTF8 }"
  ],
  "persist": "Data/Settings.json",
  "shortcuts": [
    [
      "Bloatynosy.exe",
      "Bloatynosy Origin"
    ]
  ],
  "checkver": {
    "url": "https://api.github.com/repos/builtbybel/Bloatynosy/releases/latest",
    "regex": "BloatynosyOrigin-([\\d.]+)\\.zip"
  },
  "autoupdate": {
    "architecture": {
      "64bit": {
        "url": "https://github.com/builtbybel/Bloatynosy/releases/latest/download/BloatynosyOrigin-$version.zip"
      }
    }
  },
  "notes": [
    "Portable ZIP build. Requires Windows 10 or 11 and .NET Framework 4.8.",
    "Review selected changes before applying; the app can change Windows settings or uninstall Store apps.",
    "Optional AI API keys are stored as plain text in Data/Settings.json."
  ]
}
