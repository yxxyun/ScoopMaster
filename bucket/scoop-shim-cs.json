{
    "version": "0.1.2",
    "description": "Scoop shim launcher (C# implementation). Runs the executable described in its paired .shim file.",
    "homepage": "https://github.com/ScoopInstaller/Shim",
    "license": "Unlicense OR MIT",
    "notes": [
        "Scoop core has no support for the new shim implementations yet, so this manifest overwrites every built-in Scoop shim (supporting\\shims\\71, kiennq and scoopcs).",
        "Whatever 'scoop config shim' is set to (or the default kiennq), Scoop will use this implementation.",
        "Install only one of scoop-shim-cs, scoop-shim-cpp, scoop-shim-rust or scoop-shim-zig at a time.",
        "Uninstalling restores the original files from Scoop's git checkout."
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/ScoopInstaller/Shim/releases/download/cs/v0.1.2/shim-x64.zip",
            "hash": "87a18af5397d66baad753fbc98b6afa043e66044068729bf97aaa718b384f62c"
        },
        "32bit": {
            "url": "https://github.com/ScoopInstaller/Shim/releases/download/cs/v0.1.2/shim-x86.zip",
            "hash": "d383e1b0d2398ab8648858c4e85851ff51d1667b0a6701191e18c7429d4adc83"
        },
        "arm64": {
            "url": "https://github.com/ScoopInstaller/Shim/releases/download/cs/v0.1.2/shim-arm64.zip",
            "hash": "28fb6ef60f13ecf221563536a50374b36cc9aded85a5d02955665d99ce0d08a7"
        }
    },
    "post_install": [
        "$shimRoot = \"$scoopdir\\apps\\scoop\\current\\supporting\\shims\"",
        "$impls = @('71', 'kiennq', 'scoopcs')",
        "if (Test-Path $shimRoot) { $impls = @($impls + @(Get-ChildItem $shimRoot -Directory -ErrorAction SilentlyContinue | Select-Object -ExpandProperty Name) | Select-Object -Unique) }",
        "foreach ($impl in $impls) {",
        "    $shimDir = ensure \"$shimRoot\\$impl\"",
        "    Copy-Item \"$dir\\shim.exe\" \"$shimDir\\shim.exe\" -Force",
        "    if (Test-Path \"$dir\\shim.exe.sha256\") { Copy-Item \"$dir\\shim.exe.sha256\" \"$shimDir\\checksum.sha256\" -Force }",
        "    if (Test-Path \"$dir\\shim.exe.sha512\") { Copy-Item \"$dir\\shim.exe.sha512\" \"$shimDir\\checksum.sha512\" -Force }",
        "    if (Test-Path \"$dir\\version\") { Copy-Item \"$dir\\version\" \"$shimDir\\version.txt\" -Force }",
        "}"
    ],
    "pre_uninstall": "git -C \"$scoopdir\\apps\\scoop\\current\" checkout -- supporting/shims",
    "checkver": {
        "url": "https://api.github.com/repos/ScoopInstaller/Shim/releases",
        "jsonpath": "$[*].tag_name",
        "regex": "cs/v([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/ScoopInstaller/Shim/releases/download/cs/v$version/shim-x64.zip"
            },
            "32bit": {
                "url": "https://github.com/ScoopInstaller/Shim/releases/download/cs/v$version/shim-x86.zip"
            },
            "arm64": {
                "url": "https://github.com/ScoopInstaller/Shim/releases/download/cs/v$version/shim-arm64.zip"
            }
        }
    }
}
