{
    "version": "0.1.0",
    "description": "Native terminal, SSH client and SFTP browser written in Go, supporting SSH, Mosh, EternalTerminal, Telnet and serial connections.",
    "homepage": "https://github.com/mslxl/natcatty",
    "license": "GPL-3.0-or-later",
    "url": "https://github.com/mslxl/natcatty/releases/download/v0.1.0/natcatty-0.1.0-windows-amd64-portable.zip",
    "hash": "70c3b4f0a47b7c45a3e778c236d545a56fa344d72ab09335a5d4916a49e7a671",
    "shortcuts": [
        [
            "Natcatty.exe",
            "Natcatty"
        ]
    ],
    "installer": {
        "script": [
            "ensure \"$persist_dir\" | Out-Null",
            "$targetPath = \"$env:APPDATA\\Natcatty\"",
            "$target = Get-Item -Path $targetPath -Force -ErrorAction SilentlyContinue",
            "if ($null -ne $target) {",
            "    if ($null -ne $target.LinkType) {",
            "        [System.IO.Directory]::Delete($targetPath)",
            "    } else {",
            "        Get-ChildItem -Path $targetPath -Force | Move-Item -Destination $persist_dir -Force -ErrorAction Stop",
            "        [System.IO.Directory]::Delete($targetPath)",
            "    }",
            "}",
            "New-Item -Path $targetPath -ItemType Junction -Target $persist_dir | Out-Null"
        ]
    },
    "uninstaller": {
        "script": [
            "$targetPath = \"$env:APPDATA\\Natcatty\"",
            "$target = Get-Item -Path $targetPath -Force -ErrorAction SilentlyContinue",
            "if ($null -ne $target -and $null -ne $target.LinkType) {",
            "    [System.IO.Directory]::Delete($targetPath)",
            "}"
        ]
    },
    "notes": "User data is stored in %APPDATA%\\Natcatty and linked to the Scoop persist directory.",
    "checkver": "github",
    "autoupdate": {
        "url": "https://github.com/mslxl/natcatty/releases/download/v$version/natcatty-$version-windows-amd64-portable.zip"
    }
}
