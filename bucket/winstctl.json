{
    "$schema": "https://raw.githubusercontent.com/ScoopInstaller/Scoop/master/schema.json",
    "version": "1.0.0",
    "description": "IaC-style Windows scheduled task management powered by task + yq + schtasks XML",
    "homepage": "https://github.com/gdm257/scoop-257",
    "license": "Unlicense",
    "url": ["https://unlicense.org/UNLICENSE"],
    "hash": "b5065838cbac452dfc855ba6e6e031481ad2c68406f70d21ead9321374653e6c",
    "depends": ["main/task", "main/yq"],
    "installer": {
        "script": [
            "Copy-Item (Join-Path $bucketsdir $bucket 'scripts\\winstctl\\Taskfile.yml') \"$dir\\Taskfile.yml\"",
            "Copy-Item (Join-Path $bucketsdir $bucket 'scripts\\winstctl\\winstctl.ps1') \"$dir\\winstctl.ps1\"",
            "Copy-Item (Join-Path $bucketsdir $bucket 'scripts\\winstctl\\template.xml') \"$dir\\template.xml\""
        ]
    },
    "bin": [["winstctl.ps1", "winstctl"]],
    "persist": ["tasks", "template.xml"]
}
