{
    "homepage": "https://github.com/aa2013/ClipShare",
    "description": "Cross-platform clipboard history and synchronization for text, images, files, and SMS.",
    "version": "1.5.5.32",
    "license": "GPL-3.0-only",
    "architecture": {
        "64bit": {
            "url": "https://github.com/aa2013/ClipShare/releases/download/v1.5.5/clipshare-1.5.5%2B32-setup.zip",
            "hash": "73f0fb268558eec0d9952acfff8cfac8dbdfa5582d95f361df6cab438f80844e"
        }
    },
    "pre_install": [
        "foreach ($name in @('clipshare.db', 'clipshare.db-journal', 'clipshare.db-wal', 'clipshare.db-shm')) { $path = Join-Path $dir $name; if (!(Test-Path -LiteralPath $path)) { New-Item -ItemType File -Path $path -Force | Out-Null } }"
    ],
    "persist": [
        "clipshare.db",
        "clipshare.db-journal",
        "clipshare.db-wal",
        "clipshare.db-shm",
        "files",
        "logs"
    ],
    "shortcuts": [
        [
            "clipshare.exe",
            "ClipShare"
        ]
    ],
    "checkver": {
        "url": "https://api.github.com/repos/aa2013/ClipShare/releases/latest",
        "jsonpath": "$..assets[*].name",
        "regex": "clipshare-(?<version>[\\d.]+)\\+(?<build>\\d+)-setup\\.zip",
        "replace": "${version}.${build}"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/aa2013/ClipShare/releases/download/v$matchVersion/clipshare-$matchVersion%2B$matchBuild-setup.zip"
            }
        }
    }
}
