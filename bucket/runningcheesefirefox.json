{
    "version": "1.3.0",
    "description": "RunningCheese Firefox 定制版便携浏览器",
    "homepage": "https://www.runningcheese.com/firefox",
    "license": "Freeware",
    "architecture": {
        "64bit": {
            "url": "https://github.com/TuringRiff/browser-pkg-test/releases/download/v1.3.0/RunningCheeseFirefox.7z",
            "hash": "acf2b553bbbbde52d5134179213331f8cc3024a5b0fa487f36a8feb6ea4bbc2f"
        }
    },
    "post_install": [
        "# 更新时 Scoop 已把新包 Profiles 备份为 Profiles.original 并链接回旧持久化数据；此处仅把新版 chrome 覆盖进旧 Profiles。",
        "if (Test-Path \"$dir\\Profiles.original\") {",
        "    if (Test-Path \"$dir\\Profiles.original\\chrome\") {",
        "        try {",
        "            if (Test-Path \"$dir\\Profiles\\chrome.new\") { Remove-Item \"$dir\\Profiles\\chrome.new\" -Recurse -Force }",
        "            Copy-Item \"$dir\\Profiles.original\\chrome\" \"$dir\\Profiles\\chrome.new\" -Recurse -Force",
        "            if (Test-Path \"$dir\\Profiles\\chrome\") { Remove-Item \"$dir\\Profiles\\chrome\" -Recurse -Force }",
        "            Move-Item \"$dir\\Profiles\\chrome.new\" \"$dir\\Profiles\\chrome\"",
        "        } catch {",
        "            warn \"替换 Profiles\\chrome 失败：$($_.Exception.Message)；请检查 $dir 下的 chrome 与 chrome.new\"",
        "        }",
        "    }",
        "    Remove-Item \"$dir\\Profiles.original\" -Recurse -Force -ErrorAction SilentlyContinue",
        "}",
        "# Tools 整目录持久化，新包中的 Tools.original 不保留。",
        "if (Test-Path \"$dir\\Tools.original\") { Remove-Item \"$dir\\Tools.original\" -Recurse -Force }"
    ],
    "shortcuts": [
        [
            "Firefox\\firefox.exe",
            "Firefox"
        ]
    ],
    "persist": [
        "Profiles",
        "Tools"
    ],
    "checkver": {
        "github": "https://github.com/TuringRiff/browser-pkg-test"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/TuringRiff/browser-pkg-test/releases/download/v$version/RunningCheeseFirefox.7z"
            }
        }
    }
}
