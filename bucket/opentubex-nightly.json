{
    "version": "0.37.4-nightly-3117",
    "description": "Private YouTube client (nightly development builds)",
    "homepage": "https://opentubex.org/",
    "license": "AGPL-3.0-or-later",
    "notes": "Nightly builds are meant for testing and may be unstable. They share settings and data with the stable opentubex package.",
    "architecture": {
        "64bit": {
            "url": "https://github.com/OpenTubeX/OpenTubeX/releases/download/v0.37.4-nightly-3117/opentubex-0.37.4-nightly-3117-win-x64-portable.zip",
            "hash": "6db9afe99e03ac2ab202ead9e57a3aa38e52a6e40c9917ce9da87dc99fa0eb88"
        },
        "arm64": {
            "url": "https://github.com/OpenTubeX/OpenTubeX/releases/download/v0.37.4-nightly-3117/opentubex-0.37.4-nightly-3117-win-arm64-portable.zip",
            "hash": "8317e9f0c978f5f622e1a6a03a7c99955f6a027fb9b74b15f97e21aa929a40f3"
        }
    },
    "pre_install": [
        "# Run as an installed app, not in portable mode.",
        "Remove-Item -LiteralPath \"$dir\\portable.marker\", \"$dir\\version.dll\", \"$dir\\.interposer\", \"$dir\\LANCommander.Interposer.LICENSE.txt\" -Recurse -Force -ErrorAction Ignore"
    ],
    "post_uninstall": [
        "# Updates keep the old version directory, so only an uninstall removes the opentubex:// link registration.",
        "$key = 'HKCU:\\Software\\Classes\\opentubex'",
        "$command = (Get-ItemProperty -LiteralPath \"$key\\shell\\open\\command\" -ErrorAction Ignore).'(default)'",
        "if (-not (Test-Path -LiteralPath $dir) -and $command -like \"*$([WildcardPattern]::Escape((Split-Path $dir)))\\*\") {",
        "    Remove-Item -LiteralPath $key -Recurse -Force",
        "}"
    ],
    "shortcuts": [
        [
            "OpenTubeX.exe",
            "OpenTubeX Nightly"
        ]
    ]
}
