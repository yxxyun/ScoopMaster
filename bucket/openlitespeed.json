{
    "version": "1.9.4-win.9",
    "description": "Native Windows build of the OpenLiteSpeed web server with PHP through LSAPI.",
    "homepage": "https://openlitespeed.dev/windows/",
    "license": "GPL-3.0-only",
    "notes": [
        "Start the server with: openlitespeed -s start",
        "PHP needs the Microsoft Visual C++ runtime. If it is missing, run once as administrator: & \"$dir\\install.ps1\" -Mode standalone -PhpOnly"
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/NeuralFoundry/openlitespeed-windows/releases/download/v1.9.4-win.9/OpenLiteSpeed-1.9.4-win64.zip",
            "hash": "00ddde585184e64ab6d729a02dfcaa4cfc907290419881ce3f1180d5fc9f4672",
            "extract_dir": "OpenLiteSpeed-1.9.4-win64"
        }
    },
    "bin": "bin\\openlitespeed.exe",
    "shortcuts": [
        [
            "bin\\olstray.exe",
            "OpenLiteSpeed"
        ]
    ],
    "persist": [
        "conf",
        "admin\\conf",
        "logs",
        "Example",
        "www",
        "data",
        "php"
    ],
    "post_install": "& \"$dir\\install.ps1\" -Mode standalone -Quiet",
    "checkver": {
        "github": "https://github.com/NeuralFoundry/openlitespeed-windows",
        "regex": "tag/v([\\d.]+-win\\.\\d+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/NeuralFoundry/openlitespeed-windows/releases/download/v$version/OpenLiteSpeed-1.9.4-win64.zip"
            }
        }
    }
}
