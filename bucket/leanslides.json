{
    "version": "0.1.0",
    "description": "Presentation (.pptx) viewer: read-only, never runs macros, never fetches what a deck links to",
    "homepage": "https://abooodbah.github.io/leanslides/",
    "license": "MIT",
    "notes": [
        "LeanSlides needs the Microsoft Edge WebView2 Runtime, which ships with Windows 11 and current Windows 10.",
        "Settings (theme, language, recent files) are kept in the registry under HKCU\\Software\\LeanSlides and the WebView2 profile under",
        "%LOCALAPPDATA%\\LeanSlides. Both live outside the Scoop folder: they survive updates and stay after uninstall."
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/abooodbah/leanslides/releases/download/v0.1.0/LeanSlides-v0.1.0-windows-x64.zip",
            "hash": "347563b778e80266b8233b78b2a2d832f4fc74740578b93d765645addc36b77c",
            "extract_dir": "LeanSlides-v0.1.0-windows-x64"
        }
    },
    "pre_install": "Remove-Item \"$dir\\installer\", \"$dir\\INSTALL.txt\" -Recurse -ErrorAction SilentlyContinue",
    "bin": [
        "LeanSlides.exe",
        [
            "tools\\leanslides-inspect.exe",
            "leanslides-inspect"
        ]
    ],
    "shortcuts": [
        [
            "LeanSlides.exe",
            "LeanSlides"
        ]
    ],
    "checkver": {
        "github": "https://github.com/abooodbah/leanslides"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/abooodbah/leanslides/releases/download/v$version/LeanSlides-v$version-windows-x64.zip",
                "extract_dir": "LeanSlides-v$version-windows-x64"
            }
        },
        "hash": {
            "url": "$url.sha256"
        }
    }
}
