    "installer": {
        "script": [
            "if ($global) { error \"Global installation is not supported for $app\"; break }",
            "$winVer = [Environment]::OSVersion.Version",
            "if (($winVer.Major -lt 10) -or ($winVer.Build -lt 19041)) { error 'At least Windows 10 2004 (build 19041) is required.'; break }",
            "if ($PSVersionTable.PSVersion.Major -ge 6) { Import-Module Appx -UseWindowsPowershell 3>$null }",
            "$ProgressPreference = 'SilentlyContinue'",
            "$xaml = Get-AppxPackage 'Microsoft.UI.Xaml.2.8' | Sort-Object { [version]$_.Version } -Descending | Select-Object -First 1",
            "if (-not $xaml -or ([version]$xaml.Version -lt [version]'8.2305.5001.0')) {",
            "    Add-AppxPackage -Path \"$dir\\xaml.appx\"",
            "}",
            "Add-AppxPackage -Path \"$dir\\intelligent-terminal.msixbundle\" -ForceApplicationShutdown -ForceUpdateFromAnyVersion",
            "Remove-Item \"$dir\\xaml.appx\", \"$dir\\intelligent-terminal.msixbundle\" -Force -ErrorAction SilentlyContinue"
        ]
    },
    "uninstaller": {
        "script": [
            "if ($PSVersionTable.PSVersion.Major -ge 6) { Import-Module Appx -UseWindowsPowershell 3>$null }",
            "$ProgressPreference = 'SilentlyContinue'",
            "Get-Process -Name 'WindowsTerminal' -ErrorAction SilentlyContinue | Where-Object { $_.Path -like '*IntelligentTerminal*' } | Stop-Process -Force -ErrorAction SilentlyContinue",
            "Get-AppxPackage 'Microsoft.IntelligentTerminal' | Remove-AppxPackage"
        ]
    },
