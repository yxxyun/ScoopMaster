{
    "version": "5.8",
    "description": "Portable edition of Vovsoft Retail Barcode.",
    "homepage": "https://vovsoft.com/software/retail-barcode/",
    "license": "Proprietary",
    "url": "https://vovsoft.com/files/retail-barcode-portable.zip?v=5.8",
    "checkver": {
        "url": "https://vovsoft.com/download/retail-barcode-portable/",
        "regex": "(?is)Version\\s*(?:<[^>]*>\\s*)*:?\\s*(?:<[^>]*>\\s*)*(?<version>\\d+(?:\\.\\d+)+)"
    },
    "autoupdate": {
        "url": "https://vovsoft.com/files/retail-barcode-portable.zip?v=$version"
    },
    "shortcuts": [
        [
            "retailbarcode.exe",
            "Vovsoft Retail Barcode"
        ]
    ],
    "notes": [
        "SHA-256 has not been verified; archive contents and the shortcut target have been checked."
    ],
    "pre_install": [
        "if (-not (Test-Path -LiteralPath \"$dir\\key.txt\" -PathType Leaf)) { New-Item -ItemType File -Path \"$dir\\key.txt\" | Out-Null }"
    ],
    "persist": "key.txt"
}
