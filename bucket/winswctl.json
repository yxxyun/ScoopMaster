{
    "$schema": "https://raw.githubusercontent.com/ScoopInstaller/Scoop/master/schema.json",
    "version": "2.14.0",
    "description": "Centralized Windows service management tool powered by winsw + task",
    "homepage": "https://github.com/winsw/winsw",
    "license": "MIT",
    "depends": "main/task",
    "architecture": {
        "64bit": {
            "url": "https://github.com/winsw/winsw/releases/download/v2.14.0/WinSW-x64.exe#/winsw.exe",
            "hash": "4ebd9dc3e817f80b2bd8c18f5bfe0d550241c1d08b57bd9694777a6e56a7b24f"
        },
        "32bit": {
            "url": "https://github.com/winsw/winsw/releases/download/v2.14.0/WinSW-x86.exe#/winsw.exe",
            "hash": "61b25f752826d1f92679d267290d7053810db6f4c03beee17491db832d7fdbfa"
        }
    },
    "installer": {
        "script": [
            "Copy-Item (Join-Path $bucketsdir $bucket 'scripts\\winswctl\\Taskfile.yml') \"$dir\\Taskfile.yml\"",
            "Copy-Item (Join-Path $bucketsdir $bucket 'scripts\\winswctl\\winswctl.ps1') \"$dir\\winswctl.ps1\"",
            "Copy-Item (Join-Path $bucketsdir $bucket 'scripts\\winswctl\\template.yml') \"$dir\\template.yml\""
        ]
    },
    "bin": [
        [
            "winswctl.ps1",
            "winswctl"
        ],
        "winsw.exe"
    ],
    "persist": [
        "shims",
        "template.yml"
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/winsw/winsw/releases/download/v$version/WinSW-x64.exe#/winsw.exe"
            },
            "32bit": {
                "url": "https://github.com/winsw/winsw/releases/download/v$version/WinSW-x86.exe#/winsw.exe"
            }
        }
    }
}
