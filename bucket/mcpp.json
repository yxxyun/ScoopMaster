{
    "version": "2026.10.16.3",
    "description": "A modern C++ module-first build tool written in pure C++23 modules.",
    "homepage": "https://github.com/mcpp-community/mcpp",
    "license": "Apache-2.0",
    "architecture": {
        "64bit": {
            "url": "https://github.com/mcpp-community/mcpp/releases/download/v2026.10.16.3/mcpp-2026.10.16.3-windows-x86_64.zip",
            "hash": "a2dcee0398dd9e349ecfd5562b7b9b0ce3c0751f4b60c005272445f10d80dae5"
        }
    },
    "extract_dir": "mcpp-2026.10.16.3-windows-x86_64",
    "pre_install": "New-Item \"$dir\\data\" -ItemType Directory -Force | Out-Null",
    "post_install": [
        "New-Item \"$persist_dir\\data\\registry\\bin\" -ItemType Directory -Force | Out-Null",
        "Copy-Item \"$dir\\registry\\bin\\xlings.exe\" \"$persist_dir\\data\\registry\\bin\\xlings.exe\" -Force"
    ],
    "bin": "bin\\mcpp.exe",
    "env_set": {
        "MCPP_HOME": "$persist_dir\\data"
    },
    "persist": "data",
    "checkver": {
        "github": "https://github.com/mcpp-community/mcpp"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/mcpp-community/mcpp/releases/download/v$version/mcpp-$version-windows-x86_64.zip"
            }
        },
        "hash": {
            "url": "$url.sha256"
        },
        "extract_dir": "mcpp-$version-windows-x86_64"
    }
}
