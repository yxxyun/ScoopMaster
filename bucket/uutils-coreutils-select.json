{
    "version": "0.12.0",
    "description": "A cross-platform Rust reimplementation of GNU coreutils (binaries compiled with MSVC), with shortcuts to only a select few commands.",
    "homepage": "https://uutils.github.io/coreutils/",
    "license": {
        "identifier": "MIT",
        "url": "https://github.com/uutils/coreutils/blob/HEAD/LICENSE"
    },
    "suggest": {
        "Microsoft Visual C++ 2015-2022 Redistributable": "extras/vcredist2022"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/uutils/coreutils/releases/download/0.12.0/coreutils-0.12.0-x86_64-pc-windows-msvc.zip",
            "hash": "45d6760c136ef42cdba1e2dbb492b0858be98099d6c7fb3e300a3adcfbc54cfe",
            "extract_dir": "coreutils-0.12.0-x86_64-pc-windows-msvc"
        }
    },
    "pre_install": "Get-ChildItem -Path $dir -File -Recurse -Exclude @('LICENSE', 'README.*', 'head.*', 'ls.*', 'printenv.*', 'tail.*', 'tr.*', 'wc.*') | Remove-Item *>$null",
    "bin": [
        "head.exe",
        "ls.exe",
        "printenv.exe",
        "tail.exe",
        "tr.exe",
        "wc.exe"
    ],
    "checkver": {
        "github": "https://github.com/uutils/coreutils"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/uutils/coreutils/releases/download/$version/coreutils-$version-x86_64-pc-windows-msvc.zip",
                "extract_dir": "coreutils-$version-x86_64-pc-windows-msvc"
            }
        }
    }
}
