{
    "version": "1.0.1-260818",
    "description": "Lightweight Windows 11 utility to view and clean up stale notification area (tray) icon records in the user registry",
    "homepage": "https://github.com/KaiZhou554/trayce",
    "license": "MIT",
    "notes": "Auto-backs up registry records before deletion, supports undo, and never touches HKLM.",
    "architecture": {
        "64bit": {
            "url": "https://github.com/KaiZhou554/trayce/releases/download/v1.0.1/trayce-v260818.exe#/trayce.exe",
            "hash": "0ada40f7336aa6d67b44b4c5b5ecda50619f77482ddb400eb721c5ab68ca96e7"
        }
    },
    "shortcuts": [
        [
            "trayce.exe",
            "Trayce"
        ]
    ],
    "pre_install": [
        "$localAppDataDir = \"$env:LOCALAPPDATA\\unieditdept\\trayce\"",
        "New-Item -Path $persist_dir -ItemType Directory -Force -ErrorAction Stop | Out-Null",
        "$existingItem = Get-Item -LiteralPath $localAppDataDir -Force -ErrorAction SilentlyContinue",
        "if ($existingItem -and ($existingItem.Attributes -band [IO.FileAttributes]::ReparsePoint)) {",
        "    if ($existingItem.LinkType -eq 'Junction' -and $existingItem.Target -eq $persist_dir) {",
        "        return",
        "    }",
        "    throw \"Cannot persist Trayce data: '$localAppDataDir' is an unsupported link or points to another directory.\"",
        "}",
        "if ($existingItem -and !$existingItem.PSIsContainer) {",
        "    throw \"Cannot persist Trayce data: '$localAppDataDir' is not a directory.\"",
        "}",
        "if ($existingItem) {",
        "    info \"Moving Trayce data from '$localAppDataDir' to '$persist_dir'...\"",
        "    Get-ChildItem -LiteralPath $localAppDataDir -Force -ErrorAction Stop | Move-Item -Destination $persist_dir -ErrorAction Stop",
        "    [IO.Directory]::Delete($localAppDataDir)",
        "}",
        "New-Item -Path (Split-Path -Parent $localAppDataDir) -ItemType Directory -Force -ErrorAction Stop | Out-Null",
        "info \"Creating Trayce data junction from '$localAppDataDir' to '$persist_dir'...\"",
        "New-Item -Path $localAppDataDir -ItemType Junction -Target $persist_dir -ErrorAction Stop | Out-Null"
    ],
    "uninstaller": {
        "script": [
            "if ($cmd -eq 'uninstall') {",
            "    $localAppDataDir = \"$env:LOCALAPPDATA\\unieditdept\\trayce\"",
            "    $existingItem = Get-Item -LiteralPath $localAppDataDir -Force -ErrorAction SilentlyContinue",
            "    if ($existingItem -and $existingItem.LinkType -eq 'Junction' -and $existingItem.Target -eq $persist_dir) {",
            "        info \"Removing Trayce data junction at '$localAppDataDir'...\"",
            "        [IO.Directory]::Delete($localAppDataDir)",
            "    }",
            "    $appDataDir = \"$env:APPDATA\\unieditdept\\trayce\"",
            "    info \"Removing Trayce application data at '$appDataDir'...\"",
            "    Remove-Item $appDataDir -Recurse -Force -ErrorAction SilentlyContinue",
            "}"
        ]
    },
    "checkver": {
        "url": "https://api.github.com/repos/KaiZhou554/trayce/releases/latest",
        "regex": "download/v([\\d.]+)/trayce-v(\\d+)\\.exe",
        "replace": "${1}-${2}"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/KaiZhou554/trayce/releases/download/v$match1/trayce-v$match2.exe#/trayce.exe"
            }
        },
        "hash": {
            "url": "https://api.github.com/repos/KaiZhou554/trayce/releases/latest",
            "jp": "$..assets[?(@.browser_download_url == '$url')].digest"
        }
    }
}
