{
    "version": "1.0.1",
    "description": "Lightweight Windows 11 utility to view and clean up stale notification area (tray) icon records in the user registry",
    "homepage": "https://github.com/KaiZhou554/trayce",
    "license": "MIT",
    "notes": "Auto-backs up registry records before deletion, supports undo, and never touches HKLM.",
    "architecture": {
        "64bit": {
            "url": "https://github.com/KaiZhou554/trayce/releases/download/v1.0.1/trayce-v260818.exe#/trayce.exe",
            "hash": "0ada40f7336aa6d67b44b4c5b5ecda50619f77482ddb400eb721c5ab68ca96e7"
        }
    },
    "shortcuts": [
        [
            "trayce.exe",
            "Trayce"
        ]
    ],
    "post_install": [
        "$junctionPath = \"$env:LOCALAPPDATA\\unieditdept\\trayce\"",
        "$exists = Test-Path $junctionPath",
        "$isJunction = $exists -and ((Get-Item $junctionPath -Force).Attributes -band [IO.FileAttributes]::ReparsePoint)",
        "if (!$isJunction) {",
        "    New-Item $persist_dir -ItemType Directory -Force | Out-Null",
        "    if ($exists) {",
        "        Move-Item \"$junctionPath\\*\" $persist_dir -Force",
        "        Remove-Item $junctionPath -Recurse -Force",
        "    }",
        "    New-Item $junctionPath -ItemType Junction -Value $persist_dir | Out-Null",
        "}"
    ],
    "uninstaller": {
        "script": [
            "if ($cmd -eq 'uninstall') {",
            "    $junctionPath = \"$env:LOCALAPPDATA\\unieditdept\\trayce\"",
            "    $webviewCache = \"$env:APPDATA\\unieditdept\\trayce\"",
            "    $isJunction = (Test-Path $junctionPath) -and ((Get-Item $junctionPath -Force).Attributes -band [IO.FileAttributes]::ReparsePoint)",
            "    if ($isJunction) {",
            "        [IO.Directory]::Delete($junctionPath)",
            "    }",
            "    Remove-Item $webviewCache -Recurse -Force -ErrorAction SilentlyContinue",
            "}"
        ]
    },
    "checkver": {
        "url": "https://api.github.com/repos/KaiZhou554/trayce/releases/latest",
        "regex": "download/v([\\d.]+)/trayce-v(\\d+)\\.exe"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/KaiZhou554/trayce/releases/download/v$match1/trayce-v$match2.exe#/trayce.exe"
            }
        },
        "hash": {
            "url": "https://api.github.com/repos/KaiZhou554/trayce/releases/latest",
            "regex": "\"name\": ?\"trayce-v[^\"]+\\.exe\".*?\"digest\": ?\"sha256:([\\da-f]{64})\""
        }
    }
}
