{
    "version": "1.2.0",
    "description": "终端镜像源管理器（km）：通过 Lua 插件一键切换 pip、npm、cargo、go、flutter 等国内镜像源，只修改托管配置块，支持自动备份、撤销与测速。",
    "homepage": "https://github.com/morning-start/keep-mirrors",
    "license": "Unknown",
    "notes": "插件目录为 %APPDATA%\\keep-mirrors\\plugins，可用 `km plugin sync` 同步最新官方插件。",
    "architecture": {
        "64bit": {
            "url": "https://github.com/morning-start/keep-mirrors/releases/download/v1.2.0/km-1.2.0-windows-amd64.zip",
            "hash": "079d04ce63ad266a6640fff88ff234947b2fb7bd7b48893548d420d783db2b1d"
        },
        "arm64": {
            "url": "https://github.com/morning-start/keep-mirrors/releases/download/v1.2.0/km-1.2.0-windows-arm64.zip",
            "hash": "d8f92e9f39bbfa569239933f3a7068c574ef7b6072aa677809ef35eb2267fcb6"
        }
    },
    "pre_install": [
        "Get-ChildItem \"$dir\" -Directory | ForEach-Object { Move-Item \"$($_.FullName)\\*\" \"$dir\" -Force }",
        "Get-ChildItem \"$dir\" -Directory | Remove-Item -Recurse -Force"
    ],
    "bin": "km.exe",
    "checkver": {
        "github": "https://github.com/morning-start/keep-mirrors",
        "regex": "v([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/morning-start/keep-mirrors/releases/download/v$version/km-$version-windows-amd64.zip"
            },
            "arm64": {
                "url": "https://github.com/morning-start/keep-mirrors/releases/download/v$version/km-$version-windows-arm64.zip"
            }
        }
    }
}
