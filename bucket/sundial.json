{
    "homepage": "https://github.com/Deide/Sundial",
    "description": "Automation based on sunrise and sunset for Windows 10+",
    "version": "1.0.1",
    "license": {
        "identifier": "MIT",
        "url": "https://github.com/Deide/Sundial/blob/master/LICENSE"
    },
    "depends": "pwsh",
    "architecture": {
        "64bit": {
            "url": "https://github.com/Deide/Sundial/archive/refs/tags/v1.0.1.zip",
            "hash": "f6dcd29e33f34d685e6d38faf7cd7bd6a2f062dee26fdce9375fab0c79a3b309",
            "extract_dir": "Sundial-1.0.1"
        }
    },
    "installer": {
        "script": "pwsh.exe",
        "args": [
            "-ExecutionPolicy Bypass",
            "-NoProfile",
            "-NonInteractive",
            "-WindowStyle Hidden",
            "-File $dir/Install-SolarSwitch.ps1"
        ]
    },
    "uninstaller": {
        "script": "pwsh.exe",
        "args": [
            "-ExecutionPolicy Bypass",
            "-NoProfile",
            "-NonInteractive",
            "-WindowStyle Hidden",
            "-File $dir/Uninstall-SolarSwitch.ps1"
        ]
    },
    "persist": "data",
    "checkver": {
        "github": "https://github.com/Deide/Sundial"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/Deide/Sundial/archive/refs/tags/v$version.zip",
                "extract_dir": "Sundial-$version"
            }
        }
    }
}
