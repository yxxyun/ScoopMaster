{
    "version": "0.4.0",
    "homepage": "https://github.com/noris-plugins-for-obs/shutdown-plugin",
    "description": "Plugin for shutting down OBS Studio through websocket API",
    "license": "GPL-2.0",
    "notes": "If you don't have any obs-studio version installed in your computer, please install one of the following below. Then uninstall this app and install it again.",
    "suggest": {
        "OBS": [
            "extras/obs-studio",
            "extras/obs-studio-small",
            "versions/obs-studio-pre"
        ]
    },
    "architecture": {
        "arm64": {
            "url": "https://github.com/noris-plugins-for-obs/shutdown-plugin/releases/download/0.4.0/shutdown-plugin-0.4.0-obs33-Windows-arm64.zip",
            "hash": "11ed3351c4408b1915481e194505bb882cc3e9534824ba77ef0963e1e3d4cd75"
        },
        "64bit": {
            "url": "https://github.com/noris-plugins-for-obs/shutdown-plugin/releases/download/0.4.0/shutdown-plugin-0.4.0-obs33-Windows-x64.zip",
            "hash": "a80425adcb31b802091203bd53133fdc4a0e3644f1b12326d003f5963f7b353e"
        }
    },
    "pre_install": [
        "'obs-studio', 'obs-studio-small', 'obs-studio-pre' | ForEach-Object {",
        "    $obs = \"$(appdir $_ $global)\"",
        "    if (Test-Path $obs) {",
        "       info \"Install for $_\"",
        "       Copy-Item \"$dir\\data\" \"$obs\\current\" -Recurse -ErrorAction SilentlyContinue",
        "       Copy-Item \"$dir\\obs-plugins\" \"$obs\\current\" -Recurse -ErrorAction SilentlyContinue",
        "   }",
        "}"
    ],
    "pre_uninstall": [
        "'obs-studio', 'obs-studio-small', 'obs-studio-pre' | ForEach-Object {",
        "    $obs = \"$(appdir $_ $global)\"",
        "    if (Test-Path $obs) {",
        "        info \"Uninstall for $_\"",
        "        Remove-Item \"$obs\\current\\data\\obs-plugins\\shutdown-plugin\" -Force -Recurse -ErrorAction SilentlyContinue",
        "        Remove-Item \"$obs\\current\\obs-plugins\\64bit\\shutdown-plugin.*\" -Force -ErrorAction SilentlyContinue",
        "    }",
        "}"
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "arm64": {
                "url": "https://github.com/noris-plugins-for-obs/shutdown-plugin/releases/download/$version/shutdown-plugin-$version-obs33-Windows-arm64.zip"
            },
            "64bit": {
                "url": "https://github.com/noris-plugins-for-obs/shutdown-plugin/releases/download/$version/shutdown-plugin-$version-obs33-Windows-x64.zip"
            }
        }
    }
}
