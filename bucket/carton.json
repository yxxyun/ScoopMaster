{
    "version": "0.6.0",
    "description": "A Windows and Linux GUI client for sing-box.",
    "homepage": "https://github.com/821869798/carton",
    "license": "GPL-3.0",
    "architecture": {
        "64bit": {
            "url": "https://github.com/821869798/carton/releases/download/v0.6.0/carton-0.6.0-win-x64-portable.zip",
            "hash": "6eeea6bfee018aae7eea887190a2ce48a4211abe55025f5f4594781513554c62"
        },
        "arm64": {
            "url": "https://github.com/821869798/carton/releases/download/v0.6.0/carton-0.6.0-win-arm64-portable.zip",
            "hash": "d619909b54641509ef751a383f2febb6a951e666a1f5a72a428af800c6591c07"
        }
    },
    "shortcuts": [
        [
            "carton.exe",
            "Carton"
        ]
    ],
    "pre_install": [
        "$portableFlag = \"$dir\\.carton_portable_data\"",
        "if (!(Test-Path \"$portableFlag\")) {",
        "    Add-Content -Path \"$portableFlag\" -Value \"true\" -NoNewline",
        "}"
    ],
    "bin": "carton.exe",
    "env_add_path": "bin",
    "persist": [
        ".carton_portable_data",
        "data",
        "bin"
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/821869798/carton/releases/download/v$version/carton-$version-win-x64-portable.zip"
            },
            "arm64": {
                "url": "https://github.com/821869798/carton/releases/download/v$version/carton-$version-win-arm64-portable.zip"
            }
        }
    }
}
