{
    "version": "1.5",
    "description": "Utility that protects configured IPv4 and IPv6 DNS addresses from being changed by other software.",
    "homepage": "https://www.sordum.org/9432/dns-lock-v1-5/",
    "license": {
        "identifier": "Freeware",
        "url": "https://www.sordum.org/eula/"
    },
    "url": "https://www.sordum.org/files/download/dns-lock/DNS-Lock.zip",
    "autoupdate": {
        "url": "https://www.sordum.org/files/download/dns-lock/DNS-Lock.zip",
        "extract_dir": "DNS-Lock"
    },
    "architecture": {
        "64bit": {
            "bin": [
                [
                    "DNS-Lock_x64.exe",
                    "SordumDNSLock"
                ]
            ],
            "shortcuts": [
                [
                    "DNS-Lock_x64.exe",
                    "Sordum - DNS Lock"
                ]
            ]
        },
        "32bit": {
            "bin": [
                [
                    "DNS-Lock.exe",
                    "SordumDNSLock"
                ]
            ],
            "shortcuts": [
                [
                    "DNS-Lock.exe",
                    "Sordum - DNS Lock"
                ]
            ]
        }
    },
    "persist": "DNS-Lock.ini",
    "checkver": {
        "url": "https://www.sordum.org/9432/dns-lock-v1-5/",
        "regex": "Dns Lock v([\\d.]+)"
    },
    "extract_dir": "DNS-Lock"
}
