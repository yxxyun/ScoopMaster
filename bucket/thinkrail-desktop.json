    "architecture": {
        "64bit": {
            "url": "https://github.com/JetBrains/thinkrail/releases/download/v0.1.2/thinkrail-desktop-windows-x64.zip",
            "hash": "f3c9a9b1df62034f314a90d564670c497090e0b6cd5623f01de7937b8df6e8d5"
        }
    },
    "installer": {
        "script": [
            "tar -xf \"$dir\\.installer\\ThinkRail-Setup.tar.zst\" -C \"$dir\"",
            "Get-ChildItem \"$dir\\ThinkRail\" | Move-Item -Destination \"$dir\" -Force",
            "Remove-Item \"$dir\\ThinkRail\", \"$dir\\.installer\", \"$dir\\ThinkRail-Setup.exe\" -Recurse -Force -ErrorAction SilentlyContinue"
        ]
    },
    "bin": [
        [
            "bin\\launcher.exe",
            "thinkrail-desktop"
        ]
    ],
    "shortcuts": [
        [
            "bin\\launcher.exe",
            "ThinkRail"
        ]
    ],
    "checkver": {
        "github": "https://github.com/JetBrains/thinkrail"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/JetBrains/thinkrail/releases/download/v$version/thinkrail-desktop-windows-x64.zip"
            }
        },
        "hash": {
            "url": "$baseurl/SHA256SUMS"
        }
    }
}
