                "hash": {
                    "mode": "json",
                    "url": "https://api.github.com/repos/ch1y1z1/jianshan/releases/tags/v$version",
                    "jp": "$.assets[?(@.name == 'jianshan-setup-$version-amd64.exe')].digest"
                }
            }
        }
