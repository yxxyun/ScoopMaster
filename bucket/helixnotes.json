{
    "version": "1.3.6",
    "description": "Local Markdown note-taking app with rich editing, tasks, graph view, and version history.",
    "homepage": "https://helixnotes.com/",
    "license": "AGPL-3.0",
    "url": "https://download.helixnotes.com/releases/v1.3.6/HelixNotes_1.3.6_x64-setup.exe",
    "installer": {
        "args": [
            "/S",
            "/D=$dir"
        ]
    },
    "bin": "HelixNotes.exe",
    "shortcuts": [
        [
            "HelixNotes.exe",
            "HelixNotes"
        ]
    ],
    "checkver": {
        "url": "https://gitlab.com/api/v4/projects/ArkHost%2FHelixNotes/releases/permalink/latest",
        "regex": "\"tag_name\":\"v([0-9.]+)\""
    },
    "autoupdate": {
        "url": "https://download.helixnotes.com/releases/v$version/HelixNotes_$version_x64-setup.exe"
    }
}
