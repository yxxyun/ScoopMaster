{
    "$schema": "https://raw.githubusercontent.com/ScoopInstaller/Scoop/master/schema.json",
    "version": "1.5.8",
    "description": "Capture, annotate, extract text, and record your screen. Turn a moment into something worth sharing",
    "homepage": "https://github.com/mg-chao/snow-shot",
    "license": "GPL-3.0-or-later",
    "architecture": {
        "64bit": {
            "url": "https://github.com/mg-chao/snow-shot/releases/download/v1.5.8_snow-shot/snow-shot-1.5.8-windows-x64-portable.zip",
            "hash": "sha256:1f8f50a1ca9aceb76e1a5312cb0275c7f755ef8cb296b45c5ff1b651859ccb93"
        }
    },
    "extract_dir": "bin",
    "bin": [
        "snow_shot.exe",
        [
            "snow_shot.exe",
            "snowshot"
        ],
        [
            "snow_shot.exe",
            "snow-shot"
        ],
        [
            "snow_shot.exe",
            "snow-shot-editor",
            "--edit-with-snow-shot"
        ],
        "snow-shot-mcp.exe"
    ],
    "shortcuts": [
        [
            "snow_shot.exe",
            "Snow Shot"
        ]
    ],
    "persist": "portable",
    "checkver": {
        "github": "https://github.com/mg-chao/snow-shot",
        "regex": "v([\\d.]+(?:-beta\\d*)?)_snow-shot(?!-)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/mg-chao/snow-shot/releases/download/v$versioin_snow-shot/snow-shot-$version-windows-x64-portable.zip"
            }
        }
    }
}
