{
    "$schema": "https://raw.githubusercontent.com/ScoopInstaller/Scoop/master/schema.json",
    "version": "0.13.2",
    "description": "One Hub All LLMs For You | 为个人打造的 LLM API 聚合网关",
    "homepage": "https://github.com/bestruirui/octopus",
    "license": "AGPL-3.0-or-later",
    "architecture": {
        "64bit": {
            "url": "https://github.com/bestruirui/octopus/releases/download/v0.13.2/octopus-windows-amd64.zip",
            "hash": "f635c6b4c1369400c9d201fd43b1b327b777c17563944b4dbf7e8efd5ae4a0bc"
        }
    },
    "installer": {
        "script": "Copy-Item -Path (Join-Path $bucketsdir $bucket 'scripts\\command-wrapper\\command-wrapper.cmd') -Destination (Join-Path $dir 'command-wrapper.cmd') -Force"
    },
    "bin": [
        [
            "command-wrapper.cmd",
            "octopus",
            "octopus.exe --workdir ."
        ]
    ],
    "persist": "data",
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/bestruirui/octopus/releases/download/v$version/octopus-windows-amd64.zip"
            }
        }
    }
}
