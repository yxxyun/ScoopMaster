{
    "version": "4.47.1.5286",
    "description": "NetEase UU Remote (网易UU远程) - remote desktop access and control tool.",
    "homepage": "https://uuyc.163.com/",
    "license": "Freeware",
    "notes": [
        "The app is installed by the vendor NSIS installer into 'C:\\Program Files\\Netease\\GameViewer' and registers the GameViewerService system service.",
        "The app UI requires the Microsoft Edge WebView2 Runtime."
    ],
    "url": "https://api.nrd.nie.163.com/api/v1/release/dl/1?channel=gwqd#/UURemote_Setup.exe",
    "hash": "e095939fc410e7a092b2ccc7b0350cdd8db6ab61f02e215fcb47bd4c8ec3b8bd",
    "installer": {
        "script": [
            "if (!(is_admin)) {",
            "    error 'Administrator rights are required to install $app.'",
            "    break",
            "}",
            "",
            "Start-Process \"$dir\\UURemote_Setup.exe\" -ArgumentList '/S' -Wait",
            "",
            "# the postinstall script automatically launches the app",
            "Start-Sleep -Seconds 2",
            "Get-Process | Where-Object { $_.name -match '^GameViewer' } | ForEach-Object { Stop-Process -Id $_.Id -Force }"
        ]
    },
    "uninstaller": {
        "script": [
            "if (!(is_admin)) {",
            "    error 'Administrator rights are required to uninstall $app.'",
            "    break",
            "}",
            "",
            "Stop-Process -Name 'GameViewer*' -Force -ErrorAction SilentlyContinue",
            "Start-Process \"$env:ProgramFiles\\Netease\\GameViewer\\Uninstall.exe\" -ArgumentList '/S' -Wait"
        ]
    },
    "checkver": {
        "script": [
            "$req = [System.Net.HttpWebRequest]::Create('https://api.nrd.nie.163.com/api/v1/release/dl/1?channel=gwqd')",
            "$req.AllowAutoRedirect = $false",
            "$req.Timeout = 30000",
            "$resp = $req.GetResponse()",
            "$loc = $resp.Headers['Location']",
            "$resp.Close()",
            "Write-Output $loc"
        ],
        "regex": "UURemote_Setup_([\\d.]+)_"
    },
    "autoupdate": {
        "url": "https://api.nrd.nie.163.com/api/v1/release/dl/1?channel=gwqd#/UURemote_Setup.exe"
    }
}
