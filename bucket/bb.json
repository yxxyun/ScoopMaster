{
  "version": "6.0.0",
  "description": "A CLI for Bitbucket Data Center",
  "homepage": "https://github.com/vriesdemichael/bitbucket-data-center-cli",
  "license": "Apache-2.0",
  "architecture": {
    "64bit": {
      "url": "https://github.com/vriesdemichael/bitbucket-data-center-cli/releases/download/v6.0.0/bb_6.0.0_windows_amd64_noupdate.zip",
      "hash": "fd0730fb7e881177f6e65b9b4626f7f50588a5abc41a1c2ca5b631485ba039d0"
    },
    "arm64": {
      "url": "https://github.com/vriesdemichael/bitbucket-data-center-cli/releases/download/v6.0.0/bb_6.0.0_windows_arm64_noupdate.zip",
      "hash": "d8f9984406ad82c68d215700027e4d4454d0f60910aec6ee4efa1264facd9880"
    }
  },
  "bin": "bb.exe",
  "post_install": [
    "function Invoke-Bb {",
    "    try { & \"$dir\\bb.exe\" @args; $ok = $LASTEXITCODE -eq 0 } catch { Write-Host $_ -ForegroundColor Red; $ok = $false }",
    "    if (-not $ok) { Write-Host \"bb $args did not succeed, and Scoop carries on without it; run it yourself once the reason is dealt with.\" -ForegroundColor Yellow }",
    "}",
    "Write-Host ''",
    "if ($global) {",
    "    Invoke-Bb completion install --shell powershell --all-users",
    "} else {",
    "    Invoke-Bb completion install --shell powershell",
    "    Invoke-Bb ai skill install --global",
    "}"
  ],
  "pre_uninstall": [
    "function Invoke-Bb {",
    "    try { & \"$dir\\bb.exe\" @args; $ok = $LASTEXITCODE -eq 0 } catch { Write-Host $_ -ForegroundColor Red; $ok = $false }",
    "    if (-not $ok) { Write-Host \"bb $args did not succeed, and Scoop carries on without it; run it yourself once the reason is dealt with.\" -ForegroundColor Yellow }",
    "}",
    "Write-Host ''",
    "if ($global) {",
    "    Invoke-Bb completion remove --shell powershell --all-users --yes",
    "} else {",
    "    Invoke-Bb completion remove --shell powershell --yes",
    "    Invoke-Bb ai skill remove --global --yes",
    "}"
  ],
  "notes": [
    "PowerShell completion and the bb agent skill for coding agents are set up, and scoop uninstall bb takes them out again.",
    "To take them out and keep bb: bb completion remove --shell powershell --yes, and bb ai skill remove --global --yes.",
    "Installed with --global, completion is set up for every user instead (bb completion remove --shell powershell --all-users --yes takes it out), and each user who wants the skill runs bb ai skill install --global."
  ],
  "checkver": {
    "github": "https://github.com/vriesdemichael/bitbucket-data-center-cli"
  },
  "autoupdate": {
    "architecture": {
      "64bit": {
        "url": "https://github.com/vriesdemichael/bitbucket-data-center-cli/releases/download/v$version/bb_$version_windows_amd64_noupdate.zip"
      },
      "arm64": {
        "url": "https://github.com/vriesdemichael/bitbucket-data-center-cli/releases/download/v$version/bb_$version_windows_arm64_noupdate.zip"
      }
    }
  }
}
