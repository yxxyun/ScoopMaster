{
    "version": "3.1.1029",
    "description": "Portable Windows utility for reviewing, removing, and restoring built-in and third-party apps.",
    "homepage": "https://www.oo-software.com/en/ooappbuster",
    "license": "Freeware",
    "url": "https://dl5.oo-software.com/files/ooappbuster/OOAPB.exe",
    "hash": "A916AE3FF406BEDD6D5B762D3D6DE0A64FDB02F505B750B822409DA63DF15F8F",
    "shortcuts": [
        [
            "OOAPB.exe",
            "O&O AppBuster"
        ]
    ],
    "checkver": {
        "script": [
            "$ErrorActionPreference = 'Stop'",
            "$ProgressPreference = 'SilentlyContinue'",
            "$html = (Invoke-WebRequest -Uri 'https://www.oo-software.com/en/support/productreleases' -UseBasicParsing).Content",
            "$rows = [regex]::Matches($html, '(?is)<tr\\b[^>]*>.*?</tr>')",
            "$version = $null",
            "foreach ($row in $rows) {",
            "    $text = [System.Net.WebUtility]::HtmlDecode([regex]::Replace($row.Value, '<[^>]+>', ' '))",
            "    $text = [regex]::Replace($text, '\\s+', ' ').Trim()",
            "    if ($text -match '(?i)O&O AppBuster\\s+(?<version>\\d+(?:\\.\\d+){1,3})\\b') {",
            "        $version = $Matches['version']",
            "        break",
            "    }",
            "}",
            "if (-not $version) { throw 'Unable to detect the O&O AppBuster version on the official O&O product releases page.' }",
            "$version"
        ],
        "regex": "(?<version>\\d+(?:\\.\\d+){1,3})"
    },
    "autoupdate": {
        "url": "https://dl5.oo-software.com/files/ooappbuster/OOAPB.exe"
    },
    "notes": "Removing apps for all users or the entire PC requires administrator rights. Create a system restore point before removing system-related apps."
}
