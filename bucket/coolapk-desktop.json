{
    "version": "1.31.0",
    "description": "酷安第三方跨平台桌面客户端，支持动态、图文、评论、私信与登录态同步",
    "homepage": "https://github.com/daimiaopeng/coolapk-desktop",
    "license": "MIT",
    "notes": [
        "账号与偏好（accounts.json、settings.json、search_history.json、startup_state.json）位于 %APPDATA%\\com.coolapk.desktop，本包用目录级联接点托管到 persist\\coolapk-desktop\\roaming",
        "WebView2 数据、缓存与日志（EBWebView、CoolapkDesktopCache、logs）位于 %LOCALAPPDATA%\\com.coolapk.desktop，同样托管到 persist\\coolapk-desktop\\local",
        "两个目录名都取自应用的 Tauri identifier（com.coolapk.desktop），不是显示名“酷安”",
        "本包使用上游 x64 单文件便携版，无需安装；运行所需文件全部内嵌在该 exe 中",
        "应用内的自动更新会绕过 Scoop，升级请使用 scoop update coolapk-desktop"
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/daimiaopeng/coolapk-desktop/releases/download/v1.31.0/coolapk-desktop_1.31.0_x64-portable.exe#/coolapk-desktop.exe",
            "hash": "0c7562e5a1754de3e0a622cbc70aa90394ab4815f7ff049190e6e9cc8af1493a"
        }
    },
    "shortcuts": [
        [
            "coolapk-desktop.exe",
            "酷安"
        ]
    ],
    "post_install": [
        "$createJunction = {",
        "    param($source, $name)",
        "    $target = Join-Path $persist_dir $name",
        "    ensure $target",
        "",
        "    if (Test-Path $source) {",
        "        $item = Get-Item -LiteralPath $source -Force",
        "        if ($item.Attributes -band [IO.FileAttributes]::ReparsePoint) {",
        "            Write-Host \"检测到已存在的联接点：$source，跳过创建\"",
        "            return",
        "        }",
        "        if (-not $item.PSIsContainer) {",
        "            throw \"数据路径已存在且不是目录：$source\"",
        "        }",
        "",
        "        & robocopy $source $target /E /R:1 /W:1 /NFL /NDL /NJH /NJS /NP | Out-Null",
        "        if ($LASTEXITCODE -gt 7) {",
        "            Write-Host \"迁移失败，保留原目录：$source\"",
        "            return",
        "        }",
        "",
        "        $backup = \"$source.backup-$(Get-Date -Format 'yyyyMMdd-HHmmss')\"",
        "        try {",
        "            Move-Item -LiteralPath $source -Destination $backup -Force",
        "            Write-Host \"已备份原数据目录：$backup\"",
        "        } catch {",
        "            Write-Host \"无法重命名原目录：$source\"",
        "            return",
        "        }",
        "    }",
        "",
        "    New-Item -Path $source -ItemType Junction -Value $target | Out-Null",
        "}",
        "& $createJunction (Join-Path $env:APPDATA 'com.coolapk.desktop') 'roaming'",
        "& $createJunction (Join-Path $env:LOCALAPPDATA 'com.coolapk.desktop') 'local'"
    ],
    "post_uninstall": [
        "$removeJunction = {",
        "    param($source)",
        "    if (Test-Path -LiteralPath $source) {",
        "        $item = Get-Item -LiteralPath $source -Force",
        "        if ($item.Attributes -band [IO.FileAttributes]::ReparsePoint) {",
        "            Remove-Item -LiteralPath $source -Force",
        "        }",
        "    }",
        "}",
        "& $removeJunction (Join-Path $env:APPDATA 'com.coolapk.desktop')",
        "& $removeJunction (Join-Path $env:LOCALAPPDATA 'com.coolapk.desktop')"
    ],
    "checkver": {
        "github": "https://github.com/daimiaopeng/coolapk-desktop"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/daimiaopeng/coolapk-desktop/releases/download/v$version/coolapk-desktop_$version_x64-portable.exe#/coolapk-desktop.exe"
            }
        },
        "hash": {
            "mode": "download"
        }
    }
}
