{
    "version": "0.5.6",
    "description": "Internet access is a right, not a privilege. Terminal client and VPN service.",
    "homepage": "https://github.com/openrung/openrung",
    "license": "GPL-3.0-only",
    "architecture": {
        "64bit": {
            "url": "https://github.com/openrung/openrung/releases/download/client-v0.5.6/openrung-client-windows-amd64.zip",
            "hash": "a848192ec84e1cf33a6b9a9146be7ccbbd69cb2410b7d8ba7adb528141727d4e",
            "extract_dir": "openrung-client-windows-amd64"
        }
    },
    "bin": [
        "openrung-client.exe",
        [
            "openrung-client.exe",
            "openrung"
        ]
    ],
    "shortcuts": [
        [
            "openrung-client.exe",
            "OpenRung"
        ]
    ],
    "post_install": [
        "if (!(Test-Path \"$persist_dir\")) { New-Item -ItemType Directory -Path \"$persist_dir\" | Out-Null }",
        "if (Test-Path \"$env:AppData\\openrung\") {",
        "    if ((Get-Item \"$env:AppData\\openrung\").LinkType -ne 'Junction') {",
        "        Copy-Item \"$env:AppData\\openrung\\*\" \"$persist_dir\" -Recurse -Force -ErrorAction SilentlyContinue",
        "        Remove-Item \"$env:AppData\\openrung\" -Recurse -Force",
        "    }",
        "}",
        "if (!(Test-Path \"$env:AppData\\openrung\")) {",
        "    New-DirectoryJunction \"$env:AppData\\openrung\" \"$persist_dir\" | Out-Null",
        "}"
    ],
    "pre_uninstall": [
        "$data = Get-Item \"$env:AppData\\openrung\" -ErrorAction SilentlyContinue",
        "if ($data -and $data.LinkType -eq 'Junction') { $data.Delete() }"
    ],
    "checkver": {
        "github": "https://github.com/openrung/openrung",
        "regex": "client-v([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/openrung/openrung/releases/download/client-v$version/openrung-client-windows-amd64.zip"
            }
        }
    }
}
