{
    "version": "0.2.1",
    "description": "Native desktop manager for local AI agent skills and sessions.",
    "homepage": "https://github.com/Maidang1/knack",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/Maidang1/knack/releases/download/v0.2.1/knack-setup-0.2.1-amd64.exe",
            "hash": "ab8674f135c73fc724f319f4c182344e9a42059ef2f28e5f20ba48ce61a557b8"
        },
        "arm64": {
            "url": "https://github.com/Maidang1/knack/releases/download/v0.2.1/knack-setup-0.2.1-arm64.exe",
            "hash": "aac67c7f47ad2de3b011069f145138982f2969dafe76bbbd04a233c010997f3c"
        }
    },
    "##": "Installer Type: NSIS",
    "installer": {
        "args": [
            "/S",
            "/D=$dir"
        ]
    },
    "uninstaller": {
        "script": [
            "if ($cmd -ne 'update') {",
            "    $uninstaller = Join-Path $dir 'Uninstall.exe'",
            "    if (-not (Test-Path -LiteralPath $uninstaller -PathType Leaf)) { throw 'Knack NSIS uninstaller was not found in the Scoop version directory.' }",
            "    $uninstallArgs = @('/S', ('\"' + '_?=' + $dir + '\"'))",
            "    $process = Start-Process -FilePath $uninstaller -ArgumentList $uninstallArgs -Wait -PassThru -ErrorAction Stop",
            "    if ($process.ExitCode -ne 0) { throw \"Knack NSIS uninstaller exited with code $($process.ExitCode).\" }",
            "}"
        ]
    },
    "bin": "Knack.exe",
    "shortcuts": [
        [
            "Knack.exe",
            "Knack"
        ]
    ],
    "checkver": {
        "github": "https://github.com/Maidang1/knack"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/Maidang1/knack/releases/download/v$version/knack-setup-$version-amd64.exe",
                "hash": {
                    "mode": "json",
                    "url": "https://api.github.com/repos/Maidang1/knack/releases/tags/v$version",
                    "jp": "$.assets[?(@.name == 'knack-setup-$version-amd64.exe')].digest"
                }
            },
            "arm64": {
                "url": "https://github.com/Maidang1/knack/releases/download/v$version/knack-setup-$version-arm64.exe",
                "hash": {
                    "mode": "json",
                    "url": "https://api.github.com/repos/Maidang1/knack/releases/tags/v$version",
                    "jp": "$.assets[?(@.name == 'knack-setup-$version-arm64.exe')].digest"
                }
            }
        }
    },
    "notes": "Creating skill symlinks on Windows requires Developer Mode or an elevated session."
}
