{
    "version": "0.1.1",
    "description": "Desktop tools for Windows and Linux X11.",
    "homepage": "https://github.com/scillidan/desktop-tools-rs",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/scillidan/desktop-tools-rs/releases/download/v0.1.1/desktop-tools-rs-v0.1.1-win64.zip",
            "hash": "5e7ab5a0ac752655dd9d467de75d652075e03aa67cd7fb0913f42a29c3571d51"
        }
    },
    "pre_install": [
        "if (Test-Path \"$dir\\desktop-tools-rs.exe\") { Rename-Item \"$dir\\desktop-tools-rs.exe\" desktop-tools-rs.exe }",
        "if (Test-Path \"$dir\\window-tools.toml\") { Rename-Item \"$dir\\window-tools.toml\" desktop-tools.toml }"
    ],
    "bin": "desktop-tools-rs.exe",
    "shortcuts": [
        [
            "desktop-tools-rs.exe",
            "Desktop Tools"
        ]
    ],
    "persist": [
        "desktop-tools.toml",
        "resize.toml"
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/scillidan/desktop-tools-rs/releases/download/v$version/desktop-tools-rs-v$version-win64.zip",
                "hash": {
                    "url": "$url.sha256"
                }
            }
        }
    }
}
