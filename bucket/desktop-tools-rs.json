{
    "version": "0.1.0",
    "description": "Hotkey desktop tools for Windows and Linux X11.",
    "homepage": "https://github.com/scillidan/window-tools-rs",
    "license": "MIT",
    "notes": [
        "Config: desktop-tools.toml and resize.toml live next to the exe and are kept across updates.",
        "Start with Windows, suspend/resume and quit are in the tray menu."
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/scillidan/window-tools-rs/releases/download/v0.1.0/window-tools-rs-v0.1.0-win64.zip",
            "hash": "542fe017f43ff307e10d10d488f7953bc6ca04dce6bc34d57bdff5950d12f8b8"
        }
    },
    "pre_install": [
        "if (Test-Path \"$dir\\window-tools-rs.exe\") { Rename-Item \"$dir\\window-tools-rs.exe\" desktop-tools-rs.exe }",
        "if (Test-Path \"$dir\\window-tools.toml\") { Rename-Item \"$dir\\window-tools.toml\" desktop-tools.toml }"
    ],
    "bin": "desktop-tools-rs.exe",
    "shortcuts": [
        [
            "desktop-tools-rs.exe",
            "Desktop Tools"
        ]
    ],
    "persist": [
        "desktop-tools.toml",
        "resize.toml"
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/scillidan/window-tools-rs/releases/download/v$version/desktop-tools-rs-v$version-win64.zip",
                "hash": {
                    "url": "$url.sha256"
                }
            }
        }
    }
}
