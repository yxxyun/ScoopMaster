{
    "version": "1.38.1",
    "description": "Usage meters for AI subscriptions and API plans (Claude, Codex, Copilot, Cursor, SuperGrok, Antigravity, ...) as a Windows tray popover, a TUI and a CLI",
    "homepage": "https://github.com/akitaonrails/ai-usagebar",
    "license": "MIT",
    "notes": [
        "Start the tray with 'ai-usagebar-tray' or the Start Menu shortcut 'AI Usage', then turn on 'Start with Windows' from its menu.",
        "Update with 'scoop update ai-usagebar'. The tray's own updater can stay on Notify (the default); let Scoop do the install."
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/akitaonrails/ai-usagebar/releases/download/v1.38.1/ai-usagebar-windows-x86_64.zip",
            "hash": "3692ad9a84ca030591dafff85af73de34d47eb0ba0a6ff5dfc7e7bf6d4dd2e4f"
        }
    },
    "bin": [
        "ai-usagebar.exe",
        "ai-usagebar-tui.exe",
        "ai-usagebar-tray.exe"
    ],
    "shortcuts": [
        [
            "ai-usagebar-tray.exe",
            "AI Usage"
        ]
    ],
    "pre_uninstall": [
        "$root = Split-Path $dir",
        "Get-Process -Name 'ai-usagebar-tray' -ErrorAction SilentlyContinue | Where-Object { $_.Path -like \"$root\\*\" } | Stop-Process -Force -ErrorAction SilentlyContinue"
    ],
    "post_uninstall": [
        "$root = Split-Path $dir",
        "$run = 'HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Run'",
        "$value = (Get-ItemProperty -Path $run -Name 'ai-usagebar-tray' -ErrorAction SilentlyContinue).'ai-usagebar-tray'",
        "if ($value -and $value -like \"*$root*\") { Remove-ItemProperty -Path $run -Name 'ai-usagebar-tray' -ErrorAction SilentlyContinue }",
        "Get-ChildItem 'HKCU:\\Control Panel\\NotifyIconSettings' -ErrorAction SilentlyContinue | ForEach-Object { $icon = Get-ItemProperty $_.PSPath; if ($icon.ExecutablePath -like \"$root\\*\") { Remove-Item $_.PSPath -Recurse -Force -ErrorAction SilentlyContinue } }"
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/akitaonrails/ai-usagebar/releases/download/v$version/ai-usagebar-windows-x86_64.zip"
            }
        },
        "hash": {
            "url": "$url.sha256"
        }
    }
}
