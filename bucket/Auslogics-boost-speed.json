    "bin": "BoostSpeed.exe",
    "shortcuts": [
        [
            "BoostSpeed.exe",
            "Auslogics BoostSpeed"
        ]
    ],
    "checkver": {
        "script": [
            "$html = (Invoke-WebRequest -Uri 'https://www.auslogics.com/en/software/boost-speed/' -UseBasicParsing).Content",
            "$text = [System.Net.WebUtility]::HtmlDecode([regex]::Replace($html, '<[^>]+>', ' '))",
            "$text = [regex]::Replace($text, '\\s+', ' ')",
            "$match = [regex]::Match($text, '(?i)Version\\s+(?<version>\\d+(?:\\.\\d+){3})')",
            "if (-not $match.Success) { throw 'Unable to detect Auslogics BoostSpeed version from the official product page.' }",
            "$match.Groups['version'].Value"
        ],
        "regex": "(?<version>\\d+(?:\\.\\d+){3})"
    },
    "autoupdate": {
        "url": "https://downloads.auslogics.com/en/boost-speed/auslogics-boost-speed-setup.exe"
    },
    "notes": [
        "Scoop extracts the official Inno Setup application payload into the app directory; it does not run the setup program.",
