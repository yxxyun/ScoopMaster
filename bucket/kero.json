{
    "version": "2.1.31",
    "description": "A terminal for coding agents, with sessions that keep running after you quit.",
    "homepage": "https://kero.sh/",
    "license": "MIT",
    "notes": [
        "Kero can update itself. Turn off automatic updates in Settings > Updates and run 'scoop update kero' instead.",
        "Quit Kero and stop its background service ('kero daemon stop') before updating."
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/egoist/kero/releases/download/v2.1.31/kero-2.1.31-windows-amd64.tar.gz",
            "hash": "a4e69cd7d130c96bb048a58eedbffb1f7f241b90cf8e8052faa374a95d99cffd"
        },
        "arm64": {
            "url": "https://github.com/egoist/kero/releases/download/v2.1.31/kero-2.1.31-windows-arm64.tar.gz",
            "hash": "9a2be127b04934d84e279169f491afb4dbbb65b99958ef3e62f45fef98de2214"
        }
    },
    "installer": {
        "script": [
            "# Kero.exe is a GUI executable, so shells neither wait for it nor show its output.",
            "# Like Kero's own 'Install Command Line Tool', make a console copy of it for the 'kero' command.",
            "$bytes = [IO.File]::ReadAllBytes(\"$dir\\Kero.exe\")",
            "$subsystem = [BitConverter]::ToInt32($bytes, 0x3c) + 92",
            "if ($bytes[$subsystem] -eq 2) { $bytes[$subsystem] = 3 }",
            "[IO.File]::WriteAllBytes(\"$dir\\kero-cli.exe\", $bytes)"
        ]
    },
    "bin": [
        [
            "kero-cli.exe",
            "kero"
        ]
    ],
    "shortcuts": [
        [
            "Kero.exe",
            "Kero"
        ]
    ],
    "checkver": {
        "github": "https://github.com/egoist/kero"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/egoist/kero/releases/download/v$version/kero-$version-windows-amd64.tar.gz"
            },
            "arm64": {
                "url": "https://github.com/egoist/kero/releases/download/v$version/kero-$version-windows-arm64.tar.gz"
            }
        }
    }
}
