    "license": "MIT",
    "architecture": {
        "32bit": {
            "url": "https://github.com/winsiderss/si-builds/releases/download/4.0.26253.624/systeminformer-build-win32-bin.zip",
            "hash": "819cfcb6ac9ce863eb493d38c77e2b070207a419d37273b56befef545fb73199"
        },
        "64bit": {
            "url": "https://github.com/winsiderss/si-builds/releases/download/4.0.26253.624/systeminformer-build-win64-bin.zip",
            "hash": "99436feaef63b48033591bf00a1d333caf2de9c8b45ab90ef9f69b8480321f93"
        },
        "arm64": {
            "url": "https://github.com/winsiderss/si-builds/releases/download/4.0.26253.624/systeminformer-build-arm64-bin.zip",
            "hash": "1c2c2a112b4531ae9e017b3ba51ed64b93bb958dd9c1cabe4d4a3713a31c6f4e"
        }
    },
    "pre_install": [
        "'SystemInformer.exe.settings.json', 'peview.exe.settings.json', 'usernotesdb.json' | ForEach-Object {",
        "    if (Test-Path \"$persist_dir\\$_\") {",
        "        Copy-Item \"$persist_dir\\$_\" \"$dir\\$_\"",
        "    } else {",
        "        Set-Content \"$dir\\$_\" -Value \"{}\" | Out-Null",
        "    }",
        "}",
        "if (-not (Test-Path \"$persist_dir\\scan.db\")) {",
        "    New-Item \"$dir\\scan.db\" | Out-Null",
        "}"
    ],
    "bin": "peview.exe",
    "shortcuts": [
        [
            "SystemInformer.exe",
            "System Informer"
        ],
        [
            "peview.exe",
            "PE Viewer"
        ]
    ],
    "persist": "scan.db",
    "pre_uninstall": [
        "ensure $persist_dir",
        "'SystemInformer.exe.settings.json', 'peview.exe.settings.json', 'usernotesdb.json' | ForEach-Object {",
        "    Copy-Item \"$dir\\$_\" \"$persist_dir\\$_\"",
        "}"
    ],
    "checkver": {
        "github": "https://github.com/winsiderss/si-builds"
    },
    "autoupdate": {
        "architecture": {
            "32bit": {
                "url": "https://github.com/winsiderss/si-builds/releases/download/$version/systeminformer-build-win32-bin.zip"
            },
            "64bit": {
                "url": "https://github.com/winsiderss/si-builds/releases/download/$version/systeminformer-build-win64-bin.zip"
            },
            "arm64": {
                "url": "https://github.com/winsiderss/si-builds/releases/download/$version/systeminformer-build-arm64-bin.zip"
            }
        }
    }
}
