{
    "version": "5.2.0.6",
    "description": "Windows cleanup and disk space management utility",
    "homepage": "https://www.auslogics.com/en/software/windows-slimmer/",
    "license": "Proprietary",
    "url": "https://downloads.auslogics.com/en/windows-slimmer/auslogics-windows-slimmer-setup.exe",
    "hash": "7D272E536DFB41F0619A3702863560C69468C4AD53C418F81D320D22C5AC18DD",
    "innosetup": true,
    "bin": "WindowsSlimmer.exe",
    "shortcuts": [
        [
            "WindowsSlimmer.exe",
            "Auslogics Windows Slimmer"
        ]
    ],
    "checkver": {
        "script": [
            "$html = (Invoke-WebRequest -Uri 'https://www.auslogics.com/en/software/windows-slimmer/' -UseBasicParsing).Content",
            "$text = [System.Net.WebUtility]::HtmlDecode([regex]::Replace($html, '<[^>]+>', ' '))",
            "$text = [regex]::Replace($text, '\\s+', ' ')",
            "$match = [regex]::Match($text, '(?i)Version\\s+(?<version>\\d+(?:\\.\\d+){3})')",
            "if (-not $match.Success) { throw 'Unable to detect Auslogics Windows Slimmer version from the official product page.' }",
            "$match.Groups['version'].Value"
        ],
        "regex": "(?<version>\\d+(?:\\.\\d+){3})"
    },
    "autoupdate": {
        "url": "https://downloads.auslogics.com/en/windows-slimmer/auslogics-windows-slimmer-setup.exe"
    },
    "notes": [
        "Scoop extracts the official Inno Setup application payload into the app directory; it does not run the setup program.",
        "This extracts the application's installed files but does not guarantee the vendor's own portable mode or suppress any runtime requirements."
    ]
}
