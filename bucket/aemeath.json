{
    "version": "0.0.4",
    "description": "Native Windows desktop monitor for CPU, memory, disk, network, temperature, and GPU telemetry.",
    "homepage": "https://github.com/foliageSea/Aemeath",
    "license": "Unknown",
    "architecture": {
        "64bit": {
            "url": "https://github.com/foliageSea/Aemeath/releases/download/v0.0.4/Aemeath-Agent-0.0.4-windows-x64-setup.exe",
            "hash": "bfb6a9e5148996a5bd236fc1947de17b53ca77c89eb28b7ccea6484c613d0d02"
        }
    },
    "installer": {
        "args": [
            "/S",
            "/D=$dir"
        ]
    },
    "uninstaller": {
        "script": [
            "$uninstaller = Get-ChildItem -LiteralPath $dir -File -Recurse -ErrorAction SilentlyContinue | Where-Object { $_.Name -match '(?i)^(unins\\d*|uninstall.*)\\.exe$' } | Select-Object -First 1",
            "if (-not $uninstaller) { throw 'The application uninstaller was not found in the Scoop version directory.' }",
            "$process = Start-Process -FilePath $uninstaller.FullName -ArgumentList '/S' -WorkingDirectory $uninstaller.DirectoryName -Wait -PassThru",
            "if ($process.ExitCode -ne 0) { throw ('The application uninstaller exited with code {0}.' -f $process.ExitCode) }"
        ]
    },
    "bin": "Aemeath.exe",
    "shortcuts": [
        [
            "Aemeath.exe",
            "Aemeath"
        ]
    ],
    "checkver": {
        "github": "https://github.com/foliageSea/Aemeath"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/foliageSea/Aemeath/releases/download/v$version/Aemeath-Agent-$version-windows-x64-setup.exe",
                "hash": {
                    "mode": "json",
                    "url": "https://api.github.com/repos/foliageSea/Aemeath/releases/tags/v$version",
                    "jp": "$.assets[?(@.name == 'Aemeath-Agent-$version-windows-x64-setup.exe')].digest"
                }
            }
        }
    }
}
