{
    "version": "10.0.5.825",
    "description": "Lightweight and versatile image viewer",
    "homepage": "https://imageglass.org",
    "license": "GPL-3.0-only",
    "notes": [
        "To associate image formats with ImageGlass, use Settings > File type associations.",
        "Settings, plugins, language packs, and themes are preserved across updates."
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/d2phap/ImageGlass/releases/download/10.0.5.825/ImageGlass_10.0.5.825_win-x64.zip",
            "hash": "1676d43d2ffbfd20fd9b574e1652337be30c6a3935a67e8693954df2365d9786",
            "extract_dir": "ImageGlass_10.0.5.825_win-x64"
        },
        "arm64": {
            "url": "https://github.com/d2phap/ImageGlass/releases/download/10.0.5.825/ImageGlass_10.0.5.825_win-arm64.zip",
            "hash": "be989a54826292df8cd9999ecb7e053b114861ac5983fffe83d6df16357803a8",
            "extract_dir": "ImageGlass_10.0.5.825_win-arm64"
        }
    },
    "pre_install": [
        "if (!(Test-Path \"$persist_dir\\igconfig.json\")) {",
        "    [System.IO.File]::WriteAllText(\"$dir\\igconfig.json\", '{\"AutoUpdate\":\"0\"}')",
        "}"
    ],
    "post_install": [
        "'_lang', '_themes' | ForEach-Object {",
        "    if (Test-Path \"$dir\\$_.original\" -PathType Container) {",
        "        Copy-Item \"$dir\\$_.original\\*\" \"$persist_dir\\$_\" -Recurse -Force",
        "    }",
        "}"
    ],
    "bin": [
        "ImageGlass.exe",
        [
            "ImageGlass.exe",
            "ig"
        ]
    ],
    "shortcuts": [
        [
            "ImageGlass.exe",
            "ImageGlass"
        ]
    ],
    "persist": [
        "igconfig.json",
        "_plugins",
        "_lang",
        "_themes"
    ],
    "checkver": {
        "github": "https://github.com/d2phap/ImageGlass"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/d2phap/ImageGlass/releases/download/$version/ImageGlass_$version_win-x64.zip",
                "extract_dir": "ImageGlass_$version_win-x64"
            },
            "arm64": {
                "url": "https://github.com/d2phap/ImageGlass/releases/download/$version/ImageGlass_$version_win-arm64.zip",
                "extract_dir": "ImageGlass_$version_win-arm64"
            }
        }
    }
}
