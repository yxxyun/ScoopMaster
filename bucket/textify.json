{
    "version": "1.10.4",
    "description": "A small tool which allows to copy text from dialogs and controls which don't allow it otherwise.",
    "homepage": "https://ramensoftware.com/textify",
    "license": "GPL-3.0",
    "url": "https://ramensoftware.com/downloads/textify_setup.exe#/dl.7z",
    "hash": "68d09e1a39da33a3ba80a2eec437d764bbe79026ab323f710f88e5f71bcddd0d",
    "post_install": [
        "Remove-Item \"$dir\\`$PLUGINSDIR\", \"$dir\\uninstall.exe\" -Force -Recurse",
        "if (Test-Path \"$dir\\Textify.ini\") {",
        "    (Get-Content \"$dir\\Textify.ini\") -replace 'check_for_updates=1', 'check_for_updates=0' | Set-Content \"$dir\\Textify.ini\"",
        "}"
    ],
    "shortcuts": [
        [
            "Textify.exe",
            "Textify"
        ]
    ],
    "persist": "Textify.ini",
    "checkver": {
        "url": "https://ramensoftware.com/textify",
        "regex": "Latest version: v([\\d.]+)"
    },
    "autoupdate": {
        "url": "https://ramensoftware.com/downloads/textify_setup.exe#/dl.7z"
    }
}
