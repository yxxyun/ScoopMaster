{
    "version": "1.3.1",
    "description": "Text-to-speech communication assistant for people with speech impairments, optimized for fullscreen scenarios like games (Alt+V floating window)",
    "homepage": "https://github.com/Mr-Shaw-Yihan/TTSassist",
    "license": "MIT",
    "url": "https://github.com/Mr-Shaw-Yihan/TTSassist/releases/download/v1.3.1/TTSassist.exe",
    "hash": "ff81f2c3776bf341612688e6deb8c01087c56dc82e5d2ce195ba20c0226243bd",
    "bin": "TTSassist.exe",
    "shortcuts": [
        [
            "TTSassist.exe",
            "TTSassist"
        ]
    ],
    "post_install": [
        "$targetPath = \"$persist_dir\\TTSassist\"",
        "$configPath = \"$env:APPDATA\\com.voiceassist.app\"",
        "ensure $targetPath | Out-Null",
        "$linkType = (Get-Item -Path $configPath -ErrorAction SilentlyContinue).LinkType",
        "if (Test-Path $configPath) {",
        "    if ($linkType -eq 'Junction') {",
        "        Remove-Item -Path $configPath -Force",
        "    } else {",
        "        Get-ChildItem -Path $configPath -Force | Move-Item -Destination $targetPath -Force",
        "        Remove-Item -Path $configPath -Force -Recurse",
        "    }",
        "}",
        "New-Item $configPath -ItemType Junction -Target $targetPath | Out-Null"
    ],
    "checkver": "github",
    "autoupdate": {
        "url": "https://github.com/Mr-Shaw-Yihan/TTSassist/releases/download/v$version/TTSassist.exe"
    }
}
