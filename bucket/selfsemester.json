{
    "$schema": "https://raw.githubusercontent.com/ScoopInstaller/Scoop/master/schema.json",
    "version": "0.9.0",
    "description": "Build, schedule, and grade courses for any subject with a Claude Code-powered workflow.",
    "homepage": "https://github.com/munitkala/selfsemester",
    "license": {
        "identifier": "MIT",
        "url": "https://github.com/munitkala/selfsemester/blob/main/LICENSE"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/munitkala/selfsemester/releases/download/v0.9.0/SelfSemester_0.9.0_x64-setup.exe#/dl.7z",
            "hash": "e36d4c77582b0deb5d2eb664948f4cc6eb240b5a6555139062aa010fcb7a7f0a"
        }
    },
    "pre_install": [
        "$launcher = @'",
        "Set shell = CreateObject(\"WScript.Shell\")",
        "Set fso = CreateObject(\"Scripting.FileSystemObject\")",
        "appDir = fso.GetParentFolderName(WScript.ScriptFullName)",
        "shell.Environment(\"PROCESS\")(\"SELFSEMESTER_HOME\") = appDir & \"\\data\"",
        "shell.Run Chr(34) & appDir & \"\\selfsemester.exe\" & Chr(34), 1, False",
        "'@",
        "Set-Content -LiteralPath (Join-Path $dir 'SelfSemester.vbs') -Value $launcher -Encoding ASCII"
    ],
    "persist": "data",
    "shortcuts": [
        [
            "SelfSemester.vbs",
            "SelfSemester"
        ]
    ],
    "checkver": {
        "github": "https://github.com/munitkala/selfsemester"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/munitkala/selfsemester/releases/download/v$version/SelfSemester_$version_x64-setup.exe#/dl.7z",
                "hash": {
                    "mode": "json",
                    "url": "https://api.github.com/repos/munitkala/selfsemester/releases/tags/v$version",
                    "jsonpath": "$.assets[?(@.name == '$basename')].digest",
                    "regex": "^sha256:([a-fA-F0-9]{64})$"
                }
            }
        }
    },
    "notes": "The Start Menu shortcut launches a wrapper that sets SELFSEMESTER_HOME to the persisted data folder. Course creation and grading require Claude Code; it is not bundled."
}
