{
    "version": "11.1",
    "description": "Portable edition of Vovsoft Vov Sticky Notes.",
    "homepage": "https://vovsoft.com/software/vov-sticky-notes/",
    "license": "Proprietary",
    "url": "https://vovsoft.com/files/vov-sticky-notes-portable.zip?v=11.1",
    "checkver": {
        "url": "https://vovsoft.com/download/vov-sticky-notes-portable/",
        "regex": "(?is)Version\\s*(?:<[^>]*>\\s*)*:?\\s*(?:<[^>]*>\\s*)*(?<version>\\d+(?:\\.\\d+)+)"
    },
    "autoupdate": {
        "url": "https://vovsoft.com/files/vov-sticky-notes-portable.zip?v=$version"
    },
    "shortcuts": [
        [
            "sticky.exe",
            "Vovsoft Vov Sticky Notes"
        ]
    ],
    "notes": [
        "SHA-256 has not been verified; archive contents and the shortcut target have been checked."
    ],
    "pre_install": [
        "if (-not (Test-Path -LiteralPath \"$dir\\key.txt\" -PathType Leaf)) { New-Item -ItemType File -Path \"$dir\\key.txt\" | Out-Null }"
    ],
    "persist": "key.txt"
}
