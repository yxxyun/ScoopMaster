{
    "version": "3.5.2.2",
    "description": "A powerful and easy-to-use screenshot and pinning tool to help you improve efficiency",
    "homepage": "https://pixpinapp.com/",
    "license": "Freeware",
    "architecture": {
        "64bit": {
            "url": "https://download.pixpinapp.com/PixPin_win_3.5.2.2.zip",
            "hash": "af7426c7b79a104c406b6fc1259921f85aaac02d0ab7cb324a8aed3035a91470"
        }
    },
    "extract_dir": "PixPin",
    "pre_install": [
        "ensure $persist_dir\\Config",
        "if (-not (Test-Path \"$persist_dir\\Config\\PixPinConfig.json\")) {",
        "    $defaultConfig = @{",
        "        'System.Share Analytics.UploadCrashInformation' = @{ t = 1; v = $false }",
        "        'System.Update.UpgradeMode#s.win' = @{ t = 1; v = 0 }",
        "        'System.Update.UpgradeMode.UpgradeType#s.win' = @{ t = 1; v = 1 }",
        "    }",
        "    $json = $defaultConfig | ConvertTo-Json",
        "    Set-Content -Path \"$persist_dir\\Config\\PixPinConfig.json\" -Value $json",
        "}",
        "if (-not (Test-Path \"$persist_dir\\LocalStorage.data\")) {",
        "    Set-Content -Path \"$persist_dir\\LocalStorage.data\" -Value @('[General]', 'IsFirstRun=false')",
        "}"
    ],
    "shortcuts": [
        [
            "PixPin.exe",
            "PixPin Beta"
        ]
    ],
    "persist": [
        "History",
        "Data",
        "Config",
        "LocalStorage.data"
    ],
    "checkver": {
        "url": "https://upgrade.pixpin.cn/api/check/1/3.0.0.0/windows/x64/intl/zh-cn/.zip",
        "jsonpath": "$.[0].version"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://download.pixpinapp.com/PixPin_win_$version.zip"
            }
        }
    }
}
