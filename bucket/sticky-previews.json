{
    "version": "3.1",
    "description": "Picture-in-Picture control for Windows PC",
    "homepage": "https://www.ntwind.com/software/stickypreviews.html",
    "license": "Proprietary",
    "url": "https://www.ntwind.com/download/StickyPreviews_3.1-setup.exe",
    "hash": "0120207f8dac690e1d65df83aabd10212356567104a4ff6f29970afe7f315593",
    "depends": "main/7zip",
    "installer": {
        "script": [
            "7z x \"$dir\\$fname\" -o\"$dir\" -aou -y | Out-Null",
            "Remove-Item \"$dir\\$fname\"",
            "Remove-Item \"$dir\\*PLUGINSDIR\" -Recurse -Force -ErrorAction SilentlyContinue",
            "Remove-Item \"$dir\\*.nsis\" -ErrorAction SilentlyContinue",
            "Remove-Item \"$dir\\uninst.exe\" -ErrorAction SilentlyContinue",
            "$machine = @{}",
            "@(\"spv.exe\", \"spv_1.exe\") | Where-Object { Test-Path \"$dir\\$_\" } | ForEach-Object { $fs = [IO.File]::OpenRead(\"$dir\\$_\"); $br = New-Object IO.BinaryReader($fs); $fs.Position = 0x3C; $peOffset = $br.ReadInt32(); $fs.Position = $peOffset + 4; $machine[$_] = $br.ReadUInt16(); $br.Close(); $fs.Close() }",
            "$x64exe = ($machine.GetEnumerator() | Where-Object { $_.Value -eq 0x8664 }).Name",
            "$x86exe = ($machine.GetEnumerator() | Where-Object { $_.Value -eq 0x014c }).Name",
            "Rename-Item \"$dir\\$x64exe\" \"spv64.exe\"",
            "Rename-Item \"$dir\\$x86exe\" \"spv32.exe\""
        ]
    },
    "architecture": {
        "64bit": {
            "bin": [
                [
                    "spv64.exe",
                    "stickypreviews"
                ]
            ],
            "shortcuts": [
                [
                    "spv64.exe",
                    "Sticky Previews"
                ]
            ]
        },
        "32bit": {
            "bin": [
                [
                    "spv32.exe",
                    "stickypreviews"
                ]
            ],
            "shortcuts": [
                [
                    "spv32.exe",
                    "Sticky Previews"
                ]
            ]
        }
    },
    "checkver": {
        "url": "https://www.ntwind.com/download-all.html",
        "regex": "StickyPreviews_([\\d.]+)-setup\\.exe"
    },
    "autoupdate": {
        "url": "https://www.ntwind.com/download/StickyPreviews_$version-setup.exe"
    }
}
