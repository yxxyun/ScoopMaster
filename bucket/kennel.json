{
    "version": "0.1.0",
    "description": "Named tabs for your Claude Code, Codex and shell sessions, restored after every restart",
    "homepage": "https://github.com/xevrion/kennel",
    "license": {
        "identifier": "MIT,OFL-1.1",
        "url": "https://github.com/xevrion/kennel/blob/main/LICENSE"
    },
    "notes": [
        "kennel-desktop.exe isn't code-signed yet. If Windows SmartScreen warns, choose More info, then Run anyway.",
        "Your tabs and settings live in %LOCALAPPDATA%\\kennel, so updating or uninstalling kennel leaves them alone."
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/xevrion/kennel/releases/download/v0.1.0/kennel-0.1.0-windows-x86_64.zip",
            "hash": "683f1eb1407a3659923ea9af943f43e2b2ed2d377f3bf866bf7641dbfcb6be63"
        }
    },
    "bin": "kennel-desktop.exe",
    "shortcuts": [
        [
            "kennel-desktop.exe",
            "kennel"
        ]
    ],
    "post_install": [
        "# Scoop starts a shortcut in the app's own folder, and kennel opens new tabs in the folder it",
        "# started in, so the Start menu entry starts in your home folder instead.",
        "$menu = if ($global) { 'CommonStartMenu' } else { 'StartMenu' }",
        "$lnk = [IO.Path]::Combine([Environment]::GetFolderPath($menu), 'Programs', 'Scoop Apps', 'kennel.lnk')",
        "if (Test-Path $lnk) {",
        "    $link = (New-Object -ComObject WScript.Shell).CreateShortcut($lnk)",
        "    $link.WorkingDirectory = $env:USERPROFILE",
        "    $link.Save()",
        "}"
    ],
    "checkver": {
        "github": "https://github.com/xevrion/kennel"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/xevrion/kennel/releases/download/v$version/kennel-$version-windows-x86_64.zip",
                "hash": {
                    "url": "$baseurl/SHA256SUMS",
                    "regex": "$sha256\\s+$basename"
                }
            }
        }
    }
}
