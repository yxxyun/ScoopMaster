{
    "version": "4.0.5",
    "description": "Gaming suite with an FPS overlay, game streaming, stutter analysis, and virtual gamepad tools.",
    "homepage": "https://k-toolz.de/en/",
    "license": "AGPL-3.0-only",
    "architecture": {
        "64bit": {
            "url": "https://github.com/kara2010/k-toolz/releases/download/v4.0.5/K-Toolz-Setup-4.0.5.exe#/dl.7z",
            "hash": "471ee76f179791af4862dd26cb88c80aef2ffae61fd6b18063f4faf34683afe4"
        }
    },
    "bin": "k-toolz.exe",
    "shortcuts": [
        [
            "k-toolz.exe",
            "K-Toolz",
            "icons\\k-toolz.ico"
        ]
    ],
    "checkver": {
        "url": "https://api.github.com/repos/kara2010/k-toolz/releases/latest",
        "jsonpath": "$.tag_name",
        "regex": "^v([\\d.]+)$"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/kara2010/k-toolz/releases/download/v$version/K-Toolz-Setup-$version.exe#/dl.7z"
            }
        }
    },
    "notes": [
        "On first launch, K-Toolz registers the ktoolz:// and lumora:// URL handlers under HKCU. Scoop removes these registrations on uninstall only when they still point to this Scoop installation.",
        "Requires Microsoft Edge WebView2 Runtime and Microsoft Visual C++ 2015-2022 x64. Scoop does not install these prerequisites automatically.",
        "PawnIO and ViGEmBus are optional drivers installed only through explicit actions in the app. Optional PlainOSD, network statistics and StutterHunter features can create elevated Task Scheduler tasks; remove those tasks manually if no longer needed after uninstall.",
        "Settings and game-library data remain under %APPDATA%\\K-Toolz; the WebView2 profile remains under %LOCALAPPDATA%\\K-Toolz\\WebView2. The app's built-in updater remains enabled."
    ],
    "pre_uninstall": [
        "$appRoot = (Split-Path -Parent $dir).TrimEnd('\\')",
        "$rootPrefix = '\"' + $appRoot + '\\'",
        "foreach ($scheme in @('ktoolz', 'lumora')) {",
        "    $schemeKey = \"HKCU:\\Software\\Classes\\$scheme\"",
        "    $commandKey = Join-Path $schemeKey 'shell\\open\\command'",
        "    $command = if (Test-Path -LiteralPath $commandKey) { (Get-Item -LiteralPath $commandKey).GetValue('') }",
        "    if ($command -and $command.StartsWith($rootPrefix, [System.StringComparison]::OrdinalIgnoreCase) -and $command.EndsWith('\\k-toolz.exe\" \"%1\"', [System.StringComparison]::OrdinalIgnoreCase)) {",
        "        Remove-Item -LiteralPath $schemeKey -Recurse -Force",
        "    }",
        "}",
        "$runKey = 'HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Run'",
        "$runCommand = if (Test-Path -LiteralPath $runKey) { (Get-Item -LiteralPath $runKey).GetValue('K-Toolz') }",
        "$ownsRun = $runCommand -and $runCommand.StartsWith($rootPrefix, [System.StringComparison]::OrdinalIgnoreCase) -and ($runCommand.EndsWith('\\k-toolz.exe\"', [System.StringComparison]::OrdinalIgnoreCase) -or $runCommand.EndsWith('\\k-toolz.exe\" --minimized', [System.StringComparison]::OrdinalIgnoreCase))",
        "if ($ownsRun) { Remove-ItemProperty -LiteralPath $runKey -Name 'K-Toolz' -Force }"
    ]
}
