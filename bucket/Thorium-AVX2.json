{
  "version": "156.0.8078.80",
  "description": "Thorium AVX2 - Chromium fork named after radioactive element No. 90. Optimized for AVX2. If your CPU does not support AVX2 DO NOT INSTALL.",
  "homepage": "https://thorium.rocks/",
  "license": "BSD-3-Clause",
  "architecture": {
    "64bit": {
      "url": "https://github.com/gz83/thorium/releases/download/M156.0.8078.80/Thorium_AVX2_156.0.8078.80.zip",
      "hash": "sha256:cc8db207d195a01401332ecfb164cda62482e4d11afe0900ec41cdd9cf0b7ab1"
    }
  },
  "bin": [
    [
      "BIN\\thorium.exe",
      "thorium",
      "--user-data-dir=\"$dir\\USER_DATA\""
    ]
  ],
  "shortcuts": [
    [
      "BIN\\thorium.exe",
      "Thorium AVX2",
      "--user-data-dir=\"$dir\\USER_DATA\""
    ]
  ],
  "post_install": [
    "if (!(Test-Path \"$dir\\USER_DATA\\*\") -and (Test-Path \"$env:LocalAppData\\Thorium\\User Data\")) {",
    "    info '[Portable Mode]: Copying user data...'",
    "    Copy-Item \"$env:LocalAppData\\Thorium\\User Data\\*\" \"$dir\\USER_DATA\" -Recurse",
    "}"
  ],
  "env_set": {
    "CHROME_EXECUTABLE": "$dir\\BIN\\thorium.exe"
  },
  "persist": "USER_DATA",
  "checkver": {
    "url": "https://api.github.com/repos/gz83/thorium/releases",
    "regex": "\"tag_name\":\\s*\"M([\\d.]+)\""
  },
  "autoupdate": {
    "architecture": {
      "64bit": {
        "url": "https://github.com/gz83/thorium/releases/download/M$version/Thorium_AVX2_$version.zip"
      }
    }
  }
}
