{
    "version": "3.4.0",
    "description": "Local-first voice dictation with on-device speech recognition.",
    "homepage": "https://github.com/anomalyco/hex",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/anomalyco/hex/releases/download/v3.4.0/hex-3.4.0-windows-x64.exe#/hex.exe",
            "hash": "90bf9543dee8c3c799de95cbb4ccd1c05bcb29863c7212c1bd641979e287af9e"
        },
        "arm64": {
            "url": "https://github.com/anomalyco/hex/releases/download/v3.4.0/hex-3.4.0-windows-arm64.exe#/hex.exe",
            "hash": "9f31a38ced09e23d87d5a2e4977db3024de988275593f750f26ba6d8882b7a24"
        }
    },
    "bin": "hex.exe",
    "shortcuts": [
        [
            "hex.exe",
            "Hex"
        ]
    ],
    "notes": [
        "Windows x64 requires an AVX2 CPU and a Vulkan graphics driver.",
        "Complete model setup before dictation. Settings and models remain in %APPDATA%\\hex after uninstall.",
        "Update this Scoop-managed installation with scoop update hex. Launching Hex enables its configured dictation shortcut.",
        "Scoop disables in-app updates through the current-user Hex policy when registry permissions allow. If it warns that access was denied, ask an administrator to configure the policy. Use scoop update hex."
    ],
    "checkver": {
        "url": "https://api.github.com/repos/anomalyco/hex/releases?per_page=100",
        "jsonpath": "$[?(@.prerelease == false)].tag_name",
        "regex": "(?:^|\")v([0-9.]+)(?:\"|$)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/anomalyco/hex/releases/download/v$version/hex-$version-windows-x64.exe#/hex.exe"
            },
            "arm64": {
                "url": "https://github.com/anomalyco/hex/releases/download/v$version/hex-$version-windows-arm64.exe#/hex.exe"
            }
        }
    },
    "post_install": [
        "$policy = 'HKCU:\\Software\\Policies\\Anomaly\\Hex'",
        "try {",
        "    New-Item -Path $policy -Force -ErrorAction Stop | Out-Null",
        "    New-ItemProperty -Path $policy -Name DisableUpdates -Value 1 -PropertyType DWord -Force -ErrorAction Stop | Out-Null",
        "} catch [System.UnauthorizedAccessException], [System.Security.SecurityException] {",
        "    Write-Warning 'Cannot set the Hex update policy: the current user lacks registry access. In-app updates remain enabled unless an administrator configures the policy.'",
        "}"
    ]
}
