{
    "version": "0.1.4",
    "description": "Read-only viewer for Word documents",
    "homepage": "https://abooodbah.github.io/leandoc/",
    "license": "MIT",
    "notes": [
        "LeanDoc needs the Microsoft Edge WebView2 Runtime, which ships with Windows 11 and current Windows 10.",
        "Settings (theme, view, recent files) are kept in the registry under HKCU\\Software\\LeanDoc and the WebView2 profile under",
        "%LOCALAPPDATA%\\LeanDoc. Both live outside the Scoop folder: they survive updates and stay after uninstall."
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/abooodbah/leandoc/releases/download/v0.1.4/LeanDoc-v0.1.4-windows-x64.zip",
            "hash": "e669fb32f7a78d46febbd2d12212e15e863f94e55f235ccfba82d275cd3243fa",
            "extract_dir": "LeanDoc-v0.1.4-windows-x64"
        }
    },
    "pre_install": "Remove-Item \"$dir\\installer\", \"$dir\\INSTALL.txt\" -Recurse -ErrorAction SilentlyContinue",
    "bin": [
        "LeanDoc.exe",
        [
            "tools\\leandoc-inspect.exe",
            "leandoc-inspect"
        ]
    ],
    "shortcuts": [
        [
            "LeanDoc.exe",
            "LeanDoc"
        ]
    ],
    "checkver": {
        "github": "https://github.com/abooodbah/leandoc"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/abooodbah/leandoc/releases/download/v$version/LeanDoc-v$version-windows-x64.zip",
                "extract_dir": "LeanDoc-v$version-windows-x64"
            }
        },
        "hash": {
            "url": "$url.sha256"
        }
    }
}
