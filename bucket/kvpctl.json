{
    "version": "0.11.0",
    "description": "CLI for KVP (Key-Value Pair) exchange with Hyper-V VMs (libhvee)",
    "homepage": "https://github.com/containers/libhvee",
    "license": "Apache-2.0",
    "architecture": {
        "64bit": {
            "url": "https://github.com/containers/libhvee/releases/download/v0.11.0/kvpctl-amd64.exe.zip",
            "hash": "6bab2103227ab5538d767769ef8c5a8ade212b0a2782bb2f8aeb93b9a8eab22a"
        },
        "arm64": {
            "url": "https://github.com/containers/libhvee/releases/download/v0.11.0/kvpctl-arm64.exe.zip",
            "hash": "59965ecd5718cadb28006e7b22ef81812fc48a40bc47e75f449de5aaad24c100"
        }
    },
    "pre_install": "Rename-Item \"$dir\\kvpctl-$architecture.exe\" \"$dir\\kvpctl.exe\"",
    "bin": "kvpctl.exe",
    "checkver": {
        "github": "https://github.com/containers/libhvee",
        "regex": "v([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/containers/libhvee/releases/download/v$version/kvpctl-amd64.exe.zip"
            },
            "arm64": {
                "url": "https://github.com/containers/libhvee/releases/download/v$version/kvpctl-arm64.exe.zip"
            }
        },
        "hash": {
            "url": "https://github.com/containers/libhvee/releases/download/v$version/sha256sums",
            "find": "([a-fA-F0-9]{64})\\s+$basename"
        }
    }
}
