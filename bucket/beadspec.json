{
    "version": "0.1.4-rzyns.2",
    "description": "Desktop GUI for Beads and OpenSpec, with Windows project-path fixes from the rzyns fork.",
    "homepage": "https://github.com/rzyns/BeadSpec",
    "license": "MIT",
    "notes": [
        "Requires the Beads CLI (bd) 1.3 or newer on PATH: https://github.com/gastownhall/beads/releases",
        "Requires Microsoft Edge WebView2 Runtime. Install extras/webview2 if it is not already available.",
        "Updates are managed by Scoop; the upstream in-app updater is disabled. App settings and project databases remain outside the installation directory."
    ],
    "suggest": {
        "Microsoft Edge WebView2 Runtime": "extras/webview2"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/rzyns/BeadSpec/releases/download/scoop-v0.1.4-rzyns.2/beadspec_0.1.4-rzyns.2_windows_x64.zip",
            "hash": "187d980e397a74f319ed5a5b2e7cfaa916b32181acc1b7fbe274f048b783adf7"
        }
    },
    "shortcuts": [
        [
            "beadspec.exe",
            "BeadSpec"
        ]
    ],
    "checkver": {
        "url": "https://api.github.com/repos/rzyns/BeadSpec/releases/latest",
        "jsonpath": "$.tag_name",
        "regex": "^scoop-v([\\d.]+-rzyns\\.\\d+)$"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/rzyns/BeadSpec/releases/download/scoop-v$version/beadspec_$version_windows_x64.zip",
                "hash": {
                    "url": "$url.sha256"
                }
            }
        }
    }
}
