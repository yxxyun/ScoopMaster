{
    "version": "1.3.0",
    "description": "Apple TV-style Windows screen saver with aerial videos, local video playback, and configurable overlays.",
    "homepage": "https://github.com/AerialWindows/Aerial",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/AerialWindows/Aerial/releases/download/v1.3.0/Aerial.1.3.0.win-x64.zip",
            "hash": "8546f2544c2f0ec2a068f6fccb50e42d6ac7b97c1f0e662093dc52e093916336"
        },
        "arm64": {
            "url": "https://github.com/AerialWindows/Aerial/releases/download/v1.3.0/Aerial.1.3.0.win-arm64.zip",
            "hash": "1d4f5f8ca6cfdb7064fb544503efdabc6737e4008b298d5e10f28bc033ba2046"
        }
    },
    "bin": "aerial.exe",
    "shortcuts": [
        [
            "aerial.exe",
            "Aerial"
        ]
    ],
    "checkver": {
        "script": [
            "$headers = @{ Accept = 'application/vnd.github+json'; 'User-Agent' = 'kirobucket-checkver' }",
            "if ($env:GITHUB_TOKEN) { $headers.Authorization = \"Bearer $env:GITHUB_TOKEN\" }",
            "$releases = Invoke-RestMethod -Uri 'https://api.github.com/repos/AerialWindows/Aerial/releases?per_page=100' -Headers $headers -ErrorAction Stop",
            "$compatibleVersion = $null",
            "foreach ($release in $releases) {",
            "    if ($release.draft -or $release.prerelease) { continue }",
            "    $tag = [regex]::Match([string]$release.tag_name, '^v(?<version>\\d+(?:\\.\\d+)+)$')",
            "    if (-not $tag.Success) { continue }",
            "    $candidateVersion = $tag.Groups['version'].Value",
            "    $assets = @($release.assets | ForEach-Object { [string]$_.name })",
            "    if (($assets -contains \"Aerial.$candidateVersion.win-x64.zip\") -and ($assets -contains \"Aerial.$candidateVersion.win-arm64.zip\")) {",
            "        $compatibleVersion = $candidateVersion",
            "        break",
            "    }",
            "}",
            "if (-not $compatibleVersion) { throw 'No Aerial release with both supported Windows ZIP assets was found.' }",
            "$compatibleVersion"
        ],
        "regex": "(?<version>[\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/AerialWindows/Aerial/releases/download/v$version/Aerial.$version.win-x64.zip",
                "hash": {
                    "url": "https://api.github.com/repos/AerialWindows/Aerial/releases/tags/v$version",
                    "regex": "\"name\"\\s*:\\s*\"Aerial\\.[\\d.]+\\.win-x64\\.zip\"[\\s\\S]*?\"digest\"\\s*:\\s*\"sha256:([a-f0-9]{64})\""
                }
            },
            "arm64": {
                "url": "https://github.com/AerialWindows/Aerial/releases/download/v$version/Aerial.$version.win-arm64.zip",
                "hash": {
                    "url": "https://api.github.com/repos/AerialWindows/Aerial/releases/tags/v$version",
                    "regex": "\"name\"\\s*:\\s*\"Aerial\\.[\\d.]+\\.win-arm64\\.zip\"[\\s\\S]*?\"digest\"\\s*:\\s*\"sha256:([a-f0-9]{64})\""
                }
            }
        }
    },
    "notes": [
        "Scoop does not apply Aerial's optional Windows startup registration. Settings and video cache are stored under %APPDATA%\\Aerial; the cache location can be changed in the app settings.",
        "This manifest tracks the last compatible portable ZIP. Releases v1.4 and later use a different package format that is not covered by this manifest."
    ]
}
