{
    "version": "1.2.07",
    "description": "The AT32 Work Bench can generate initialization C code and corresponding IDE project through MCU graphical configuration",
    "homepage": "https://arterychip.com/cn/support/tools.jsp",
    "license": "Freeware",
    "url": "https://arterychip.com/download/AT32%20Workbench/AT32_Work_Bench_Win-x86_64_V1.2.07.zip",
    "hash": "06bfe12d1f3e1e6b013c2d2827018fbb46f5d14d982fb15db0519cf24cd46219",
    "pre_install": [
        "Get-ChildItem $dir -Directory -Filter 'AT32_Work_Bench_V*' | Rename-Item -NewName 'AT32_Work_Bench'",
        "if (!(Test-Path \"$persist_dir\\Repository\\Package\")) {",
        "    New-Item -Path \"$dir\\Repository\\Package\" -ItemType Directory -Force | Out-Null",
        "}",
        "if (!(Test-Path \"$persist_dir\\AT32_Work_Bench\\config.xml\")) {",
        "    $pkg = ((Split-Path $dir -Parent) + '\\current\\Repository\\Package') -replace '\\\\', '/'",
        "    $xml = \"<?xml version='1.0' encoding='UTF-8'?><Configuration><PackagePath>$pkg</PackagePath></Configuration>\"",
        "    New-Item -Path \"$dir\\AT32_Work_Bench\\config.xml\" -ItemType File -Value $xml | Out-Null",
        "}"
    ],
    "shortcuts": [
        [
            "AT32_Work_Bench\\AT32_Work_Bench.exe",
            "AT32 Work Bench"
        ]
    ],
    "persist": [
        "Repository",
        "AT32_Work_Bench\\config.xml"
    ],
    "checkver": {
        "url": "https://arterychip.com/json/Document.json",
        "jsonpath": "$.data[?(@.docNo=='AT32 Work Bench')].cnVersion"
    },
    "autoupdate": {
        "url": "https://arterychip.com/download/AT32%20Workbench/AT32_Work_Bench_Win-x86_64_V$version.zip"
    }
}
