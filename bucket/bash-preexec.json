{
    "version": "0.7.0",
    "description": "preexec and precmd functions for Bash just like Zsh.",
    "homepage": "https://github.com/rcaloras/bash-preexec",
    "license": "MIT",
    "suggest": {
        "Git": "main/git"
    },
    "notes": [
        "It must be used inside a Bash/Zsh session,",
        "The easiest Windows option is Git Bash.",
        "(Experimental) To keep the right tools first, add these to the TOP of your System PATH",
        "  $env:SCOOP\\apps\\git\\current\\bin",
        "  $env:SCOOP\\apps\\git\\current\\usr\\bin"
    ],
    "url": "https://github.com/rcaloras/bash-preexec/archive/refs/tags/0.7.0.zip",
    "hash": "1c54b0a26c11c738c5d85dbb284fdd525a46f7c054f95703b35213507203769e",
    "extract_dir": "bash-preexec-0.7.0",
    "pre_install": [
        "Remove-Item -Path \"$dir\\*\" -Exclude 'bash-preexec.sh', 'LICENSE.md', 'README.md' -Recurse -Force",
        "New-Item -Path \"$dir\\bash-preexec.cmd\" -ItemType File -Force",
        "Add-Content -Path \"$dir\\bash-preexec.cmd\" -Value \"bash $env:SCOOP\\apps\\bash-preexec\\current\\bash-preexec.sh %*\""
    ],
    "bin": "bash-preexec.cmd",
    "checkver": "github",
    "autoupdate": {
        "url": "https://github.com/rcaloras/bash-preexec/archive/refs/tags/$version.zip",
        "extract_dir": "bash-preexec-$version"
    }
}
