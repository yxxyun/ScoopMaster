{
    "version": "1.4.0",
    "description": "把 Switch 游戏装进 iPhone: 图形界面一键构建, 不用命令行",
    "homepage": "https://github.com/LNPANDY/NX2Apple",
    "license": "MIT",
    "notes": "数据 (游戏库, 封面, 工具链和 SDK 缓存) 保存在 Scoop 的 persist 目录。程序启动时会检查新版本, 更新按钮会把新文件直接覆盖到当前安装目录; 请改用 scoop update nx2apple 升级, 不要点程序内的更新。更新或卸载前请先退出程序。",
    "architecture": {
        "64bit": {
            "url": "https://github.com/LNPANDY/NX2Apple/releases/download/v1.4.0/NX2Apple-windows-x64.zip",
            "hash": "fa6c65e618f8c43b46041fcfb02d627b39ee204fd1ea0adbe0f95a858434e02e"
        }
    },
    "extract_dir": "NX2Apple",
    "persist_link": [
        [
            "$env:LocalAppData\\NS Port Builder",
            "LocalAppData"
        ]
    ],
    "post_install": "Restore-AppRegistry -Map @{ 'config.reg' = 'HKCU\\Software\\NS Port Builder' }",
    "post_uninstall": "Save-AppRegistry -Map @{ 'config.reg' = 'HKCU\\Software\\NS Port Builder' } -Delete",
    "shortcuts": [
        [
            "NX2Apple.exe",
            "NX2Apple"
        ]
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/LNPANDY/NX2Apple/releases/download/v$version/NX2Apple-windows-x64.zip"
            }
        }
    }
}
