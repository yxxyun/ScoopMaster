{
    "version": "5.3.4",
    "description": "tinyMediaManager is a media management tool written in Java/Swing. It is written to provide metadata for the Kodi Media Center (formerly known as XBMC), MediaPortal and Plex media server",
    "homepage": "https://www.tinymediamanager.org/",
    "license": {
        "identifier": "Apache-2.0",
        "url": "https://github.com/tinyMediaManager/tinyMediaManager/blob/master/LICENSE"
    },
    "architecture": {
        "64bit": {
            "url": "https://release.tinymediamanager.org/v5/dist/tinyMediaManager-5.3.4-windows-amd64.zip",
            "hash": "448d8cbe8a78ae859719b4030208741294575ee190468aba2504bfd76cbac408"
        }
    },
    "extract_dir": "tinyMediaManager",
    "bin": "tinyMediaManagerCMD.exe",
    "shortcuts": [
        [
            "tinyMediaManager.exe",
            "tinyMediaManager"
        ]
    ],
    "persist": [
        "logs",
        "data",
        "cache",
        "backup"
    ],
    "checkver": {
        "url": "https://www.tinymediamanager.org/blog/",
        "regex": "Version v(.*)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://release.tinymediamanager.org/v5/dist/tinyMediaManager-$version-windows-amd64.zip",
                "hash": {
                    "url": "$url.sha256"
                }
            }
        },
        "extract_dir": "tinyMediaManager"
    }
}
