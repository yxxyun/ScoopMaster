    "checkver": {
        "script": [
            "$release = Invoke-RestMethod -Headers @{ 'User-Agent' = 'Scoop' } -Uri 'https://api.github.com/repos/microsoft/DirectXTex/releases/latest'",
            "$readme = Invoke-RestMethod -Headers @{ 'User-Agent' = 'Scoop' } -Uri 'https://raw.githubusercontent.com/microsoft/DirectXTex/main/README.md'",
            "$dateText = [regex]::Match($readme, '(?m)^##\\s+(?<date>[A-Z][a-z]+\\s+\\d+,?\\s+\\d{4})\\s*$').Groups['date'].Value",
            "$date = [datetime]::Parse($dateText, [Globalization.CultureInfo]::InvariantCulture)",
            "\"$($date.ToString('yyyy.MM.dd')) $($release.tag_name)\""
        ],
        "regex": "^(?<version>[\\d.]+) (?<tag>[a-z]+\\d{4})$",
        "replace": "${version}"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": [
                    "https://github.com/microsoft/DirectXTex/releases/download/$matchTag/texconv.exe",
                    "https://github.com/microsoft/DirectXTex/releases/download/$matchTag/texassemble.exe",
                    "https://github.com/microsoft/DirectXTex/releases/download/$matchTag/texdiag.exe"
