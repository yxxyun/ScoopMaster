{
  "version": "0.8.5",
  "description": "Open-source AI-native vector design tool",
  "homepage": "https://github.com/zseven-w/openpencil",
  "license": "MIT",
  "architecture": {
    "64bit": {
      "url": "https://github.com/zseven-w/openpencil/releases/download/v0.8.5/openpencil-desktop-windows-x86_64.zip",
      "hash": "5718043af5eca0b124f5521a22c32954df5760eeb9a34fdf2690ab972964e801"
    },
    "arm64": {
      "url": "https://github.com/zseven-w/openpencil/releases/download/v0.8.5/openpencil-desktop-windows-aarch64.zip",
      "hash": "7a427c1b6983b99198f69e764ab71e31826488e338f2a7b327af63cbbde8a905"
    }
  },
  "bin": "openpencil-desktop.exe",
  "installer": {
    "script": [
      "$runtimeArchitecture = if ($architecture -eq 'arm64') { 'arm64' } else { 'x64' }",
      "$requiredVersion = [version]'14.51.36247.0'",
      "$redistUrl = 'https://download.visualstudio.microsoft.com/download/pr/ebdab8e5-1d7b-4d9f-a11b-cbb1720c3b12/843068991DAAA1F73AD9F6239BCE4D0F6A07A51F18C37EA2A867E9BECA71295C/VC_redist.x64.exe'",
      "$expectedSha256 = '843068991daaa1f73ad9f6239bce4d0f6a07a51f18c37ea2a867e9beca71295c'",
      "function Get-InstalledVcRuntimeVersion {",
      "  $baseKey = $null",
      "  $runtimeKey = $null",
      "  try {",
      "    $baseKey = [Microsoft.Win32.RegistryKey]::OpenBaseKey([Microsoft.Win32.RegistryHive]::LocalMachine, [Microsoft.Win32.RegistryView]::Registry64)",
      "    $runtimeKey = $baseKey.OpenSubKey(\"SOFTWARE\\Microsoft\\VisualStudio\\14.0\\VC\\Runtimes\\$runtimeArchitecture\")",
      "    if ($null -eq $runtimeKey -or [int]$runtimeKey.GetValue('Installed', 0) -ne 1) { return $null }",
      "    $versionValue = [string]$runtimeKey.GetValue('Version', '')",
      "    try { return [version]($versionValue.TrimStart('v')) } catch { return $null }",
      "  } finally {",
      "    if ($null -ne $runtimeKey) { $runtimeKey.Dispose() }",
      "    if ($null -ne $baseKey) { $baseKey.Dispose() }",
      "  }",
      "}",
      "$installedVersion = Get-InstalledVcRuntimeVersion",
      "if ($null -eq $installedVersion -or $installedVersion -lt $requiredVersion) {",
      "  $redist = Join-Path $dir 'VC_redist.x64.exe'",
      "  $log = Join-Path $env:TEMP ('openpencil-vcredist-' + [Guid]::NewGuid().ToString('N') + '.log')",
      "  [Net.ServicePointManager]::SecurityProtocol = [Net.ServicePointManager]::SecurityProtocol -bor [Net.SecurityProtocolType]::Tls12",
      "  Invoke-WebRequest -Uri $redistUrl -OutFile $redist -UseBasicParsing",
      "  $redistItem = Get-Item -LiteralPath $redist -Force -ErrorAction Stop",
      "  if ($redistItem.PSIsContainer -or ($redistItem.Attributes -band [IO.FileAttributes]::ReparsePoint) -or $redistItem.Length -le 0) { throw 'Visual C++ Redistributable download is not a regular file.' }",
      "  $actualSha256 = (Get-FileHash -LiteralPath $redist -Algorithm SHA256).Hash.ToLowerInvariant()",
      "  if ($actualSha256 -cne $expectedSha256) { throw 'Visual C++ Redistributable checksum mismatch.' }",
      "  $versionInfo = [Diagnostics.FileVersionInfo]::GetVersionInfo($redist)",
      "  $downloadedFileVersion = [version]$versionInfo.FileVersion",
      "  $downloadedProductVersion = [version]$versionInfo.ProductVersion",
      "  if ($downloadedFileVersion -ne $requiredVersion -or $downloadedProductVersion -ne $requiredVersion) { throw \"Unexpected Visual C++ Redistributable versions file=$downloadedFileVersion product=$downloadedProductVersion.\" }",
      "  $signature = Get-AuthenticodeSignature -LiteralPath $redist",
      "  $signerName = if ($null -ne $signature.SignerCertificate) { $signature.SignerCertificate.GetNameInfo([Security.Cryptography.X509Certificates.X509NameType]::SimpleName, $false) } else { '' }",
      "  if ($signature.Status -ne [System.Management.Automation.SignatureStatus]::Valid -or $signerName -cne 'Microsoft Corporation' -or $signature.SignerCertificate.Subject -notmatch '(^|,\\s*)O=Microsoft Corporation(,|$)') { throw 'Visual C++ Redistributable does not have a valid Microsoft signature.' }",
      "  $arguments = @('/install', '/passive', '/norestart', '/log', ('\"' + $log + '\"'))",
      "  $process = Start-Process -FilePath $redist -ArgumentList $arguments -Verb RunAs -Wait -PassThru",
      "  if ($process.ExitCode -notin @(0, 1638, 3010)) { throw \"Microsoft Visual C++ Redistributable exited with code $($process.ExitCode). See $log.\" }",
      "  $installedVersion = Get-InstalledVcRuntimeVersion",
      "  if ($null -eq $installedVersion -or $installedVersion -lt $requiredVersion) { throw \"Microsoft Visual C++ Redistributable $requiredVersion or newer is required.\" }",
      "  if ($process.ExitCode -eq 3010) { Write-Warning 'Restart Windows before running OpenPencil.' }",
      "}",
      "Remove-Item -LiteralPath (Join-Path $dir 'VC_redist.x64.exe') -Force -ErrorAction SilentlyContinue"
    ]
  },
  "checkver": {
    "github": "https://github.com/zseven-w/openpencil"
  },
  "autoupdate": {
    "architecture": {
      "64bit": {
        "url": "https://github.com/zseven-w/openpencil/releases/download/v$version/openpencil-desktop-windows-x86_64.zip"
      },
      "arm64": {
        "url": "https://github.com/zseven-w/openpencil/releases/download/v$version/openpencil-desktop-windows-aarch64.zip"
      }
    }
  },
  "shortcuts": [
    [
      "openpencil-desktop.exe",
      "OpenPencil"
    ]
  ]
}
