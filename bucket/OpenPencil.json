{
    "version": "0.8.3",
    "description": "The world's first open-source AI-native vector design tool with concurrent Agent Teams. Design-as-Code alternative to Pencil",
    "homepage": "https://github.com/ZSeven-W/openpencil",
    "license": "MIT",
    "notes": [
        "OpenPencil 是一个开源 AI 原生矢量设计工具（0.8.0 起由 Electron 重写为 Rust 原生程序）",
        "用户数据目录 1：%APPDATA%\\openpencil\\（settings.json、window.json、主题预设等）",
        "用户数据目录 2：%USERPROFILE%\\.openpencil\\（ui.json、git-auth.json、MCP 端口等）",
        "本包会将这两个目录持久化到 Scoop 的 persist，并在原路径创建 Junction 指向 persist"
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/ZSeven-W/openpencil/releases/download/v0.8.3/openpencil-desktop-windows-x86_64.zip",
            "hash": "b5781ce82bf6b13f5aa4d1bd88616fc0d012290ad93b97f4978bb2ee2e58e91b"
        }
    },
    "bin": [
        [
            "openpencil-desktop.exe",
            "openpencil"
        ]
    ],
    "shortcuts": [
        [
            "openpencil-desktop.exe",
            "OpenPencil"
        ]
    ],
    "post_install": [
        "$createJunction = {",
        "    param($source, $name)",
        "    $target = Join-Path $persist_dir $name",
        "    ensure $target",
        "",
        "    if (Test-Path $source) {",
        "        $item = Get-Item -LiteralPath $source -Force",
        "        if ($item.Attributes -band [IO.FileAttributes]::ReparsePoint) {",
        "            Write-Host \"检测到已存在的联接点：$source，跳过创建\"",
        "            return",
        "        }",
        "        if (-not $item.PSIsContainer) {",
        "            throw \"配置路径已存在且不是目录：$source\"",
        "        }",
        "",
        "        & robocopy $source $target /E /R:1 /W:1 /NFL /NDL /NJH /NJS /NP | Out-Null",
        "        if ($LASTEXITCODE -gt 7) {",
        "            Write-Host \"迁移失败，保留原目录：$source\"",
        "            return",
        "        }",
        "",
        "        $backup = \"$source.backup-$(Get-Date -Format 'yyyyMMdd-HHmmss')\"",
        "        try {",
        "            Move-Item -LiteralPath $source -Destination $backup -Force",
        "            Write-Host \"已备份原配置目录：$backup\"",
        "        } catch {",
        "            Write-Host \"无法重命名原目录：$source\"",
        "            return",
        "        }",
        "    }",
        "",
        "    New-Item -Path $source -ItemType Junction -Value $target | Out-Null",
        "}",
        "",
        "& $createJunction (Join-Path $env:APPDATA 'openpencil') 'data'",
        "& $createJunction (Join-Path $env:USERPROFILE '.openpencil') 'dotopenpencil'"
    ],
    "persist": [
        "data",
        "dotopenpencil"
    ],
    "checkver": {
        "url": "https://api.github.com/repos/ZSeven-W/openpencil/releases",
        "jsonpath": "$[0].tag_name",
        "regex": "v(?<version>[\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/ZSeven-W/openpencil/releases/download/v$version/openpencil-desktop-windows-x86_64.zip"
            }
        },
        "hash": {
            "mode": "download"
        }
    }
}
