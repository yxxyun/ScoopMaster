{
    "version": "0.26.3",
    "description": "A terminal AI chat: local models via llama.cpp, or OpenAI, Anthropic, Gemini, Grok and OpenRouter, with persistent memory, notes, RAG and tools.",
    "homepage": "https://mindfork.io",
    "license": "MIT",
    "notes": [
        "Chats, notes and settings live in %APPDATA%\\mindfork-rs\\data: an update or an uninstall leaves them in place.",
        "No model yet? 'mindfork demo' opens the app with sample chats and a scripted engine."
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/vshylov/mindfork-rs/releases/download/v0.26.3/mindfork-rs-v0.26.3-x86_64-windows.zip",
            "hash": "c3363a2bf092ad32a474b7e87dea279b5caef53b711720d6883cdf77b4e334f3"
        }
    },
    "installer": {
        "script": "Set-Content -LiteralPath \"$dir\\defaults.json\" -Value '{ \"mode\": \"system\" }' -Encoding Ascii"
    },
    "bin": "mindfork.exe",
    "shortcuts": [
        [
            "mindfork.exe",
            "mindfork"
        ]
    ],
    "checkver": {
        "github": "https://github.com/vshylov/mindfork-rs"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/vshylov/mindfork-rs/releases/download/v$version/mindfork-rs-v$version-x86_64-windows.zip"
            }
        },
        "hash": {
            "url": "$baseurl/sha256sums.txt"
        }
    }
}
