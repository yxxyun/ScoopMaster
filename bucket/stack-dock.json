{
    "version": "0.2.0-beta",
    "description": "Customizable Windows dock for apps, games, files, folders, and links.",
    "homepage": "https://github.com/TNVR-HSN/stack-dock",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/TNVR-HSN/stack-dock/releases/download/v0.2.0-beta/StackDock_0.2.0-beta_x64_portable.zip",
            "hash": "802451a6fe035daa9e5d796fdb5bedc382a3bc254969229750b7df23c592490d",
            "extract_dir": "StackDock_0.2.0-beta_x64_portable"
        }
    },
    "persist": [
        "profile"
    ],
    "post_install": [
        "$ErrorActionPreference = 'Stop'",
        "$appDataPath = Join-Path $env:LOCALAPPDATA 'com.stackdock.launcher'",
        "$persistProfilePath = Join-Path $persist_dir 'profile'",
        "New-Item -ItemType Directory -Path $persistProfilePath -Force | Out-Null",
        "$existing = Get-Item -LiteralPath $appDataPath -Force -ErrorAction SilentlyContinue",
        "$alreadyLinked = $false",
        "if ($null -ne $existing) {",
        "    if (($existing.Attributes -band [IO.FileAttributes]::ReparsePoint) -ne 0) {",
        "        if ($existing.LinkType -eq 'Junction' -and [IO.Path]::GetFullPath([string]$existing.Target) -ieq [IO.Path]::GetFullPath($persistProfilePath)) {",
        "            $alreadyLinked = $true",
        "        } else {",
        "            throw ('Refusing to replace an unexpected reparse point at ' + $appDataPath)",
        "        }",
        "    } else {",
        "        $appItems = @(Get-ChildItem -LiteralPath $appDataPath -Force)",
        "        $persistItems = @(Get-ChildItem -LiteralPath $persistProfilePath -Force)",
        "        if ($appItems.Count -gt 0 -and $persistItems.Count -gt 0) {",
        "            throw ('Both ' + $appDataPath + ' and ' + $persistProfilePath + ' contain data; refusing to overwrite either location.')",
        "        }",
        "        if ($appItems.Count -gt 0) { $appItems | Move-Item -Destination $persistProfilePath }",
        "        Remove-Item -LiteralPath $appDataPath -Force",
        "    }",
        "}",
        "if (-not $alreadyLinked) { New-Item -ItemType Junction -Path $appDataPath -Target $persistProfilePath | Out-Null }"
    ],
    "pre_uninstall": [
        "$appDataPath = Join-Path $env:LOCALAPPDATA 'com.stackdock.launcher'",
        "$persistProfilePath = Join-Path $persist_dir 'profile'",
        "$existing = Get-Item -LiteralPath $appDataPath -Force -ErrorAction SilentlyContinue",
        "if ($null -ne $existing -and",
        "    ($existing.Attributes -band [IO.FileAttributes]::ReparsePoint) -ne 0 -and",
        "    $existing.LinkType -eq 'Junction' -and",
        "    [IO.Path]::GetFullPath([string]$existing.Target) -ieq [IO.Path]::GetFullPath($persistProfilePath)) {",
        "    $removeCommand = 'rmdir \"' + $appDataPath + '\"'",
        "    & $env:ComSpec /d /c $removeCommand",
        "    if ($LASTEXITCODE -ne 0) { throw ('Failed to remove the StackDock LocalAppData junction; cmd exit code: ' + $LASTEXITCODE) }",
        "}"
    ],
    "shortcuts": [
        [
            "StackDock_portable.exe",
            "StackDock"
        ]
    ],
    "checkver": {
        "github": "https://github.com/TNVR-HSN/stack-dock",
        "jsonpath": "$.tag_name",
        "regex": "^v(?<version>[\\d.]+-[\\w.]+)$"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/TNVR-HSN/stack-dock/releases/download/v$version/StackDock_$version_x64_portable.zip",
                "extract_dir": "StackDock_$version_x64_portable",
                "hash": {
                    "url": "https://api.github.com/repos/TNVR-HSN/stack-dock/releases/tags/v$version",
                    "jsonpath": "$.assets[?(@.name == 'StackDock_$version_x64_portable.zip')].digest"
                }
            }
        }
    },
    "notes": [
        "Uses the official portable ZIP; it does not run the NSIS or MSI installer.",
        "The Tauri WebView2 profile in %LOCALAPPDATA%\\com.stackdock.launcher is redirected to Scoop persist and retained after uninstall.",
        "Microsoft Edge WebView2 Runtime is required."
    ]
}
