{
  "version": "3.2.0",
  "description": "ZTools - An extensible application launcher",
  "homepage": "https://github.com/ZToolsCenter/ZTools",
  "license": "MIT",
  "architecture": {
    "64bit": {
      "url": "https://github.com/ZToolsCenter/ZTools/releases/download/v3.2.0/ZTools-3.2.0-win-x64.zip",
      "hash": "cfbee38dd75a139903592178baea67b827aa943b20184906d72aee2ae23456d6"
    }
  },
  "shortcuts": [
    [
      "ZTools.exe",
      "ZTools"
    ]
  ],
  "pre_install": [
    "$legacyDataDir = \"$env:USERPROFILE\\.ztools\"",
    "$persistDataDir = \"$persist_dir\\data\"",
    "Write-Host ''",
    "if (Test-Path -LiteralPath $persistDataDir) {",
    "    info \"Using existing data at '$persistDataDir'; skipping migration.\"",
    "    return",
    "}",
    "if (!(Test-Path -LiteralPath $legacyDataDir -PathType Container)) {",
    "    info \"No existing ZTools data found at '$legacyDataDir'; skipping migration.\"",
    "    return",
    "}",
    "info \"Copying ZTools data from '$legacyDataDir' to '$persistDataDir'...\"",
    "New-Item -ItemType Directory -Path $persist_dir -Force -ErrorAction Stop | Out-Null",
    "Copy-Item -LiteralPath $legacyDataDir -Destination $persistDataDir -Recurse -Force -ErrorAction Stop",
    "info \"ZTools data copied. You may manually delete '$legacyDataDir'.\""
  ],
  "env_set": {
    "ZTOOLS_DATA_ROOT": "$persist_dir\\data"
  },
  "uninstaller": {
    "script": [
      "if ($cmd -eq 'uninstall') {",
      "    Write-Host ''",
      "    info 'Removing ZTools startup entries...'",
      "    $keys = @(",
      "        'HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Run',",
      "        'HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\StartupApproved\\Run'",
      "    )",
      "    foreach ($key in $keys) {",
      "        Remove-ItemProperty -Path $key -Name 'top.z-tools' -ErrorAction SilentlyContinue",
      "    }",
      "    info 'ZTools startup entry cleanup finished.'",
      "    $tempRoot = [IO.Path]::GetFullPath([IO.Path]::GetTempPath())",
      "    $tempDirs = @('ztools-plugin-download', 'ztools-npm-download', 'ztools-zbrowser')",
      "    foreach ($name in $tempDirs) {",
      "        $tempPath = [IO.Path]::GetFullPath((Join-Path $tempRoot $name))",
      "        if (!(Test-Path -LiteralPath $tempPath -PathType Container)) {",
      "            continue",
      "        }",
      "        info \"Removing temporary directory '$tempPath'...\"",
      "        try {",
      "            Remove-Item -LiteralPath $tempPath -Recurse -Force -ErrorAction Stop",
      "        } catch {",
      "            warn \"Could not remove '$tempPath': $($_.Exception.Message)\"",
      "        }",
      "    }",
      "    $roamingDataDir = Join-Path $env:APPDATA 'ZTools'",
      "    if (Test-Path -LiteralPath $roamingDataDir -PathType Container) {",
      "        try {",
      "            [IO.Directory]::Delete($roamingDataDir, $false)",
      "            info \"Removed empty directory '$roamingDataDir'.\"",
      "        } catch {",
      "            warn \"Preserved '$roamingDataDir': $($_.Exception.Message)\"",
      "        }",
      "    }",
      "}"
    ]
  },
  "checkver": {
    "github": "https://github.com/ZToolsCenter/ZTools"
  },
  "autoupdate": {
    "architecture": {
      "64bit": {
        "url": "https://github.com/ZToolsCenter/ZTools/releases/download/v$version/ZTools-$version-win-x64.zip"
      }
    }
  }
}
