    "uninstaller": {
        "script": [
            "# Run at login points at this install; settings in $env:APPDATA\\Porta are kept.",
            "if ($cmd -eq 'uninstall') { Remove-ItemProperty -Path 'HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Run' -Name 'Porta' -ErrorAction SilentlyContinue }"
