{
    "$schema": "https://raw.githubusercontent.com/ScoopInstaller/Scoop/master/schema.json",
    "version": "1.0.0",
    "description": "Run scoop core's bin\\checkver.ps1 against the local buckets (scoop dir resolved dynamically; extra args forwarded)",
    "homepage": "https://github.com/gdm257/scoop-257",
    "license": "Unlicense",
    "url": ["https://unlicense.org/UNLICENSE"],
    "installer": {
        "script": [
            "Copy-Item -Path (Join-Path $bucketsdir $bucket 'scripts\\scoop-checkver\\scoop-checkver.ps1') -Destination (Join-Path $dir 'scoop-checkver.ps1') -Force"
        ]
    },
    "bin": "scoop-checkver.ps1"
}
