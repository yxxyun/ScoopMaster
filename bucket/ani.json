{
    "version": "6.4.0-beta01",
    "description": "一站式在线番剧追番与弹幕平台",
    "homepage": "https://github.com/open-ani/ani",
    "license": "GPL-3.0-only",
    "architecture": {
        "64bit": {
            "url": "https://github.com/open-ani/ani/releases/download/v6.4.0-beta01/ani-6.4.0-beta01-windows-x86_64.zip",
            "hash": "7ec89535a5494d3c0702fc796c1f5db161a2dc0d9e73ab8f4e0172797c0bf879",
            "extract_dir": "Ani"
        }
    },
    "bin": "Ani.exe",
    "shortcuts": [
        [
            "Ani.exe",
            "Ani"
        ]
    ],
    "installer": {
        "script": [
            "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name mqbucket) scripts/AppsUtils.psm1)",
            "Mount-ExternalRuntimeData -Source \"$persist_dir\\data\" -Target \"$env:APPDATA\\Him188\"",
            "Remove-Module -Name AppsUtils"
        ]
    },
    "uninstaller": {
        "script": [
            "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name mqbucket) scripts/AppsUtils.psm1)",
            "Dismount-ExternalRuntimeData -Target \"$env:APPDATA\\Him188\"",
            "Remove-Module -Name AppsUtils"
        ]
    },
    "checkver": {
        "url": "https://api.github.com/repos/open-ani/ani/releases",
        "jsonpath": "$..tag_name",
        "regex": "v([-\\d.\\w]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/open-ani/ani/releases/download/v$version/ani-$version-windows-x86_64.zip"
            }
        }
    }
}
