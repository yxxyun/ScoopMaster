{
    "version": "5.2",
    "description": "Run console applications and batch files without any window",
    "homepage": "https://www.ntwind.com/software/hstart.html",
    "license": "Proprietary",
    "url": "https://www.ntwind.com/download/Hstart_5.2-setup.exe",
    "hash": "34bbae916f913757d22f7ffde4bd618754eba3ad363472afb48433e446f37e89",
    "depends": "main/7zip",
    "installer": {
        "script": [
            "7z x \"$dir\\$fname\" -o\"$dir\" -aou -y | Out-Null",
            "Remove-Item \"$dir\\$fname\"",
            "Remove-Item \"$dir\\*PLUGINSDIR\" -Recurse -Force -ErrorAction SilentlyContinue",
            "Remove-Item \"$dir\\*.nsis\" -ErrorAction SilentlyContinue",
            "Remove-Item \"$dir\\uninst.exe\" -ErrorAction SilentlyContinue",
            "$machine = @{}",
            "@(\"hstart64.exe\", \"hstart.exe\") | Where-Object { Test-Path \"$dir\\$_\" } | ForEach-Object { $fs = [IO.File]::OpenRead(\"$dir\\$_\"); $br = New-Object IO.BinaryReader($fs); $fs.Position = 0x3C; $peOffset = $br.ReadInt32(); $fs.Position = $peOffset + 4; $machine[$_] = $br.ReadUInt16(); $br.Close(); $fs.Close() }",
            "$x64exe = ($machine.GetEnumerator() | Where-Object { $_.Value -eq 0x8664 }).Name",
            "$x86exe = ($machine.GetEnumerator() | Where-Object { $_.Value -eq 0x014c }).Name",
            "Rename-Item \"$dir\\$x64exe\" \"hstart64.exe\" -ErrorAction SilentlyContinue",
            "Rename-Item \"$dir\\$x86exe\" \"hstart32.exe\""
        ]
    },
    "architecture": {
        "64bit": {
            "bin": [
                [
                    "hstart64.exe",
                    "hstart"
                ],
                [
                    "hstart64.exe",
                    "hstart64"
                ],
                [
                    "hstart32.exe",
                    "hstart32"
                ]
            ],
            "shortcuts": [
                [
                    "HstartUI.exe",
                    "Hidden Start"
                ]
            ]
        },
        "32bit": {
            "bin": [
                [
                    "hstart32.exe",
                    "hstart"
                ],
                [
                    "hstart32.exe",
                    "hstart32"
                ]
            ],
            "shortcuts": [
                [
                    "HstartUI.exe",
                    "Hidden Start"
                ]
            ]
        }
    },
    "checkver": {
        "url": "https://www.ntwind.com/download-all.html",
        "regex": "Hstart_([\\d.]+)-setup\\.exe"
    },
    "autoupdate": {
        "url": "https://www.ntwind.com/download/Hstart_$version-setup.exe"
    }
}
