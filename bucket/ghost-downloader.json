{
    "##": "Inno Setup 6.7 installer, silent install straight into the Scoop version dir (/DIR=$dir). The installer honours /NOICONS only partially: it still drops 'Ghost Downloader.lnk' into the user Programs folder, so that leftover is removed afterwards and the Scoop-managed shortcut (Scoop Apps) is the single entry point. Removal delegates to the bundled unins000.exe.",
    "version": "4.6.1",
    "description": "Ghost Downloader 3 — 多线程/多任务下载器（Python + PySide6/Qt 6 图形界面），支持 HTTP/磁力/BT、浏览器扩展接管、多协议下载与插件式功能包",
    "homepage": "https://github.com/XiaoYouChR/Ghost-Downloader-3",
    "license": {
        "identifier": "GPL-3.0",
        "url": "https://github.com/XiaoYouChR/Ghost-Downloader-3/blob/main/LICENSE"
    },
    "notes": [
        "安装版（Inno Setup 静默安装到 Scoop 目录），卸载走包内 unins000.exe",
        "启动：Ghost-Downloader（Scoop shim）或开始菜单「Scoop Apps → Ghost Downloader 3」",
        "配置与下载记录在 %APPDATA%\\GhostDownloader，Scoop 不接管",
        "免安装/便携版请装 Ghost-Downloader-portable 包"
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/XiaoYouChR/Ghost-Downloader-3/releases/download/v4.6.1/Ghost-Downloader-v4.6.1-Windows-x86_64-Setup.exe",
            "hash": "6c6d637df0f748df6d67c1c75fbc614a454a9491e007a9665cf2b769b3044c7c"
        }
    },
    "installer": {
        "script": [
            "$installer = Join-Path $dir $fname",
            "Start-Process -FilePath $installer -ArgumentList '/VERYSILENT', '/SUPPRESSMSGBOXES', '/NORESTART', '/SP-', '/NOICONS', \"/MERGETASKS=!desktopicon\", \"/DIR=$dir\" -Wait",
            "Remove-Item $installer -Force -ErrorAction SilentlyContinue",
            "# the installer ignores /NOICONS for the application group link - drop it so only the Scoop shortcut remains",
            "$programs = [Environment]::GetFolderPath('Programs')",
            "Get-ChildItem -LiteralPath $programs -Filter 'Ghost Downloader*.lnk' -ErrorAction SilentlyContinue | Remove-Item -Force -ErrorAction SilentlyContinue"
        ]
    },
    "uninstaller": {
        "script": [
            "$u = Join-Path $dir 'unins000.exe'",
            "if (Test-Path -LiteralPath $u) { Start-Process -FilePath $u -ArgumentList '/VERYSILENT', '/SUPPRESSMSGBOXES', '/NORESTART' -Wait }"
        ]
    },
    "checkver": {
        "github": "https://github.com/XiaoYouChR/Ghost-Downloader-3"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/XiaoYouChR/Ghost-Downloader-3/releases/download/v$version/Ghost-Downloader-v$version-Windows-x86_64-Setup.exe"
            }
        }
    },
    "bin": [
        [
            "Ghost-Downloader-3.exe",
            "Ghost-Downloader"
        ]
    ],
    "shortcuts": [
        [
            "Ghost-Downloader-3.exe",
            "Ghost Downloader 3"
        ]
    ]
}
