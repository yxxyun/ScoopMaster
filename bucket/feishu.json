        }
    },
    "extract_to": "app",
    "shortcuts": [
        [
            "app/Feishu.exe",
            "Feishu"
        ]
    ],
    "checkver": {
        "url": "https://www.feishu.cn/api/downloads",
        "script": [
            "$release = $page | ConvertFrom-Json",
            "$version = $release.versions.Windows.version_number -replace 'Windows@V?', ''",
            "$id32 = if ($release.versions.Windows.download_link -match '(?<=/)\\w+(?=/Feishu-win32)') { $Matches[0] }",
            "$id64 = if ($release.versions.Windows_x64.download_link -match '(?<=/)\\w+(?=/Feishu-win32)') { $Matches[0] }",
            "Write-Output \"$version $id32 $id64\""
        ],
        "regex": "(?<version>[\\d.]+) (?<id32>\\w+) (?<id64>\\w+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://sf3-cn.feishucdn.com/obj/ee-appcenter/$matchId64/Feishu-win32_x64-$version-signed.exe#/feishu-$version.7z",
                "hash": {
                    "url": "https://www.feishu.cn/api/downloads",
                    "jsonpath": "$.versions.Windows_x64.hash"
                }
            },
            "32bit": {
                "url": "https://sf3-cn.feishucdn.com/obj/ee-appcenter/$matchId32/Feishu-win32_ia32-$version-signed.exe#/feishu-$version.7z",
                "hash": {
                    "url": "https://www.feishu.cn/api/downloads",
                    "jsonpath": "$.versions.Windows.hash"
                }
            }
        }
    }
