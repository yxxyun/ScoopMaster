{
    "version": "26.9.0",
    "description": "An AI Chatbot for many LLMs",
    "homepage": "https://chatwise.app/",
    "license": "Freeware",
    "architecture": {
        "64bit": {
            "url": "https://releases.chatwise.app/26.9.0/ChatWise-26.9.0-setup.exe#/dl.7z",
            "hash": "12520e5b9ec5b8636920a36c75c30145c32d58bcde02c8089073ad520b0317b7"
        }
    },
    "installer": {
        "script": [
            "Expand-7ZipArchive \"$dir\\`$PLUGINSDIR\\app-64.7z\" \"$dir\" -Removal",
            "Remove-Item \"$dir\\`$*\", \"$dir\\Uninstall*\", \"$dir\\resources\\app-update.yml\" -Force -Recurse -ErrorAction SilentlyContinue | Out-Null",
            "Remove-Item \"$env:LOCALAPPDATA\\chatwise-updater\" -Force -Recurse -ErrorAction SilentlyContinue | Out-Null"
        ]
    },
    "shortcuts": [
        [
            "ChatWise.exe",
            "ChatWise"
        ]
    ],
    "pre_uninstall": "Remove-Item \"$env:LOCALAPPDATA\\chatwise-updater\" -Force -Recurse -ErrorAction SilentlyContinue | Out-Null",
    "checkver": {
        "url": "https://releases.chatwise.app/releases",
        "jsonpath": "$[0].version"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://releases.chatwise.app/$version/ChatWise-$version-setup.exe#/dl.7z"
            }
        },
        "hash": {
            "mode": "download"
        }
    }
}
