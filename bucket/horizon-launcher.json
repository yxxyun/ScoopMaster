{
    "version": "0.2.65",
    "description": "Launcher for Horizon, a Minecraft: Java Edition reimplementation written in Rust.",
    "homepage": "https://playhorizon.dev",
    "license": {
        "identifier": "MIT",
        "url": "https://github.com/horizon-rust/horizon/blob/main/LICENSE"
    },
    "url": "https://github.com/horizon-rust/horizon/releases/download/launcher%400.2.65/horizon-launcher-windows-x64.zip",
    "hash": "75094660b109169d5511436ceffdd172323e4e61848801c002224fbb2cfa2836",
    "env_set": {
        "HORIZON_LAUNCHER_HOME": "$persist_dir\\launcher",
        "HORIZON_HOME": "$persist_dir\\game",
        "HORIZON_LAUNCHER_NO_SELF_UPDATE": "1"
    },
    "post_install": [
        "# Keep data of a launcher installed outside Scoop: move %APPDATA% folders into the persisted ones.",
        "if (Get-Process horizon-launcher -ErrorAction SilentlyContinue) {",
        "    warn 'Horizon Launcher was running, so its old data stays in %APPDATA%: close it and reinstall the app to move that data into the persist folder.'",
        "} else {",
        "    @{ \"$env:APPDATA\\horizon-launcher\" = \"$persist_dir\\launcher\"; \"$env:APPDATA\\horizon\" = \"$persist_dir\\game\" }.GetEnumerator() | ForEach-Object {",
        "        $old = $_.Key",
        "        $new = $_.Value",
        "        if (!(Test-Path $new)) { New-Item -ItemType Directory -Path $new -Force | Out-Null }",
        "        if (!(Test-Path $old)) { return }",
        "        if ((Get-Item $old -Force).Attributes -band [IO.FileAttributes]::ReparsePoint) { return }",
        "        robocopy $old $new /E /MOVE /R:1 /W:1 /NFL /NDL /NJH /NJS /NP | Out-Null",
        "        if ($LASTEXITCODE -ge 8) { warn \"Some files could not be moved from $old to $new (robocopy exit code $LASTEXITCODE).\" }",
        "    }",
        "}"
    ],
    "bin": [
        [
            "horizon-launcher.exe",
            "horizon-launcher"
        ]
    ],
    "shortcuts": [
        [
            "horizon-launcher.exe",
            "Horizon Launcher"
        ]
    ],
    "checkver": {
        "url": "https://api.github.com/repos/horizon-rust/horizon/releases?per_page=30",
        "jsonpath": "$[*].tag_name",
        "regex": "launcher@([\\d.]+)"
    },
    "autoupdate": {
        "url": "https://github.com/horizon-rust/horizon/releases/download/launcher%40$version/horizon-launcher-windows-x64.zip",
        "hash": {
            "url": "$baseurl/SHA256SUMS"
        }
    }
}
