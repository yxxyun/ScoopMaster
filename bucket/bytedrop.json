{
    "version": "1.0.0",
    "description": "Transfer files and clipboard text between a Windows PC and remote browsers over LAN, Mobile Hotspot, or a Cloudflare tunnel.",
    "homepage": "https://github.com/HusseinWalid48/ByteDrop",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/HusseinWalid48/ByteDrop/releases/download/v1.0.0/ByteDrop.exe",
            "hash": "1de5924afb3d250da4c97cf20762f402f43a58e51c573203bbc50070da7098be"
        }
    },
    "shortcuts": [
        [
            "ByteDrop.exe",
            "ByteDrop"
        ]
    ],
    "env_set": {
        "BYTEDROP_APPDATA": "$persist_dir\\data"
    },
    "checkver": {
        "url": "https://api.github.com/repos/HusseinWalid48/ByteDrop/releases/latest",
        "jsonpath": "$.tag_name",
        "regex": "^v([\\d.]+)$"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/HusseinWalid48/ByteDrop/releases/download/v$version/ByteDrop.exe",
                "hash": {
                    "url": "https://api.github.com/repos/HusseinWalid48/ByteDrop/releases/tags/v$version",
                    "regex": "\"name\"\\s*:\\s*\"ByteDrop\\.exe\"[\\s\\S]*?\"digest\"\\s*:\\s*\"sha256:([a-f0-9]{64})\""
                }
            }
        }
    },
    "notes": [
        "ByteDrop stores settings, history, logs, and its downloaded cloudflared binary in the Scoop persist directory through BYTEDROP_APPDATA. Received files default to %USERPROFILE%\\Downloads\\ByteDrop.",
        "The single-file release handles PyInstaller's runtime extraction under %TEMP%. Cloud Link downloads cloudflared on demand and verifies its SHA-256 before execution."
    ]
}
