{
    "homepage": "https://tomcat.apache.org",
    "version": "10.1.60",
    "checkver": {
        "url": "https://www.apache.org/dist/tomcat/tomcat-10/?C=M;O=D",
        "re": "v(?<version>[\\d.]+)"
    },
    "autoupdate": {
        "extract_dir": "apache-tomcat-$version",
        "architecture": {
            "32bit": {
                "url": "https://www.apache.org/dist/tomcat/tomcat-10/v$version/bin/apache-tomcat-$version-windows-x86.zip"
            },
            "64bit": {
                "url": "https://www.apache.org/dist/tomcat/tomcat-10/v$version/bin/apache-tomcat-$version-windows-x64.zip"
            }
        },
        "hash": {
            "url": "$url.sha512"
        }
    },
    "extract_dir": "apache-tomcat-10.1.60",
    "bin": "bin\\catalina.bat",
    "env_set": {
        "CATALINA_HOME": "$dir",
        "CATALINA_BASE": "$dir"
    },
    "suggest": {
        "JRE": "java/openjdk"
    },
    "architecture": {
        "64bit": {
            "url": "https://www.apache.org/dist/tomcat/tomcat-10/v10.1.60/bin/apache-tomcat-10.1.60-windows-x64.zip",
            "hash": "sha512:0ce586fb15b528d417ef4dd0e479529c9c92fe19f3942be239aa098fd99e14e7b76c96046258f400fa25c239fbba55a1509d046db17846e6144d4feeb17d32e4"
        },
        "32bit": {
            "url": "https://www.apache.org/dist/tomcat/tomcat-10/v10.1.60/bin/apache-tomcat-10.1.60-windows-x86.zip",
            "hash": "sha512:23ac4ec422cb201c8d9f38f00d1774316c6b69efbf7f02e92ab274c8f7df17ce1735e5d7fe88884a0e7d2d56e9f8e4d07989bcdef612d4e3cc33dc34d2cadbcc"
        }
    }
}
