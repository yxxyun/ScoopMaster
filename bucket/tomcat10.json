{
    "homepage": "https://tomcat.apache.org",
    "version": "10.1.59",
    "checkver": {
        "url": "https://www.apache.org/dist/tomcat/tomcat-10/?C=M;O=D",
        "re": "v(?<version>[\\d.]+)"
    },
    "autoupdate": {
        "extract_dir": "apache-tomcat-$version",
        "architecture": {
            "32bit": {
                "url": "https://www.apache.org/dist/tomcat/tomcat-10/v$version/bin/apache-tomcat-$version-windows-x86.zip"
            },
            "64bit": {
                "url": "https://www.apache.org/dist/tomcat/tomcat-10/v$version/bin/apache-tomcat-$version-windows-x64.zip"
            }
        },
        "hash": {
            "url": "$url.sha512"
        }
    },
    "extract_dir": "apache-tomcat-10.1.59",
    "bin": "bin\\catalina.bat",
    "env_set": {
        "CATALINA_HOME": "$dir",
        "CATALINA_BASE": "$dir"
    },
    "suggest": {
        "JRE": "java/openjdk"
    },
    "architecture": {
        "64bit": {
            "url": "https://www.apache.org/dist/tomcat/tomcat-10/v10.1.59/bin/apache-tomcat-10.1.59-windows-x64.zip",
            "hash": "sha512:62d7e5eb78ec98c2e6d7d3104b63376035427c6a5c683ca6a241d258c0c32d76f538c85a59f2e4e804ec7c9f9f3118160a796032938fec56e96ea59c22d09a36"
        },
        "32bit": {
            "url": "https://www.apache.org/dist/tomcat/tomcat-10/v10.1.59/bin/apache-tomcat-10.1.59-windows-x86.zip",
            "hash": "sha512:b3b6b0e6e3588f7e94d497b0099780f30f6dd42550fac594ca2d05735d7b4f1435b327e100dc8340c3acf5f1e3476ccf2e999a85adb40d23647c48c35e098f62"
        }
    }
}
