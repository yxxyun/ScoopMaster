{
    "version": "1.0.4",
    "description": "Clipboard manager for Windows. Alternative to Ditto.",
    "homepage": "https://github.com/farzher/clipman",
    "licease": {
        "identifier": "Unknown"
    },
    "notes": [
        "The manifest does not support persisting custom database name after an update.",
        "Only the default file name clipman.db is allowed."
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/farzher/clipman/releases/download/v1.0.4/clipman.zip",
            "hash": "edea1eec1aedb6aa084205d28447a14560b66d78a708f3677c679a833b2afa2f"
        }
    },
    "pre_install": [
        "if ((!(Test-Path \"$persist_dir\\clipman.db\")) -or (!(Test-Path \"$persist_dir\\clipman.ini\"))) {",
        "    Write-Host 'File clipman.db or clipman.ini does not exists. Creating.' -f Yellow",
        "    Start-Process -FilePath \"$dir\\clipman.exe\" -WindowStyle Minimized",
        "    while ((!(Test-Path \"$dir\\clipman.db\")) -or (!(Test-Path \"$dir\\clipman.ini\"))) {",
        "        Start-Sleep -Milliseconds 500",
        "    }",
        "    Stop-Process -Name clipman",
        "}"
    ],
    "bin": "clipman.exe",
    "persist": [
        "clipman.db",
        "clipman.ini"
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/farzher/clipman/releases/download/v$version/clipman.zip"
            }
        }
    }
}
