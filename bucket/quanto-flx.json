{
    "version": "2.00.1110",
    "description": "A desktop customization tool based on Rainmeter",
    "homepage": "https://github.com/stevehsudrawing/quantoflx",
    "license": {
        "identifier": "Freeware",
        "url": "https://raw.githubusercontent.com/stevehsudrawing/quantoflx/refs/heads/main/LICENSE.txt"
    },
    "url": "https://github.com/stevehsudrawing/quantoflx/releases/download/1110/Quanto.Flx_2.00.Epsilon.Build.1110.rmskin#/quantoflx.rmskin",
    "hash": "3a30765ce75e97c84dc725d1a3418c04f90859ebbd8a5453e550e6cb8d141f63",
    "depends": "rainmeter",
    "checkver": {
        "script": [
            "$headers = @{ 'User-Agent' = 'KiroBucket-ScoopCheckver'; 'Accept' = 'application/vnd.github+json' }",
            "$releases = @(Invoke-RestMethod -Uri 'https://api.github.com/repos/stevehsudrawing/quantoflx/releases?per_page=1' -Headers $headers -TimeoutSec 30)",
            "if ($releases.Count -eq 0) { throw 'GitHub did not return a Quanto Flx release.' }",
            "$release = $releases[0]",
            "$asset = @($release.assets | Where-Object { $_.name -match '\\.rmskin$' } | Select-Object -First 1)",
            "if ($asset.Count -eq 0) { throw 'The latest Quanto Flx release has no RMSKIN asset.' }",
            "$tag = [string]$release.tag_name",
            "$mainVersion = ([string]$release.name -split '\\s+')[0]",
            "if ([string]::IsNullOrWhiteSpace($tag) -or [string]::IsNullOrWhiteSpace($mainVersion)) { throw 'The Quanto Flx release is missing its version or tag.' }",
            "$version = \"$mainVersion.$tag\"",
            "Write-Output \"$version $tag $($asset[0].name)\""
        ],
        "regex": "^(?<version>\\S+)\\s(?<tag>\\S+)\\s(?<name>.+\\.rmskin)$"
    },
    "notes": "quanto-flx can be installed by SkinInstaller.exe",
    "autoupdate": {
        "url": "https://github.com/stevehsudrawing/quantoflx/releases/download/$matchTag/$matchName#/quantoflx.rmskin"
    }
}
