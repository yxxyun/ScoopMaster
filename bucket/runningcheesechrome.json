{
    "version": "1.4.0",
    "description": "RunningCheese Chrome 定制版便携浏览器",
    "homepage": "https://www.runningcheese.com/chrome",
    "license": "Freeware",
    "architecture": {
        "64bit": {
            "url": "https://github.com/TuringRiff/browser-pkg-test/releases/download/v1.4.0/RunningCheeseChrome.7z",
            "hash": "d1fc1c797d4f6a2332eaca5d1808d6b20e67aa0823ad0caf8c29f5639c2f45cd"
        }
    },
    "post_install": [
        "# 更新时 Scoop 会把新包的 Data、Tools 备份为 .original 并链接回持久化数据；此处清理不需要的备份。",
        "if (Test-Path \"$dir\\Data.original\") { Remove-Item \"$dir\\Data.original\" -Recurse -Force -ErrorAction SilentlyContinue }",
        "if (Test-Path \"$dir\\Tools.original\") { Remove-Item \"$dir\\Tools.original\" -Recurse -Force -ErrorAction SilentlyContinue }",
        "# 等效于官方根目录 开始.bat：在包根目录生成 Chrome.lnk。",
        "$ws = New-Object -ComObject WScript.Shell",
        "$lnk = $ws.CreateShortcut((Join-Path $dir 'Chrome.lnk'))",
        "$lnk.TargetPath = (Join-Path $dir 'App\\chrome.exe')",
        "$lnk.Arguments = '--disable-features=ExtensionManifestV2Unsupported,ExtensionManifestV2Disabled'",
        "$lnk.WindowStyle = 1",
        "$lnk.IconLocation = (Join-Path $dir 'App\\chrome.exe')",
        "$lnk.Description = ''",
        "$lnk.WorkingDirectory = $dir",
        "$lnk.Save()"
    ],
    "shortcuts": [
        [
            "App\\chrome.exe",
            "Chrome",
            "--disable-features=ExtensionManifestV2Unsupported,ExtensionManifestV2Disabled"
        ]
    ],
    "persist": [
        "Data",
        "Tools"
    ],
    "checkver": {
        "github": "https://github.com/TuringRiff/browser-pkg-test"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/TuringRiff/browser-pkg-test/releases/download/v$version/RunningCheeseChrome.7z"
            }
        }
    }
}
