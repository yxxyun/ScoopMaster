{
    "version": "12.3.0.1",
    "description": "Auslogics Disk Defrag hard-drive defragmenter",
    "homepage": "https://www.auslogics.com/en/software/disk-defrag/",
    "license": "Proprietary",
    "url": "https://downloads.auslogics.com/en/disk-defrag/auslogics-disk-defrag-setup.exe",
    "hash": "70df633112af4ad86602f69ab266fe8e57fb9873b8f60766fa5c55455c0e6f9e",
    "innosetup": true,
    "bin": "DiskDefrag.exe",
    "shortcuts": [
        [
            "DiskDefrag.exe",
            "Auslogics Disk Defrag"
        ]
    ],
    "checkver": {
        "script": [
            "$html = (Invoke-WebRequest -Uri 'https://www.auslogics.com/en/software/disk-defrag/' -UseBasicParsing).Content",
            "$text = [System.Net.WebUtility]::HtmlDecode([regex]::Replace($html, '<[^>]+>', ' '))",
            "$text = [regex]::Replace($text, '\\s+', ' ')",
            "$match = [regex]::Match($text, '(?i)Version\\s+(?<version>\\d+(?:\\.\\d+){3})')",
            "if (-not $match.Success) { throw 'Unable to detect the Auslogics Disk Defrag version from the official product page.' }",
            "$match.Groups['version'].Value"
        ],
        "regex": "(?<version>\\d+(?:\\.\\d+){3})"
    },
    "autoupdate": {
        "url": "https://downloads.auslogics.com/en/disk-defrag/auslogics-disk-defrag-setup.exe"
    },
    "notes": "Scoop uses Inno Setup extraction to unpack the official installer into the application directory; the installer is not executed."
}
