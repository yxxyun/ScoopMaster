{
    "version": "0.1.0",
    "description": "Native desktop Markdown vault and note editor with structured writing, live preview, and local-first storage.",
    "homepage": "https://github.com/agnogad/GoFolio",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/agnogad/GoFolio/releases/download/v0.1.0/gofolio-setup-0.1.0-amd64.exe",
            "hash": "2861a542a1383e179530862a755af515ae5461e7d6a25f87b8c85292d1959eb5"
        },
        "arm64": {
            "url": "https://github.com/agnogad/GoFolio/releases/download/v0.1.0/gofolio-setup-0.1.0-arm64.exe",
            "hash": "0258ce0dcd73c7ff3cadb7ef9d9c1eff47dd3fe5897750b1b02834e41ff38b9a"
        }
    },
    "installer": {
        "args": [
            "/S",
            "/D=$dir"
        ]
    },
    "uninstaller": {
        "script": ["$uninstaller = Get-ChildItem -LiteralPath $dir -File -Recurse -ErrorAction SilentlyContinue | Where-Object { $_.Name -match '(?i)^(unins\\d*|uninstall.*)\\.exe$' } | Select-Object -First 1","if (-not $uninstaller) { throw 'The application uninstaller was not found in the Scoop version directory.' }","$process = Start-Process -FilePath $uninstaller.FullName -ArgumentList '/S' -WorkingDirectory $uninstaller.DirectoryName -Wait -PassThru","if ($process.ExitCode -ne 0) { throw ('The application uninstaller exited with code {0}.' -f $process.ExitCode) }"]
    },
    "bin": "GoFolio.exe",
    "shortcuts": [
        [
            "GoFolio.exe",
            "GoFolio"
        ]
    ],
    "checkver": {
        "github": "https://github.com/agnogad/GoFolio"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/agnogad/GoFolio/releases/download/v$version/gofolio-setup-$version-amd64.exe",
                "hash": {
                    "mode": "json",
                    "url": "https://api.github.com/repos/agnogad/GoFolio/releases/tags/v$version",
                    "jp": "$.assets[?(@.name == 'gofolio-setup-$version-amd64.exe')].digest"
                }
            },
            "arm64": {
                "url": "https://github.com/agnogad/GoFolio/releases/download/v$version/gofolio-setup-$version-arm64.exe",
                "hash": {
                    "mode": "json",
                    "url": "https://api.github.com/repos/agnogad/GoFolio/releases/tags/v$version",
                    "jp": "$.assets[?(@.name == 'gofolio-setup-$version-arm64.exe')].digest"
                }
            }
        }
    }
}
