{
    "version": "1.0.0-nightly.20261112.87",
    "description": "Lightweight native Discord client written in Rust. Tracks the nightly pre-release.",
    "homepage": "https://github.com/ViceVerse-cz/Serein",
    "license": {
        "identifier": "MIT|Apache-2.0",
        "url": "https://github.com/ViceVerse-cz/Serein#license"
    },
    "notes": [
        "Data lives in Scoop's persist folder (via SEREIN_DATA_DIR). Your login token stays in Windows Credential Manager.",
        "Update with 'scoop update serein-pre' and leave automatic updates off in Settings > Updates, so the in-app updater doesn't change files behind Scoop's back."
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/ViceVerse-cz/Serein/releases/download/v1.0.0-nightly.20261112.87/serein-v1.0.0-nightly.20261112.87-Windows-X64.zip",
            "hash": "b5f9f094271323c84f9620b3fcfa1d75817680e20c2dc6bf6e14ae337c18a55d"
        },
        "arm64": {
            "url": "https://github.com/ViceVerse-cz/Serein/releases/download/v1.0.0-nightly.20261112.87/serein-v1.0.0-nightly.20261112.87-Windows-ARM64.zip",
            "hash": "697ccce43fa9e535fe57bd68bd7c577d17a587660004c6e5d4309f0cf49dfcaf"
        }
    },
    "bin": "serein.exe",
    "env_set": {
        "SEREIN_DATA_DIR": "$dir\\data"
    },
    "persist": "data",
    "post_install": [
        "# Windows toasts need a Start menu shortcut carrying Serein's AppUserModelID, which upstream's script creates",
        "$lnk = Join-Path ([Environment]::GetFolderPath('Programs')) 'Serein.lnk'",
        "$ours = !(Test-Path -LiteralPath $lnk) -or ((New-Object -ComObject WScript.Shell).CreateShortcut($lnk).TargetPath -like \"$(Split-Path $dir)\\*\")",
        "if ($ours) {",
        "    try {",
        "        & \"$dir\\install-notifications.ps1\" -Force | Out-Null",
        "    } catch {",
        "        warn \"Couldn't create Serein's Start menu shortcut: $_\"",
        "    }",
        "} else {",
        "    warn 'Another Serein install already owns the Serein Start menu shortcut, so Scoop left it alone.'",
        "}"
    ],
    "uninstaller": {
        "script": [
            "# Scoop update: post_install refreshes the shortcut, so only remove it on scoop uninstall",
            "if ($cmd -eq 'uninstall') {",
            "    $lnk = Join-Path ([Environment]::GetFolderPath('Programs')) 'Serein.lnk'",
            "    if ((Test-Path -LiteralPath $lnk) -and ((New-Object -ComObject WScript.Shell).CreateShortcut($lnk).TargetPath -like \"$(Split-Path $dir)\\*\")) {",
            "        Remove-Item -LiteralPath $lnk -Force",
            "    }",
            "}"
        ]
    },
    "checkver": {
        "url": "https://api.github.com/repos/ViceVerse-cz/Serein/releases",
        "jsonpath": "$[0].tag_name",
        "regex": "v([\\d.]+(?:-[\\w.]+)?)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/ViceVerse-cz/Serein/releases/download/v$version/serein-v$version-Windows-X64.zip"
            },
            "arm64": {
                "url": "https://github.com/ViceVerse-cz/Serein/releases/download/v$version/serein-v$version-Windows-ARM64.zip"
            }
        },
        "hash": {
            "url": "$baseurl/SHA256SUMS.txt",
            "regex": "$sha256\\s+(?:\\./)?$basename"
        }
    }
}
