{
    "architecture": {
        "64bit": {
            "url": "https://inf.ds.163.com/v1/web/init/server/time#/download.json"
        }
    },
    "autoupdate": {
        "notes": "Installer SHA-256: $matchSha256"
    },
    "checkver": {
        "script": [
            "param([switch]$ResolveRelease)",
            "$base = 'https://inf.ds.163.com/v1/web'",
            "$headers = @{ Origin = 'https://ds.163.com'; Referer = 'https://ds.163.com/pc/'; 'GL-ClientType' = '60'; 'GL-DeviceId' = [guid]::NewGuid().ToString() }",
            "Invoke-RestMethod \"$base/init/server/time\" -Headers $headers -SessionVariable dsSession -UseBasicParsing -ErrorAction Stop | Out-Null",
            "$cookie = $dsSession.Cookies.GetCookies([uri]$base)['GL-XSRF-TOKEN']",
            "if (!$cookie) { throw 'NetEase DS API did not return a session token.' }",
            "$token = [uri]::UnescapeDataString($cookie.Value)",
            "$body = '{}'",
            "$sha1 = [Security.Cryptography.SHA1]::Create()",
            "try {",
            "    $bytes = $sha1.ComputeHash([Text.Encoding]::UTF8.GetBytes($body + $token))",
            "    $headers['GL-CheckSum'] = [BitConverter]::ToString($bytes).Replace('-', '').ToLowerInvariant()",
            "} finally {",
            "    $sha1.Dispose()",
            "}",
            "$headers['GL-X-XSRF-TOKEN'] = $token",
            "$response = Invoke-RestMethod \"$base/pc/pc-channel-package/get-by-channel-id\" -Method Post -Headers $headers -WebSession $dsSession -Body $body -ContentType 'application/json; charset=UTF-8' -UseBasicParsing -ErrorAction Stop",
            "$release = $response.result",
            "$downloadUrl = ([string]$release.x64DownloadLink).Trim()",
            "if (!$downloadUrl) { $downloadUrl = ([string]$release.fullPackageUrl).Trim() }",
            "if ($response.code -ne 200 -or $release.x64Version -notmatch '^\\d+(?:\\.\\d+)+$' -or $downloadUrl -notlike 'https://*') {",
            "    throw 'NetEase DS API did not return a valid x64 release.'",
            "}",
            "if ($ResolveRelease) { return @{ Version = $release.x64Version; Url = $downloadUrl } }",
            "if (!$ForceUpdate -and (!$Update -or $release.x64Version -eq $expected_ver)) { return $release.x64Version }",
            "ensure $cachedir | Out-Null",
            "$archive = Join-Path $cachedir \"$app.$([guid]::NewGuid()).download\"",
            "try {",
            "    Invoke-WebRequest -Uri $downloadUrl -OutFile $archive -UseBasicParsing -ErrorAction Stop",
            "    $sha256 = (Get-FileHash -LiteralPath $archive -Algorithm SHA256 -ErrorAction Stop).Hash.ToLowerInvariant()",
            "    $cacheKey = \"$($json.checkver.url)#/$sha256.7z\"",
            "    $cached = cache_path $app $release.x64Version $cacheKey",
            "    Move-Item -LiteralPath $archive -Destination $cached -Force -ErrorAction Stop",
            "    \"$($release.x64Version) $sha256\"",
            "} finally {",
            "    Remove-Item -LiteralPath $archive -ErrorAction SilentlyContinue",
            "}"
        ],
        "regex": "^(?<version>\\d+(?:\\.\\d+)+)(?: (?<sha256>[a-f0-9]{64}))?$",
        "url": "https://inf.ds.163.com/v1/web/init/server/time"
    },
    "description": "网易大神，超热闹的游戏玩家社交平台。",
    "homepage": "https://ds.163.com/pc/",
    "license": {
        "identifier": "Freeware",
        "url": "https://m.ds.163.com/p/builtin/policy/privacy/"
    },
    "notes": "Installer SHA-256: 0be55ac5e56164144dacae2d556f1a67490eae7c0d269b87f76b00c8422e9a97",
    "pre_install": [
        "if ($manifest.notes -notmatch '^Installer SHA-256: ([a-f0-9]{64})$') {",
        "    throw 'NetEase DS installer SHA-256 is missing from the manifest.'",
        "}",
        "$expectedHash = $Matches[1].ToLowerInvariant()",
        "$cacheKey = \"$($manifest.checkver.url)#/$expectedHash.7z\"",
        "$cached = cache_path $app $version $cacheKey",
        "$archive = Join-Path $dir 'dl.7z'",
        "$stagedCache = $null",
        "try {",
        "    $cacheHit = $false",
        "    if ($use_cache -and (Test-Path -LiteralPath $cached -PathType Leaf)) {",
        "        Copy-Item -LiteralPath $cached -Destination $archive -Force -ErrorAction Stop",
        "        $cacheHit = (Get-FileHash -LiteralPath $archive -Algorithm SHA256 -ErrorAction Stop).Hash -eq $expectedHash",
        "        if ($cacheHit) { Write-Host 'Loading NetEase DS installer from cache.' }",
        "    }",
        "    if (!$cacheHit) {",
        "        $resolveRelease = [scriptblock]::Create($manifest.checkver.script -join \"`n\")",
        "        $release = & $resolveRelease -ResolveRelease",
        "        if ($release.Version -ne $version) {",
        "            throw \"NetEase DS API returned version $($release.Version), but the manifest requires $version.\"",
        "        }",
        "        Invoke-WebRequest -Uri $release.Url -OutFile $archive -UseBasicParsing -ErrorAction Stop",
        "        if ((Get-FileHash -LiteralPath $archive -Algorithm SHA256 -ErrorAction Stop).Hash -ne $expectedHash) {",
        "            throw 'NetEase DS installer SHA-256 mismatch.'",
        "        }",
        "        if ($use_cache) {",
        "            ensure $cachedir | Out-Null",
        "            $stagedCache = \"$cached.$([guid]::NewGuid()).download\"",
        "            Copy-Item -LiteralPath $archive -Destination $stagedCache -ErrorAction Stop",
        "            Move-Item -LiteralPath $stagedCache -Destination $cached -Force -ErrorAction Stop",
        "        }",
        "    }",
        "    Expand-7zipArchive -Path $archive -DestinationPath $dir -Switches '-xr!$PLUGINSDIR'",
        "} finally {",
        "    Remove-Item -LiteralPath $archive -ErrorAction SilentlyContinue",
        "    if ($stagedCache) { Remove-Item -LiteralPath $stagedCache -ErrorAction SilentlyContinue }",
        "}",
        "Remove-Item -LiteralPath (Join-Path $dir 'download.json')",
        "",
        "$targetPath = Join-Path ([Environment]::GetFolderPath('LocalApplicationData')) 'ds_client'",
        "$target = Get-Item -LiteralPath $targetPath -Force -ErrorAction SilentlyContinue",
        "$persist = Get-Item -LiteralPath $persist_dir -Force -ErrorAction SilentlyContinue",
        "if ($persist -and (!$persist.PSIsContainer -or ($persist.Attributes -band [IO.FileAttributes]::ReparsePoint))) {",
        "    throw \"NetEase DS persist path is not a regular directory: $persist_dir\"",
        "}",
        "if ($target.LinkType -eq 'Junction' -and $target.Target.TrimEnd('\\') -eq $persist_dir.TrimEnd('\\')) {",
        "    [IO.Directory]::CreateDirectory($persist_dir) | Out-Null",
        "    return",
        "}",
        "if ($target -and (!$target.PSIsContainer -or ($target.Attributes -band [IO.FileAttributes]::ReparsePoint))) {",
        "    throw \"NetEase DS data path is not a regular directory: $targetPath\"",
        "}",
        "if ($target -and $persist) {",
        "    throw \"NetEase DS data exists at both $targetPath and $persist_dir. Merge or back up the directories before retrying.\"",
        "}",
        "if (Get-Process -Name ds_client,ds_helper,ds_protocol -ErrorAction SilentlyContinue) {",
        "    throw 'Exit NetEase DS before migrating its data directory.'",
        "}",
        "if (!$target) {",
        "    [IO.Directory]::CreateDirectory($persist_dir) | Out-Null",
        "    try {",
        "        New-Item -ItemType Junction -Path $targetPath -Target $persist_dir -ErrorAction Stop | Out-Null",
        "    } catch {",
        "        if (!$persist) { [IO.Directory]::Delete($persist_dir) }",
        "        throw",
        "    }",
        "    return",
        "}",
        "[IO.Directory]::CreateDirectory((Split-Path -Parent $persist_dir)) | Out-Null",
        "$migrationId = [guid]::NewGuid()",
        "$stagingPath = \"$persist_dir.scoop-$migrationId\"",
        "$backupPath = \"$targetPath.scoop-$migrationId\"",
        "try {",
        "    $PSNativeCommandUseErrorActionPreference = $false",
        "    $copyLog = robocopy.exe $targetPath $stagingPath /E /SJ /SL /R:0 /W:0 /NFL /NDL /NP",
        "    if ($LASTEXITCODE -ge 8) { throw \"NetEase DS data copy failed: $($copyLog -join [Environment]::NewLine)\" }",
        "    [IO.Directory]::Move($targetPath, $backupPath)",
        "    try {",
        "        [IO.Directory]::Move($stagingPath, $persist_dir)",
        "        try {",
        "            New-Item -ItemType Junction -Path $targetPath -Target $persist_dir -ErrorAction Stop | Out-Null",
        "        } catch {",
        "            [IO.Directory]::Move($persist_dir, $stagingPath)",
        "            throw",
        "        }",
        "    } catch {",
        "        [IO.Directory]::Move($backupPath, $targetPath)",
        "        throw",
        "    }",
        "} finally {",
        "    if ([IO.Directory]::Exists($stagingPath)) { [IO.Directory]::Delete($stagingPath, $true) }",
        "}",
        "try {",
        "    [IO.Directory]::Delete($backupPath, $true)",
        "} catch {",
        "    Write-Warning \"NetEase DS data was migrated. The original backup is still at $backupPath.\"",
        "}"
    ],
    "post_uninstall": [
        "$targetPath = Join-Path ([Environment]::GetFolderPath('LocalApplicationData')) 'ds_client'",
        "$target = Get-Item -LiteralPath $targetPath -Force -ErrorAction SilentlyContinue",
        "if ($target.LinkType -eq 'Junction' -and $target.Target.TrimEnd('\\') -eq $persist_dir.TrimEnd('\\')) {",
        "    [IO.Directory]::Delete($targetPath)",
        "}"
    ],
    "shortcuts": [["Start.exe", "网易大神"]],
    "version": "1.0.17"
}
