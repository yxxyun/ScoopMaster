{
    "version": "0.7.0",
    "description": "Google Workspace MCP server and CLI (Docs, Drive, Gmail, Calendar, Sheets)",
    "homepage": "https://github.com/n24q02m/workspace",
    "license": "Apache-2.0",
    "depends": "nodejs",
    "url": [
        "https://registry.npmjs.org/@n24q02m/workspace/-/workspace-0.7.0.tgz",
        "https://raw.githubusercontent.com/n24q02m/scoop-bucket/main/locks/workspace-0.7.0.package-lock.json#/package-lock.json"
    ],
    "hash": [
        "b298886ef8391788567d4545ce2250a2516c457334f658ecaef1e3a13d51fc00",
        "a5df90c43f97a1f70aff95efb16bacb1280ad3e576ce7ccea2aa15989c80d5fb"
    ],
    "extract_dir": "package",
    "installer": {
        "script": [
            "# Every dependency is pinned by integrity hash in package-lock.json, resolved by bump.py.",
            "Push-Location $dir",
            "npm ci --omit=dev --ignore-scripts --no-audit --no-fund --loglevel=error",
            "$code = $LASTEXITCODE",
            "Pop-Location",
            "if ($code) { throw 'npm ci failed' }",
            "# Run the node of the `nodejs` app this manifest depends on (a sibling app dir), not",
            "# whatever node comes first on PATH: the package's engines need a current Node.",
            "Set-Content -Path \"$dir\\workspace.cmd\" -Value '@\"%~dp0..\\..\\nodejs\\current\\node.exe\" \"%~dp0bin\\cli.mjs\" %*' -Encoding ascii"
        ]
    },
    "bin": "workspace.cmd"
}
