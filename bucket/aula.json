{
    "version": "0.1.3",
    "description": "Study companion that turns notes, slides, and past exams into interactive courses.",
    "homepage": "https://github.com/luumlabs/aula",
    "license": "AGPL-3.0-only",
    "architecture": {
        "64bit": {
