            "hash": "0438bae640a226e44ca3279660e892e88d7ac9c92c4b2051a2515e545ae7658c"
        }
    },
    "post_install": [
        "Expand-7zipArchive (Join-Path $dir '$PLUGINSDIR\\app-64.7z') $dir",
        "Remove-Item -LiteralPath (Join-Path $dir '$PLUGINSDIR') -Recurse -Force -ErrorAction SilentlyContinue",
        "Remove-Item -LiteralPath (Join-Path $dir '$R0') -Recurse -Force -ErrorAction SilentlyContinue"
    ],
    "bin": "Aula.exe",
    "shortcuts": [
        [
            "Aula.exe",
            "Aula"
        ]
    ],
    "checkver": {
        "url": "https://api.github.com/repos/luumlabs/aula/releases/latest",
        "jsonpath": "$.tag_name",
        "regex": "^v(?<version>[\\d.]+)$"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/luumlabs/aula/releases/download/v$version/Aula-Setup-$version.exe#/dl.7z"
            }
        }
    }
