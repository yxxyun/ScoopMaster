{
    "version": "8.09.28.1124",
    "description": "AMD Chipset Driver for Ryzen processors",
    "homepage": "https://www.amd.com/en/support/download/drivers.html",
    "license": {
        "identifier": "Proprietary",
        "url": "https://www.amd.com/en/resources/support-articles/amd-software-eula.html"
    },
    "notes": "Only compatible with AMD Ryzen processors",
    "suggest": {
        "vcredist": "extras/vcredist2022"
    },
    "url": "https://drivers.amd.com/drivers/amd_chipset_software_8.09.28.1124.exe",
    "hash": "57ed1aa9ac842d8ad0064fced2524e9aab66c5ba74ed90c0135b34f53278ac7f",
    "pre_install": [
        "# Detect AMD system from SMBus vendor ID",
        "$pnpDevices = Get-WmiObject -Class Win32_PnPEntity",
        "$amdPattern = \"PCI\\\\VEN_(1002&DEV_(4353|4363|4372|4385)|1022&DEV_(780B|790B))\"",
        "if (!($pnpDevices.DeviceID -match $amdPattern)) { error \"AMD system not detected.\"; break }"
    ],
    "installer": {
        "script": [
            "Start-Process \"$dir\\$fname\" -ArgumentList '/S' -Verb RunAs -Wait | Out-Null",
            "if (Test-Path 'C:\\AMD') { Remove-Item -Path 'C:\\AMD' -Recurse -Force -ErrorAction SilentlyContinue }"
        ]
    },
    "checkver": {
        "url": "https://www.amd.com/en/support/downloads/drivers.html/chipsets/laptop-chipsets/amd-ryzen-and-athlon-mobile-chipset.html",
        "useragent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64)",
        "regex": "<h4>AMD Chipset Drivers[\\s\\S]*?Revision Number[\\s\\S]*?([\\d.]+)<\\/p>"
    },
    "autoupdate": {
        "url": "https://drivers.amd.com/drivers/amd_chipset_software_$version.exe"
    }
}
