    "installer": {
        "args": [
            "/S",
            "/D=$dir"
        ]
    },
    "uninstaller": {
        "script": "$uninstaller = Get-ChildItem -LiteralPath $dir -Filter 'unins*.exe' -File -ErrorAction SilentlyContinue | Select-Object -First 1; if ($uninstaller) { Invoke-ExternalCommand $uninstaller.FullName -ArgumentList '/S' -RunAs | Out-Null }"
    },
    "bin": "Coodesker-x64.exe",
    "shortcuts": [
        [
            "Coodesker-x64.exe",
            "Coodesker"
        ]
    ],
    "checkver": {
        "github": "https://github.com/coodesker/coodesker-desktop",
        "regex": "v([0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+)"
    },
    "autoupdate": {
        "url": "https://github.com/coodesker/coodesker-desktop/releases/download/v$version/Coodesker-x64_$version.exe"
    }
}
