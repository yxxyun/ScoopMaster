{
    "version": "0.16.4",
    "description": "The Pony toolchain multiplexer",
    "homepage": "https://github.com/ponylang/ponyup",
    "license": "BSD-2-Clause",
    "architecture": {
        "64bit": {
            "url": "https://github.com/ponylang/ponyup/releases/download/0.16.4/ponyup-x86-64-pc-windows-msvc.zip",
            "hash": "2a4320d8ef62130f8ee803b18a61f56432239fd263817923343d0a0727fabef1"
        },
        "arm64": {
            "url": "https://github.com/ponylang/ponyup/releases/download/0.16.4/ponyup-arm64-pc-windows-msvc.zip",
            "hash": "28bdc4ceea0ab92b013d2e5023751e0e49630bf393b18d53ff5d3b5770af78d6"
        }
    },
    "bin": [
        [
            "bin\\ponyup.exe",
            "ponyup",
            "-p \"$persist_dir\""
        ]
    ],
    "persist": "ponyup",
    "env_add_path": "ponyup\\bin",
    "notes": [
        "Install the Pony compiler with: ponyup update ponyc release",
        "Install Corral with: ponyup update corral release"
    ],
    "post_install": [
        "$prefix = Join-Path $persist_dir 'ponyup'",
        "New-Item -ItemType Directory -Path (Join-Path $prefix 'bin') -Force | Out-Null",
        "$platformArch = if ($architecture -eq 'arm64') { 'arm64' } else { 'x86_64' }",
        "$platform = \"$platformArch-pc-windows-msvc\"",
        "& (Join-Path $dir 'bin\\ponyup.exe') -p $persist_dir default $platform",
        "if ($LASTEXITCODE -ne 0) { throw 'Ponyup failed to initialize its platform.' }",
        "Set-Content -Path (Join-Path $prefix '.lock') -Value \"ponyup-release-$version-$platformArch-windows\""
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/ponylang/ponyup/releases/download/$version/ponyup-x86-64-pc-windows-msvc.zip"
            },
            "arm64": {
                "url": "https://github.com/ponylang/ponyup/releases/download/$version/ponyup-arm64-pc-windows-msvc.zip"
            }
        }
    }
}
