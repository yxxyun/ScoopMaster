{
    "version": "2.6.2",
    "description": "Save and restore Windows display layouts, resolutions, refresh rates, and hotkey presets.",
    "homepage": "https://github.com/GTRows/MonitorSnap",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/GTRows/MonitorSnap/releases/download/v2.6.2/MonitorSnap-Portable-2.6.2.exe",
            "hash": "e94204a229d9229db4f96fc2d03e788c6a0fbe51a060caacbfae057e7772287b"
        }
    },
    "pre_install": [
        "$portableExe = Get-ChildItem -LiteralPath $dir -Filter 'MonitorSnap-Portable-*.exe' -File | Select-Object -First 1",
        "if (-not $portableExe) { throw 'MonitorSnap portable executable was not found.' }",
        "Move-Item -LiteralPath $portableExe.FullName -Destination (Join-Path $dir 'MonitorSnap.exe') -ErrorAction Stop"
    ],
    "bin": "MonitorSnap.exe",
    "shortcuts": [
        [
            "MonitorSnap.exe",
            "MonitorSnap"
        ]
    ],
    "persist": "MonitorSnapData",
    "checkver": {
        "url": "https://api.github.com/repos/GTRows/MonitorSnap/releases/latest",
        "jsonpath": "$.tag_name",
        "regex": "^v(?<version>[\\d.]+)$"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/GTRows/MonitorSnap/releases/download/v$version/MonitorSnap-Portable-$version.exe",
                "hash": {
                    "url": "https://api.github.com/repos/GTRows/MonitorSnap/releases/tags/v$version",
                    "regex": "\"name\"\\s*:\\s*\"MonitorSnap-Portable-$version\\.exe\"[\\s\\S]*?\"digest\"\\s*:\\s*\"sha256:([a-f0-9]{64})\""
                }
            }
        }
    }
}
