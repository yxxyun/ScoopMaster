{
    "version": "1.4",
    "description": "Portable edition of Vovsoft Auto Change Wallpapers.",
    "homepage": "https://vovsoft.com/software/auto-change-wallpapers/",
    "license": "Proprietary",
    "url": "https://vovsoft.com/files/auto-change-wallpapers-portable.zip?v=1.4",
    "checkver": {
        "url": "https://vovsoft.com/download/auto-change-wallpapers-portable/",
        "regex": "(?is)Version\\s*(?:<[^>]*>\\s*)*:?\\s*(?:<[^>]*>\\s*)*(?<version>\\d+(?:\\.\\d+)+)"
    },
    "autoupdate": {
        "url": "https://vovsoft.com/files/auto-change-wallpapers-portable.zip?v=$version"
    },
    "shortcuts": [
        [
            "acwall.exe",
            "Vovsoft Auto Change Wallpapers"
        ]
    ],
    "notes": [
        "SHA-256 has not been verified; archive contents and the shortcut target have been checked."
    ],
    "pre_install": [
        "if (-not (Test-Path -LiteralPath \"$dir\\key.txt\" -PathType Leaf)) { New-Item -ItemType File -Path \"$dir\\key.txt\" | Out-Null }"
    ],
    "persist": "key.txt"
}
