{
    "version": "11.0.0",
    "description": "Microsoft .NET Desktop Runtime",
    "homepage": "https://dotnet.microsoft.com/download/dotnet",
    "license": {
        "identifier": "Freeware",
        "url": "https://www.microsoft.com/en-us/legal/intellectualproperty/copyright/default.aspx"
    },
    "notes": "You can now remove this installer with 'scoop uninstall windowsdesktop-runtime-x64'",
    "architecture": {
        "64bit": {
            "url": "https://builds.dotnet.microsoft.com/dotnet/WindowsDesktop/11.0.0/windowsdesktop-runtime-11.0.0-win-x64.exe",
            "hash": "sha512:ca20dba0c69dd6ae3932d2a42beeeecc4f4ece0be084f9921b001c8acd4ece7999df73ede76b87b6ae0d34974112ddd1c828fafad487df27c25e59e7f794c059"
        }
    },
    "pre_install": "if (!(is_admin)) { error 'Admin privileges are required.'; break }",
    "installer": {
        "script": "Invoke-ExternalCommand \"$dir\\$fname\" -ArgumentList '/install', '/quiet', '/norestart' -RunAs | Out-Null"
    },
    "checkver": {
        "url": "https://dotnetcli.blob.core.windows.net/dotnet/WindowsDesktop/Current/latest.version",
        "regex": "([\\d.]+)$"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://dotnetcli.blob.core.windows.net/dotnet/WindowsDesktop/$version/windowsdesktop-runtime-$version-win-x64.exe",
                "hash": {
                    "url": "https://dotnet.microsoft.com/download/dotnet/thank-you/runtime-desktop-$version-windows-x64-installer",
                    "regex": "value=\"$sha512\""
                }
            }
        }
    }
}
