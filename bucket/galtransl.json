{
    "version": "8.4.1",
    "description": "Automated Galgame translation with GPT/Claude/DeepSeek/Sakura models through a desktop UI, dictionaries and resumable cache",
    "homepage": "https://github.com/GalTransl/GalTransl",
    "license": "GPL-3.0-only",
    "url": "https://github.com/GalTransl/GalTransl/releases/download/8.4.1/GalTransl_8.4.1_win.zip",
    "hash": "1deafd653209c62f1bc7eabae4e40a9dae9bcdc62a074008978e68fb3fe82541",
    "extract_dir": "GalTransl_8.4.1_win",
    "bin": [
        [
            "GalTransl Desktop.exe",
            "galtransl"
        ]
    ],
    "shortcuts": [
        [
            "GalTransl Desktop.exe",
            "GalTransl"
        ]
    ],
    "installer": {
        "script": [
            "foreach ($seed in @('Dict', 'translation_guidelines')) {",
            "    if (Test-Path \"$persist_dir\\$seed\") {",
            "        Get-ChildItem -LiteralPath \"$dir\\$seed\" -File -Force | Where-Object { -not (Test-Path -LiteralPath \"$persist_dir\\$seed\\$($_.Name)\") } | Copy-Item -Destination \"$persist_dir\\$seed\" -Force",
            "    }",
            "}"
        ]
    },
    "persist": [
        "Dict",
        "translation_guidelines"
    ],
    "checkver": "github",
    "autoupdate": {
        "url": "https://github.com/GalTransl/GalTransl/releases/download/$version/GalTransl_$version_win.zip",
        "hash": "1bff66616f54bbb8408bb5c015beb7cb3db27a3cd4bc97601df0ce653c7c6ef2",
        "extract_dir": "GalTransl_$version_win"
    },
    "notes": [
        "Runs GalTransl Desktop.exe with the backend bundled, so no Python install is needed.",
        "Dict/ and translation_guidelines/ stay in ~/scoop/persist/galtransl and pick up new bundled files on upgrade; a bundled file you also edited keeps your version."
    ]
}
