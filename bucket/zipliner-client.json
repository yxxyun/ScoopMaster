{
    "version": "0.3.0",
    "description": "Live coordinates and zipline data collection for Arknights: Endfield.",
    "homepage": "https://github.com/ZipField/zipliner-client",
    "license": "GPL-3.0-or-later",
    "architecture": {
        "64bit": {
            "url": "https://github.com/ZipField/zipliner-client/releases/download/v0.3.0/zipliner-client-v0.3.0-windows-x64.zip",
            "hash": "3287602cf5b890df77d91d3c89c03bdda59eb6de3ef769d8626e7fca17c2db2f"
        }
    },
    "extract_dir": "zipliner-client-v0.3.0-windows-x64",
    "post_uninstall": [
        "if ($cmd -ne 'uninstall' -or -not $purge) { return }",
        "$dataDir = Join-Path $env:APPDATA 'org.zipliner\\zipliner_client'",
        "if ([IO.Directory]::Exists($dataDir)) { [IO.Directory]::Delete($dataDir, $true) }"
    ],
    "shortcuts": [
        [
            "zipliner_client.exe",
            "Zipliner Client"
        ]
    ],
    "checkver": {
        "github": "https://github.com/ZipField/zipliner-client"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/ZipField/zipliner-client/releases/download/v$version/zipliner-client-v$version-windows-x64.zip"
            }
        },
        "extract_dir": "zipliner-client-v$version-windows-x64"
    },
    "notes": [
        "Settings and account credentials in %APPDATA%\\org.zipliner\\zipliner_client are retained on regular uninstall. Use 'scoop uninstall -p zipliner-client' to remove them.",
        "Captures and logs in the system Documents\\Zipliner folder are always retained.",
        "PS WinDivert driver cleanup is handled by the application on stop/exit."
    ]
}
