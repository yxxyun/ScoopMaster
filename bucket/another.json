{
    "version": "0.4.4",
    "description": "A desktop app for mirroring and controlling Android devices over USB.",
    "homepage": "https://github.com/Zfinix/another",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/Zfinix/another/releases/download/v0.4.4/Another_0.4.4_x64-setup.exe",
            "hash": "6ca61a1195f8be42f9361493c98d299da7161dc2d8a2e4d4f041d9d7755de1bf"
        }
    },
    "installer": {
        "args": [
            "/S",
            "/NS",
            "/D=$dir"
        ]
    },
    "uninstaller": {
        "script": [
            "if (Test-Path (Join-Path $dir 'uninstall.exe')) { Invoke-ExternalCommand (Join-Path $dir 'uninstall.exe') -ArgumentList '/S' | Out-Null }"
        ]
    },
    "bin": "Another.exe",
    "shortcuts": [
        [
            "Another.exe",
            "Another"
        ]
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/Zfinix/another/releases/download/v$version/Another_$version_x64-setup.exe"
            }
        }
    }
}
