{
    "version": "1.0.0",
    "description": "A desktop app for mirroring and controlling Android devices over USB.",
    "homepage": "https://github.com/Zfinix/another",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/Zfinix/another/releases/download/v1.0.0/Another_1.0.0_x64-setup.exe",
            "hash": "bde5dd60b19b097ef605ab78c53b6bf5eb27703b396b4cf7e39f943fcf2961c7"
        }
    },
    "installer": {
        "args": [
            "/S",
            "/NS",
            "/D=$dir"
        ]
    },
    "uninstaller": {
        "script": "if (Test-Path (Join-Path $dir 'uninstall.exe')) { Invoke-ExternalCommand (Join-Path $dir 'uninstall.exe') -ArgumentList '/S' | Out-Null }"
    },
    "bin": "Another.exe",
    "shortcuts": [
        [
            "Another.exe",
            "Another"
        ]
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/Zfinix/another/releases/download/v$version/Another_$version_x64-setup.exe"
            }
        }
    }
}
