{
  "version": "0.1.31",
  "description": "Private VPN for Windows 10 and 11 with a free plan of 500 MB a day, no ads and no browsing logs. Made for networks that block VPNs.",
  "homepage": "https://tealvpn.com/windows",
  "license": {
    "identifier": "Proprietary",
    "url": "https://tealvpn.com/terms"
  },
  "notes": [
    "Teal VPN installs system-wide through its own signed setup (service + driver), so this manifest runs the setup silently (admin prompt).",
    "Updates: scoop update teal-vpn. Remove: scoop uninstall teal-vpn."
  ],
  "architecture": {
    "64bit": {
      "url": "https://github.com/tealvpn/windows/releases/download/v0.1.31/TealVPN-Setup-x64.exe",
      "hash": "sha256:b0b49f61b08929ef0017459a731e2bdddd37ccaa61c199d08702966fcf62b848"
    },
    "arm64": {
      "url": "https://github.com/tealvpn/windows/releases/download/v0.1.31/TealVPN-Setup-arm64.exe",
      "hash": "sha256:201b4cf11703bbc34527d45c37be6356191d15199ae9bccb97838ceeace9b2a5"
    }
  },
  "installer": {
    "script": [
      "Start-Process -FilePath \"$dir\\$fname\" -ArgumentList '/quiet' -Wait",
      "Remove-Item \"$dir\\$fname\" -ErrorAction SilentlyContinue"
    ]
  },
  "uninstaller": {
    "script": [
      "$k = Get-ItemProperty 'HKLM:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\TealVPN' -ErrorAction SilentlyContinue",
      "if ($k -and $k.QuietUninstallString) { cmd /c $k.QuietUninstallString }"
    ]
  },
  "checkver": {
    "url": "https://download.tealvpn.com/windows/latest.json",
    "jsonpath": "$.version"
  },
  "autoupdate": {
    "architecture": {
      "64bit": {
        "url": "https://github.com/tealvpn/windows/releases/download/v$version/TealVPN-Setup-x64.exe",
        "hash": {
          "url": "$url.sha256"
        }
      },
      "arm64": {
        "url": "https://github.com/tealvpn/windows/releases/download/v$version/TealVPN-Setup-arm64.exe",
        "hash": {
          "url": "$url.sha256"
        }
      }
    }
  }
}
