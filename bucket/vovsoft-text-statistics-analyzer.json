{
    "version": "4.0",
    "description": "Portable edition of Vovsoft Text Statistics Analyzer.",
    "homepage": "https://vovsoft.com/software/text-statistics-analyzer/",
    "license": "Proprietary",
    "url": "https://vovsoft.com/files/text-statistics-analyzer-portable.zip?v=4.0",
    "checkver": {
        "url": "https://vovsoft.com/download/text-statistics-analyzer-portable/",
        "regex": "(?is)Version\\s*(?:<[^>]*>\\s*)*:?\\s*(?:<[^>]*>\\s*)*(?<version>\\d+(?:\\.\\d+)+)"
    },
    "autoupdate": {
        "url": "https://vovsoft.com/files/text-statistics-analyzer-portable.zip?v=$version"
    },
    "shortcuts": [
        [
            "textstats.exe",
            "Vovsoft Text Statistics Analyzer"
        ]
    ],
    "notes": [
        "SHA-256 has not been verified; archive contents and the shortcut target have been checked."
    ],
    "pre_install": [
        "if (-not (Test-Path -LiteralPath \"$dir\\key.txt\" -PathType Leaf)) { New-Item -ItemType File -Path \"$dir\\key.txt\" | Out-Null }"
    ],
    "persist": "key.txt"
}
