{
    "version": "11.2.0.6",
    "description": "Duplicate file detection utility",
    "homepage": "https://www.auslogics.com/en/software/duplicate-file-finder/",
    "license": "Proprietary",
    "url": "https://downloads.auslogics.com/en/duplicate-file-finder/auslogics-duplicate-file-finder-setup.exe",
    "hash": "06974E6B71790BDF09B9D5ACD23FFEB98BB4EF5CD516FC4B96C0AF2EE82425CC",
    "innosetup": true,
    "bin": "DuplicateFileFinder.exe",
    "shortcuts": [
        [
            "DuplicateFileFinder.exe",
            "Auslogics Duplicate File Finder"
        ]
    ],
    "checkver": {
        "script": [
            "$html = (Invoke-WebRequest -Uri 'https://www.auslogics.com/en/software/duplicate-file-finder/' -UseBasicParsing).Content",
            "$text = [System.Net.WebUtility]::HtmlDecode([regex]::Replace($html, '<[^>]+>', ' '))",
            "$text = [regex]::Replace($text, '\\s+', ' ')",
            "$match = [regex]::Match($text, '(?i)Version\\s+(?<version>\\d+(?:\\.\\d+){3})')",
            "if (-not $match.Success) { throw 'Unable to detect Auslogics Duplicate File Finder version from the official product page.' }",
            "$match.Groups['version'].Value"
        ],
        "regex": "(?<version>\\d+(?:\\.\\d+){3})"
    },
    "autoupdate": {
        "url": "https://downloads.auslogics.com/en/duplicate-file-finder/auslogics-duplicate-file-finder-setup.exe"
    },
    "notes": [
        "Scoop extracts the official Inno Setup application payload into the app directory; it does not run the setup program.",
        "This extracts the application's installed files but does not guarantee the vendor's own portable mode or suppress any runtime requirements."
    ]
}
