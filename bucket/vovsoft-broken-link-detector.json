{
    "version": "4.3",
    "description": "Portable edition of Vovsoft Broken Link Detector.",
    "homepage": "https://vovsoft.com/software/broken-link-detector/",
    "license": "Proprietary",
    "url": "https://vovsoft.com/files/broken-link-detector-portable.zip?v=4.3",
    "checkver": {
        "url": "https://vovsoft.com/download/broken-link-detector-portable/",
        "regex": "(?is)Version\\s*(?:<[^>]*>\\s*)*:?\\s*(?:<[^>]*>\\s*)*(?<version>\\d+(?:\\.\\d+)+)"
    },
    "autoupdate": {
        "url": "https://vovsoft.com/files/broken-link-detector-portable.zip?v=$version"
    },
    "shortcuts": [
        [
            "brokenlink.exe",
            "Vovsoft Broken Link Detector"
        ]
    ],
    "notes": [
        "SHA-256 has not been verified; archive contents and the shortcut target have been checked."
    ],
    "pre_install": [
        "if (-not (Test-Path -LiteralPath \"$dir\\key.txt\" -PathType Leaf)) { New-Item -ItemType File -Path \"$dir\\key.txt\" | Out-Null }"
    ],
    "persist": "key.txt"
}
