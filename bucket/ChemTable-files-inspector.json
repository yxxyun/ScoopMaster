{
    "version": "4.55",
    "description": "Disk space analyzer for finding large files, folders, and removable data",
    "homepage": "https://www.chemtable.com/files-inspector.htm",
    "license": "Proprietary",
    "url": "https://files.chemtable.com/fi/files-inspector-setup.exe",
    "hash": "67E358613308FA1C483C60908E1E895DD2B3C03833757628813A79687C0D017E",
    "innosetup": true,
    "bin": "FilesInspector,1.exe",
    "shortcuts": [
        [
            "FilesInspector,1.exe",
            "ChemTable Files Inspector"
        ]
    ],
    "checkver": {
        "script": [
            "$html = (Invoke-WebRequest -Uri 'https://www.chemtable.com/files-inspector.htm' -UseBasicParsing).Content",
            "$text = [System.Net.WebUtility]::HtmlDecode([regex]::Replace($html, '<[^>]+>', ' '))",
            "$text = [regex]::Replace($text, '\\s+', ' ')",
            "$match = [regex]::Match($text, '(?i)\\bFiles Inspector\\s+(?<version>\\d+(?:\\.\\d+){1,3})')",
            "if (-not $match.Success) { throw 'Unable to detect the Files Inspector version from the official ChemTable product page.' }",
            "$match.Groups['version'].Value"
        ],
        "regex": "(?<version>\\d+(?:\\.\\d+){1,3})"
    },
    "autoupdate": {
        "url": "https://files.chemtable.com/fi/files-inspector-setup.exe"
    },
    "notes": "Scoop extracts the official Inno Setup payload into the app directory instead of executing the installer; installer-registered shell integration or machine-wide components are not installed."
}
