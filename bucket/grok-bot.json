{
    "version": "0.28.0",
    "description": "AI teammates that use apps and websites to complete work",
    "homepage": "https://x.ai/bot",
    "license": "Proprietary",
    "architecture": {
        "64bit": {
            "url": "https://downloads.cursor.com/grokbot/stable/win32-x64/0.28.0/Grok_Bot_0.28.0_Setup.exe",
            "hash": "skip"
        },
        "arm64": {
            "url": "https://downloads.cursor.com/grokbot/stable/win32-arm64/0.28.0/Grok_Bot_0.28.0_Setup.exe",
            "hash": "skip"
        }
    },
    "installer": {
        "script": [
            "$file = (Get-ChildItem \"$dir\" 'Grok_Bot*.exe' | Select-Object -First 1).FullName",
            "Expand-7ZipArchive \"$file\" \"$dir\\\" -Removal",
            "$app7z = Get-ChildItem \"$dir\\`$PLUGINSDIR\\app*.7z\" | Select-Object -First 1",
            "if ($app7z) { Expand-7ZipArchive $app7z.FullName \"$dir\" -Removal }",
            "Remove-Item \"$dir\\`$PLUGINSDIR\", \"$dir\\Uninstall*\", \"$dir\\`$R0\" -Force -Recurse -ErrorAction SilentlyContinue"
        ]
    },
    "shortcuts": [
        [
            "Grok Bot.exe",
            "Grok Bot"
        ]
    ],
    "checkver": {
        "url": "https://x.ai/bot",
        "regex": "Grok_Bot_(?<version>[\\d.]+)\\.(?:dmg|exe)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://downloads.cursor.com/grokbot/stable/win32-x64/$version/Grok_Bot_$version_Setup.exe"
            },
            "arm64": {
                "url": "https://downloads.cursor.com/grokbot/stable/win32-arm64/$version/Grok_Bot_$version_Setup.exe"
            }
        }
    }
}
