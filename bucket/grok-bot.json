{
    "version": "0.37.0",
    "description": "AI teammates that use apps and websites to complete work",
    "homepage": "https://cursor.com/grokbot",
    "license": "Proprietary",
    "architecture": {
        "64bit": {
            "url": "https://downloads.cursor.com/grokbot/stable/win32-x64/0.37.0/Grok_Bot_0.37.0_Setup.exe",
            "hash": "ea3a134d9c47e5ddb8d7c130be2c7c8f07bc050f69c7a77ec4ba4dd77b1c8681"
        },
        "arm64": {
            "url": "https://downloads.cursor.com/grokbot/stable/win32-arm64/0.37.0/Grok_Bot_0.37.0_Setup.exe",
            "hash": "c14a7ecffeb4772d15ea5dcc52be826a72ca9f279bb55f91b4fdb12fbcb2f3f2"
        }
    },
    "installer": {
        "script": [
            "$file = (Get-ChildItem \"$dir\" 'Grok_Bot*.exe' | Select-Object -First 1).FullName",
            "Expand-7ZipArchive \"$file\" \"$dir\\\" -Removal",
            "$app7z = Get-ChildItem \"$dir\\`$PLUGINSDIR\\app*.7z\" | Select-Object -First 1",
            "if ($app7z) { Expand-7ZipArchive $app7z.FullName \"$dir\" -Removal }",
            "Remove-Item \"$dir\\`$PLUGINSDIR\", \"$dir\\Uninstall*\", \"$dir\\`$R0\" -Force -Recurse -ErrorAction SilentlyContinue"
        ]
    },
    "shortcuts": [
        [
            "Grok Bot.exe",
            "Grok Bot"
        ]
    ],
    "checkver": {
        "script": [
            "function Test-GrokBotVersion([string]$Version) {",
            "    $url = \"https://downloads.cursor.com/grokbot/stable/win32-x64/$Version/Grok_Bot_${Version}_Setup.exe\"",
            "    try {",
            "        Invoke-WebRequest -Uri $url -Method Head -UseBasicParsing -ErrorAction Stop | Out-Null",
            "        return $true",
            "    } catch {",
            "        return $false",
            "    }",
            "}",
            "$ver = [version]'0.27.0'",
            "$changed = $true",
            "while ($changed) {",
            "    $changed = $false",
            "    $candidates = @(",
            "        [version]::new($ver.Major, $ver.Minor, $ver.Build + 1),",
            "        [version]::new($ver.Major, $ver.Minor + 1, 0),",
            "        [version]::new($ver.Major + 1, 0, 0)",
            "    )",
            "    foreach ($candidate in ($candidates | Where-Object { $_ -gt $ver } | Sort-Object -Descending)) {",
            "        $candidateStr = \"$($candidate.Major).$($candidate.Minor).$($candidate.Build)\"",
            "        if (Test-GrokBotVersion $candidateStr) {",
            "            $ver = $candidate",
            "            $changed = $true",
            "            break",
            "        }",
            "    }",
            "}",
            "\"$($ver.Major).$($ver.Minor).$($ver.Build)\""
        ],
        "regex": "^(?<version>[\\d.]+)$"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://downloads.cursor.com/grokbot/stable/win32-x64/$version/Grok_Bot_$version_Setup.exe"
            },
            "arm64": {
                "url": "https://downloads.cursor.com/grokbot/stable/win32-arm64/$version/Grok_Bot_$version_Setup.exe"
            }
        }
    }
}
