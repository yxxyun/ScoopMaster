            "hash": "f7ceb01900db737eb8ed779beea593366cc424d9875efd5a719ec53607711a8e"
        }
    },
    "pre_install": [
        "& 7z.exe x \"$dir\\Reasonix-windows-amd64-installer.exe\" -o\"$dir\" -y | Out-Null",
        "Remove-Item \"$dir\\Reasonix-windows-amd64-installer.exe\", (Join-Path $dir '$PLUGINSDIR'), (Join-Path $dir '$R9'), \"$dir\\uninstall.exe\", \"$dir\\webview2bootstrapper\" -Recurse -Force -ErrorAction SilentlyContinue"
    ],
    "shortcuts": [
        [
            "reasonix-desktop.exe",
            "Reasonix Desktop"
        ]
    ],
    "checkver": {
        "url": "https://github.com/esengine/DeepSeek-Reasonix/releases",
        "regex": "tag/(?:desktop-)?v(?<version>[\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://dl.reasonix.io/desktop-v$version/Reasonix-windows-amd64-installer.exe"
            }
        },
        "hash": {
            "url": "https://dl.reasonix.io/desktop-v$version/latest.json",
            "jsonpath": "$.platforms['windows-amd64'].sha256"
        }
    }
}
