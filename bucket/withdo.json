{
    "version": "0.15.0",
    "description": "Local-first AI task manager and desktop assistant with agent integrations.",
    "homepage": "https://github.com/QingYunA/withdo",
    "license": "AGPL-3.0-only",
    "url": "https://github.com/QingYunA/withdo/releases/download/v0.15.0/Withdo-Setup-0.15.0-windows-x64.exe",
    "hash": "ffdbaffac07dbbb8a7b0557c5341f3ed2e72b0af3263be8a6e9161df67267586",
    "bin": [
        [
            "withdo-cli.exe",
            "withdo"
        ]
    ],
    "##": "Installer Type: NSIS",
    "installer": {
        "args": [
            "/S",
            "/D=$dir"
        ]
    },
    "uninstaller": {
        "script": [
            "if ($cmd -ne 'update') {",
            "    $uninstaller = Join-Path $dir 'Uninstall.exe'",
            "    if (-not (Test-Path -LiteralPath $uninstaller -PathType Leaf)) { throw 'MyGo NSIS uninstaller was not found in the Scoop version directory.' }",
            "    $uninstallArgs = @('/S', ('\"' + '_?=' + $dir + '\"'))",
            "    $process = Start-Process -FilePath $uninstaller -ArgumentList $uninstallArgs -Wait -PassThru -ErrorAction Stop",
            "    if ($process.ExitCode -ne 0) { throw \"MyGo NSIS uninstaller exited with code $($process.ExitCode).\" }",
            "}"
        ]
    },
    "checkver": {
        "github": "https://github.com/QingYunA/withdo"
    },
    "autoupdate": {
        "url": "https://github.com/QingYunA/withdo/releases/download/v$version/Withdo-Setup-$version-windows-x64.exe",
        "hash": {
            "mode": "json",
            "url": "https://api.github.com/repos/QingYunA/withdo/releases/tags/v$version",
            "jp": "$.assets[?(@.name == 'Withdo-Setup-$version-windows-x64.exe')].digest"
        }
    },
    "notes": "Use Scoop as the update authority; do not apply independent updates from Withdo's built-in MyGo updater."
}
