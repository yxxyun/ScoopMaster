    "hash": "b5f0580ee187a02426139ecc0152ebd6e9014fd521caf004e79b3c6f2fe74ff3",
    "installer": {
        "script": "start-process -wait \"$dir\\setup.exe\" -a '-s'"
    },
    "uninstaller": {
        "script": "start-process -wait \"$env:localappdata\\fluxer_app\\Update.exe\" -a '--uninstall -s'"
    },
    "checkver": {
        "script": [
            "$src = 'https://api.fluxer.app/dl/desktop/canary/win32/x64/latest/setup'",
            "$html = curl.exe -IsSq $src",
            "$ver = [regex]::Matches($html, 'x-fluxer-version: ([\\d.]+)')",
            "[string]::Format('{0}', $ver.groups[1].value)"
        ],
        "regex": "(?<version>.+)"
    },
    "autoupdate": {
        "url": "https://api.fluxer.app/dl/desktop/canary/win32/x64/latest/setup#/setup.exe"
    }
}
