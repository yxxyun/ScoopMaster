    "checkver": {
        "script": [
            "$src = 'https://api.fluxer.app/dl/desktop/canary/win32/x64/latest/setup'",
            "$html = curl.exe -IsSq $src",
            "$ver = [regex]::Matches($html, 'x-fluxer-version: ([\\d.]+)')",
            "[string]::Format('{0}', $ver.groups[1].value)"
        ],
        "regex": "(?<version>.+)"
    },
