    "version": "1.3.4",
    "description": "云汐网盘 —— 聚合多家网盘的高速下载/管理桌面端",
    "homepage": "https://github.com/tidain/YunX-Desktop",
    "license": {
        "identifier": "AGPL-3.0-only",
        "url": "https://github.com/tidain/YunX-Desktop/blob/main/LICENSE"
    },
    "notes": "Inno Setup 安装包，静默装进 Scoop 目录，卸载走 unins000.exe",
    "architecture": {
        "64bit": {
            "url": "https://github.com/tidain/YunX-Desktop/releases/download/v1.3.4/YunX-Desktop-setup-1.3.4.exe",
            "hash": "905670552ae14183173bd5ba064bef3e181c564d5301c26ccf539843aaedde18"
        }
    },
    "installer": {
        "script": [
            "$installer = Join-Path $dir $fname",
            "$dirArg = '/DIR=\"{0}\"' -f $dir",
            "Start-Process -FilePath $installer -ArgumentList '/VERYSILENT', '/SUPPRESSMSGBOXES', '/NORESTART', $dirArg -Wait",
            "Remove-Item $installer -Force"
        ]
    },
    "uninstaller": {
        "script": [
            "$c=@((Join-Path $dir 'unins000.exe'))",
            "foreach ($u in $c) { if (Test-Path -LiteralPath $u) { Start-Process -FilePath $u -ArgumentList '/VERYSILENT','/SUPPRESSMSGBOXES','/NORESTART' -Wait; break } }"
        ]
    },
    "checkver": {
        "url": "https://github.com/tidain/YunX-Desktop/releases.atom",
        "regex": "releases/tag/v([\\d.]+)\""
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/tidain/YunX-Desktop/releases/download/v$version/YunX-Desktop-setup-$version.exe"
            }
        },
        "hash": {
            "url": "https://api.github.com/repos/tidain/YunX-Desktop/releases/tags/v$version",
            "regex": "\"name\":\"YunX-Desktop-setup-$version\\.exe\".*?\"digest\":\"sha256:([0-9a-f]{64})\""
        }
    }
}
