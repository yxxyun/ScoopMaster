{
    "version": "2.10.0-beta.1",
    "description": "Open-source mod manager from Nexus Mods",
    "homepage": "https://www.nexusmods.com/about/vortex/",
    "license": {
        "identifier": "GPL-3.0-or-later",
        "url": "https://raw.githubusercontent.com/Nexus-Mods/Vortex/master/LICENSE.md"
    },
    "url": "https://github.com/Nexus-Mods/Vortex/releases/download/v2.10.0-beta.1/vortex-setup-2.10.0-beta.1.exe",
    "hash": "sha512:d71d7fb9d038039a436f375c63f1b269b5fa6a347c4523abde290ceb8c9dc697ef5704d4ca2cd1b0236592d13a1c93db69a1ec8f4a595ecbc0681c3dbac9ddf1",
    "installer": {
        "script": [
            "$args = @('/S')",
            "Start-Process \"$dir\\$fname\" -ArgumentList $args -Wait -Verb RunAs | Out-Null",
            "Remove-Item \"$dir\\$fname\""
        ]
    },
    "checkver": {
        "github": "https://api.github.com/repos/Nexus-Mods/Vortex/releases",
        "jp": "$..tag_name",
        "re": "(?!v)([\\d.]+(?:-[\\da-zA-Z.-]+)?)"
    },
    "autoupdate": {
        "url": "https://github.com/Nexus-Mods/Vortex/releases/download/v$version/vortex-setup-$version.exe",
        "hash": {
            "url": "$baseurl/latest.yml",
            "regex": "sha512: $base64"
        }
    }
}
