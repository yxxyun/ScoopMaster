{
    "version": "0.7.3",
    "description": "知乎开放平台 Agent Skill 包：SKILL.md、参考文档与初始化脚本，配合 zhihu-cli 供 AI Agent 使用",
    "homepage": "https://developer.zhihu.com/",
    "license": "Proprietary",
    "notes": [
        "pi 用户可在 settings.json 的 skills 数组中指向本目录，无需复制到 ~/.pi/agent/skills/",
        "示例：\"skills\": [\"~/scoop/apps/zhihu-cli-skill/current\"]"
    ],
    "architecture": {
        "64bit": {
            "url": "https://developer-cdn.zhihu.com/zhihu-cli/releases/stable/skill/0.7.3/zhihu-cli-skill-0.7.3.zip",
            "hash": "5ef31a3d8f414216e6d5be054a419d78bbb16094717fae545dd0d0843daf429c"
        }
    },
    "extract_dir": "zhihu",
    "checkver": {
        "url": "https://developer-cdn.zhihu.com/zhihu-cli/releases/stable/manifest.json",
        "jsonpath": "$.skill.latest_version"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://developer-cdn.zhihu.com/zhihu-cli/releases/stable/skill/$version/zhihu-cli-skill-$version.zip",
                "hash": {
                    "url": "https://developer-cdn.zhihu.com/zhihu-cli/releases/stable/manifest.json",
                    "jsonpath": "$.skill.sha256"
                }
            }
        }
    }
}
