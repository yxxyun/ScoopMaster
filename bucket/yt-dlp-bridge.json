{
    "version": "0.2026.04.01.add0473",
    "description": "浏览器（Chrome/Brave）扩展 + 本地 Native Messaging host：把网页视频/音频下载交给本机 yt-dlp 执行（全离线、无服务器、无追踪）",
    "homepage": "https://github.com/exotic123567/yt-dlp-bridge",
    "license": "Unknown",
    "depends": [
        "python312",
        "yt-dlp",
        "ffmpeg"
    ],
    "url": "https://github.com/exotic123567/yt-dlp-bridge/archive/add0473f5b9ff2d1654945ad4f9dcc79e1c1fe30.zip",
    "hash": "13004605a09c41a5a10ef13a6673ae456b4a582cd1cf87ae810f969802af435b",
    "extract_dir": "yt-dlp-bridge-add0473f5b9ff2d1654945ad4f9dcc79e1c1fe30\\YTBridge",
    "persist": "host_config.json",
    "installer": {
        "script": [
            "$ErrorActionPreference = 'Stop'",
            "$currentDir = Join-Path (Split-Path $dir -Parent) 'current'",
            "$extId = 'lgcpalmplaikljdjgocplillnpaidock'",
            "$extKey = ''",
            "",
            "# 1) 向 unpacked 扩展注入固定 key：扩展 ID 由 key 推导，与安装路径无关，升级/换机器都不变",
            "$extManifest = \"$dir\\extension\\manifest.json\"",
            "if (-not (Test-Path -LiteralPath $extManifest)) { error \"Extension manifest not found: $extManifest\" }",
            "$ext = Get-Content -LiteralPath $extManifest -Raw | ConvertFrom-Json",
            "if ($ext.key -ne $extKey) {",
            "    if ($ext.PSObject.Properties.Name -contains 'key') { $ext.key = $extKey } else { $ext | Add-Member -NotePropertyName key -NotePropertyValue $extKey }",
            "    [System.IO.File]::WriteAllText($extManifest, ($ext | ConvertTo-Json -Depth 10), (New-Object System.Text.UTF8Encoding($false)))",
            "    info \"已固定扩展 ID: $extId\"",
            "}",
            "",
            "# 2) 定位依赖：优先 scoop 安装目录（current junction，升级不失效），其次 PATH（排除 WindowsApps 商店占位符）",
            "$appDir = Split-Path $dir -Parent",
            "$scoopRoot = Split-Path (Split-Path $appDir -Parent) -Parent",
            "function Find-Tool([string]$Relative, [string]$Command) {",
            "    $appPath = Join-Path $scoopRoot $Relative",
            "    if (Test-Path -LiteralPath $appPath) { return $appPath }",
            "    $cmd = Get-Command $Command -ErrorAction SilentlyContinue | Where-Object { $_.Source -and $_.Source -notlike '*\\WindowsApps\\*' } | Select-Object -First 1",
            "    if ($cmd) { return $cmd.Source }",
            "    return $null",
            "}",
            "$ytdlp = Find-Tool 'apps\\yt-dlp\\current\\yt-dlp.exe' 'yt-dlp.exe'",
            "$ffmpeg = Find-Tool 'apps\\ffmpeg\\current\\bin\\ffmpeg.exe' 'ffmpeg.exe'",
            "$python = Find-Tool 'apps\\python312\\current\\python.exe' 'python312.exe'",
            "if (-not $python) { $python = Find-Tool 'apps\\python312\\current\\python.exe' 'python3.exe' }",
            "if (-not $python) { $python = Find-Tool 'apps\\python312\\current\\python.exe' 'python.exe' }",
            "",
            "# 3) native_host.bat 改用绝对路径的 python312 解释器启动（PATH 上没有 python 时浏览器会静默收不到响应）",
            "if ($python) {",
            "    $bat = \"@echo off`r`n`\"$python`\" `\"%~dp0native_host.py`\" %*\"",
            "    [System.IO.File]::WriteAllText(\"$dir\\native_host.bat\", $bat, [System.Text.Encoding]::ASCII)",
            "} else {",
            "    warn '未找到 python312 解释器，native_host.bat 沿用 PATH 上的 python；请 scoop install python312 后重装本应用'",
            "}",
            "",
            "# 4) native messaging host 清单：注册表指向 current 下的这份文件，升级后路径依然有效",
            "$hostManifest = @{",
            "    name            = 'com.rnb.ytdlpbridge'",
            "    description     = 'Native messaging bridge for local yt-dlp downloads'",
            "    path            = \"$currentDir\\native_host.bat\"",
            "    type            = 'stdio'",
            "    allowed_origins = @(\"chrome-extension://$extId/\")",
            "} | ConvertTo-Json -Depth 4",
            "[System.IO.File]::WriteAllText(\"$dir\\com.rnb.ytdlpbridge.json\", $hostManifest, (New-Object System.Text.UTF8Encoding($false)))",
            "",
            "# 5) 注册 Chrome / Brave（HKCU，无需管理员权限）",
            "foreach ($browser in @('Google\\Chrome', 'BraveSoftware\\Brave-Browser')) {",
            "    New-Item -Path \"HKCU:\\Software\\$browser\\NativeMessagingHosts\\com.rnb.ytdlpbridge\" -Force -Value \"$currentDir\\com.rnb.ytdlpbridge.json\" | Out-Null",
            "}",
            "info '已注册 Chrome / Brave native messaging host: com.rnb.ytdlpbridge'",
            "",
            "# 6) host_config.json：首次安装按本机实际路径生成并交给 persist；已有配置则保留（不覆盖用户编辑）",
            "$configPath = \"$dir\\host_config.json\"",
            "if (Test-Path -LiteralPath \"$persist_dir\\host_config.json\") {",
            "    if (Test-Path -LiteralPath $configPath) { Remove-Item -LiteralPath $configPath -Force }",
            "    info \"保留已有配置: $persist_dir\\host_config.json\"",
            "} else {",
            "    $ytdlpPath = if ($ytdlp) { $ytdlp } else { 'C:\\yt-dlp\\yt-dlp.exe' }",
            "    $ffmpegPath = if ($ffmpeg) { $ffmpeg } else { 'C:\\ffmpeg\\bin\\ffmpeg.exe' }",
            "    $config = [ordered]@{",
            "        yt_dlp_path = $ytdlpPath",
            "        ffmpeg_path = $ffmpegPath",
            "        output_dirs = [ordered]@{",
            "            YT    = \"$env:USERPROFILE\\Downloads\\YT\"",
            "            Music = \"$env:USERPROFILE\\Downloads\\Music\"",
            "        }",
            "    } | ConvertTo-Json -Depth 4",
            "    [System.IO.File]::WriteAllText($configPath, $config, (New-Object System.Text.UTF8Encoding($false)))",
            "    info \"已生成配置（存于 persist，升级/卸载不丢）: $persist_dir\\host_config.json\"",
            "    if (-not $ytdlp) { warn 'yt-dlp 未找到，请编辑 host_config.json 的 yt_dlp_path' }",
            "    if (-not $ffmpeg) { warn 'ffmpeg 未找到，请编辑 host_config.json 的 ffmpeg_path' }",
            "}",
            "",
            "# 7) 浏览器不允许脚本加载 unpacked 扩展，最后一步需手动完成（见 notes）",
            "info \"手动加载扩展（一次性）: chrome://extensions/ 或 brave://extensions/ -> 开发者模式 -> 加载已解压的扩展程序 -> $currentDir\\extension\""
        ]
    },
    "uninstaller": {
        "script": [
            "foreach ($browser in @('Google\\Chrome', 'BraveSoftware\\Brave-Browser')) {",
            "    Remove-Item -Path \"HKCU:\\Software\\$browser\\NativeMessagingHosts\\com.rnb.ytdlpbridge\" -Recurse -Force -ErrorAction SilentlyContinue",
            "}",
            "info '已移除 native messaging host 注册；浏览器中已加载的扩展请在扩展页手动移除'"
        ]
    },
    "notes": [
        "本清单自动化了除「浏览器加载扩展」之外的全部步骤：下载源码、写配置、注册 Chrome/Brave native messaging host、依赖 python312 + yt-dlp + ffmpeg。",
        "扩展 ID 固定为 lgcpalmplaikljdjgocplillnpaidock（安装时向扩展 manifest.json 注入固定 key，与安装路径和机器无关），allowed_origins 已按此写好，无需手动填写。",
        "native messaging host 注册在当前用户 HKCU\\Software\\{Google\\Chrome, BraveSoftware\\Brave-Browser}\\NativeMessagingHosts\\com.rnb.ytdlpbridge，不需要管理员权限；注册表值指向 current junction，升级后不失效。",
        "浏览器不允许脚本自动加载 unpacked 扩展，需手动完成一次（约 30 秒）：",
        "  1. Chrome 打开 chrome://extensions/，Brave 打开 brave://extensions/，开启右上角「开发者模式」",
        "  2. 「加载已解压的扩展程序」→ 选择安装日志里打印的路径 <scoop>\\apps\\yt-dlp-bridge\\current\\extension",
        "  3. 确认扩展 ID 为 lgcpalmplaikljdjgocplillnpaidock（与 allowed_origins 一致）",
        "升级后扩展文件随 current 同步；若浏览器未自动生效，在扩展页点一次「重新加载」。",
        "配置（yt-dlp/ffmpeg 路径、输出目录）保存在 <scoop>\\persist\\yt-dlp-bridge\\host_config.json，升级和卸载（不带 -p）都不会丢，可直接编辑；默认输出目录为 %USERPROFILE%\\Downloads\\YT 与 %USERPROFILE%\\Downloads\\Music。",
        "native_host.bat 已被改写为用绝对路径的 python312 解释器（<scoop>\\apps\\python312\\current\\python.exe）启动，避免 PATH 上没有 python 时 host 静默失败；host 日志写在安装目录的 host_log.txt（每次升级随版本目录重建）。",
        "仅注册 Chrome 与 Brave 两个浏览器（与上游 register_host.reg 一致）；其它 Chromium 浏览器需自行加注册表项。",
        "卸载：scoop uninstall yt-dlp-bridge 会移除注册表项并保留 persist 配置；浏览器里已加载的扩展需在扩展页手动移除。"
    ],
    "checkver": {
        "url": "https://github.com/exotic123567/yt-dlp-bridge/commits/main.atom",
        "regex": "(?s)>(\\d+)-(\\d+)-(\\d+)T.*?/(?<sha>(?<short>[0-9a-f]{7})[0-9a-f]{33})",
        "replace": "0.${1}.${2}.${3}.${short}"
    },
    "autoupdate": {
        "url": "https://github.com/exotic123567/yt-dlp-bridge/archive/$matchSha.zip",
        "extract_dir": "yt-dlp-bridge-$matchSha\\YTBridge"
    }
}
