{
    "version": "1.5",
    "description": "Portable utility for merging multiple audio files into one track.",
    "homepage": "https://vovsoft.com/software/merge-audio-files/",
    "license": "Proprietary",
    "url": "https://vovsoft.com/files/merge-audio-files-portable.zip?v=1.5",
    "checkver": {
        "url": "https://vovsoft.com/download/merge-audio-files-portable/",
        "regex": "(?is)Version\\s*(?:<[^>]*>\\s*)*:?\\s*(?:<[^>]*>\\s*)*(?<version>\\d+(?:\\.\\d+)+)"
    },
    "autoupdate": {
        "url": "https://vovsoft.com/files/merge-audio-files-portable.zip?v=$version"
    },
    "shortcuts": [
        [
            "mergeaudio.exe",
            "Vovsoft Merge Audio Files"
        ]
    ],
    "pre_install": "if (-not (Test-Path -LiteralPath \"$dir\\key.txt\" -PathType Leaf)) { New-Item -ItemType File -Path \"$dir\\key.txt\" | Out-Null }",
    "persist": "key.txt"
}
