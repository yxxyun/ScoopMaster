{
    "version": "1.6.0",
    "description": "Organize, customize, and launch app groups from the Windows taskbar.",
    "homepage": "https://github.com/iandiv/AppGroup",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/iandiv/AppGroup/releases/download/v1.6.0/AppGroup_v1.6.0.win-x64.zip",
            "hash": "5b8272f6deed5b14b52192e090a1cd8c244f22b5e4b7849b3ada39582c555bf9"
        }
    },
    "persist": "config",
    "bin": "AppGroup.exe",
    "shortcuts": [
        [
            "AppGroup.exe",
            "AppGroup"
        ]
    ],
    "checkver": {
        "github": "https://github.com/iandiv/AppGroup",
        "regex": "v(?<version>[\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/iandiv/AppGroup/releases/download/v$version/AppGroup_v$version.win-x64.zip"
            }
        },
        "hash": {
            "url": "https://api.github.com/repos/iandiv/AppGroup/releases/tags/v$version",
            "regex": "\"name\":\\s*\"AppGroup_v$version\\.win-x64\\.zip\".*?\"digest\":\\s*\"sha256:([a-fA-F0-9]{64})\""
        }
    },
    "notes": "Uses the portable ZIP without the bundled .NET 8 runtime; .NET 8 must be installed separately. The config folder is persisted so portable AppGroup data survives Scoop upgrades."
}
