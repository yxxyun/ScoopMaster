{
    "version": "0.90+git7758",
    "description": "QElectroTech, or QET in short, is a free software to create industrial complex electric diagrams.",
    "homepage": "https://qelectrotech.org/",
    "license": {
        "identifier": "GNU General Public License v2.0",
        "url": "https://github.com/qelectrotech/qelectrotech-source-mirror/blob/master/LICENSE"
    },
    "notes": [
        "Scoop manifest of QElectroTech",
        "",
        "The location of the conf file is \"~/.config/qelectrotech/conf\".",
        "",
        "The conf file remains even after uninstalling QElectroTech.",
        "If you no longer need the conf file, please delete \"~/.config/qelectrotech\".",
        "-----"
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/qelectrotech/qelectrotech-source-mirror/releases/download/0.9/qelectrotech-0.90+git7758-x86-win64-readytouse.7z",
            "hash": "DDE10CBC8FB9E0EDD17F7801151ED4EE20AA63B688D23BB97BCF4EE37F13E048"
        }
    },
    "extract_dir": "qelectrotech-0.90+git7758-x86-win64-readytouse",
    "post_install": [
        "$len_bat = \"$dir\\Lancer QET.bat\"",
        "$len_conf = \"$env:USERPROFILE\\.config\\qelectrotech\\conf\"",
        "if (!(Test-Path $len_conf)) {",
        "   New-Item -ItemType Directory -Path $len_conf -Force | Out-Null",
        "   Copy-Item \"$dir\\conf\\*\" $len_conf -Recurse -Force",
        "}",
        "$content = Get-Content -Path $len_bat -Raw",
        "$content = $content -replace '--config-dir=conf/', \"--config-dir=`\"$len_conf`\"\"",
        "$content = $content -replace '--data-dir=conf/', \"--data-dir=`\"$len_conf`\"\"",
        "Set-Content -Path $len_bat -Value $content -Encoding ASCII -NoNewline"
    ],
    "bin": [
        [
            "Lancer QET.bat",
            "qet"
        ]
    ],
    "checkver": {
        "url": "https://api.github.com/repos/qelectrotech/qelectrotech-source-mirror/releases/latest",
        "regex": "qelectrotech-(?<version>[\\d.]+\\+git[0-9a-fA-F]+)-x86-win64-readytouse\\.7z"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/qelectrotech/qelectrotech-source-mirror/releases/download/$majorVersion.$minorVersion/qelectrotech-$version-x86-win64-readytouse.7z"
            }
        },
        "hash": {
            "mode": "download"
        },
        "extract_dir": "qelectrotech-$$version-x86-win64-readytouse"
    }
}
