{
    "version": "1.4.2",
    "description": "Ship of Harkinain build supporting Archipelago randomizer",
    "homepage": "https://github.com/HarbourMasters/Archipelago-SoH",
    "license": "MIT",
    "notes": "Ship of Harkinian fork with support for the Archipelago randomizer",
    "suggest": {
        "archipelago": "spiraster/archipelago"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/HarbourMasters/Archipelago-SoH/releases/download/Soh_1.4.2/SoH_Archipelago_1-4-2_Windows.zip",
            "hash": "6f954ea330db23a04c8fb5aace263841a7e9cfe0c69c7b96d124bea844ee5723"
        }
    },
    "pre_install": [
        "'shipofharkinian.json', 'imgui.ini' | % {",
        "   if (!(Test-Path \"$persist_dir\\$_\")) {",
        "      New-Item \"$dir\\$_\" | Out-Null",
        "   }",
        "}"
    ],
    "post_install": [
        "'oot.o2r', 'oot-mq.o2r' | % {",
        "   if (Test-Path \"$persist_dir\\$_\") {",
        "       Copy-Item \"$persist_dir\\$_\" \"$dir\\$_\" -Force",
        "   }",
        "}"
    ],
    "shortcuts": [
        [
            "soh.exe",
            "Ship of Harkinian (AP)"
        ]
    ],
    "persist": [
        "logs",
        "mods",
        "Randomizer",
        "Save",
        "shipofharkinian.json",
        "imgui.ini"
    ],
    "pre_uninstall": [
        "'oot.o2r', 'oot-mq.o2r' | % {",
        "   if (Test-Path \"$dir\\$_\") {",
        "       Copy-Item \"$dir\\$_\" \"$persist_dir\\$_\" -Force",
        "   }",
        "}"
    ],
    "checkver": {
        "github": "https://github.com/HarbourMasters/Archipelago-SoH",
        "regex": "(?i)(?<tag>soh_(?<version>[\\d\\.]+))"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/HarbourMasters/Archipelago-SoH/releases/download/$matchTag/SoH_Archipelago_$dashVersion_Windows.zip"
            }
        }
    }
}
