{
    "$schema": "https://raw.githubusercontent.com/ScoopInstaller/Scoop/master/schema.json",
    "version": "2.02.61",
    "description": "TinTin++ is a console MUD client with support for scripting, automapping, and VT100 emulation.",
    "homepage": "https://tintin.mudhalla.net/",
    "license": "GPL-3.0-or-later",
    "url": "https://github.com/scandum/tintin/releases/download/2.02.61/wintin-2.02.61.msi",
    "hash": "421a1458080413d5135a7490dc05ac0f4b54f1caadbfc033214536237420e847",
    "pre_install": [
        "if (Test-Path \"$dir\\APPDIR\") {",
        "    Get-ChildItem \"$dir\\APPDIR\" | Move-Item -Destination \"$dir\"",
        "    Remove-Item \"$dir\\APPDIR\" -Recurse -Force",
        "}"
    ],
    "bin": [
        [
            "bin\\tt++.exe",
            "tt++"
        ]
    ],
    "persist": "bin\\mintty.con",
    "checkver": {
        "github": "https://github.com/scandum/tintin"
    },
    "autoupdate": {
        "url": "https://github.com/scandum/tintin/releases/download/$version/wintin-$version.msi"
    }
