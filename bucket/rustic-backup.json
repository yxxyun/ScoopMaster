{
  "version": "0.2.1",
  "description": "Incremental backup tool based on rustic with WeCom notification",
  "homepage": "https://github.com/yanlearn2/rustic-backup-rs",
  "license": "MIT",
  "architecture": {
    "64bit": {
      "url": "https://github.com/yanlearn2/rustic-backup-rs/releases/download/v0.2.1/RusticBackup-Setup.exe",
      "hash": "daa00a8a0f6d88c62b53bd8952bbfe46ae6b74b7f40e8d9d9784ac963577c902"
    }
  },
  "installer": {
    "script": [
      "$exe = Join-Path $dir 'RusticBackup-Setup.exe'",
      "$installDir = Join-Path $dir 'app'",
      "Start-Process -FilePath $exe -ArgumentList '/VERYSILENT','/SUPPRESSMSGBOXES','/NORESTART',\"/DIR=$installDir\" -Wait"
    ]
  },
  "uninstaller": {
    "script": [
      "$uninst = Join-Path $dir 'app\\unins000.exe'",
      "if (Test-Path $uninst) { Start-Process -FilePath $uninst -ArgumentList '/VERYSILENT','/SUPPRESSMSGBOXES' -Wait }"
    ]
  },
  "bin": ["app\\rustic-backup.exe"],
  "checkver": "github",
  "autoupdate": {
    "architecture": {
      "64bit": {
        "url": "https://github.com/yanlearn2/rustic-backup-rs/releases/download/v$version/RusticBackup-Setup.exe"
      }
    }
  }
}
