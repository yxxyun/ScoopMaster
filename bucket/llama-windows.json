{
    "version": "0.14.1.0",
    "description": "Windows Llama App Companion",
    "homepage": "https://llama.app",
    "license": "MIT",
    "notes": "程序内置更新检查会提示 GitHub 上的新版本, 请用 scoop update llama-windows 升级。设置、本地模型目录与上下文预设保存在 Scoop 的 persist 目录, 下载的模型缓存仍在 Hugging Face 的默认缓存目录。更新或卸载前请先退出程序。",
    "architecture": {
        "64bit": {
            "url": "https://github.com/ggml-org/Llama-Windows/releases/download/v0.14.1/LlamaApp_0.14.1.0_x64.msix#/dl.zip",
            "hash": "1bd05c6ce8b5147636a37ec6508f7cac9090e1d9d320975d0dd4bf546e9d95cc"
        },
        "arm64": {
            "url": "https://github.com/ggml-org/Llama-Windows/releases/download/v0.14.1/LlamaApp_0.14.1.0_arm64.msix#/dl.zip",
            "hash": "1a23fc3e431226d3e792a90f7063c760a8beb081e5c7761b5afc8f3644d7a411"
        }
    },
    "persist": "LlamaApp.exe.WebView2",
    "persist_link": [
        [
            "$env:LocalAppData\\Llama",
            "LocalAppData"
        ],
        [
            "$env:UserProfile\\.llama",
            "UserProfile"
        ]
    ],
    "pre_install": "Remove-InstallerResidue -Include 'Appx*', '[[]Content_Types].xml'",
    "post_uninstall": [
        "Get-ChildItem 'HKCU:\\Software\\Classes\\AppUserModelId' -ErrorAction SilentlyContinue | Where-Object { $_.PSChildName -like '*llama-windows*' } | Remove-Item -Recurse -Force",
        "Get-ChildItem 'HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Notifications\\Settings' -ErrorAction SilentlyContinue | Where-Object { $_.PSChildName -like '*llama-windows*' } | Remove-Item -Recurse -Force"
    ],
    "shortcuts": [
        [
            "LlamaApp.exe",
            "Llama"
        ]
    ],
    "checkver": {
        "github": "https://api.github.com/repos/ggml-org/Llama-Windows/releases/latest",
        "jsonpath": "$.assets[*].name",
        "regex": "LlamaApp_([\\d.]+)_x64\\.msix"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/ggml-org/Llama-Windows/releases/download/v$matchHead/LlamaApp_$version_x64.msix#/dl.zip"
            },
            "arm64": {
                "url": "https://github.com/ggml-org/Llama-Windows/releases/download/v$matchHead/LlamaApp_$version_arm64.msix#/dl.zip"
            }
        }
    }
}
