{
    "version": "1.3.0",
    "description": "AI agent toolkit: unified LLM API, agent loop, TUI, coding agent CLI",
    "homepage": "https://github.com/earendil-works/pi",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/earendil-works/pi/releases/download/v1.3.0/pi-windows-x64.zip",
            "hash": "daf0ef45fd08f13dbb64c62d559e332c2d3d3087f8ae022ec5a1b9b655b59894"
        },
        "arm64": {
            "url": "https://github.com/earendil-works/pi/releases/download/v1.3.0/pi-windows-arm64.zip",
            "hash": "a349536d76bd83842f7b28db73a6ab89c68015731110aba299e57233539a0ded"
        }
    },
    "pre_install": "Set-Content \"$dir\\pi.cmd\" -Value '@\"%~dp0pi.exe\" %*' -Encoding ASCII",
    "post_install": [
        "$shimCmd = Join-Path (shimdir $global) 'pi.cmd'",
        "Set-Content $shimCmd -Value '@rem pi shim for cmd`r`n@\"%~dp0pi.exe\" %*' -Encoding ASCII",
        "$legacy = Join-Path (shimdir $global) 'pi'",
        "if (Test-Path $legacy) { Remove-Item $legacy -Force -ErrorAction SilentlyContinue }"
    ],
    "bin": "pi.exe",
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/earendil-works/pi/releases/download/v$version/pi-windows-x64.zip"
            },
            "arm64": {
                "url": "https://github.com/earendil-works/pi/releases/download/v$version/pi-windows-arm64.zip"
            }
        }
    }
}
