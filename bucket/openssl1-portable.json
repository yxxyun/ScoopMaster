{
    "version": "1.1.1w",
    "description": "OpenSSL Portable Builds(on windows)",
    "homepage": "https://github.com/pedoc/openssl-builds/releases",
    "license": {
        "identifier": "OpenSSL",
        "url": "https://github.com/openssl/openssl/blob/OpenSSL_1_1_1w/LICENSE"
    },
    "notes": "mirror of https://github.com/xanasoft/openssl-builds",
    "architecture": {
        "64bit": {
            "url": "https://github.com/pedoc/openssl-builds/releases/download/v1.1.1w/openssl-1.1.1w-x64-artifacts.zip",
            "hash": "9967cca81bd7a14f24d420dbada766bbd1a8792d83fa6dd66da18b763ddce669",
            "extract_dir": "openssl-1.1.1w"
        }
    },
    "bin": [
        [
            "openssl.exe",
            "openssl1"
        ]
    ],
    "checkver": {
        "url": "https://api.github.com/repos/pedoc/openssl-builds/releases/latest",
        "jsonpath": "$.assets[*].browser_download_url",
        "regex": "download/(?<tag>v[\\d.]+)/(?<asset>openssl-(?<ver>1\\.[\\d.]+[a-z]*)-x64-artifacts\\.zip)(?![\\w.])",
        "replace": "${ver}"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/pedoc/openssl-builds/releases/download/$matchTag/$matchAsset",
                "extract_dir": "openssl-$version"
            }
        }
    }
}
