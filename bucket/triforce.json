{
    "version": "0.8.3",
    "description": "Native PC port of The Legend of Zelda: Ocarina of Time built through static recompilation",
    "homepage": "https://triforceproject.com",
    "license": "GPL-3.0-or-later",
    "notes": [
        "Launch Triforce from the Start menu or run 'triforce' to run the launcher in-place from the Scoop install directory.",
        "Building the game requires your own copy of The Legend of Zelda: Ocarina of Time (Switch 2, update v131072 / build e0f3ccfa), a Vulkan 1.3 GPU with mesh shaders, 16 GB RAM, and about 60 GB free disk space while building.",
        "Launcher settings are stored in HKCU\\Software\\Triforce, cache/build files in %LOCALAPPDATA%\\Triforce, and the built game/saves in your chosen game folder (default: %USERPROFILE%\\Games\\Triforce)."
    ],
    "architecture": {
        "64bit": {
            "url": [
                "https://git.triforceproject.com/triforce/downloads/releases/download/v0.8.3/TriforceSetup.exe",
                "https://git.triforceproject.com/triforce/downloads/releases/download/v0.8.3/Triforce-Tools.zip"
            ],
            "hash": [
                "4c7acab8cd2f65c0d6b9efb4faf320f6e7b922c0bb438146956e434e33fa6def",
                "af2bc874b7f07841c4802664a3e39681fcb57382b19ad95b8b9a3bf95961fd12"
            ]
        }
    },
    "pre_install": "@('@echo off', 'setlocal', 'set \"TRIFORCE_DEV=1\"', 'start \"\" /D \"%~dp0\" \"%~dp0TriforceSetup.exe\" %*') | Set-Content \"$dir\\triforce.cmd\" -Encoding Ascii",
    "bin": "triforce.cmd",
    "shortcuts": [
        [
            "triforce.cmd",
            "Triforce",
            "",
            "TriforceSetup.exe"
        ]
    ],
    "persist": [
        "ngx-sdk",
        "save-backups"
    ],
    "checkver": {
        "url": "https://git.triforceproject.com/api/v1/repos/triforce/downloads/releases?limit=1",
        "jsonpath": "$[0].tag_name",
        "regex": "v([\\d.]+(?:-[\\w.]+)?)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": [
                    "https://git.triforceproject.com/triforce/downloads/releases/download/v$version/TriforceSetup.exe",
                    "https://git.triforceproject.com/triforce/downloads/releases/download/v$version/Triforce-Tools.zip"
                ]
            }
        }
    }
}
