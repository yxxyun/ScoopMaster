{
    "$schema": "https://raw.githubusercontent.com/lukesampson/scoop/master/schema.json",
    "version": "1.0.5",
    "description": "Unofficial YouTube Music Desktop wrapper with some extra features.",
    "homepage": "https://github.com/typefasterjoel/yumu",
    "license": "GPL-3.0-only",
    "architecture": {
        "64bit": {
            "url": "https://github.com/typefasterjoel/yumu/releases/download/v1.0.5/yumu-1.0.5-setup.exe#/dl.7z",
            "hash": "a572adbfe5f6c75e4aad4df23ffc380732b1e7783e067328b2865c373f952cbc"
        }
    },
    "installer": {
        "script": [
            "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-64.7z\" \"$dir\"",
            "Remove-Item \"$dir\\`$PLUGINSDIR\", \"$dir\\Uninstall*\" -Force -Recurse"
        ]
    },
    "bin": "yumu.exe",
    "shortcuts": [
        [
            "yumu.exe",
            "Yumu"
        ]
    ],
    "checkver": {
        "github": "https://github.com/typefasterjoel/yumu",
        "regex": "/releases/tag/(?:v|V)?\\.?([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/typefasterjoel/yumu/releases/download/v$version/yumu-$version-setup.exe#/dl.7z"
            }
        }
    }
}
