{
    "version": "1.1",
    "description": "Portable edition of Vovsoft Face Detector.",
    "homepage": "https://vovsoft.com/software/face-detector/",
    "license": "Proprietary",
    "url": "https://vovsoft.com/files/face-detector-portable.zip?v=1.1",
    "checkver": {
        "url": "https://vovsoft.com/download/face-detector-portable/",
        "regex": "(?is)Version\\s*(?:<[^>]*>\\s*)*:?\\s*(?:<[^>]*>\\s*)*(?<version>\\d+(?:\\.\\d+)+)"
    },
    "autoupdate": {
        "url": "https://vovsoft.com/files/face-detector-portable.zip?v=$version"
    },
    "shortcuts": [
        [
            "facedetector.exe",
            "Vovsoft Face Detector"
        ]
    ],
    "notes": [
        "SHA-256 has not been verified; archive contents and the shortcut target have been checked."
    ],
    "pre_install": [
        "if (-not (Test-Path -LiteralPath \"$dir\\key.txt\" -PathType Leaf)) { New-Item -ItemType File -Path \"$dir\\key.txt\" | Out-Null }"
    ],
    "persist": "key.txt"
}
