{
    "version": "2026.8.2115.0",
    "description": "The Cloudflare One Client (formerly WARP) for Windows.",
    "homepage": "https://developers.cloudflare.com/cloudflare-one/team-and-resources/devices/cloudflare-one-client/",
    "license": "Unknown",
    "architecture": {
        "64bit": {
            "url": "https://downloads.cloudflareclient.com/v1/download/windows/version/2026.8.2115.0#/dl.msi",
            "hash": "ab3138dbebdf132af076b5ebcb25b42345d29258acb76267c3bd1f8cfea57a53",
            "extract_dir": "PFiles64\\Cloudflare\\Cloudflare WARP"
        }
    },
    "post_install": [
        "'install-context', 'uninstall-context' | ForEach-Object {",
        "    if (Test-Path \"$bucketsdir\\xn\\scripts\\cloudflare-one\\$_.reg\") {",
        "        $cfdir = \"$dir\".Replace('\\', '\\\\')",
        "        $content = (Get-Content \"$bucketsdir\\xn\\scripts\\cloudflare-one\\$_.reg\").Replace('$cfdir', $cfdir)",
        "        if ($global) { $content = $content.Replace('HKEY_CURRENT_USER', 'HKEY_LOCAL_MACHINE') }",
        "        Set-Content \"$dir\\$_.reg\" $content -Encoding Ascii -Force",
        "    }",
        "}",
        "if (Test-Path \"$dir\\install-context.reg\") {",
        "    reg import \"$dir\\install-context.reg\"",
        "}"
    ],
    "bin": [
        "warp-cli.exe",
        "warp-dex.exe",
        "warp-diag.exe",
        "warp-svc.exe",
        "warp-updater.exe"
    ],
    "shortcuts": [
        [
            "Cloudflare WARP.exe",
            "Cloudflare WARP"
        ]
    ],
    "pre_uninstall": [
        "if ($cmd -eq 'uninstall') { reg import \"$dir\\uninstall-context.reg\" }"
    ],
    "checkver": {
        "url": "https://developers.cloudflare.com/cloudflare-one/team-and-resources/devices/cloudflare-one-client/download/",
        "regex": "Version: </strong>Windows ([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://downloads.cloudflareclient.com/v1/download/windows/version/$version#/dl.msi"
            }
        }
    },
    "notes": [
        "Default data folder `CloudflareData` is located in C:\\ProgramData\\Cloudflare",
        "",
        "Cloudflare One depends on the warp-svc.exe service to function properly.",
        "Ensure that you have administrative privileges to start the service.",
        "",
        "Run the warp-svc service using the following command on PowerShell:",
        "Start-Process $dir\\warp-svc.exe -WindowStyle Hidden",
        "And then you can use the Cloudflare WARP client or warp-cli.",
        "",
        "Run the following command to shutdown the warp-svc service:",
        "Stop-Process -Name warp-svc",
        "And then kill warp-related processes in Task Manager if necessary manually."
    ]
}
