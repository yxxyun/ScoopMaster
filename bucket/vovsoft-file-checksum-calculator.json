{
    "version": "2.5",
    "description": "Portable edition of Vovsoft File Checksum Calculator.",
    "homepage": "https://vovsoft.com/software/file-checksum-calculator/",
    "license": "Proprietary",
    "url": "https://vovsoft.com/files/file-checksum-calculator-portable.zip?v=2.5",
    "checkver": {
        "url": "https://vovsoft.com/download/file-checksum-calculator-portable/",
        "regex": "(?is)Version\\s*(?:<[^>]*>\\s*)*:?\\s*(?:<[^>]*>\\s*)*(?<version>\\d+(?:\\.\\d+)+)"
    },
    "autoupdate": {
        "url": "https://vovsoft.com/files/file-checksum-calculator-portable.zip?v=$version"
    },
    "shortcuts": [
        [
            "filechecksum.exe",
            "Vovsoft File Checksum Calculator"
        ]
    ],
    "notes": [
        "SHA-256 has not been verified; archive contents and the shortcut target have been checked."
    ],
    "pre_install": [
        "if (-not (Test-Path -LiteralPath \"$dir\\key.txt\" -PathType Leaf)) { New-Item -ItemType File -Path \"$dir\\key.txt\" | Out-Null }"
    ],
    "persist": "key.txt"
}
