{
    "version": "0.1.2-0",
    "description": "A fast, open-source launcher for macOS, Windows, and Linux.",
    "homepage": "https://asyar.org/",
    "license": "GPL-3.0",
    "architecture": {
        "64bit": {
            "url": "https://github.com/Xoshbin/asyar/releases/download/v0.1.2-0/asyar_windows_x64_portable.zip",
            "hash": "8d20a9f8a3454e4ae40e6b1f94b388bfbff4fc79905b0fb20e5932dde6bb0ce2"
        },
        "arm64": {
            "url": "https://github.com/Xoshbin/asyar/releases/download/v0.1.2-0/asyar_windows_arm64_portable.zip",
            "hash": "51d92dc79a2673e3a7229ab965515c17b5afe908a8bf754b11d02c49d0414da9"
        }
    },
    "shortcuts": [
        [
            "asyar.exe",
            "Asyar"
        ]
    ],
    "post_uninstall": [
        "if ($purge) {",
        "    $env:APPDATA, $env:LOCALAPPDATA | ForEach-Object {",
        "        Join-Path -Path $_ -ChildPath 'org.asyar.app' | Remove-Item -Force -Recurse -ErrorAction SilentlyContinue",
        "    }",
        "}"
    ],
    "checkver": {
        "github": "https://api.github.com/repos/Xoshbin/asyar/releases",
        "jsonpath": "$[*].tag_name",
        "regex": "v([\\d.]+-\\d+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/Xoshbin/asyar/releases/download/v$version/asyar_windows_x64_portable.zip"
            },
            "arm64": {
                "url": "https://github.com/Xoshbin/asyar/releases/download/v$version/asyar_windows_arm64_portable.zip"
            }
        }
    }
}
