{
    "version": "0.1.2-2",
    "description": "A fast, open-source launcher for macOS, Windows, and Linux.",
    "homepage": "https://asyar.org/",
    "license": "GPL-3.0",
    "architecture": {
        "64bit": {
            "url": "https://github.com/Xoshbin/asyar/releases/download/v0.1.2-2/asyar_windows_x64_portable.zip",
            "hash": "51a268897f12e8158fffe0e23ccf6989be84ff0d4758e426a0e6517cda513d6e"
        },
        "arm64": {
            "url": "https://github.com/Xoshbin/asyar/releases/download/v0.1.2-2/asyar_windows_arm64_portable.zip",
            "hash": "36228d4311f8e8492a314878a06a65c6b7a765b9552ee4d102da668f99507694"
        }
    },
    "shortcuts": [
        [
            "asyar.exe",
            "Asyar"
        ]
    ],
    "post_uninstall": [
        "if ($purge) {",
        "    $env:APPDATA, $env:LOCALAPPDATA | ForEach-Object {",
        "        Join-Path -Path $_ -ChildPath 'org.asyar.app' | Remove-Item -Force -Recurse -ErrorAction SilentlyContinue",
        "    }",
        "}"
    ],
    "checkver": {
        "github": "https://api.github.com/repos/Xoshbin/asyar/releases",
        "jsonpath": "$[*].tag_name",
        "regex": "v([\\d.]+-\\d+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/Xoshbin/asyar/releases/download/v$version/asyar_windows_x64_portable.zip"
            },
            "arm64": {
                "url": "https://github.com/Xoshbin/asyar/releases/download/v$version/asyar_windows_arm64_portable.zip"
            }
        }
    }
}
