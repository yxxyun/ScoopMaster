{
    "version": "0.1.1-54",
    "description": "A fast, open-source launcher for macOS, Windows, and Linux.",
    "homepage": "https://asyar.org/",
    "license": "GPL-3.0",
    "architecture": {
        "64bit": {
            "url": "https://github.com/Xoshbin/asyar/releases/download/v0.1.1-54/asyar_windows_x64_portable.zip",
            "hash": "b90b67fbab0a58958bc7668411eb39f71d2236dd9f8cb75c84512ef0757d8eff"
        },
        "arm64": {
            "url": "https://github.com/Xoshbin/asyar/releases/download/v0.1.1-54/asyar_windows_arm64_portable.zip",
            "hash": "ffe52feb9fe7b7175a009b24e8b10d847f4f1b83ffd9ca3beb50aa7013d5db36"
        }
    },
    "shortcuts": [
        [
            "asyar.exe",
            "Asyar"
        ]
    ],
    "post_uninstall": [
        "if ($purge) {",
        "    $env:APPDATA, $env:LOCALAPPDATA | ForEach-Object {",
        "        Join-Path -Path $_ -ChildPath 'org.asyar.app' | Remove-Item -Force -Recurse -ErrorAction SilentlyContinue",
        "    }",
        "}"
    ],
    "checkver": {
        "github": "https://api.github.com/repos/Xoshbin/asyar/releases",
        "jsonpath": "$[*].tag_name",
        "regex": "v([\\d.]+-\\d+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/Xoshbin/asyar/releases/download/v$version/asyar_windows_x64_portable.zip"
            },
            "arm64": {
                "url": "https://github.com/Xoshbin/asyar/releases/download/v$version/asyar_windows_arm64_portable.zip"
            }
        }
    }
}
