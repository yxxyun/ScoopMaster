{
    "version": "0.1.2-3",
    "description": "A fast, open-source launcher for macOS, Windows, and Linux.",
    "homepage": "https://asyar.org/",
    "license": "GPL-3.0",
    "architecture": {
        "64bit": {
            "url": "https://github.com/Xoshbin/asyar/releases/download/v0.1.2-3/asyar_windows_x64_portable.zip",
            "hash": "e50652f1b11cb6b39f79abc88d91e4bb6d85213785db0e528fc7e8948e04dd8c"
        },
        "arm64": {
            "url": "https://github.com/Xoshbin/asyar/releases/download/v0.1.2-3/asyar_windows_arm64_portable.zip",
            "hash": "b148ed6fa14af0f9c2e24654505be39eb33734749b4fe6f99d036d27c5248fe5"
        }
    },
    "shortcuts": [
        [
            "asyar.exe",
            "Asyar"
        ]
    ],
    "post_uninstall": [
        "if ($purge) {",
        "    $env:APPDATA, $env:LOCALAPPDATA | ForEach-Object {",
        "        Join-Path -Path $_ -ChildPath 'org.asyar.app' | Remove-Item -Force -Recurse -ErrorAction SilentlyContinue",
        "    }",
        "}"
    ],
    "checkver": {
        "github": "https://api.github.com/repos/Xoshbin/asyar/releases",
        "jsonpath": "$[*].tag_name",
        "regex": "v([\\d.]+-\\d+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/Xoshbin/asyar/releases/download/v$version/asyar_windows_x64_portable.zip"
            },
            "arm64": {
                "url": "https://github.com/Xoshbin/asyar/releases/download/v$version/asyar_windows_arm64_portable.zip"
            }
        }
    }
}
