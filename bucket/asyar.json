{
    "version": "0.1.2-5",
    "description": "A fast, open-source launcher for macOS, Windows, and Linux.",
    "homepage": "https://asyar.org/",
    "license": "GPL-3.0",
    "architecture": {
        "64bit": {
            "url": "https://github.com/Xoshbin/asyar/releases/download/v0.1.2-5/asyar_windows_x64_portable.zip",
            "hash": "20adc3917058b641830a4326770ab853808222945ef0593c8b609195285cfbd7"
        },
        "arm64": {
            "url": "https://github.com/Xoshbin/asyar/releases/download/v0.1.2-5/asyar_windows_arm64_portable.zip",
            "hash": "f21e41ef29345f77f8ca06ba6e175a8e7ba22c1e090fdf2e9c57f989ead97ada"
        }
    },
    "shortcuts": [
        [
            "asyar.exe",
            "Asyar"
        ]
    ],
    "post_uninstall": [
        "if ($purge) {",
        "    $env:APPDATA, $env:LOCALAPPDATA | ForEach-Object {",
        "        Join-Path -Path $_ -ChildPath 'org.asyar.app' | Remove-Item -Force -Recurse -ErrorAction SilentlyContinue",
        "    }",
        "}"
    ],
    "checkver": {
        "github": "https://api.github.com/repos/Xoshbin/asyar/releases",
        "jsonpath": "$[*].tag_name",
        "regex": "v([\\d.]+-\\d+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/Xoshbin/asyar/releases/download/v$version/asyar_windows_x64_portable.zip"
            },
            "arm64": {
                "url": "https://github.com/Xoshbin/asyar/releases/download/v$version/asyar_windows_arm64_portable.zip"
            }
        }
    }
}
