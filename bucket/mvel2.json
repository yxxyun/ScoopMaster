{
    "homepage": "https://github.com/mvel/mvel",
    "version": "2.4.14",
    "license": "Apache-2.0",
    "architecture": {
        "64bit": {
            "url": "https://github.com/pedoc/scoop-packages/releases/download/asset-mvel2/mvel2-2.4.14.Final.jar",
            "hash": "sha256:ad0ff955c33d25187cab4ba8840ccea2bdf0fb689843fbb5f47f50055e9b4b3b"
        }
    },
    "shortcuts": [
        [
            "mvel2.bat",
            "mvel2"
        ]
    ],
    "pre_install": [
        "New-Item -Path \"$dir\\mvel2.bat\" -ItemType 'file' -Force",
        "Add-Content -Path \"$dir\\mvel2.bat\" -Value \"start /B java -jar $dir\\mvel2-2.4.14.Final.jar\""
    ],
    "description": "MVEL (MVFLEX Expression Language).",
    "checkver": {
        "url": "https://api.github.com/repos/pedoc/scoop-packages/releases/tags/asset-mvel2",
        "script": [
            "$release = $page | ConvertFrom-Json",
            "$assets = @($release.assets | Where-Object { $_.name -cmatch '^mvel2-\\d+\\.\\d+(?:\\.\\d+){0,2}\\.Final\\.jar$' })",
            "$asset = $assets | Sort-Object { [version]([regex]::Match($_.name, '^mvel2-([\\d.]+)\\.Final\\.jar$').Groups[1].Value) } -Descending | Select-Object -First 1",
            "if (-not $asset.browser_download_url) { throw 'No versioned mirrored MVEL JAR asset found' }",
            "$asset.browser_download_url"
        ],
        "regex": "download/asset-mvel2/mvel2-(?<ver>[\\d.]+)\\.Final\\.jar(?![\\w.])",
        "replace": "${ver}"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/pedoc/scoop-packages/releases/download/asset-mvel2/mvel2-$version.Final.jar#/mvel2-2.4.14.Final.jar"
            }
        }
    }
}
