{
    "version": "6.7",
    "description": "Portable edition of Vovsoft HTTP Requester.",
    "homepage": "https://vovsoft.com/software/http-requester/",
    "license": "Proprietary",
    "url": "https://vovsoft.com/files/http-requester-portable.zip?v=6.7",
    "checkver": {
        "url": "https://vovsoft.com/download/http-requester-portable/",
        "regex": "(?is)Version\\s*(?:<[^>]*>\\s*)*:?\\s*(?:<[^>]*>\\s*)*(?<version>\\d+(?:\\.\\d+)+)"
    },
    "autoupdate": {
        "url": "https://vovsoft.com/files/http-requester-portable.zip?v=$version"
    },
    "shortcuts": [
        [
            "httprequester.exe",
            "Vovsoft HTTP Requester"
        ]
    ],
    "notes": "SHA-256 has not been verified; archive contents and the shortcut target have been checked.",
    "pre_install": "if (-not (Test-Path -LiteralPath \"$dir\\key.txt\" -PathType Leaf)) { New-Item -ItemType File -Path \"$dir\\key.txt\" | Out-Null }",
    "persist": "key.txt"
}
