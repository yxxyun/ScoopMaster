{
    "version": "1.4.0-rc.6",
    "description": "Feature rich, native desktop YouTube Music client built with Tauri and Rust",
    "homepage": "https://github.com/SimoHypers/limusic",
    "license": "GPL-3.0-or-later",
    "architecture": {
        "64bit": {
            "url": "https://github.com/SimoHypers/limusic/releases/download/v1.4.0-rc.6/limusic_1.4.0-rc.6_x64-setup.exe#/dl.7z",
            "hash": "d123bd93e63ede9410eed30ba3f5ea1fb021eab97b93fb650e649c31386936f5"
        }
    },
    "pre_install": [
        "$subdirs = @('$INSTDIR', '$_OUTDIR')",
        "foreach ($sub in $subdirs) {",
        "    $subPath = Join-Path $dir $sub",
        "    if (Test-Path $subPath) {",
        "        Get-ChildItem \"$subPath\\*\" | Move-Item -Destination $dir -Force",
        "        Remove-Item $subPath -Recurse -Force",
        "    }",
        "}",
        "$plugins = Join-Path $dir '$PLUGINSDIR'",
        "if (Test-Path $plugins) {",
        "    Remove-Item $plugins -Recurse -Force",
        "}",
        "Remove-Item \"$dir\\uninstall*.exe*\" -Force -ErrorAction SilentlyContinue"
    ],
    "bin": [
        [
            "limusic-app.exe",
            "limusic"
        ]
    ],
    "shortcuts": [
        [
            "limusic-app.exe",
            "LiMusic"
        ]
    ],
    "checkver": {
        "github": "https://api.github.com/repos/SimoHypers/limusic/releases",
        "jsonpath": "$[0].tag_name",
        "regex": "^v?([\\w.-]+)$"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/SimoHypers/limusic/releases/download/v$version/limusic_$version_x64-setup.exe#/dl.7z"
            }
        }
    }
}
