{
    "version": "1.7.11",
    "description": "Habit tracker for weekly planning, tasks, goals, and reminders.",
    "homepage": "https://github.com/English-Muffin/GroundworkHabits",
    "license": "AGPL-3.0-or-later",
    "url": "https://github.com/English-Muffin/GroundworkHabits/releases/download/v1.7.11/Groundwork-Habits-1.7.11-Windows-portable.exe#/groundwork-habits.exe",
    "hash": "46bf922318c00cd42cbae1dfb61dd7b4532d02dc4f88f21d131fc827bb530e24",
    "persist": [
        "data",
        "webview2"
    ],
    "post_install": [
        "$junctions = @(",
        "    @{ Path = (Join-Path $env:APPDATA 'Groundwork Habits'); Target = (Join-Path $persist_dir 'data') },",
        "    @{ Path = (Join-Path $env:LOCALAPPDATA 'com.groundwork.habits'); Target = (Join-Path $persist_dir 'webview2') }",
        ")",
        "foreach ($junction in $junctions) {",
        "    $path = [string]$junction.Path",
        "    $target = [string]$junction.Target",
        "    if (-not (Test-Path -LiteralPath $target -PathType Container)) {",
        "        New-Item -ItemType Directory -Path $target -Force | Out-Null",
        "    }",
        "    $existing = Get-Item -LiteralPath $path -Force -ErrorAction SilentlyContinue",
        "    if ($null -ne $existing) {",
        "        if (($existing.Attributes -band [IO.FileAttributes]::ReparsePoint) -ne 0) {",
        "            if ($existing.LinkType -eq 'Junction' -and [IO.Path]::GetFullPath([string]$existing.Target) -ieq [IO.Path]::GetFullPath($target)) { continue }",
        "            throw ('Refusing to replace an unexpected reparse point at ' + $path)",
        "        }",
        "        $sourceItems = @(Get-ChildItem -LiteralPath $path -Force)",
        "        $targetItems = @(Get-ChildItem -LiteralPath $target -Force)",
        "        if ($sourceItems.Count -gt 0 -and $targetItems.Count -gt 0) {",
        "            throw ('Both ' + $path + ' and ' + $target + ' contain data; refusing to overwrite either location.')",
        "        }",
        "        if ($sourceItems.Count -gt 0) { $sourceItems | Move-Item -Destination $target }",
        "        Remove-Item -LiteralPath $path -Force",
        "    }",
        "    New-Item -ItemType Junction -Path $path -Target $target | Out-Null",
        "}"
    ],
    "pre_uninstall": [
        "$junctions = @(",
        "    @{ Path = (Join-Path $env:APPDATA 'Groundwork Habits'); Target = (Join-Path $persist_dir 'data') },",
        "    @{ Path = (Join-Path $env:LOCALAPPDATA 'com.groundwork.habits'); Target = (Join-Path $persist_dir 'webview2') }",
        ")",
        "foreach ($junction in $junctions) {",
        "    $path = [string]$junction.Path",
        "    $target = [string]$junction.Target",
        "    $existing = Get-Item -LiteralPath $path -Force -ErrorAction SilentlyContinue",
        "    if ($null -ne $existing -and",
        "        ($existing.Attributes -band [IO.FileAttributes]::ReparsePoint) -ne 0 -and",
        "        $existing.LinkType -eq 'Junction' -and",
        "        [IO.Path]::GetFullPath([string]$existing.Target) -ieq [IO.Path]::GetFullPath($target)) {",
        "        $removeCommand = 'rmdir \"' + $path + '\"'",
        "        & $env:ComSpec /d /c $removeCommand",
        "        if ($LASTEXITCODE -ne 0) { throw ('Failed to remove the Groundwork junction at ' + $path + '; cmd exit code: ' + $LASTEXITCODE) }",
        "    }",
        "}"
    ],
    "shortcuts": [
        [
            "groundwork-habits.exe",
            "Groundwork Habits"
        ]
    ],
    "checkver": {
        "github": "https://github.com/English-Muffin/GroundworkHabits"
    },
    "autoupdate": {
        "url": "https://github.com/English-Muffin/GroundworkHabits/releases/download/v$version/Groundwork-Habits-$version-Windows-portable.exe#/groundwork-habits.exe",
        "hash": {
            "url": "https://api.github.com/repos/English-Muffin/GroundworkHabits/releases/tags/v$version",
            "jsonpath": "$.assets[?(@.name == 'Groundwork-Habits-$version-Windows-portable.exe')].digest"
        }
    },
    "notes": [
        "The default configuration, backups, and WebView2 profile are stored under Scoop persist.",
        "A data folder explicitly selected inside the app remains at the location chosen by the user."
    ]
}
