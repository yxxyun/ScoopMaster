{
    "version": "0.14.0",
    "description": "Runs a published module or Maven artifact with one command - npx for Java.",
    "homepage": "https://github.com/jenesis/jenesis",
    "license": "Apache-2.0",
    "url": "https://github.com/jenesis/jenesis/releases/download/v0.14.0/jpx-0.14.0.zip",
    "hash": "sha256:733a3398f71f3588f341e173a34bbdde3c66ceead6f7cfbf227bae77c6a5c987",
    "extract_dir": "jpx-0.14.0",
    "env_add_path": "bin",
    "suggest": {
        "JDK": [
            "java/oraclejdk",
            "java/openjdk"
        ]
    },
    "checkver": {
        "url": "https://github.com/jenesis/jenesis/releases/latest",
        "re": "v([\\d.]+).zip"
    },
