{
    "version": "0.12.0",
    "description": "Runs a published module or Maven artifact with one command - npx for Java.",
    "homepage": "https://github.com/jenesis/jenesis",
    "license": "Apache-2.0",
    "url": "https://github.com/jenesis/jenesis/releases/download/v0.12.0/jpx-0.12.0.zip",
    "hash": "sha256:7d98f4b9c1592fac46fea3a867e6032d890e64fc611dcfbcb9fe527cf82538f2",
    "extract_dir": "jpx-0.12.0",
    "env_add_path": "bin",
    "suggest": {
        "JDK": [
            "java/oraclejdk",
            "java/openjdk"
        ]
    },
    "checkver": {
        "url": "https://github.com/jenesis/jenesis/releases/latest",
        "re": "v([\\d.]+).zip"
    },
    "autoupdate": {
        "url": "https://github.com/jenesis/jenesis/releases/download/v$version/jpx-$version.zip",
        "extract_dir": "jpx-$version",
        "hash": {
            "url": "$url.sha256"
        }
    }
}
