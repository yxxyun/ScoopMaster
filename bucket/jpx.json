{
    "version": "0.15.0",
    "description": "Runs a published module or Maven artifact with one command - npx for Java.",
    "homepage": "https://github.com/jenesis/jenesis",
    "license": "Apache-2.0",
    "url": "https://github.com/jenesis/jenesis/releases/download/v0.15.0/jpx-0.15.0.zip",
    "hash": "sha256:0c312a3fcb736f57e40b49fecbb5a165124a264aa877bb2de17f656b43929446",
    "extract_dir": "jpx-0.15.0",
    "env_add_path": "bin",
    "suggest": {
        "JDK": [
            "java/oraclejdk",
            "java/openjdk"
        ]
    },
    "checkver": {
        "url": "https://github.com/jenesis/jenesis/releases/latest",
        "re": "v([\\d.]+).zip"
    },
    "autoupdate": {
        "url": "https://github.com/jenesis/jenesis/releases/download/v$version/jpx-$version.zip",
        "extract_dir": "jpx-$version",
        "hash": {
            "url": "$url.sha256"
        }
    }
}
