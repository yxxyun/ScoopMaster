{
    "version": "0.13.0",
    "description": "Runs a published module or Maven artifact with one command - npx for Java.",
    "homepage": "https://github.com/jenesis/jenesis",
    "license": "Apache-2.0",
    "url": "https://github.com/jenesis/jenesis/releases/download/v0.13.0/jpx-0.13.0.zip",
    "hash": "sha256:3c24142d4e6ba8e02635b63ff4cc09f672db656a9ec8de56650455672dfee225",
    "extract_dir": "jpx-0.13.0",
    "env_add_path": "bin",
    "suggest": {
        "JDK": [
            "java/oraclejdk",
            "java/openjdk"
        ]
    },
    "checkver": {
        "url": "https://github.com/jenesis/jenesis/releases/latest",
        "re": "v([\\d.]+).zip"
    },
    "autoupdate": {
        "url": "https://github.com/jenesis/jenesis/releases/download/v$version/jpx-$version.zip",
        "extract_dir": "jpx-$version",
        "hash": {
            "url": "$url.sha256"
        }
    }
