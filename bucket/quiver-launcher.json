{
    "version": "4.0.0-beta.1",
    "description": "A modern launcher for downloading, installing, and running apps from GitHub and GitLab releases.",
    "homepage": "https://quiverlauncher.com/",
    "license": "MIT",
    "url": "https://github.com/tgeorgiadis/quiver-launcher/releases/download/v4.0.0-beta.1/QuiverLauncher-win-Portable.zip",
    "hash": "6d940798b93d7e03d873f0b58f03862237a975cf0a1b712d7992635b0daa83f7",
    "pre_install": [
        "ensure \"$persist_dir\" | Out-Null",
        "Get-ChildItem \"$persist_dir\\*\" -Include 'apps.json', 'settings.json' | Copy-Item -Destination \"$dir\" -ErrorAction SilentlyContinue"
    ],
    "shortcuts": [
        [
            "QuiverLauncher.exe",
            "Quiver Launcher"
        ]
    ],
    "persist": "Apps",
    "post_uninstall": "Get-ChildItem \"$dir\\*\" -Include 'apps.json', 'settings.json' | Copy-Item -Destination \"$persist_dir\" -ErrorAction SilentlyContinue -Force",
    "checkver": {
        "github": "https://api.github.com/repos/tgeorgiadis/quiver-launcher/releases",
        "jsonpath": "$[0].tag_name",
        "regex": "v([\\w.-]+)"
    },
    "autoupdate": {
        "url": "https://github.com/tgeorgiadis/quiver-launcher/releases/download/v$version/QuiverLauncher-win-Portable.zip"
    }
}
