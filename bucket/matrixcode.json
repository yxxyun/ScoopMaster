                "hash": {
                    "url": "https://api.github.com/repos/JamesBedford/MatrixCode/releases/tags/v$version",
                    "regex": "\"name\"\\s*:\\s*\"MatrixCode-[\\d.]+-windows-x64-portable\\.zip\"[\\s\\S]*?\"digest\"\\s*:\\s*\"sha256:([a-f0-9]{64})\""
                }
            },
            "arm64": {
                "url": "https://github.com/JamesBedford/MatrixCode/releases/download/v$version/MatrixCode-$version-windows-arm64-portable.zip",
                "hash": {
                    "url": "https://api.github.com/repos/JamesBedford/MatrixCode/releases/tags/v$version",
                    "regex": "\"name\"\\s*:\\s*\"MatrixCode-[\\d.]+-windows-arm64-portable\\.zip\"[\\s\\S]*?\"digest\"\\s*:\\s*\"sha256:([a-f0-9]{64})\""
                }
            }
        }
    },
    "notes": [
        "The manifest does not register Matrix Code in Windows Screen Saver Settings. The Start Menu shortcut launches the preview; configure the .scr file in Windows settings if you want it as the system screen saver.",
        "Requires Windows 10 version 2004 (build 19041) or newer."
    ]
