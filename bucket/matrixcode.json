{
    "version": "1.1.0",
    "description": "Open-source Matrix digital-rain application with a native Windows screensaver.",
    "homepage": "https://github.com/JamesBedford/MatrixCode",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/JamesBedford/MatrixCode/releases/download/v1.1.0/MatrixCode-1.1.0-windows-x64-portable.zip",
            "hash": "1e675e816f95954d03d922cb564f9f690c78c80278826098c2920b81adf233e1"
        },
        "arm64": {
            "url": "https://github.com/JamesBedford/MatrixCode/releases/download/v1.1.0/MatrixCode-1.1.0-windows-arm64-portable.zip",
            "hash": "be89718a2d78608c2c17a96e0fc221d46a8bb072f7b8d02979714bef8ad975f8"
        }
    },
    "bin": [
        [
            "MatrixCode.exe",
            "matrixcode"
        ]
    ],
    "shortcuts": [
        [
            "MatrixCode.exe",
            "Matrix Code"
        ],
        [
            "Matrix Code.scr",
            "Matrix Code Screen Saver",
            "/s"
        ]
    ],
    "checkver": {
        "github": "https://github.com/JamesBedford/MatrixCode",
        "regex": "v(?<version>[\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/JamesBedford/MatrixCode/releases/download/v$version/MatrixCode-$version-windows-x64-portable.zip",
                "hash": {
                    "url": "https://api.github.com/repos/JamesBedford/MatrixCode/releases/tags/v$version",
                    "regex": "\"name\"\\s*:\\s*\"MatrixCode-[\\d.]+-windows-x64-portable\\.zip\"[\\s\\S]*?\"digest\"\\s*:\\s*\"sha256:([a-f0-9]{64})\""
                }
            },
            "arm64": {
                "url": "https://github.com/JamesBedford/MatrixCode/releases/download/v$version/MatrixCode-$version-windows-arm64-portable.zip",
                "hash": {
                    "url": "https://api.github.com/repos/JamesBedford/MatrixCode/releases/tags/v$version",
                    "regex": "\"name\"\\s*:\\s*\"MatrixCode-[\\d.]+-windows-arm64-portable\\.zip\"[\\s\\S]*?\"digest\"\\s*:\\s*\"sha256:([a-f0-9]{64})\""
                }
            }
        }
    },
    "notes": [
        "Uses the official architecture-specific portable ZIP instead of the MSI. Scoop does not install files into Program Files or System32 and does not register the screen saver.",
        "The portable package includes Matrix Code.scr. The Start Menu screen-saver shortcut launches it with /s; Windows Screen Saver Settings registration is not performed by this manifest.",
        "Windows 10 version 2004 (build 19041) or newer is required."
    ]
}
