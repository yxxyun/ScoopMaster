{
    "version": "8u501",
    "description": "Oracle JDK 8 with simple cacerts handling",
    "homepage": "https://www.oracle.com/java/",
    "license": "https://www.oracle.com/downloads/licenses/no-fee-license.html",

    "architecture": {
        "64bit": {
            "url": "https://scoop-packages.itsmtaxud.priv/packages/oraclejdk/jdk-8u501-windows-x64.zip",
            "hash": "474eb9ce838b87d373a999da49e39e4dc736e964844154cbc3a33aa38b7ddb95"
        }
    },

    "extract_dir": "jdk1.8.0_501",

    "env_add_path": "bin",

    "env_set": {
        "JAVA_HOME": "$dir"
    },

    "post_install": [
        "$map = Get-Content 'C:\\ProgramData\\scoop\\java-cacerts-map.json' | ConvertFrom-Json",
        "$previous = $map.oraclejdk8u501",
        "$source = \"C:\\ProgramData\\scoop\\apps\\$previous\\current\\jre\\lib\\security\\cacerts\"",
        "$destination = Join-Path $dir 'jre\\lib\\security\\cacerts'",
        "if (Test-Path $source) { Copy-Item $source $destination -Force }",
        "Write-Host 'Oracle JDK8 cacerts synced'"
    ]
}
