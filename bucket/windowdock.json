{
    "version": "0.2.2",
    "description": "Group existing terminals, AI agent sessions, and desktop apps into one tabbed workspace.",
    "homepage": "https://github.com/poikilometis/WindowDock",
    "license": "MIT",
    "notes": [
        "WindowDock.exe is not code-signed yet, so Microsoft Defender SmartScreen may ask for confirmation on first launch.",
        "Settings and saved groups live in the persisted 'data' folder and survive updates.",
        "Update with 'scoop update windowdock'."
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/poikilometis/WindowDock/releases/download/v0.2.2/WindowDock-0.2.2-win-x64.zip",
            "hash": "73d1e7f1401ac2e06666e134fcee567e45efb97d88a6e81ba55d63bc72b5be73"
        }
    },
    "bin": "WindowDock.exe",
    "shortcuts": [
        [
            "WindowDock.exe",
            "WindowDock"
        ]
    ],
    "persist": "data",
    "checkver": {
        "github": "https://github.com/poikilometis/WindowDock"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/poikilometis/WindowDock/releases/download/v$version/WindowDock-$version-win-x64.zip"
            }
        },
        "hash": {
            "url": "$url.sha256"
        }
    }
}
