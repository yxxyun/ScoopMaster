    },
    "version": "0.1.302-1",
    "url": "https://fedorapeople.org/groups/virt/virtio-win/direct-downloads/archive-virtio/virtio-win-0.1.302-1/virtio-win-guest-tools.exe",
    "hash": "d8ae9ea1e943384ac195e012cd36f82c3161620e5fc9529be4e42e6f420e222d",
    "checkver": {
        "url": "https://fedorapeople.org/groups/virt/virtio-win/direct-downloads/archive-virtio/?C=M;O=D",
        "regex": "virtio-win-((\\d+\\.)+\\d+.*?)\\/"
    },
    "autoupdate": {
        "url": "https://fedorapeople.org/groups/virt/virtio-win/direct-downloads/archive-virtio/virtio-win-$version/virtio-win-guest-tools.exe"
    },
    "pre_install": "if (!(is_admin)) { throw 'Admin privileges are required.' }",
    "installer": {
        "script": "Invoke-ExternalCommand \"$dir\\$fname\" -ArgumentList '/install', '/quiet', '/norestart' -RunAs | Out-Null"
    }
}
