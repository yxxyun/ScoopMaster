{
    "version": "4.2",
    "description": "Portable edition of Vovsoft Collect URL.",
    "homepage": "https://vovsoft.com/software/collect-url/",
    "license": "Proprietary",
    "url": "https://vovsoft.com/files/collect-url-portable.zip?v=4.2",
    "checkver": {
        "url": "https://vovsoft.com/download/collect-url-portable/",
        "regex": "(?is)Version\\s*(?:<[^>]*>\\s*)*:?\\s*(?:<[^>]*>\\s*)*(?<version>\\d+(?:\\.\\d+)+)"
    },
    "autoupdate": {
        "url": "https://vovsoft.com/files/collect-url-portable.zip?v=$version"
    },
    "shortcuts": [
        [
            "collecturl.exe",
            "Vovsoft Collect URL"
        ]
    ],
    "notes": [
        "SHA-256 has not been verified; archive contents and the shortcut target have been checked."
    ],
    "pre_install": [
        "if (-not (Test-Path -LiteralPath \"$dir\\key.txt\" -PathType Leaf)) { New-Item -ItemType File -Path \"$dir\\key.txt\" | Out-Null }"
    ],
    "persist": "key.txt"
}
