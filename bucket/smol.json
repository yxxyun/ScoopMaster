            "64bit": {
                "url": "https://github.com/Metwalley/Smol/releases/download/v$version/Smol_$version_x64-setup.exe",
                "hash": {
                    "url": "https://api.github.com/repos/Metwalley/Smol/releases/tags/v$version",
                    "jsonpath": "$.assets[?(@.name == '$basename')].digest"
                }
            }
        }
    }
}
