{
    "version": "1.0.0",
    "description": "Fast native Windows desktop app for compressing videos, audio, images, and PDFs.",
    "homepage": "https://github.com/Metwalley/Smol",
    "license": "AGPL-3.0",
    "architecture": {
        "64bit": {
            "url": "https://github.com/Metwalley/Smol/releases/download/v1.0.0/Smol_1.0.0_x64-setup.exe",
            "hash": "8acdea560d420949620a48eb10b8a1c570ce9d1552b88b576a8d010735c86c56"
        }
    },
    "installer": {
        "args": [
            "/S",
            "/D=$dir"
        ]
    },
    "bin": "smol.exe",
    "shortcuts": [
        [
            "smol.exe",
            "Smol"
        ]
    ],
    "checkver": {
        "github": "https://github.com/Metwalley/Smol"
    },
    "autoupdate": {
