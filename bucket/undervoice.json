    "homepage": "https://github.com/Londopy/undervoice",
    "license": "MIT",
    "url": "https://github.com/Londopy/undervoice/releases/download/v0.5.0/undervoice-v0.5.0-portable.zip",
    "hash": "77db0770c3adebe78c64b079f1261a4c8750696972075971938ee408542a77c4",
    "extract_dir": "undervoice",
    "architecture": {
        "64bit": {
            "bin": "x64\\undervoice.exe",
            "shortcuts": [
                [
                    "x64\\undervoice.exe",
                    "undervoice"
                ]
            ]
        }
    },
    "persist": [
        "x64\\config.toml"
    ],
