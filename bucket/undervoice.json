{
    "version": "0.2.0",
    "description": "Sends your callsign, grid square and a short status hidden under ordinary FM voice, for amateur radio. A window for sound card and PTT setup, transmitting and a log of what was heard.",
    "homepage": "https://github.com/Londopy/undervoice",
    "license": "MIT",
    "url": "https://github.com/Londopy/undervoice/releases/download/v0.2.0/undervoice-v0.2.0-portable.zip",
    "hash": "37d63ca87532ab2ef1d440ef4c8efea6f99e94255d7d1c2b73939934d40e67d6",
    "extract_dir": "undervoice",
    "architecture": {
        "64bit": {
            "bin": "x64\\undervoice.exe",
            "shortcuts": [
                [
                    "x64\\undervoice.exe",
                    "undervoice"
                ]
            ]
        }
    },
    "persist": [
        "x64\\config.toml"
    ],
    "pre_install": "$marker = Join-Path $dir 'x64\\portable'; if (!(Test-Path $marker)) { New-Item -ItemType File -Path $marker | Out-Null }",
    "checkver": {
        "github": "https://github.com/Londopy/undervoice"
    },
    "autoupdate": {
        "url": "https://github.com/Londopy/undervoice/releases/download/v$version/undervoice-v$version-portable.zip",
        "hash": {
            "url": "https://github.com/Londopy/undervoice/releases/download/v$version/SHA256SUMS.txt",
            "regex": "$sha256\\s+$basename"
        }
    }
}
