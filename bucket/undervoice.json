    "checkver": {
        "github": "https://github.com/Londopy/undervoice"
    },
    "autoupdate": {
        "url": "https://github.com/Londopy/undervoice/releases/download/v$version/undervoice-v$version-portable.zip",
        "hash": {
            "url": "https://github.com/Londopy/undervoice/releases/download/v$version/SHA256SUMS.txt",
            "regex": "$sha256\\s+$basename"
        }
    }
}
