    "architecture": {
        "64bit": {
            "url": "https://github.com/Huseynteymurzade28/pomtex/releases/download/v0.4.0/pomtex-0.4.0-windows-x86_64.zip",
            "hash": "f5fdc2c0374628ea9c0b33cb013f0fb105ab5d910f5d4dec6b0d93f3f8bfa5b4",
            "extract_dir": "pomtex-0.4.0-windows-x86_64"
        }
    },
    "bin": "pomtex.exe",
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/Huseynteymurzade28/pomtex/releases/download/v$version/pomtex-$version-windows-x86_64.zip",
