                    "MWNoZoom_x64.exe",
                    "Sordum - No Mouse Wheel Zoom"
                ]
            ]
        },
        "32bit": {
            "bin": [
                [
                    "MWNoZoom.exe",
                    "SordumNoMouseWheelZoom"
                ]
            ],
            "shortcuts": [
                [
                    "MWNoZoom.exe",
                    "Sordum - No Mouse Wheel Zoom"
                ]
            ]
        }
    },
    "persist": "MWNoZoom.ini",
    "checkver": {
