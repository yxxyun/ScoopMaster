{
    "version": "1.2.0",
    "description": "Every game you own in one fast native launcher: Steam, Epic Games, GOG, Amazon Games, Xbox, emulators and more.",
    "homepage": "https://heronite.app",
    "license": "GPL-3.0-only",
    "notes": [
        "Close Heronite (also from the tray) before 'scoop update heronite'.",
        "Your library and settings are in %APPDATA%\\heronite and %LOCALAPPDATA%\\heronite; uninstalling keeps them."
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/RafaelGoulartB/Heronite/releases/download/v1.2.0/Heronite-Portable-x86_64.zip",
            "hash": "9d091e34f9db6af88e3fafa1bd0883985ee43c3e22098c1364344cc2dbf00687"
        }
    },
    "extract_dir": "Heronite",
    "post_install": [
        "Remove-Item -LiteralPath \"$dir\\portable.txt\" -Force -ErrorAction SilentlyContinue",
        "Set-Content -LiteralPath \"$dir\\package-format\" -Value 'scoop' -Encoding ascii"
    ],
    "uninstaller": {
        "script": [
            "if ($cmd -eq 'uninstall') {",
            "    Remove-ItemProperty -Path 'HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Run' -Name 'Heronite' -ErrorAction SilentlyContinue",
            "    Remove-Item -Path 'HKCU:\\Software\\Classes\\heronite' -Recurse -Force -ErrorAction SilentlyContinue",
            "}"
        ]
    },
    "bin": "heronite.exe",
    "shortcuts": [
        [
            "heronite.exe",
            "Heronite"
        ]
    ],
    "checkver": {
        "github": "https://github.com/RafaelGoulartB/Heronite"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/RafaelGoulartB/Heronite/releases/download/v$version/Heronite-Portable-x86_64.zip"
            }
        },
        "hash": {
            "url": "$baseurl/SHA256SUMS",
            "regex": "([a-fA-F0-9]{64})\\s+\\*?$basename"
        }
    }
}
