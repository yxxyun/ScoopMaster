{
    "version": "0.1.5",
    "description": "Browser automation CLI for coding agents.",
    "homepage": "https://github.com/anomalyco/browse",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://registry.npmjs.org/@opencode/browse-windows-x64-baseline/-/browse-windows-x64-baseline-0.1.5.tgz",
            "hash": "dd07e1062804a0a2e3a4be9fed81839de3ec304fce059f587fc10e8ae06d79bc"
        }
    },
    "extract_dir": "package/bin",
    "bin": "browse.exe",
    "checkver": {
        "url": "https://anoma.ly/release/browse/cli/stable.json",
        "jsonpath": "$.release.version",
        "regex": "([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://registry.npmjs.org/@opencode/browse-windows-x64-baseline/-/browse-windows-x64-baseline-$version.tgz"
            }
        }
    },
    "post_install": [
        "& \"$dir\\browse.exe\" update --mode off",
        "if ($LASTEXITCODE -ne 0) { throw 'Could not disable Browse automatic updates.' }"
    ],
    "notes": "Automatic updates are disabled; use scoop update browse. Browser pairing is managed separately."
}
