{
    "version": "0.28.6",
    "description": "Open-source AI coding agent that lives in your terminal, powered by Qwen models.",
    "homepage": "https://qwenlm.github.io/qwen-code-docs/",
    "license": "Apache-2.0",
    "notes": "Run 'qwen' to start. This build bundles its own Node.js runtime, so no 'nodejs' dependency is needed.",
    "url": "https://github.com/QwenLM/qwen-code/releases/download/v0.28.6/qwen-code-win-x64.zip",
    "hash": "dad1ab3ebadc33c0c8e4dec364adbf18fa7728c20bedf5c1b2af99f9d26eaf1e",
    "extract_dir": "qwen-code",
    "bin": [
        [
            "bin\\qwen.cmd",
            "qwen"
        ]
    ],
    "checkver": {
        "script": [
            "$ErrorActionPreference = 'Stop'",
            "$releases = Invoke-RestMethod 'https://api.github.com/repos/QwenLM/qwen-code/releases?per_page=30'",
            "($releases | Where-Object { !$_.prerelease -and $_.tag_name -match '^v[0-9.]+$' } | Select-Object -First 1).tag_name"
        ],
        "regex": "^v([\\d.]+)$"
    },
    "autoupdate": {
        "url": "https://github.com/QwenLM/qwen-code/releases/download/v$version/qwen-code-win-x64.zip"
    }
}
