{
    "version": "1.0.96",
    "description": "StealthSurf VPN client (portable, proxy and TUN modes)",
    "homepage": "https://stealthsurf.net/",
    "license": {
        "identifier": "Proprietary",
        "url": "https://stealthsurf.net/"
    },
    "notes": [
        "Requires the Microsoft Edge WebView2 Runtime.",
        "Account data is kept in $persist_dir\\data between updates; 'scoop uninstall -p' removes it.",
        "Only one StealthSurf VPN client (installed or portable) can run at a time.",
        "TUN mode installs a system service after a UAC prompt; uninstalling the app does not remove it."
    ],
    "architecture": {
        "64bit": {
            "url": "https://cdn.stealthsurf.io/app/desktop/1.0.96/StealthSurf-1.0.96-windows-x64-portable-tun.zip",
            "hash": "2736f0ff89ffe594f31a58fd4b054a4d61d802e2ff122b575fab7a041615535c"
        },
        "arm64": {
            "url": "https://cdn.stealthsurf.io/app/desktop/1.0.96/StealthSurf-1.0.96-windows-arm64-portable-tun.zip",
            "hash": "f5f191d2082be2f11d13f6aaca11beed137093f82b67e1669e2118806000b8af"
        }
    },
    "post_install": [
        "$kept = Join-Path $persist_dir 'data'",
        "$live = Join-Path $original_dir 'data'",
        "if ((Test-Path -LiteralPath $kept) -and -not (Test-Path -LiteralPath $live)) {",
        "    Move-Item -LiteralPath $kept -Destination $live",
        "}",
        "$link = (New-Object -ComObject WScript.Shell).CreateShortcut((Join-Path (shortcut_folder $global) 'StealthSurf VPN.lnk'))",
        "$link.TargetPath = Join-Path $original_dir 'StealthSurf.exe'",
        "$link.WorkingDirectory = $original_dir",
        "$link.Save()"
    ],
    "pre_uninstall": [
        "$live = Join-Path $dir 'data'",
        "if (Test-Path -LiteralPath $live) {",
        "    $root = (Resolve-Path -LiteralPath $dir).Path",
        "    if (Get-Process | Where-Object { $_.Path -like \"$root\\*\" }) {",
        "        throw 'StealthSurf VPN is still running. Quit it and try again.'",
        "    }",
        "    New-Item -ItemType Directory -Force -Path $persist_dir | Out-Null",
        "    $kept = Join-Path $persist_dir 'data'",
        "    if (Test-Path -LiteralPath $kept) {",
        "        Rename-Item -LiteralPath $kept -NewName ('data-' + (Get-Date -Format 'yyyyMMddHHmmss'))",
        "    }",
        "    Move-Item -LiteralPath $live -Destination $kept",
        "}",
        "Remove-Item -LiteralPath (Join-Path (shortcut_folder $global) 'StealthSurf VPN.lnk') -ErrorAction SilentlyContinue"
    ],
    "checkver": {
        "url": "https://cdn.stealthsurf.io/app/desktop/latest.json",
        "jsonpath": "$.version"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://cdn.stealthsurf.io/app/desktop/$version/StealthSurf-$version-windows-x64-portable-tun.zip"
            },
            "arm64": {
                "url": "https://cdn.stealthsurf.io/app/desktop/$version/StealthSurf-$version-windows-arm64-portable-tun.zip"
            }
        }
    }
}
