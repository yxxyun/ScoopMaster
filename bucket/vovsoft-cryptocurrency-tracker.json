{
    "version": "2.4",
    "description": "Portable edition of Vovsoft Cryptocurrency Tracker.",
    "homepage": "https://vovsoft.com/software/cryptocurrency-tracker/",
    "license": "Proprietary",
    "url": "https://vovsoft.com/files/cryptocurrency-tracker-portable.zip?v=2.4",
    "checkver": {
        "url": "https://vovsoft.com/download/cryptocurrency-tracker-portable/",
        "regex": "(?is)Version\\s*(?:<[^>]*>\\s*)*:?\\s*(?:<[^>]*>\\s*)*(?<version>\\d+(?:\\.\\d+)+)"
    },
    "autoupdate": {
        "url": "https://vovsoft.com/files/cryptocurrency-tracker-portable.zip?v=$version"
    },
    "shortcuts": [
        [
            "cryptotracker.exe",
            "Vovsoft Cryptocurrency Tracker"
        ]
    ],
    "notes": [
        "SHA-256 has not been verified; archive contents and the shortcut target have been checked."
    ],
    "pre_install": [
        "if (-not (Test-Path -LiteralPath \"$dir\\key.txt\" -PathType Leaf)) { New-Item -ItemType File -Path \"$dir\\key.txt\" | Out-Null }"
    ],
    "persist": "key.txt"
}
