{
    "version": "2605.7.2",
    "description": "安装全新的 NixOS-WSL",
    "homepage": "https://github.com/nix-community/NixOS-WSL",
    "license": "Freeware",
    "depends": "ChuckieChen945_Tangyuan/wsl-customized",
    "architecture": {
        "64bit": {
            "url": "https://github.com/nix-community/NixOS-WSL/releases/download/2605.7.2/nixos.wsl",
            "hash": "e7180ad555fdcb8e1e057e2ef056de467603a5e502ff8531053738371be3f6b9"
        }
    },
    "pre_install": "ensure \"$persist_dir\\data\"",
    "installer": {
        "script": [
            "info \"Installing WSL distribution...\"",
            "wsl --install --from-file \"$dir\\nixos.wsl\" --name \"NixOS\" --location \"$persist_dir\\data\" --no-launch"
        ]
    },
    "post_install": [
        "# TODO: 跟踪一下set-sparse这个功能有没有被设成默认值了",
        "# TODO: 下面这个命令会报错：无法完成该操作，因为 VHD 当前正在使用中。强制 WSL 停止使用: wsl.exe --shutdown",
        "# wsl.exe --manage Arch --set-sparse true --allow-unsafe",
        "Get-ChildItem -Path $dir -Recurse | Remove-Item -Force -ErrorAction SilentlyContinue -Recurse"
    ],
    "uninstaller": {
        "script": "wsl --unregister NixOS"
    },
    "persist": "data",
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/nix-community/NixOS-WSL/releases/download/$version/nixos.wsl"
            }
        }
    }
}
