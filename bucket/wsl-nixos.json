{
    "version": "2605.7.2",
    "description": "安装全新的NixOS-WSL",
    "homepage": "https://github.com/nix-community/NixOS-WSL",
    "license": "Freeware",
    "depends": "ChuckieChen945_Tangyuan/wsl-customized",
    "architecture": {
        "64bit": {
            "url": "https://github.com/nix-community/NixOS-WSL/releases/download/2605.7.2/nixos.wsl",
            "hash": "e7180ad555fdcb8e1e057e2ef056de467603a5e502ff8531053738371be3f6b9"
        }
    },
    "pre_install": "ensure \"$persist_dir\\data\"",
    "installer": {
        "script": [
            "info \"Installing WSL distribution...\"",
            "wsl --install --from-file \"$dir\\nixos.wsl\" --name \"NixOS\" --location \"$persist_dir\\data\""
        ]
    },
    "post_install": "Get-ChildItem -Path $dir -Recurse | Remove-Item -Force -ErrorAction SilentlyContinue -Recurse",
    "pre_uninstall": [
        
    ],
    "uninstaller": {
        "script": "wsl --unregister NixOS"
    },
    "persist": "data",
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/nix-community/NixOS-WSL/releases/download/$version/nixos.wsl"
            }
        }
    }
}
