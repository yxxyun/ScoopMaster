{
    "version": "2005.10.29",
    "description": "GRC ClicKey: Adds configurable keyboard typing sounds and supports command-line sound and volume options.",
    "homepage": "https://www.grc.com/freeware/clickey.htm",
    "license": "Freeware",
    "url": "https://www.grc.com/files/clickey.exe",
    "bin": "clickey.exe",
    "shortcuts": [
        [
            "clickey.exe",
            "GRC ClicKey"
        ]
    ],
    "notes": [
        "GRC does not publish a static SHA-256 checksum for this download. The manifest omits hash rather than inventing a value.",
        "Legacy utility; its published version is old. Verify that it is applicable to your operating system before using it."
    ],
    "checkver": {
        "script": [
            "$html = (Invoke-WebRequest -Uri 'https://www.grc.com/freeware/clickey.htm' -UseBasicParsing).Content",
            "$text = [System.Net.WebUtility]::HtmlDecode([regex]::Replace($html, '<[^>]+>', ' '))",
            "$text = [regex]::Replace($text, '\\s+', ' ')",
            "$match = [regex]::Match($text, '(?is)File stats for:\\s*ClicKey.{0,1800}?Last\\s+Updated:\\s*Size:\\s*[\\d.,]+\\s*[kKmM]?\\s+(?<date>[A-Za-z]{3}\\s+\\d{1,2},\\s+\\d{4})\\s+at\\b')",
            "if (-not $match.Success) { throw 'Unable to read the published Last Updated date for ClicKey.' }",
            "[DateTime]::ParseExact($match.Groups['date'].Value, 'MMM d, yyyy', [Globalization.CultureInfo]::InvariantCulture).ToString('yyyy.MM.dd')"
        ],
        "regex": "(?<version>\\d{4}\\.\\d{2}\\.\\d{2})"
    },
    "autoupdate": {
        "url": "https://www.grc.com/files/clickey.exe"
    }
}
