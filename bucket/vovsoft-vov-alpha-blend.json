{
    "version": "2.3",
    "description": "Portable edition of Vovsoft Vov Alpha Blend.",
    "homepage": "https://vovsoft.com/software/vov-alpha-blend/",
    "license": "Proprietary",
    "url": "https://vovsoft.com/files/vov-alpha-blend-portable.zip?v=2.3",
    "checkver": {
        "url": "https://vovsoft.com/download/vov-alpha-blend-portable/",
        "regex": "(?is)Version\\s*(?:<[^>]*>\\s*)*:?\\s*(?:<[^>]*>\\s*)*(?<version>\\d+(?:\\.\\d+)+)"
    },
    "autoupdate": {
        "url": "https://vovsoft.com/files/vov-alpha-blend-portable.zip?v=$version"
    },
    "shortcuts": [
        [
            "alphablend.exe",
            "Vovsoft Vov Alpha Blend"
        ]
    ],
    "notes": [
        "SHA-256 has not been verified; archive contents and the shortcut target have been checked."
    ],
    "pre_install": [
        "if (-not (Test-Path -LiteralPath \"$dir\\key.txt\" -PathType Leaf)) { New-Item -ItemType File -Path \"$dir\\key.txt\" | Out-Null }"
    ],
    "persist": "key.txt"
}
