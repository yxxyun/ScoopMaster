{
    "version": "11.1.0",
    "description": "Custom Minecraft launcher based on PrismLauncher, with Ely.by authentication support",
    "homepage": "https://github.com/ElyPrismLauncher/Launcher",
    "license": "GPL-3.0-only",
    "notes": "PineconeMC",
    "architecture": {
        "64bit": {
            "url": "https://github.com/ElyPrismLauncher/Launcher/releases/download/11.1.0/PineconeMC-Windows-MSVC-Portable-11.1.0.zip",
            "hash": "b13c5de4c638b71309071c917bcac445ebe49b4bb17e7012430347df53e1f80a"
        },
        "arm64": {
            "url": "https://github.com/ElyPrismLauncher/Launcher/releases/download/11.1.0/PineconeMC-Windows-MSVC-arm64-Portable-11.1.0.zip",
            "hash": "9c3db121caae1a1a323ab6c1f405c8d8c9fb24034d26e904299025464dae46f1"
        }
    },
    "pre_install": [
        "$migration = $true",
        "$visibleUserAccounts = Get-LocalUser | Where-Object { $_.Enabled -eq $true }",
        "if ($global -and $visibleUserAccounts.Count -gt 1) { $migration = $false }",
        "",
        "$appdataPath = \"$HOME\\AppData\\Roaming\\ElyPrismLauncher\"",
        "if ((Test-Path -Path $appdataPath\\*) -and (!(Test-Path -Path $persist_dir\\*)) -and $migration) {",
        "    Write-Warning \"Migrating data from $appdataPath to $persist_dir (this may take a while)\"",
        "    New-Item -Type Directory -Path $persist_dir | Out-Null",
        "    Copy-Item -Recurse -Force $appdataPath\\* $persist_dir\\",
        "} elseif (!($migration)) {",
        "    Write-Warning \"A global Scoop installation was detected with multiple user accounts. Please see the notes at the end of the install process.\"",
        "}",
        "# Hardlinks cannot work properly here, as this app would create a new file instead of writing directly.",
        "# Please keep the file list the same in both pre_install and pre_uninstall scripts.",
        "$contents = @{",
        "    'metacache' = '{}'",
        "}",
        "'accounts.json', 'metacache', 'elyprismlauncher.cfg' | ForEach-Object {",
        "    if (Test-Path \"$persist_dir\\$_\") {",
        "        Copy-Item \"$persist_dir\\$_\" \"$dir\\$_\" -Force",
        "    } else {",
        "        Set-Content -Path \"$dir\\$_\" -Value $contents[$_]",
        "    }",
        "}",
        "# Fix LibrariesDir to avoid Scoop junction path conflicts with Java module system",
        "$libDir = ($persist_dir -replace '\\\\', '/') + '/libraries'",
        "$cfgContent = Get-Content \"$dir\\elyprismlauncher.cfg\" -Raw -ErrorAction SilentlyContinue",
        "if (!$cfgContent) { $cfgContent = '[General]' }",
        "if ($cfgContent -match 'LibrariesDir=') { $cfgContent = $cfgContent -replace 'LibrariesDir=.+', \"LibrariesDir=$libDir\" }",
        "elseif ($cfgContent -match '\\[General\\]') { $cfgContent = $cfgContent.Replace('[General]', \"[General]`nLibrariesDir=$libDir\") }",
        "else { $cfgContent = \"[General]`nLibrariesDir=$libDir`n\" + $cfgContent }",
        "Set-Content \"$dir\\elyprismlauncher.cfg\" $cfgContent -NoNewline",
        "Remove-Item -Path \"$dir\\elyprismlauncher_updater.exe\" -Force -ErrorAction Ignore"
    ],
    "bin": "elyprismlauncher.exe",
    "shortcuts": [
        [
            "elyprismlauncher.exe",
            "PineconeMC"
        ]
    ],
    "persist": [
        "assets",
        "cache",
        "catpacks",
        "icons",
        "iconthemes",
        "instances",
        "java",
        "libraries",
        "logs",
        "mods",
        "skins",
        "themes",
        "translations"
    ],
    "pre_uninstall": [
        "# Hardlinks cannot work properly here, as this app would create a new file instead of writing directly.",
        "# Please keep the file list the same in both pre_install and pre_uninstall scripts.",
        "'accounts.json', 'metacache', 'elyprismlauncher.cfg' | ForEach-Object {",
        "    if (Test-Path -Path \"$dir\\$_\") {",
        "        Copy-Item -Path \"$dir\\$_\" -Destination \"$persist_dir\\$_\" -Force",
        "    }",
        "}",
        "if ($cmd -eq 'uninstall') { reg import \"$dir\\uninstall-associations.reg\" }"
    ],
    "checkver": {
        "github": "https://github.com/ElyPrismLauncher/Launcher"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/ElyPrismLauncher/Launcher/releases/download/$version/PineconeMC-Windows-MSVC-Portable-$version.zip"
            },
            "arm64": {
                "url": "https://github.com/ElyPrismLauncher/Launcher/releases/download/$version/PineconeMC-Windows-MSVC-arm64-Portable-$version.zip"
            }
        }
    }
}
