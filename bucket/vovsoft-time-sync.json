{
    "version": "3.2",
    "description": "A lightweight utility for synchronizing the Windows clock with NTP servers.",
    "homepage": "https://vovsoft.com/software/time-sync/",
    "license": "Freeware",
    "url": "https://vovsoft.com/files/time-sync-portable.zip?v=3.2",
    "checkver": {
        "url": "https://vovsoft.com/download/time-sync-portable/",
        "regex": "(?is)Version\\s*(?:<[^>]*>\\s*)*:?\\s*(?:<[^>]*>\\s*)*(?<version>\\d+(?:\\.\\d+)+)"
    },
    "autoupdate": {
        "url": "https://vovsoft.com/files/time-sync-portable.zip?v=$version"
    },
    "bin": "timesync.exe",
    "shortcuts": [
        [
            "timesync.exe",
            "Vovsoft Time Sync"
        ]
    ],
    "pre_install": [
        "if (-not (Test-Path -LiteralPath \"$dir\\key.txt\" -PathType Leaf)) { New-Item -ItemType File -Path \"$dir\\key.txt\" | Out-Null }"
    ],
    "persist": "key.txt"
}
