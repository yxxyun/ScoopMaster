{
    "version": "3.0.2",
    "description": "WinUI 3 service manager with a native NSSM host, independent of the legacy nssm CLI.",
    "homepage": "https://github.com/pedoc/nssm/tree/main/next",
    "license": "Public Domain",
    "notes": [
        "Requires x64 Windows 10 build 19041 or later, or Windows 11.",
        "Manages only NssmNext-owned services; existing legacy nssm services are not imported or changed.",
        "Service changes request administrator access. Uninstalling this package does not stop or remove services or the protected native host cache."
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/pedoc/nssm/releases/download/next-v3.0.2/NssmNext-3.0.2-win-x64.zip",
            "hash": "32fb1c1a427927e2734652eb276561eca640be823f41222c842c49534193fa59"
        }
    },
    "extract_dir": "NssmNext",
    "pre_install": "if ([Environment]::OSVersion.Version.Build -lt 19041) { throw 'NSSM Next requires Windows 10 build 19041 or later.' }",
    "bin": [
        [
            "NssmNext.exe",
            "nssmnext"
        ]
    ],
    "shortcuts": [
        [
            "NssmNext.exe",
            "NSSM Next"
        ]
    ],
    "checkver": {
        "url": "https://github.com/pedoc/nssm/releases.atom",
        "regex": "<id>tag:github\\.com,2008:Repository/[0-9]+/next-v([0-9]+\\.[0-9]+\\.[0-9]+)</id>"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/pedoc/nssm/releases/download/next-v$version/NssmNext-$version-win-x64.zip",
                "hash": {
                    "url": "https://github.com/pedoc/nssm/releases/download/next-v$version/SHA256SUMS.txt",
                    "regex": "(?m)^([a-fA-F0-9]{64})[\\x20\\t]+$basename\\r?$"
                }
            }
        }
    }
}
