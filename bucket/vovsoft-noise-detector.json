{
    "version": "1.1",
    "description": "Portable edition of Vovsoft Noise Detector.",
    "homepage": "https://vovsoft.com/software/noise-detector/",
    "license": "Proprietary",
    "url": "https://vovsoft.com/files/noise-detector-portable.zip?v=1.1",
    "checkver": {
        "url": "https://vovsoft.com/download/noise-detector-portable/",
        "regex": "(?is)Version\\s*(?:<[^>]*>\\s*)*:?\\s*(?:<[^>]*>\\s*)*(?<version>\\d+(?:\\.\\d+)+)"
    },
    "autoupdate": {
        "url": "https://vovsoft.com/files/noise-detector-portable.zip?v=$version"
    },
    "shortcuts": [
        [
            "noisedetector.exe",
            "Vovsoft Noise Detector"
        ]
    ],
    "pre_install": [
        "if (-not (Test-Path -LiteralPath \"$dir\\key.txt\" -PathType Leaf)) { New-Item -ItemType File -Path \"$dir\\key.txt\" | Out-Null }"
    ],
    "persist": "key.txt"
}
