{
    "version": "1.8.1",
    "description": "Open-source security engine that detects and responds to malicious behavior.",
    "homepage": "https://github.com/crowdsecurity/crowdsec",
    "license": "MIT",
    "url": "https://github.com/crowdsecurity/crowdsec/releases/download/v1.8.1/crowdsec_1.8.1.msi",
    "hash": "014e15d97ac015d9e75d151150af08c5661901dc14904d44ca7240da1cdb70e6",
    "installer": {
        "file": "crowdsec_1.8.1.msi",
        "args": [
            "/quiet",
            "/norestart"
        ],
        "keep": true
    },
    "uninstaller": {
        "script": [
            "$paths = @('HKLM:\\Software\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\*','HKLM:\\Software\\WOW6432Node\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\*')",
            "$entry = Get-ItemProperty $paths -ErrorAction SilentlyContinue | Where-Object { $_.DisplayName -eq 'CrowdSec' } | Select-Object -First 1",
            "if ($entry -and $entry.UninstallString) { Start-Process -Wait 'cmd.exe' -ArgumentList '/c', $entry.UninstallString, '/quiet', '/norestart' }"
        ]
    },
    "checkver": {
        "github": "https://github.com/crowdsecurity/crowdsec",
        "regex": "v([0-9]+\\.[0-9]+\\.[0-9]+)"
    },
    "autoupdate": {
        "url": "https://github.com/crowdsecurity/crowdsec/releases/download/v$version/crowdsec_$version.msi"
    }
}
