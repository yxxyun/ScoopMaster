{
    "version": "1.2",
    "description": "Portable edition of Vovsoft Image Pixelator.",
    "homepage": "https://vovsoft.com/software/image-pixelator/",
    "license": "Proprietary",
    "url": "https://vovsoft.com/files/image-pixelator-portable.zip?v=1.2",
    "checkver": {
        "url": "https://vovsoft.com/download/image-pixelator-portable/",
        "regex": "(?is)Version\\s*(?:<[^>]*>\\s*)*:?\\s*(?:<[^>]*>\\s*)*(?<version>\\d+(?:\\.\\d+)+)"
    },
    "autoupdate": {
        "url": "https://vovsoft.com/files/image-pixelator-portable.zip?v=$version"
    },
    "shortcuts": [
        [
            "imagepixelator.exe",
            "Vovsoft Image Pixelator"
        ]
    ],
    "pre_install": [
        "if (-not (Test-Path -LiteralPath \"$dir\\key.txt\" -PathType Leaf)) { New-Item -ItemType File -Path \"$dir\\key.txt\" | Out-Null }"
    ],
    "persist": "key.txt"
}
