{
    "version": "0.1.0",
    "description": "Native desktop localization and translation workspace for software projects, with Git hooks and credential-manager integration.",
    "homepage": "https://github.com/CairnPack/Codei18nDesktop",
    "license": "Unknown",
    "architecture": {
        "64bit": {
            "url": "https://github.com/CairnPack/Codei18nDesktop/releases/download/v0.1.0/Codei18n-Setup-0.1.0-amd64.exe",
            "hash": "12a9a2d230b302c9c3e5f249f36129f71e1865aacdbb130349836cd0393383db"
        }
    },
    "installer": {
        "args": [
            "/S",
            "/D=$dir"
        ]
    },
    "uninstaller": {
        "script": ["$uninstaller = Get-ChildItem -LiteralPath $dir -File -Recurse -ErrorAction SilentlyContinue | Where-Object { $_.Name -match '(?i)^(unins\\d*|uninstall.*)\\.exe$' } | Select-Object -First 1","if (-not $uninstaller) { throw 'The application uninstaller was not found in the Scoop version directory.' }","$process = Start-Process -FilePath $uninstaller.FullName -ArgumentList '/S' -WorkingDirectory $uninstaller.DirectoryName -Wait -PassThru","if ($process.ExitCode -ne 0) { throw ('The application uninstaller exited with code {0}.' -f $process.ExitCode) }"]
    },
    "bin": "Codei18n.exe",
    "shortcuts": [
        [
            "Codei18n.exe",
            "Codei18n"
        ]
    ],
    "checkver": {
        "github": "https://github.com/CairnPack/Codei18nDesktop"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/CairnPack/Codei18nDesktop/releases/download/v$version/Codei18n-Setup-$version-amd64.exe",
                "hash": {
                    "mode": "json",
                    "url": "https://api.github.com/repos/CairnPack/Codei18nDesktop/releases/tags/v$version",
                    "jp": "$.assets[?(@.name == 'Codei18n-Setup-$version-amd64.exe')].digest"
                }
            }
        }
    }
}
