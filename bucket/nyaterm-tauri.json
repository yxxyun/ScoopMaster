{
    "version": "1.3.2",
    "description": "A modern remote terminal workspace (Legacy Tauri/WebView2 edition)",
    "homepage": "https://nyaterm.app",
    "license": "MIT",
    "notes": [
        "NyaTerm Tauri edition (1.x branch) is archived.",
        "For the new Rust + GPUI native version, install 'zyqpkg/nyaterm'."
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/nyakang/nyaterm/releases/download/v1.3.2/NyaTerm_1.3.2_windows_x64_portable.zip",
            "hash": "07e037ce96b08b6d31a4f9de0f99bc6d6fbc8413e0a3b73e63e16d1fd58d8364"
        },
        "arm64": {
            "url": "https://github.com/nyakang/nyaterm/releases/download/v1.3.2/NyaTerm_1.3.2_windows_arm64_portable.zip",
            "hash": "8ecf116a966975353c6c61c3046dbdc11e55508feb2f1d8f974799b1a0217034"
        }
    },
    "pre_install": [
        "$src = Join-Path $dir 'NyaTerm-portable'",
        "if (Test-Path -LiteralPath $src) {",
        "    Get-ChildItem -LiteralPath $src -Force | ForEach-Object {",
        "        # Zip contains an empty stub named nyaterm-portable; moving it onto $dir collides with the source folder on Windows (case-insensitive).",
        "        if ($_.Name -ieq 'nyaterm-portable') {",
        "            Remove-Item -LiteralPath $_.FullName -Force -ErrorAction SilentlyContinue",
        "        } else {",
        "            Move-Item -LiteralPath $_.FullName -Destination $dir -Force",
        "        }",
        "    }",
        "    Remove-Item -LiteralPath $src -Force -Recurse -ErrorAction SilentlyContinue",
        "    New-Item -Path (Join-Path $dir 'nyaterm-portable') -ItemType File -Force | Out-Null",
        "}"
    ],
    "bin": [
        [
            "NyaTerm.exe",
            "nyaterm-tauri"
        ]
    ],
    "shortcuts": [
        [
            "NyaTerm.exe",
            "NyaTerm (Tauri)"
        ]
    ],
    "persist": "data",
    "checkver": {
        "url": "https://github.com/nyakang/nyaterm/releases",
        "regex": "/releases/tag/v(1\\.[\\d.]+)\""
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/nyakang/nyaterm/releases/download/v$version/NyaTerm_$version_windows_x64_portable.zip"
            },
            "arm64": {
                "url": "https://github.com/nyakang/nyaterm/releases/download/v$version/NyaTerm_$version_windows_arm64_portable.zip"
            }
        }
    }
}
