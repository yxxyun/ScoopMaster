{
    "version": "5.4.1.5408",
    "description": "爱奇艺万能联播（GeePlayer），爱奇艺出品的万能影音播放器，支持几乎所有主流音视频格式的本地播放，并提供 DLNA 投屏与手机互传。",
    "homepage": "https://github.com/123GitHub0123/GeePlayer",
    "license": "Freeware",
    "url": "https://raw.githubusercontent.com/123GitHub0123/GeePlayer/main/GeePlayerSetup_app.exe",
    "hash": "134f7015873bb1ddad17c8cfb4bcf017b84c380ce22ed5238eef1286196c3d23",
    "installer": {
        "script": [
            "$helper = @(",
            "    \"Start-Process -FilePath '$dir\\$fname' -ArgumentList '/S', '/D=$dir' -Wait\"",
            "    \"Get-ChildItem '$dir\\GeePlayer\\$version' -Force | Move-Item -Destination '$dir' -Force\"",
            "    \"Remove-Item '$dir\\GeePlayer', '$dir\\GeePlayerUninst.exe' -Recurse -Force -ErrorAction SilentlyContinue\"",
            "    \"Remove-Item '$dir\\$fname' -Force -ErrorAction SilentlyContinue\"",
            "    \"Remove-Item 'HKLM:\\Software\\WOW6432Node\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\GeePlayer' -Recurse -Force -ErrorAction SilentlyContinue\"",
            ")",
            "Set-Content \"$dir\\_install.ps1\" $helper -Encoding UTF8",
            "Start-Process powershell.exe -ArgumentList '-NoProfile', '-ExecutionPolicy', 'Bypass', '-File', \"`\"$dir\\_install.ps1`\"\" -Verb RunAs -Wait",
            "Remove-Item \"$dir\\_install.ps1\" -Force -ErrorAction SilentlyContinue"
        ]
    },
    "post_install": [
        "Remove-Item \"$env:APPDATA\\Microsoft\\Windows\\Start Menu\\Programs\\爱奇艺万能联播.lnk\" -Force -ErrorAction SilentlyContinue",
        "Remove-Item \"$env:APPDATA\\Microsoft\\Windows\\Start Menu\\Programs\\爱奇艺\\爱奇艺万能联播\" -Recurse -Force -ErrorAction SilentlyContinue",
        "$iqiyiDir = \"$env:APPDATA\\Microsoft\\Windows\\Start Menu\\Programs\\爱奇艺\"",
        "if ((Test-Path $iqiyiDir) -and -not (Get-ChildItem $iqiyiDir -Force -ErrorAction SilentlyContinue)) { Remove-Item $iqiyiDir -Force }"
    ],
    "shortcuts": [
        [
            "GeePlayer.exe",
            "爱奇艺万能联播"
        ]
    ],
    "notes": "安装需要管理员权限，过程中会弹出一次 UAC。用户数据保存在 %APPDATA%\\IQIYI Video\\GeePlayer，升级与卸载（不带 -p）都不会删除。上游已停止维护，此清单版本固定为 5.4.1.5408，不提供 checkver/autoupdate。"
}
