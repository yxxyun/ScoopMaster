{
    "version": "12.2.0.6",
    "description": "File recovery utility",
    "homepage": "https://www.auslogics.com/en/software/file-recovery/",
    "license": "Proprietary",
    "url": "https://downloads.auslogics.com/en/file-recovery/auslogics-file-recovery-setup.exe",
    "hash": "607D50AEFF7E767CBAA272BEC4F13640F6615F4C78BCB4143096CE02D9B719F8",
    "innosetup": true,
    "bin": "FileRecovery.exe",
    "shortcuts": [
        [
            "FileRecovery.exe",
            "Auslogics File Recovery"
        ]
    ],
    "checkver": {
        "script": [
            "$html = (Invoke-WebRequest -Uri 'https://www.auslogics.com/en/software/file-recovery/' -UseBasicParsing).Content",
            "$text = [System.Net.WebUtility]::HtmlDecode([regex]::Replace($html, '<[^>]+>', ' '))",
            "$text = [regex]::Replace($text, '\\s+', ' ')",
            "$match = [regex]::Match($text, '(?i)Version\\s+(?<version>\\d+(?:\\.\\d+){3})')",
            "if (-not $match.Success) { throw 'Unable to detect Auslogics File Recovery version from the official product page.' }",
            "$match.Groups['version'].Value"
        ],
        "regex": "(?<version>\\d+(?:\\.\\d+){3})"
    },
    "autoupdate": {
        "url": "https://downloads.auslogics.com/en/file-recovery/auslogics-file-recovery-setup.exe"
    },
    "notes": [
        "Scoop extracts the official Inno Setup application payload into the app directory; it does not run the setup program.",
        "This extracts the application's installed files but does not guarantee the vendor's own portable mode or suppress any runtime requirements."
    ]
}
