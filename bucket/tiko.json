{
    "version": "e3ece432",
    "description": "Compiled language with Python-like readability, small fast executables, Go-style concurrency, direct C-header import and a batteries-included standard library; no GC, no runtime to install",
    "homepage": "https://tiko-lang.net",
    "license": {
        "identifier": "GPL-2.0-or-later, LGPL-2.1-or-later",
        "url": "https://github.com/PaulSquires/tiko-lang/blob/master/licences/LICENSE-tiko"
    },
    "suggest": {
        "LLVM (clang is required by the compiler)": "llvm"
    },
    "notes": [
        "The compiler needs clang (LLVM) for the .ll -> .o step and linking: scoop install llvm",
        "If clang is not at the default location, point TIKO_CLANG at clang.exe"
    ],
    "url": "https://github.com/PaulSquires/tiko-lang/releases/download/toolchain-e3ece432/tiko-windows-x86_64-e3ece432.zip",
    "hash": "c94f0e3e52bf7d6e8113247794d194260f2bfe14e3e625f3c3eb819844a3dfa1",
    "extract_dir": "tiko-lang",
    "installer": {
        "script": [
            "$mappings = @(",
            "    @{ Config = \"$env:APPDATA\\tkEdit\"; Target = \"$persist_dir\\tkEdit\" }",
            "    @{ Config = \"$env:LOCALAPPDATA\\tiko\"; Target = \"$persist_dir\\tiko-cache\" }",
            ")",
            "foreach ($map in $mappings) {",
            "    $targetPath = $map.Target",
            "    $configPath = $map.Config",
            "    ensure $targetPath | Out-Null",
            "    $linkType = (Get-Item -Path $configPath -ErrorAction SilentlyContinue).LinkType",
            "    if (Test-Path $configPath) {",
            "        if ($linkType -eq 'Junction') {",
            "            Remove-Item -Path $configPath -Force",
            "        } else {",
            "            Get-ChildItem -Path $configPath -Force | Move-Item -Destination $targetPath -Force",
            "            Remove-Item -Path $configPath -Force -Recurse",
            "        }",
            "    }",
            "    New-Item $configPath -ItemType Junction -Target $targetPath | Out-Null",
            "}"
        ]
    },
    "bin": [
        "tiko.exe",
        "tiko-lsp.exe",
        "tkedit.exe"
    ],
    "shortcuts": [
        [
            "tkedit.exe",
            "tkedit"
        ]
    ],
    "checkver": {
        "url": "https://api.github.com/repos/PaulSquires/tiko-lang/releases/latest",
        "regex": "tiko-windows-x86_64-([\\w]+)\\.zip"
    },
    "autoupdate": {
        "url": "https://github.com/PaulSquires/tiko-lang/releases/download/toolchain-$version/tiko-windows-x86_64-$version.zip"
    }
}
