{
    "version": "20260912-133823-2afb8364",
    "description": "GPU-accelerated terminal emulator",
    "homepage": "https://github.com/wezterm/wezterm",
    "license": "Apache-2.0",
    "notes": [
        "Add Open with Wezterm as a context menu option by running:",
        "reg import \"$dir\\install-context.reg\""
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/Lyaiya/wezterm-weekly/releases/download/20260912-133823-2afb8364/WezTerm-windows-20260912-133823-2afb8364.zip",
            "hash": "283f87933e68c13bd6f27638180f521721a61e42b55249f88c1e5413a88c7ed1"
        }
    },
    "pre_install": [
        "$folder = Get-ChildItem $dir | Where-Object { $_.PSIsContainer } | Select-Object -First 1",
        "if ($folder) { Move-Item \"$($folder.FullName)\\*\" $dir -Force }",
        "if ($folder) { Remove-Item $folder.FullName -Recurse -Force }"
    ],
    "post_install": [
        "$weztermPath = \"$dir\\wezterm-gui.exe\".Replace('\\', '\\\\')",
        "'install-context', 'uninstall-context' | ForEach-Object {",
        "    if (Test-Path \"$bucketsdir\\extras\\scripts\\wezterm\\$_.reg\") {",
        "        $content = Get-Content \"$bucketsdir\\extras\\scripts\\wezterm\\$_.reg\"",
        "        $content = $content.Replace('$weztermPath', $weztermPath)",
        "        if ($global) { $content = $content.Replace('HKEY_CURRENT_USER', 'HKEY_LOCAL_MACHINE') }",
        "        Set-Content \"$dir\\$_.reg\" $content -Encoding Ascii -Force",
        "    }",
        "}"
    ],
    "uninstaller": {
        "script": "if ($cmd -eq 'uninstall') { reg import \"$dir\\uninstall-context.reg\" *> $null }"
    },
    "bin": [
        "wezterm.exe",
        "wezterm-gui.exe"
    ],
    "shortcuts": [
        [
            "wezterm-gui.exe",
            "Wezterm"
        ]
    ],
    "checkver": {
        "url": "https://api.github.com/repos/Lyaiya/wezterm-weekly/releases",
        "regex": "download/([\\da-f-]+?)/WezTerm-windows-[\\da-f-]+?\\.zip"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/Lyaiya/wezterm-weekly/releases/download/$version/WezTerm-windows-$version.zip"
            }
        },
        "hash": {
            "url": "$url.sha256"
        }
    }
}
