{
    "version": "0.8.2",
    "description": "Pokemon Pokopia recompiled to run natively on Windows, with multiplayer support",
    "homepage": "https://github.com/featureJosh/Recompia",
    "license": "GPL-3.0",
    "notes": "Run PokopiaLauncher and select your own game dump to complete setup.",
    "architecture": {
        "64bit": {
            "url": "https://github.com/featureJosh/Recompia/releases/download/v0.8.2/PokopiaRecomp-0.8.2-win64.zip",
            "hash": "711fe65e2274b1a855e436d614fd5be863751dcfaf60f1c44e019ca1dd4ddbbf"
        }
    },
    "extract_dir": "PokopiaRecomp-0.8.2",
    "pre_install": [
        "foreach ($file in 'pkp.ini', 'controls.ini', 'pkp.exe') {",
        "    if (Test-Path \"$persist_dir\\$file\") { Copy-Item \"$persist_dir\\$file\" \"$dir\\$file\" -Force }",
        "}"
    ],
    "pre_uninstall": [
        "foreach ($file in 'pkp.ini', 'controls.ini', 'pkp.exe') {",
        "    if (Test-Path \"$dir\\$file\") { Copy-Item \"$dir\\$file\" \"$persist_dir\\$file\" -Force }",
        "}"
    ],
    "shortcuts": [
        [
            "PokopiaLauncher.exe",
            "Recompia"
        ]
    ],
    "persist": [
        "save",
        "shader_cache",
        "build",
        "nup_dump"
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/featureJosh/Recompia/releases/download/v$version/PokopiaRecomp-$version-win64.zip",
                "hash": {
                    "url": "https://github.com/featureJosh/Recompia/releases/download/v$version/SHA256SUMS.txt"
                }
            }
        },
        "extract_dir": "PokopiaRecomp-$version"
    }
}
