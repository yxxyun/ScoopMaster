{
    "version": "1.1.1",
    "description": "Checks for and installs AMD chipset driver updates from amd.com.",
    "homepage": "https://github.com/Maxsenza151/amd-chipset-updater",
    "license": "MIT",
    "notes": "Requires Windows 10 or 11 with .NET Framework 4.8.",
    "url": "https://github.com/Maxsenza151/amd-chipset-updater/releases/download/v1.1.1/AMDChipsetUpdater-Portable-1.1.1.zip",
    "hash": "e1317e7f2f60a4ea058f6869025adc03dd87bc0d503d86f0912b29f8bc335950",
    "bin": "AMDChipsetUpdater.exe",
    "shortcuts": [
        [
            "AMDChipsetUpdater.exe",
            "AMD Chipset Updater"
        ]
    ],
    "post_uninstall": [
        "if ($cmd -eq 'uninstall') {",
        "    $runKey = 'HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Run'",
        "    $startup = (Get-ItemProperty -LiteralPath $runKey -ErrorAction SilentlyContinue).AMDChipsetUpdater",
        "    $pattern = '^\"{0}\\\\[^\\\\]+\\\\AMDChipsetUpdater\\.exe\" --check$' -f [regex]::Escape((appdir $app $global))",
        "    if ($startup -match $pattern) {",
        "        Remove-ItemProperty -LiteralPath $runKey -Name 'AMDChipsetUpdater'",
        "    }",
        "}"
    ],
    "checkver": "github",
    "autoupdate": {
        "url": "https://github.com/Maxsenza151/amd-chipset-updater/releases/download/v$version/AMDChipsetUpdater-Portable-$version.zip"
    }
}
