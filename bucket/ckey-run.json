{
    "version": "2026.09.15",
    "description": "JetBrains activation via ja-netfilter (ckey.run distribution)",
    "homepage": "https://ckey.run",
    "license": "GPL-3.0-only",
    "notes": [
        "WARNING: This manifest automates bypassing JetBrains commercial licensing.",
        "",
        "Differences from jetbra:",
        "* Core components (ja-netfilter.jar, power/dns/url/hideme plugins) are IDENTICAL (same SHA-1)",
        "* Adds 3rd-party plugins: env.jar, native.jar, privacy.jar (anti-detection, from gitea.998043.xyz)",
        "* power.conf downloaded from server at install time (no hash verification - updates frequently)",
        "* Working directory: C:\\Users\\Public\\.jb_run (writable by any local user - RCE risk)",
        "",
        "Security risks:",
        "* Downloads plugin JARs without hash verification",
        "* Local privilege escalation: any interactive user can modify C:\\Users\\Public\\.jb_run\\*.jar",
        "* Third-party privacy.jar accesses JDK internal APIs (requires --add-opens)",
        "",
        "* Previously installed JB apps from Scoop are patched automatically.",
        "* Newly installed JB apps from Scoop require: scoop uninstall ckey-run; scoop install ckey-run",
        "* Conflicts with jetbra - cannot coexist.",
        "* IDE restart required after install/uninstall."
    ],
    "url": "https://ckey.run/ja-netfilter/ja-netfilter.jar",
    "hash": "0100484b6410660eca2c202f4a5bfd907763bdb323e1c07662c12dbde5ba8936",
    "installer": {
        "script": [
            "# Download plugins",
            "$plugins = @('dns.jar', 'env.jar', 'hideme.jar', 'native.jar', 'power.jar', 'privacy.jar', 'url.jar')",
            "New-Item -ItemType Directory -Force -Path \"$dir\\plugins\" | Out-Null",
            "foreach ($plugin in $plugins) {",
            "    Write-Host \"Downloading plugins/$plugin...\"",
            "    try {",
            "        Invoke-WebRequest -Uri \"https://ckey.run/ja-netfilter/plugins/$plugin\" -OutFile \"$dir\\plugins\\$plugin\" -ErrorAction Stop",
            "    } catch {",
            "        Write-Host \"Failed to download $plugin : $_\" -ForegroundColor Red",
            "        throw",
            "    }",
            "}",
            "",
            "# Download configs",
            "$configs = @('dns.conf', 'env.conf', 'native.conf', 'power.conf', 'url.conf')",
            "New-Item -ItemType Directory -Force -Path \"$dir\\config\" | Out-Null",
            "foreach ($conf in $configs) {",
            "    Write-Host \"Downloading config/$conf...\"",
            "    try {",
            "        Invoke-WebRequest -Uri \"https://ckey.run/ja-netfilter/config/$conf\" -OutFile \"$dir\\config\\$conf\" -ErrorAction Stop",
            "    } catch {",
            "        Write-Host \"Failed to download $conf : $_\" -ForegroundColor Yellow",
            "    }",
            "}",
            "",
            "Write-Host ''",
            "Write-Host 'Patching JetBrains IDEs vmoptions...'",
            "",
            "function Update-VmOptions([string]$file) {",
            "    Write-Host \"  Patching $file...\"",
            "    $jarFile = \"$dir\\ja-netfilter.jar\"",
            "    $newContent = @()",
            "    $regex = '^-javaagent:.*[\\/\\\\]ja-netfilter\\.jar.*'",
            "    $regexAddOpens = '^--add-opens=java\\.base/jdk\\.internal\\.org\\.objectweb\\.asm'",
            "",
            "    if (Test-Path $file) {",
            "        Copy-Item -Path $file -Destination \"$file.bak\" -Force",
            "        Get-Content $file | ForEach-Object {",
            "            if ($_ -notmatch $regex -and $_ -notmatch $regexAddOpens) {",
            "                $newContent += $_",
            "            }",
            "        }",
            "    }",
            "",
            "    $newContent += '--add-opens=java.base/jdk.internal.org.objectweb.asm=ALL-UNNAMED'",
            "    $newContent += '--add-opens=java.base/jdk.internal.org.objectweb.asm.tree=ALL-UNNAMED'",
            "    $newContent += \"-javaagent:$jarFile\"",
            "    $newContent | Set-Content $file",
            "}",
            "",
            "$JBProducts = @('idea', 'idea-ultimate', 'clion', 'phpstorm', 'goland', 'pycharm', 'pycharm-professional', 'webstorm', 'webide', 'rider', 'datagrip', 'rubymine', 'appcode', 'dataspell', 'gateway', 'jetbrains_client', 'jetbrainsclient', 'devecostudio', 'aqua', 'rustrover')",
            "foreach ($prd in $JBProducts) {",
            "    Get-ChildItem \"$scoopdir\\apps\\$prd*\\current\\IDE\\bin\\*.exe.vmoptions\" -ErrorAction SilentlyContinue | ForEach-Object {",
            "        Update-VmOptions -file $_.FullName",
            "    }",
            "}",
            "",
            "Write-Host ''",
            "Write-Host 'Installation complete. Restart your JetBrains IDEs to apply changes.' -ForegroundColor Green",
            "Write-Host 'Get activation keys from: https://ckey.run' -ForegroundColor Cyan"
        ]
    },
    "uninstaller": {
        "script": [
            "Write-Host 'Restoring JetBrains IDEs vmoptions...'",
            "",
            "function Restore-VmOptions([string]$file) {",
            "    Write-Host \"  Restoring $file...\"",
            "    if (Test-Path \"$file.bak\") {",
            "        Copy-Item -Path \"$file.bak\" -Destination $file -Force",
            "        Remove-Item \"$file.bak\" -Force",
            "    } else {",
            "        if (Test-Path $file) {",
            "            $newContent = @()",
            "            $regex = '^-javaagent:.*[\\/\\\\]ja-netfilter\\.jar.*'",
            "            $regexAddOpens = '^--add-opens=java\\.base/jdk\\.internal\\.org\\.objectweb\\.asm'",
            "            Get-Content $file | ForEach-Object {",
            "                if ($_ -notmatch $regex -and $_ -notmatch $regexAddOpens) {",
            "                    $newContent += $_",
            "                }",
            "            }",
            "            $newContent | Set-Content $file",
            "        }",
            "    }",
            "}",
            "",
            "$JBProducts = @('idea', 'idea-ultimate', 'clion', 'phpstorm', 'goland', 'pycharm', 'pycharm-professional', 'webstorm', 'webide', 'rider', 'datagrip', 'rubymine', 'appcode', 'dataspell', 'gateway', 'jetbrains_client', 'jetbrainsclient', 'devecostudio', 'aqua', 'rustrover')",
            "foreach ($prd in $JBProducts) {",
            "    Get-ChildItem \"$scoopdir\\apps\\$prd*\\current\\IDE\\bin\\*.exe.vmoptions\" -ErrorAction SilentlyContinue | ForEach-Object {",
            "        Restore-VmOptions -file $_.FullName",
            "    }",
            "}",
            "",
            "Write-Host ''",
            "Write-Host 'Uninstallation complete. Restart your JetBrains IDEs.' -ForegroundColor Green"
        ]
    },
    "checkver": {
        "url": "https://ckey.run/",
        "regex": "Script Date[:\\s]+([\\d-]+)",
        "replace": "${1}"
    }
}
