{
    "##": "Based on hotkey-detective.json",
    "version": "0.7.2-alpha",
    "description": "AutoHotkey Repository Install System (Package Manager for AHK v2)",
    "homepage": "https://github.com/Descolada/Aris",
    "license": "MIT",
    "url": "https://github.com/Descolada/Aris/archive/refs/tags/v0.7.2-alpha.zip",
    "hash": "857259dc6bb67542e3e88c81df093607cd743168e7847e4ab6638748d5750293",
    "extract_dir": "Aris-0.7.2-alpha",
    "installer": {
        "script": [
            "$ahkPath = Join-Path $env:ProgramFiles 'AutoHotkey\\v2\\AutoHotkey64.exe'",
            "if (-not (Test-Path $ahkPath)) { $ahkPath = Join-Path $env:ProgramFiles 'AutoHotkey\\AutoHotkey.exe' }",
            "if (Test-Path $ahkPath) {",
            "    Write-Host 'Launching Aris to initialize background configurations and create PATH integrations...' -ForegroundColor Yellow",
            "    Start-Process -FilePath $ahkPath -ArgumentList \"`\"$dir\\aris.ahk`\"\" -Wait",
            "} else {",
            "    Write-Warning 'AutoHotkey v2 executable could not be found. Please manually launch aris.ahk inside the installation folder later to complete background routing.'",
            "}"
        ]
    },
    "post_uninstall": [
        "$arisDataDir = Join-Path $env:APPDATA 'Aris'",
        "if (Test-Path $arisDataDir) {",
        "    Write-Host 'Removing Aris data directory in AppData...' -ForegroundColor Yellow",
        "    Remove-Item -Path $arisDataDir -Recurse -Force -ErrorAction SilentlyContinue",
        "}"
    ],
    "checkver": {
        "url": "https://github.com/Descolada/Aris/releases/latest",
        "regex": "v([\\d.]+(?:-alpha)?)"
    },
    "autoupdate": {
        "url": "https://github.com/Descolada/Aris/archive/refs/tags/v$version.zip",
        "extract_dir": "Aris-$version"
    }
}
