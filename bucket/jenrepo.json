{
    "version": "0.8.1",
    "description": "Operate a Jenesis repository from the command line.",
    "homepage": "https://github.com/jenesis/jenesis-repository",
    "license": "Apache-2.0",
    "url": "https://github.com/jenesis/jenesis-repository/releases/download/v0.8.1/jenrepo-0.8.1.zip",
    "hash": "sha256:0593d4121463cbf6a4b23e28cba5475a166330ba7d55363e1d596be7053a2fce",
    "extract_dir": "jenrepo-0.8.1",
    "env_add_path": "bin",
    "suggest": {
        "JDK": [
            "java/oraclejdk",
            "java/openjdk"
        ]
    },
    "checkver": {
        "url": "https://github.com/jenesis/jenesis-repository/releases/latest",
        "re": "v([\\d.]+).zip"
    },
    "autoupdate": {
