{
    "version": "0.4.5",
    "description": "Modern video/audio downloader based on yt-dlp with browser integration",
    "homepage": "https://neodlp.neosubhamoy.com/",
    "license": "MIT",
    "notes": [
        "NeoDLP 的用户数据目录已持久化到 Scoop persist，并在原路径创建 Junction（所有启动方式共用同一份数据）：",
        "  %APPDATA%\\com.neosubhamoy.neodlp        -> persist\\neodlp\\appdata（database.db、设置与下载历史）",
        "  %APPDATA%\\neosubhamoy\\neodlp\\config     -> persist\\neodlp\\msghost-config（浏览器本地消息宿主配置）",
        "首次安装会迁移原目录中的数据；卸载（不带 -p）保留数据，重装可复用。",
        "安装时注册 Chrome/Chromium 与 Firefox 的 Native Messaging 宿主，并添加开机自启（--hidden，托盘运行）；卸载时移除。",
        "浏览器集成需要安装扩展：https://github.com/neosubhamoy/neodlp-extension",
        "需要 WebView2 Runtime（Windows 10/11 通常已内置）。应用内更新会绕过 Scoop，建议使用 scoop update neodlp。"
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/neosubhamoy/neodlp/releases/download/v0.4.5/NeoDLP_0.4.5_x64-setup.exe#/dl.7z",
            "hash": "1ee385c163528eb69eada953b6b860a2995ea3a8b937126750b049a5c7112ee9"
        },
        "arm64": {
            "url": "https://github.com/neosubhamoy/neodlp/releases/download/v0.4.5/NeoDLP_0.4.5_arm64-setup.exe#/dl.7z",
            "hash": "f67dc747915bf593c1bf731b4e3bd1292d188eaa0c49995ed6483d68ec83a74f"
        }
    },
    "pre_install": "Remove-Item \"$dir\\`$PLUGINSDIR\", \"$dir\\uninstall.exe\" -Recurse -Force -ErrorAction SilentlyContinue",
    "post_install": [
        "$createJunction = {",
        "    param($source, $name)",
        "    $target = Join-Path $persist_dir $name",
        "    ensure $target | Out-Null",
        "",
        "    if (Test-Path -LiteralPath $source) {",
        "        $item = Get-Item -LiteralPath $source -Force",
        "        if ($item.Attributes -band [IO.FileAttributes]::ReparsePoint) {",
        "            info \"Link already exists, skipping: $source\"",
        "            return",
        "        }",
        "        if (-not $item.PSIsContainer) {",
        "            throw \"Data path exists but is not a directory: $source\"",
        "        }",
        "",
        "        & robocopy $source $target /E /R:1 /W:1 /NFL /NDL /NJH /NJS /NP | Out-Null",
        "        if ($LASTEXITCODE -gt 7) {",
        "            warn \"Migration failed, keeping the original directory: $source\"",
        "            return",
        "        }",
        "",
        "        $backup = \"$source.backup-$(Get-Date -Format 'yyyyMMdd-HHmmss')\"",
        "        try {",
        "            Move-Item -LiteralPath $source -Destination $backup -Force",
        "            info \"Original data directory backed up to $backup\"",
        "        } catch {",
        "            warn \"Could not rename the original directory: $source\"",
        "            return",
        "        }",
        "    }",
        "",
        "    ensure (Split-Path -Path $source -Parent) | Out-Null",
        "    New-Item -Path $source -ItemType Junction -Value $target | Out-Null",
        "    info \"Linked $source -> $target\"",
        "}",
        "",
        "& $createJunction (Join-Path $env:AppData 'com.neosubhamoy.neodlp') 'appdata'",
        "& $createJunction (Join-Path $env:AppData 'neosubhamoy\\neodlp\\config') 'msghost-config'",
        "",
        "$current = Join-Path (Split-Path -Path $dir) 'current'",
        "$entries = @(",
        "    @('Software\\Google\\Chrome\\NativeMessagingHosts\\com.neosubhamoy.neodlp', (Join-Path $current 'chrome.json')),",
        "    @('Software\\Mozilla\\NativeMessagingHosts\\com.neosubhamoy.neodlp', (Join-Path $current 'firefox.json'))",
        ")",
        "foreach ($entry in $entries) {",
        "    $key = [Microsoft.Win32.Registry]::CurrentUser.CreateSubKey($entry[0])",
        "    $key.SetValue('', $entry[1])",
        "    $key.Close()",
        "}",
        "$runKey = [Microsoft.Win32.Registry]::CurrentUser.OpenSubKey('Software\\Microsoft\\Windows\\CurrentVersion\\Run', $true)",
        "if ($runKey) {",
        "    $runKey.SetValue('NeoDLP', \"`\"$current\\neodlp.exe`\" --hidden\")",
        "    $runKey.Close()",
        "}"
    ],
    "pre_uninstall": [
        "$keys = @(",
        "    'HKCU:\\Software\\Google\\Chrome\\NativeMessagingHosts\\com.neosubhamoy.neodlp',",
        "    'HKCU:\\Software\\Mozilla\\NativeMessagingHosts\\com.neosubhamoy.neodlp'",
        ")",
        "foreach ($key in $keys) {",
        "    if (Test-Path -LiteralPath $key) { Remove-Item -LiteralPath $key -Recurse -Force }",
        "}",
        "Remove-ItemProperty -Path 'HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Run' -Name 'NeoDLP' -ErrorAction SilentlyContinue",
        "if ($purge) {",
        "    $links = @((Join-Path $env:AppData 'com.neosubhamoy.neodlp'), (Join-Path $env:AppData 'neosubhamoy\\neodlp\\config'))",
        "    foreach ($link in $links) {",
        "        if (Test-Path -LiteralPath $link) {",
        "            $item = Get-Item -LiteralPath $link -Force",
        "            if ($item.Attributes -band [IO.FileAttributes]::ReparsePoint) {",
        "                & \"$env:COMSPEC\" /c \"rmdir `\"$link`\"\"",
        "            }",
        "        }",
        "    }",
        "    Remove-Item -LiteralPath (Join-Path $env:LocalAppData 'com.neosubhamoy.neodlp') -Recurse -Force -ErrorAction SilentlyContinue",
        "}"
    ],
    "shortcuts": [
        [
            "neodlp.exe",
            "NeoDLP"
        ]
    ],
    "persist": [
        "appdata",
        "msghost-config"
    ],
    "checkver": {
        "github": "https://github.com/neosubhamoy/neodlp"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/neosubhamoy/neodlp/releases/download/v$version/NeoDLP_$version_x64-setup.exe#/dl.7z"
            },
            "arm64": {
                "url": "https://github.com/neosubhamoy/neodlp/releases/download/v$version/NeoDLP_$version_arm64-setup.exe#/dl.7z"
            }
        },
        "hash": {
            "mode": "download"
        }
    }
}
