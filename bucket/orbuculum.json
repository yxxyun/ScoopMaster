    "architecture": {
        "64bit": {
            "url": "https://nightly.link/orbcode/orbuculum/actions/runs/30168471690/orbuculum-windows.zip",
            "hash": "ef915734a7153ffd8cc9f47c6ce48765c05a3a50684d1cb18702449fec792234"
        }
    },
    "bin": [
        "bin/orbcat.exe",
        "orbcat.exe",
        "orbdump.exe",
        "orblcd.exe",
        "orbprofile.exe",
        "orbstat.exe",
        "orbtop.exe",
        "orbtrace.exe",
        "orbuculum.exe",
        "orbzmq.exe"
    ],
    "checkver": {
        "script": [
            "$ErrorActionPreference = 'Stop'",
            "$url = 'https://api.github.com/repos/orbcode/orbuculum/actions/workflows/build-windows.yml/runs?branch=main&status=success&per_page=1'",
            "$runs = (Invoke-WebRequest $url).Content | ConvertFrom-Json",
            "$run_id = $runs.workflow_runs[0].id",
            "",
            "$tags_url = 'https://api.github.com/repos/orbcode/orbuculum/tags?per_page=1'",
            "$tags = (Invoke-WebRequest $tags_url).Content | ConvertFrom-Json",
            "$latest_tag = $tags[0].name",
            "",
            "Write-Output \"$latest_tag $run_id\""
        ],
        "regex": "[v|V](?<version>[\\w\\.]*) (?<run>\\d*)",
        "replace": "${version}-${run}"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://nightly.link/orbcode/orbuculum/actions/runs/$matchRun/orbuculum-windows.zip"
            }
        }
    }
}
