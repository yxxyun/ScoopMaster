{
    "version": "0.1.5",
    "description": "Local-first desktop companion connecting Android phones and Windows PCs for notifications, messages, calls, clipboard, file transfers, screen mirroring, phone apps, and media controls.",
    "homepage": "https://github.com/thtbee/nectarlink",
    "license": "GPL-3.0-or-later",
    "url": "https://github.com/thtbee/nectarlink/releases/download/v0.1.5/Nectarlink-0.1.5-x64-setup.exe",
    "hash": "9db9066b7024283a22db0ea026cd52584a0646a888239c559c0417eac6f32ac4",
    "checkver": {
        "url": "https://api.github.com/repos/thtbee/nectarlink/releases/latest",
        "jsonpath": "$.tag_name",
        "regex": "^v(?<version>[\\d.]+)$"
    },
    "autoupdate": {
        "url": "https://github.com/thtbee/nectarlink/releases/download/v$version/Nectarlink-$version-x64-setup.exe"
    },
    "installer": {
        "script": [
            "$setupPath = Join-Path $dir $fname",
            "$setupTempPath = Join-Path $env:TEMP ('Nectarlink-' + $version + '-setup-' + [guid]::NewGuid().ToString('N') + '.exe')",
            "$callerSid = [Security.Principal.WindowsIdentity]::GetCurrent().User.Value",
            "$setupLiteral = \"'\" + $setupPath.Replace(\"'\", \"''\") + \"'\"",
            "$tempLiteral = \"'\" + $setupTempPath.Replace(\"'\", \"''\") + \"'\"",
            "$dirLiteral = \"'\" + $dir.Replace(\"'\", \"''\") + \"'\"",
            "$sidLiteral = \"'\" + $callerSid.Replace(\"'\", \"''\") + \"'\"",
            "$adminScript = @'
$ErrorActionPreference = 'Stop'
$setupPath = __SETUP_PATH__
$setupTempPath = __SETUP_TEMP_PATH__
$installDir = __INSTALL_DIR__
$callerSid = __CALLER_SID__
$icacls = Join-Path $env:SystemRoot 'System32\\icacls.exe'
& $icacls $installDir /reset /T /C /Q | Out-Null
if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
Move-Item -LiteralPath $setupPath -Destination $setupTempPath -Force
Get-ChildItem -LiteralPath $installDir -Force | Remove-Item -Recurse -Force
$process = Start-Process -FilePath $setupTempPath -ArgumentList \"/S /D=$installDir\" -Wait -PassThru
if ($process.ExitCode -ne 0) { exit $process.ExitCode }
$grant = '*{0}:(OI)(CI)M' -f $callerSid
& $icacls $installDir /grant $grant /T /C /Q | Out-Null
if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
$app = Join-Path $installDir 'nectarlink-desktop.exe'
if (-not (Test-Path -LiteralPath $app -PathType Leaf)) { exit 2 }
Remove-Item -LiteralPath $setupTempPath -Force
exit 0
'@",
            "$adminScript = $adminScript.Replace('__SETUP_PATH__', $setupLiteral).Replace('__SETUP_TEMP_PATH__', $tempLiteral).Replace('__INSTALL_DIR__', $dirLiteral).Replace('__CALLER_SID__', $sidLiteral)",
            "$encodedCommand = [Convert]::ToBase64String([Text.Encoding]::Unicode.GetBytes($adminScript))",
            "$powershellPath = (Get-Process -Id $PID).Path",
            "try {",
            "    $process = Start-Process -FilePath $powershellPath -ArgumentList \"-NoProfile -ExecutionPolicy Bypass -EncodedCommand $encodedCommand\" -Verb RunAs -Wait -PassThru",
            "    if ($process.ExitCode -ne 0) { throw \"NectarLink installer failed with exit code $($process.ExitCode).\" }",
            "} finally {",
            "    Remove-Item -LiteralPath $setupTempPath -Force -ErrorAction SilentlyContinue",
            "}"
        ]
    },
    "uninstaller": {
        "script": [
            "if ($cmd -ne 'update') {",
            "    $uninstallerPath = Join-Path $dir 'uninstall.exe'",
            "    if (Test-Path -LiteralPath $uninstallerPath -PathType Leaf) {",
            "        $callerSid = [Security.Principal.WindowsIdentity]::GetCurrent().User.Value",
            "        $uninstallerLiteral = \"'\" + $uninstallerPath.Replace(\"'\", \"''\") + \"'\"",
            "        $dirLiteral = \"'\" + $dir.Replace(\"'\", \"''\") + \"'\"",
            "        $adminScript = @'
$ErrorActionPreference = 'Stop'
$uninstallerPath = __UNINSTALLER_PATH__
$installDir = __INSTALL_DIR__
$process = Start-Process -FilePath $uninstallerPath -ArgumentList \"/S _?=$installDir\" -Wait -PassThru
if ($process.ExitCode -ne 0) { exit $process.ExitCode }
exit 0
'@",
            "        $adminScript = $adminScript.Replace('__UNINSTALLER_PATH__', $uninstallerLiteral).Replace('__INSTALL_DIR__', $dirLiteral)",
            "        $encodedCommand = [Convert]::ToBase64String([Text.Encoding]::Unicode.GetBytes($adminScript))",
            "        $powershellPath = (Get-Process -Id $PID).Path",
            "        $process = Start-Process -FilePath $powershellPath -ArgumentList \"-NoProfile -ExecutionPolicy Bypass -EncodedCommand $encodedCommand\" -Verb RunAs -Wait -PassThru",
            "        if ($process.ExitCode -ne 0) { throw \"NectarLink uninstaller failed with exit code $($process.ExitCode).\" }",
            "    }",
            "}"
        ]
    },
    "bin": "nectarlink-desktop.exe"
}
