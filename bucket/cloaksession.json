{
    "version": "1.1.0",
    "description": "Isolated multi-session fingerprint browser with per-profile fingerprint, proxy and behavioral settings, built with Tauri 2.x and Rust",
    "homepage": "https://github.com/xiaozhou26/Cloaksession",
    "license": "Unknown",
    "notes": [
        "Cloaksession 是一个多会话指纹浏览器，按配置文件隔离指纹、代理和行为设置",
        "主程序文件名为 tauri-app.exe，已注册为命令 cloaksession",
        "用户数据目录：%LOCALAPPDATA%\\com.cloaksession.browser\\（profiles.db、profiles、settings.json 等）",
        "本包会将该目录持久化到 Scoop 的 persist，并在原路径创建 Junction 指向 persist",
        "应用需要配套的浏览器内核（默认查找 PATH 中的 cloakbrowser.exe，可在设置中指定路径）"
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/xiaozhou26/Cloaksession/releases/download/v1.1.0/Cloaksession_1.1.0_x64-setup.exe#/dl.7z",
            "hash": "e6256690678cd213d1152c515d1556f84db4690419b4baaf4617d9264fa9c9be"
        }
    },
    "pre_install": "Remove-Item \"$dir\\`$*\", \"$dir\\uninstall.exe\" -Force -Recurse -ErrorAction SilentlyContinue",
    "bin": [
        [
            "tauri-app.exe",
            "cloaksession"
        ]
    ],
    "shortcuts": [
        [
            "tauri-app.exe",
            "Cloaksession"
        ]
    ],
    "post_install": [
        "$source = Join-Path $env:LOCALAPPDATA 'com.cloaksession.browser'",
        "$target = Join-Path $persist_dir 'data'",
        "ensure $target",
        "",
        "if (Test-Path $source) {",
        "    $item = Get-Item -LiteralPath $source -Force",
        "    if ($item.Attributes -band [IO.FileAttributes]::ReparsePoint) {",
        "        Write-Host \"检测到已存在的联接点：$source，跳过创建\"",
        "        return",
        "    }",
        "    if (-not $item.PSIsContainer) {",
        "        throw \"配置路径已存在且不是目录：$source\"",
        "    }",
        "",
        "    & robocopy $source $target /E /R:1 /W:1 /NFL /NDL /NJH /NJS /NP | Out-Null",
        "    if ($LASTEXITCODE -gt 7) {",
        "        Write-Host \"迁移失败，保留原目录：$source\"",
        "        return",
        "    }",
        "",
        "    $backup = \"$source.backup-$(Get-Date -Format 'yyyyMMdd-HHmmss')\"",
        "    try {",
        "        Move-Item -LiteralPath $source -Destination $backup -Force",
        "        Write-Host \"已备份原配置目录：$backup\"",
        "    } catch {",
        "        Write-Host \"无法重命名原目录：$source\"",
        "        return",
        "    }",
        "}",
        "",
        "New-Item -Path $source -ItemType Junction -Value $target | Out-Null"
    ],
    "post_uninstall": [
        "$source = Join-Path $env:LOCALAPPDATA 'com.cloaksession.browser'",
        "if (Test-Path $source) {",
        "    $item = Get-Item -LiteralPath $source -Force",
        "    if ($item.Attributes -band [IO.FileAttributes]::ReparsePoint) {",
        "        Remove-Item -LiteralPath $source -Force",
        "    }",
        "}"
    ],
    "persist": "data",
    "checkver": {
        "github": "https://github.com/xiaozhou26/Cloaksession"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/xiaozhou26/Cloaksession/releases/download/v$version/Cloaksession_$version_x64-setup.exe#/dl.7z"
            }
        }
    }
}
