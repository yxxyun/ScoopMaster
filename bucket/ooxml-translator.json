{
    "version": "4.0.0",
    "description": "Translate XLSX, DOCX, and PPTX documents with OpenAI-compatible language models.",
    "homepage": "https://github.com/lemos1235/excel-translator",
    "license": "MIT",
    "url": "https://github.com/lemos1235/excel-translator/releases/download/4.0.0/ooxml-translator-setup-4.0.0-amd64.exe",
    "hash": "6acab807747a4137d7fc69c5bde1d439f48ada569c5b59750a242c4ff8a684e1",
    "##": "Installer Type: NSIS",
    "installer": {
        "args": [
            "/S",
            "/D=$dir"
        ]
    },
    "uninstaller": {
        "script": [
            "if ($cmd -ne 'update') {",
            "    $uninstaller = Join-Path $dir 'Uninstall.exe'",
            "    if (-not (Test-Path -LiteralPath $uninstaller -PathType Leaf)) { throw 'OOXML Translator NSIS uninstaller was not found in the Scoop version directory.' }",
            "    $uninstallArgs = @('/S', ('\"' + '_?=' + $dir + '\"'))",
            "    $process = Start-Process -FilePath $uninstaller -ArgumentList $uninstallArgs -Wait -PassThru -ErrorAction Stop",
            "    if ($process.ExitCode -ne 0) { throw \"OOXML Translator uninstaller exited with code $($process.ExitCode).\" }",
            "}"
        ]
    },
    "bin": "OOXML Translator.exe",
    "shortcuts": [
        [
            "OOXML Translator.exe",
            "OOXML Translator"
        ]
    ],
    "checkver": {
        "github": "https://github.com/lemos1235/excel-translator"
    },
    "autoupdate": {
        "url": "https://github.com/lemos1235/excel-translator/releases/download/$version/ooxml-translator-setup-$version-amd64.exe",
        "hash": {
            "mode": "json",
            "url": "https://api.github.com/repos/lemos1235/excel-translator/releases/tags/$version",
            "jp": "$.assets[?(@.name == 'ooxml-translator-setup-$version-amd64.exe')].digest"
        }
    }
}
