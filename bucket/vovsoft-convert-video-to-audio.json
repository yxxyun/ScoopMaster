{
    "version": "2.4",
    "description": "Portable edition of Vovsoft Convert Video to Audio.",
    "homepage": "https://vovsoft.com/software/convert-video-to-audio/",
    "license": "Proprietary",
    "url": "https://vovsoft.com/files/convert-video-to-audio-portable.zip?v=2.4",
    "checkver": {
        "url": "https://vovsoft.com/download/convert-video-to-audio-portable/",
        "regex": "(?is)Version\\s*(?:<[^>]*>\\s*)*:?\\s*(?:<[^>]*>\\s*)*(?<version>\\d+(?:\\.\\d+)+)"
    },
    "autoupdate": {
        "url": "https://vovsoft.com/files/convert-video-to-audio-portable.zip?v=$version"
    },
    "shortcuts": [
        [
            "convertva.exe",
            "Vovsoft Convert Video to Audio"
        ]
    ],
    "notes": [
        "SHA-256 has not been verified; archive contents and the shortcut target have been checked."
    ],
    "pre_install": [
        "if (-not (Test-Path -LiteralPath \"$dir\\key.txt\" -PathType Leaf)) { New-Item -ItemType File -Path \"$dir\\key.txt\" | Out-Null }"
    ],
    "persist": "key.txt"
}
