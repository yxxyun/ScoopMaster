{
    "version": "0.3.2",
    "description": "Clipboard text-to-speech desktop app with local and cloud voice engines, captions, tray integration, and browser companion.",
    "homepage": "https://github.com/ilyaizen/CopySpeech",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/ilyaizen/CopySpeech/releases/download/v0.3.2/CopySpeech_0.3.2_x64_en-US.msi",
            "hash": "a6bc4e571867886cded2b50ab1b4fccda87910422501a8b4ed6afa1f806ad728",
            "extract_dir": "PFiles\\CopySpeech"
        }
    },
    "persist": "data",
    "post_install": [
        "$persistRoot = Join-Path $persist_dir 'data'",
        "$locations = @(",
        "@{",
        "Source = Join-Path $env:APPDATA 'CopySpeech'",
        "Legacy = Join-Path $env:APPDATA 'CopySpeak'",
        "Relative = 'Roaming\\CopySpeech'",
        "},",
        "@{",
        "Source = Join-Path $env:LOCALAPPDATA 'CopySpeech'",
        "Legacy = Join-Path $env:LOCALAPPDATA 'CopySpeak'",
        "Relative = 'Local\\CopySpeech'",
        "},",
        "@{",
        "Source = Join-Path ([Environment]::GetFolderPath('MyDocuments')) 'CopySpeech'",
        "Legacy = Join-Path ([Environment]::GetFolderPath('MyDocuments')) 'CopySpeak'",
        "Relative = 'Documents\\CopySpeech'",
        "}",
        ")",
        "",
        "foreach ($location in $locations) {",
        "$target = Join-Path $persistRoot $location.Relative",
        "New-Item -ItemType Directory -Path $target -Force | Out-Null",
        "",
        "foreach ($sourcePath in @($location.Source, $location.Legacy)) {",
        "if (-not (Test-Path -LiteralPath $sourcePath)) {",
        "continue",
        "}",
        "",
        "$sourceItem = Get-Item -LiteralPath $sourcePath -Force",
        "if ($sourceItem.Attributes -band [IO.FileAttributes]::ReparsePoint) {",
        "if ($sourcePath -ieq $location.Source) {",
        "continue",
        "}",
        "throw \"CopySpeech legacy data path is already a reparse point; refusing to move it: $sourcePath\"",
        "}",
        "if (-not $sourceItem.PSIsContainer) {",
        "throw \"CopySpeech data path exists but is not a directory: $sourcePath\"",
        "}",
        "",
        "$children = @(Get-ChildItem -LiteralPath $sourcePath -Force)",
        "$conflicts = @($children | Where-Object {",
        "Test-Path -LiteralPath (Join-Path $target $_.Name)",
        "})",
        "if ($conflicts.Count -gt 0) {",
        "$names = ($conflicts | ForEach-Object Name) -join ', '",
        "throw \"CopySpeech data migration found name conflicts in '$sourcePath': $names. No conflicting files were overwritten.\"",
        "}",
        "",
        "foreach ($child in $children) {",
        "Move-Item -LiteralPath $child.FullName -Destination $target",
        "}",
        "if (@(Get-ChildItem -LiteralPath $sourcePath -Force).Count -eq 0) {",
        "Remove-Item -LiteralPath $sourcePath -Force",
        "}",
        "}",
        "",
        "if (Test-Path -LiteralPath $location.Source) {",
        "$existing = Get-Item -LiteralPath $location.Source -Force",
        "if ($existing.Attributes -band [IO.FileAttributes]::ReparsePoint) {",
        "$linkTarget = [string](@($existing.Target)[0])",
        "if ([string]::IsNullOrWhiteSpace($linkTarget)) {",
        "throw \"Could not determine the existing CopySpeech junction target: $($location.Source)\"",
        "}",
        "if ([IO.Path]::GetFullPath($linkTarget).TrimEnd('\\') -ne [IO.Path]::GetFullPath($target).TrimEnd('\\')) {",
        "throw \"CopySpeech path already points somewhere else: $($location.Source)\"",
        "}",
        "continue",
        "}",
        "throw \"CopySpeech data directory still exists after migration; refusing to replace it: $($location.Source)\"",
        "}",
        "",
        "New-Item -ItemType Directory -Path (Split-Path -Parent $location.Source) -Force | Out-Null",
        "New-Item -ItemType Junction -Path $location.Source -Target $target -ErrorAction Stop | Out-Null",
        "}",
        ""
    ],
    "pre_uninstall": [
        "$locations = @(",
        "@{",
        "Source = Join-Path $env:APPDATA 'CopySpeech'",
        "Relative = 'Roaming\\CopySpeech'",
        "},",
        "@{",
        "Source = Join-Path $env:LOCALAPPDATA 'CopySpeech'",
        "Relative = 'Local\\CopySpeech'",
        "},",
        "@{",
        "Source = Join-Path ([Environment]::GetFolderPath('MyDocuments')) 'CopySpeech'",
        "Relative = 'Documents\\CopySpeech'",
        "}",
        ")",
        "",
        "foreach ($location in $locations) {",
        "if (-not (Test-Path -LiteralPath $location.Source)) {",
        "continue",
        "}",
        "",
        "$item = Get-Item -LiteralPath $location.Source -Force",
        "if (-not ($item.Attributes -band [IO.FileAttributes]::ReparsePoint)) {",
        "continue",
        "}",
        "",
        "$expected = Join-Path $persist_dir ('data\\' + $location.Relative)",
        "$actual = [string](@($item.Target)[0])",
        "if (-not [string]::IsNullOrWhiteSpace($actual) -and",
        "[IO.Path]::GetFullPath($actual).TrimEnd('\\') -eq [IO.Path]::GetFullPath($expected).TrimEnd('\\')) {",
        "Remove-Item -LiteralPath $location.Source -Force",
        "}",
        "}",
        ""
    ],
    "shortcuts": [
        [
            "copyspeech.exe",
            "CopySpeech"
        ]
    ],
    "checkver": {
        "url": "https://api.github.com/repos/ilyaizen/CopySpeech/releases/latest",
        "jsonpath": "$.tag_name",
        "regex": "^v(?<version>[\\d.]+)$"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/ilyaizen/CopySpeech/releases/download/v$version/CopySpeech_$version_x64_en-US.msi",
                "extract_dir": "PFiles\\CopySpeech"
            }
        },
        "hash": {
            "url": "https://api.github.com/repos/ilyaizen/CopySpeech/releases/tags/v$version",
            "jsonpath": "$.assets[?(@.name == 'CopySpeech_$version_x64_en-US.msi')].digest"
        }
    },
    "notes": [
        "Scoop extracts the official MSI into the application directory; the MSI is not installed system-wide.",
        "Roaming, LocalAppData, and Documents data directories are linked to Scoop's persistent data folder. Existing CopySpeech/CopySpeak data is moved only when the destination has no filename conflicts; conflicts stop installation without overwriting data.",
        "The first launch may download selected local TTS engines and voice models. CopySpeech also offers cloud engines.",
        "CopySpeech includes an in-app updater; use Scoop as the update authority to avoid competing updates."
    ]
}
