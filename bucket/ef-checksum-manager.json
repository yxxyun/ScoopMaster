{
    "version": "26.10",
    "description": "Creates and verifies file checksums, including SFV/CRC32, MD5, BLAKE3, and SHA-family formats.",
    "homepage": "https://efsoftware.com/cm/e.htm",
    "license": "Shareware",
    "architecture": {
        "64bit": {
            "url": "https://efsoftware.com/_p4/cm",
            "extract_dir": "ef_checksum_manager_64",
            "shortcuts": [
                [
                    "EFCM.EXE",
                    "EF CheckSum Manager"
                ]
            ]
        }
    },
    "checkver": {
        "script": [
            "$response = Invoke-WebRequest -Uri 'https://efsoftware.com/dw/e.htm' -UseBasicParsing",
            "$html = [string]$response.Content",
            "$needle = 'href=\"/cm/e.htm\"'",
            "$start = $html.IndexOf($needle, [System.StringComparison]::OrdinalIgnoreCase)",
            "if ($start -lt 0) { throw 'Could not locate EF CheckSum Manager in the official EFSoftware download page.' }",
            "$versionCell = $html.IndexOf('align=right>', $start, [System.StringComparison]::OrdinalIgnoreCase)",
            "if ($versionCell -lt 0) { throw 'Could not locate the EF CheckSum Manager version cell in the official download page.' }",
            "$valueStart = $versionCell + 'align=right>'.Length",
            "$valueLength = [Math]::Min(80, $html.Length - $valueStart)",
            "$versionText = $html.Substring($valueStart, $valueLength)",
            "$match = [regex]::Match($versionText, '(?<version>\\d+\\.\\d+)')",
            "if (-not $match.Success) { throw 'Could not parse the EF CheckSum Manager version from the official download page.' }",
            "$match.Groups['version'].Value"
        ],
        "regex": "(?<version>\\d+\\.\\d+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://efsoftware.com/_p4/cm",
                "extract_dir": "ef_checksum_manager_64"
            }
        }
    }
}
