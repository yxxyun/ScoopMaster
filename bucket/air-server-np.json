{
    "version": "5.7.2",
    "description": "AirServer is the most advanced screen mirroring receiver for Mac and PC.",
    "license": "Proprietary",
    "homepage": "https://www.airserver.com",
    "architecture": {
        "64bit": {
            "url": "https://dl.airserver.com/pc32/AirServer-5.7.2-x64.msi#/setup.msi_",
            "hash": "173685e9c546993d9956030587ee296b61947e8944878538abd5a598b91a9bfc"
        },
        "32bit": {
            "url": "https://dl.airserver.com/pc32/AirServer-5.7.2-x86.msi#/setup.msi_",
            "hash": "6a0990ca4c8b637479233ca149714aff9ebe3fa5487133a499ca9a5fb04799d5"
        }
    },
    "installer": {
        "script": [
            "if (!(is_admin)) { error \"$app requires admin rights to $cmd\"; break }",
            "Start-Process msiexec -ArgumentList @('/i', \"`\"$dir\\setup.msi_`\"\", '/qn', '/norestart') -Wait -Verb RunAs | Out-Null"
        ]
    },
    "uninstaller": {
        "script": [
            "if (!(is_admin)) { error \"$app requires admin rights to $cmd\"; break }",
            "Start-Process msiexec -ArgumentList @('/x', \"`\"$dir\\setup.msi_`\"\", '/qn', '/norestart') -Wait -Verb RunAs | Out-Null"
        ]
    },
    "checkver": {
        "script": [
            "$url = & curl.exe --silent --show-error --head --location --max-redirs 10 --max-time 30 --output NUL --write-out '%{url_effective}' 'https://www.airserver.com/download/windows/classic/x64'",
            "if ($LASTEXITCODE -ne 0 -or [string]::IsNullOrWhiteSpace($url)) { throw 'Could not retrieve the official AirServer download URL.' }",
            "$match = [regex]::Match($url, 'AirServer-(?<version>\\d+(?:\\.\\d+)+)-x64\\.msi')",
            "if (-not $match.Success) { throw \"Could not detect the AirServer version from its final official URL: $url\" }",
            "$match.Groups['version'].Value"
        ],
        "regex": "^(?<version>\\d+(?:\\.\\d+)+)$"
    },
    "notes": "Detects the version from the final URL returned by AirServer's official download redirect.",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://dl.airserver.com/pc32/AirServer-$version-x64.msi#/setup.msi_"
            },
            "32bit": {
                "url": "https://dl.airserver.com/pc32/AirServer-$version-x86.msi#/setup.msi_"
            }
        }
    }
}
