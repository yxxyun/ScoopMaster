{
    "version": "2.0.0.8",
    "description": "Used to rectify the perspective in natural taken images.",
    "homepage": "https://perspectiveimg.sourceforge.io",
    "license": "GPL-3.0-or-later",
    "suggest": {
        "vcredist": "extras/vcredist2010"
    },
    "architecture": {
        "64bit": {
            "url": "https://sourceforge.net/projects/perspectiveimg/Setup_Perspective_Image_Correction64_2008.msi",
            "hash": "d6c24f0a64a45c83cb3c8bbcd5c4c9900c6aa68c0d4236425da9654a2cbf0f02"
        }
    },
    "extract_dir": "PerspectiveImageCorrection",
    "shortcuts": [
        [
            "PerspectiveImageCorrection.exe",
            "PerspectiveImageCorrection"
        ]
    ],
    "checkver": {
        "sourceforge": "perspectiveimg",
        "regex": "Setup_Perspective_Image_Correction64_(\\d)(\\d)(\\d)(\\d)\\.msi",
        "replace": "${1}.${2}.${3}.${4}"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://sourceforge.net/projects/perspectiveimg/Setup_Perspective_Image_Correction64_$match1$match2$match3$match4.msi"
            }
        }
    }
}
