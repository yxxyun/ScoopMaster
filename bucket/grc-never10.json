{
    "version": "2019.04.21",
    "description": "GRC Never10: Legacy utility for controlling the Windows 7/8.1 upgrade offer to Windows 10.",
    "homepage": "https://www.grc.com/never10.htm",
    "license": "Freeware",
    "url": "https://www.grc.com/files/never10.exe",
    "bin": "never10.exe",
    "shortcuts": [
        [
            "never10.exe",
            "GRC Never10"
        ]
    ],
    "notes": [
        "GRC does not publish a static SHA-256 checksum for this download. The manifest omits hash rather than inventing a value.",
        "Obsolete and intended only for Windows 7/8.1-era upgrade behavior. It is not a Windows 10/11 update-control tool; use GRC InControl for that purpose."
    ],
    "checkver": {
        "script": [
            "$html = (Invoke-WebRequest -Uri 'https://www.grc.com/never10.htm' -UseBasicParsing).Content",
            "$text = [System.Net.WebUtility]::HtmlDecode([regex]::Replace($html, '<[^>]+>', ' '))",
            "$text = [regex]::Replace($text, '\\s+', ' ')",
            "$match = [regex]::Match($text, '(?is)File stats for:\\s*Never10.{0,1800}?Last\\s+Updated:\\s*Size:\\s*[\\d.,]+\\s*[kKmM]?\\s+(?<date>[A-Za-z]{3}\\s+\\d{1,2},\\s+\\d{4})\\s+at\\b')",
            "if (-not $match.Success) { throw 'Unable to read the published Last Updated date for Never10.' }",
            "[DateTime]::ParseExact($match.Groups['date'].Value, 'MMM d, yyyy', [Globalization.CultureInfo]::InvariantCulture).ToString('yyyy.MM.dd')"
        ],
        "regex": "(?<version>\\d{4}\\.\\d{2}\\.\\d{2})"
    },
    "autoupdate": {
        "url": "https://www.grc.com/files/never10.exe"
    }
}
