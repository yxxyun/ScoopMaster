{
    "version": "3.0.3.11_3",
    "description": "WeChat Input Method (微信输入法), a Chinese input method by Tencent.",
    "homepage": "https://z.weixin.qq.com/",
    "license": "Freeware",
    "architecture": {
        "64bit": {
            "url": "https://download.z.weixin.qq.com/app/win/WeTypeSetup_3.0.3.11_3.exe#/WeTypeSetup.exe",
            "hash": "bcee3ec93fc6751fc08a2a73bf4b4aa20d78b6cae7de14c84f45db61e4bf0c86"
        },
        "arm64": {
            "url": "https://download.z.weixin.qq.com/app/win/WeTypeSetup_3.0.3.11_3.exe#/WeTypeSetup.exe",
            "hash": "bcee3ec93fc6751fc08a2a73bf4b4aa20d78b6cae7de14c84f45db61e4bf0c86"
        }
    },
    "installer": {
        "script": [
            "# WeType is a system-wide input method: the installer elevates itself (UAC) and installs",
            "# outside the Scoop directory, so only the setup file lands in $dir.",
            "$installer = \"$dir\\WeTypeSetup.exe\"",
            "if (-not (Test-Path $installer)) { abort 'WeTypeSetup.exe is missing.' }",
            "try {",
            "    $process = Start-Process -FilePath $installer -ArgumentList '/s' -Wait -PassThru -ErrorAction Stop",
            "} catch {",
            "    abort \"微信输入法安装失败：$($_.Exception.Message)。安装器需要管理员授权（UAC），请在可交互的桌面会话中重试。\"",
            "}",
            "if ($null -ne $process.ExitCode -and $process.ExitCode -ne 0) {",
            "    abort \"微信输入法安装失败，退出码：$($process.ExitCode)\"",
            "}",
            "Remove-Item $installer -Force -ErrorAction SilentlyContinue"
        ]
    },
    "notes": [
        "微信输入法是系统级输入法，安装到系统目录并注册输入法框架(TSF)，不在 Scoop 目录内；安装时会弹出 UAC 授权。",
        "Scoop 只负责下载安装包并调用官方安装器；升级时 scoop update 会先调用官方卸载器再安装新版本。",
        "官方建议优先使用输入法自带的更新功能；静默覆盖安装可能需重启后才能生效。",
        "用户词库等数据不在 Scoop 目录内，scoop uninstall 只卸载程序。"
    ],
    "uninstaller": {
        "script": [
            "$arp = Get-ItemProperty 'HKLM:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\*', 'HKLM:\\SOFTWARE\\WOW6432Node\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\*', 'HKCU:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\*' -ErrorAction SilentlyContinue |",
            "    Where-Object { $_.DisplayName -eq '微信输入法' } | Select-Object -First 1",
            "if (-not $arp) {",
            "    warn '微信输入法未注册卸载信息，可能已经卸载。'",
            "} else {",
            "    $command = if ($arp.QuietUninstallString) { $arp.QuietUninstallString } else { $arp.UninstallString }",
            "    if ($command -match '^\\s*\"([^\"]+)\"\\s*(.*)$') {",
            "        $exe = $matches[1]",
            "        $arguments = $matches[2]",
            "    } elseif ($command -match '^\\s*(\\S+\\.exe)\\s*(.*)$') {",
            "        $exe = $matches[1]",
            "        $arguments = $matches[2]",
            "    } else {",
            "        $exe = $command",
            "        $arguments = ''",
            "    }",
            "    if ($arguments) {",
            "        Start-Process -FilePath $exe -ArgumentList $arguments -Wait",
            "    } else {",
            "        Start-Process -FilePath $exe -Wait",
            "    }",
            "}"
        ]
    },
    "checkver": {
        "url": "https://z.weixin.qq.com/",
        "regex": "\"latest\":\"https://download\\.z\\.weixin\\.qq\\.com/app/win/WeTypeSetup_([\\d\\._]+)\\.exe\""
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://download.z.weixin.qq.com/app/win/WeTypeSetup_$version.exe#/WeTypeSetup.exe"
            },
            "arm64": {
                "url": "https://download.z.weixin.qq.com/app/win/WeTypeSetup_$version.exe#/WeTypeSetup.exe"
            }
        }
    }
}
