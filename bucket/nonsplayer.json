{
    "version": "1.8.7",
    "description": "Multiple music streaming services & High performance. 跨平台、多音源的音乐播放器",
    "homepage": "https://github.com/Miaoyww/NonsPlayer",
    "license": {
        "identifier": "GPL-3.0 license",
        "url": "https://github.com/Miaoyww/NonsPlayer#GPL-3.0-1-ov-file"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/Miaoyww/NonsPlayer/releases/download/v1.8.7/Nons_1.8.7_x64-setup.exe#/dl.7z",
            "hash": "5b07fd2bc26ec664e6a03c7ad673e2498f045dae45436530147767aa12a2bc68",
            "pre_install": "Remove-Item \"$dir\\`$*\", \"$dir\\uninst*\" -Force -Recurse"
        }
    },
    "installer": {
        "script": [
            "# handle runtime cache",
            "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name apps) scripts/AppsUtils.psm1)",
            "Mount-ExternalRuntimeData -Source \"$persist_dir\\appdata\" -Target \"$env:LOCALAPPDATA\\Nons\"",
            "Mount-ExternalRuntimeData -Source \"$persist_dir\\userdata\" -Target \"$env:APPDATA\\Nons\"",
            "Remove-Module -Name AppsUtils"
        ]
    },
    "uninstaller": {
        "script": [
            "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name apps) scripts/AppsUtils.psm1)",
            "Dismount-ExternalRuntimeData -Target \"$env:LOCALAPPDATA\\Nons\"",
            "Dismount-ExternalRuntimeData -Target \"$env:APPDATA\\Nons\"",
            "Remove-Module -Name AppsUtils"
        ]
    },
    "bin": [
        [
            "Nons.exe",
            "NonsPlayer"
        ]
    ],
    "shortcuts": [
        [
            "Nons.exe",
            "NonsPlayer"
        ]
    ],
    "checkver": {
        "github": "https://api.github.com/repos/Miaoyww/NonsPlayer/releases",
        "jp": "$[0].tag_name",
        "regex": "v([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/Miaoyww/NonsPlayer/releases/download/v$version/Nons_$version_x64-setup.exe#/dl.7z"
            }
        },
        "hash": {
            "url": "$baseurl/SHA256SUMS.txt"
        }
    }
}
