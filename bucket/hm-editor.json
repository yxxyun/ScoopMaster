{
    "version": "9.60-5.12",
    "license": "custom",
    "homepage": "https://hide.maruo.co.jp/software/hidemaru.html",
    "checkver": {
        "script": [
            "function Get-Latest($page, $pattern) {",
            "    $content = (Invoke-WebRequest \"https://hide.maruo.co.jp/software/$page\" -UseBasicParsing -UserAgent (Get-UserAgent) -TimeoutSec 30).Content",
            "    [regex]::Matches($content, $pattern) | ForEach-Object { [int]$_.Groups[1].Value } | Sort-Object -Descending | Select-Object -First 1",
            "}",
            "$hm = \"$(Get-Latest 'hidemaru.html' 'hm(\\d+)_x64_signed\\.exe')\"",
            "$pv = \"$(Get-Latest 'hmpv.html' 'hmpv(\\d+)_signed\\.exe')\"",
            "\"$($hm.Insert($hm.Length - 2, '.'))-$($pv.Insert($pv.Length - 2, '.')) hm$hm hmpv$pv\""
        ],
        "regex": "(?<version>[\\d.]+-[\\d.]+) hm(?<hm>\\d+) hmpv(?<pv>\\d+)"
    },
    "##": [
        "秀丸パブリッシャー hmpv*.exe は 32bit/64bit 共通",
        "version は「エディタの版」と「パブリッシャーの版」をハイフンで連結し、どちらの更新も検知できるようにした値"
    ],
