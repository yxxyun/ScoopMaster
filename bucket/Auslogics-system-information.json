{
    "version": "2.0.0.8",
    "description": "Hardware and operating system information utility",
    "homepage": "https://www.auslogics.com/en/software/system-information/",
    "license": "Proprietary",
    "url": "https://downloads.auslogics.com/en/system-information/auslogics-system-information-setup.exe",
    "hash": "B6DB900D45338DC2A375A88B04E7A64F454A32DF8AE27EB1AF1D864D711827D9",
    "innosetup": true,
    "bin": "Integrator.exe",
    "shortcuts": [
        [
            "Integrator.exe",
            "Auslogics System Information"
        ]
    ],
    "checkver": {
        "script": [
            "$html = (Invoke-WebRequest -Uri 'https://www.auslogics.com/en/software/system-information/' -UseBasicParsing).Content",
            "$text = [System.Net.WebUtility]::HtmlDecode([regex]::Replace($html, '<[^>]+>', ' '))",
            "$text = [regex]::Replace($text, '\\s+', ' ')",
            "$match = [regex]::Match($text, '(?i)Version\\s+(?<version>\\d+(?:\\.\\d+){3})')",
            "if (-not $match.Success) { throw 'Unable to detect Auslogics System Information version from the official product page.' }",
            "$match.Groups['version'].Value"
        ],
        "regex": "(?<version>\\d+(?:\\.\\d+){3})"
    },
    "autoupdate": {
        "url": "https://downloads.auslogics.com/en/system-information/auslogics-system-information-setup.exe"
    },
    "notes": [
        "Scoop extracts the official Inno Setup application payload into the app directory; it does not run the setup program.",
        "This extracts the application's installed files but does not guarantee the vendor's own portable mode or suppress any runtime requirements."
    ]
}
