{
    "homepage": "https://tomcat.apache.org",
    "version": "11.0.25",
    "checkver": {
        "url": "https://www.apache.org/dist/tomcat/tomcat-11/?C=M;O=D",
        "re": "v(?<version>[\\d.]+)"
    },
    "autoupdate": {
        "extract_dir": "apache-tomcat-$version",
        "architecture": {
            "64bit": {
                "url": "https://www.apache.org/dist/tomcat/tomcat-11/v$version/bin/apache-tomcat-$version-windows-x64.zip"
            }
        },
        "hash": {
            "url": "$url.sha512"
        }
    },
    "extract_dir": "apache-tomcat-11.0.25",
    "bin": "bin\\catalina.bat",
    "env_set": {
        "CATALINA_HOME": "$dir",
        "CATALINA_BASE": "$dir"
    },
    "suggest": {
        "JRE": "java/openjdk"
    },
    "architecture": {
        "64bit": {
            "url": "https://www.apache.org/dist/tomcat/tomcat-11/v11.0.25/bin/apache-tomcat-11.0.25-windows-x64.zip",
            "hash": "sha512:d28c933ee1ed9bbce295e125c944e51a99dfbdcdd714c8cc17ddce7ede77c70f99a7e052af9823e8f8d2f53770d4030390019f4f4d5a3e48404f1f2b77456d06"
        }
    }
}
