{
    "homepage": "https://tomcat.apache.org",
    "version": "11.0.26",
    "checkver": {
        "url": "https://www.apache.org/dist/tomcat/tomcat-11/?C=M;O=D",
        "re": "v(?<version>[\\d.]+)"
    },
    "autoupdate": {
        "extract_dir": "apache-tomcat-$version",
        "architecture": {
            "64bit": {
                "url": "https://www.apache.org/dist/tomcat/tomcat-11/v$version/bin/apache-tomcat-$version-windows-x64.zip"
            }
        },
        "hash": {
            "url": "$url.sha512"
        }
    },
    "extract_dir": "apache-tomcat-11.0.26",
    "bin": "bin\\catalina.bat",
    "env_set": {
        "CATALINA_HOME": "$dir",
        "CATALINA_BASE": "$dir"
    },
    "suggest": {
        "JRE": "java/openjdk"
    },
    "architecture": {
        "64bit": {
            "url": "https://www.apache.org/dist/tomcat/tomcat-11/v11.0.26/bin/apache-tomcat-11.0.26-windows-x64.zip",
            "hash": "sha512:13e866438d5732dbe35ca4dbd0eb668255f158c96e81dff092dff153b537ac8f20006c3e86b0ff5df8c7c5cc07be28dceb223592318de37378d85de07c5fdbc1"
        }
    }
}
