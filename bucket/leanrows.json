            "hash": "884285fd7e23dbd667e7c29a4ad5db3ece856e5189e557ecf8679cf9141ab649",
            "extract_dir": "LeanRows-v0.7.0-windows-x64-unsigned"
        }
    },
    "pre_install": "Remove-Item \"$dir\\install.ps1\", \"$dir\\uninstall.ps1\" -ErrorAction SilentlyContinue",
    "bin": "leanrows.exe",
    "shortcuts": [
        [
            "leanrows.exe",
            "LeanRows"
        ]
    ],
    "checkver": {
        "github": "https://github.com/abooodbah/leanrows"
    },
