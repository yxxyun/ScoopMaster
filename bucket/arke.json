    "architecture": {
        "64bit": {
            "url": "https://github.com/Koimsurai/Arke/releases/download/v0.10.1/arke-0.10.1.exe#/arke.exe",
            "hash": "3371bb41ee2b60a6e9562548a1956864ecce700f500eada719299cd54aa727c6"
        },
        "arm64": {
            "url": "https://github.com/Koimsurai/Arke/releases/download/v0.10.1/arke-0.10.1-arm64.exe#/arke.exe",
            "hash": "75642cb8d915e3487fd606fc5081fd4946af71a28e61e5d22f7683a6e8dcf274"
        }
    },
    "bin": "arke.exe",
    "shortcuts": [
        [
            "arke.exe",
            "Arke"
        ]
    ],
    "pre_uninstall": [
        "if ($cmd -eq 'uninstall') {",
        "    $arkeArgs = @('--uninstall', '--quiet')",
        "    $scope = if ($global) { ' --global' } else { '' }",
        "    $retry = \"scoop uninstall arke$scope\"",
        "    if ($purge) { $retry += ' --purge' } else { $arkeArgs += '--keep-settings' }",
        "    $arke = Start-Process \"$dir\\arke.exe\" -ArgumentList $arkeArgs -Wait -PassThru",
        "    if ($arke.ExitCode -ne 0) {",
        "        warn 'Arke could not undo everything it set up (for example the search service, if its administrator prompt was declined).'",
        "        warn \"To finish, run 'scoop install arke$scope', then '$retry' again.\"",
        "    }",
        "}"
    ],
    "notes": "Arke keeps its settings in %APPDATA%\\Arke. Update with: scoop update arke",
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/Koimsurai/Arke/releases/download/v$version/arke-$version.exe#/arke.exe",
                "hash": {
                    "url": "https://github.com/Koimsurai/Arke/releases/download/v$version/arke-$version.exe.sha256"
                }
            },
            "arm64": {
                "url": "https://github.com/Koimsurai/Arke/releases/download/v$version/arke-$version-arm64.exe#/arke.exe",
                "hash": {
                    "url": "https://github.com/Koimsurai/Arke/releases/download/v$version/arke-$version-arm64.exe.sha256"
                }
            }
        }
    }
}
