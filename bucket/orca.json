            "hash": "sha512:9b2dafc2e2ee409aac1f302acd38b0d2aaa673cee94cd4eb8dfada296fe0d9286670d1cbe533c2f04a42a870e5d076d0f09ad4326e31b24d6dca05a7f5a68e78"
        }
    },
    "pre_install": "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-64.7z\" \"$dir\"",
