    "architecture": {
        "64bit": {
            "url": "https://github.com/stablyai/orca/releases/download/v1.4.264/orca-windows-setup.exe#/dl.7z",
            "hash": "sha512:e3dc579e3b813543d8c4edc922b827b396c494321859c7a773334647427c00c5bb2ac4f09d8f29b7e74eb42339858c67aa6aec1e7428d6c92df12607e8c769cf"
        }
    },
    "pre_install": "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-64.7z\" \"$dir\"",
    "post_install": "Get-ChildItem \"$dir\" -Filter '$*' | Remove-Item -Recurse -Force",
    "bin": [
        [
