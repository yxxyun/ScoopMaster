            "hash": "sha512:018745003006ae2f40852e93e4408a97694686c253295445dec0068b6fceedb11203f3290c5288cd88be446497b0d60657d08214f4b7e667a745a3137ea63068"
        }
    },
    "pre_install": "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-64.7z\" \"$dir\"",
