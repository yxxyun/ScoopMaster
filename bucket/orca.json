    "architecture": {
        "64bit": {
            "url": "https://github.com/stablyai/orca/releases/download/v1.4.255/orca-windows-setup.exe#/dl.7z",
            "hash": "sha512:f89ec45d13a030c996cb565c161d9d82b66fb5e6edb13e2e5220f0841c54eccf0be049485fa66d2982467ed4f3e95246c02a566861fc0705a0512912997db8b0"
        }
    },
    "pre_install": "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-64.7z\" \"$dir\"",
    "post_install": "Get-ChildItem \"$dir\" -Filter '$*' | Remove-Item -Recurse -Force",
    "bin": [
