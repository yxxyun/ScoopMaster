            "hash": "sha512:09ba052c34372da5bf9e0a70b01fdcd8167d05482f21260cf295e43562695ed3b0376eaecfa171a7735281433cb3b24609c6e4169cd1856ea92f82ffe920a287"
        }
    },
    "pre_install": "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-64.7z\" \"$dir\"",
