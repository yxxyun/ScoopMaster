    "homepage": "https://github.com/stablyai/orca",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/stablyai/orca/releases/download/v1.4.205/orca-windows-setup.exe#/dl.7z",
            "hash": "sha512:0c04b75d5c84132de7de327db3b3e8d760f21aceba6f3dda852eb12ded8af10bd848bf827b6d06aba22c7e1db738c5d05a8a6b6cf6408ed4d8f18c02b4e8400a"
        }
    },
    "pre_install": "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-64.7z\" \"$dir\"",
    "post_install": "Get-ChildItem \"$dir\" -Filter '$*' | Remove-Item -Recurse -Force",
    "bin": [
        [
