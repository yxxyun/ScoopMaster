    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/stablyai/orca/releases/download/v1.4.171/orca-windows-setup.exe#/dl.7z",
            "hash": "sha512:cd5db39382d08f442850b0edc081f1cf288a1311b734fc918b3dc1a9df3d88c649652981e3dbe2bb53f7379fa31a8d65b80c9dd6e4650df6b9258dc5104b4740"
        }
    },
    "pre_install": "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-64.7z\" \"$dir\"",
    "post_install": "Get-ChildItem \"$dir\" -Filter '$*' | Remove-Item -Recurse -Force",
    "bin": [
        [
            "resources\\bin\\orca.exe",
            "orca"
        ]
    ],
    "shortcuts": [
        [
            "Orca.exe",
            "Orca"
        ]
    ],
    "checkver": {
        "url": "https://api.github.com/repos/stablyai/orca/releases/latest",
        "jsonpath": "$.tag_name",
        "regex": "^v([\\d.]+)$"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/stablyai/orca/releases/download/v$version/orca-windows-setup.exe#/dl.7z",
                "hash": {
                    "url": "$baseurl/latest.yml",
                    "regex": "sha512:\\s+$base64"
                }
            }
        }
    }
}
