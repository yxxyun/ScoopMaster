{
    "version": "0.18.0",
    "description": "A cross-platform terminal workspace for Codex and Claude Code",
    "homepage": "https://github.com/ChengSoon/belfry-desktop",
    "license": "LGPL-3.0-only",
    "notes": [
        "Belfry application data: %APPDATA%\\io.appmakes.belfry.desktop\\",
        "Belfry and WebView2 local data, including localStorage: %LOCALAPPDATA%\\io.appmakes.belfry.desktop\\",
        "This package persists both directories through Scoop-managed Junction links",
        "Stop Belfry before installing, updating, or uninstalling so WebView2 files are not locked",
        "SSH passwords remain in Windows Credential Manager; external Agent and project data stay in their native paths"
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/ChengSoon/belfry-desktop/releases/download/v0.18.0/Belfry_0.18.0_x64-setup.exe#/dl.7z",
            "hash": "c0c9178887636c48f0ee754b2ca88dbe37cc4bf0ea8ca0a02123c2eb10a2f42d"
        }
    },
    "pre_install": [
        "$running = @(Get-Process -Name 'belfry-desktop' -ErrorAction SilentlyContinue)",
        "if ($running.Count -gt 0) { throw 'Belfry is running. Stop it before installing or updating this package.' }",
        "Remove-Item \"$dir\\`$PLUGINSDIR\", \"$dir\\uninstall.exe\" -Force -Recurse -ErrorAction SilentlyContinue"
    ],
    "bin": "belfry-desktop.exe",
    "shortcuts": [
        [
            "belfry-desktop.exe",
            "Belfry"
        ]
    ],
    "post_install": [
        "$mountPersistedDirectory = {",
        "    param($source, $persistName)",
        "    $target = Join-Path $persist_dir $persistName",
        "    ensure $target",
        "    $item = Get-Item -LiteralPath $source -Force -ErrorAction SilentlyContinue",
        "    $backup = $null",
        "",
        "    if ($item) {",
        "        if ($item.Attributes -band [IO.FileAttributes]::ReparsePoint) {",
        "            $expected = [IO.Path]::GetFullPath($target).TrimEnd('\\')",
        "            $actual = @($item.Target) | Select-Object -First 1",
        "            if ($actual -and [IO.Path]::GetFullPath($actual).TrimEnd('\\') -ieq $expected) {",
        "                Write-Host \"Junction already managed by Scoop: $source\"",
        "                return",
        "            }",
        "            throw \"Path is an existing reparse point not managed by this package: $source\"",
        "        }",
        "        if (-not $item.PSIsContainer) {",
        "            throw \"Path exists and is not a directory: $source\"",
        "        }",
        "",
        "        & robocopy.exe $source $target /E /R:1 /W:1 /NFL /NDL /NJH /NJS /NP | Out-Null",
        "        $copyExitCode = $LASTEXITCODE",
        "        if ($copyExitCode -gt 7) {",
        "            throw \"Migration failed with robocopy exit code ${copyExitCode}: $source\"",
        "        }",
        "",
        "        $backup = \"$source.backup-$(Get-Date -Format 'yyyyMMdd-HHmmssfff')\"",
        "        Move-Item -LiteralPath $source -Destination $backup -Force",
        "        Write-Host \"Backed up original directory: $backup\"",
        "    }",
        "",
        "    try {",
        "        New-Item -Path $source -ItemType Junction -Value $target -Force | Out-Null",
        "    } catch {",
        "        if ($backup -and (Test-Path $backup) -and -not (Test-Path $source)) {",
        "            Move-Item -LiteralPath $backup -Destination $source -Force",
        "        }",
        "        throw",
        "    }",
        "}",
        "",
        "& $mountPersistedDirectory (Join-Path $env:APPDATA 'io.appmakes.belfry.desktop') 'app-data'",
        "& $mountPersistedDirectory (Join-Path $env:LOCALAPPDATA 'io.appmakes.belfry.desktop') 'webview-data'"
    ],
    "post_uninstall": [
        "$removePersistedJunction = {",
        "    param($source, $persistName)",
        "    $item = Get-Item -LiteralPath $source -Force -ErrorAction SilentlyContinue",
        "    if (-not $item) { return }",
        "    if (-not ($item.Attributes -band [IO.FileAttributes]::ReparsePoint)) { return }",
        "",
        "    $target = Join-Path $persist_dir $persistName",
        "    $expected = [IO.Path]::GetFullPath($target).TrimEnd('\\')",
        "    $actual = @($item.Target) | Select-Object -First 1",
        "    if ($actual -and [IO.Path]::GetFullPath($actual).TrimEnd('\\') -ieq $expected) {",
        "        Remove-Item -LiteralPath $source -Force",
        "    }",
        "}",
        "",
        "& $removePersistedJunction (Join-Path $env:APPDATA 'io.appmakes.belfry.desktop') 'app-data'",
        "& $removePersistedJunction (Join-Path $env:LOCALAPPDATA 'io.appmakes.belfry.desktop') 'webview-data'"
    ],
    "persist": [
        "app-data",
        "webview-data"
    ],
    "checkver": {
        "github": "https://github.com/ChengSoon/belfry-desktop"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/ChengSoon/belfry-desktop/releases/download/v$version/Belfry_$version_x64-setup.exe#/dl.7z"
            }
        },
        "hash": {
            "mode": "download"
        }
    }
}
