{
    "version": "2.10.1",
    "description": "Open-source mod manager from Nexus Mods.",
    "homepage": "https://www.nexusmods.com/about/vortex/",
    "license": {
        "identifier": "GPL-3.0-or-later",
        "url": "https://raw.githubusercontent.com/Nexus-Mods/Vortex/master/LICENSE.md"
    },
    "url": "https://github.com/Nexus-Mods/Vortex/releases/download/v2.10.1/vortex-setup-2.10.1.exe",
    "hash": "sha512:b0a1d7a56b544682e31247340eae591aca915c0bc8740feb58ee6bd7ad10f341fb05fefa322085c950cd7c3c454afcad17130d1a1df9af8aea366ea82ff0ecbf",
    "installer": {
        "script": [
            "$args = @('/S')",
            "Start-Process \"$dir\\$fname\" -ArgumentList $args -Wait -Verb RunAs | Out-Null",
            "Remove-Item \"$dir\\$fname\""
        ]
    },
    "uninstaller": {
        "script": [
            "# Scoop update: the new installer upgrades Vortex in place, so only remove it on scoop uninstall",
            "if ($cmd -eq 'uninstall') {",
            "    $entry = Get-ItemProperty @('HKLM:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\*', 'HKLM:\\SOFTWARE\\WOW6432Node\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\*') -ErrorAction SilentlyContinue | Where-Object { $_.DisplayName -eq 'Vortex' -and $_.QuietUninstallString } | Select-Object -First 1",
            "    if ($entry.QuietUninstallString -match '^\\s*\"?(?<exe>[^\"]+?\\.exe)\"?\\s*(?<args>.*)$') {",
            "        # --updated stops the uninstaller from popping up its feedback prompt during a silent removal",
            "        Start-Process $Matches.exe -ArgumentList \"$($Matches.args) --updated\" -Verb RunAs -Wait",
            "    } else {",
            "        warn 'Vortex''s uninstaller was not found. Remove Vortex from Settings > Apps if it is still installed.'",
            "    }",
            "}"
        ]
    },
    "checkver": {
        "url": "https://api.github.com/repos/Nexus-Mods/Vortex/releases",
        "jp": "$..tag_name",
        "re": "(?!v)([\\d.]+(?:-[\\da-zA-Z.-]+)?)"
    },
    "autoupdate": {
        "url": "https://github.com/Nexus-Mods/Vortex/releases/download/v$version/vortex-setup-$version.exe",
        "hash": {
            "url": "$baseurl/latest.yml",
            "regex": "sha512: $base64"
        }
    }
}
