    },
    "installer": {
        "script": [
            "$setupPath = Join-Path $dir 'setup.exe'",
            "$extractPath = Join-Path $dir 'VeraCrypt'",
            "Start-Process -FilePath $setupPath -Wait",
            "$mainFiles = @('VeraCrypt-x64.exe', 'VeraCrypt-arm64.exe')",
            "if (-not (@($mainFiles | Where-Object { Test-Path -LiteralPath (Join-Path $extractPath $_) }).Count -gt 0)) {",
            "    throw 'VeraCrypt extraction was not completed to the default Scoop folder. Re-run installation and keep the default extraction location.'",
            "}",
            "Remove-Item -LiteralPath $setupPath -Force",
            "Get-ChildItem -LiteralPath $extractPath -Force | Move-Item -Destination $dir -Force",
            "Remove-Item -LiteralPath $extractPath -Recurse -Force",
            "$configPath = Join-Path $dir 'Configuration.xml'",
            "if (-not (Test-Path -LiteralPath $configPath)) { New-Item -Path $configPath -ItemType File | Out-Null }"
        ]
    },
    "persist": "Configuration.xml",
    "notes": [
        "Uses the official portable self-extracting package. The setup wizard is used only to extract files; keep its default extraction location (the VeraCrypt subfolder inside the Scoop app directory).",
        "Portable mode does not mean driver-free: VeraCrypt requires administrator privileges to mount volumes and loads its driver at runtime. In some unmount scenarios the driver may remain loaded until Windows restarts.",
        "Configuration.xml is persisted across Scoop updates. The program files stay under the Scoop app directory, but mounted volumes and the runtime driver are managed by Windows.",
        "See the bundled LICENSE and NOTICE files for upstream and third-party licensing notices."
    ],
    "checkver": {
        "github": "https://github.com/veracrypt/VeraCrypt",
        "regex": "VeraCrypt_([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/veracrypt/VeraCrypt/releases/download/VeraCrypt_$version/VeraCrypt.Portable.$version.exe#/setup.exe",
                "hash": {
                    "url": "https://github.com/veracrypt/VeraCrypt/releases/download/VeraCrypt_$version/veracrypt-$version-sha256sum.txt",
                    "regex": "$sha256\\s+\\*?$basename"
                }
            },
            "arm64": {
                "url": "https://github.com/veracrypt/VeraCrypt/releases/download/VeraCrypt_$version/VeraCrypt.Portable.$version.exe#/setup.exe",
                "hash": {
                    "url": "https://github.com/veracrypt/VeraCrypt/releases/download/VeraCrypt_$version/veracrypt-$version-sha256sum.txt",
                    "regex": "$sha256\\s+\\*?$basename"
                }
            }
        }
    }
